    "// Reads the lines between the first line and the blank one.",
    "export HeaderBlock parseHeaders(String[] lines) {",
    "    Map<String, String> h = {};",
    "    String[] cookies = [];",
    "    if (lines.length > MAX_HEADERS) {",
    "        return Error(`too many headers (${lines.length})`, ErrorCode.TOO_LARGE);",
    "    }",
    "    forEach(lines, line) {",
    "        if (string.length(line) == 0) { continue; }",
    "        if (string.length(line) > MAX_LINE) {",
    "            return Error(\"header line too long\", ErrorCode.TOO_LARGE);",
    "        }",
    "        // A leading space or tab starts an obs-fold continuation, which RFC",
    "        // 9112 says a recipient must reject.",
