import 'string';
import 'json';

String s = "  Hello, World  ";
print(string.trim(s));
print(string.toUpperCaseAscii("nio v1.0!"));
print(string.toLowerCaseAscii("Nio V1.0!"));
print(string.length("hello"));
print(string.length(""));
print(string.append("foo", "bar"));
print(string.contains("hello world", "lo w"));
print(string.contains("hello world", "xyz"));
print(string.find("my findValue", "findValue"));
print(string.find("abc", "z"));
print(string.copy("dup"));
print(string.replace("a-b-c", "-", "+"));
print(string.replaceAll("a-b-c", "-", "+"));
print(json.toText(string.split("hello - world", "-")));
print(json.toText(string.toByteArray("Az")));
print(string.toUpperCaseAscii(string.trim("  ok  ")));
`, [
        "Hello, World", "NIO V1.0!", "nio v1.0!", "5", "0", "foobar", "true", "false",
        "3", "-1", "dup", "a+b-c", "a+b+c", "[\"hello \",\" world\"]", "[65,122]",
        "OK",
    ]);
});

// A program can declare its own Cpu. Codegen interns type descriptors by qual
// and name, so the two must stay different.
