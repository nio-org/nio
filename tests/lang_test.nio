test.start("lang: functions and recursion", void () -> {
    h.expectOutput(`
int fib(int n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}
print(fib(10));

String greet(String name) {
    return "hello " + name;
}
print(greet("world"));

int early(int x) {
    if (x > 0) {
        return 1;
    }
    return -1;
}
print(early(5));
print(early(-5));

void voidReturn(int x) {
    if (x > 0) {
        return;
    }
    print("negative");
}
voidReturn(1);
voidReturn(-1);
`, [
        "55", "hello world", "1", "-1", "negative",
    ]);
});

