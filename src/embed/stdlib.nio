    "// Reads `GET /path?q HTTP/1.1`.",
    "export RequestLine parseRequestLine(String line) {",
    "    if (string.length(line) > MAX_LINE) {",
    "        return Error(\"request line too long\", ErrorCode.TOO_LARGE);",
    "    }",
    "    int sp1 = string.find(line, \" \");",
