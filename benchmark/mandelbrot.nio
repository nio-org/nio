// Mandelbrot escape time over a 1000x1000 grid. Measures float arithmetic.
// The coordinates use float accumulators, as in the other versions.
int width = 1000;
int height = 1000;
int maxIter = 250;
float dx = 3.0 / 1000.0;
float dy = 3.0 / 1000.0;

int totalIter = 0;
int py = 0;
float cy = -1.5;

while (py < height) {
    int px = 0;
    float cx = -2.0;
    while (px < width) {
        float zx = 0.0;
        float zy = 0.0;
        int iter = 0;
        while (iter < maxIter && zx * zx + zy * zy <= 4.0) {
            float tmp = zx * zx - zy * zy + cx;
            zy = 2.0 * zx * zy + cy;
            zx = tmp;
            iter = iter + 1;
        }
        totalIter = totalIter + iter;
        cx = cx + dx;
        px = px + 1;
    }
    cy = cy + dy;
    py = py + 1;
}

print(totalIter);
