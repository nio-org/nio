test.start("lang: map optional chaining", void () -> {
    h.expectOutput(`
type Garage { Map<String, int>? slots; }
type Lot { Garage? garage; }

Garage empty = { slots: null };
Garage full = { slots: { "front": 1 } };
print(empty.slots?.length);
print(full.slots?.length);

// Indexing continues a chain, and the map lookup's V? is the chain's own
// optional shape.
Lot l = { garage: { slots: { "front": 1 } } };
print(l.garage?.slots["front"]);
print(l.garage?.slots["back"]);
Lot none = { garage: null };
print(none.garage?.slots["front"]);
`, [
        "null", "1", "1", "null", "null",
    ]);
});

test.start("lang: maps in functions and closures", void () -> {
    h.expectOutput(`
import 'map';

int count(Map<String, int> m) {
    return m.length;
}
Map<String, int> make() {
    Map<String, int> m;
    m["a"] = 1;
    m["b"] = 2;
    return m;
}
print(count(make()));

// A captured map is shared by reference through its box.
Map<String, int> shared;
Function()<void> bump = void () -> {
    shared["hits"] = shared.length + 1;
};
bump();
bump();
print(shared["hits"]);
print(shared.length);
`, [
        "2", "2", "1",
    ]);
});

test.start("lang: maps across await", void () -> {
    h.expectOutput(`
import 'time';

int async tally() {
    Map<String, int> local;
    local["before"] = 1;
    await time.sleep(1);
    // The map lives in the state-machine frame and survives the suspension.
    local["after"] = 2;
    return local.length;
}
print(await tally());
`, [
        "2",
    ]);
});

test.start("lang: variadic parameters", void () -> {
    h.expectOutput(`
void customPrint(int myInt, ...String logs) {
    print(myInt);
    forEach(logs, log) {
        print(log);
    }
}
customPrint(0, "hello", "world", "!");

// The collecting parameter is an ordinary array: no trailing argument
// makes it empty, and it carries its length like any other.
int sum(...int ns) {
    print(ns.length);
    int total = 0;
    forEach(ns, n) {
        total = total + n;
    }
    return total;
}
print(sum());
print(sum(1, 2, 3));
`, [
        "0", "hello", "world", "!", "0", "0", "3", "6",
    ]);
});

test.start("lang: variadic function values", void () -> {
    h.expectOutput(`
Function(...String)<void> shout = void (...String parts) -> {
    forEach(parts, p) {
        print(p + "!");
    }
};
shout("a", "b");
shout();
print(getType(shout));

// A variadic parameter can be captured, like any other.
Function()<int> adder(...int seed) {
    return int () -> seed[0] + seed[1];
}
print(adder(10, 5)());
`, [
        "a!", "b!", "Function(...String)<void>", "15",
    ]);
});

test.start("lang: variadic async and fallible", void () -> {
    h.expectOutput(`
int async twice(int n) {
    return n * 2;
}
int async total(...int ns) {
    int t = 0;
    forEach(ns, n) {
        t = t + await twice(n);
    }
    return t;
}
// The arguments are evaluated and collected at the call, before the body
// runs; an await among them completes first.
print(await total(1, 2, 3));
print(await total(await twice(5), 1));

int first(...int ns) {
    if (ns.length == 0) {
        return Error("nothing to pick");
    }
    return ns[0];
}
print(first(7));
print(first() catch -1);
`, [
        "12", "22", "7", "-1",
    ]);
});

// Each argument stays live while the later ones are evaluated, and while the
// array that collects them is allocated.
test.start("lang: variadic rooting", void () -> {
    h.expectOutput(`
void join(String head, String sep, ...String rest) {
    String out = head;
    forEach(rest, r) {
        out = out + sep + r;
    }
    print(out);
}
String a = "a";
join(a + "1", "-" + "-", a + "2", a + "3", a + "4");
`, [
        "a1--a2--a3--a4",
    ]);
});

test.start("lang: methods", void () -> {
    h.expectOutput(`
import 'json';

type Car {
    String make;
    int buildYear;

    // The receiver reads its own fields. A function-typed field cannot do
    // this, because a closure captures variables and not the record.
    int returnYear() {
        return self.buildYear;
    }

    void rename(String name) {
        self.make = name;
    }

    // one method calling another on the same receiver
    String describe() {
        return self.make + " (" + self.age() + " years)";
    }

    String age() {
        return json.toText(2026 - self.returnYear());
    }
}

Car myCar = { make: "myCar", buildYear: 1922 }
print(myCar.returnYear());
myCar.rename("Toyota");
print(myCar.make);
print(myCar.describe());

// Methods are not fields: the JSON form is the data alone.
print(json.toText(myCar));

// Every value of the type shares one method; nothing is stored per value.
Car other = { make: "honda", buildYear: 2000 }
print(other.describe());
`, [
        "1922", "Toyota", "Toyota (104 years)",
        "{\"make\":\"Toyota\",\"buildYear\":1922}", "honda (26 years)",
    ]);
});

test.start("lang: method receiver kinds", void () -> {
    h.expectOutput(`
import 'array';

type Counter {
    int n;
    int bump() {
        self.n = self.n + 1;
        return self.n;
    }
    Counter self() { return self; }   // the receiver as a value
}

type Garage {
    Counter[] counters;
    Counter? spare;

    int total() {
        int sum = 0;
        forEach(self.counters, c) {
            sum = sum + c.n;
        }
        return sum;
    }
}

Counter makeCounter(int n) { return { n: n }; }

Garage g = { counters: [{ n: 1 }, { n: 2 }] };
print(g.total());

// through an array element, a narrowed optional, a call result, and a chain
print(g.counters[0].bump());
g.spare = { n: 100 };
if (g.spare != null) {
    print(g.spare.bump());
}
print(makeCounter(7).bump());
print(makeCounter(7).self().bump());
array.push(g.counters, makeCounter(10));
print(g.total());

// Records are references, so a method mutates the value it was called on.
Counter c = { n: 0 };
Counter alias = c;
print(alias.bump());
print(c.n);
`, [
        "3", "2", "101", "8", "8", "14", "1", "1",
    ]);
});

test.start("lang: methods with closures and errors", void () -> {
    h.expectOutput(`
import 'array';

type Box {
    int n;
    String label;

    // a function value capturing the receiver, outliving the call
    Function()<int> stepper() {
        return int () -> {
            self.n = self.n + 1;
            return self.n;
        };
    }

    Function()<int>[] steppers(int times) {
        Function()<int>[] out = [];
        for (int i = 0; i < times; i = i + 1) {
            array.push(out, self.stepper());
        }
        return out;
    }

    // fallible, inferred from the body
    int risky() {
        if (self.n > 10) {
            return Error("too big");
        }
        return self.n;
    }

    // a catch handler inside a method may mutate the receiver
    int safe() {
        return self.risky() catch e {
            self.label = e.message;
            return -1;
        };
    }
}

Box b = { n: 0, label: "start" };
Function()<int> step = b.stepper();
print(step());
print(step());
print(b.n);

forEach(b.steppers(2), s) {
    print(s());
}

print(b.safe());
b.n = 50;
print(b.safe());
print(b.label);
print(b.risky() catch -1);
`, [
        "1", "2", "2", "3", "4", "4", "-1", "too big", "-1",
    ]);
});

test.start("lang: async methods", void () -> {
    h.expectOutput(`
import 'time';

type Node {
    int value;
    Node? next;

    int async total() {
        await time.sleep(1);
        if (self.next != null) {
            return self.value + await self.next.total();
        }
        return self.value;
    }

    int async risky() {
        await time.sleep(1);
        if (self.value < 0) {
            return Error("negative");
        }
        return self.value;
    }
}

Node c = { value: 3 };
Node b = { value: 2, next: c };
Node a = { value: 1, next: b };

Future<int> f = a.total();
print(await f);
print(await f);          // the result is remembered

print(await a.risky() catch -1);
a.value = -5;
print(await a.risky() catch -1);
`, [
        "6", "6", "1", "-1",
    ]);
});

// A method call on a null receiver is a runtime error (§5.5).
test.start("lang: method on narrowed null receiver", void () -> {
    h.expectRuntimeError(`
type T {
    int n;
    T? other;
    int get() { return self.n; }
    void clear() { self.other = null; }
}

T t = { n: 1 };
t.other = { n: 2 };
if (t.other != null) {
    t.clear();
    print(t.other.get());
}
`, "null");
});

// An argument that awaits hoists the receiver and not the callee, because a
// method is not a value.
test.start("lang: async method arguments", void () -> {
    h.expectOutput(`
import 'time';

type T {
    int n;
    T? other;

    int add(int a, int b) { return self.n + a + b; }
    int async val() { await time.sleep(1); return self.n; }
    T async mk(int v) { await time.sleep(1); return { n: v }; }

    int async go() { return self.add(await self.val(), 1); }
    int async chained() { return (await self.mk(100)).add(await self.val(), 2); }
    int async viaOther() {
        if (self.other != null) {
            return self.other.add(await self.val(), 3);
        }
        return 0;
    }
}

T t = { n: 5 };
t.other = { n: 7 };
print(await t.go());
print(await t.chained());
print(await t.viaOther());
`, [
        "11", "107", "15",
    ]);
});

// A captured self moves into a heap box in the state-0 prologue.
test.start("lang: async method captures receiver", void () -> {
    h.expectOutput(`
import 'time';

type T {
    int n;

    int async run() {
        Function()<int> bump = int () -> {
            self.n = self.n + 1;
            return self.n;
        };
        int a = bump();
        await time.sleep(1);
        int b = bump();
        return a + b + self.n;
    }
}

T t = { n: 0 };
print(await t.run());
print(t.n);
`, [
        "5", "2",
    ]);
});

// extends copies the members (§2.4). The base's fields keep their indices, and
// the inherited bodies call the override.
test.start("lang: extends", void () -> {
    h.expectOutput(`
import 'json';

type Car {
    String make;
    String? owner;

    int wheels() { return 4; }

    void describe() {
        print(self.make, "has", self.wheels(), "wheels");
    }
}

type Truck extends Car {
    int load;

    int override wheels() { return 6; }

    int carry(int extra) { return self.load + extra; }
}

type Van extends Truck {
    void override describe() {
        print("van:", self.make, self.wheels());
    }
}

Car c = { make: "toyota" };
Truck t = { make: "volvo", owner: "eli", load: 900 };
Van v = { make: "ford", load: 300 };

c.describe();
t.describe();          // the base's body, calling Truck's override
v.describe();

print(t.owner, t.load, t.carry(100));
print(getType(c), getType(t), getType(v));
print(json.toText(t));

// A method mutating the receiver reaches an inherited field.
t.make = "scania";
print(t.make);
`, [
        "toyota has 4 wheels", "volvo has 6 wheels", "van: ford 6", "eli 900 1000",
        "Car Truck Van", "{\"make\":\"volvo\",\"owner\":\"eli\",\"load\":900}",
        "scania",
    ]);
});

// An inherited body belongs to the extending type, so self carries that type.
test.start("lang: extends inherited body kinds", void () -> {
    h.expectOutput(`
import 'time';

type Base {
    String name;

    String risky(bool bad) {
        if (bad) { return Error("boom"); }
        return self.name;
    }

    Function()<String> closure() {
        return String () -> self.name + "/" + self.tag();
    }

    String async fetch() {
        await time.sleep(1);
        return self.name + ":" + self.tag();
    }

    String tag() { return "base"; }
}

type Sub extends Base {
    String[] extras;                  // a reference field the base knows nothing about
    String override tag() { return "sub"; }
}

Sub s = { name: "s", extras: ["e"] };
print(s.risky(false));
print(s.risky(true) catch "caught");
Function()<String> f = s.closure();
print(f());
print(await s.fetch());
print(s.extras[0]);
`, [
        "s", "caught", "s/sub", "s:sub", "e",
    ]);
});

// A parse with no type. Navigation never stops the program, and the readers
// return their failures as errors.
test.start("lang: json dynamic", void () -> {
    h.expectOutput(`
import 'json';

Json? raw = json.parse('{"name":"api","port":8080,"tls":{"on":false},"tags":["a","b"]}')
    catch e { print(e.message); };
if (raw != null) {
    print(json.getType(raw) == json.Type.OBJECT);
    print(json.asText(raw["name"]) catch "?");
    print(json.asInt(raw["port"]) catch -1);
    print(json.asBool(raw["tls"]["on"]) catch true);

    // An absent key is MISSING, and a chain through one does not trap.
    print(json.getType(raw["nope"]) == json.Type.MISSING);
    print(json.getType(raw["a"]["b"]["c"]) == json.Type.MISSING);

    // Arrays.
    print(json.length(raw["tags"]));
    print(json.asText(raw["tags"][1]) catch "?");
    print(json.getType(raw["tags"][9]) == json.Type.MISSING);
    forEach(json.keys(raw), k) { printInline(k + " "); }
    print("");

    // Asking for the wrong shape is catchable, not fatal.
    print(json.asInt(raw["name"]) catch -1);
}

// So is a malformed document.
Json? bad = json.parse("{oops") catch e { print("caught"); };
print(bad == null);
`, [
        "true", "api", "8080", "false", "true", "true", "2", "b", "true",
        "name port tls tags ", "-1", "caught", "true",
    ]);
});

// A key that is present with the value null is different from an absent key.
test.start("lang: json null is not missing", void () -> {
    h.expectOutput(`
import 'json';

Json? d = json.parse('{"a":null}') catch e { print(e.message); };
if (d != null) {
    print(json.getType(d["a"]) == json.Type.NULL);
    print(json.getType(d["b"]) == json.Type.MISSING);
    print(json.toText(d));
}
`, [
        "true", "true", "{\"a\":null}",
    ]);
});

// A read aliases into the tree; a write deep-copies into it.
test.start("lang: json writing", void () -> {
    h.expectOutput(`
import 'json';

Json? w = json.parse('{"a":1,"nested":{"x":10}}') catch e { print(e.message); };
if (w != null) {
    w["a"] = 2;
    w["added"] = "new";
    w["flag"] = true;
    w["ratio"] = 0.5;
    w["list"] = [1, 2, 3];
    w["nothing"] = null;

    // A read is a view: writing through it changes the document.
    Json nested = w["nested"];
    nested["x"] = 11;
    nested["y"] = 12;

    json.push(w["list"], 4);
    w["list"][0] = 9;
    json.remove(w, "flag");
    print(json.toText(w));

    // A write copies: the source cannot be changed through the document.
    Json? src = json.parse('{"k":1}') catch e { print(e.message); };
    if (src != null) {
        w["copied"] = src;
        src["k"] = 99;
        print(json.toText(w["copied"]));
    }
}
`, [
        "{\"a\":2,\"nested\":{\"x\":11,\"y\":12},\"added\":\"new\",\"ratio\":0.5,\"list\":[9,2,3,4],\"nothing\":null}",
        "{\"k\":1}",
    ]);
});

// A json* field keeps the undeclared keys and writes them back with the
// declared fields.
test.start("lang: json catch all", void () -> {
    h.expectOutput(`
import 'json';

type Tls    { bool enabled; String cert;  Json extra 'json*'; }
type Config { String name; int port; Tls tls; Json extra 'json*'; }

String migrate(String text) {
    Config c = json.parse(text) as Config;
    c.port = c.port + 1;
    c.tls.enabled = true;

    Json limits = c.extra["limits"];
    if (json.getType(limits) == json.Type.OBJECT) {
        limits["rate"] = json.asInt(limits["rate"]) * 2;
    }
    c.extra["added"] = true;
    json.remove(c.extra, "drop");
    return json.toText(c);
}

String? out = migrate('{"name":"api","port":8080,"tls":{"enabled":false,"cert":"/c","min":"1.2"},"owner":"me","limits":{"rate":100},"drop":true}')
    catch e { print(e.message); };
print(out);

// A record with a catch-all and no unknown keys leaves an empty object,
// not a missing one, so a program can still write into it.
type Small { int n; Json rest 'json*'; }
Small? s = json.parse('{"n":1}') as Small catch e { print(e.message); };
if (s != null) {
    print(json.getType(s.rest) == json.Type.OBJECT);
    s.rest["late"] = 1;
    print(json.toText(s));
}
`, [
        "{\"name\":\"api\",\"port\":8081,\"tls\":{\"enabled\":true,\"cert\":\"/c\",\"min\":\"1.2\"},\"owner\":\"me\",\"limits\":{\"rate\":200},\"added\":true}",
        "true", "{\"n\":1,\"late\":1}",
    ]);
});

// strict refuses a key the type does not declare, at every depth.
test.start("lang: json strict", void () -> {
    h.expectOutput(`
import 'json';

type Inner  { int b; }
type Limits { int rate; Inner inner; }

Limits? ok = json.parse('{"rate":1,"inner":{"b":2}}') strict as Limits
    catch e { print(e.message); };
print(ok?.rate);

Limits? typo = json.parse('{"rat":1,"inner":{"b":2}}') strict as Limits
    catch e { print(e.message); };
print(typo == null);

// At every depth: a typo inside inner is the same bug as one at the top.
Limits? deep = json.parse('{"rate":1,"inner":{"c":2,"b":3}}') strict as Limits
    catch e { print(e.message); };
print(deep == null);

// Without strict the same documents parse and the extra key is dropped.
Limits? loose = json.parse('{"rate":7,"inner":{"b":2},"rat":1}') as Limits
    catch e { print(e.message); };
print(loose?.rate);
`, [
        "1", "cannot parse JSON: unknown key \"rat\"", "true",
        "cannot parse JSON: unknown key \"c\" at inner", "true", "7",
    ]);
});

test.start("lang: json as on tree", void () -> {
    h.expectOutput(`
import 'json';
import 'string';

type Circle { String type; float r; }
type Square { String type; float side; }

Json[]? shapes = json.parse('[{"type":"circle","r":2},{"type":"square","side":3},{"type":"circle"}]')
    as Json[] catch e { print(e.message); };

if (shapes != null) {
    forEach(shapes, it) {
        String tag = json.asText(it["type"]) catch "";
        if (tag == "circle") {
            Circle? c = it as Circle catch e { print(e.message); };
            if (c != null) { print("circle " + string.from(c.r)); }
        }
        if (tag == "square") {
            Square? s = it as Square catch e { print(e.message); };
            if (s != null) { print("square " + string.from(s.side)); }
        }
    }
}
`, [
        "circle 2", "square 3", "cannot parse JSON: missing field at r",
    ]);
});

// A NUMBER node records that it holds an integer. A double would round this
// value.
test.start("lang: json big integer round trips", void () -> {
    h.expectOutput(`
import 'json';

Json? d = json.parse('{"id":9007199254740993,"f":0.5,"neg":-9007199254740993}')
    catch e { print(e.message); };
if (d != null) {
    print(json.toText(d));
    print(json.asInt(d["id"]) catch -1);
}
`, [
        "{\"id\":9007199254740993,\"f\":0.5,\"neg\":-9007199254740993}",
        "9007199254740993",
    ]);
});

test.start("lang: json composes", void () -> {
    h.expectOutput(`
import 'json';
import 'string';

type Log { int id; Json[] events; Map<String, Json> meta; }

Log? log = json.parse('{"id":42,"events":[1,"s",{"p":5},null,[1,2]],"meta":{"a":1,"b":"two"}}')
    as Log catch e { print(e.message); };

if (log != null) {
    print(log.id);
    forEach(log.events, e) { printInline(string.from(json.getType(e)) + " "); }
    print("");
    Json? a = log.meta["a"];
    if (a != null) { print(json.getType(a) == json.Type.NUMBER); }
    print(json.toText(log));
}
`, [
        "42", "NUMBER STRING OBJECT NULL ARRAY ", "true",
        "{\"id\":42,\"events\":[1,\"s\",{\"p\":5},null,[1,2]],\"meta\":{\"a\":1,\"b\":\"two\"}}",
    ]);
});

// A handler dispatches on Error.code (§2.9). The message is prose.
test.start("lang: error code", void () -> {
    h.expectOutput(`
import 'fs';

enum Mine { BAD_INPUT: 100, TOO_BIG: 101 }

// A library failure carries a code from the documented set.
byte[]? d = fs.readFile("no-such-file-anywhere.txt") catch e {
    print(e.code == fs.ErrorCode.NOT_FOUND);
    print(e.code == fs.ErrorCode.PERMISSION);
};
print(d == null);

// An Error written without one carries 0.
String plain() { return Error("plain"); }
String? a = plain() catch e { print(e.code); };

// And a program declares its own set, which widens to the int field.
String mine() { return Error("mine", Mine.TOO_BIG); }
String? b = mine() catch e {
    print(e.code == Mine.TOO_BIG);
    print(e.message);
};
print(a == null && b == null);
`, [
        "true", "false", "true", "0", "true", "mine", "true",
    ]);
});

// strict is a modifier only directly before an as. In other positions it is an
// ordinary name.
test.start("lang: strict is contextual", void () -> {
    h.expectOutput(`
import 'json';

type P { int n; }

int strict = 7;
print(strict);

// A variable called strict, and a strict parse, in the same expression.
P? p = json.parse('{"n":1}') strict as P catch e { print(e.message); };
if (p != null) { print(p.n + strict); }

void strictly(bool strict) { print(strict); }
strictly(true);
`, [
        "7", "8", "true",
    ]);
});

// The regexp language surface (§6.14). A RegExp is a value that a program can
// name, hold, pass and store. tests/regexp_test.nio tests the engine.
test.start("lang: regexp module", void () -> {
    h.expectOutput(`
import 'regexp';

RegExp mySearchRegexp = regexp.create("ab+c", "i");
print(regexp.find("xxABBBCyy", mySearchRegexp));
print(regexp.match("xxABBBCyy", mySearchRegexp));
print(regexp.match("xxacyy", mySearchRegexp));
print(regexp.find("nothing here", mySearchRegexp));

// The flags argument may be left off, which means no flags at all.
RegExp digits = regexp.create("[0-9]+");
print(regexp.find("abc 4321 def", digits));
print(regexp.match("abc", digits));

// A RegExp is an ordinary value: passed, returned, held in an array.
int countMatches(String[] lines, RegExp re) {
    int n = 0;
    forEach(lines, line) {
        if (regexp.match(line, re)) { n++; }
    }
    return n;
}
print(countMatches(["a1", "bb", "c3"], digits));

RegExp[] all = [mySearchRegexp, digits];
print(regexp.match("abbc", all[0]));
print(all.length);
`, [
        "2", "true", "false", "-1", "4", "false", "2", "true", "2",
    ]);
});

// One line for each construct in §6.14, so a missing construct fails here.
test.start("lang: regexp pattern syntax", void () -> {
    h.expectOutput(`
import 'regexp';

bool m(String pattern, String flags, String subject) {
    return regexp.match(subject, regexp.create(pattern, flags));
}

print(m("a.c", "", "abc"));            // . is any byte
print(m("a.c", "", "a\\nc"));           // but not a newline
print(m("a.c", "s", "a\\nc"));          // unless the s flag says so
print(m("^abc$", "", "abc"));          // anchors
print(m("^b", "", "a\\nb"));            // ^ is the text, not the line
print(m("^b", "m", "a\\nb"));           // until the m flag says otherwise
print(m("colou?r", "", "color"));      // ?
print(m("ab+c", "", "abbbc"));         // +
print(m("ab*c", "", "ac"));            // *
print(m("a{2,3}", "", "aa"));          // counted
print(m("a{4}", "", "aaa"));
print(m("cat|dog", "", "hotdog"));     // alternation
print(m("(ab)+c", "", "ababc"));       // groups
print(m("(?:ab)+c", "", "ababc"));     // and their non-capturing spelling
print(m("[aeiou]", "", "xyz"));        // classes
print(m("[^aeiou]", "", "xyz"));
print(m("[a-f]", "", "d"));
print(m("\\\\d\\\\d", "", "a42"));         // shorthands
print(m("\\\\w+", "", "  "));
print(m("\\\\s", "", "a b"));
print(m("\\\\bcat\\\\b", "", "the cat"));  // word boundaries
print(m("\\\\bcat\\\\b", "", "concat"));
print(m("a\\\\+b", "", "a+b"));          // escaped metacharacters
print(m("HELLO", "i", "hello"));       // case folding
print(m("[a-f]+", "i", "DEAF"));
`, [
        "true", "false", "true", "true", "false", "true", "true", "true", "true",
        "true", "false", "true", "true", "true", "false", "true", "true", "true",
        "false", "true", "true", "false", "true", "true", "true",
    ]);
});

// Patterns come from outside the program, so regexp.create is fallible (§6.14).
test.start("lang: regexp create is fallible", void () -> {
    h.expectOutput(`
import 'regexp';
import 'string';

RegExp? bad = regexp.create("a(b") catch e {
    print(e.message);
    // The library's one ErrorCode enum, named through the module that raised.
    print(e.code == regexp.ErrorCode.INVALID);
    print(e.code == string.ErrorCode.INVALID);
};
print(bad == null);

// The failure propagates like any other, so a function that compiles a
// pattern is inferred fallible without saying so.
RegExp compile(String p) { return regexp.create(p, "i"); }
RegExp? ok = compile("x+") catch e { print("unreachable"); };
print(ok != null);
RegExp? no = compile("[z-a]") catch e { print(string.contains(e.message, "range")); };
print(no == null);
`, [
        "regexp.create \"a(b\": unmatched (", "true", "true", "true", "true", "true",
        "true",
    ]);
});

test.start("lang: regexp bad pattern aborts", void () -> {
    h.expectRuntimeError(`
import 'regexp';

RegExp re = regexp.create("*oops");
print(regexp.match("x", re));
`, "regexp.create \"*oops\": nothing to repeat");
});

// Use of a RegExp that was never created is a program error. It cannot be
// caught.
test.start("lang: regexp uninitialized panics", void () -> {
    h.expectRuntimeError(`
import 'regexp';

RegExp re;
print(regexp.match("x", re));
`, "use of a RegExp that was never created");
});

// The engine is a Thompson NFA simulation (§6.14). A backtracking engine does
// not finish this case in practical time.
test.start("lang: regexp no catastrophic backtracking", void () -> {
    h.expectOutput(`
import 'regexp';

String subject = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
print(regexp.match(subject, regexp.create("(a+)+b")));
print(regexp.match(subject, regexp.create("(a|a)*b")));
print(regexp.match(subject, regexp.create("(a*)*b")));
print(regexp.match(subject + "b", regexp.create("(a+)+b")));
print(regexp.find(subject + "b", regexp.create("(a|aa)+b")));
`, [
        "false", "false", "false", "true", "0",
    ]);
});

// A record holds its own descriptor. In a base-typed slot, an extender keeps
// its fields, its tracing and its JSON form.
test.start("lang: sealed upcast", void () -> {
    h.expectOutput(`
import 'json';

sealed type Expr { int line; }
type IntLit extends Expr { int value; }
type Ident  extends Expr { String name; }

IntLit a = { line: 1, value: 42 };
Ident  b = { line: 2, name: "x" };

Expr e = a;
print(e.line);

Expr[] all = [a, b];
forEach(all, x) { print(x.line); }

// Serialized as the type it is, not the type of the slot it arrived in.
print(json.toText(e));
`, [
        "1", "1", "2", "{\"line\":1,\"value\":42}",
    ]);
});

test.start("lang: sealed downcast", void () -> {
    h.expectOutput(`
sealed type Expr { int line; }
type IntLit extends Expr { int value; }
type Ident  extends Expr { String name; }

IntLit a = { line: 1, value: 42 };
Ident  b = { line: 2, name: "x" };
Expr[] all = [a, b];

forEach(all, e) {
    IntLit? lit = e as IntLit;
    if (lit != null) { print("int", lit.value); }
    Ident? id = e as Ident;
    if (id != null) { print("ident", id.name); }
}
`, [
        "int 42", "ident x",
    ]);
});

// An exhaustive type switch needs no default and counts as terminating (§4.9).
test.start("lang: sealed type switch", void () -> {
    h.expectOutput(`
import 'string';

sealed type Expr { int line; }
type IntLit extends Expr { int value; }
type Ident  extends Expr { String name; }
type Binary extends Expr { String op; Expr left; Expr right; }

String render(Expr e) {
    switch (e) {
        case IntLit n:
            return string.from(n.value);
        case Ident n:
            return n.name;
        case Binary n:
            return "(" + render(n.left) + " " + n.op + " " + render(n.right) + ")";
    }
}

IntLit two = { line: 1, value: 2 };
Ident  x   = { line: 1, name: "x" };
Binary sum = { line: 1, op: "+", left: two, right: x };
Binary out = { line: 1, op: "*", left: sum, right: two };
print(render(out));
`, [
        "((2 + x) * 2)",
    ]);
});

// Narrowing makes the receiver's type known, so the override of that type runs.
test.start("lang: sealed method after narrowing", void () -> {
    h.expectOutput(`
sealed type Shape {
    int sides;
    String describe() { return "a shape"; }
}
type Square extends Shape {
    String override describe() { return "a square"; }
}
type Tri extends Shape {
    String override describe() { return "a triangle"; }
}

Square sq = { sides: 4 };
Tri    tr = { sides: 3 };
Shape[] shapes = [sq, tr];
forEach(shapes, s) {
    switch (s) {
        case Square q:
            print(q.describe());
        case Tri q:
            print(q.describe());
    }
}
`, [
        "a square", "a triangle",
    ]);
});

// The collector traces the extra reference fields of an extender that is in a
// base-typed slot.
test.start("lang: sealed upcast survives collection", void () -> {
    h.StressRun sr = h.runStressed(`
sealed type Node { int tag; }
type Labelled extends Node { String label; String[] parts; }

// The base-typed slot is what this is about, but a sealed type cannot be
// constructed (§2.4), so the slot is seeded with an extender.
Labelled seed = { tag: 0, label: "", parts: [] };
Node hold = seed;
int i;
while (i < 2000) {
    Labelled l = { tag: i, label: "n" + "ame", parts: ["a" + "b", "c" + "d"] };
    hold = l;
    i = i + 1;
}
Labelled? last = hold as Labelled;
if (last != null) {
    print(last.label, last.parts[0], last.parts[1], last.parts.length);
}
`);
    test.expectString(sr.stressed.out, "name ab cd 2\n");
});

// A sealed type is not one of its own extenders, so a value of it would match
// no clause of an exhaustive type switch (§4.9).
test.start("lang: a sealed type cannot be constructed", void () -> {
    h.expectCompileError(`
sealed type Shape { int sides; }
type Circle extends Shape { int r; }
Shape s = { sides: 7 };
`, "cannot construct Shape");
});

// The zero value of a sealed type is null. An exhaustive switch reports it at
// the switch, and not as a missing return several frames later.
test.start("lang: an unassigned sealed value is reported at the switch", void () -> {
    h.expectRuntimeError(`
sealed type Shape { int sides; }
type Circle extends Shape { int r; }
type Square extends Shape { int side; }

String name(Shape s) {
    switch (s) {
        case Circle c: return "circle";
        case Square q: return "square";
    }
}
Shape unset;
print(name(unset));
`, "switch on a Shape that was never assigned");
});

// A base-typed read is a load at a fixed offset valid for every extender.
test.start("lang: a sealed base still carries fields and recurses", void () -> {
    h.expectOutput(`
sealed type TypeNode { int line; }
type NameNode  extends TypeNode { String name; }
type ArrayNode extends TypeNode { TypeNode elem; }

int lineOf(TypeNode t) { return t.line; }

String render(TypeNode t) {
    switch (t) {
        case NameNode n:  return n.name;
        case ArrayNode n: return render(n.elem) + "[]";
    }
}

NameNode  i  = { line: 3, name: "int" };
ArrayNode ia = { line: 4, elem: i };
print(render(ia), lineOf(ia));
`, ["int[] 4"]);
});

// A union is a sealed base with one generated record for each member. Each
// record holds its value in a field that no identifier can name (§1.3). Rule 7
// wraps a value in its member.
test.start("lang: union wraps and matches", void () -> {
    h.expectOutput(`
import 'string';
union Text { String, byte[] Bytes }

String render(Text t) {
    switch (t) {
        case Text.String v: return "chars(" + v + ")";
        case Text.Bytes  v: return "bytes(" + string.fromByteArray(v) + ")";
    }
}

Text a = "hi";                          // rule 7: exactly one member accepts
Text b = string.toByteArray("raw");
print(render(a));
print(render(b));
`, ["chars(hi)", "bytes(raw)"]);
});

// A member typed with a single capitalized name takes its tag from the type.
test.start("lang: a union member tags itself", void () -> {
    h.expectOutput(`
import 'string';
enum ADC { IMM: 105, ZP: 101 }
enum AND { IMM: 41,  ZP: 37  }
union Opcode { ADC, AND }

String name(Opcode op) {
    switch (op) {
        case Opcode.ADC m: return "ADC " + string.from(m);
        case Opcode.AND m: return "AND " + string.from(m);
    }
}

Opcode a = ADC.IMM;
Opcode b = AND.ZP;
print(name(a));
print(name(b));
`, ["ADC IMM", "AND ZP"]);
});

// A function goes into a union only through a named member. §2.9 decides a
// literal's contract from its expected type, before rule 7 can infer a member.
test.start("lang: union construction names the member", void () -> {
    h.expectOutput(`
import 'string';
type Req { String path }
type Res { int status }

union Handler {
    Function(Req)<Res!>        Sync,
    Function(Req)<Future<Res>> Async
}

Res okSync(Req r)        { return { status: 200 }; }
Res badSync(Req r)       { return Error("boom"); }
Res async okAsync(Req r) { return { status: 202 }; }

Res async run(Handler h, Req req) {
    switch (h) {
        case Handler.Sync  f: return f(req) catch e { return { status: 500 }; };
        case Handler.Async f: return await f(req);
    }
}

Handler a = Handler.Sync(Res (Req r) -> okSync(r));
Handler b = Handler.Sync(Res (Req r) -> badSync(r));
Handler c = Handler.Async(Future<Res> (Req r) -> okAsync(r));
Req q = { path: "/" };
forEach([a, b, c], hh) {
    Res got = await run(hh, q);
    print(string.from(got.status));
}
`, ["200", "500", "202"]);
});

// The message names the tag in the source, never the generated record.
test.start("lang: a union switch must cover every member", void () -> {
    h.expectCompileError(`
union Text { String, byte[] Bytes, int Count }
String render(Text t) {
    switch (t) {
        case Text.String v: return "s";
        case Text.Bytes  v: return "b";
    }
}
print(render("hi"));
`, "add Text.Count");
});

// Two members can accept the same value, so the error is at the assignment.
test.start("lang: an ambiguous union member must be named", void () -> {
    h.expectCompileError(`
union Distance { float Meters, float Feet }
Distance d = 3.0;
print("unreachable");
`, "cannot tell which member of Distance");
});

// On a union, as gives the value the member holds, because no program can name
// the payload field.
test.start("lang: as narrows a union to what the member holds", void () -> {
    h.expectOutput(`
import 'string';
union Text { String, byte[] Bytes, int Count }
Text a = "hi";
Text b = 7;

String? s = a as Text.String;
if (s != null) { print("string: " + s); }
print(a as Text.Count == null);            // a is not a Count
int? m = b as Text.Count;
if (m != null) { print("count: " + string.from(m)); }
`, ["string: hi", "true", "count: 7"]);
});

// as only narrows (§3.6). When as is written towards a union, the error tells
// which direction is valid.
test.start("lang: as towards a union says which way it goes", void () -> {
    h.expectCompileError(`
union Text { String, byte[] Bytes }
Text greeting = "hello" as Text;
print("unreachable");
`, "String is already Text and needs no 'as'");
    h.expectCompileError(`
union Text { String, byte[] Bytes }
int n = 5;
Text t = n as Text;
print("unreachable");
`, "int is not Text, and 'as' cannot make it one: Text has members String, Bytes");
    // A hand-written sealed type has extenders and no members.
    h.expectCompileError(`
sealed type Shape { int sides; }
type Square extends Shape { int w; }
Square q = { sides: 4, w: 2 };
Shape s = q as Shape;
print("unreachable");
`, "'as' narrows Shape to one of the types extending it");
    // A pair that is not a narrowing or a conversion gets the JSON message.
    h.expectCompileError(`
int x = "s" as int;
print("unreachable");
`, "'as' reads JSON into a type");
});

// A member from another module takes three segments: alias, union and tag.
test.start("lang: a union crosses a module boundary", void () -> {
    h.expectFilesOutput([
        h.file("text.nio", `
export union Text { String, byte[] Bytes }
`),
        h.file("main.nio", `
import 'string';
import './text' as tx;

String render(tx.Text t) {
    switch (t) {
        case tx.Text.String v: return "chars(" + v + ")";
        case tx.Text.Bytes  v: return "bytes(" + string.fromByteArray(v) + ")";
    }
}
tx.Text a = "hi";
tx.Text b = string.toByteArray("raw");
print(render(a));
print(render(b));
String? s = a as tx.Text.String;
if (s != null) { print("as: " + s); }
`),
    ], "main.nio", ["chars(hi)", "bytes(raw)", "as: hi"]);
});

// A union reads JSON by kind (§6.3). The value's JSON kind selects the member,
// and the writer writes the payload with no wrapper.
test.start("lang: a union parses from JSON by kind and round-trips", void () -> {
    h.expectOutput(`
import 'json';
import 'string';

union Price { String, int Amount }

type Score { float average; int reviews }
union Rating { Score, String Note }

type Item {
    Price price;
    Rating rating;
}

String doc = '[{"price":"$16.99","rating":{"average":4.5,"reviews":10}},{"price":100,"rating":"nice"}]';
Item[] items = json.parse(doc) as Item[];
forEach(items, it) {
    switch (it.price) {
        case Price.String s: print("s " + s);
        case Price.Amount n: print("n " + string.from(n));
    }
}
print(json.toText(items) == doc);

// The tree form of "as" takes the same dispatch.
Json tree = json.parse(doc);
print(json.toText(tree as Item[]) == doc);

// A union value that was never parsed serializes the same way: the member
// is representation, and its generated field never shows.
Rating r = "great";
print(json.toText(r));
`, ["s $16.99", "n 100", "true", "true", '"great"']);
});

// A kind no member accepts fails at the value's path, in both forms of as.
test.start("lang: a union refuses a JSON kind no member takes", void () -> {
    h.expectOutput(`
import 'json';
union Price { String, int Amount }
type Item { Price price; }

Item? bad = json.parse('{"price":true}') as Item catch e { print(e.message); };
print(bad == null);
Json tree = json.parse('{"price":[1]}');
Item? bad2 = tree as Item catch e { print(e.message); };
print(bad2 == null);
`, [
        "cannot parse JSON: expected a string or a number at price",
        "true",
        "cannot parse JSON: expected a string or a number at price",
        "true",
    ]);
});

// JSON null belongs to an optional, never to a member.
test.start("lang: an optional union field takes JSON null", void () -> {
    h.expectOutput(`
import 'json';
union Price { String, int Amount }
type Item { Price? price; }

Item a = json.parse('{"price":null}') as Item;
Item b = json.parse('{}') as Item;
Item c = json.parse('{"price":7}') as Item;
print(a.price == null);
print(b.price == null);
Price? p = c.price;
if (p != null) { print(json.toText(p)); }
`, ["true", "true", "7"]);
});

// The dispatch is sound because no two members read from the same kind. The
// checker checks this where the as is written.
test.start("lang: a union the kinds cannot tell apart will not parse", void () -> {
    h.expectCompileError(`
import 'json';
union Bad { int I, float F }
Bad b = json.parse("1") as Bad;
`, "members I and F are both read from a number");
});

test.start("lang: a union with a Json member will not parse", void () -> {
    h.expectCompileError(`
import 'json';
union Bad { String, Json J }
Bad b = json.parse("1") as Bad;
`, "member J is a Json");
});

test.start("lang: a DateTime member reads as a string", void () -> {
    h.expectCompileError(`
import 'json';
union Bad { String, DateTime When }
Bad b = json.parse("1") as Bad;
`, "members String and When are both read from a string");
});

test.start("lang: a sealed type is not a JSON target", void () -> {
    h.expectCompileError(`
import 'json';
sealed type Shape { }
type Circle extends Shape { float r; }
Shape s = json.parse("{}") as Shape;
`, "Shape is sealed, and a document names no type to build");
});

// A literal's member comes from its written signature. Fallibility is the only
// difference a literal can cross, so this needs no tag.
test.start("lang: a function literal finds its union member", void () -> {
    h.expectOutput(`
import 'string';
type Req { String path }
type Res { int status }

union Handler {
    Function(Req)<Res!>        Sync,
    Function(Req)<Future<Res>> Async
}

Res okSync(Req r)        { return { status: 200 }; }
Res badSync(Req r)       { return Error("boom"); }
Res async okAsync(Req r) { return { status: 202 }; }

Res async run(Handler h, Req req) {
    switch (h) {
        case Handler.Sync  f: return f(req) catch e { return { status: 500 }; };
        case Handler.Async f: return await f(req);
    }
}

Handler a = Res (Req r) -> okSync(r);            // no tag written
Handler b = Res (Req r) -> badSync(r);
Handler c = Future<Res> (Req r) -> okAsync(r);

Req q = { path: "/" };
forEach([a, b, c], hh) {
    Res got = await run(hh, q);
    print(string.from(got.status));
}
`, ["200", "500", "202"]);
});

// An unknown tag is reported as a tag, never as an unknown module.
test.start("lang: a union reports an unknown tag", void () -> {
    h.expectCompileError(`
union Text { String, byte[] Bytes }
void f(Text t) {
    switch (t) {
        case Text.Nope v: return;
        default: return;
    }
}
`, "union Text has no member tagged");
});

// An async variadic packs its arguments before the frame is built.
test.start("lang: variadic across modules", void () -> {
    h.expectFilesOutput([
        h.file("strings.nio", `
export String join(String sep, ...String parts) {
    String out = "";
    forEach(parts, p, i) {
        if (i > 0) {
            out = out + sep;
        }
        out = out + p;
    }
    return out;
}
export int async count(...int ns) {
    return ns.length;
}
`),
        h.file("main.nio", `
import './strings.nio' as s;
print(s.join("-", "a", "b", "c"));
print(s.join("-"));
print(await s.count(1, 2, 3, 4));
`),
    ], "main.nio", ["a-b-c", "", "4"]);
});

// The module that declares the type emits its methods
// (@fn.<qual>.<Type>.<name>). An importer calls that module's body, also when
// the method is fallible.
test.start("lang: methods across modules", void () -> {
    h.expectFilesOutput([
        h.file("shapes.nio", `
export type Rect {
    int w;
    int h;

    int area() { return self.w * self.h; }

    void scale(int by) {
        self.w = self.w * by;
        self.h = self.h * by;
    }

    int checked() {
        if (self.w <= 0) {
            return Error("empty rect");
        }
        return self.area();
    }
}

export Rect unit = { w: 1, h: 1 };
`),
        h.file("main.nio", `
import './shapes.nio';

shapes.Rect r = { w: 3, h: 4 };
print(r.area());
r.scale(2);
print(r.area());
print(shapes.unit.area());
print(r.checked() catch -1);
r.w = 0;
print(r.checked() catch -1);
`),
    ], "main.nio", ["12", "48", "1", "48", "-1"]);
});

// array.sort calls back into Nio, so the comparator can allocate and collect at
// each comparison. Its scratch space is a second Nio array, rooted with the
// closure.
test.start("lang: GC stress array sort", void () -> {
    h.expectSameUnderStress(`
import 'array';
import 'string';
import 'json';

// Every comparison builds two strings, so under stress every comparison
// collects while the sort holds all 200 elements.
String[] words = [];
for (int i = 0; i < 200; i++) {
    array.push(words, string.append("w", string.from((i * 37) % 200)));
}
array.sort(words, bool (String x, String y) -> string.append(x, "!") < string.append(y, "!"));
print(words[0], words[1], words[199]);

// Record elements: pointers whose only root is the array being sorted.
type Item { String tag; int key; }
Item[] items = [];
for (int i = 0; i < 150; i++) {
    array.push(items, { tag: string.from(i), key: (i * 91) % 150 });
}
array.sort(items, bool (Item x, Item y) -> string.append(x.tag, "") != "" && x.key < y.key);
print(items[0].key, items[149].key, items[0].tag);

// slice's own allocation, with the source live across it.
int[] ns = [];
for (int i = 0; i < 100; i++) { array.push(ns, (i * 7) % 100); }
array.sort(ns);
print(array.indexOf(ns, 42), json.toText(array.slice(ns, 97)));
`, "w0 w1 w99\n0 149 0\n42 [97,98,99]\n");
});

// A compiled RegExp is one GC block with no pointers, so TD_REGEXP marks it and
// does not walk it. The block must still be marked.
test.start("lang: GC stress regexp", void () -> {
    h.expectContains(h.sameUnderStress(`
import 'regexp';
import 'string';

int hits = 0;
String last = "";
for (int i = 0; i < 200; i++) {
    RegExp re = regexp.create(string.append("a", "b+c"), string.toLowerCaseAscii("I"));
    if (regexp.match(string.append("xxAB", "BCyy"), re)) { hits++; }
    last = string.append("at ", string.from(regexp.find("zzabbc", re)));
}
print(hits);
print(last);

// A RegExp held across allocations of its own, and one that is only ever a
// temporary. Neither may be collected while it is in use.
RegExp kept = regexp.create("[0-9]+");
String junk = "";
for (int i = 0; i < 500; i++) { junk = string.append(junk, "x"); }
print(regexp.find(string.append(junk, "42"), kept));
print(regexp.match("7", regexp.create(string.append("[0-", "9]"))));
`), "200\nat 2\n500\ntrue");
});

// These sizes are where a bottom-up merge changes shape. The values repeat, so
// the sort has ties to break.
test.start("lang: array sort matches reference", void () -> {
    forEach([2, 3, 7, 8, 9, 33, 1000, 2001], n) {
        int[] values = [];
        for (int i = 0; i < n; i++) {
            array.push(values, (i * 7919) % 101);
        }
        String[] parts = [];
        forEach(values, v) {
            array.push(parts, string.from(v));
        }
        String literal = string.join(parts, ",");
        String[] wantParts = [];
        forEach(sortedCopy(values), v) {
            array.push(wantParts, string.from(v));
        }
        h.Run r = h.runProgram(`
import 'array';
import 'string';

int[] xs = [` + literal + `];
array.sort(xs);
String out = "";
forEach(xs, v, i) {
    if (i > 0) { out = out + ","; }
    out = out + string.from(v);
}
print(out);

// The comparator form over the same input must agree with it.
int[] ys = [` + literal + `];
array.sort(ys, bool (int a, int b) -> a < b);
String other = "";
forEach(ys, v, i) {
    if (i > 0) { other = other + ","; }
    other = other + string.from(v);
}
print(other == out);
`);
        if (r.code != 0) {
            return Error("n=" + string.from(n) + ": exit code " + string.from(r.code)
                + "\n" + r.err);
        }
        String want = string.join(wantParts, ",") + "\ntrue\n";
        if (r.out != want) {
            return Error("n=" + string.from(n) + ": got \"" + r.out + "\", want \""
                + want + "\"");
        }
    }
});

test.start("lang: array slice out of range", void () -> {
    String[] calls = [
        "array.slice(ns, 0, 9)", "array.slice(ns, -1)",
        "array.slice(ns, 3, 2)", "array.slice(ns, 5)",
    ];
    String[] wants = [
        "slice [0, 9) out of range (array length 4)",
        "slice [-1, 4) out of range (array length 4)",
        "slice [3, 2) out of range (array length 4)",
        "slice [5, 4) out of range (array length 4)",
    ];
    for (int i = 0; i < calls.length; i++) {
        h.expectRuntimeError(`
import 'array';
int[] ns = [1, 2, 3, 4];
` + calls[i] + `;
`, wants[i]);
    }
});

// substring's bounds are 0 <= start <= end <= length. It does not clamp them.
test.start("lang: string substring out of range", void () -> {
    forEach([
        `string.substring("abc", -1, 2);`, `string.substring("abc", 0, 4);`,
        `string.substring("abc", 2, 1);`,
    ], src) {
        h.expectRuntimeError("import 'string';\n" + src, "substring out of range");
    }
});

// as T reports the path in the document where it stopped. The walk builds the
// path as it descends.
test.start("lang: JSON parse errors", void () -> {
    String decl = `import 'json';
type Car { String make; int age; { int n; }[] parts; }
`;
    String[] srcs = [
        `Car c = json.parse('{"make":"v"}') as Car;`,
        `Car c = json.parse('{"make":"v","age":"old","parts":[]}') as Car;`,
        `Car c = json.parse('{"make":"v","age":1,"parts":[{"n":1},{"n":"x"}]}') as Car;`,
        `Car c = json.parse('{"make":null,"age":1,"parts":[]}') as Car;`,
        `Car c = json.parse('{"make":') as Car;`,
        `Car c = json.parse('[1,2]') as Car;`,
        `Car c = json.parse('{"make":"v","age":1,"parts":[]} junk') as Car;`,
    ];
    String[] wants = [
        "cannot parse JSON: missing field at age",
        "cannot parse JSON: expected a number at age",
        "cannot parse JSON: expected a number at parts[1].n",
        "unexpected null (the type is not optional) at make",
        "cannot parse JSON",
        "cannot parse JSON: expected an object",
        "trailing text after the value",
    ];
    for (int i = 0; i < srcs.length; i++) {
        h.expectRuntimeError(decl + srcs[i] + "\nprint(c.age);", wants[i]);
    }
});

// The runtime checks the narrow unsigned ranges when it reads JSON. lib/json.c
// keeps an integer too large for an int64 exact, and does not round it to a
// double.
test.start("lang: unsigned JSON range", void () -> {
    String[] types = ["uint8", "uint8", "uint16", "uint32", "uint64", "uint64", "uint8"];
    String[] docs = [
        `{"v":256}`, `{"v":-1}`, `{"v":65536}`, `{"v":4294967296}`,
        `{"v":18446744073709551616}`, `{"v":-1}`, `{"v":1.5}`,
    ];
    String[] wants = [
        "uint8 out of range at v", "uint8 out of range at v",
        "uint16 out of range at v", "uint32 out of range at v",
        "uint64 out of range at v", "uint64 out of range at v",
        "expected a whole number at v",
    ];
    for (int i = 0; i < types.length; i++) {
        h.expectRuntimeError(`
import 'json';
type T { ` + types[i] + ` v; }
T t = json.parse('` + docs[i] + `') as T;
`, wants[i]);
    }

    // The largest uint64 is valid. A double would round it to 2^64 and reject
    // it.
    h.expectOutput(`
import 'json';
type T { uint64 v; }
T t = json.parse('{"v":18446744073709551615}') as T;
print(t.v);
print(json.toText(t));
`, ["18446744073709551615", `{"v":18446744073709551615}`]);
});

// A file claims a module name only for itself, so another module can export
// the same name.
test.start("lang: library name is per file", void () -> {
    h.expectFilesOutput([
        h.file("routes.nio", `
export String path = "/from/routes";
export String fs(String s) { return s + "!"; }
`),
        h.file("main.nio", `
import 'path';
import './routes.nio' as r;
print(path.join("a", "b"));
print(r.path, r.fs("x"));
`),
    ], "main.nio", [path.join("a", "b"), "/from/routes x!"]);
});

// Each print argument is live while the next one allocates, so all of them are
// rooted before the call.
test.start("lang: print arguments survive collection", void () -> {
    h.expectOutput(`
String repeat(String s, int n) {
    String out = "";
    for (int i = 0; i < n; i++) {
        out = out + s;
    }
    return out;
}
print(repeat("a", 3), repeat("b", 4), repeat("c", 5));
`, ["aaa bbbb ccccc"]);
});

// Counted repeats multiply, so a length check alone cannot find a pattern whose
// compiled size is too large. Both failures are errors that a program can
// catch.
test.start("lang: regexp long patterns", void () -> {
    String long = repeat("a", 15000);
    String[] branches = [];
    for (int i = 0; i < 4000; i++) {
        array.push(branches, "kw" + string.from(i));
    }
    h.expectOutput(`
import 'regexp';

RegExp cat = regexp.create("` + long + `");
print(regexp.match("` + long + `", cat));
print(regexp.match("` + repeat("a", 14999) + `", cat));

RegExp alt = regexp.create("` + string.join(branches, "|") + `");
print(regexp.find("zzkw3999yy", alt));
print(regexp.match("nope", alt));

// Over the length limit, which is an ordinary catchable failure.
RegExp? huge = regexp.create("` + repeat("b", 33000) + `") catch e {
    print(e.message);
};
print(huge == null);

// And the one the length limit cannot catch, since counted repeats multiply.
RegExp? blown = regexp.create("(a{1000}){1000}") catch e { print(e.message); };
print(blown == null);
`, [
        "true", "false", "2", "false",
        `regexp.create "` + repeat("b", 200) + `": pattern too long`, "true",
        `regexp.create "(a{1000}){1000}": pattern too large`, "true",
    ]);
});

// ---- §3.1 bitwise operators ----
// Each expected value is calculated by hand from the bit patterns.
test.start("lang: bitwise operators", void () -> {
    h.expectOutput(`
int a = 12;      // 1100
int b = 10;      // 1010
print(a & b, a | b, a ^ b, ~a);
print(a << 3, a >> 2, -13 >> 2);

// The two families shift right differently, and that is the whole
// difference: signed fills with the sign, unsigned with zeros.
uint u = 12;
uint zero = 0;
uint all = ~zero;
print(u >> 2, ~u, all >> 60);

// & binds like *, and | and ^ bind like +. So the
// comparison below means what it looks like:
// (a & 12) == 12.
print(1 | 2 ^ 3 & 2);
print(a & 12 == 12);
`, [
        "8 14 6 -13", "96 3 -4",
        "3 18446744073709551603 15", "1", "true",
    ]);
});

// A shift past the width has a defined result (§3.1). LLVM's shl gives poison
// there.
test.start("lang: shifts past the width", void () -> {
    h.expectOutput(`
uint zero = 0;
uint all = ~zero;
int n = 64;
print(1 << 64, 1 << n, -1 >> 64, -1 >> n);
print(all >> 64, all >> n);
// A variable count in range still shifts.
int two = 2;
print(12 >> two, 12 << two);
`, ["0 0 -1 -1", "0 0", "3 48"]);
});

// A narrow operand shifts as its value, and not as the 8-byte unit that holds
// it. genShift does not extend it, because the unit holds the value already
// extended by its family.
test.start("lang: shifts on narrow types", void () -> {
    h.expectOutput(`
byte b = 200;
print(b >> 1, getType(b >> 1));       // unsigned: zeros come in
int8 x = -100;
print(x >> 1, getType(x >> 1));       // signed: the sign comes in

// The count carries no family of its own (§3.1), so either family may
// count for either.
int i = -16;
uint c = 2;
print(i >> c, getType(i >> c));
uint u = 16;
int c2 = 2;
print(u >> c2, getType(u >> c2));
`, ["100 uint", "-50 int", "-4 int", "4 uint"]);
});

test.start("lang: negative shift count", void () -> {
    h.expectRuntimeError(`
int n = -1;
print(1 << n);
`, "negative shift count");
});

// ---- §3.6 numeric conversion ----
// Each operator widens (§2.1), so as is the only way back to a narrow type.
test.start("lang: numeric conversion", void () -> {
    h.expectOutput(`
byte a = 200;
byte b = 55;
byte[] out = [0, 0];
out[0] = (a + b) as byte;        // 255 exactly
out[1] = (a + b + 1) as byte;    // 256, which wraps
print(out[0], out[1]);
print(getType((a + b) as byte));

// Reinterpreting between the families at one width, which assignment
// refuses and this is the only spelling of.
int i = -1;
uint u = 4294967296;
print(i as uint);
print(u as uint32, u as int);

// A float narrows in precision rather than in range.
float f = 0.1;
print(f as float32);
`, ["255 0", "uint8", "18446744073709551615", "0 4294967296", "0.1"]);
});

test.start("lang: numeric conversion refusals", void () -> {
    h.expectCompileError(`
int i = 3;
print(i as float);
`, "'as' does not convert between int and float");
    h.expectCompileError(`
import 'time';
DateTime t = time.now();
print(t as int);
`, "say so with time.milliseconds(x)");
});

// ---- §6.6 constant-time comparison ----
test.start("lang: constant-time comparison", void () -> {
    h.expectOutput(`
import 'string';

String token = "s3cr3t-token";
print(string.equalsConstantTime(token, "s3cr3t-token"));
print(string.equalsConstantTime(token, "s3cr3t-tokeX"));
print(string.equalsConstantTime(token, "x"));
print(string.equalsConstantTime("", ""));

byte[] mac = string.toByteArray("abc");
print(string.bytesEqualConstantTime(mac, string.toByteArray("abc")));
print(string.bytesEqualConstantTime(mac, string.toByteArray("abd")));
print(string.bytesEqualConstantTime(mac, string.toByteArray("ab")));
print(string.bytesEqualConstantTime([], []));
`, ["true", "false", "false", "true", "true", "false", "false", "true"]);
});

// ---- §2.12 noalloc ----
test.start("lang: noalloc bodies", void () -> {
    h.expectOutput(`
import 'string';

int noalloc ctSelect(int cond, int a, int b) {
    int mask = -cond;                    // 0 or -1, no branch
    return (a & mask) | (b & ~mask);
}

void noalloc xorInto(byte[] buf, byte[] key) {
    for (int i = 0; i < buf.length; i++) {
        buf[i] = (buf[i] ^ key[i % key.length]) as byte;
    }
}

// A noalloc body may call another, and may use the allocation-free
// built-ins.
bool noalloc sameLength(String a, String b) {
    return string.length(a) == string.length(b);
}

int noalloc twice(int x) { return ctSelect(1, x + x, 0); }

print(ctSelect(1, 42, 99), ctSelect(0, 42, 99));
print(twice(21));
print(sameLength("abc", "xyz"), sameLength("abc", "xy"));

byte[] data = string.toByteArray("hello world");
byte[] key = string.toByteArray("k3y");
xorInto(data, key);
print(string.equalsConstantTime(string.fromByteArray(data), "hello world"));
xorInto(data, key);
print(string.fromByteArray(data));
`, ["42 99", "42", "true false", "false", "hello world"]);
});

// Each way that a body can allocate is refused. The cases are the complement
// of the whitelist in noteAlloc.
test.start("lang: noalloc refusals", void () -> {
    h.expectCompileError(`String noalloc f() { return "a" + "b"; }`,
        "joining strings allocates the new one");
    h.expectCompileError(`int[] noalloc f() { return [1, 2]; }`,
        "an array literal allocates the array");
    h.expectCompileError(`type P { int x; }
P noalloc f() { P p = { x: 1 }; return p; }`,
        "a record literal allocates the record");
    h.expectCompileError(`Map<String, int> noalloc f() { return {"a": 1}; }`,
        "a map literal allocates the map");
    h.expectCompileError(`int noalloc f() { int? x = 1; return 0; }`,
        "declaring x optional means boxing what goes in it");
    h.expectCompileError(`int? noalloc f() { return 1; }`,
        "returning an optional means boxing the value");
    h.expectCompileError(`int noalloc f(int? x) { return 1; }`,
        "an optional parameter means its caller boxes the value");
    h.expectCompileError(`int noalloc f() { return g(); }
int g() { return 1; }`,
        "g is not declared noalloc");
    h.expectCompileError(`void noalloc f() { Function(int)<int> g = int (int x) -> x; }`,
        "a function value allocates the block");
    h.expectCompileError(`int noalloc f() { return Error("x").code; }`,
        "an Error is a record, so building one allocates it");
    h.expectCompileError(`import 'string';
String noalloc f(String s) { return string.trim(s); }`,
        "string.trim allocates the value it answers");
    h.expectCompileError(`import 'time';
void noalloc f() { print(time.now()); }`,
        "time.now allocates the value it answers");
    // An async function allocates its frame before the body runs.
    h.expectCompileError(`void noalloc async f() { }`,
        "cannot be both async and noalloc");
});

// print writes through a stack buffer for every type but DateTime.
test.start("lang: noalloc and print", void () -> {
    h.expectOutput(`
void noalloc f(int n) {
    print("n is", n, getType(n));
}
f(7);
`, ["n is 7 int"]);
    h.expectCompileError(`import 'time';
void noalloc f(DateTime t) { print(t); }`,
        "printing a DateTime allocates the text it is rendered into");
});

test.start("lang: noalloc is contextual", void () -> {
    h.expectOutput(`
int noalloc = 5;
void noalloc2() { print(noalloc); }
noalloc2();
print(noalloc + 1);
`, ["5", "6"]);
});

// ---- §5.7 packing ----
// An element occupies its own width. A program cannot see the layout, so a
// wrong width shows as a wrong number.
test.start("lang: packed array elements round-trip at every width", void () -> {
    h.expectOutput(`
int8[] a8 = [-128, 127, -1, 0];
uint8[] b8 = [0, 255, 128, 1];
int16[] a16 = [-32768, 32767, -1, 0];
uint16[] b16 = [0, 65535, 32768, 1];
int32[] a32 = [-2147483648, 2147483647, -1, 0];
uint32[] b32 = [0, 4294967295, 2147483648, 1];
float32[] f32 = [0.5, -0.5, 3.25, 0.0];
bool[] bs = [true, false, true, false];

print(a8[0], a8[1], a8[2], a8[3]);
print(b8[0], b8[1], b8[2], b8[3]);
print(a16[0], a16[1], a16[2], a16[3]);
print(b16[0], b16[1], b16[2], b16[3]);
print(a32[0], a32[1], a32[2], a32[3]);
print(b32[0], b32[1], b32[2], b32[3]);
print(f32[0], f32[1], f32[2], f32[3]);
print(bs[0], bs[1], bs[2], bs[3]);

// Written back through the other path: an assignment rather than a literal.
a8[0] = 127; b8[0] = 255; a16[0] = 32767; b16[0] = 65535;
a32[0] = 2147483647; b32[0] = 4294967295; f32[0] = -3.25; bs[0] = false;
print(a8[0], b8[0], a16[0], b16[0]);
print(a32[0], b32[0], f32[0], bs[0]);

// And read back through forEach, which loads an element by a third path.
forEach(a8, v) { printInline(v, " "); }
print("");
forEach(f32, v) { printInline(v, " "); }
print("");
`, [
        "-128 127 -1 0",
        "0 255 128 1",
        "-32768 32767 -1 0",
        "0 65535 32768 1",
        "-2147483648 2147483647 -1 0",
        "0 4294967295 2147483648 1",
        "0.5 -0.5 3.25 0",
        "true false true false",
        "127 255 32767 65535",
        "2147483647 4294967295 -3.25 false",
        "127  127  -1  0  ",
        "-3.25  -0.5  3.25  0  ",
    ]);
});

// The array library reads and writes elements in C, through rt_arr_get and
// rt_arr_set.
test.start("lang: the array library at every width", void () -> {
    h.expectOutput(`
import 'array';

byte[] b = [3, 1, 2];
array.push(b, 255 as byte);
array.push(b, 0 as byte);
print(b.length, b[3], b[4]);
print(array.pop(b));
print(array.indexOf(b, 255 as byte), array.indexOf(b, 9 as byte));
array.sort(b);
print(b[0], b[1], b[2], b[3]);
byte[] bs = array.slice(b, 1, 3);
print(bs.length, bs[0], bs[1]);

int8[] s = [3, -128, 127, -1];
array.sort(s);
print(s[0], s[1], s[2], s[3]);

int16[] w = [300, -300, 0];
array.sort(w);
print(w[0], w[1], w[2]);

float32[] f = [2.5, -1.25, 0.5];
array.sort(f);
print(f[0], f[1], f[2]);

// A comparator takes its arguments as the unit, so a narrow element reaches
// it widened. This is where packing could change what a program's own
// code sees.
int8[] c = [1, -2, 3];
array.sort(c, bool (int8 x, int8 y) -> { return x * x < y * y; });
print(c[0], c[1], c[2]);

uint32[] u = [4294967295, 0, 7];
array.sort(u);
print(u[0], u[1], u[2]);
`, [
        "5 255 0", "0", "3 -1", "1 2 3 255", "2 2 3",
        "-128 -1 3 127",
        "-300 0 300",
        "-1.25 0.5 2.5",
        "1 -2 3",
        "0 7 4294967295",
    ]);
});

// The JSON reader and writer access an element at a width that only the
// TypeDesc knows.
test.start("lang: packed arrays through JSON", void () -> {
    h.expectOutput(`
import 'json';

int8[] a8 = [-128, 127];
uint8[] b8 = [0, 255];
int16[] a16 = [-32768, 32767];
uint16[] b16 = [0, 65535];
int32[] a32 = [-2147483648, 2147483647];
uint32[] b32 = [0, 4294967295];
float32[] f32 = [0.5, -3.25];

// No literal can name the top half of a uint64 (§1.6), so it is reached by
// arithmetic. Packing does not change this row: a uint64 is the 8-byte unit
// itself, so a wrong widening shows as a wrong number. That is why it is
// here.
uint64 d = 9223372036854775807;
uint64[] a64 = [0, d + d + 1];

print(json.toText(a8), json.toText(b8));
print(json.toText(a16), json.toText(b16));
print(json.toText(a32), json.toText(b32));
print(json.toText(a64));
print(json.toText(f32));

int8[] r8 = json.parse("[-128,127]") as int8[];
uint16[] r16 = json.parse("[0,65535]") as uint16[];
uint64[] r64 = json.parse("[18446744073709551615]") as uint64[];
float32[] rf = json.parse("[0.5,-3.25]") as float32[];
print(r8[0], r8[1], r16[0], r16[1]);
print(r64[0]);
print(rf[0], rf[1]);

// Out of range on the way in is still refused at the element's own width.
uint8[]? bad = json.parse("[256]") as uint8[] catch e { print(e.message); };
`, [
        "[-128,127] [0,255]",
        "[-32768,32767] [0,65535]",
        "[-2147483648,2147483647] [0,4294967295]",
        "[0,18446744073709551615]",
        "[0.5,-3.25]",
        "-128 127 0 65535",
        "18446744073709551615",
        "0.5 -3.25",
        "cannot parse JSON: uint8 out of range at [0]",
    ]);
});

// A byte[] and a String are the same bytes with a different header, so a
// conversion between them is a copy. A byte stays unsigned (§2.1) in each
// direction.
test.start("lang: byte arrays are bytes", void () -> {
    h.expectOutput(`
import 'string';
import 'array';

String s = "héllo";
byte[] b = string.toByteArray(s);
print(b.length, b[0], b[1], b[2]);
print(string.fromByteArray(b) == s);
print(s[1]);

// A large one, where a wrong width would run off the end rather than merely
// read the wrong number.
String[] parts = [];
for (int i = 0; i < 20000; i++) { array.push(parts, "xyzzy"); }
byte[] big = string.toByteArray(string.join(parts, ""));
print(big.length, big[0], big[99999]);
print(string.length(string.fromByteArray(big)));
`, ["6 104 195 169", "true", "195", "100000 120 121", "100000"]);
});

// map.keys and map.values return arrays packed at the element width (§5.7).
test.start("lang: map keys and values become packed arrays", void () -> {
    h.expectOutput(`
import 'map';

Map<String, int32> m = { "a": 2147483647, "b": -2147483648 };
int32[] vs = map.values(m);
print(vs.length, vs[0], vs[1]);

Map<byte, String> k = { 255: "hi", 0: "lo" };
byte[] ks = map.keys(k);
print(ks.length, ks[0], ks[1]);
`, ["2 2147483647 -2147483648", "2 255 0"]);
});

// A record's fields have their own widths and alignments (§5.7). This order
// puts them at 8, 10, 16, 24, 28, 32 and 40, with padding at 9 and 25..27.
test.start("lang: packed record fields round-trip at every width", void () -> {
    h.expectOutput(`
type P {
    byte a;
    int16 b;
    int c;
    bool d;
    float32 e;
    String s;
    uint32 u;

    int sum() { return self.a + self.b; }
}

P? pick(P v) { return v; }

P p = { a: 255, b: -32768, c: 1234567890123456, d: true, e: 3.25, s: "hi", u: 4294967295 };
print(p.a, p.b, p.c, p.d);
print(p.e, p.s, p.u);
print(p.sum());

p.a = 0; p.b = 32767; p.d = false; p.u = 0; p.e = 0.1;
print(p.a, p.b, p.d, p.u);
// The store *is* the rounding onto the binary32 grid: 0.1 read back is the
// float32 0.1, not the double.
print(p.e == 0.1, p.e == (0.1 as float32));

// ++ exists only at natural width (narrow arithmetic widens), so a member
// target is always an 8-byte field, reached through the same packed slot.
p.c++;
print(p.c);

// An optional chain re-boxes the widened unit (flow narrowing makes a
// directly-assigned optional non-null, so the maybe goes through a call).
byte? oa = pick(p)?.a;
int16? ob = pick(p)?.b;
print(oa, ob);
`, [
        "255 -32768 1234567890123456 true",
        "3.25 hi 4294967295",
        "-32513",
        "0 32767 false 0",
        "false true",
        "1234567890123457",
        "0 32767",
    ]);
});

// An extender puts the base's fields first, so a base-typed read uses the
// base's offsets on the extender's block.
test.start("lang: extends keeps a packed base's offsets", void () -> {
    h.expectOutput(`
import 'json';

sealed type Shape {
    byte tag;
    int16 w;
}
type Circle extends Shape {
    float32 r;
    String name;
}
type Square extends Shape {
    int side;
}

int width(Shape s) { return s.w; }

Circle c = { tag: 7, w: -12345, r: 2.5, name: "round" };
Square q = { tag: 9, w: 31000, side: 4 };
print(width(c), width(q), c.tag, q.tag);

Shape s = c;
switch (s) {
    case Circle cc:
        print(cc.name, cc.r);
    case Square qq:
        print("wrong");
}
// The stamp in slot [0], not the static type, is what serializes: the
// extender's fields survive a trip through a base-typed slot.
print(json.toText(s));
`, [
        "-12345 31000 7 9",
        "round 2.5",
        `{"tag":7,"w":-12345,"r":2.5,"name":"round"}`,
    ]);
});

// The JSON reader stores at the field's width (rt_rec_set), and the writer
// loads at that width (rt_rec_get). An offset is not 8 + index*8.
test.start("lang: packed record fields through JSON", void () -> {
    h.expectOutput(`
import 'json';

type N {
    int8 a;
    uint16 b;
    float32 e;
    bool d;
}

N n = json.parse("{\\"a\\":-128,\\"b\\":65535,\\"e\\":-3.25,\\"d\\":true}") as N;
print(n.a, n.b, n.e, n.d);
print(json.toText(n));

N? bad = json.parse("{\\"a\\":128,\\"b\\":0,\\"e\\":0,\\"d\\":false}") as N catch e { print(e.message); };

type Cfg {
    uint8 level;
    Json extra 'json*';
    int16 port;
}

Cfg cfg = json.parse("{\\"level\\":9,\\"port\\":-1000,\\"zip\\":\\"kept\\"}") as Cfg;
print(cfg.level, cfg.port);
print(json.toText(cfg));
`, [
        "-128 65535 -3.25 true",
        `{"a":-128,"b":65535,"e":-3.25,"d":true}`,
        "cannot parse JSON: int8 out of range at a",
        "9 -1000",
        // The preserved key comes out at the catch-all's declared position.
        `{"level":9,"zip":"kept","port":-1000}`,
    ]);
});

// A union member is a record with one field. A narrow payload is at offset 8,
// at its own width.
test.start("lang: a union member holds a narrow payload", void () -> {
    h.expectOutput(`
union Pick { byte Small, String Text }

Pick p = 200 as byte;
switch (p) {
    case Pick.Small b:
        print(b);
    case Pick.Text t:
        print("wrong");
}
byte? b = p as Pick.Small;
print(b);
Pick t = "words";
print(t as Pick.Text);
`, ["200", "200", "words"]);
});

// Zero values are built field by field over the packed layout.
test.start("lang: zero values of packed records", void () -> {
    h.expectOutput(`
type Z {
    byte a;
    int16 b;
    float32 e;
    bool d;
    String s;
}
Z[2] zs;
print(zs[0].a, zs[0].b, zs[0].e, zs[0].d);
print(zs[1].s == "", zs[1].a);
`, ["0 0 0 false", "true 0"]);
});

// A map's entry blocks hold keys and values at their own widths (§5.7). The
// 255 key and the signed value test the extension. A wrong extension loses the
// entry.
test.start("lang: a map's entries occupy their widths", void () -> {
    h.expectOutput(`
import 'map';
import 'string';
import 'json';

Map<byte, int16> m = {};
int i = 0;
while (i < 20) {
    m[(i * 3) as byte] = (-100 * i) as int16;
    i++;
}
print(m.length, m[0] == 0, m[57] == -1900, map.has(m, 58));
map.remove(m, 30);
byte[] ks = map.keys(m);
int16[] vs = map.values(m);
print(ks.length, ks[9], ks[10], vs[10]);
Map<byte, int16> mc = map.copy(m);
mc[255] = -1;
print(mc.length, m.length, mc[255] == -1);

Map<bool, byte> flags = {};
flags[true] = 200;
flags[false] = 100;
print(flags[true], flags[false]);

Map<String, byte> jm = {};
jm["x"] = 7;
jm["y"] = 255;
String js = json.toText(jm);
print(js);
Map<String, byte> back = json.parse(js) as Map<String, byte> catch {};
print(back["x"], back["y"], back.length);
`, [
        "20 true true false",
        "19 27 33 -1100",
        "20 19 true",
        "200 100",
        `{"x":7,"y":255}`,
        "7 255 2",
    ]);
});

// An optional's box holds the inner value at its own width (§5.7). Each reader
// extends the value by the family of the inner type.
test.start("lang: an optional's box holds its inner at its width", void () -> {
    h.expectOutput(`
byte? pb(byte v) { return v; }
int16? ps(int16 v) { return v; }
float32? pf(float32 v) { return v; }
bool? pt(bool v) { return v; }
uint64? pu(uint64 v) { return v; }

byte? b = pb(200);
print(b);
if (b != null) {
    print(b + 1);
}
print(b == pb(200), b == pb(3), b == null);
int16? s = ps(-300);
print(s, s == ps(-300));
float32? f = pf(1.5);
print(f);
bool? t = pt(true);
print(t, t == pt(false));
uint64? u = pu(9000000000000000000);
print(u == pu(9000000000000000000));
`, [
        "200",
        "201",
        "true false false",
        "-300 true",
        "1.5",
        "true false",
        "true",
    ]);
});

// A captured variable's box is packed like an optional's box (§5.7). The
// closure and the frame must read the same cell, or the counter splits in two.
test.start("lang: a captured variable's box is packed", void () -> {
    h.expectOutput(`
byte counter = 10;
Function()<void> bump = void () -> {
    counter = (counter + 95) as byte;
};
bump();
print(counter);
bump();
print(counter);    // 200: still one byte, zero-extended back out

float32 fs = 1.0;
Function()<float> read = float () -> { return fs; };
Function()<void> half = void () -> {
    fs = (fs + 0.25) as float32;
};
half();
print(fs, read());

int16 low = -32768;
Function()<void> wrap = void () -> {
    low = ((low + 1) - 1) as int16;
};
wrap();
print(low);
`, ["105", "200", "1.25 1.25", "-32768"]);
});

test.start("lang: string interpolation and the later escapes", void () -> {
    // The test program is in a backtick string, so its holes are escaped.
    h.expectOutput(`
import 'string';
String who = "world";
int n = 3;
float f = 1.5;
bool b = true;
print(\`hello \${who}, n = \${n + 1}, f = \${f}, b = \${b}\`);
print(\`\${n}\`);
print(\`\${n}\${n}\`);
type P { int x; String tag; }
P p = { x: 7, tag: "t" };
print(\`x=\${p.x} tag=\${p.tag} nested=\${\`<\${p.x}>\`}\`);
print(\`brace \${ (int () -> { return n + 2; })() } done\`);
print(\`a\\\${b} $c\`);
String multi = \`one \${n}
two \${who}\`;
print(multi);
print("\\x41\\x42" == "AB");
print(string.length("\\r\\0\\t") == 3);
print(string.toByteArray("\\r\\0")[0] == 13 && string.toByteArray("\\r\\0")[1] == 0);
`, [
        "hello world, n = 4, f = 1.5, b = true", "3", "33", "x=7 tag=t nested=<7>",
        "brace 5 done", "a${b} $c", "one 3", "two world", "true", "true", "true",
    ]);
});

test.start("lang: forEach over a String walks code points", void () -> {
    h.expectOutput(`
import 'string';
String s = "héllo";
forEach(s, r, i) {
    print(string.from(i) + " " + string.from(r) + " " + string.fromRunes([r]));
}
int n = 0;
forEach("😀a", r) {
    n = n + r;
}
print(n);
print(string.runeCount("café"));
print(string.length("café"));
print(string.runeAt("héllo", 1));
print(string.isValidUtf8("café"));
print(string.isValidUtf8(string.substring("café", 0, 4)));
print(string.isValidUtf8(string.fromByteArray([0xC0, 0x80])));
// An invalid byte is U+FFFD one byte wide, so the walk ends and skips nothing.
String bad = string.fromByteArray([65, 0xFF, 66]);
forEach(bad, r, i) {
    print(string.from(i) + ":" + string.from(r));
}
print(string.runeCount(bad));
print(string.fromRunes([104, 233, 0x1F600]) == "hé😀");
print(string.length(string.fromRunes([0xD800, -1, 0x110000])));
print(string.toUpperCaseAscii("straße") == "STRAßE");
print(string.toLowerCaseAscii("ÀB") == "Àb");
int total = 0;
forEach("abc", r, i) {
    if (r == 98) {
        continue;
    }
    total = total + i;
}
print(total);
`, [
        "0 104 h", "1 233 é", "3 108 l", "4 108 l", "5 111 o", "128609", "4", "5", "233",
        "true", "false", "false", "0:65", "1:65533", "2:66", "3", "true", "9", "true",
        "true", "2",
    ]);
});
