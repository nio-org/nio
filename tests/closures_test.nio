// Function values and closures, end to end.
import 'test';
import './harness' as h;

test.start("closures: function values", void () -> {
    h.expectOutput(`
Function(int)<int> sumAll(int a) {
    Function(int)<int> sum = int (int b) -> a + b;
    return sum;
}

Function()<void> greeter() {
    Function()<void> hi = void () -> { print("hi"); };
    return hi;
}

int apply(Function(int)<int> f, int x) {
    return f(x);
}

Function(int)<int> add10 = sumAll(10);
print(add10(5));
greeter()();
print(apply(int (int n) -> n * 2, 21));
print((int (int n) -> n + 1)(41));
`, [
        "15", "hi", "42", "42",
    ]);
});

test.start("closures: closure captures by reference", void () -> {
    h.expectOutput(`
Function()<int> counter() {
    int n = 0;
    return int () -> {
        n = n + 1;
        return n;
    };
}

Function()<int> c = counter();
Function()<int> d = counter();
print(c());
print(c());
print(d());

int seen = 0;
Function()<void> watch = void () -> { print(seen); };
seen = 7;
watch();

int bumped = 0;
Function()<void> bump = void () -> { bumped++; };
bump();
bump();
print(bumped);
`, [
        "1", "2", "1", "7", "2",
    ]);
});

test.start("closures: closure captures params and nesting", void () -> {
    h.expectOutput(`
Function(int)<Function(int)<int>> makeAdder = Function(int)<int> (int a) -> int (int b) -> a + b;
print(makeAdder(40)(2));

// The inner value captures both the outer parameter and an outer local.
Function(int)<int> scaled(int factor) {
    int offset = 100;
    return int (int x) -> x * factor + offset;
}
print(scaled(3)(14));
`, [
        "42", "142",
    ]);
});

test.start("closures: closures in loops", void () -> {
    h.expectOutput(`
import 'array';

// forEach bindings are per iteration: each closure keeps its own element.
Function()<int>[] fns = [];
forEach([10, 20, 30], e, i) {
    array.push(fns, int () -> e + i);
}
print(fns[0]());
print(fns[1]());
print(fns[2]());

// A for-loop variable is one binding for the whole loop, shared by every
// closure created in it.
Function()<int>[] shared = [];
for (int k = 0; k < 3; k++) {
    array.push(shared, int () -> k);
}
print(shared[0]());
print(shared[2]());
`, [
        "10", "21", "32", "3", "3",
    ]);
});

test.start("closures: function values are first class", void () -> {
    h.expectOutput(`
import 'array';

type Handler {
    String name;
    Function(int)<int> run;
}

Handler h = { name: "double", run: int (int x) -> x * 2 };
print(h.run(8));
h.run = int (int x) -> x + 1;
print(h.run(8));

Function(String)<String>[] funcs = [String (String s) -> s + "!", String (String s) -> s + "?"];
forEach(funcs, f) {
    print(f("ok"));
}

Function(int)<int>? maybe = null;
if (maybe == null) {
    print("absent");
}
maybe = int (int x) -> x + 1;
if (maybe != null) {
    print(maybe(41));
}
`, [
        "16", "9", "ok!", "ok?", "absent", "42",
    ]);
});

test.start("closures: function value runtime errors", void () -> {
    h.expectRuntimeError(`
Function()<void> f;
f();
`, "called a function value that was never assigned");
    h.expectRuntimeError(`
type H { Function()<int> run; }
H[2] hs;
print(hs[0].run());
`, "called a function value that was never assigned");
    h.expectRuntimeError(`
Function(bool)<int> f = int (bool b) -> {
    if (b) {
        return 1;
    }
};
print(f(false));
`, "missing return in function value");
});

// A function value crosses the module boundary as an ordinary value. The
// exported one is a variable, so an assignment through the alias replaces it.
test.start("closures: function values across modules", void () -> {
    h.expectFilesOutput([
        h.file("main.nio", `
import 'ops';

print(ops.apply(ops.makeAdder(40), 2));
print(ops.twice(1));
ops.twice = int (int x) -> x * 10;
print(ops.twice(1));
`),
        h.file("ops.nio", `
export Function(int)<int> makeAdder(int a) {
    return int (int b) -> a + b;
}

export int apply(Function(int)<int> f, int x) {
    return f(x);
}

export Function(int)<int> twice = int (int x) -> x * 2;
`),
    ], "main.nio", ["42", "2", "10"]);
});

// A closure block holds its capture descriptor in slot [1], so the collector
// traces the captured values and nothing more.
test.start("closures: GC stress closures", void () -> {
    h.expectContains(h.sameUnderStress(`
import 'array';

type Acc { int total; }

Function(int)<int> chain(Function(int)<int> f, int add) {
    return int (int x) -> f(x) + add;
}

Acc a = { total: 0 };
Function(int)<int> f = int (int x) -> x;
for (int i = 1; i <= 40; i++) {
    f = chain(f, i);
    String s = "round-" + "trip";
    if (s == "round-trip") {
        a.total = a.total + 1;
    }
}
print(f(0));
print(a.total);

Function()<String>[] tags = [];
forEach([1, 2, 3, 4, 5, 6, 7, 8], n, i) {
    String prefix = "tag" + "-";
    array.push(tags, String () -> prefix + "n");
}
int count = 0;
forEach(tags, tag) {
    if (tag() == "tag-n") {
        count++;
    }
}
print(count);
`), "820");    // 1+2+...+40 added to 0
});
