    "",
    "@rt_td_int8 = external global %TD",
    "@rt_td_int16 = external global %TD",
    "@rt_td_int32 = external global %TD",
    "@rt_td_int = external global %TD",
    "@rt_td_uint8 = external global %TD",
    "@rt_td_uint16 = external global %TD",
    "@rt_td_uint32 = external global %TD",
    "@rt_td_uint = external global %TD",
    "@rt_td_float32 = external global %TD",
    "@rt_td_float = external global %TD",
    "@rt_td_string = external global %TD",
    "@rt_td_bool = external global %TD",
    "@rt_td_datetime = external global %TD",
    "@rt_td_duration = external global %TD",
    "@rt_td_func = external global %TD",
    "@rt_td_future = external global %TD",
    "@rt_td_socket = external global %TD",
    "@rt_td_json = external global %TD",
    "@rt_td_regexp = external global %TD",
    "",
];

String header() {
    return string.join(headerLines, "\n") + "\n";
}

type Sym {
    String ptr;    // LLVM name of the alloca, frame slot or global
    types.Type t;
    // boxed marks a variable that a function value captures. The root slot
    // holds a pointer to a one-slot heap box that every closure which captured
    // it shares, so each read and each write takes one more indirection.
    bool boxed;
}

Sym newSym(String ptr, types.Type t, bool boxed) {
    Sym s = { ptr: ptr, t: t, boxed: boxed };
    return s;
}

// Fallback for a lookup that cannot fail: the checker proved the name is bound.
Sym missingSym() {
    return newSym("", types.InvalidT, false);
}

type Symtab {
    Map<String, Sym> m;
    Symtab? outer;

    Sym? lookup(String name) {
        Symtab? t = self;
        while (t != null) {
            Sym? v = t.m[name];
            if (v != null) {
                return v;
            }
            t = t.outer;
        }
        return null;
    }
}

Symtab newSymtab(Symtab? outer) {
    Symtab t = { m: {}, outer: outer };
    return t;
}

// LoopCtx names the blocks break and continue jump to. cont is the condition
// block when nothing runs between the body and the next test.
type LoopCtx {
    String brk;
    String cont;
}

// GcGlobal is one entry of the @gcglobals root table.
type GcGlobal {
    String sym;
    types.Type t;
}

// ErrCtx is the open catch: its landing block, and the root slot that carries
// the Error there. A null ErrCtx means the error leaves the function.
type ErrCtx {
    String label;
    String slot;
}

// srcName is the name of a function in the call chain of a panic (§5.5): its
// own name, or `Type.name` for a method. It is the name in the source and not
// the mangled symbol.
String srcName(ast.FunctionDeclStatement fd, types.Type? recv) {
    if (recv == null) {
        return fd.name;
    }
    types.Record? r = recv as types.Record;
    if (r == null) {
        return fd.name;
    }
    return r.name + "." + fd.name;
}

// FnState is the generation state of one function. The generator saves it while
// it emits the lifted function of a function value inside another body.
type FnState {
    String[] body;
    int[] popSlots;
    String[] allocas;
    types.Type[] rootTypes;
    int tmp;
    int lbl;
    int nlocal;
    String block;
    bool terminated;
    types.Type fnRet;
    String fnName;
    bool fnFallible;
    ErrCtx? errDest;
    Symtab syms;
    bool inAsync;
    types.Type[] frameTypes;
    String[] resumes;
    LoopCtx[] loops;
    int covBlk;
    String covLL;
    String dbgSub;
    String dbgLoc;
    String dbgFnLoc;
}

// HomeSave is what enterHome sets aside: the name-keyed tables an inherited
// body resolves its free names through, plus the qual its symbols are built
// from and the globals they reach.
type HomeSave {
    bool active;
    Map<String, types.Record> records;
    Map<String, types.Enum> enums;
    Map<String, types.FuncType> funcs;
    Map<String, checker.ModuleRef> aliases;
    String qual;
    Symtab syms;
}

// CovLine gives one source line to one counter. A line can appear more than
// once, under a different counter each time, and the counts add up.
type CovLine {
    int file;    // index into Coverage.files
    int line;
    int block;    // index into the counter array
}

// Coverage collects the line table during generation. The counter count is
// known only when generation ends, so main calls a setup function the generator
// emits last rather than calling rt_cov_init itself.
type Coverage {
    String[] files;
    Map<String, int> fileIdx;
    CovLine[] lines;
    // The registered (file, line, block) triples, as strings: a map key cannot
    // be a record (§6.7).
    Map<String, bool> seen;
    int nblocks;

    // Registers one source line under a counter and ignores a repeat. Two
    // statements sharing a line and a block would report the counter twice.
    void addLine(String path, int line, int block) {
        int fi = 0;
        int? known = self.fileIdx[path];
        if (known == null) {
            fi = self.files.length;
            self.fileIdx[path] = fi;
            array.push(self.files, path);
        } else {
            fi = known;
        }
        String key = `${fi}:${line}:${block}`;
        if (self.seen[key] != null) {
            return;
        }
        self.seen[key] = true;
        CovLine cl = { file: fi, line: line, block: block };
        array.push(self.lines, cl);
    }
}

Coverage newCoverage() {
    Coverage c = { files: [], fileIdx: {}, lines: [], seen: {}, nblocks: 0 };
    return c;
}

// ---- symbol names ----

String fnSym(String qual, String name) {
    if (qual == "") {
        return "@fn." + name;
    }
    return "@fn." + qual + "." + name;
}

// methodSym returns the LLVM symbol of a method. The module of the record
// qualifies it, so an importer calls the body the declaring module emitted. A
// function name cannot collide: '.' is not an identifier character.
String methodSym(types.Record rec, String name) {
    return fnSym(rec.qual, rec.name + "." + name);
}

String gvSym(String qual, String name) {
    if (qual == "") {
        return "@gv." + name;
    }
    return "@gv." + qual + "." + name;
}

// initSym returns the LLVM symbol of the top-level initializer of a module.
String initSym(String qual) {
    return "@mod.init." + qual;
}

// ---- LLVM types and constants ----

// llty maps a language type to the LLVM form it is computed in.
String llty(types.Type t) {
    switch (t) {
        case types.Basic b:
            if (types.isFloatFamily(b)) {
                // A float32 is a double too. The narrow types are ranges the
                // checker keeps a value inside, and not layouts.
                return "double";
            }
            if (b.kind == types.Kind.VOID) {
                return "void";
            }
            if (b.kind == types.Kind.STRING || b.kind == types.Kind.NULL
                || b.kind == types.Kind.JSON || b.kind == types.Kind.REGEXP
                || b.kind == types.Kind.SOCKET || b.kind == types.Kind.LISTENER) {
                // A null Json is MISSING (§6.3). A RegExp is null before an
                // assignment and a use of that null panics (§6.14). A Socket
                // and a Listener are null before an open and raise (§6.15).
                return "ptr";
            }
            return "i64";
        case types.Array a:
            return "ptr";
        case types.Optional o:
            return "ptr";
        case types.Record r:
            return "ptr";
        case types.FuncType f:
            return "ptr";
        case types.FutureType fu:
            return "ptr";
        case types.MapType m:
            return "ptr";
        case types.Enum e:
            return "i64";
    }
    return "i64";
}

// llStore maps a language type to the LLVM type it takes in a container: its
// own width (§5.7). Only the narrow types differ from llty, so packing stays
// invisible outside the load and the store. A float32 is stored as an LLVM
// `float`, so the store rounds onto the binary32 grid. A bool takes one byte,
// and §5.7 packs nothing below a byte.
String llStore(types.Type t) {
    types.Basic? b = t as types.Basic;
    if (b == null) {
        return llty(t);
    }
    if (b.kind == types.Kind.BOOL) {
        return "i8";
    }
    if (!types.isNarrow(b)) {
        return llty(t);
    }
    if (types.isFloatFamily(b)) {
        return "float";
    }
    return "i" + string.from(types.bits(b));
}

bool isBool(types.Type t) {
    types.Basic? b = t as types.Basic;
    return b != null && b.kind == types.Kind.BOOL;
}

// widthOf is llStore as a number of bytes (§5.7).
int widthOf(types.Type t) {
    types.Basic? b = t as types.Basic;
    if (b == null) {
        return 8;
    }
    if (b.kind == types.Kind.BOOL) {
        return 1;
    }
    if (!types.isNarrow(b)) {
        return 8;
    }
    return types.bits(b) / 8;
}

String arrWidth(types.Type elem) {
    return string.from(widthOf(elem));
}

String zeroConst(types.Type t) {
    String l = llty(t);
    if (l == "double") {
        return llFloat(0.0);
    }
    if (l == "ptr") {
        return "null";
    }
    return "0";
}

// ---- float constants ----
//
// Renders a double as an LLVM float token without loss. The shortest
// round-trip decimal parses back to the same 64 bits, and LLVM reads a `double`
// literal at full binary64 precision. The LLVM lexer needs a dot, so `1` and
// `1e-12` become `1.0` and `1.0e-12`. Infinity and NaN cannot occur here.
export String llFloat(float f) {
    if (f - f != 0.0) {    // infinity or NaN
        if (f > 0.0) {
            return "0x7FF0000000000000";
        }
        if (f < 0.0) {
            return "0xFFF0000000000000";
        }
        return "0x7FF8000000000000";
    }
    String s = shortestG(f);
    if (string.contains(s, ".")) {
        return s;
    }
    // Only renderG writes an exponent, and always in lower case.
    int e = string.find(s, "e");
    if (e >= 0) {
        return string.substring(s, 0, e) + ".0" + string.substring(s, e, string.length(s));
    }
    return s + ".0";
}

// Digits holds a decimal significand and the position of its point: the value
// is 0.<d> * 10^dp. d has no leading and no trailing zero, and is empty only
// for zero.
type Digits {
    String d;
    int dp;
}

// FloatDigits is Digits with the sign kept apart from the digits.
type FloatDigits {
    bool neg;
    String d;
    int dp;
}

// Writes f in the shortest decimal that reads back as f. string.from answers a
// different question, the shortest C `%g` at 15, 16 or 17 digits, so digitsOf
// takes that apart, shorten drops digits, and renderG lays the result out. The
// residue is subnormals below about 1e-310, which §1.6 cannot write.
String shortestG(float f) {
    FloatDigits fd = digitsOf(string.from(f));
    Digits sd = shorten(fd, f);
    return renderG(fd.neg, sd.d, sd.dp);
}

// Reads a C `%g` rendering, such as "-1.25e-07", into a sign, the digits alone,
// and the position of the decimal point.
FloatDigits digitsOf(String text) {
    String s = text;
    bool neg = false;
    if (string.length(s) > 0 && string.substring(s, 0, 1) == "-") {
        neg = true;
        s = string.substring(s, 1, string.length(s));
    }
    int exp = 0;
    int e = string.find(s, "e");
    if (e >= 0) {
        exp = string.toInt(string.substring(s, e + 1, string.length(s))) catch 0;
        s = string.substring(s, 0, e);
    }
    int dp = string.length(s);
    int dot = string.find(s, ".");
    if (dot >= 0) {
        dp = dot;
        s = string.substring(s, 0, dot) + string.substring(s, dot + 1, string.length(s));
    }
    dp = dp + exp;

    int lead = 0;
    while (lead < string.length(s) && string.substring(s, lead, lead + 1) == "0") {
        lead++;
    }
    s = string.substring(s, lead, string.length(s));
    dp = dp - lead;

    int n = string.length(s);
    while (n > 0 && string.substring(s, n - 1, n) == "0") {
        n--;
    }
    s = string.substring(s, 0, n);
    if (string.length(s) == 0) {
        dp = 0;
    }
    FloatDigits r = { neg: neg, d: s, dp: dp };
    return r;
}

// digitAt returns the digit at i, and 0 outside the significand.
int digitAt(String d, int i) {
    if (i < 0 || i >= string.length(d)) {
        return 0;
    }
    return string.toInt(string.substring(d, i, i + 1)) catch 0;
}

// charAt is digitAt, as text.
String charAt(String d, int i) {
    if (i < 0 || i >= string.length(d)) {
        return "0";
    }
    return string.substring(d, i, i + 1);
}

// roundTo rounds d to k significant digits, with a half rounded away from zero.
// It moves the decimal point when the carry passes the front.
Digits roundTo(String d, int dp, int k) {
    int nd = string.length(d);
    if (nd <= k) {
        Digits keep = { d: d, dp: dp };
        return keep;
    }
    int[] ds = [];
    for (int i = 0; i < k; i++) {
        array.push(ds, digitAt(d, i));
    }
    int point = dp;
    if (digitAt(d, k) >= 5) {
        int i = k - 1;
        bool carried = false;
        while (i >= 0 && !carried) {
            if (ds[i] < 9) {
                ds[i] = ds[i] + 1;
                carried = true;
            } else {
                ds[i] = 0;
                i--;
            }
        }
        if (!carried) {
            // Every digit was a nine: the significand becomes 1, one decade up.
            ds[0] = 1;
            point++;
        }
    }
    int n = ds.length;
    while (n > 0 && ds[n - 1] == 0) {
        n--;
    }
    String out = "";
    for (int i = 0; i < n; i++) {
        out = out + string.from(ds[i]);
    }
    if (n == 0) {
        point = 0;
    }
    Digits r = { d: out, dp: point };
    return r;
}

// Writes 0.<d> * 10^dp in a form that string.toFloat reads back.
String renderSci(bool neg, String d, int dp) {
    if (string.length(d) == 0) {
        if (neg) {
            return "-0";
        }
        return "0";
    }
    String s = "0." + d + "e" + string.from(dp);
    if (neg) {
        return "-" + s;
    }
    return s;
}

// Removes significant digits while the value still parses back as f. The first
// length that survives is the shortest one. An algorithm such as Ryu needs a
// bit-level decomposition of a float, which the language cannot write.
Digits shorten(FloatDigits fd, float f) {
    int nd = string.length(fd.d);
    for (int k = 1; k < nd; k++) {
        Digits c = roundTo(fd.d, fd.dp, k);
        float back = string.toFloat(renderSci(fd.neg, c.d, c.dp)) catch 0.0;
        if (back == f) {
            return c;
        }
    }
    Digits all = { d: fd.d, dp: fd.dp };
    return all;
}

// renderG lays a significand out: the scientific form when the decimal exponent
// is below -4 or is 6 or more, the plain form otherwise. An exponent has two
// digits at least.
String renderG(bool neg, String d, int dp) {
    int nd = string.length(d);
    String out = "";
    if (neg) {
        out = "-";
    }
    int exp = dp - 1;
    if (exp < -4 || exp >= 6) {
        // Zero never reaches this point, because its dp is 0 and its exp is
        // therefore -1.
        out = out + charAt(d, 0);
        if (nd > 1) {
            out = out + "." + string.substring(d, 1, nd);
        }
        out = out + "e";
        int e = exp;
        if (e < 0) {
            out = out + "-";
            e = -e;
        } else {
            out = out + "+";
        }
        if (e < 10) {
            out = out + "0";
        }
        return out + string.from(e);
    }
    if (dp > 0) {
        for (int i = 0; i < dp; i++) {
            out = out + charAt(d, i);
        }
    } else {
        out = out + "0";
    }
    int prec = nd - dp;
    if (prec < 0) {
        prec = 0;
    }
    if (prec > 0) {
        out = out + ".";
        for (int i = 0; i < prec; i++) {
            out = out + charAt(d, dp + i);
        }
    }
    return out;
}

// TWO52 is the value at which the ulp of a double is 1. To add it and
// then subtract it rounds to the nearest integer, with a tie to even.
float const TWO52 = 4503599627370496.0;

// roundFloat32 rounds v to the nearest value a binary32 holds, with a tie to
// even, and keeps it as a double. It is idempotent: a value already on the
// binary32 grid stays put. §7 has no float conversion and no access to the bits
// of a float, so the function scales onto the grid, rounds with TWO52, and
// scales back. The checker refuses a float32 literal binary32 cannot hold, so
// overflow cannot arrive.
export float roundFloat32(float v) {
    if (v - v != 0.0) {
        return v;    // infinity or NaN: nothing to round
    }
    if (v == 0.0) {
        return v;
    }
    bool neg = v < 0.0;
    float a = v;
    if (neg) {
        a = -a;
    }
    // The binary exponent, where a is 1.xxx * 2^k.
    int k = 0;
    float m = a;
    while (m >= 2.0) {
        m = m * 0.5;
        k++;
    }
    while (m < 1.0) {
        m = m * 2.0;
        k--;
    }
    int step = k - 23;
    if (step < -149) {
        step = -149;    // subnormal: the grid stops halving
    }
    float g = scaleTwo(a, -step);
    float r = (g + TWO52) - TWO52;
    float out = scaleTwo(r, step);
    if (neg) {
        return -out;
    }
    return out;
}

// scaleTwo multiplies x by 2^p. A scale by two never rounds.
float scaleTwo(float x, int p) {
    float r = x;
    int n = p;
    while (n > 0) {
        r = r * 2.0;
        n--;
    }
    while (n < 0) {
        r = r * 0.5;
        n++;
    }
    return r;
}

// ---- layout ----

// isRef tells whether a value of t is a heap pointer the collector must see.
bool isRef(types.Type t) {
    return llty(t) == "ptr";
}

// An async frame is state, result, awaited future and raised Error, then the
// variable slots (runtime.h). asyncErrOffset is where a fallible async body
// leaves the Error for the scheduler to move into the future.
int const asyncFrameHeader = 32;
int const asyncErrOffset = 24;

// The protocol codes lib/net.c takes. They are the NIO_NET_* values in
// runtime.h and must change with them.
int const netTCP = 1;
int const netUDP = 2;
int const netUNIX = 3;

// Gives the argument count of a net function with its options record written
// out. A call with one argument fewer passes null, which the runtime reads as
// options that set nothing. The table is not derived from builtins.builtinSigs,
// because net.close and net.address take either handle type and have no
// signature.
int netArity(String fn) {
    if (fn == "send") {
        return 4;
    }
    if (fn == "read" || fn == "readExactly" || fn == "write" || fn == "receive") {
        return 3;
    }
    return 2;    // accept
}

// recHeader is the byte offset of the first declared field. Slot [0] of a
// record payload points to the TypeDesc of the record itself, and the fields
// follow, each at its own width (§5.7). The C side reads the same layout
// through REC_TD and the field_offsets of the TypeDesc. The two must change
// together.
//
// The stamp lets a value of an extending type sit in a location typed at its
// base (§2.4): the collector traces the descriptor it finds in the object, and
// not the static one at the root.
int const recHeader = 8;

// recOffset returns the byte offset of field idx. Each field starts at the next
// multiple of its own width (§5.7), so a pointer field always lands at a
// multiple of 8, which the word loads of the collector need. An extending type
// carries the fields of its base at the front, and the shared prefix folds to
// the same offsets (§2.4).
int recOffset(types.Record rec, int idx) {
    int off = recHeader;
    int i = 0;
    while (i < idx) {
        off = off + widthOf(rec.fields[i].type);
        i++;
        off = alignTo(off, widthOf(rec.fields[i].type));
    }
    return off;
}

// recSizeOf returns the allocation size of the block of rec: past the last
// field, moved up to a multiple of 8, so the block holds whole words.
int recSizeOf(types.Record rec) {
    int n = rec.fields.length;
    if (n == 0) {
        return recHeader;
    }
    int end = recOffset(rec, n - 1) + widthOf(rec.fields[n - 1].type);
    return alignTo(end, 8);
}

int alignTo(int off, int w) {
    int r = off % w;
    if (r == 0) {
        return off;
    }
    return off + w - r;
}

// Gives the shape of the box of a captured variable, as the collector sees it:
// a pointer to a cell holding a T at its own width (§5.7). An optional has that
// layout, so a box descriptor uses the optional TypeDesc form.
types.Type boxType(types.Type t) {
    return types.newOptional(t);
}

// gcPopMarker stands for the shadow-stack pop before a `ret`. Whether a
// function has a frame is known only once its body is emitted, so gcPop records
// the body slot that holds the marker and endFunction assigns the real
// instruction, or nothing, over it. The marker never reaches the output.
String const gcPopMarker = "  ; @@gc.pop@@\n";

// gcStatic is the GC_STATIC bit of the object header in runtime.h.
int const gcStatic = 2;

// The function main calls to hand the coverage tables to the runtime.
String const covSetupSym = "@nio.cov.setup";

// retLL returns the LLVM return type of a function with signature sig.
//
//	infallible          define T @f(...)
//	fallible, non-void  define {T, ptr} @f(...)
//	fallible, void      define ptr @f(...)
String retLL(types.FuncType sig) {
    if (!sig.fallible) {
        return llty(sig.return);
    }
    if (types.equal(sig.return, types.VoidT)) {
        return "ptr";
    }
    return "{" + llty(sig.return) + ", ptr}";
}

// isRaiseValue tells whether a return of a value of type vt, from a function
// returning retType, raises instead of returning. It is the codegen half of
// isRaise in the checker.
bool isRaiseValue(types.Type? retType, types.Type vt) {
    if (!types.isError(vt)) {
        return false;
    }
    if (retType == null) {
        return true;
    }
    return !types.assignable(retType, vt);
}

// typeKey identifies a type across modules. The name of a record alone can
// repeat between files.
String typeKey(types.Type t) {
    switch (t) {
        case types.Array a:
            return typeKey(a.elem) + "[]";
        case types.Optional o:
            return typeKey(o.inner) + "?";
        case types.MapType m:
            return "Map<" + typeKey(m.key) + "," + typeKey(m.value) + ">";
        case types.Record r:
            return "record." + r.qual + "." + r.name;
        case types.Enum e:
            return "enum." + e.qual + "." + e.name;
        default:
            return types.typeString(t);
    }
}

String const hexDigits = "0123456789ABCDEF";

// escapeIR writes s as the body of an LLVM `c"..."` constant: printable ASCII
// as itself, every other byte as \XX in upper case. hexEscapes holds "\\00" to
// "\\FF", built at the first escape, because the bake sends the whole C runtime
// through here as string literals.
String[] hexEscapes = [];

String hexEscape(int u) {
    if (hexEscapes.length == 0) {
        for (int i = 0; i < 256; i++) {
            array.push(hexEscapes, "\\" + string.substring(hexDigits, i / 16, i / 16 + 1)
                + string.substring(hexDigits, i % 16, i % 16 + 1));
        }
    }
    return hexEscapes[u];
}

// Writes the bytes of a string as the body of an LLVM string constant. It
// copies runs of bytes: one allocation for each byte makes the string literals
// of a baked module the largest source of garbage in a compile.
String escapeIR(String s) {
    int n = string.length(s);
    String[] parts = [];
    int start = 0;    // byte index where the pending verbatim run began
    for (int i = 0; i < n; i++) {
        int ch = s[i];
        // 34 is a quote and 92 a backslash. A byte is a uint8, so 128 to 255
        // take the escape branch too (§2.1).
        if (ch >= 32 && ch <= 126 && ch != 34 && ch != 92) {
            continue;
        }
        if (i > start) {
            array.push(parts, string.substring(s, start, i));
        }
        array.push(parts, hexEscape(ch));
        start = i + 1;
    }
    if (start < n) {
        array.push(parts, string.substring(s, start, n));
    }
    return string.join(parts, "");
}

// hasContinue tells whether a `continue` in stmts binds to the loop whose body
// holds them. A loop inside stmts binds its own, so the walk stops there.
bool hasContinue(ast.Statement[] stmts) {
    bool found = false;
    forEach(stmts, s) {
        switch (s) {
            case ast.ContinueStatement cs:
                found = true;
            case ast.BlockStatement bs:
                if (hasContinue(bs.statements)) {
                    found = true;
                }
            case ast.IfStatement ifs:
                if (hasContinue(ifs.then.statements)) {
                    found = true;
                }
                ast.BlockStatement? els = ifs.else;
                if (els != null && hasContinue(els.statements)) {
                    found = true;
                }
            case ast.SwitchStatement sw:
                // A switch binds a `break` and never a `continue`, so the walk
                // enters it.
                forEach(sw.cases, cl) {
                    if (hasContinue(cl.body.statements)) {
                        found = true;
                    }
                }
            default:
                // A while, a for and a forEach each bind their own continue.
                break;
        }
        // A catch handler is a statement list hanging off an expression, and a
        // continue in one binds to this loop.
        forEach(ast.catchBlocks(s), b) {
            if (hasContinue(b.statements)) {
                found = true;
            }
        }
    }
    return found;
}

// zeroNeedsFill tells whether the zero value of t is something other than all
// zero bits: the empty string constant, or a new allocation.
bool zeroNeedsFill(types.Type t) {
    switch (t) {
        case types.Basic b:
            return b.kind == types.Kind.STRING;
        case types.Record r:
            return true;
        case types.Array a:
            return true;
        case types.MapType m:
            return true;
        default:
            return false;
    }
}

// covCounted tells whether a counter must cover the statement s. Two kinds have
// none: a statement with no token line, which the await normalizer built, and a
// block statement, whose brace would give the `if (c) {` line a second counter.
bool covCounted(ast.Statement s) {
    ast.BlockStatement? blk = s as ast.BlockStatement;
    if (blk != null) {
        return false;
    }
    return s.tok.line > 0;
}

types.Optional asOptional(types.Type t) {
    types.Optional? o = t as types.Optional;
    if (o == null) {
        unreachable("expected an optional type, got " + types.typeString(t));
        return types.newOptional(types.InvalidT);
    }
    return o;
}

// ---- operator tables ----

String floatArithOp(String op) {
    switch (op) {
        case "+":
            return "fadd";
        case "-":
            return "fsub";
        case "*":
            return "fmul";
        default:    // "/"
            return "fdiv";
    }
}

String intArithOp(String op) {
    switch (op) {
        case "+":
            return "add";
        case "-":
            return "sub";
        default:    // "*"
            return "mul";
    }
}

// bitArithOp maps the bitwise operators that are one instruction. The shifts
// are in genShift: the family of the operand picks the instruction, and all
// three need guards.
String bitArithOp(String op) {
    switch (op) {
        case "&":
            return "and";
        case "|":
            return "or";
        default:    // "^"
            return "xor";
    }
}

String intDivOp(String op) {
    if (op == "%") {
        return "srem";
    }
    return "sdiv";
}

String uintDivOp(String op) {
    if (op == "%") {
        return "urem";
    }
    return "udiv";
}

String floatCmpOp(String op) {
    switch (op) {
        case "<":
            return "olt";
        case ">":
            return "ogt";
        case "<=":
            return "ole";
        default:    // ">="
            return "oge";
    }
}

String intCmpOp(String op) {
    switch (op) {
        case "<":
            return "slt";
        case ">":
            return "sgt";
        case "<=":
            return "sle";
        default:    // ">="
            return "sge";
    }
}

String uintCmpOp(String op) {
    switch (op) {
        case "<":
            return "ult";
        case ">":
            return "ugt";
        case "<=":
            return "ule";
        default:    // ">="
            return "uge";
    }
}

// stringSym returns the runtime symbol behind one function of the string
// module, for the functions that compile to a call of the same shape.
String stringSym(String fn) {
    switch (fn) {
        case "toByteArray":
            return "rt_string_to_byte_array";
        case "fromByteArray":
            return "rt_string_from_byte_array";
        case "toUpperCaseAscii":
            return "rt_string_upper";
        case "toLowerCaseAscii":
            return "rt_string_lower";
        case "fromRunes":
            return "rt_string_from_runes";
        case "runeCount":
            return "rt_string_rune_count";
        case "runeAt":
            return "rt_string_rune_at";
        case "isValidUtf8":
            return "rt_string_valid_utf8";
        case "trim":
            return "rt_string_trim";
        case "copy":
            return "rt_string_copy";
        case "split":
            return "rt_string_split";
        case "join":
            return "rt_string_join";
        case "contains":
            return "rt_string_contains";
        case "find":
            return "rt_string_find";
        case "replace":
            return "rt_string_replace";
        case "replaceAll":
            return "rt_string_replace_all";
        case "equalsConstantTime":
            return "rt_string_equals_ct";
        default:
            return "";
    }
}

// fsSym returns the runtime symbol behind the fs functions that return a value.
String fsSym(String fn) {
    switch (fn) {
        case "readDir":
            return "rt_fs_read_dir";
        case "readFile":
            return "rt_fs_read_file";
        case "stat":
            return "rt_fs_stat";
        case "createTempDir":
            return "rt_fs_create_temp_dir";
        default:
            return "";
    }
}

// Stops the compiler on a state the checker has already excluded. §7 has no
// panic operation, so it reaches the panic of the runtime through the only
// operation defined to fail: an index outside an array.
void unreachable(String what) {
    print("codegen: unreachable:", what);
    int[] stop = [];
    stop[0] = 0;
}

// The conversions the checker has already proved. A branch that cannot run
// stops the compiler.
types.Array asArray(types.Type t) {
    types.Array? a = t as types.Array;
    if (a == null) {
        unreachable("expected an array type, got " + types.typeString(t));
        return types.newArray(types.InvalidT);
    }
    return a;
}

types.MapType asMap(types.Type t) {
    types.MapType? m = t as types.MapType;
    if (m == null) {
        unreachable("expected a map type, got " + types.typeString(t));
        return types.newMapType(types.InvalidT, types.InvalidT);
    }
    return m;
}

types.Record asRecord(types.Type t) {
    types.Record? r = t as types.Record;
    if (r == null) {
        unreachable("expected a record type, got " + types.typeString(t));
        return types.ErrorT;
    }
    return r;
}

// Reads a Boxed, Narrowed or Raises table, where an absent key means false.
bool marked(Map<int, bool> m, int id) {
    bool? v = m[id];
    if (v == null) {
        return false;
    }
    return v;
}

// Slot is what genIncDecSlot returns: where a value is stored, and its type.
// `packed` says the address is inside a container, where the value takes its
// own width (§5.7) and not the 8-byte unit a local takes.
type Slot {
    String ptr;
    types.Type t;
    bool packed;
}

Slot newSlot(String ptr, types.Type t) {
    Slot s = { ptr: ptr, t: t, packed: false };
    return s;
}

Slot newPackedSlot(String ptr, types.Type t) {
    Slot s = { ptr: ptr, t: t, packed: true };
    return s;
}

types.Field plainField(String name, types.Type t) {
    types.Field f = { name: name, type: t, jsonName: "", jsonRest: false };
    return f;
}

// The signature genPathCall compiles path.join through. It must match the one
// in pathCallType: one fixed element and a collecting parameter.
types.FuncType pathJoinSig = makePathJoinSig();

types.FuncType makePathJoinSig() {
    types.Type[] ps = [];
    array.push(ps, types.StringT);
    array.push(ps, types.newArray(types.StringT));
    types.FuncType f = {
        params: ps, return: types.StringT,
        async: false, fallible: false, variadic: true, noalloc: false, extern: false,
    };
    return f;
}

// The two pieces around every emitted instruction. They are literals, so the
// wrapping costs a pointer and not a copy of the instruction.
String const indent = "  ";
String const nl = "\n";

// The byte offset of an async frame slot, from the name frameSlot gave it, or
// -1 for anything that is not one. The two must agree: a slot is named "%f"
// and its index, and slot i is at asyncFrameHeader + i * 8 (runtime.h).
int frameSlotOffset(String name) {
    if (!str.hasPrefix(name, "%f")) {
        return -1;
    }
    int i = string.toInt(string.substring(name, 2, string.length(name))) catch -1;
    if (i < 0) {
        return -1;
    }
    return asyncFrameHeader + i * 8;
}

// The byte offset of the shadow-stack slot named "%r<i>" in the function's
// %gcslots block, or -1 for any other address.
int rootSlotOffset(String name) {
    if (!str.hasPrefix(name, "%r")) {
        return -1;
    }
    int i = string.toInt(string.substring(name, 2, string.length(name))) catch -1;
    if (i < 0) {
        return -1;
    }
    return i * 8;
}

// How DWARF reads the bits of a value that is not a pointer. The two integer
// families (§2.1) differ here and nowhere else in the debug information.
String dbgEncoding(types.Type t) {
    if (types.equal(t, types.BoolT)) {
        return "DW_ATE_boolean";
    }
    if (types.isFloatFamily(t)) {
        return "DW_ATE_float";
    }
    if (types.isUnsignedFamily(t)) {
        return "DW_ATE_unsigned";
    }
    return "DW_ATE_signed";
}

// A string as LLVM metadata spells one. Only a quote and a backslash need an
// escape. A metadata string is bytes, and every other byte stands for itself.
String mdStr(String s) {
    String[] out = ["\""];
    forEach(string.toByteArray(s), b) {
        if (b == 34) {
            array.push(out, "\\22");
            continue;
        }
        if (b == 92) {
            array.push(out, "\\5C");
            continue;
        }
        array.push(out, string.fromByteArray([b]));
    }
    array.push(out, "\"");
    return string.join(out, "");
}

// The filename and directory of the DIFile of a module. A standard library
// module written in Nio has no file on disk, because it is baked into the
// compiler. It is named by the import path, under a directory that says so,
// which a debugger does not search.
String dbgFileFields(module.Module? m, String qual) {
    String p = "";
    if (m != null) {
        p = m.path;
    }
    if (p == "") {
        return "filename: " + mdStr(qual + ".nio") + ", directory: " + mdStr("<nio>");
    }
    String dir = dirOfPath(p);
    String base = p;
    if (dir != "") {
        base = string.substring(p, string.length(dir) + 1, string.length(p));
    }
    return "filename: " + mdStr(base) + ", directory: " + mdStr(dir);
}

// The directory part of a path, or "" when it names no directory. src/loader.nio
// has the general form. This copy holds only the case codegen needs, and keeps
// the module graph acyclic.
String dirOfPath(String p) {
    int cut = -1;
    for (int i = 0; i < string.length(p); i++) {
        String c = string.substring(p, i, i + 1);
        if (c == "/" || c == "\\") {
            cut = i;
        }
    }
    if (cut < 0) {
        return "";
    }
    return string.substring(p, 0, cut);
}

// DWARF debug information, as LLVM metadata (§1.3). One DICompileUnit for the
// program, one DIFile per module, one DISubprogram per generated function, and
// one DILocation per source position an instruction comes from.
//
// It is null on Gen when -g is off, and then nothing is emitted. Coverage
// follows the same rule. A DISubprogram alone is not sufficient: the LLVM
// verifier rejects a call without a location in a function that has debug
// information, so each call must carry a location.
type Dbg {
    // Every node, in id order: nodes[i] is "!i". A dense numbering means the id
    // of a node is where it sits, so nothing has to be renumbered.
    String[] nodes;
    Map<String, String> files;    // module qual -> "!n" of its DIFile
    Map<String, String> locs;     // "sub:line:col" -> "!n" of its DILocation
    Map<String, String> types;    // type name -> "!n" of its DIType
    String cu;                    // "!n" of the compile unit
    int cuIndex;                  // where that node sits, so finish can rewrite it
    String cuBody;                // the unit's text, up to its closing bracket
    String[] cuGlobals;           // the "!n" of every global's expression
    String subType;               // "!n" of the shared DISubroutineType
    String flags;                 // the module-flag nodes, as a list

    // add appends a node and answers its "!n".
    String add(String body) {
        String id = "!" + string.from(self.nodes.length);
        array.push(self.nodes, id + " = " + body + "\n");
        return id;
    }

    // loc answers the DILocation for a position inside sub, making it once.
    String loc(String sub, int line, int col) {
        String key = sub + ":" + string.from(line) + ":" + string.from(col);
        String? had = self.locs[key];
        if (had != null) {
            return had;
        }
        String id = self.add("!DILocation(line: " + string.from(line) + ", column: "
            + string.from(col) + ", scope: " + sub + ")");
        self.locs[key] = id;
        return id;
    }

    // Closes the compile unit. The unit lists a node for each global, and the
    // list is complete only after the walk of all modules. Thus the node of the
    // unit is written last, in the place reserved for it.
    void finish() {
        String tail = "";
        if (self.cuGlobals.length > 0) {
            tail = ", globals: " + self.add("!{" + string.join(self.cuGlobals, ", ") + "}");
        }
        self.nodes[self.cuIndex] = self.cu + " = " + self.cuBody + tail + ")\n";
    }
}

type Gen {
    checker.Info info;    // current module's type info
    String qual;          // current module's symbol prefix
    String[] globals;     // string constants, typedescs, global vars
    String[] code;        // function definitions

    // attrRef is " #0" when the module carries a target attribute group, and
    // empty when it does not. Every "define" ends with it. generate explains
    // why it is necessary.
    String attrRef;

    // Per-function state.
    String[] body;
    int[] popSlots;    // indices in body holding gcPopMarker
    String[] allocas;
    types.Type[] rootTypes;    // shadow-stack slots, in slot order
    int tmp;
    int lbl;
    String block;
    bool terminated;
    types.Type fnRet;
    // The source name of the function under generation, as a panic prints it
    // (§5.5). It reaches the shadow-stack frame and nothing else.
    String fnName;

    // Debug information, or null when -g is off. dbgSub is the DISubprogram of
    // the function under generation and dbgLoc the location every instruction
    // emitted now carries. Both are empty when there is no location.
    Dbg? dbg;
    String dbgSub;
    String dbgLoc;
    // The declaration line of the function under generation. A spawn wrapper is
    // generated after its step function and shares it.
    int dbgFnLine;
    // The location of that line, which is what the prologue carries: the frame
    // it builds belongs to the function rather than to any statement in it.
    String dbgFnLoc;
    // fnFallible marks the function under generation as one returning a
    // {result, error} pair. errDest is the innermost open catch, or null. The
    // two decide where a raise goes (emitRaise).
    bool fnFallible;
    ErrCtx? errDest;

    // The state-machine mode, set while the step function of an async function
    // is emitted. Every named value and every root goes into the heap frame,
    // and frameTypes lists the slots after the fixed header. Each await records
    // a resume label the dispatch switch in the entry block reaches.
    bool inAsync;
    types.Type[] frameTypes;
    String[] resumes;

    // The stack of loops around the statement under generation, innermost last.
    // A `break` branches to the exit label of the last entry, a `continue` to
    // its next-iteration label.
    LoopCtx[] loops;

    Symtab syms;
    Map<String, Symtab> modSyms;           // module qual -> its global variables
    Map<String, module.Module> modules;    // module qual -> the module itself
    Symtab baseSyms;                       // current module's global symtab

    Map<String, String> strs;
    Map<String, String> cstrs;
    Map<String, String> tds;
    Map<String, bool> externDecls;    // extern C symbols already declared (§5.8)
    int nstr;
    int ncstr;
    int ntd;
    int nlocal;
    int nfrm;
    int nlam;

    GcGlobal[] gcGlobals;    // every pointer-typed global, for the root table

    // Statement coverage, null unless the build asked for it. covBlk is the
    // counter the statements under emission belong to, and covLL is the LLVM
    // block it opened in. A statement emitted into any other block starts a
    // counter of its own. covBlk is -1 when no counter is open.
    Coverage? cov;
    int covBlk;
    String covLL;

    void setModule(module.Module m) {
        self.info = m.info;
        self.qual = m.qual;
        Symtab? t = self.modSyms[m.qual];
        if (t != null) {
            self.baseSyms = t;
        }
    }

    // typeOf returns the checked type of an expression. Every expression the
    // checker accepted has one.
    types.Type typeOf(ast.Expression e) {
        types.Type? t = self.info.types[e.id];
        if (t == null) {
            return types.InvalidT;
        }
        return t;
    }

    // ---- per-function machinery ----

    String newTmp() {
        self.tmp++;
        return "%t" + string.from(self.tmp);
    }

    String newLabel(String prefix) {
        self.lbl++;
        return prefix + string.from(self.lbl);
    }

    // Appends one indented instruction. The pieces go in separately: the body
    // is joined once at the end, so no instruction is copied twice.
    void emit(String format, ...String args) {
        array.push(self.body, indent);
        fmt.fmtInto(self.body, format, args);
        array.push(self.body, self.dbgSuffix());
        array.push(self.body, nl);
    }

    // What every instruction carries when -g is on: the position of the
    // statement being generated, scoped to the function being generated. Empty
    // otherwise, and empty for the prologue, which no statement wrote.
    String dbgSuffix() {
        if (self.dbgLoc == "") {
            return "";
        }
        return ", !dbg " + self.dbgLoc;
    }

    // The same for an instruction of the prologue, which belongs to the
    // function rather than to a statement.
    String dbgFnSuffix() {
        if (self.dbgFnLoc == "") {
            return "";
        }
        return ", !dbg " + self.dbgFnLoc;
    }

    // Names a definition's DISubprogram. A head always ends in " {", which is
    // where the reference goes: LLVM writes it on the define, not in the body.
    String dbgHead(String head) {
        if (self.dbgSub == "") {
            return head;
        }
        return string.substring(head, 0, string.length(head) - 1) + "!dbg " + self.dbgSub + " {";
    }

    // Opens the DISubprogram of a function, and makes its own line the location
    // its prologue carries.
    void beginDbgFn(String name, int line) {
        self.dbgSub = "";
        self.dbgLoc = "";
        self.dbgFnLoc = "";
        Dbg? d = self.dbg;
        if (d == null) {
            return;
        }
        String file = self.dbgFile();
        self.dbgSub = d.add("distinct !DISubprogram(name: " + mdStr(name)
            + ", scope: " + file + ", file: " + file + ", line: " + string.from(line)
            + ", type: " + d.subType + ", scopeLine: " + string.from(line)
            + ", spFlags: DISPFlagDefinition, unit: " + d.cu + ")");
        self.dbgLoc = d.loc(self.dbgSub, line, 1);
        self.dbgFnLoc = self.dbgLoc;
    }

    // Moves the location every following instruction carries to a statement's
    // own position.
    void dbgAt(int line, int col) {
        Dbg? d = self.dbg;
        if (d == null || self.dbgSub == "") {
            return;
        }
        // A statement that the await normalizer built has no position (line
        // is 0, as coverage also tests). It keeps the current location, which
        // is that of the statement it was rewritten from.
        if (line == 0) {
            return;
        }
        int col2 = col;
        if (col2 < 1) {
            col2 = 1;
        }
        self.dbgLoc = d.loc(self.dbgSub, line, col2);
    }

    // Names a local variable, so that a debugger can read it. addr is where the
    // value lives: an alloca, a shadow-stack slot, or an async frame slot.
    //
    // A boxed variable (one that a function value captured) keeps its value in
    // a heap box that the closures share. The slot holds the address of the
    // value, and DW_OP_deref follows it.
    void dbgLocal(String name, String addr, types.Type t, int line, int arg, bool boxed) {
        Dbg? d = self.dbg;
        if (d == null || self.dbgSub == "") {
            return;
        }
        String argPart = "";
        if (arg > 0) {
            argPart = `, arg: ${arg}`;
        }
        String v = d.add("!DILocalVariable(name: " + mdStr(name) + argPart
            + ", scope: " + self.dbgSub + ", file: " + self.dbgFile()
            + ", line: " + string.from(line) + ", type: " + self.dbgType(t) + ")");
        // A local of an async body is at an offset in the heap frame the
        // scheduler owns, and a rooted local of any other function is at an
        // offset in the %gcslots block. Neither has an address of its own.
        // The getelementptr that computes one is not an alloca, so LLVM
        // attaches no variable to it and drops the variable at every
        // optimization level. Thus each is described as the block plus a
        // byte offset.
        String base = addr;
        String[] ops = [];
        int off = frameSlotOffset(addr);
        if (off >= 0) {
            base = "%frame";
            array.push(ops, `DW_OP_plus_uconst, ${off}`);
        }
        int root = rootSlotOffset(addr);
        if (root >= 0) {
            base = "%gcslots";
            array.push(ops, `DW_OP_plus_uconst, ${root}`);
        }
        if (boxed) {
            array.push(ops, "DW_OP_deref");
        }
        String expr = "!DIExpression(" + string.join(ops, ", ") + ")";
        self.emit("call void @llvm.dbg.declare(metadata ptr %s, metadata %s, metadata %s)",
            base, v, expr);
    }

    // The DIType of a Nio type, made once for each.
    //
    // Every size here is 64, because that is what a slot holding the value is:
    // §5.7 packs a value where it is stored in a container, and a local is not
    // one. A narrow integer sits in its slot sign- or zero-extended, so reading
    // the whole 64 bits gives the value the program has.
    String dbgType(types.Type t) {
        Dbg? d = self.dbg;
        if (d == null) {
            return "";
        }
        String name = types.typeString(t);
        String? had = d.types[name];
        if (had != null) {
            return had;
        }
        String body = "";
        if (isRef(t)) {
            // Everything the collector traces is one machine pointer. What it
            // points at has no DIType yet, so the name is a typedef over an
            // untyped pointer: a debugger shows "String" and an address, rather
            // than "void *".
            body = "!DIDerivedType(tag: DW_TAG_typedef, name: " + mdStr(name)
                + ", baseType: " + self.dbgVoidPtr() + ")";
        } else {
            body = "!DIBasicType(name: " + mdStr(name) + ", size: 64, encoding: "
                + dbgEncoding(t) + ")";
        }
        String id = d.add(body);
        d.types[name] = id;
        return id;
    }

    // The untyped pointer that every reference type is a name for.
    String dbgVoidPtr() {
        Dbg? d = self.dbg;
        if (d == null) {
            return "";
        }
        String? had = d.types["*"];
        if (had != null) {
            return had;
        }
        String id = d.add("!DIDerivedType(tag: DW_TAG_pointer_type, baseType: null, size: 64)");
        d.types["*"] = id;
        return id;
    }

    // The DIFile of the module under generation, made once per module.
    String dbgFile() {
        return self.dbgFileOf(self.qual);
    }

    String dbgFileOf(String qual) {
        Dbg? d = self.dbg;
        if (d == null) {
            return "";
        }
        String? had = d.files[qual];
        if (had != null) {
            return had;
        }
        String id = d.add("!DIFile(" + dbgFileFields(self.modules[qual], qual) + ")");
        d.files[qual] = id;
        return id;
    }

    // Names a top-level variable. It answers what the global definition must
    // carry, or "" when there is no debug information to carry.
    String dbgGlobal(String name, String qual, types.Type t, int line) {
        Dbg? d = self.dbg;
        if (d == null) {
            return "";
        }
        String v = d.add("distinct !DIGlobalVariable(name: " + mdStr(name)
            + ", scope: " + d.cu + ", file: " + self.dbgFileOf(qual)
            + ", line: " + string.from(line) + ", type: " + self.dbgType(t)
            + ", isLocal: false, isDefinition: true)");
        String e = d.add("!DIGlobalVariableExpression(var: " + v + ", expr: !DIExpression())");
        array.push(d.cuGlobals, e);
        return ", !dbg " + e;
    }

    void startBlock(String label) {
        array.push(self.body, label);
        array.push(self.body, ":\n");
        self.block = label;
        self.terminated = false;
    }

    void terminate(String format, ...String args) {
        array.push(self.body, indent);
        fmt.fmtInto(self.body, format, args);
        array.push(self.body, self.dbgSuffix());
        array.push(self.body, nl);
        self.terminated = true;
    }

    void beginFunction(types.Type ret, String name, int line) {
        self.fnName = name;
        self.dbgFnLine = line;
        self.beginDbgFn(name, line);
        self.body = [];
        self.popSlots = [];
        self.allocas = [];
        self.rootTypes = [];
        self.tmp = 0;
        self.lbl = 0;
        self.nlocal = 0;
        self.fnRet = ret;
        self.fnFallible = false;
        self.errDest = null;
        self.loops = [];
        // No coverage counter is open. Labels start again in each function, so
        // the label of the last one must not match the first block here.
        self.covBlk = -1;
        self.startBlock("start");
    }

    // rootSlot reserves a shadow-stack slot and returns the LLVM name of its
    // address. An async step function has no shadow stack: its roots go into
    // the heap frame, which survives a suspension where a stack slot does not.
    String rootSlot(types.Type t) {
        if (self.inAsync) {
            return self.frameSlot(t);
        }
        String name = "%r" + string.from(self.rootTypes.length);
        array.push(self.rootTypes, t);
        return name;
    }

    // frameSlot reserves one 8-byte slot of the async frame and returns the
    // LLVM name of its address. endAsyncFunction emits the getelementptr into
    // the entry block, where it dominates the code of every state.
    String frameSlot(types.Type t) {
        String name = "%f" + string.from(self.frameTypes.length);
        array.push(self.frameTypes, t);
        return name;
    }

    // protect roots v and returns it unchanged. Every heap pointer held while
    // another expression runs must go through this function: that expression
    // can allocate, and the collector does not see an SSA register. The
    // register stays usable, because the collector never moves an object.
    String protect(String v, types.Type t) {
        if (isRef(t)) {
            self.emit("store ptr %s, ptr %s", v, self.rootSlot(t));
        }
        return v;
    }

    void gcPop() {
        if (self.inAsync) {
            return;    // step functions have no shadow frame to pop
        }
        array.push(self.popSlots, self.body.length);
        array.push(self.body, gcPopMarker);
    }

    // Builds the entry block, with its allocas, its shadow-stack frame and its
    // br, and joins it to the body. It closes an open block with defaultTerm.
    void endFunction(String head, String defaultTerm) {
        if (!self.terminated) {
            if (str.hasPrefix(defaultTerm, "ret")) {
                self.gcPop();
            }
            // defaultTerm is two instructions where it panics, and each needs
            // its own location. One emit puts the location after the last line
            // and leaves the call without one. The LLVM verifier then drops all
            // debug information from the program, and the build still passes.
            forEach(string.split(defaultTerm, "\n"), part) {
                self.emit("%s", string.trim(part));
            }
        }

        int n = self.rootTypes.length;
        // A frame is pushed only where the collector needs one. Thus the call
        // chain that a panic prints (§5.5) costs nothing per call. A frame in
        // every function measured 2x slower on a recursive scalar function
        // (benchmark/fib.nio): the push writes a global, so each call reloads
        // what the optimizer kept in registers. The chain is thus sparse: a
        // function that holds no heap value is not in it. Debug information
        // gives the complete chain.
        //
        // An async step function has no frame either. The condition here must
        // stay the same as the one gcPop tests: its locals are in a heap frame
        // that the scheduler owns.
        bool hasFrame = !self.inAsync && n > 0;
        String pop = "";
        if (hasFrame) {
            pop = "  store ptr %gcprev, ptr @rt_gc_top\n";
        }
        forEach(self.popSlots, i) {
            self.body[i] = pop;
        }
        String body = string.join(self.body, "");

        array.push(self.code, self.dbgHead(head) + "\nentry:\n");
        forEach(self.allocas, a) {
            array.push(self.code, "  " + a + "\n");
        }
        if (hasFrame) {
            array.push(self.code, self.gcFrame(n));
        }
        array.push(self.code, "  br label %start\n");
        array.push(self.code, body);
        array.push(self.code, "}\n\n");
    }

    // Emits the entry-block code that builds the shadow-stack frame and pushes
    // it. It clears the slot array first: the collector scans the array from
    // the moment the frame is linked in, before any slot holds a value.
    String gcFrame(int n) {
        String[] tds = [];
        forEach(self.rootTypes, t) {
            array.push(tds, "ptr " + self.tdGlobal(t));
        }
        String tdSym = "@gctd." + string.from(self.nfrm);
        self.nfrm++;
        array.push(self.globals, tdSym + " = private constant [" + string.from(n)
            + " x ptr] [" + string.join(tds, ", ") + "]\n");

        String[] b = [];
        array.push(b, "  %gcslots = alloca [" + string.from(n) + " x i64], align 8\n");
        array.push(b, "  call void @llvm.memset.p0.i64(ptr %gcslots, i8 0, i64 "
            + string.from(n * 8) + ", i1 false)" + self.dbgFnSuffix() + "\n");
        for (int i = 0; i < n; i++) {
            array.push(b, "  %r" + string.from(i) + " = getelementptr inbounds ["
                + string.from(n) + " x i64], ptr %gcslots, i64 0, i64 " + string.from(i) + "\n");
        }
        array.push(b, "  %gcframe = alloca %GCFrame, align 8\n");
        array.push(b, "  %gcprev = load ptr, ptr @rt_gc_top\n");
        array.push(b, "  store ptr %gcprev, ptr %gcframe\n");
        array.push(b, "  %gcf1 = getelementptr inbounds %GCFrame, ptr %gcframe, i32 0, i32 1\n  store i64 "
            + string.from(n) + ", ptr %gcf1\n");
        array.push(b, "  %gcf2 = getelementptr inbounds %GCFrame, ptr %gcframe, i32 0, i32 2\n  store ptr "
            + tdSym + ", ptr %gcf2\n");
        array.push(b, "  %gcf3 = getelementptr inbounds %GCFrame, ptr %gcframe, i32 0, i32 3\n  store ptr %gcslots, ptr %gcf3\n");
        array.push(b, "  %gcf4 = getelementptr inbounds %GCFrame, ptr %gcframe, i32 0, i32 4\n  store ptr "
            + self.cstr(self.fnName) + ", ptr %gcf4\n");
        array.push(b, "  store ptr %gcframe, ptr @rt_gc_top\n");
        return string.join(b, "");
    }

    // alloca reserves storage for a named value. A pointer value goes into
    // the shadow-stack frame, so that the collector sees it, and every other
    // value goes into an ordinary stack slot. In an async step function every
    // value lives in the heap frame, whether it is a pointer or not, because a
    // stack slot does not survive a suspension.
    String alloca(types.Type t) {
        if (self.inAsync) {
            return self.frameSlot(t);
        }
        if (isRef(t)) {
            return self.rootSlot(t);
        }
        self.nlocal++;
        String name = "%v" + string.from(self.nlocal);
        array.push(self.allocas, name + " = alloca " + llty(t));
        return name;
    }

    // boxedSlot reserves the root slot of a captured variable. It holds the box
    // pointer, which is a heap pointer whatever T is.
    String boxedSlot(types.Type t) {
        return self.rootSlot(boxType(t));
    }

    FnState saveFn() {
        FnState s = {
            body: self.body, popSlots: self.popSlots, allocas: self.allocas,
            rootTypes: self.rootTypes,
            tmp: self.tmp, lbl: self.lbl, nlocal: self.nlocal, block: self.block,
            terminated: self.terminated, fnRet: self.fnRet, syms: self.syms,
            fnName: self.fnName,
            dbgSub: self.dbgSub,
            dbgLoc: self.dbgLoc,
            dbgFnLoc: self.dbgFnLoc,
            fnFallible: self.fnFallible, errDest: self.errDest,
            inAsync: self.inAsync, frameTypes: self.frameTypes, resumes: self.resumes,
            loops: self.loops, covBlk: self.covBlk, covLL: self.covLL,
        };
        return s;
    }

    void restoreFn(FnState s) {
        // beginFunction put a new array in each of these fields, so nothing
        // appended to the saved ones and they need no copy.
        self.body = s.body;
        self.popSlots = s.popSlots;
        self.allocas = s.allocas;
        self.rootTypes = s.rootTypes;
        self.tmp = s.tmp;
        self.lbl = s.lbl;
        self.nlocal = s.nlocal;
        self.block = s.block;
        self.terminated = s.terminated;
        self.fnRet = s.fnRet;
        self.fnName = s.fnName;
        self.dbgSub = s.dbgSub;
        self.dbgLoc = s.dbgLoc;
        self.dbgFnLoc = s.dbgFnLoc;
        self.syms = s.syms;
        self.fnFallible = s.fnFallible;
        self.errDest = s.errDest;
        self.inAsync = s.inAsync;
        self.frameTypes = s.frameTypes;
        self.resumes = s.resumes;
        self.loops = s.loops;
        self.covBlk = s.covBlk;
        self.covLL = s.covLL;
    }

    // ---- functions ----

    void genFunction(ast.FunctionDeclStatement fd) {
        types.FuncType? sig = self.info.funcs[fd.name];
        if (sig == null) {
            return;    // the checker records a signature for every declaration
        }
        if (fd.extern) {
            self.declareExtern(fd.name, sig);
            return;
        }
        self.genFunctionAs(fd, sig, fnSym(self.qual, fd.name), null);
    }

    // Emits the LLVM declare for an extern function (§5.8). The symbol is the
    // bare C name, with no mangling: it names a definition in a native source.
    // One declaration serves every module that binds it, because the loader has
    // held every declaration of one symbol to one signature.
    void declareExtern(String name, types.FuncType sig) {
        if (self.externDecls[name] != null) {
            return;
        }
        self.externDecls[name] = true;
        String[] ps = [];
        forEach(sig.params, p) {
            array.push(ps, llty(p));
        }
        array.push(self.globals, "declare " + retLL(sig) + " @" + name + "(" + string.join(ps, ", ") + ")\n");
    }

    // Emits the bodies of the methods of a type declaration. They are ordinary
    // functions taking the receiver before the declared arguments, so a method
    // costs a value of the type nothing. An inherited method (§2.4) is emitted
    // here too, under the symbol of this type and with the receiver typed as
    // this record: extending a type copies its methods, so two types share no
    // body.
    void genMethods(ast.TypeDeclStatement td) {
        types.Record? rec = self.info.records[td.name];
        if (rec == null) {
            return;
        }
        forEach(td.allMethods(), md) {
            types.FuncType? sig = rec.methodSig(md.name);
            if (sig != null) {
                HomeSave saved = self.enterHome(md);
                self.genFunctionAs(md, sig, methodSym(rec, md.name), rec);
                self.leaveHome(saved);
            }
        }
    }

    // Moves name resolution to the module that wrote an inherited body, and
    // returns what leaveHome needs to move it back. A copied body still calls
    // the functions of that module and reads its variables. Everything keyed by
    // an AST node stays with this module: the nodes are its copies, and the
    // checker typed them here.
    HomeSave enterHome(ast.FunctionDeclStatement md) {
        HomeSave s = {
            active: false, records: {}, enums: {}, funcs: {}, aliases: {},
            qual: self.qual, syms: self.baseSyms,
        };
        ast.Origin? from = md.from;
        if (from == null || from.qual == self.qual) {
            return s;
        }
        module.Module? home = self.modules[from.qual];
        if (home == null) {
            return s;
        }
        s.active = true;
        s.records = self.info.records;
        s.enums = self.info.enums;
        s.funcs = self.info.funcs;
        s.aliases = self.info.moduleAliases;
        self.info.records = home.info.records;
        self.info.enums = home.info.enums;
        self.info.funcs = home.info.funcs;
        self.info.moduleAliases = home.info.moduleAliases;
        self.qual = home.qual;
        Symtab? hs = self.modSyms[home.qual];
        if (hs != null) {
            self.baseSyms = hs;
        }
        return s;
    }

    void leaveHome(HomeSave s) {
        if (!s.active) {
            return;
        }
        self.info.records = s.records;
        self.info.enums = s.enums;
        self.info.funcs = s.funcs;
        self.info.moduleAliases = s.aliases;
        self.qual = s.qual;
        self.baseSyms = s.syms;
    }

    // Emits one function body under the given symbol. recv is the type of the
    // receiver when fd is a method, and it takes parameter slot 0. recv is null
    // for a plain function.
    void genFunctionAs(ast.FunctionDeclStatement fd, types.FuncType sig, String symbol, types.Type? recv) {
        if (fd.async) {
            self.genAsyncFunction(fd, sig, symbol, recv);
            return;
        }
        String[] params = [];
        int base = 0;
        if (recv != null) {
            array.push(params, "ptr %p0");
            base = 1;
        }
        forEach(sig.params, p, i) {
            array.push(params, llty(p) + " %p" + string.from(i + base));
        }
        String head = "define " + retLL(sig) + " " + symbol + "("
            + string.join(params, ", ") + ")" + self.attrRef + " {";

        self.beginFunction(sig.return, srcName(fd, recv), fd.nameTok.line);
        self.fnFallible = sig.fallible;
        self.syms = newSymtab(self.baseSyms);
        ast.Param? rp = fd.recv;
        if (recv != null && rp != null) {
            self.storeRecv(rp, recv);
        }
        self.storeParams(fd.params, sig, base);
        forEach(fd.body.statements, s) {
            self.genStatement(s, false);
        }
        self.endFunction(head, self.defaultTerm("missing return in function " + fd.name));
    }

    // Writes the receiver of a method, %p0, into the slot `self` names. That
    // slot is a heap box when a function value in the body captured it.
    void storeRecv(ast.Param p, types.Type t) {
        if (marked(self.info.boxedParams, p.id)) {
            String slot = self.boxedSlot(t);
            self.emit("store ptr %s, ptr %s", self.box("%p0", t), slot);
            self.syms.m[p.name] = newSym(slot, t, true);
            self.dbgLocal(p.name, slot, t, self.dbgFnLine, 0, true);
            return;
        }
        String slot = self.alloca(t);
        self.emit("store ptr %%p0, ptr %s", slot);
        self.syms.m[p.name] = newSym(slot, t, false);
        self.dbgLocal(p.name, slot, t, self.dbgFnLine, 0, false);
    }

    // Closes a function body that reached its end. A void function returns,
    // with a null error when it is fallible. Every other function fails as §5.5
    // describes.
    String defaultTerm(String msg) {
        if (!types.equal(self.fnRet, types.VoidT)) {
            return "call void @rt_panic(ptr " + self.cstr(msg) + ")\n  unreachable";
        }
        if (self.fnFallible) {
            return "ret ptr null";
        }
        return "ret void";
    }

    // Compiles an async function into its state machine: a `<symbol>.step`
    // function that runs the normalized body with every local in a heap frame,
    // and a `<symbol>.spawn` wrapper that allocates the frame and gives the task
    // to the scheduler. runtime.h describes the frame layout and the step
    // protocol. The frame slot of a receiver comes before those of the
    // parameters.
    void genAsyncFunction(ast.FunctionDeclStatement fd, types.FuncType sig, String symbol, types.Type? recv) {
        self.beginFunction(sig.return, srcName(fd, recv), fd.nameTok.line);
        self.inAsync = true;
        self.fnFallible = sig.fallible;
        self.frameTypes = [];
        self.resumes = [];
        self.syms = newSymtab(self.baseSyms);

        ast.Param? rp = fd.recv;
        if (recv != null && rp != null) {
            String slot = self.frameSlot(recv);
            if (marked(self.info.boxedParams, rp.id)) {
                String raw = self.newTmp();
                self.emit("%s = load ptr, ptr %s", raw, slot);
                String bslot = self.boxedSlot(recv);
                self.emit("store ptr %s, ptr %s", self.box(raw, recv), bslot);
                self.syms.m[rp.name] = newSym(bslot, recv, true);
                self.dbgLocal(rp.name, bslot, recv, self.dbgFnLine, 0, true);
            } else {
                self.syms.m[rp.name] = newSym(slot, recv, false);
                self.dbgLocal(rp.name, slot, recv, self.dbgFnLine, 0, false);
            }
        }
        // The spawn wrapper stores the arguments into these slots. A captured
        // parameter moves into a heap box in the prologue of state 0.
        forEach(fd.params, p, i) {
            String slot = self.frameSlot(sig.params[i]);
            if (marked(self.info.boxedParams, p.id)) {
                String raw = self.newTmp();
                self.emit("%s = load %s, ptr %s", raw, llty(sig.params[i]), slot);
                String b = self.box(raw, sig.params[i]);
                String bslot = self.boxedSlot(sig.params[i]);
                self.emit("store ptr %s, ptr %s", b, bslot);
                self.syms.m[p.name] = newSym(bslot, sig.params[i], true);
                self.dbgLocal(p.name, bslot, sig.params[i], self.dbgFnLine, i + 1, true);
            } else {
                self.syms.m[p.name] = newSym(slot, sig.params[i], false);
                self.dbgLocal(p.name, slot, sig.params[i], self.dbgFnLine, i + 1, false);
            }
        }
        forEach(fd.body.statements, s) {
            self.genStatement(s, false);
        }
        if (!self.terminated) {
            if (types.equal(sig.return, types.VoidT)) {
                self.terminate("ret i64 0");
            } else {
                self.emit("call void @rt_panic(ptr %s)",
                    self.cstr("missing return in function " + fd.name));
                self.terminate("unreachable");
            }
        }
        self.endAsyncFunction(symbol);

        types.Type[] frameTypes = self.frameTypes;
        self.inAsync = false;

        // The descriptor of the frame covers the header and every slot, so the
        // collector traces a live frame in any state. It is a TD_SLOTS and not
        // a TD_RECORD: slot [0] holds the resume state where a record holds its
        // descriptor.
        types.Record frameRec = {
            id: types.newID(),
            name: string.substring(symbol, 1, string.length(symbol)) + ".frame",
            qual: "", shown: "", base: null, sealed: false, extenders: [], fields: [], methods: [],
        };
        types.Type resultT = sig.return;
        if (types.equal(resultT, types.VoidT)) {
            resultT = types.IntT;
        }
        array.push(frameRec.fields, plainField("state", types.IntT));
        array.push(frameRec.fields, plainField("result", resultT));
        array.push(frameRec.fields, plainField("awaiting", types.newFutureType(types.IntT, false)));
        array.push(frameRec.fields, plainField("error", types.ErrorT));
        forEach(frameTypes, t, i) {
            array.push(frameRec.fields, plainField("s" + string.from(i), t));
        }
        self.genSpawnWrapper(symbol, sig, self.tdSlotsGlobal(frameRec),
            asyncFrameHeader + frameTypes.length * 8, recv, self.fnName, self.dbgFnLine);
    }

    // Builds a step function. Its entry block computes the address of every
    // frame slot, which dominates the code of all the states, and dispatches on
    // the stored resume state. State 0 starts the body.
    void endAsyncFunction(String symbol) {
        // The step function is the only definition that does not go through
        // endFunction, so it names its own subprogram: without one, every
        // variable of an async body describes a function LLVM cannot find and
        // is dropped on the way to DWARF.
        array.push(self.code, self.dbgHead("define internal i64 " + symbol + ".step(ptr %frame)"
            + self.attrRef + " {") + "\nentry:\n");
        array.push(self.code, "  %fawait = getelementptr i8, ptr %frame, i64 16\n");
        forEach(self.frameTypes, t, i) {
            array.push(self.code, "  %f" + string.from(i)
                + " = getelementptr i8, ptr %frame, i64 " + string.from(asyncFrameHeader + i * 8) + "\n");
        }
        array.push(self.code, "  %state = load i64, ptr %frame\n");
        String[] cases = [];
        forEach(self.resumes, label, i) {
            array.push(cases, "i64 " + string.from(i + 1) + ", label %" + label);
        }
        array.push(self.code, "  switch i64 %state, label %start [ " + string.join(cases, " ") + " ]\n");
        array.push(self.code, string.join(self.body, ""));
        array.push(self.code, "}\n\n");
    }

    // Emits the `<symbol>.spawn` function that every call of an async function
    // goes through. It allocates the frame, stores the arguments into its
    // parameter slots, and gives the task to the scheduler. It roots the
    // arguments first, because the allocation of the frame can collect.
    void genSpawnWrapper(String symbol, types.FuncType sig, String frameTD, int size, types.Type? recv,
        String name, int line) {
        // A receiver is the first argument and the first frame slot, so the two
        // lists stay parallel.
        types.Type[] incoming = sig.params;
        if (recv != null) {
            incoming = [];
            array.push(incoming, recv);
            forEach(sig.params, p) {
                array.push(incoming, p);
            }
        }
        String[] params = [];
        forEach(incoming, p, i) {
            array.push(params, llty(p) + " %p" + string.from(i));
        }
        String head = "define internal ptr " + symbol + ".spawn("
            + string.join(params, ", ") + ")" + self.attrRef + " {";

        self.beginFunction(types.newFutureType(sig.return, false), name, line);
        forEach(incoming, p, i) {
            self.protect("%p" + string.from(i), p);
        }
        String frame = self.newTmp();
        self.emit("%s = call ptr @rt_alloc(i64 %s)", frame, string.from(size));
        forEach(incoming, p, i) {
            String slot = self.newTmp();
            self.emit("%s = getelementptr i8, ptr %s, i64 %s", slot, frame,
                string.from(asyncFrameHeader + i * 8));
            self.emit("store %s %%p%s, ptr %s", llty(p), string.from(i), slot);
        }
        String resTD = "null";    // a void async function has no result to describe
        if (!types.equal(sig.return, types.VoidT)) {
            resTD = self.tdGlobal(sig.return);
        }
        String fu = self.newTmp();
        self.emit("%s = call ptr @rt_async_spawn(ptr %s.step, ptr %s, ptr %s, ptr %s)",
            fu, symbol, frame, frameTD, resTD);
        self.gcPop();
        self.terminate("ret ptr %s", fu);
        self.endFunction(head, "unreachable");
    }

    // Writes the incoming parameters into named slots. A parameter a function
    // value captures goes into a heap box shared with the closures.
    void storeParams(ast.Param[] params, types.FuncType sig, int base) {
        forEach(params, p, i) {
            String pv = "%p" + string.from(base + i);
            if (marked(self.info.boxedParams, p.id)) {
                String b = self.box(pv, sig.params[i]);
                String slot = self.boxedSlot(sig.params[i]);
                self.emit("store ptr %s, ptr %s", b, slot);
                self.syms.m[p.name] = newSym(slot, sig.params[i], true);
                self.dbgLocal(p.name, slot, sig.params[i], self.dbgFnLine, i + 1, true);
                continue;
            }
            String slot = self.alloca(sig.params[i]);
            self.emit("store %s %s, ptr %s", llty(sig.params[i]), pv, slot);
            self.syms.m[p.name] = newSym(slot, sig.params[i], false);
            self.dbgLocal(p.name, slot, sig.params[i], self.dbgFnLine, i + 1, false);
        }
    }

    // Emits the top-level statements of a module: everything but a type, an
    // enum and a function declaration.
    void genTopLevel(ast.Program prog) {
        self.syms = self.baseSyms;
        forEach(prog.statements, s) {
            ast.TypeDeclStatement? td = s as ast.TypeDeclStatement;
            ast.EnumDeclStatement? ed = s as ast.EnumDeclStatement;
            ast.FunctionDeclStatement? fd = s as ast.FunctionDeclStatement;
            if (td != null || ed != null || fd != null) {
                continue;
            }
            self.genStatement(s, true);
        }
    }

    // Puts the top-level code of an imported module in an init function, which
    // main calls before the code of the entry module.
    void genModuleInit(module.Module m) {
        // The qual of the module, and not its path. A path is absolute on the
        // machine that compiled, so it would put the home directory of the
        // developer in each binary and make the IR of the compiler depend on
        // the machine.
        self.beginFunction(types.VoidT, "<top level of " + m.qual + ">", 1);
        self.genTopLevel(m.prog);
        self.endFunction("define internal void " + initSym(m.qual) + "()" + self.attrRef + " {", "ret void");
    }

    // Emits the root table of every pointer-typed global. A global outlives
    // every frame, so main registers the table once and nothing pops it.
    void emitGCGlobals() {
        if (self.gcGlobals.length == 0) {
            return;
        }
        String[] entries = [];
        forEach(self.gcGlobals, gv) {
            array.push(entries, "%GCGlobal { ptr " + gv.sym + ", ptr " + self.tdGlobal(gv.t) + " }");
        }
        array.push(self.globals, "@gcglobals = private constant [" + string.from(entries.length)
            + " x %GCGlobal] [" + string.join(entries, ", ") + "]\n");
    }

    void genMain(module.Module[] deps, module.Module entry) {
        self.beginFunction(types.VoidT, "main", 1);
        // The parameters of main are the only place where the operating system
        // gives the command line. Thus it is saved first, whether or not the
        // program imports 'process'. rt_process_get_args reads the copy back.
        self.emit("call void @rt_args_init(i32 %%argc, ptr %%argv)");
        if (self.cov != null) {
            // Runs before the program, so a run ending in a panic or in
            // process.exit still reports. The call registers the atexit writer.
            self.emit("call void %s()", covSetupSym);
        }
        int n = self.gcGlobals.length;
        if (n > 0) {
            // Runs before any module init. The collector must know where the
            // globals are before one holds anything.
            self.emit("call void @rt_gc_globals(ptr @gcglobals, i64 %s)", string.from(n));
        }
        forEach(deps, m) {
            self.emit("call void %s()", initSym(m.qual));
        }
        self.genTopLevel(entry.prog);
        // Runs the async work that remains: every future nothing awaited, and
        // the callbacks async.run attached.
        self.emit("call void @rt_async_drain()");
        self.endFunction("define i32 @main(i32 %argc, ptr %argv)" + self.attrRef + " {", "ret i32 0");
    }

    // ---- statements ----

    // Emits the code for one statement. topLevel is true only for a statement
    // in main itself, where a variable declaration writes to a global.
    void genStatement(ast.Statement s, bool topLevel) {
        self.dbgAt(s.tok.line, s.tok.col);
        self.covHit(s);
        switch (s) {
            case ast.VarDeclStatement vd:
                types.Type t = types.InvalidT;
                types.Type? dt = self.info.declTypes[vd.id];
                if (dt != null) {
                    t = dt;
                }
                String v = "";
                ast.Expression? val = vd.value;
                if (val != null) {
                    v = self.genConverted(val, t);
                } else {
                    v = self.zeroValue(t);
                }
                if (topLevel) {
                    self.emit("store %s %s, ptr %s", llty(t), v, gvSym(self.qual, vd.name));
                } else if (marked(self.info.boxedVars, vd.id)) {
                    // A function value captures it, so the variable lives in a
                    // heap box the closures share with this frame.
                    String b = self.box(v, t);
                    String slot = self.boxedSlot(t);
                    self.emit("store ptr %s, ptr %s", b, slot);
                    self.syms.m[vd.name] = newSym(slot, t, true);
                    self.dbgLocal(vd.name, slot, t, vd.tok.line, 0, true);
                } else {
                    String slot = self.alloca(t);
                    self.emit("store %s %s, ptr %s", llty(t), v, slot);
                    self.syms.m[vd.name] = newSym(slot, t, false);
                    self.dbgLocal(vd.name, slot, t, vd.tok.line, 0, false);
                }
            case ast.AssignStatement asg:
                self.genAssign(asg);
            case ast.ExpressionStatement es:
                self.genExpr(es.expression);
            case ast.ReturnStatement ret:
                ast.Expression? rv = ret.value;
                if (rv != null && isRaiseValue(self.fnRet, self.typeOf(rv))) {
                    // `return Error(...)`, or `return e` in a catch block: the
                    // value leaves through the error channel.
                    self.emitRaise(self.genExpr(rv));
                } else if (self.inAsync) {
                    // The value goes into the result slot of the frame, at
                    // offset 8, and a return of 0 tells the scheduler the body
                    // is finished.
                    if (rv != null) {
                        String v = self.genConverted(rv, self.fnRet);
                        String slot = self.newTmp();
                        self.emit("%s = getelementptr i8, ptr %%frame, i64 8", slot);
                        self.emit("store %s %s, ptr %s", llty(self.fnRet), v, slot);
                    }
                    self.terminate("ret i64 0");
                } else if (rv == null) {
                    self.gcPop();
                    self.emitValueReturn("");
                } else {
                    String v = self.genConverted(rv, self.fnRet);
                    self.gcPop();
                    self.emitValueReturn(v);
                }
                self.startBlock(self.newLabel("dead"));
            case ast.IfStatement ifs:
                self.genIf(ifs);
            case ast.SwitchStatement sw:
                self.genSwitch(sw);
            case ast.WhileStatement wh:
                self.genWhile(wh);
            case ast.ForStatement fo:
                self.genFor(fo);
            case ast.IncDecStatement id:
                self.genIncDec(id);
            case ast.ForEachStatement fe:
                self.genForEach(fe);
            case ast.BreakStatement br:
                self.terminate("br label %%%s", self.loops[self.loops.length - 1].brk);
                self.startBlock(self.newLabel("dead"));
            case ast.ContinueStatement co:
                self.terminate("br label %%%s", self.loops[self.loops.length - 1].cont);
                self.startBlock(self.newLabel("dead"));
            case ast.BlockStatement blk:
                self.syms = newSymtab(self.syms);
                forEach(blk.statements, bs) {
                    self.genStatement(bs, false);
                }
                Symtab? outer = self.syms.outer;
                if (outer != null) {
                    self.syms = outer;
                }
            default:
                // An import and the declarations produce no code here.
                break;
        }
    }

    void genAssign(ast.AssignStatement st) {
        switch (st.target) {
            case ast.Identifier id:
                Sym s = missingSym();
                Sym? found = self.syms.lookup(id.name);
                if (found != null) {
                    s = found;
                }
                String v = self.genConverted(st.value, s.t);
                if (s.boxed) {
                    // The box is loaded after the value: the slot keeps it
                    // reachable across what the value allocates. The cell holds
                    // the value at its own width (§5.7), so the store truncates.
                    String bp = self.newTmp();
                    self.emit("%s = load ptr, ptr %s", bp, s.ptr);
                    self.storeElem(bp, v, s.t);
                } else {
                    self.emit("store %s %s, ptr %s", llty(s.t), v, s.ptr);
                }
            case ast.IndexExpression ix:
                types.Type at = self.typeOf(ix.left);
                if (types.equal(at, types.JsonT)) {
                    self.genJSONIndexAssign(ix, st.value);
                    return;
                }
                types.MapType? mt = at as types.MapType;
                if (mt != null) {
                    // The map is rooted across the key and the value, and the
                    // key across the value. rt_map_set roots all three across
                    // the allocations of its own growth.
                    String m = self.protect(self.genExpr(ix.left), mt);
                    String key = self.protect(self.genConverted(ix.index, mt.key), mt.key);
                    String mv = self.genConverted(st.value, mt.value);
                    self.emit("call void @rt_map_set(ptr %s, i64 %s, i64 %s, ptr %s)",
                        m, self.toRaw(key, llty(mt.key)), self.toRaw(mv, llty(mt.value)), self.tdGlobal(mt));
                    return;
                }
                // The array is rooted before the index and the value run,
                // because both can allocate. The slot address stays valid: the
                // collector never moves an object.
                String arr = self.protect(self.genExpr(ix.left), at);
                String idx = self.genExpr(ix.index);
                types.Type elem = asArray(at).elem;
                String slot = self.newTmp();
                self.emit("%s = call ptr @rt_arr_slot(ptr %s, i64 %s)", slot, arr, idx);
                String v = self.genConverted(st.value, elem);
                self.storeElem(slot, v, elem);
            case ast.MemberExpression mem:
                checker.ModuleExports? exp = self.moduleExports(mem.object);
                if (exp != null) {
                    types.Type t = types.InvalidT;
                    types.Type? vt = exp.vars[mem.property];
                    if (vt != null) {
                        t = vt;
                    }
                    String gv = self.genConverted(st.value, t);
                    self.emit("store %s %s, ptr %s", llty(t), gv, gvSym(checker.qualFor(exp, mem.property), mem.property));
                    return;
                }
                types.Record rt = asRecord(self.typeOf(mem.object));
                String rec = self.protect(self.genExpr(mem.object), rt);    // the value may allocate
                types.FieldSlot? fs = rt.fieldType(mem.property);
                if (fs == null) {
                    return;
                }
                String slot = self.newTmp();
                self.emit("%s = getelementptr i8, ptr %s, i64 %s", slot, rec, string.from(recOffset(rt, fs.index)));
                String fv = self.genConverted(st.value, fs.type);
                self.storeElem(slot, fv, fs.type);
            default:
                // The checker rejects every other assignment target.
                break;
        }
    }

    // moduleExports returns the exports of the user module e refers to, when e
    // is an identifier bound to an import alias. A built-in module gives null.
    checker.ModuleExports? moduleExports(ast.Expression e) {
        ast.Identifier? id = e as ast.Identifier;
        if (id == null) {
            return null;
        }
        checker.ModuleRef? ref = self.info.moduleAliases[id.name];
        if (ref == null) {
            return null;
        }
        return ref.exports;
    }

    String genCond(ast.Expression e) {
        String v = self.genExpr(e);
        String c = self.newTmp();
        self.emit("%s = icmp ne i64 %s, 0", c, v);
        return c;
    }

    void genIf(ast.IfStatement st) {
        String c = self.genCond(st.cond);
        String thenL = self.newLabel("then");
        String endL = self.newLabel("endif");
        String elseL = endL;
        ast.BlockStatement? els = st.else;
        if (els != null) {
            elseL = self.newLabel("else");
        }
        self.terminate("br i1 %s, label %%%s, label %%%s", c, thenL, elseL);

        self.startBlock(thenL);
        self.genStatement(st.then, false);
        if (!self.terminated) {
            self.terminate("br label %%%s", endL);
        }
        if (els != null) {
            self.startBlock(elseL);
            self.genStatement(els, false);
            if (!self.terminated) {
                self.terminate("br label %%%s", endL);
            }
        }
        self.startBlock(endL);
    }

    // Compiles a type switch (§4.9). Slot [0] holds the value's own descriptor,
    // and a hierarchy is one level deep, so a clause is one pointer comparison.
    void genTypeSwitch(ast.SwitchStatement st) {
        types.Type subjT = self.typeOf(st.subject);
        String subj = self.protect(self.genExpr(st.subject), subjT);

        String endL = self.newLabel("tsw.end");
        String[] bodyL = [];
        String defaultL = endL;
        forEach(st.cases, cl, i) {
            array.push(bodyL, self.newLabel("tsw.case"));
            if (cl.default) {
                defaultL = bodyL[i];
            }
        }

        // A null subject matches no type. An exhaustive switch must run one
        // clause (§4.9), so it panics here instead of falling through.
        String isNull = self.newTmp();
        self.emit("%s = icmp eq ptr %s, null", isNull, subj);
        String testL = self.newLabel("tsw.test");
        String nullL = defaultL;
        if (st.exhaustive) {
            nullL = self.newLabel("tsw.null");
        }
        self.terminate("br i1 %s, label %%%s, label %%%s", isNull, nullL, testL);
        if (st.exhaustive) {
            self.startBlock(nullL);
            self.emit("call void @rt_panic(ptr %s)",
                self.cstr("switch on a " + types.typeString(subjT) + " that was never assigned"));
            self.terminate("unreachable");
        }
        self.startBlock(testL);

        String td = self.newTmp();
        self.emit("%s = load ptr, ptr %s", td, subj);    // slot [0]: the value's own type
        forEach(st.cases, cl, i) {
            if (cl.typeName == null) {
                continue;    // the default clause
            }
            types.Record? ext = self.info.caseTypes[cl.id];
            if (ext == null) {
                continue;
            }
            String same = self.newTmp();
            self.emit("%s = icmp eq ptr %s, %s", same, td, self.tdGlobal(ext));
            String nextL = self.newLabel("tsw.test");
            self.terminate("br i1 %s, label %%%s, label %%%s", same, bodyL[i], nextL);
            self.startBlock(nextL);
        }
        self.terminate("br label %%%s", defaultL);

        LoopCtx brk = { brk: endL, cont: "" };
        if (self.loops.length > 0) {
            brk.cont = self.loops[self.loops.length - 1].cont;
        }
        array.push(self.loops, brk);
        forEach(st.cases, cl, i) {
            self.startBlock(bodyL[i]);
            self.syms = newSymtab(self.syms);
            types.Record? ext = self.info.caseTypes[cl.id];
            if (ext != null) {
                self.bindCase(cl, subj, ext);
            }
            self.genStatement(cl.body, false);
            Symtab? outer = self.syms.outer;
            if (outer != null) {
                self.syms = outer;
            }
            if (!self.terminated) {
                self.terminate("br label %%%s", endL);
            }
        }
        array.pop(self.loops);
        self.startBlock(endL);
    }

    // Binds the name of a type case to the subject at the narrower type, which
    // is the same pointer. An entry in Info.casePayloads marks a union member,
    // whose clause binds field 0 instead.
    void bindCase(ast.SwitchCase cl, String subj, types.Record ext) {
        types.Type? pay = self.info.casePayloads[cl.id];
        if (pay != null) {
            types.Type pt = pay;
            String fld = self.newTmp();
            self.emit("%s = getelementptr i8, ptr %s, i64 %s", fld, subj, string.from(recOffset(ext, 0)));
            String v = self.loadElem(fld, pt);
            if (marked(self.info.boxedCaseBinds, cl.id)) {
                String b = self.box(v, pt);
                String bs = self.boxedSlot(pt);
                self.emit("store ptr %s, ptr %s", b, bs);
                self.syms.m[cl.bind] = newSym(bs, pt, true);
                self.dbgLocal(cl.bind, bs, pt, cl.bindTok.line, 0, true);
                return;
            }
            String ps = self.alloca(pt);
            self.emit("store %s %s, ptr %s", llty(pt), v, ps);
            self.syms.m[cl.bind] = newSym(ps, pt, false);
            self.dbgLocal(cl.bind, ps, pt, cl.bindTok.line, 0, false);
            return;
        }
        if (marked(self.info.boxedCaseBinds, cl.id)) {
            // A function value captures it, so the binding lives in a heap box
            // that the closures share with this frame.
            String b = self.box(subj, ext);
            String slot = self.boxedSlot(ext);
            self.emit("store ptr %s, ptr %s", b, slot);
            self.syms.m[cl.bind] = newSym(slot, ext, true);
            self.dbgLocal(cl.bind, slot, ext, cl.bindTok.line, 0, true);
            return;
        }
        String slot = self.alloca(ext);
        self.emit("store ptr %s, ptr %s", subj, slot);
        self.syms.m[cl.bind] = newSym(slot, ext, false);
        self.dbgLocal(cl.bind, slot, ext, cl.bindTok.line, 0, false);
    }

    // Compiles a value switch (§4.9) into a chain of comparisons. There is no
    // fall-through. The switch pushes a LoopCtx to catch `break`, and keeps the
    // continue target of the enclosing loop, because a switch is not an
    // iteration.
    void genSwitch(ast.SwitchStatement st) {
        if (st.isTypeSwitch()) {
            self.genTypeSwitch(st);
            return;
        }
        types.Type subjT = self.typeOf(st.subject);
        // A comparison against an optional allocates a box, so the subject
        // stays rooted for the whole chain.
        String subj = self.protect(self.genExpr(st.subject), subjT);

        String endL = self.newLabel("sw.end");
        String[] bodyL = [];
        String defaultL = endL;
        forEach(st.cases, cl, i) {
            array.push(bodyL, self.newLabel("sw.case"));
            if (cl.default) {
                defaultL = bodyL[i];
            }
        }

        forEach(st.cases, cl, i) {
            forEach(cl.values, v) {
                String val = self.genExpr(v);
                String eq = self.genEqValues(subj, subjT, val, self.typeOf(v), true);
                String c = self.newTmp();
                self.emit("%s = icmp ne i64 %s, 0", c, eq);
                String nextL = self.newLabel("sw.test");
                self.terminate("br i1 %s, label %%%s, label %%%s", c, bodyL[i], nextL);
                self.startBlock(nextL);
            }
        }
        self.terminate("br label %%%s", defaultL);

        LoopCtx brk = { brk: endL, cont: "" };
        if (self.loops.length > 0) {
            brk.cont = self.loops[self.loops.length - 1].cont;
        }
        array.push(self.loops, brk);
        forEach(st.cases, cl, i) {
            self.startBlock(bodyL[i]);
            self.genStatement(cl.body, false);
            if (!self.terminated) {
                self.terminate("br label %%%s", endL);
            }
        }
        array.pop(self.loops);
        self.startBlock(endL);
    }

    // Compiles `while (cond) { ... }`. A tail that the await normalizer added
    // gets a block of its own, which the body end and a `continue` both reach.
    void genWhile(ast.WhileStatement st) {
        String condL = self.newLabel("while.cond");
        String bodyL = self.newLabel("while.body");
        String endL = self.newLabel("while.end");
        String contL = condL;
        if (st.tail.length > 0) {
            contL = self.newLabel("while.cont");
        }
        self.terminate("br label %%%s", condL);

        self.startBlock(condL);
        String c = self.genCond(st.cond);
        self.terminate("br i1 %s, label %%%s, label %%%s", c, bodyL, endL);

        self.startBlock(bodyL);
        LoopCtx lc = { brk: endL, cont: contL };
        array.push(self.loops, lc);
        self.genStatement(st.body, false);
        array.pop(self.loops);
        if (!self.terminated) {
            self.terminate("br label %%%s", contL);
        }
        if (contL != condL) {
            self.startBlock(contL);
            self.syms = newSymtab(self.syms);
            forEach(st.tail, ts) {
                self.genStatement(ts, false);
            }
            Symtab? outer = self.syms.outer;
            if (outer != null) {
                self.syms = outer;
            }
            if (!self.terminated) {
                self.terminate("br label %%%s", condL);
            }
        }
        self.startBlock(endL);
    }

    // Compiles `for (init; cond; post) { ... }`. The init declaration and the
    // body share one scope, as they do in the checker. A `continue` must still
    // run the post clause, so a body that holds one gets a post block to jump to.
    void genFor(ast.ForStatement st) {
        self.syms = newSymtab(self.syms);
        ast.Statement? init = st.init;
        if (init != null) {
            self.genStatement(init, false);
        }
        String condL = self.newLabel("for.cond");
        String bodyL = self.newLabel("for.body");
        String endL = self.newLabel("for.end");
        String contL = condL;
        ast.Statement? post = st.post;
        if (post != null && hasContinue(st.body.statements)) {
            contL = self.newLabel("for.post");
        }
        self.terminate("br label %%%s", condL);

        self.startBlock(condL);
        String c = self.genCond(st.cond);
        self.terminate("br i1 %s, label %%%s, label %%%s", c, bodyL, endL);

        self.startBlock(bodyL);
        LoopCtx lc = { brk: endL, cont: contL };
        array.push(self.loops, lc);
        forEach(st.body.statements, bs) {
            self.genStatement(bs, false);
        }
        array.pop(self.loops);
        if (contL == condL) {
            if (!self.terminated) {
                if (post != null) {
                    self.genStatement(post, false);
                }
                self.terminate("br label %%%s", condL);
            }
        } else {
            if (!self.terminated) {
                self.terminate("br label %%%s", contL);
            }
            self.startBlock(contL);
            if (post != null) {
                self.genStatement(post, false);
            }
            self.terminate("br label %%%s", condL);
        }
        self.startBlock(endL);
        Symtab? outer = self.syms.outer;
        if (outer != null) {
            self.syms = outer;
        }
    }

    // Compiles `target++;` and `target--;`. A narrowed optional target reads
    // through its box and stores a new box back.
    void genIncDec(ast.IncDecStatement st) {
        Slot sl = self.genIncDecSlot(st.target);
        String slot = sl.ptr;
        types.Type t = sl.t;
        bool narrowed = marked(self.info.narrowed, st.target.id);
        if (narrowed) {
            t = self.typeOf(st.target);    // the inner int or float
        }
        String v = self.newTmp();
        if (narrowed) {
            String box = self.newTmp();
            self.emit("%s = load ptr, ptr %s", box, slot);
            v = self.unwrapNarrowed(box, t);
        } else if (sl.packed) {
            v = self.loadElem(slot, t);
        } else {
            self.emit("%s = load %s, ptr %s", v, llty(t), slot);
        }
        String nv = self.newTmp();
        if (types.isFloatFamily(t)) {
            String op = "fadd";
            if (st.op == "--") {
                op = "fsub";
            }
            self.emit("%s = %s double %s, %s", nv, op, v, llFloat(1.0));
        } else {
            String op = "add";
            if (st.op == "--") {
                op = "sub";
            }
            self.emit("%s = %s i64 %s, 1", nv, op, v);
        }
        nv = self.fitResult(nv, t);
        if (narrowed) {
            self.emit("store ptr %s, ptr %s", self.box(nv, t), slot);
            return;
        }
        if (sl.packed) {
            self.storeElem(slot, nv, t);
            return;
        }
        self.emit("store %s %s, ptr %s", llty(t), nv, slot);
    }

    // Resolves an increment target to the address of its storage and the type
    // stored there. Only a narrowed target allocates between the slot and its
    // store, so only that case roots the object the slot points into.
    Slot genIncDecSlot(ast.Expression target) {
        switch (target) {
            case ast.Identifier id:
                Sym s = missingSym();
                Sym? found = self.syms.lookup(id.name);
                if (found != null) {
                    s = found;
                }
                if (s.boxed) {
                    // The cell of the box holds the value at its own width
                    // (§5.7), so the slot is packed.
                    String bp = self.newTmp();
                    self.emit("%s = load ptr, ptr %s", bp, s.ptr);
                    return newPackedSlot(bp, s.t);
                }
                return newSlot(s.ptr, s.t);
            case ast.IndexExpression ix:
                // The index expression can allocate, so the array is rooted
                // first.
                types.Type at = self.typeOf(ix.left);
                String arr = self.protect(self.genExpr(ix.left), at);
                String idx = self.genExpr(ix.index);
                String slot = self.newTmp();
                self.emit("%s = call ptr @rt_arr_slot(ptr %s, i64 %s)", slot, arr, idx);
                return newPackedSlot(slot, asArray(at).elem);
            case ast.MemberExpression mem:
                checker.ModuleExports? exp = self.moduleExports(mem.object);
                if (exp != null) {
                    types.Type t = types.InvalidT;
                    types.Type? vt = exp.vars[mem.property];
                    if (vt != null) {
                        t = vt;
                    }
                    return newSlot(gvSym(checker.qualFor(exp, mem.property), mem.property), t);
                }
                types.Record rt = asRecord(self.typeOf(mem.object));
                String rec = self.genExpr(mem.object);
                if (marked(self.info.narrowed, target.id)) {
                    // The new box allocates, so the record the slot points into
                    // must stay rooted.
                    self.protect(rec, rt);
                }
                types.FieldSlot? fs = rt.fieldType(mem.property);
                if (fs == null) {
                    unreachable("no such field: " + mem.property);
                    return newSlot("", types.InvalidT);
                }
                String slot = self.newTmp();
                self.emit("%s = getelementptr i8, ptr %s, i64 %s", slot, rec, string.from(recOffset(rt, fs.index)));
                // A field takes its own width (§5.7).
                return newPackedSlot(slot, fs.type);
            default:
                unreachable("invalid ++/-- target survived the checker");
                return newSlot("", types.InvalidT);
        }
    }

    // forEach over a String (§4.7): the loop of genForEach with the byte
    // offset as the counter and one code point decoded at each offset.
    // rt_str_decode answers the point and writes its width, which advances
    // the offset. A byte that begins no valid sequence is U+FFFD, one byte
    // wide, so the walk visits every byte once and always ends. As in the
    // array loop, all state is in slots, so a resume jump can enter the loop
    // without its header.
    void genForEachString(ast.ForEachStatement st) {
        String s0 = self.genExpr(st.array);
        String sSlot = self.rootSlot(types.StringT);
        self.emit("store ptr %s, ptr %s", s0, sSlot);
        String ln0 = self.newTmp();
        self.emit("%s = load i64, ptr %s", ln0, s0);    // Str.len is the header's first word
        String lnSlot = self.alloca(types.IntT);
        self.emit("store i64 %s, ptr %s", ln0, lnSlot);
        String iSlot = self.alloca(types.IntT);
        self.emit("store i64 0, ptr %s", iSlot);
        String wSlot = self.alloca(types.IntT);

        bool boxedElem = marked(self.info.boxedElems, st.id);
        bool boxedIdx = marked(self.info.boxedIndexes, st.id);
        String elemSlot = "";
        if (boxedElem) {
            elemSlot = self.boxedSlot(types.IntT);
        } else {
            elemSlot = self.alloca(types.IntT);
        }
        String idxSlot = "";
        if (st.indexName != "") {
            if (boxedIdx) {
                idxSlot = self.boxedSlot(types.IntT);
            } else {
                idxSlot = self.alloca(types.IntT);
            }
        }

        String condL = self.newLabel("fs.cond");
        String bodyL = self.newLabel("fs.body");
        String endL = self.newLabel("fs.end");
        String contL = condL;
        if (hasContinue(st.body.statements)) {
            contL = self.newLabel("fs.next");
        }
        self.terminate("br label %%%s", condL);

        self.startBlock(condL);
        String i = self.newTmp();
        self.emit("%s = load i64, ptr %s", i, iSlot);
        String ln = self.newTmp();
        self.emit("%s = load i64, ptr %s", ln, lnSlot);
        String c = self.newTmp();
        self.emit("%s = icmp slt i64 %s, %s", c, i, ln);
        self.terminate("br i1 %s, label %%%s, label %%%s", c, bodyL, endL);

        self.startBlock(bodyL);
        String s = self.newTmp();
        self.emit("%s = load ptr, ptr %s", s, sSlot);
        String r = self.newTmp();
        self.emit("%s = call i64 @rt_str_decode(ptr %s, i64 %s, ptr %s)", r, s, i, wSlot);
        if (boxedElem) {
            self.emit("store ptr %s, ptr %s", self.box(r, types.IntT), elemSlot);
        } else {
            self.emit("store i64 %s, ptr %s", r, elemSlot);
        }
        if (idxSlot != "") {
            if (boxedIdx) {
                self.emit("store ptr %s, ptr %s", self.box(i, types.IntT), idxSlot);
            } else {
                self.emit("store i64 %s, ptr %s", i, idxSlot);
            }
        }

        self.syms = newSymtab(self.syms);
        self.syms.m[st.elemName] = newSym(elemSlot, types.IntT, boxedElem);
        self.dbgLocal(st.elemName, elemSlot, types.IntT, st.elemTok.line, 0, boxedElem);
        if (st.indexName != "") {
            self.syms.m[st.indexName] = newSym(idxSlot, types.IntT, boxedIdx);
            self.dbgLocal(st.indexName, idxSlot, types.IntT, st.indexTok.line, 0, boxedIdx);
        }
        LoopCtx lc = { brk: endL, cont: contL };
        array.push(self.loops, lc);
        forEach(st.body.statements, bs) {
            self.genStatement(bs, false);
        }
        array.pop(self.loops);
        Symtab? outer = self.syms.outer;
        if (outer != null) {
            self.syms = outer;
        }

        if (contL != condL) {
            if (!self.terminated) {
                self.terminate("br label %%%s", contL);
            }
            self.startBlock(contL);
        }
        if (!self.terminated) {
            String iend = self.newTmp();
            self.emit("%s = load i64, ptr %s", iend, iSlot);
            String w = self.newTmp();
            self.emit("%s = load i64, ptr %s", w, wSlot);
            String inext = self.newTmp();
            self.emit("%s = add i64 %s, %s", inext, iend, w);
            self.emit("store i64 %s, ptr %s", inext, iSlot);
            self.terminate("br label %%%s", condL);
        }
        self.startBlock(endL);
    }

    // Compiles `forEach (arr, elem[, idx]) { ... }` into an index loop. The
    // element binding holds a copy, so an assignment to it does not write back
    // into the array.
    void genForEach(ast.ForEachStatement st) {
        types.Type at = self.typeOf(st.array);
        if (types.equal(at, types.StringT)) {
            self.genForEachString(st);
            return;
        }
        // The array and the length live in slots, which also root them across
        // the body. A resume jump can enter the loop without its header, so no
        // SSA value defined here may cross a suspension point.
        String arr0 = self.genExpr(st.array);
        String arrSlot = self.rootSlot(at);
        self.emit("store ptr %s, ptr %s", arr0, arrSlot);
        types.Type elem = asArray(at).elem;
        String ln0 = self.newTmp();
        self.emit("%s = call i64 @rt_arr_len(ptr %s)", ln0, arr0);
        String lnSlot = self.alloca(types.IntT);
        self.emit("store i64 %s, ptr %s", ln0, lnSlot);

        String iSlot = self.alloca(types.IntT);
        self.emit("store i64 0, ptr %s", iSlot);
        // A captured binding gets a new box each iteration, so the closures of
        // one iteration see the value of that iteration.
        bool boxedElem = marked(self.info.boxedElems, st.id);
        bool boxedIdx = marked(self.info.boxedIndexes, st.id);
        String elemSlot = "";
        if (boxedElem) {
            elemSlot = self.boxedSlot(elem);
        } else {
            elemSlot = self.alloca(elem);
        }
        String idxSlot = "";
        if (st.indexName != "") {
            if (boxedIdx) {
                idxSlot = self.boxedSlot(types.IntT);
            } else {
                idxSlot = self.alloca(types.IntT);
            }
        }

        String condL = self.newLabel("fe.cond");
        String bodyL = self.newLabel("fe.body");
        String endL = self.newLabel("fe.end");
        // A `continue` must still advance the counter, so a body that holds one
        // gets a block for it.
        String contL = condL;
        if (hasContinue(st.body.statements)) {
            contL = self.newLabel("fe.next");
        }
        self.terminate("br label %%%s", condL);

        self.startBlock(condL);
        String i = self.newTmp();
        self.emit("%s = load i64, ptr %s", i, iSlot);
        String ln = self.newTmp();
        self.emit("%s = load i64, ptr %s", ln, lnSlot);
        String c = self.newTmp();
        self.emit("%s = icmp slt i64 %s, %s", c, i, ln);
        self.terminate("br i1 %s, label %%%s, label %%%s", c, bodyL, endL);

        self.startBlock(bodyL);
        String arr = self.newTmp();
        self.emit("%s = load ptr, ptr %s", arr, arrSlot);
        String slot = self.newTmp();
        self.emit("%s = call ptr @rt_arr_slot(ptr %s, i64 %s)", slot, arr, i);
        String ev = self.loadElem(slot, elem);
        if (boxedElem) {
            self.emit("store ptr %s, ptr %s", self.box(ev, elem), elemSlot);
        } else {
            self.emit("store %s %s, ptr %s", llty(elem), ev, elemSlot);
        }
        if (idxSlot != "") {
            if (boxedIdx) {
                self.emit("store ptr %s, ptr %s", self.box(i, types.IntT), idxSlot);
            } else {
                self.emit("store i64 %s, ptr %s", i, idxSlot);
            }
        }

        self.syms = newSymtab(self.syms);
        self.syms.m[st.elemName] = newSym(elemSlot, elem, boxedElem);
        self.dbgLocal(st.elemName, elemSlot, elem, st.elemTok.line, 0, boxedElem);
        if (st.indexName != "") {
            self.syms.m[st.indexName] = newSym(idxSlot, types.IntT, boxedIdx);
            self.dbgLocal(st.indexName, idxSlot, types.IntT, st.indexTok.line, 0, boxedIdx);
        }
        LoopCtx lc = { brk: endL, cont: contL };
        array.push(self.loops, lc);
        forEach(st.body.statements, bs) {
            self.genStatement(bs, false);
        }
        array.pop(self.loops);
        Symtab? outer = self.syms.outer;
        if (outer != null) {
            self.syms = outer;
        }

        if (contL != condL) {
            if (!self.terminated) {
                self.terminate("br label %%%s", contL);
            }
            self.startBlock(contL);
        }
        if (!self.terminated) {
            String iend = self.newTmp();
            self.emit("%s = load i64, ptr %s", iend, iSlot);
            String inext = self.newTmp();
            self.emit("%s = add i64 %s, 1", inext, iend);
            self.emit("store i64 %s, ptr %s", inext, iSlot);
            self.terminate("br label %%%s", condL);
        }
        self.startBlock(endL);
    }

    // ---- expressions ----

    String genExpr(ast.Expression e) {
        // `Union.Tag(v)` is not a call. The checker resolved it to the member,
        // and the value is its only argument.
        types.Record? ctor = self.info.unionCtors[e.id];
        if (ctor != null) {
            ast.CallExpression? c = e as ast.CallExpression;
            if (c != null && c.args.length == 1) {
                return self.genUnionWrap(self.genExpr(c.args[0]), ctor);
            }
        }
        types.Record? arm = self.info.unionWraps[e.id];
        if (arm != null) {
            // genExprInner, not genExpr: the entry is keyed by this node, so
            // genExpr would wrap it again without end.
            return self.genUnionWrap(self.genExprInner(e), arm);
        }
        return self.genExprInner(e);
    }

    // Puts a value into the union member that rule 7 of §2.10 chose, or that
    // `Union.Tag(v)` named. A member is an ordinary record of one field, so
    // the code after this point does not see the union.
    String genUnionWrap(String value, types.Record arm) {
        types.Type pt = arm.fields[0].type;
        String v = self.protect(value, pt);    // the allocation below can collect
        String r = self.newTmp();
        self.emit("%s = call ptr @rt_alloc(i64 %s)", r, string.from(recSizeOf(arm)));
        self.emit("store ptr %s, ptr %s", self.tdGlobal(arm), r);    // see genRecordLiteral
        String fld = self.newTmp();
        self.emit("%s = getelementptr i8, ptr %s, i64 %s", fld, r, string.from(recOffset(arm, 0)));
        self.storeElem(fld, v, pt);
        return r;
    }

    String genExprInner(ast.Expression e) {
        switch (e) {
            case ast.IntLiteral il:
                return string.from(il.value);
            case ast.FloatLiteral fl:
                // A float32 is a double that round-trips through binary32, so
                // the literal rounds here, once.
                if (types.bits(self.typeOf(fl)) == 32) {
                    return llFloat(roundFloat32(fl.value));
                }
                return llFloat(fl.value);
            case ast.StringLiteral sl:
                return self.strGlobal(sl.value);
            case ast.BoolLiteral bl:
                if (bl.value) {
                    return "1";
                }
                return "0";
            case ast.NullLiteral nl:
                return "null";
            case ast.Identifier id:
                // An identifier at a value position is a variable. A function
                // has no value form, and a program can only call one.
                Sym s = missingSym();
                Sym? found = self.syms.lookup(id.name);
                if (found != null) {
                    s = found;
                }
                String v = "";
                if (s.boxed) {
                    // A captured variable lives in a heap box, at its own
                    // width (§5.7).
                    String bp = self.newTmp();
                    self.emit("%s = load ptr, ptr %s", bp, s.ptr);
                    v = self.loadElem(bp, s.t);
                } else {
                    v = self.newTmp();
                    self.emit("%s = load %s, ptr %s", v, llty(s.t), s.ptr);
                }
                if (marked(self.info.narrowed, id.id)) {
                    return self.unwrapNarrowed(v, self.typeOf(id));
                }
                return v;
            case ast.PrefixExpression pre:
                return self.genPrefix(pre);
            case ast.InfixExpression inf:
                return self.genInfix(inf);
            case ast.CatchExpr ce:
                return self.genCatch(ce);
            case ast.ArrayLiteral al:
                return self.genArrayLiteral(al);
            case ast.RecordLiteral rl:
                types.MapType? mt = self.typeOf(rl) as types.MapType;
                if (mt != null) {
                    // `{}` where a map is expected is the empty map literal.
                    String mv = self.newTmp();
                    self.emit("%s = call ptr @rt_map_new()", mv);
                    return mv;
                }
                return self.genRecordLiteral(rl);
            case ast.MapLiteral ml:
                return self.genMapLiteral(ml);
            case ast.IndexExpression ix:
                types.Type lt = self.typeOf(ix.left);
                types.Optional? opt = lt as types.Optional;
                if (opt != null) {
                    return self.genChainIndex(ix);    // `a?.items[0]`: continues the chain
                }
                types.MapType? imt = lt as types.MapType;
                if (imt != null) {
                    return self.genMapGet(ix, imt);
                }
                if (types.equal(lt, types.JsonT)) {
                    return self.genJSONIndex(ix);
                }
                if (types.equal(lt, types.StringT)) {
                    // The index expression can allocate, so the string stays
                    // rooted. The byte comes back zero-extended into its i64 unit.
                    String sv = self.protect(self.genExpr(ix.left), types.StringT);
                    String sidx = self.genExpr(ix.index);
                    String sb = self.newTmp();
                    self.emit("%s = call i64 @rt_str_byte(ptr %s, i64 %s)", sb, sv, sidx);
                    return sb;
                }
                String arr = self.protect(self.genExpr(ix.left), lt);
                String idx = self.genExpr(ix.index);
                String slot = self.newTmp();
                self.emit("%s = call ptr @rt_arr_slot(ptr %s, i64 %s)", slot, arr, idx);
                return self.loadElem(slot, self.typeOf(ix));
            case ast.MemberExpression mem:
                return self.genMember(mem);
            case ast.CallExpression call:
                return self.genCall(call);
            case ast.FuncLit fn:
                return self.genFuncLit(fn);
            case ast.AsExpression ae:
                return self.genAs(ae);
            case ast.AwaitExpr aw:
                if (self.inAsync) {
                    return self.genAwaitSuspend(aw);
                }
                // Outside an async function, an await drives the scheduler
                // until the future completes. rt_await roots the future itself.
                String fu = self.genExpr(aw.value);
                String raw = self.newTmp();
                self.emit("%s = call i64 @rt_await(ptr %s)", raw, fu);
                types.Type at = self.typeOf(aw);
                if (marked(self.info.raises, aw.id)) {
                    self.raiseFutureError(fu);
                }
                if (types.equal(at, types.VoidT)) {
                    return "";    // awaiting a Future<void> yields nothing
                }
                return self.fromRaw(raw, llty(at));
        }
        return "0";
    }

    // Compiles an await in an async body as a suspension point. The future goes
    // into frame slot [2]. An incomplete future makes the step store its resume
    // state and return 1, and the scheduler re-enters at the resume label
    // through the dispatch switch. Everything on the resume path comes from the
    // frame, so no SSA value crosses the suspension.
    String genAwaitSuspend(ast.AwaitExpr ex) {
        String fu = self.genExpr(ex.value);
        String isNull = self.newTmp();
        String nullL = self.newLabel("aw.null");
        String checkL = self.newLabel("aw.check");
        self.emit("%s = icmp eq ptr %s, null", isNull, fu);
        self.terminate("br i1 %s, label %%%s, label %%%s", isNull, nullL, checkL);
        self.startBlock(nullL);
        self.emit("call void @rt_panic(ptr %s)", self.cstr("awaited a future that was never assigned"));
        self.terminate("unreachable");

        self.startBlock(checkL);
        self.emit("store ptr %s, ptr %%fawait", fu);
        int state = self.resumes.length + 1;
        String resumeL = "resume" + string.from(state);
        array.push(self.resumes, resumeL);
        String st = self.newTmp();
        self.emit("%s = load i64, ptr %s", st, fu);    // Future.state, offset 0
        String done = self.newTmp();
        self.emit("%s = icmp eq i64 %s, 1", done, st);    // FUT_DONE
        String suspendL = self.newLabel("aw.suspend");
        self.terminate("br i1 %s, label %%%s, label %%%s", done, resumeL, suspendL);

        self.startBlock(suspendL);
        self.emit("store i64 %s, ptr %%frame", string.from(state));    // frame.state, offset 0
        self.terminate("ret i64 1");

        self.startBlock(resumeL);
        String fu2 = self.newTmp();
        self.emit("%s = load ptr, ptr %%fawait", fu2);
        String rslot = self.newTmp();
        self.emit("%s = getelementptr i8, ptr %s, i64 8", rslot, fu2);    // Future.result
        String raw = self.newTmp();
        self.emit("%s = load i64, ptr %s", raw, rslot);
        self.emit("store ptr null, ptr %%fawait");    // done with it; let it collect
        if (marked(self.info.raises, ex.id)) {
            self.raiseFutureError(fu2);
        }
        types.Type t = self.typeOf(ex);
        if (types.equal(t, types.VoidT)) {
            return "";
        }
        return self.fromRaw(raw, llty(t));
    }

    // Compiles a function value. The body moves into a lifted function that
    // takes the closure block as a hidden first parameter. The block is the
    // value: slot [0] holds the code pointer, slot [1] the capture TypeDesc the
    // collector reads, and slots from [2] one pointer per capture (runtime.h).
    // A capture is by reference: each slot points at the heap box of the
    // variable, so the closure and the declaration share one cell.
    String genFuncLit(ast.FuncLit ex) {
        checker.Lambda? lam = self.info.lambdas[ex.id];
        if (lam == null) {
            unreachable("a function value the checker did not record");
            return "null";
        }
        types.FuncType sig = lam.sig;
        String fnName = "@lambda." + string.from(self.nlam);
        self.nlam++;

        // The capture descriptor, built as a generated record of boxes.
        types.Record envRec = {
            id: types.newID(),
            name: string.substring(fnName, 1, string.length(fnName)) + ".env",
            qual: self.qual, shown: "", base: null, sealed: false,
            extenders: [], fields: [], methods: [],
        };
        forEach(lam.captures, cap) {
            array.push(envRec.fields, plainField(cap.name, boxType(cap.type)));
        }
        String envTD = self.tdGlobal(envRec);

        // The output receives whole functions only, so the state under
        // construction is saved first. A function value is never async, so the
        // async mode of an enclosing step function does not reach it.
        FnState saved = self.saveFn();
        self.beginFunction(sig.return, "<function literal in " + saved.fnName + ">", ex.tok.line);
        self.inAsync = false;
        self.fnFallible = sig.fallible;
        self.syms = newSymtab(self.baseSyms);
        self.storeParams(ex.params, sig, 1);
        forEach(lam.captures, cap, i) {
            String src = self.newTmp();
            self.emit("%s = getelementptr i8, ptr %%p0, i64 %s", src, string.from(16 + i * 8));
            String bp = self.newTmp();
            self.emit("%s = load ptr, ptr %s", bp, src);
            String slot = self.boxedSlot(cap.type);
            self.emit("store ptr %s, ptr %s", bp, slot);
            self.syms.m[cap.name] = newSym(slot, cap.type, true);
            self.dbgLocal(cap.name, slot, cap.type, ex.tok.line, 0, true);
        }
        ast.BlockStatement? blk = ex.blockBody;
        ast.Expression? ebody = ex.exprBody;
        if (blk != null) {
            forEach(blk.statements, s) {
                self.genStatement(s, false);
            }
        } else if (ebody != null && types.equal(sig.return, types.VoidT)) {
            self.genExpr(ebody);    // evaluated, value (if any) discarded
        } else if (ebody != null) {
            if (isRaiseValue(sig.return, self.typeOf(ebody))) {
                self.emitRaise(self.genExpr(ebody));
            } else {
                String v = self.genConverted(ebody, sig.return);
                self.gcPop();
                self.emitValueReturn(v);
            }
        }
        String[] params = [];
        array.push(params, "ptr %p0");
        forEach(sig.params, pt, i) {
            array.push(params, llty(pt) + " %p" + string.from(i + 1));
        }
        String head = "define internal " + retLL(sig) + " " + fnName + "("
            + string.join(params, ", ") + ")" + self.attrRef + " {";
        self.endFunction(head, self.defaultTerm("missing return in function value"));
        self.restoreFn(saved);

        // rt_alloc clears the block, and the collector reads a null descriptor
        // as "no captures yet", so the block can be rooted before its slots
        // hold values.
        String clos = self.newTmp();
        self.emit("%s = call ptr @rt_alloc(i64 %s)", clos, string.from(16 + lam.captures.length * 8));
        self.protect(clos, sig);
        self.emit("store ptr %s, ptr %s", fnName, clos);
        String tdSlot = self.newTmp();
        self.emit("%s = getelementptr i8, ptr %s, i64 8", tdSlot, clos);
        self.emit("store ptr %s, ptr %s", envTD, tdSlot);
        forEach(lam.captures, cap, i) {
            Sym s = missingSym();
            Sym? found = self.syms.lookup(cap.name);    // always boxed
            if (found != null) {
                s = found;
            }
            String bp = self.newTmp();
            self.emit("%s = load ptr, ptr %s", bp, s.ptr);
            String slot = self.newTmp();
            self.emit("%s = getelementptr i8, ptr %s, i64 %s", slot, clos, string.from(16 + i * 8));
            self.emit("store ptr %s, ptr %s", bp, slot);
        }
        return clos;
    }

    String genPrefix(ast.PrefixExpression ex) {
        String v = self.genExpr(ex.right);
        String r = self.newTmp();
        if (ex.operator == "!") {
            self.emit("%s = xor i64 %s, 1", r, v);
            return r;
        }
        if (ex.operator == "~") {
            // LLVM has no `not`. fitResult makes the result the complement of
            // the value and not of its 8-byte unit.
            self.emit("%s = xor i64 %s, -1", r, v);
            return self.fitResult(r, self.typeOf(ex));
        }
        if (types.isFloatFamily(self.typeOf(ex.right))) {
            self.emit("%s = fneg double %s", r, v);
        } else {
            self.emit("%s = sub i64 0, %s", r, v);
        }
        return self.fitResult(r, self.typeOf(ex));
    }

    String genArrayLiteral(ast.ArrayLiteral ex) {
        types.Type at = self.typeOf(ex);
        types.Type elem = asArray(at).elem;
        String arr = self.newTmp();
        self.emit("%s = call ptr @rt_arr_new(i64 %s, i64 %s)", arr,
            string.from(ex.elements.length), arrWidth(elem));
        self.protect(arr, at);    // the elements allocate
        forEach(ex.elements, el, i) {
            String v = self.genConverted(el, elem);
            String slot = self.newTmp();
            self.emit("%s = call ptr @rt_arr_slot(ptr %s, i64 %s)", slot, arr, string.from(i));
            self.storeElem(slot, v, elem);
        }
        return arr;
    }

    // Builds a map literal with one rt_map_set per entry, in source order. A key
    // is a constant, so only the map needs a root across the entry values.
    String genMapLiteral(ast.MapLiteral ex) {
        types.MapType mt = asMap(self.typeOf(ex));
        String m = self.newTmp();
        self.emit("%s = call ptr @rt_map_new()", m);
        self.protect(m, mt);
        String td = self.tdGlobal(mt);
        forEach(ex.entries, en) {
            String key = self.genConverted(en.key, mt.key);
            String v = self.genConverted(en.value, mt.value);
            self.emit("call void @rt_map_set(ptr %s, i64 %s, i64 %s, ptr %s)",
                m, self.toRaw(key, llty(mt.key)), self.toRaw(v, llty(mt.value)), td);
        }
        return m;
    }

    // Compiles a map read `m[k]`, which gives V?. rt_map_get boxes a present
    // value and answers null for an absent key. It roots its own arguments.
    String genMapGet(ast.IndexExpression ex, types.MapType mt) {
        String m = self.protect(self.genExpr(ex.left), mt);    // the key expression may allocate
        String key = self.genConverted(ex.index, mt.key);
        String v = self.newTmp();
        self.emit("%s = call ptr @rt_map_get(ptr %s, i64 %s, ptr %s)",
            v, m, self.toRaw(key, llty(mt.key)), self.tdGlobal(mt));
        return v;
    }

    String genRecordLiteral(ast.RecordLiteral ex) {
        types.Record rec = asRecord(self.typeOf(ex));
        String r = self.newTmp();
        self.emit("%s = call ptr @rt_alloc(i64 %s)", r, string.from(recSizeOf(rec)));
        // Write the descriptor first. Nothing allocates between rt_alloc and
        // this store, and from here the collector can read the type out of the
        // block (recHeader).
        self.emit("store ptr %s, ptr %s", self.tdGlobal(rec), r);
        self.protect(r, rec);    // the field values allocate
        forEach(ex.fields, f) {
            types.FieldSlot? fs = rec.fieldType(f.name);
            if (fs == null) {
                continue;
            }
            String v = self.genConverted(f.value, fs.type);
            String slot = self.newTmp();
            self.emit("%s = getelementptr i8, ptr %s, i64 %s", slot, r, string.from(recOffset(rec, fs.index)));
            self.storeElem(slot, v, fs.type);
        }
        return r;
    }

    String genMember(ast.MemberExpression ex) {
        // An enum member is a compile-time constant. Its object names a type,
        // so nothing evaluates it.
        int? ev = self.info.enumMembers[ex.id];
        if (ev != null) {
            return string.from(ev);
        }
        // A constant of a built-in module, such as math.PI, is written in
        // place (§6.21).
        ast.Identifier? oid = ex.object as ast.Identifier;
        if (oid != null) {
            checker.ModuleRef? oref = self.info.moduleAliases[oid.name];
            if (oref != null && oref.builtin != "") {
                float? cv = builtins.constValue(oref.builtin, ex.property);
                if (cv != null) {
                    return llFloat(cv);
                }
            }
        }
        checker.ModuleExports? exp = self.moduleExports(ex.object);
        if (exp != null) {
            types.Type t = types.InvalidT;
            types.Type? vt = exp.vars[ex.property];
            if (vt != null) {
                t = vt;
            }
            String v = self.newTmp();
            self.emit("%s = load %s, ptr %s", v, llty(t), gvSym(checker.qualFor(exp, ex.property), ex.property));
            if (marked(self.info.narrowed, ex.id)) {
                return self.unwrapNarrowed(v, self.typeOf(ex));
            }
            return v;
        }
        types.Type ot = self.typeOf(ex.object);
        types.Optional? oopt = ot as types.Optional;
        if (oopt != null) {
            return self.genChainMember(ex);    // `a?.b`, or `a?.b.c` continuing a chain
        }
        String obj = self.genExpr(ex.object);
        switch (ot) {
            case types.Array arr:    // .length
                String av = self.newTmp();
                self.emit("%s = call i64 @rt_arr_len(ptr %s)", av, obj);
                return av;
            case types.MapType mp:    // .length
                String mv = self.newTmp();
                self.emit("%s = call i64 @rt_map_len(ptr %s)", mv, obj);
                return mv;
            case types.Record rec:
                types.FieldSlot? fs = rec.fieldType(ex.property);
                if (fs == null) {
                    return "0";
                }
                String slot = self.newTmp();
                self.emit("%s = getelementptr i8, ptr %s, i64 %s", slot, obj, string.from(recOffset(rec, fs.index)));
                String fv = self.loadElem(slot, fs.type);
                if (marked(self.info.narrowed, ex.id)) {
                    return self.unwrapNarrowed(fv, self.typeOf(ex));
                }
                return fv;
            default:
                return "0";
        }
    }

    // Compiles a use that the checker narrowed from T? to T. An alias or a call
    // can clear the value after the null check, so an absent value traps here
    // instead of reading a null box. The box holds the inner value at its own
    // width (§5.7).
    String unwrapNarrowed(String v, types.Type inner) {
        String nilL = self.newLabel("nn.nil");
        String okL = self.newLabel("nn.ok");
        String c = self.newTmp();
        self.emit("%s = icmp eq ptr %s, null", c, v);
        self.terminate("br i1 %s, label %%%s, label %%%s", c, nilL, okL);
        self.startBlock(nilL);
        self.emit("call void @rt_panic(ptr %s)",
            self.cstr("unexpected null (value changed after its null check)"));
        self.terminate("unreachable");
        self.startBlock(okL);
        return self.loadElem(v, inner);
    }

    // Compiles one link of an optional chain. A null object gives a null result.
    // A field value that is already optional passes through, because the
    // language has no T??.
    String genChainMember(ast.MemberExpression ex) {
        types.Optional objT = asOptional(self.typeOf(ex.object));
        String obj = self.genExpr(ex.object);
        String entry = self.block;
        String okL = self.newLabel("oc.ok");
        String endL = self.newLabel("oc.end");
        String isNull = self.newTmp();
        self.emit("%s = icmp eq ptr %s, null", isNull, obj);
        self.terminate("br i1 %s, label %%%s, label %%%s", isNull, endL, okL);

        self.startBlock(okL);
        String inner = self.newTmp();
        // The object of a chain has members, so its inner value is a pointer and
        // its box is 8 bytes wide. §5.7 narrows only the scalar cells.
        self.emit("%s = load ptr, ptr %s", inner, obj);
        String val = "";
        switch (objT.inner) {
            case types.Array arr:    // ?.length
                String araw = self.newTmp();
                self.emit("%s = call i64 @rt_arr_len(ptr %s)", araw, inner);
                val = self.box(araw, types.IntT);
            case types.MapType mp:    // ?.length
                String mraw = self.newTmp();
                self.emit("%s = call i64 @rt_map_len(ptr %s)", mraw, inner);
                val = self.box(mraw, types.IntT);
            case types.Record rec:
                types.FieldSlot? fs = rec.fieldType(ex.property);
                if (fs != null) {
                    String slot = self.newTmp();
                    self.emit("%s = getelementptr i8, ptr %s, i64 %s", slot, inner, string.from(recOffset(rec, fs.index)));
                    String fv = self.loadElem(slot, fs.type);
                    types.Optional? alreadyOpt = fs.type as types.Optional;
                    if (alreadyOpt != null) {
                        val = fv;
                    } else {
                        val = self.box(fv, fs.type);
                    }
                }
            default:
                // No other type has a member that a chain can reach.
                break;
        }
        String okEnd = self.block;
        self.terminate("br label %%%s", endL);

        self.startBlock(endL);
        String v = self.newTmp();
        self.emit("%s = phi ptr [ null, %%%s ], [ %s, %%%s ]", v, entry, val, okEnd);
        return v;
    }

    // Compiles `a?.items[i]`, which indexes the array or map result of an
    // optional chain. A null passes through.
    String genChainIndex(ast.IndexExpression ex) {
        types.Optional leftT = asOptional(self.typeOf(ex.left));
        types.MapType? mt = leftT.inner as types.MapType;
        if (mt != null) {
            return self.genChainMapIndex(ex, mt);
        }
        if (types.equal(leftT.inner, types.StringT)) {
            return self.genChainStringIndex(ex);
        }
        types.Array at = asArray(leftT.inner);
        String left = self.genExpr(ex.left);
        String entry = self.block;
        String okL = self.newLabel("oc.ok");
        String endL = self.newLabel("oc.end");
        String isNull = self.newTmp();
        self.emit("%s = icmp eq ptr %s, null", isNull, left);
        self.terminate("br i1 %s, label %%%s, label %%%s", isNull, endL, okL);

        self.startBlock(okL);
        String arr = self.newTmp();
        self.emit("%s = load ptr, ptr %s", arr, left);
        self.protect(arr, at);    // the index expression may allocate
        String idx = self.genExpr(ex.index);
        String slot = self.newTmp();
        self.emit("%s = call ptr @rt_arr_slot(ptr %s, i64 %s)", slot, arr, idx);
        String ev = self.loadElem(slot, at.elem);
        String val = ev;
        types.Optional? alreadyOpt = at.elem as types.Optional;
        if (alreadyOpt == null) {
            val = self.box(ev, at.elem);
        }
        String okEnd = self.block;
        self.terminate("br label %%%s", endL);

        self.startBlock(endL);
        String v = self.newTmp();
        self.emit("%s = phi ptr [ null, %%%s ], [ %s, %%%s ]", v, entry, val, okEnd);
        return v;
    }

    // Compiles `a?.name[i]`. A null chain passes through. The byte goes into a
    // box to give the chain its optional shape.
    String genChainStringIndex(ast.IndexExpression ex) {
        String left = self.genExpr(ex.left);
        String entry = self.block;
        String okL = self.newLabel("oc.ok");
        String endL = self.newLabel("oc.end");
        String isNull = self.newTmp();
        self.emit("%s = icmp eq ptr %s, null", isNull, left);
        self.terminate("br i1 %s, label %%%s, label %%%s", isNull, endL, okL);

        self.startBlock(okL);
        String sv = self.newTmp();
        self.emit("%s = load ptr, ptr %s", sv, left);
        self.protect(sv, types.StringT);    // the index expression may allocate
        String idx = self.genExpr(ex.index);
        String b = self.newTmp();
        self.emit("%s = call i64 @rt_str_byte(ptr %s, i64 %s)", b, sv, idx);
        String val = self.box(b, types.Uint8T);
        String okEnd = self.block;
        self.terminate("br label %%%s", endL);

        self.startBlock(endL);
        String v = self.newTmp();
        self.emit("%s = phi ptr [ null, %%%s ], [ %s, %%%s ]", v, entry, val, okEnd);
        return v;
    }

    // Compiles `a?.scores[k]`. A null chain passes through. The lookup already
    // answers null or a box, so nothing wraps the result again.
    String genChainMapIndex(ast.IndexExpression ex, types.MapType mt) {
        String left = self.genExpr(ex.left);
        String entry = self.block;
        String okL = self.newLabel("oc.ok");
        String endL = self.newLabel("oc.end");
        String isNull = self.newTmp();
        self.emit("%s = icmp eq ptr %s, null", isNull, left);
        self.terminate("br i1 %s, label %%%s, label %%%s", isNull, endL, okL);

        self.startBlock(okL);
        String m = self.newTmp();
        self.emit("%s = load ptr, ptr %s", m, left);
        self.protect(m, mt);    // the key expression may allocate
        String key = self.genConverted(ex.index, mt.key);
        String val = self.newTmp();
        self.emit("%s = call ptr @rt_map_get(ptr %s, i64 %s, ptr %s)",
            val, m, self.toRaw(key, llty(mt.key)), self.tdGlobal(mt));
        String okEnd = self.block;
        self.terminate("br label %%%s", endL);

        self.startBlock(endL);
        String v = self.newTmp();
        self.emit("%s = phi ptr [ null, %%%s ], [ %s, %%%s ]", v, entry, val, okEnd);
        return v;
    }

    // Flattens a tree of String `+` into its operands, left to right, which is
    // the order of evaluation. It appends to the array of the caller.
    void concatParts(ast.Expression ex, ast.Expression[] out) {
        ast.InfixExpression? inf = ex as ast.InfixExpression;
        if (inf != null) {
            if (inf.operator == "+" && types.equal(self.typeOf(inf), types.StringT)) {
                self.concatParts(inf.left, out);
                self.concatParts(inf.right, out);
                return;
            }
        }
        array.push(out, ex);
    }

    // Emits a chain of concatenations as one call. The slots are reserved before
    // any operand is emitted, because an operand reserves slots of its own and
    // this run must stay together: rt_str_concat_n reads the operands out of
    // consecutive frame slots (runtime.h) and pushes no root of its own.
    String genConcatChain(ast.Expression[] parts) {
        String[] slots = [];
        for (int i = 0; i < parts.length; i++) {
            array.push(slots, self.rootSlot(types.StringT));
        }
        for (int i = 0; i < parts.length; i++) {
            self.emit("store ptr %s, ptr %s", self.genExpr(parts[i]), slots[i]);
        }
        String v = self.newTmp();
        self.emit("%s = call ptr @rt_str_concat_n(ptr %s, i64 %s)", v, slots[0],
            string.from(parts.length));
        return v;
    }

    String genInfix(ast.InfixExpression ex) {
        if (ex.operator == "&&" || ex.operator == "||") {
            return self.genShortCircuit(ex);
        }
        if (ex.operator == "==" || ex.operator == "!=") {
            return self.genEquality(ex);
        }
        if (ex.operator == "<" || ex.operator == ">" || ex.operator == "<=" || ex.operator == ">=") {
            return self.genOrdered(ex);
        }
        // A chain of three or more concatenations compiles to one call.
        if (ex.operator == "+" && types.equal(self.typeOf(ex), types.StringT)) {
            ast.Expression[] parts = [];
            self.concatParts(ex, parts);
            if (parts.length > 2) {
                return self.genConcatChain(parts);
            }
        }
        // Only a string concatenation gives a pointer, and protect tests the
        // type, so the other cases cost nothing.
        String l = self.protect(self.genExpr(ex.left), self.typeOf(ex.left));
        String r = self.genExpr(ex.right);
        types.Type res = self.typeOf(ex);
        String v = self.newTmp();
        if (types.equal(res, types.StringT)) {
            self.emit("%s = call ptr @rt_str_concat(ptr %s, ptr %s)", v, l, r);
            return v;
        }
        if (types.isFloatFamily(res)) {
            self.emit("%s = %s double %s, %s", v, floatArithOp(ex.operator), l, r);
            return self.fitResult(v, res);
        }
        if (ex.operator == "/" || ex.operator == "%") {
            return self.fitResult(
                self.genIntDivide(ex.operator, l, r, ex.right, types.isUnsignedFamily(res)), res);
        }
        if (ex.operator == "<<" || ex.operator == ">>") {
            return self.genShift(ex.operator, l, r, ex.right, res);
        }
        if (ex.operator == "&" || ex.operator == "|" || ex.operator == "^") {
            // No fitResult. `and`, `or` and `xor` cannot move a value outside
            // the range of their operands.
            self.emit("%s = %s i64 %s, %s", v, bitArithOp(ex.operator), l, r);
            return v;
        }
        self.emit("%s = %s i64 %s, %s", v, intArithOp(ex.operator), l, r);
        return self.fitResult(v, res);
    }

    // Emits `<<` or `>>`. LLVM shl/lshr/ashr are poison for a count at or above
    // the bit width of the operand, but §3.1 defines every count. A shift that
    // moves every bit out answers 0, or -1 for `>>` on a negative signed value.
    // A negative count panics. The width is that of the result type and not
    // the 64 bits of the unit, so `x << 32` on a 32-bit `int` answers 0.
    String genShift(String op, String l, String r, ast.Expression rhs, types.Type res) {
        int width = types.bits(res);
        if (width == 0 || width > 64) {
            width = 64;
        }
        String shiftOp = "shl";
        if (op == ">>") {
            if (types.isUnsignedFamily(res)) {
                shiftOp = "lshr";
            } else {
                shiftOp = "ashr";
            }
        }
        String v = self.newTmp();
        ast.IntLiteral? lit = rhs as ast.IntLiteral;
        if (lit != null && lit.value >= 0 && lit.value < width) {
            self.emit("%s = %s i64 %s, %s", v, shiftOp, l, string.from(lit.value));
            return self.fitResult(v, res);
        }

        String negL = self.newLabel("shift.negative");
        String okL = self.newLabel("shift.ok");
        String neg = self.newTmp();
        self.emit("%s = icmp slt i64 %s, 0", neg, r);
        self.terminate("br i1 %s, label %%%s, label %%%s", neg, negL, okL);
        self.startBlock(negL);
        self.emit("call void @rt_panic(ptr %s)", self.cstr("negative shift count"));
        self.terminate("unreachable");
        self.startBlock(okL);

        // The clamp keeps the shift defined for every input, and the select
        // gives the answer §3.1 defines.
        String inRange = self.newTmp();
        String safe = self.newTmp();
        String shifted = self.newTmp();
        self.emit("%s = icmp ult i64 %s, %s", inRange, r, string.from(width));
        self.emit("%s = select i1 %s, i64 %s, i64 0", safe, inRange, r);
        self.emit("%s = %s i64 %s, %s", shifted, shiftOp, l, safe);
        // Every bit moved out, so the result is 0. An arithmetic shift right
        // keeps the sign, which is -1 for a negative value.
        String out = "0";
        if (shiftOp == "ashr") {
            String sign = self.newTmp();
            self.emit("%s = ashr i64 %s, 63", sign, l);
            out = sign;
        }
        self.emit("%s = select i1 %s, i64 %s, i64 %s", v, inRange, shifted, out);
        return self.fitResult(v, res);
    }

    // Cuts an arithmetic result back to the width of its type. Arithmetic runs
    // in the full 8-byte unit, so this does nothing where the type is as wide as
    // the unit. An unsigned type extends back with zeros: a `uint8` is an i64
    // holding 0 to 255, so every reader of the unit needs no mask.
    String fitResult(String v, types.Type t) {
        int bits = types.bits(t);
        if (bits == 0 || bits >= 64) {
            return v;
        }
        String narrow = self.newTmp();
        String wide = self.newTmp();
        if (types.isFloatFamily(t)) {
            self.emit("%s = fptrunc double %s to float", narrow, v);
            self.emit("%s = fpext float %s to double", wide, narrow);
        } else {
            String ext = "sext";
            if (types.isUnsignedFamily(t)) {
                ext = "zext";
            }
            self.emit("%s = trunc i64 %s to i%s", narrow, v, string.from(bits));
            self.emit("%s = %s i%s %s to i64", wide, ext, string.from(bits), narrow);
        }
        return wide;
    }

    // loadElem and storeElem are the only places in codegen that know an element
    // is not eight bytes (§5.7). The value crossing the boundary is always the
    // 8-byte unit, and the widening is fitResult's rule in reverse, so a value
    // stored and then loaded is the value that was stored. The store of a
    // float32 is the rounding onto the binary32 grid.
    String loadElem(String slot, types.Type elem) {
        String st = llStore(elem);
        String v = self.newTmp();
        if (st == llty(elem)) {
            self.emit("%s = load %s, ptr %s", v, st, slot);
            return v;
        }
        self.emit("%s = load %s, ptr %s", v, st, slot);
        String wide = self.newTmp();
        if (st == "float") {
            self.emit("%s = fpext float %s to double", wide, v);
            return wide;
        }
        String ext = "sext";
        if (types.isUnsignedFamily(elem) || isBool(elem)) {
            ext = "zext";
        }
        self.emit("%s = %s %s %s to i64", wide, ext, st, v);
        return wide;
    }

    void storeElem(String slot, String v, types.Type elem) {
        String st = llStore(elem);
        if (st == llty(elem)) {
            self.emit("store %s %s, ptr %s", st, v, slot);
            return;
        }
        String narrow = self.newTmp();
        if (st == "float") {
            self.emit("%s = fptrunc double %s to float", narrow, v);
        } else {
            self.emit("%s = trunc %s %s to %s", narrow, llty(elem), v, st);
        }
        self.emit("store %s %s, ptr %s", st, narrow, slot);
    }

    // Emits `/` or `%` on integers. sdiv and srem are undefined for a zero
    // divisor and for INT64_MIN / -1. The language defines both: the first
    // panics, the second wraps. The guards are inline, so the division stays a
    // plain instruction and a loop-invariant divisor makes them hoistable. An
    // unsigned division needs the zero guard alone, and a positive literal
    // divisor needs none.
    String genIntDivide(String op, String l, String r, ast.Expression rhs, bool unsigned) {
        String divOp = intDivOp(op);
        if (unsigned) {
            divOp = uintDivOp(op);
        }
        String v = self.newTmp();
        ast.IntLiteral? lit = rhs as ast.IntLiteral;
        if (lit != null && lit.value > 0) {
            self.emit("%s = %s i64 %s, %s", v, divOp, l, string.from(lit.value));
            return v;
        }

        String word = "division";
        if (op == "%") {
            word = "modulo";
        }
        String zero = self.newTmp();
        String panicL = self.newLabel(word + ".zero");
        String okL = self.newLabel(word + ".ok");
        self.emit("%s = icmp eq i64 %s, 0", zero, r);
        self.terminate("br i1 %s, label %%%s, label %%%s", zero, panicL, okL);
        self.startBlock(panicL);
        self.emit("call void @rt_panic(ptr %s)", self.cstr(word + " by zero"));
        self.terminate("unreachable");
        self.startBlock(okL);

        if (unsigned) {
            self.emit("%s = %s i64 %s, %s", v, divOp, l, r);
            return v;
        }

        // Dividing by 1 in place of -1 keeps the instruction defined. sdiv gives
        // x, which the select negates, and srem gives 0, the answer for x % -1.
        String neg = self.newTmp();
        String safe = self.newTmp();
        self.emit("%s = icmp eq i64 %s, -1", neg, r);
        self.emit("%s = select i1 %s, i64 1, i64 %s", safe, neg, r);
        if (op == "%") {
            self.emit("%s = srem i64 %s, %s", v, l, safe);
            return v;
        }
        String quot = self.newTmp();
        String negated = self.newTmp();
        self.emit("%s = sdiv i64 %s, %s", quot, l, safe);
        self.emit("%s = sub i64 0, %s", negated, l);
        self.emit("%s = select i1 %s, i64 %s, i64 %s", v, neg, negated, quot);
        return v;
    }

    String genShortCircuit(ast.InfixExpression ex) {
        String l = self.genExpr(ex.left);
        String lc = self.newTmp();
        self.emit("%s = icmp ne i64 %s, 0", lc, l);
        String entry = self.block;
        String rhsL = self.newLabel("sc.rhs");
        String endL = self.newLabel("sc.end");
        String shortVal = "0";
        if (ex.operator == "||") {
            shortVal = "1";
            self.terminate("br i1 %s, label %%%s, label %%%s", lc, endL, rhsL);
        } else {
            self.terminate("br i1 %s, label %%%s, label %%%s", lc, rhsL, endL);
        }
        self.startBlock(rhsL);
        String r = self.genExpr(ex.right);
        String rhsEnd = self.block;
        self.terminate("br label %%%s", endL);
        self.startBlock(endL);
        String v = self.newTmp();
        self.emit("%s = phi i64 [ %s, %%%s ], [ %s, %%%s ]", v, shortVal, entry, r, rhsEnd);
        return v;
    }

    String genEquality(ast.InfixExpression ex) {
        bool isEq = ex.operator == "==";
        types.Type lt = self.typeOf(ex.left);
        types.Type rt = self.typeOf(ex.right);
        bool lNull = types.equal(lt, types.NullT);
        bool rNull = types.equal(rt, types.NullT);

        if (lNull && rNull) {
            if (isEq) {
                return "1";
            }
            return "0";
        }

        String l = self.protect(self.genExpr(ex.left), lt);
        String r = self.genExpr(ex.right);
        return self.genEqValues(l, lt, r, rt, isEq);
    }

    // Compares two evaluated values and answers an i64 of 0 or 1. isEq chooses
    // `==` over `!=`. Both genEquality and genSwitch call it, which keeps
    // `case v:` matching what `subject == v` matches. The caller owns the
    // rooting: lv must already be protected, because a box here can allocate.
    String genEqValues(String lv, types.Type lt, String rv, types.Type rt, bool isEq) {
        String l = lv;
        String r = rv;
        bool lNull = types.equal(lt, types.NullT);
        bool rNull = types.equal(rt, types.NullT);

        // An optional against the null literal is a null test on the pointer.
        if (lNull || rNull) {
            String v = r;
            if (rNull) {
                v = l;
            }
            String cmp = "eq";
            if (!isEq) {
                cmp = "ne";
            }
            String c = self.newTmp();
            self.emit("%s = icmp %s ptr %s, null", c, cmp, v);
            return self.zextBool(c);
        }

        types.Optional? lo = lt as types.Optional;
        types.Optional? ro = rt as types.Optional;
        if (lo != null || ro != null) {
            String td = self.tdGlobal(lt);
            if (lo == null) {
                td = self.tdGlobal(rt);
                l = self.box(l, lt);
            }
            if (ro == null) {
                r = self.box(r, rt);
            }
            String lraw = self.toRaw(l, "ptr");
            String rraw = self.toRaw(r, "ptr");
            String v = self.newTmp();
            self.emit("%s = call i64 @rt_eq(i64 %s, i64 %s, ptr %s)", v, lraw, rraw, td);
            if (!isEq) {
                String x = self.newTmp();
                self.emit("%s = xor i64 %s, 1", x, v);
                return x;
            }
            return v;
        }

        if (types.isFloatFamily(lt)) {
            String op = "oeq";
            if (!isEq) {
                op = "one";
            }
            String c = self.newTmp();
            self.emit("%s = fcmp %s double %s, %s", c, op, l, r);
            return self.zextBool(c);
        }
        if (types.equal(lt, types.StringT)) {
            String v = self.newTmp();
            self.emit("%s = call i64 @rt_str_eq(ptr %s, ptr %s)", v, l, r);
            if (!isEq) {
                String x = self.newTmp();
                self.emit("%s = xor i64 %s, 1", x, v);
                return x;
            }
            return v;
        }
        // int family, bool, DateTime, Duration
        String op = "eq";
        if (!isEq) {
            op = "ne";
        }
        String c = self.newTmp();
        self.emit("%s = icmp %s i64 %s, %s", c, op, l, r);
        return self.zextBool(c);
    }

    String genOrdered(ast.InfixExpression ex) {
        types.Type lt = self.typeOf(ex.left);
        types.Type rt = self.typeOf(ex.right);
        String l = self.protect(self.genExpr(ex.left), lt);
        String r = self.genExpr(ex.right);
        String c = self.newTmp();
        if (types.isFloatFamily(lt)) {
            self.emit("%s = fcmp %s double %s, %s", c, floatCmpOp(ex.operator), l, r);
        } else if (types.equal(lt, types.StringT)) {
            String cmp = self.newTmp();
            self.emit("%s = call i64 @rt_str_cmp(ptr %s, ptr %s)", cmp, l, r);
            self.emit("%s = icmp %s i64 %s, 0", c, intCmpOp(ex.operator), cmp);
        } else {
            // The integer family, DateTime and Duration. The common type of the
            // pair decides the comparison, not the type of the left operand.
            // Only a pair whose common type is unsigned compares unsigned.
            String cmpOp = intCmpOp(ex.operator);
            types.Type? pair = types.widenPair(lt, rt);
            if (pair != null && types.isUnsignedFamily(pair)) {
                cmpOp = uintCmpOp(ex.operator);
            }
            self.emit("%s = icmp %s i64 %s, %s", c, cmpOp, l, r);
        }
        return self.zextBool(c);
    }

    String zextBool(String i1) {
        String v = self.newTmp();
        self.emit("%s = zext i1 %s to i64", v, i1);
        return v;
    }

    // ---- calls ----

    String genCall(ast.CallExpression ex) {
        ast.Identifier? id = ex.callee as ast.Identifier;
        if (id != null) {
            // Every argument runs before anything is written, so an argument
            // that raises (§2.9) leaves no part of a line behind. The earlier
            // values are therefore held across the later expressions.
            if (id.name == "print" || id.name == "printInline") {
                String[] raws = [];
                forEach(ex.args, arg, i) {
                    types.Type at = self.typeOf(arg);
                    String v = self.genExpr(arg);
                    if (i < ex.args.length - 1) {
                        self.protect(v, at);    // held while the later arguments run
                    }
                    array.push(raws, self.toRaw(v, llty(at)));
                }
                forEach(ex.args, arg, i) {
                    if (i > 0) {
                        self.emit("call void @rt_print_space()");
                    }
                    self.emit("call void @rt_print(i64 %s, ptr %s)", raws[i], self.tdGlobal(self.typeOf(arg)));
                }
                if (id.name == "print") {
                    self.emit("call void @rt_print_newline()");
                }
                return "";
            }
            // getType is answered at compile time as a string constant. The
            // argument still runs, so its effects still happen.
            if (id.name == "getType") {
                types.Type at = self.typeOf(ex.args[0]);
                self.genExpr(ex.args[0]);
                return self.strGlobal(types.typeString(at));
            }
            if (id.name == "Error") {
                return self.genErrorNew(ex);
            }
            // A variable in scope takes priority over a declared function of the
            // same name, as it does in the checker.
            if (self.syms.lookup(id.name) != null) {
                return self.genIndirectCall(ex, self.genExpr(id));
            }
            types.FuncType? sig = self.info.funcs[id.name];
            if (sig == null) {
                unreachable("a call of a function the checker did not record: " + id.name);
                return "0";
            }
            if (sig.extern) {
                // A direct call of the bare C symbol. The checker holds the
                // signature to types that cross unchanged.
                return self.genDirectCall(ex, sig, "@" + id.name);
            }
            if (sig.async) {
                return self.genAsyncCall(ex, sig, fnSym(self.qual, id.name));
            }
            return self.genDirectCall(ex, sig, fnSym(self.qual, id.name));
        }
        ast.MemberExpression? mem = ex.callee as ast.MemberExpression;
        if (mem != null) {
            return self.genMemberCall(ex, mem);
        }
        // Every other callee gives a function value.
        return self.genIndirectCall(ex, self.genExpr(ex.callee));
    }

    // Calls a function value. It traps on null, loads the code pointer from slot
    // [0] of the closure, and passes the closure as the hidden first argument.
    String genIndirectCall(ast.CallExpression ex, String clos) {
        types.FuncType? sigOpt = self.typeOf(ex.callee) as types.FuncType;
        if (sigOpt == null) {
            unreachable("an indirect call of something that is not a function value");
            return "0";
        }
        types.FuncType sig = sigOpt;
        String isNull = self.newTmp();
        String nullL = self.newLabel("fn.null");
        String okL = self.newLabel("fn.ok");
        self.emit("%s = icmp eq ptr %s, null", isNull, clos);
        self.terminate("br i1 %s, label %%%s, label %%%s", isNull, nullL, okL);
        self.startBlock(nullL);
        self.emit("call void @rt_panic(ptr %s)", self.cstr("called a function value that was never assigned"));
        self.terminate("unreachable");
        self.startBlock(okL);

        self.protect(clos, sig);    // held across the argument expressions
        String[] args = [];
        array.push(args, "ptr " + clos);
        forEach(self.callArgs(ex.args, sig), a) {
            array.push(args, a);
        }
        String code = self.newTmp();
        self.emit("%s = load ptr, ptr %s", code, clos);
        if (types.equal(sig.return, types.VoidT) && !sig.fallible) {
            self.emit("call void %s(%s)", code, string.join(args, ", "));
            return "";
        }
        String v = self.newTmp();
        self.emit("%s = call %s %s(%s)", v, retLL(sig), code, string.join(args, ", "));
        if (sig.fallible) {
            return self.splitResult(v, sig.return);
        }
        return v;
    }

    // Evaluates call arguments left to right and answers them as LLVM
    // `<type> <value>` operands. An argument that has already run stays rooted
    // while the others run. The last one needs no root, because the callee
    // stores its parameters into its own frame before it allocates. A variadic
    // signature ends with an array parameter that collects the extra arguments,
    // so every stage below sees a plain array parameter.
    String[] callArgs(ast.Expression[] exprs, types.FuncType sig) {
        int fixed = sig.params.length;
        if (sig.variadic) {
            fixed--;
        }
        String[] args = [];
        for (int i = 0; i < fixed; i++) {
            String v = self.genConverted(exprs[i], sig.params[i]);
            // The variadic array is built after the fixed arguments and
            // allocates, so with one present the last fixed argument needs a
            // root too.
            if (i < exprs.length - 1 || sig.variadic) {
                self.protect(v, sig.params[i]);
            }
            array.push(args, llty(sig.params[i]) + " " + v);
        }
        if (!sig.variadic) {
            return args;
        }
        types.Array at = asArray(sig.params[fixed]);
        String arr = self.newTmp();
        self.emit("%s = call ptr @rt_arr_new(i64 %s, i64 %s)", arr,
            string.from(exprs.length - fixed), arrWidth(at.elem));
        self.protect(arr, at);    // the collected arguments allocate
        for (int i = fixed; i < exprs.length; i++) {
            String v = self.genConverted(exprs[i], at.elem);
            String slot = self.newTmp();
            self.emit("%s = call ptr @rt_arr_slot(ptr %s, i64 %s)", slot, arr, string.from(i - fixed));
            self.storeElem(slot, v, at.elem);
        }
        array.push(args, "ptr " + arr);
        return args;
    }

    // Emits a call of a function symbol that is known at compile time.
    String genDirectCall(ast.CallExpression ex, types.FuncType sig, String symbol) {
        String[] none = [];
        return self.genDirectCallWith(ex, sig, symbol, none);
    }

    // genDirectCall with arguments the call site supplies before the written
    // ones. The receiver of a method is the only such argument.
    String genDirectCallWith(ast.CallExpression ex, types.FuncType sig, String symbol, String[] lead) {
        String[] args = [];
        forEach(lead, a) {
            array.push(args, a);
        }
        forEach(self.callArgs(ex.args, sig), a) {
            array.push(args, a);
        }
        if (types.equal(sig.return, types.VoidT) && !sig.fallible) {
            self.emit("call void %s(%s)", symbol, string.join(args, ", "));
            return "";
        }
        String v = self.newTmp();
        self.emit("%s = call %s %s(%s)", v, retLL(sig), symbol, string.join(args, ", "));
        if (sig.fallible) {
            return self.splitResult(v, sig.return);
        }
        return v;
    }

    // Emits `value.method(args)` for a method, `alias.fn(args)` for a module
    // call, and an indirect call for any other member holding a function value.
    String genMemberCall(ast.CallExpression ex, ast.MemberExpression callee) {
        checker.MethodRef? m = self.info.methodCalls[ex.id];
        if (m != null) {
            return self.genMethodCall(ex, callee, m);
        }
        // In `time.date.day(t)` the object of the callee names a namespace and
        // not a value, so nothing evaluates it.
        checker.NsRef? ns = self.info.builtinNamespace(callee.object);
        if (ns != null) {
            if (ns.module == "time") {
                return self.genTimeDateCall(ex, callee.property);
            }
            if (ns.module == "process") {
                return self.genProcessNsCall(ex, ns.ns, callee.property);
            }
            if (ns.module == "net") {
                return self.genNetOpenCall(ex, ns.ns, callee.property);
            }
        }
        ast.Identifier? id = callee.object as ast.Identifier;
        if (id != null) {
            checker.ModuleRef? ref = self.info.moduleAliases[id.name];
            if (ref != null) {
                String b = ref.builtin;
                if (b == "json") {
                    return self.genJSONCall(ex, callee.property);
                }
                if (b == "time") {
                    return self.genTimeCall(ex, callee.property);
                }
                if (b == "array") {
                    return self.genArrayCall(ex, callee.property);
                }
                if (b == "string") {
                    return self.genStringCall(ex, callee.property);
                }
                if (b == "map") {
                    return self.genMapCall(ex, callee.property);
                }
                if (b == "math") {
                    return self.genMathCall(ex, callee.property);
                }
                if (b == "random") {
                    return self.genRandomCall(ex, callee.property);
                }
                if (b == "os") {
                    return self.genOSCall(ex, callee.property);
                }
                if (b == "path") {
                    return self.genPathCall(ex, callee.property);
                }
                if (b == "fs") {
                    return self.genFSCall(ex, callee.property);
                }
                if (b == "process") {
                    return self.genProcessCall(ex, callee.property);
                }
                if (b == "regexp") {
                    return self.genRegexpCall(ex, callee.property);
                }
                if (b == "crypto") {
                    return self.genCryptoCall(ex, callee.property);
                }
                if (b == "net") {
                    return self.genNetCall(ex, callee.property);
                }
                if (b == "async") {
                    if (callee.property == "race") {
                        return self.genAsyncRace(ex);
                    }
                    // A callback literal allocates its closure block, so the
                    // future stays rooted while it runs.
                    String fu = self.protect(self.genExpr(ex.args[0]), self.typeOf(ex.args[0]));
                    String cb = self.genExpr(ex.args[1]);
                    self.emit("call void @rt_async_run(ptr %s, ptr %s)", fu, cb);
                    return "";
                }
                checker.ModuleExports? exp = ref.exports;
                if (exp != null) {
                    types.FuncType? sig = exp.funcs[callee.property];
                    if (sig != null) {
                        if (sig.async) {
                            return self.genAsyncCall(ex, sig, fnSym(checker.qualFor(exp, callee.property), callee.property));
                        }
                        return self.genDirectCall(ex, sig, fnSym(checker.qualFor(exp, callee.property), callee.property));
                    }
                }
            }
        }
        // A record field, or an exported variable, holding a function value.
        return self.genIndirectCall(ex, self.genExpr(callee));
    }

    // Emits a call of an async function as a direct call of its spawn wrapper.
    // The wrapper puts the arguments into a new state-machine frame and answers
    // an incomplete future. The body runs when the scheduler steps the task.
    String genAsyncCall(ast.CallExpression ex, types.FuncType sig, String symbol) {
        String[] none = [];
        return self.genAsyncCallWith(ex, sig, symbol, none);
    }

    String genAsyncCallWith(ast.CallExpression ex, types.FuncType sig, String symbol, String[] lead) {
        types.FuncType spawnSig = {
            params: sig.params, return: types.newFutureType(sig.return, false),
            async: false, fallible: false, variadic: sig.variadic, noalloc: false, extern: false,
        };
        return self.genDirectCallWith(ex, spawnSig, symbol + ".spawn", lead);
    }

    // Emits `value.method(args)` as a direct call with the receiver before the
    // written arguments. The static type of the receiver picks the body, and the
    // value itself holds nothing about its methods.
    String genMethodCall(ast.CallExpression ex, ast.MemberExpression callee, checker.MethodRef m) {
        String recv = self.protect(self.genExpr(callee.object), m.owner);
        String[] lead = [];
        array.push(lead, "ptr " + recv);
        if (m.sig.async) {
            return self.genAsyncCallWith(ex, m.sig, methodSym(m.owner, m.name), lead);
        }
        return self.genDirectCallWith(ex, m.sig, methodSym(m.owner, m.name), lead);
    }

    // ---- built-in modules ----

    // Emits the functions of the built-in array module. They are generic over
    // the element type, so each call passes the TypeDesc of the array.
    String genArrayCall(ast.CallExpression ex, String fn) {
        types.Array at = asArray(self.typeOf(ex.args[0]));
        switch (fn) {
            case "push":
                // The value can allocate, so the array stays rooted.
                // rt_arr_push roots both across its own growth.
                String parr = self.protect(self.genExpr(ex.args[0]), at);
                String pv = self.genConverted(ex.args[1], at.elem);
                String praw = self.toRaw(pv, llty(at.elem));
                self.emit("call void @rt_arr_push(ptr %s, i64 %s, ptr %s)", parr, praw, self.tdGlobal(at));
                return "";
            case "pop":
                String oarr = self.genExpr(ex.args[0]);
                String oraw = self.newTmp();
                self.emit("%s = call i64 @rt_arr_pop(ptr %s, ptr %s)", oraw, oarr, self.tdGlobal(at));
                return self.fromRaw(oraw, llty(at.elem));
            case "indexOf":
                // The array stays rooted while the value runs. The search
                // allocates nothing.
                String iarr = self.protect(self.genExpr(ex.args[0]), at);
                String iv = self.genConverted(ex.args[1], at.elem);
                String iraw = self.toRaw(iv, llty(at.elem));
                String idx = self.newTmp();
                self.emit("%s = call i64 @rt_arr_index_of(ptr %s, i64 %s, ptr %s)", idx, iarr, iraw, self.tdGlobal(at));
                return idx;
            case "sort":
                if (ex.args.length == 1) {
                    String sarr = self.genExpr(ex.args[0]);
                    self.emit("call void @rt_arr_sort(ptr %s, ptr %s)", sarr, self.tdGlobal(at));
                    return "";
                }
                // A comparator literal allocates its closure block, so the array
                // stays rooted across it.
                String barr = self.protect(self.genExpr(ex.args[0]), at);
                String cmp = self.genExpr(ex.args[1]);
                self.emit("call void @rt_arr_sort_by(ptr %s, ptr %s, ptr %s)", barr, cmp, self.tdGlobal(at));
                return "";
            case "contains":
                String karr = self.protect(self.genExpr(ex.args[0]), at);
                String kv = self.genConverted(ex.args[1], at.elem);
                String kraw = self.toRaw(kv, llty(at.elem));
                String kidx = self.newTmp();
                self.emit("%s = call i64 @rt_arr_index_of(ptr %s, i64 %s, ptr %s)", kidx, karr, kraw, self.tdGlobal(at));
                String has = self.newTmp();
                self.emit("%s = icmp sge i64 %s, 0", has, kidx);
                return self.zextBool(has);
            case "reverse":
                String rarr = self.genExpr(ex.args[0]);
                self.emit("call void @rt_arr_reverse(ptr %s)", rarr);
                return "";
            case "fill":
                // The value can allocate, so the array stays rooted. The fill
                // itself allocates nothing.
                String farr = self.protect(self.genExpr(ex.args[0]), at);
                String fv = self.genConverted(ex.args[1], at.elem);
                self.emit("call void @rt_arr_fill(ptr %s, i64 %s, ptr %s)", farr, self.toRaw(fv, llty(at.elem)), self.tdGlobal(at));
                return "";
            case "concat":
                // The second array can allocate while it is built, so the
                // first stays rooted. rt_arr_concat roots both across its own
                // allocation.
                String ca = self.protect(self.genExpr(ex.args[0]), at);
                String cb = self.genExpr(ex.args[1]);
                String cr = self.newTmp();
                self.emit("%s = call ptr @rt_arr_concat(ptr %s, ptr %s, ptr %s)", cr, ca, cb, self.tdGlobal(at));
                return cr;
            case "flatten":
                String fla = self.genExpr(ex.args[0]);
                String flr = self.newTmp();
                self.emit("%s = call ptr @rt_arr_flatten(ptr %s, ptr %s)", flr, fla, self.tdGlobal(at));
                return flr;
            case "map":
            case "filter":
            case "reduce":
            case "find":
            case "some":
            case "every":
                return self.genArrayLoop(ex, fn, at);
            case "slice":
                // Both indices are scalars, so nothing can free the array
                // before rt_arr_slice, which roots it itself.
                String larr = self.genExpr(ex.args[0]);
                String start = self.genConverted(ex.args[1], types.IntT);
                String end = "";
                if (ex.args.length > 2) {
                    end = self.genConverted(ex.args[2], types.IntT);
                } else {
                    // The two-argument form ends at the length of the array.
                    end = self.newTmp();
                    self.emit("%s = call i64 @rt_arr_len(ptr %s)", end, larr);
                }
                String sv = self.newTmp();
                self.emit("%s = call ptr @rt_arr_slice(ptr %s, i64 %s, i64 %s, ptr %s)",
                    sv, larr, start, end, self.tdGlobal(at));
                return sv;
            default:    // copy
                String carr = self.genExpr(ex.args[0]);
                String cv = self.newTmp();
                self.emit("%s = call ptr @rt_arr_copy(ptr %s, ptr %s)", cv, carr, self.tdGlobal(at));
                return cv;
        }
    }

    // Emits the array functions that call a function value once per element
    // (§6.5): map, filter, reduce, find, some and every. The loop is emitted
    // here rather than written in C, so a call of the function value is the
    // ordinary indirect call and every value the loop holds is an ordinary
    // root: the array, the function value, the result and reduce's
    // accumulator each sit in a slot for as long as a callback can allocate.
    // An element is read again after the callback when it is about to be
    // kept, since the callback may have replaced it.
    String genArrayLoop(ast.CallExpression ex, String fn, types.Array at) {
        types.Type res = self.typeOf(ex);
        String arr = self.protect(self.genExpr(ex.args[0]), at);
        int fnIndex = 1;
        String accSlot = "";
        if (fn == "reduce") {
            fnIndex = 2;
            String init = self.genConverted(ex.args[1], res);
            accSlot = self.alloca(res);
            self.emit("store %s %s, ptr %s", llty(res), init, accSlot);
        }
        ast.Expression fnArg = ex.args[fnIndex];
        types.FuncType? sigOpt = self.typeOf(fnArg) as types.FuncType;
        if (sigOpt == null) {
            unreachable("an array callback that is not a function value");
            return "0";
        }
        types.FuncType sig = sigOpt;
        String clos = self.protect(self.genExpr(fnArg), sig);
        self.guardFnValue(clos);

        String n = self.newTmp();
        self.emit("%s = call i64 @rt_arr_len(ptr %s)", n, arr);
        String out = "";
        if (fn == "map") {
            out = self.newTmp();
            self.emit("%s = call ptr @rt_arr_new(i64 %s, i64 %s)", out, n, string.from(widthOf(asArray(res).elem)));
            self.protect(out, res);
        } else if (fn == "filter") {
            out = self.newTmp();
            self.emit("%s = call ptr @rt_arr_new(i64 0, i64 %s)", out, string.from(widthOf(at.elem)));
            self.protect(out, res);
        }
        // find holds its optional, some and every their answer so far.
        String resSlot = "";
        if (fn == "find") {
            resSlot = self.alloca(res);
            self.emit("store ptr null, ptr %s", resSlot);
        } else if (fn == "some" || fn == "every") {
            resSlot = self.alloca(types.IntT);
            String start = "0";
            if (fn == "every") {
                start = "1";
            }
            self.emit("store i64 %s, ptr %s", start, resSlot);
        }
        String iSlot = self.alloca(types.IntT);
        self.emit("store i64 0, ptr %s", iSlot);

        String condL = self.newLabel("ar.cond");
        String bodyL = self.newLabel("ar.body");
        String nextL = self.newLabel("ar.next");
        String endL = self.newLabel("ar.end");
        self.terminate("br label %%%s", condL);

        self.startBlock(condL);
        String i = self.newTmp();
        self.emit("%s = load i64, ptr %s", i, iSlot);
        String c = self.newTmp();
        self.emit("%s = icmp slt i64 %s, %s", c, i, n);
        self.terminate("br i1 %s, label %%%s, label %%%s", c, bodyL, endL);

        self.startBlock(bodyL);
        String slot = self.newTmp();
        self.emit("%s = call ptr @rt_arr_slot(ptr %s, i64 %s)", slot, arr, i);
        String v = self.loadElem(slot, at.elem);
        String elemOp = llty(at.elem) + " " + v;
        if (fn == "map") {
            String r = self.callValue(clos, sig, [elemOp]);
            String oslot = self.newTmp();
            self.emit("%s = call ptr @rt_arr_slot(ptr %s, i64 %s)", oslot, out, i);
            self.storeElem(oslot, r, asArray(res).elem);
            self.terminate("br label %%%s", nextL);
        } else if (fn == "reduce") {
            String acc = self.newTmp();
            self.emit("%s = load %s, ptr %s", acc, llty(res), accSlot);
            String r2 = self.callValue(clos, sig, [llty(res) + " " + acc, elemOp]);
            self.emit("store %s %s, ptr %s", llty(res), r2, accSlot);
            self.terminate("br label %%%s", nextL);
        } else {
            String answer = self.callValue(clos, sig, [elemOp]);
            String hitL = self.newLabel("ar.hit");
            String test = self.newTmp();
            if (fn == "every") {
                self.emit("%s = icmp eq i64 %s, 0", test, answer);
            } else {
                self.emit("%s = icmp ne i64 %s, 0", test, answer);
            }
            self.terminate("br i1 %s, label %%%s, label %%%s", test, hitL, nextL);
            self.startBlock(hitL);
            if (fn == "filter" || fn == "find") {
                String again = self.newTmp();
                self.emit("%s = call ptr @rt_arr_slot(ptr %s, i64 %s)", again, arr, i);
                String kept = self.loadElem(again, at.elem);
                if (fn == "filter") {
                    self.emit("call void @rt_arr_push(ptr %s, i64 %s, ptr %s)", out, self.toRaw(kept, llty(at.elem)), self.tdGlobal(res));
                    self.terminate("br label %%%s", nextL);
                } else {
                    String b = self.box(kept, at.elem);
                    self.emit("store ptr %s, ptr %s", b, resSlot);
                    self.terminate("br label %%%s", endL);
                }
            } else {
                String found = "1";
                if (fn == "every") {
                    found = "0";
                }
                self.emit("store i64 %s, ptr %s", found, resSlot);
                self.terminate("br label %%%s", endL);
            }
        }

        self.startBlock(nextL);
        String i2 = self.newTmp();
        self.emit("%s = add i64 %s, 1", i2, i);
        self.emit("store i64 %s, ptr %s", i2, iSlot);
        self.terminate("br label %%%s", condL);

        self.startBlock(endL);
        if (fn == "map" || fn == "filter") {
            return out;
        }
        if (fn == "reduce") {
            String fin = self.newTmp();
            self.emit("%s = load %s, ptr %s", fin, llty(res), accSlot);
            return fin;
        }
        String got = self.newTmp();
        self.emit("%s = load %s, ptr %s", got, llty(res), resSlot);
        return got;
    }

    // Traps on a function value that was never assigned, once, before a loop
    // calls it. genIndirectCall makes the same test for a single call.
    void guardFnValue(String clos) {
        String isNull = self.newTmp();
        String nullL = self.newLabel("fn.null");
        String okL = self.newLabel("fn.ok");
        self.emit("%s = icmp eq ptr %s, null", isNull, clos);
        self.terminate("br i1 %s, label %%%s, label %%%s", isNull, nullL, okL);
        self.startBlock(nullL);
        self.emit("call void @rt_panic(ptr %s)", self.cstr("called a function value that was never assigned"));
        self.terminate("unreachable");
        self.startBlock(okL);
    }

    // Calls a function value that guardFnValue has already tested, with
    // evaluated operands written as `<type> <value>`. The value is not
    // fallible: the checker refuses one where this is used.
    String callValue(String clos, types.FuncType sig, String[] operands) {
        String code = self.newTmp();
        self.emit("%s = load ptr, ptr %s", code, clos);
        String[] args = ["ptr " + clos];
        forEach(operands, op) {
            array.push(args, op);
        }
        if (types.equal(sig.return, types.VoidT)) {
            self.emit("call void %s(%s)", code, string.join(args, ", "));
            return "";
        }
        String v = self.newTmp();
        self.emit("%s = call %s %s(%s)", v, llty(sig.return), code, string.join(args, ", "));
        return v;
    }

    // Emits the functions of the built-in map module. Each call passes the
    // TypeDesc of the map, so the runtime can trace its arguments.
    String genMapCall(ast.CallExpression ex, String fn) {
        types.MapType mt = asMap(self.typeOf(ex.args[0]));
        String td = self.tdGlobal(mt);
        String v = self.newTmp();
        if (fn == "has" || fn == "remove") {
            // The key expression can allocate, so the map stays rooted.
            String m = self.protect(self.genExpr(ex.args[0]), mt);
            String key = self.genConverted(ex.args[1], mt.key);
            String sym = "rt_map_has";
            if (fn == "remove") {
                sym = "rt_map_remove";
            }
            self.emit("%s = call i64 @%s(ptr %s, i64 %s, ptr %s)", v, sym, m, self.toRaw(key, llty(mt.key)), td);
            return v;
        }
        // keys, values, copy
        String m = self.genExpr(ex.args[0]);
        String sym = "rt_map_copy";
        if (fn == "keys") {
            sym = "rt_map_keys";
        } else if (fn == "values") {
            sym = "rt_map_values";
        }
        self.emit("%s = call ptr @%s(ptr %s, ptr %s)", v, sym, m, td);
        return v;
    }

    // Emits `expr as T` (§3.6), which reads JSON into a T. There are two entry
    // points, one for text and one for a tree the program already holds. The
    // read is fallible and uses the out-parameter convention of genFSCall.
    String genAs(ast.AsExpression ex) {
        types.Type t = self.typeOf(ex);
        // A conversion between number types (§3.6) is a truncate to the width of
        // the type and an extend back in its family, so a conversion to a type
        // as wide as the unit emits nothing.
        if (marked(self.info.numericAs, ex.id)) {
            return self.fitResult(self.genExpr(ex.value), t);
        }
        // A narrowing and not a JSON read. `t as Union.Tag` answers the
        // optional of the payload and not of the member, so the member to
        // compare against comes from Info.asMembers.
        types.Record? member = self.info.asMembers[ex.id];
        types.Optional? mopt = t as types.Optional;
        if (member != null && mopt != null) {
            return self.genDowncast(ex, member, mopt);
        }
        types.Optional? opt = t as types.Optional;
        if (opt != null) {
            types.Record? ext = opt.inner as types.Record;
            if (ext != null) {
                types.Record? base = ext.base;
                if (base != null && base.sealed) {
                    return self.genDowncast(ex, ext, opt);
                }
            }
        }
        String strict = "0";
        if (ex.strict) {
            strict = "1";
        }
        String errSlot = self.rootSlot(types.ErrorT);
        self.emit("store ptr null, ptr %s", errSlot);

        String raw = self.newTmp();
        ast.CallExpression? call = ex.value as ast.CallExpression;
        if (call != null && self.isJSONParseCall(call)) {
            String text = self.genExpr(call.args[0]);
            // A byte[] document is read in place. The type of the argument
            // picks the entry point.
            String sym = "rt_json_parse_typed";
            if (self.parseArgIsBytes(call.args[0])) {
                sym = "rt_json_parse_typed_b";
            }
            self.emit("%s = call i64 @%s(ptr %s, ptr %s, i64 %s, ptr %s)",
                raw, sym, text, self.tdGlobal(t), strict, errSlot);
        } else {
            String node = self.genExpr(ex.value);
            self.emit("%s = call i64 @rt_json_from_node(ptr %s, ptr %s, i64 %s, ptr %s)",
                raw, node, self.tdGlobal(t), strict, errSlot);
        }
        self.raiseFromSlot(errSlot, "json");
        // The parsed value is a new allocation in no root yet.
        return self.protect(self.fromRaw(raw, llty(t)), t);
    }

    // Compiles `expr as T` where T extends a sealed type (§3.6). One comparison
    // of the descriptor of the value against that of T is the full test,
    // because a hierarchy is one level deep. Nothing is reinterpreted: a value
    // that passes the test is already a T.
    String genDowncast(ast.AsExpression ex, types.Record ext, types.Optional opt) {
        String val = self.genExpr(ex.value);
        String entry = self.block;
        String testL = self.newLabel("dc.test");
        String okL = self.newLabel("dc.ok");
        String endL = self.newLabel("dc.end");

        // A null record has no descriptor to read, so it answers null.
        String isNull = self.newTmp();
        self.emit("%s = icmp eq ptr %s, null", isNull, val);
        self.terminate("br i1 %s, label %%%s, label %%%s", isNull, endL, testL);

        self.startBlock(testL);
        String td = self.newTmp();
        self.emit("%s = load ptr, ptr %s", td, val);    // slot [0]: the record's own descriptor
        String same = self.newTmp();
        self.emit("%s = icmp eq ptr %s, %s", same, td, self.tdGlobal(ext));
        String testEnd = self.block;
        self.terminate("br i1 %s, label %%%s, label %%%s", same, okL, endL);

        self.startBlock(okL);
        // A union member answers what it holds, so the payload comes out of
        // field 0 and the box takes the type of the payload.
        String hit = val;
        types.Type ht = ext;
        if (self.info.asMembers[ex.id] != null) {
            ht = ext.fields[0].type;
            String fld = self.newTmp();
            self.emit("%s = getelementptr i8, ptr %s, i64 %s", fld, val, string.from(recOffset(ext, 0)));
            hit = self.loadElem(fld, ht);
        }
        self.protect(hit, ht);    // the box allocates
        String boxed = self.box(hit, ht);
        String okEnd = self.block;
        self.terminate("br label %%%s", endL);

        self.startBlock(endL);
        String v = self.newTmp();
        self.emit("%s = phi ptr [ null, %%%s ], [ null, %%%s ], [ %s, %%%s ]",
            v, entry, testEnd, boxed, okEnd);
        return self.protect(v, opt);
    }

    // Tells whether the call is `alias.parse(...)` on the json module, whose
    // JSON is text and not a tree.
    bool isJSONParseCall(ast.CallExpression call) {
        ast.MemberExpression? m = call.callee as ast.MemberExpression;
        if (m == null || m.property != "parse") {
            return false;
        }
        ast.Identifier? id = m.object as ast.Identifier;
        if (id == null) {
            return false;
        }
        checker.ModuleRef? ref = self.info.moduleAliases[id.name];
        return ref != null && ref.builtin == "json";
    }

    // Tells which of the two argument types of json.parse this call received.
    bool parseArgIsBytes(ast.Expression arg) {
        return types.isByteArray(self.typeOf(arg));
    }

    // Emits the functions of the built-in time module. `milliseconds` emits
    // nothing: a Duration is already an i64 count of milliseconds, so the
    // conversion exists only for the checker.
    String genTimeCall(ast.CallExpression ex, String fn) {
        if (fn == "milliseconds") {
            return self.genExpr(ex.args[0]);
        }
        String v = self.newTmp();
        switch (fn) {
            case "now":
                self.emit("%s = call i64 @rt_time_now()", v);
            case "duration":
                String a = self.genExpr(ex.args[0]);
                self.emit("%s = call i64 @rt_time_duration(ptr %s)", v, a);
            case "sleep":
                String ms = self.genExpr(ex.args[0]);
                self.emit("%s = call ptr @rt_time_sleep(i64 %s)", v, ms);
            default:
                // The checker rejects every other name first.
                break;
        }
        return v;
    }

    // Emits the calendar functions the `time.date` namespace reaches. Each takes
    // a DateTime, which is an i64, so no argument needs a root.
    String genTimeDateCall(ast.CallExpression ex, String fn) {
        String v = self.newTmp();
        switch (fn) {
            case "fromText":
                String ft = self.genExpr(ex.args[0]);
                self.emit("%s = call i64 @rt_date_from_text(ptr %s)", v, ft);
            case "toText":
                String tt = self.genExpr(ex.args[0]);
                self.emit("%s = call ptr @rt_date_to_text(i64 %s)", v, tt);
            case "year":
            case "month":
            case "day":
                String ya = self.genExpr(ex.args[0]);
                self.emit("%s = call i64 @rt_date_%s(i64 %s)", v, fn, ya);
            case "addDays":
                String a = self.genExpr(ex.args[0]);
                String b = self.genExpr(ex.args[1]);
                self.emit("%s = call i64 @rt_date_add_days(i64 %s, i64 %s)", v, a, b);
            default:
                // The checker rejects every other name first.
                break;
        }
        return v;
    }

    // Emits the functions of the built-in string module. An evaluation can
    // allocate, so a call with several arguments roots the earlier operands
    // while the later ones run. The runtime functions root their own parameters.
    String genStringCall(ast.CallExpression ex, String fn) {
        String v = self.newTmp();
        switch (fn) {
            case "from":
                // The argument travels as one of print's does: the 8-byte unit
                // plus its descriptor. rt_scalar_to_text is print's formatting,
                // so it lives in the core runtime and not in lib/string.c.
                types.Type at = self.typeOf(ex.args[0]);
                String raw = self.toRaw(self.genExpr(ex.args[0]), llty(at));
                self.emit("%s = call ptr @rt_scalar_to_text(i64 %s, ptr %s)", v, raw, self.tdGlobal(at));
            case "length":
                String s = self.genExpr(ex.args[0]);
                self.emit("%s = load i64, ptr %s", v, s);    // Str.len is the header's first word
            case "append":
                String aa = self.protect(self.genExpr(ex.args[0]), types.StringT);
                String ab = self.genExpr(ex.args[1]);
                self.emit("%s = call ptr @rt_str_concat(ptr %s, ptr %s)", v, aa, ab);
            case "toByteArray":
            case "fromByteArray":
            case "fromRunes":
            case "toUpperCaseAscii":
            case "toLowerCaseAscii":
            case "trim":
            case "copy":
                // fromByteArray and fromRunes take an array, and the shape of
                // the call is the same: one pointer in and one pointer out.
                String bs = self.genExpr(ex.args[0]);
                self.emit("%s = call ptr @%s(ptr %s)", v, stringSym(fn), bs);
            case "runeCount":
            case "isValidUtf8":
                String rs = self.genExpr(ex.args[0]);
                self.emit("%s = call i64 @%s(ptr %s)", v, stringSym(fn), rs);
            case "runeAt":
                // The offset expression can call, so the string stays rooted.
                String ra = self.protect(self.genExpr(ex.args[0]), types.StringT);
                String rb = self.genExpr(ex.args[1]);
                self.emit("%s = call i64 @rt_string_rune_at(ptr %s, i64 %s)", v, ra, rb);
            case "contains":
            case "find":
            case "equalsConstantTime":
                String ca = self.protect(self.genExpr(ex.args[0]), types.StringT);
                String cb = self.genExpr(ex.args[1]);
                self.emit("%s = call i64 @%s(ptr %s, ptr %s)", v, stringSym(fn), ca, cb);
            case "bytesEqualConstantTime":
                // The first operand roots as the array it is, not as a string.
                String ba = self.protect(self.genExpr(ex.args[0]), types.newArray(types.Uint8T));
                String bb = self.genExpr(ex.args[1]);
                self.emit("%s = call i64 @rt_bytes_equals_ct(ptr %s, ptr %s)", v, ba, bb);
            case "split":
                String sa = self.protect(self.genExpr(ex.args[0]), types.StringT);
                String sb = self.genExpr(ex.args[1]);
                self.emit("%s = call ptr @%s(ptr %s, ptr %s)", v, stringSym(fn), sa, sb);
            case "join":
                // The array of pieces stays rooted while the separator
                // expression runs.
                String ja = self.protect(self.genExpr(ex.args[0]), types.newArray(types.StringT));
                String jb = self.genExpr(ex.args[1]);
                self.emit("%s = call ptr @%s(ptr %s, ptr %s)", v, stringSym(fn), ja, jb);
            case "replace":
            case "replaceAll":
                String pa = self.protect(self.genExpr(ex.args[0]), types.StringT);
                String pb = self.protect(self.genExpr(ex.args[1]), types.StringT);
                String pc = self.genExpr(ex.args[2]);
                self.emit("%s = call ptr @%s(ptr %s, ptr %s, ptr %s)", v, stringSym(fn), pa, pb, pc);

            case "substring":
                // An index expression can call a function and so allocate, so
                // the string stays rooted.
                String us = self.protect(self.genExpr(ex.args[0]), types.StringT);
                String ustart = self.genExpr(ex.args[1]);
                String uend = self.genExpr(ex.args[2]);
                self.emit("%s = call ptr @rt_string_substring(ptr %s, i64 %s, i64 %s)", v, us, ustart, uend);
            case "toInt":
            case "toUint":
            case "toFloat":
                self.genStringParse(ex, fn, v);
            default:
                // The checker rejects every other name first.
                break;
        }
        return v;
    }

    // Emits string.toInt, string.toUint and string.toFloat. They are fallible
    // and use the out-parameter convention of genFSCall. The result is a scalar,
    // so nothing here needs a root.
    void genStringParse(ast.CallExpression ex, String fn, String v) {
        String s = self.genExpr(ex.args[0]);
        String errSlot = self.rootSlot(types.ErrorT);
        self.emit("store ptr null, ptr %s", errSlot);
        if (fn == "toInt") {
            self.emit("%s = call i64 @rt_string_to_int(ptr %s, ptr %s)", v, s, errSlot);
        } else if (fn == "toUint") {
            self.emit("%s = call i64 @rt_string_to_uint(ptr %s, ptr %s)", v, s, errSlot);
        } else {
            self.emit("%s = call double @rt_string_to_float(ptr %s, ptr %s)", v, s, errSlot);
        }
        self.raiseFromSlot(errSlot, "str");
    }

    // Emits the functions of the built-in math module (§6.21). The libm
    // functions are one C wrapper each, named after the function. abs, min,
    // max, clamp and toFloat are generic over the number families, so they
    // are emitted inline on the widened type the checker answered: a select on
    // a comparison for the integers, and the IEEE minNum and maxNum intrinsics
    // for the floats, which answer the number when the other operand is NaN.
    // Every operand is a number in a register, so nothing here needs a root.
    String genMathCall(ast.CallExpression ex, String fn) {
        types.Type res = self.typeOf(ex);
        String v = self.newTmp();
        if (fn == "toFloat") {
            String n = self.genExpr(ex.args[0]);
            String op = "sitofp";
            if (types.isUnsignedFamily(self.typeOf(ex.args[0]))) {
                op = "uitofp";
            }
            self.emit("%s = %s i64 %s to double", v, op, n);
            return v;
        }
        if (fn == "abs") {
            String x = self.genExpr(ex.args[0]);
            if (types.isFloatFamily(res)) {
                self.emit("%s = call double @llvm.fabs.f64(double %s)", v, x);
                return v;
            }
            if (types.isUnsignedFamily(res)) {
                return x;
            }
            // The lowest value negates to itself, as `-x` does (§2.1).
            String neg = self.newTmp();
            self.emit("%s = icmp slt i64 %s, 0", neg, x);
            String flipped = self.newTmp();
            self.emit("%s = sub i64 0, %s", flipped, x);
            self.emit("%s = select i1 %s, i64 %s, i64 %s", v, neg, flipped, x);
            return self.fitResult(v, res);
        }
        if (fn == "min" || fn == "max") {
            String a = self.genExpr(ex.args[0]);
            String b = self.genExpr(ex.args[1]);
            return self.genMinMax(a, b, fn, res);
        }
        if (fn == "clamp") {
            String x2 = self.genExpr(ex.args[0]);
            String lo = self.genExpr(ex.args[1]);
            String hi = self.genExpr(ex.args[2]);
            String floored = self.genMinMax(x2, lo, "max", res);
            return self.genMinMax(floored, hi, "min", res);
        }
        String x3 = self.genExpr(ex.args[0]);
        if (fn == "pow" || fn == "atan2") {
            String y = self.genExpr(ex.args[1]);
            self.emit("%s = call double @rt_math_%s(double %s, double %s)", v, fn, x3, y);
            return v;
        }
        if (fn == "isNaN") {
            self.emit("%s = call i64 @rt_math_is_nan(double %s)", v, x3);
            return v;
        }
        if (fn == "isInfinite") {
            self.emit("%s = call i64 @rt_math_is_inf(double %s)", v, x3);
            return v;
        }
        if (fn == "toInt") {
            self.emit("%s = call i64 @rt_math_to_int(double %s)", v, x3);
            return v;
        }
        self.emit("%s = call double @rt_math_%s(double %s)", v, fn, x3);
        return v;
    }

    // The smaller or the larger of two evaluated numbers of the type res.
    String genMinMax(String a, String b, String fn, types.Type res) {
        String v = self.newTmp();
        if (types.isFloatFamily(res)) {
            String intrinsic = "llvm.minnum.f64";
            if (fn == "max") {
                intrinsic = "llvm.maxnum.f64";
            }
            self.emit("%s = call double @%s(double %s, double %s)", v, intrinsic, a, b);
            return v;
        }
        String cmp = "slt";
        if (fn == "max") {
            cmp = "sgt";
        }
        if (types.isUnsignedFamily(res)) {
            cmp = "ult";
            if (fn == "max") {
                cmp = "ugt";
            }
        }
        String c = self.newTmp();
        self.emit("%s = icmp %s i64 %s, %s", c, cmp, a, b);
        self.emit("%s = select i1 %s, i64 %s, i64 %s", v, c, a, b);
        return v;
    }

    // Emits the functions of the built-in random module (§6.22). shuffle and
    // pick are generic over the element type: the runtime moves or reads an
    // element at the array's own width, and pick's unit is widened here as
    // array.pop's is. Nothing allocates, so nothing needs a root.
    String genRandomCall(ast.CallExpression ex, String fn) {
        String v = self.newTmp();
        if (fn == "seed") {
            String s = self.genExpr(ex.args[0]);
            self.emit("call void @rt_random_seed(i64 %s)", s);
            return "";
        }
        if (fn == "int") {
            String lo = self.genExpr(ex.args[0]);
            String hi = self.genExpr(ex.args[1]);
            self.emit("%s = call i64 @rt_random_int(i64 %s, i64 %s)", v, lo, hi);
            return v;
        }
        if (fn == "float") {
            self.emit("%s = call double @rt_random_float()", v);
            return v;
        }
        types.Array at = asArray(self.typeOf(ex.args[0]));
        String arr = self.genExpr(ex.args[0]);
        if (fn == "shuffle") {
            self.emit("call void @rt_random_shuffle(ptr %s)", arr);
            return "";
        }
        self.emit("%s = call i64 @rt_random_pick(ptr %s, ptr %s)", v, arr, self.tdGlobal(at));
        return self.fromRaw(v, llty(at.elem));
    }

    // Emits the functions of the built-in os module. None takes an argument, so
    // nothing needs a root. getCpus takes the descriptor for os.Cpu[], because
    // it allocates the array and the records itself and must trace them.
    String genOSCall(ast.CallExpression ex, String fn) {
        String v = self.newTmp();
        if (fn == "getArch") {
            self.emit("%s = call ptr @rt_os_arch()", v);
        } else if (fn == "getPlatform") {
            self.emit("%s = call ptr @rt_os_platform()", v);
        } else {
            // getCpus
            self.emit("%s = call ptr @rt_os_get_cpus(ptr %s)", v, self.tdGlobal(self.typeOf(ex)));
        }
        return v;
    }

    // Emits `async.race(f1, f2, ...)`. The futures go into one array, so one
    // root covers all of them while the later ones run. It is written out here
    // because the arguments have no common type a signature could name. A future
    // is a pointer whatever it holds, so the array traces as an array of futures.
    String genAsyncRace(ast.CallExpression ex) {
        types.Array at = types.newArray(types.newFutureType(types.VoidT, false));
        String arr = self.newTmp();
        self.emit("%s = call ptr @rt_arr_new(i64 %s, i64 8)", arr, string.from(ex.args.length));
        self.protect(arr, at);
        forEach(ex.args, a, i) {
            String v = self.genExpr(a);
            String slot = self.newTmp();
            self.emit("%s = call ptr @rt_arr_slot(ptr %s, i64 %s)", slot, arr, string.from(i));
            self.emit("store ptr %s, ptr %s", v, slot);
        }
        String v = self.newTmp();
        self.emit("%s = call ptr @rt_async_race(ptr %s)", v, arr);
        return self.protect(v, self.typeOf(ex));
    }

    // Emits the functions of the built-in path module. Nothing here is generic,
    // and the runtime roots its own arguments. userData is the only fallible
    // function, with the out-parameter convention of genFSCall.
    String genPathCall(ast.CallExpression ex, String fn) {
        if (fn == "join") {
            return self.genDirectCall(ex, pathJoinSig, "@rt_path_join");
        }
        if (fn == "localize") {
            String s = self.genExpr(ex.args[0]);
            String v = self.newTmp();
            self.emit("%s = call ptr @rt_path_localize(ptr %s)", v, s);
            return v;
        }
        if (fn == "userData") {
            String app = self.genExpr(ex.args[0]);
            String errSlot = self.rootSlot(types.ErrorT);
            self.emit("store ptr null, ptr %s", errSlot);
            String v = self.newTmp();
            self.emit("%s = call ptr @rt_path_user_data(ptr %s, ptr %s)", v, app, errSlot);
            self.raiseFromSlot(errSlot, "path");
            // A new allocation in no root yet.
            return self.protect(v, types.StringT);
        }
        // getCwd
        String v = self.newTmp();
        self.emit("%s = call ptr @rt_path_getcwd()", v);
        return v;
    }

    // Emits the functions of the built-in fs module. Every one but `exists` is
    // fallible. The runtime function takes a last `void **err` out-parameter and
    // stores an Error through it, and the branch here gives that error to
    // emitRaise. This is the convention every raising runtime function uses.
    //
    // The {T, ptr} pair a fallible Nio function returns must not cross into C:
    // clang lowers a two-pointer C struct return to an LLVM `[2 x i64]`, not the
    // `{ptr, ptr}` a declaration here would name. An out-parameter has one
    // lowering on every target.
    //
    // The error slot is a GC root, so the collector traces the Error from the
    // moment the runtime stores it. The code clears the slot before the call, or
    // a call reached a second time, such as one in a catch handler that
    // continues a loop, would raise the earlier error again.
    String genFSCall(ast.CallExpression ex, String fn) {
        if (fn == "exists") {
            // The only function here that cannot fail. rt_fs_exists never
            // allocates, so it needs no slot, no branch and no root.
            String p = self.genExpr(ex.args[0]);
            String v = self.newTmp();
            self.emit("%s = call i64 @rt_fs_exists(ptr %s)", v, p);
            return v;
        }

        String errSlot = self.rootSlot(types.ErrorT);
        String v = "";
        if (fn == "writeFile") {
            // The content expression can allocate, so the path stays rooted.
            // The runtime allocates only the Error it can store.
            String p = self.protect(self.genExpr(ex.args[0]), types.StringT);
            String content = self.genExpr(ex.args[1]);
            self.emit("store ptr null, ptr %s", errSlot);
            self.emit("call void @rt_fs_write_file(ptr %s, ptr %s, ptr %s)", p, content, errSlot);
        } else if (fn == "createDir") {
            // rt_fs_create_dir allocates only the Error it stores, so nothing
            // needs a root.
            String p = self.genExpr(ex.args[0]);
            self.emit("store ptr null, ptr %s", errSlot);
            self.emit("call void @rt_fs_create_dir(ptr %s, ptr %s)", p, errSlot);
        } else if (fn == "rename" || fn == "copy") {
            // The second path expression can allocate, so the first stays
            // rooted.
            String from = self.protect(self.genExpr(ex.args[0]), types.StringT);
            String to = self.genExpr(ex.args[1]);
            self.emit("store ptr null, ptr %s", errSlot);
            self.emit("call void @rt_fs_%s(ptr %s, ptr %s, ptr %s)", fn, from, to, errSlot);
        } else if (fn == "delete") {
            // The options record passes as it is, and fs.c reads its fields.
            // A call that omits the options passes null, which reads as every
            // field unset. An options literal allocates, so the path is rooted
            // in that case only.
            String opts = "null";
            String p = "";
            if (ex.args.length > 1) {
                p = self.protect(self.genExpr(ex.args[0]), types.StringT);
                opts = self.genExpr(ex.args[1]);
            } else {
                p = self.genExpr(ex.args[0]);
            }
            self.emit("store ptr null, ptr %s", errSlot);
            self.emit("call void @rt_fs_delete(ptr %s, ptr %s, ptr %s)", p, opts, errSlot);
        } else {
            // readDir, readFile, stat, createTempDir
            String p = self.genExpr(ex.args[0]);
            self.emit("store ptr null, ptr %s", errSlot);
            v = self.newTmp();
            self.emit("%s = call ptr @%s(ptr %s, ptr %s)", v, fsSym(fn), p, errSlot);
        }

        self.raiseFromSlot(errSlot, "fs");
        if (v == "") {
            return "";    // createDir, delete and writeFile have no value
        }
        // A new allocation in no root yet.
        return self.protect(v, self.typeOf(ex));
    }

    // Emits the functions of the built-in regexp module (§6.14). `create` is
    // fallible, with the out-parameter convention of genFSCall, because a
    // pattern is text from outside the program. A call with no flags passes
    // null, which reads as no flags. `find` and `match` allocate nothing.
    String genRegexpCall(ast.CallExpression ex, String fn) {
        String v = self.newTmp();
        if (fn == "create") {
            String pat = "";
            String flags = "null";
            if (ex.args.length > 1) {
                pat = self.protect(self.genExpr(ex.args[0]), types.StringT);
                flags = self.genExpr(ex.args[1]);
            } else {
                pat = self.genExpr(ex.args[0]);
            }
            String errSlot = self.rootSlot(types.ErrorT);
            self.emit("store ptr null, ptr %s", errSlot);
            self.emit("%s = call ptr @rt_regexp_create(ptr %s, ptr %s, ptr %s)", v, pat, flags, errSlot);
            self.raiseFromSlot(errSlot, "re");
            // A new allocation in no root yet.
            return self.protect(v, types.RegExpT);
        }
        // find, match
        String s = self.protect(self.genExpr(ex.args[0]), types.StringT);
        String re = self.genExpr(ex.args[1]);
        String symbol = "rt_regexp_find";
        if (fn == "match") {
            symbol = "rt_regexp_match";
        }
        self.emit("%s = call i64 @%s(ptr %s, ptr %s)", v, symbol, s, re);
        return v;
    }

    // Emits the functions of the built-in crypto module (§6.17). The fallible
    // ones use the out-parameter convention of genFSCall. randomBytes panics
    // when the generator of the operating system fails, which no handler can act
    // on. Every function answers a new allocation, so every result is rooted,
    // and an earlier byte[] argument stays rooted while the later ones run.
    String genCryptoCall(ast.CallExpression ex, String fn) {
        String v = self.newTmp();
        if (fn == "base64Decode" || fn == "hexDecode") {
            String s = self.genExpr(ex.args[0]);
            String errSlot = self.rootSlot(types.ErrorT);
            self.emit("store ptr null, ptr %s", errSlot);
            String symbol = "rt_crypto_base64_decode";
            if (fn == "hexDecode") {
                symbol = "rt_crypto_hex_decode";
            }
            self.emit("%s = call ptr @%s(ptr %s, ptr %s)", v, symbol, s, errSlot);
            self.raiseFromSlot(errSlot, "crypto");
            return self.protect(v, self.typeOf(ex));
        }
        if (fn == "randomBytes") {
            String n = self.genExpr(ex.args[0]);
            self.emit("%s = call ptr @rt_crypto_random_bytes(i64 %s)", v, n);
            return self.protect(v, self.typeOf(ex));
        }
        if (fn == "sha256" || fn == "sha384" || fn == "base64Encode" || fn == "hexEncode"
            || fn == "x25519PublicKey") {
            String a = self.genExpr(ex.args[0]);
            String symbol = "rt_crypto_sha256";
            if (fn == "sha384") {
                symbol = "rt_crypto_sha384";
            } else if (fn == "base64Encode") {
                symbol = "rt_crypto_base64_encode";
            } else if (fn == "hexEncode") {
                symbol = "rt_crypto_hex_encode";
            } else if (fn == "x25519PublicKey") {
                symbol = "rt_crypto_x25519_public";
            }
            self.emit("%s = call ptr @%s(ptr %s)", v, symbol, a);
            return self.protect(v, self.typeOf(ex));
        }
        if (fn == "x25519SharedSecret") {
            String priv = self.protect(self.genExpr(ex.args[0]), self.typeOf(ex.args[0]));
            String peer = self.genExpr(ex.args[1]);
            String errSlot = self.rootSlot(types.ErrorT);
            self.emit("store ptr null, ptr %s", errSlot);
            self.emit("%s = call ptr @rt_crypto_x25519_shared(ptr %s, ptr %s, ptr %s)",
                v, priv, peer, errSlot);
            self.raiseFromSlot(errSlot, "crypto");
            return self.protect(v, self.typeOf(ex));
        }
        // The two RSA verifiers answer nothing: they return or they raise.
        if (fn == "rsaVerifyPkcs1v15" || fn == "rsaVerifyPss") {
            String mod = self.protect(self.genExpr(ex.args[0]), self.typeOf(ex.args[0]));
            String exp = self.genExpr(ex.args[1]);
            String hash = self.protect(self.genExpr(ex.args[2]), self.typeOf(ex.args[2]));
            String dig = self.protect(self.genExpr(ex.args[3]), self.typeOf(ex.args[3]));
            String sigv = self.genExpr(ex.args[4]);
            String errSlot = self.rootSlot(types.ErrorT);
            self.emit("store ptr null, ptr %s", errSlot);
            String symbol = "rt_crypto_rsa_verify_pkcs1v15";
            if (fn == "rsaVerifyPss") {
                symbol = "rt_crypto_rsa_verify_pss";
            }
            self.emit("call void @%s(ptr %s, i64 %s, ptr %s, ptr %s, ptr %s, ptr %s)",
                symbol, mod, exp, hash, dig, sigv, errSlot);
            self.raiseFromSlot(errSlot, "crypto");
            return "";
        }
        // The ECDSA verifier has the same shape, with every argument a heap
        // value.
        if (fn == "ecdsaVerify") {
            String curve = self.protect(self.genExpr(ex.args[0]), self.typeOf(ex.args[0]));
            String pub = self.protect(self.genExpr(ex.args[1]), self.typeOf(ex.args[1]));
            String dig = self.protect(self.genExpr(ex.args[2]), self.typeOf(ex.args[2]));
            String rArg = self.protect(self.genExpr(ex.args[3]), self.typeOf(ex.args[3]));
            String sArg = self.genExpr(ex.args[4]);
            String errSlot = self.rootSlot(types.ErrorT);
            self.emit("store ptr null, ptr %s", errSlot);
            self.emit("call void @rt_crypto_ecdsa_verify(ptr %s, ptr %s, ptr %s, ptr %s, ptr %s, ptr %s)",
                curve, pub, dig, rArg, sArg, errSlot);
            self.raiseFromSlot(errSlot, "crypto");
            return "";
        }
        // The two AEAD calls take four byte[] arguments.
        if (fn == "chacha20Poly1305Seal" || fn == "chacha20Poly1305Open") {
            String key = self.protect(self.genExpr(ex.args[0]), self.typeOf(ex.args[0]));
            String nonce = self.protect(self.genExpr(ex.args[1]), self.typeOf(ex.args[1]));
            String payload = self.protect(self.genExpr(ex.args[2]), self.typeOf(ex.args[2]));
            String aad = self.genExpr(ex.args[3]);
            if (fn == "chacha20Poly1305Seal") {
                self.emit("%s = call ptr @rt_crypto_chacha20poly1305_seal(ptr %s, ptr %s, ptr %s, ptr %s)",
                    v, key, nonce, payload, aad);
                return self.protect(v, self.typeOf(ex));
            }
            String errSlot = self.rootSlot(types.ErrorT);
            self.emit("store ptr null, ptr %s", errSlot);
            self.emit("%s = call ptr @rt_crypto_chacha20poly1305_open(ptr %s, ptr %s, ptr %s, ptr %s, ptr %s)",
                v, key, nonce, payload, aad, errSlot);
            self.raiseFromSlot(errSlot, "crypto");
            return self.protect(v, self.typeOf(ex));
        }
        // AES-GCM. Both halves are fallible, unlike the ChaCha pair: the cipher
        // exists only where the CPU has the instructions (§6.17).
        if (fn == "aesGcmAvailable") {
            self.emit("%s = call i64 @rt_crypto_aes_gcm_available()", v);
            return v;
        }
        if (fn == "aes128GcmSeal" || fn == "aes128GcmOpen") {
            String key = self.protect(self.genExpr(ex.args[0]), self.typeOf(ex.args[0]));
            String nonce = self.protect(self.genExpr(ex.args[1]), self.typeOf(ex.args[1]));
            String payload = self.protect(self.genExpr(ex.args[2]), self.typeOf(ex.args[2]));
            String aad = self.genExpr(ex.args[3]);
            String errSlot = self.rootSlot(types.ErrorT);
            self.emit("store ptr null, ptr %s", errSlot);
            String symbol = "rt_crypto_aes128gcm_seal";
            if (fn == "aes128GcmOpen") {
                symbol = "rt_crypto_aes128gcm_open";
            }
            self.emit("%s = call ptr @%s(ptr %s, ptr %s, ptr %s, ptr %s, ptr %s)",
                v, symbol, key, nonce, payload, aad, errSlot);
            self.raiseFromSlot(errSlot, "crypto");
            return self.protect(v, self.typeOf(ex));
        }
        if (fn == "hkdfExpandSha256" || fn == "hkdfExpandSha384") {
            String prk = self.protect(self.genExpr(ex.args[0]), self.typeOf(ex.args[0]));
            String info = self.protect(self.genExpr(ex.args[1]), self.typeOf(ex.args[1]));
            String len = self.genExpr(ex.args[2]);
            String symbol = "rt_crypto_hkdf_expand_sha256";
            if (fn == "hkdfExpandSha384") {
                symbol = "rt_crypto_hkdf_expand_sha384";
            }
            self.emit("%s = call ptr @%s(ptr %s, ptr %s, i64 %s)", v, symbol, prk, info, len);
            return self.protect(v, self.typeOf(ex));
        }
        // hmacSha256/384 and hkdfExtractSha256/384: two byte[] arguments.
        String first = self.protect(self.genExpr(ex.args[0]), self.typeOf(ex.args[0]));
        String second = self.genExpr(ex.args[1]);
        String symbol = "rt_crypto_hmac_sha256";
        if (fn == "hmacSha384") {
            symbol = "rt_crypto_hmac_sha384";
        } else if (fn == "hkdfExtractSha256") {
            symbol = "rt_crypto_hkdf_extract_sha256";
        } else if (fn == "hkdfExtractSha384") {
            symbol = "rt_crypto_hkdf_extract_sha384";
        }
        self.emit("%s = call ptr @%s(ptr %s, ptr %s)", v, symbol, first, second);
        return self.protect(v, self.typeOf(ex));
    }

    // Emits the calls that open something in the net module (§6.15), which are
    // the only ones that must know the protocol. The protocol travels as a
    // number, because everything after the socket exists is one implementation.
    String genNetOpenCall(ast.CallExpression ex, String ns, String fn) {
        String proto = string.from(netTCP);
        if (ns == "udp") {
            proto = string.from(netUDP);
        } else if (ns == "unix") {
            proto = string.from(netUNIX);
        }
        String v = self.newTmp();
        if (fn == "bind") {
            // udp.bind takes no options: none applies to a socket that neither
            // listens nor connects.
            String only = self.genExpr(ex.args[0]);
            String slot = self.rootSlot(types.ErrorT);
            self.emit("store ptr null, ptr %s", slot);
            self.emit("%s = call ptr @rt_net_udp_bind(ptr %s, ptr %s)", v, only, slot);
            self.raiseFromSlot(slot, "net");
            return self.protect(v, types.SocketT);
        }
        // An options literal allocates, so the address stays rooted. A call with
        // no options passes null, which reads as options that set nothing.
        String addr = "";
        String opts = "null";
        if (ex.args.length > 1) {
            addr = self.protect(self.genExpr(ex.args[0]), types.StringT);
            opts = self.genExpr(ex.args[1]);
        } else {
            addr = self.genExpr(ex.args[0]);
        }
        if (fn == "connect") {
            // Nothing raises here. connect answers a future, and every failure
            // completes that future (§6.15).
            self.emit("%s = call ptr @rt_net_connect(i64 %s, ptr %s, ptr %s)", v, proto, addr, opts);
            return self.protect(v, self.typeOf(ex));
        }
        // listen answers at once, so it is fallible in the usual way.
        String errSlot = self.rootSlot(types.ErrorT);
        self.emit("store ptr null, ptr %s", errSlot);
        self.emit("%s = call ptr @rt_net_listen(i64 %s, ptr %s, ptr %s, ptr %s)",
            v, proto, addr, opts, errSlot);
        self.raiseFromSlot(errSlot, "net");
        return self.protect(v, types.ListenerT);
    }

    // Emits everything a socket can do after it exists, which is the same
    // operation whatever protocol opened it. The five functions that wait raise
    // nothing at the call: each completes its future with the Error, so a caller
    // meets every failure at the await (§6.15). `close` cannot fail. `address`
    // and `peer` answer at once and use the out-parameter convention.
    String genNetCall(ast.CallExpression ex, String fn) {
        if (fn == "close") {
            String h = self.genExpr(ex.args[0]);
            self.emit("call void @rt_net_close(ptr %s)", h);
            return "";
        }
        String v = self.newTmp();
        if (fn == "address" || fn == "peer") {
            String h = self.genExpr(ex.args[0]);
            String errSlot = self.rootSlot(types.ErrorT);
            self.emit("store ptr null, ptr %s", errSlot);
            self.emit("%s = call ptr @rt_net_%s(ptr %s, ptr %s)", v, fn, h, errSlot);
            self.raiseFromSlot(errSlot, "net");
            return self.protect(v, types.StringT);
        }
        // An options literal at the end allocates, so each argument before it
        // stays rooted. The last needs none: the runtime reads its arguments
        // before it allocates (`begin` in lib/net.c).
        int last = ex.args.length - 1;
        String[] vals = [];
        forEach(ex.args, a, i) {
            types.Type at = self.typeOf(a);
            String s = self.genExpr(a);
            if (i < last) {
                s = self.protect(s, at);
            }
            array.push(vals, llty(at) + " " + s);
        }
        if (ex.args.length == netArity(fn) - 1) {
            array.push(vals, "ptr null");    // the options tail, left off
        }
        self.emit("%s = call ptr @rt_net_%s(%s)", v, fn, string.join(vals, ", "));
        return self.protect(v, self.typeOf(ex));
    }

    // Finishes a call that took a `void **err` out-parameter. It loads the slot
    // and branches to emitRaise when an Error is there. The code that follows
    // continues in the no-raise block. `what` is the prefix of the labels.
    void raiseFromSlot(String errSlot, String what) {
        String err = self.newTmp();
        self.emit("%s = load ptr, ptr %s", err, errSlot);
        String isErr = self.newTmp();
        String errL = self.newLabel(what + ".raise");
        String okL = self.newLabel(what + ".noraise");
        self.emit("%s = icmp ne ptr %s, null", isErr, err);
        self.terminate("br i1 %s, label %%%s, label %%%s", isErr, errL, okL);
        self.startBlock(errL);
        self.emitRaise(err);
        self.startBlock(okL);
    }

    // Emits the functions on the process module itself: exit and getArgs. The
    // namespaces reach genProcessNsCall instead. exit never returns, which the
    // runtime handles, so here it is an ordinary void call.
    String genProcessCall(ast.CallExpression ex, String fn) {
        if (fn == "exit") {
            String code = self.genExpr(ex.args[0]);
            self.emit("call void @rt_process_exit(i64 %s)", code);
            return "";
        }
        // getArgs answers a new array for each call, so a write into it never
        // changes what a later call answers.
        String v = self.newTmp();
        self.emit("%s = call ptr @rt_process_get_args()", v);
        return self.protect(v, self.typeOf(ex));
    }

    // Emits the functions in the namespaces of the built-in process module. The
    // stream writes cannot fail. The stdin reads are fallible and use the
    // out-parameter convention of genFSCall. child.run raises nothing.
    String genProcessNsCall(ast.CallExpression ex, String ns, String fn) {
        if (ns == "stdout" || ns == "stderr") {
            // A write and a flush answer nothing, and neither fails in a way a
            // caller can act on. See lib/process.c.
            if (fn == "flush") {
                self.emit("call void @rt_process_%s_flush()", ns);
                return "";
            }
            String s = self.genExpr(ex.args[0]);
            self.emit("call void @rt_process_%s_write(ptr %s)", ns, s);
            return "";
        }
        if (ns == "child") {    // run
            // Nothing raises here: a program that did not start is an Error on
            // the future, taken at the await (§6.12). The options record passes
            // as it is, and lib/process.c reads its fields. A call that omits
            // the options passes null, which reads as every field unset.
            String cmd = self.protect(self.genExpr(ex.args[0]), types.StringT);
            String opts = "null";
            String args = "";
            if (ex.args.length > 2) {
                args = self.protect(self.genExpr(ex.args[1]), self.typeOf(ex.args[1]));
                opts = self.genExpr(ex.args[2]);
            } else {
                args = self.genExpr(ex.args[1]);
            }
            String rv = self.newTmp();
            self.emit("%s = call ptr @rt_process_run(ptr %s, ptr %s, ptr %s)", rv, cmd, args, opts);
            return self.protect(rv, self.typeOf(ex));
        }
        // readBytes is the only stdin read with an argument. Its count is an
        // i64 and needs no root, so it can run before the error slot is reset.
        if (fn == "readBytes") {
            String n = self.genExpr(ex.args[0]);
            String nSlot = self.rootSlot(types.ErrorT);
            self.emit("store ptr null, ptr %s", nSlot);
            String nv = self.newTmp();
            self.emit("%s = call ptr @rt_process_stdin_read_bytes(i64 %s, ptr %s)", nv, n, nSlot);
            self.raiseFromSlot(nSlot, "stdin");
            return self.protect(nv, self.typeOf(ex));
        }
        String sym = "rt_process_stdin_read";
        if (fn == "readLine") {
            sym = "rt_process_stdin_read_line";
        }
        String errSlot = self.rootSlot(types.ErrorT);
        self.emit("store ptr null, ptr %s", errSlot);
        String v = self.newTmp();
        self.emit("%s = call ptr @%s(ptr %s)", v, sym, errSlot);
        self.raiseFromSlot(errSlot, "stdin");
        // A new allocation in no root yet. readLine answers null at the end of
        // the input, and a root on null is harmless.
        return self.protect(v, self.typeOf(ex));
    }

    // ---- value adaptation ----

    // Emits e and adapts its value to the target type, which allocates a box for
    // a value assigned into an optional.
    String genConverted(ast.Expression e, types.Type target) {
        String v = self.genExpr(e);
        types.Type st = self.typeOf(e);
        types.Optional? topt = target as types.Optional;
        if (topt != null) {
            types.Optional? sopt = st as types.Optional;
            if (sopt == null && !types.equal(st, types.NullT)) {
                return self.box(v, st);
            }
        }
        return v;
    }

    // Allocates a heap box holding v at its own width (§5.7). That box is the
    // cell behind a present optional and behind a captured variable. The
    // TypeDesc gives rt_box the width. The value is rooted first, because rt_box
    // allocates and cannot trace an arbitrary value.
    String box(String v, types.Type t) {
        self.protect(v, t);
        String raw = self.toRaw(v, llty(t));
        String b = self.newTmp();
        self.emit("%s = call ptr @rt_box(i64 %s, ptr %s)", b, raw, self.tdGlobal(t));
        return b;
    }

    String toRaw(String v, String lty) {
        if (lty == "double") {
            String r = self.newTmp();
            self.emit("%s = bitcast double %s to i64", r, v);
            return r;
        }
        if (lty == "ptr") {
            String r = self.newTmp();
            self.emit("%s = ptrtoint ptr %s to i64", r, v);
            return r;
        }
        return v;
    }

    // Converts an i64 bit pattern from the runtime back to the form of the
    // value. It is the inverse of toRaw.
    String fromRaw(String raw, String lty) {
        if (lty == "double") {
            String v = self.newTmp();
            self.emit("%s = bitcast i64 %s to double", v, raw);
            return v;
        }
        if (lty == "ptr") {
            String v = self.newTmp();
            self.emit("%s = inttoptr i64 %s to ptr", v, raw);
            return v;
        }
        return raw;
    }

    // Emits the zero value of t: 0, 0.0, "", false, an empty array, a record
    // whose fields hold their zero values, or null for an optional.
    String zeroValue(types.Type t) {
        Map<String, bool> visiting = {};
        return self.zeroValueGuarded(t, visiting);
    }

    String zeroValueGuarded(types.Type t, Map<String, bool> visiting) {
        switch (t) {
            case types.Basic b:
                if (b.kind == types.Kind.STRING) {
                    return self.strGlobal("");
                }
                return zeroConst(t);
            case types.Optional o:
                return "null";
            case types.MapType mt:
                String mv = self.newTmp();
                self.emit("%s = call ptr @rt_map_new()", mv);
                return mv;
            case types.Array at:
                // rt_alloc clears the slots, which is the zero value of every
                // element type whose zero is all zero bits. Strings, records and
                // arrays need a fill loop.
                String av = self.newTmp();
                self.emit("%s = call ptr @rt_arr_new(i64 %s, i64 %s)", av,
                    string.from(at.len), arrWidth(at.elem));
                if (at.len > 0 && zeroNeedsFill(at.elem)) {
                    self.protect(av, at);    // the loop body allocates
                    self.fillArrayZero(av, at.elem, at.len, visiting);
                }
                return av;
            case types.Record rec:
                String key = typeKey(rec);
                if (visiting[key] != null) {
                    return "null";    // recursive record: no finite zero
                }
                if (rec.sealed) {
                    // Nothing can construct a sealed type (§2.4): such a value
                    // is in no extenders list, so it would match no clause of an
                    // exhaustive type switch. genTypeSwitch reports this null.
                    return "null";
                }
                visiting[key] = true;
                String r = self.newTmp();
                self.emit("%s = call ptr @rt_alloc(i64 %s)", r, string.from(recSizeOf(rec)));
                self.emit("store ptr %s, ptr %s", self.tdGlobal(rec), r);    // see genRecordLiteral
                self.protect(r, rec);                                        // zero values of nested fields allocate
                forEach(rec.fields, f, i) {
                    String v = self.zeroValueGuarded(f.type, visiting);
                    if (v == "0" || v == "null") {
                        continue;    // rt_alloc zeroes memory
                    }
                    String slot = self.newTmp();
                    self.emit("%s = getelementptr i8, ptr %s, i64 %s", slot, r, string.from(recOffset(rec, i)));
                    self.storeElem(slot, v, f.type);
                }
                map.remove(visiting, key);
                return r;
            default:
                return zeroConst(t);
        }
    }

    // Emits a loop that stores the zero value of elem into each of the n slots of
    // arr. The caller has rooted arr.
    void fillArrayZero(String arr, types.Type elem, int n, Map<String, bool> visiting) {
        String iSlot = self.alloca(types.IntT);
        self.emit("store i64 0, ptr %s", iSlot);
        String condL = self.newLabel("zf.cond");
        String bodyL = self.newLabel("zf.body");
        String endL = self.newLabel("zf.end");
        self.terminate("br label %%%s", condL);

        self.startBlock(condL);
        String i = self.newTmp();
        self.emit("%s = load i64, ptr %s", i, iSlot);
        String c = self.newTmp();
        self.emit("%s = icmp slt i64 %s, %s", c, i, string.from(n));
        self.terminate("br i1 %s, label %%%s, label %%%s", c, bodyL, endL);

        self.startBlock(bodyL);
        String v = self.zeroValueGuarded(elem, visiting);
        String slot = self.newTmp();
        self.emit("%s = call ptr @rt_arr_slot(ptr %s, i64 %s)", slot, arr, i);
        self.storeElem(slot, v, elem);
        String inext = self.newTmp();
        self.emit("%s = add i64 %s, 1", inext, i);
        self.emit("store i64 %s, ptr %s", inext, iSlot);
        self.terminate("br label %%%s", condL);

        self.startBlock(endL);
    }

    // ---- global constants ----

    // Makes one shared constant for a language string, of the form
    // { i64 len, [n x i8] }, behind a one-word GC header that carries GC_STATIC.
    // The name the rest of codegen uses points at the payload after that header,
    // so a literal and an rt_str_alloc string have the same layout and the
    // collector can read the header of any pointer. The header matches GCObj in
    // runtime.h.
    String strGlobal(String s) {
        String? known = self.strs[s];
        if (known != null) {
            return known;
        }
        String name = "@str." + string.from(self.nstr);
        self.nstr++;
        self.strs[s] = name;

        String obj = name + ".obj";
        int n = string.length(s);
        String layout = `{ i64, i64, [${n} x i8] }`;
        String body = "[" + string.from(n) + " x i8] c\"" + escapeIR(s) + "\"";
        if (n == 0) {
            body = "[0 x i8] zeroinitializer";
        }
        // info holds GC_STATIC, so the collector never marks, sweeps or frees
        // this block. The constant must not be unnamed_addr: the alias below
        // points into the middle of it, and a mergeable literal section resolves
        // an interior symbol to the start of the containing atom, which reads
        // the header bits back as the length.
        array.push(self.globals, obj + " = private constant " + layout + " { i64 "
            + string.from(gcStatic) + ", i64 " + string.from(n) + ", " + body + " }, align 8\n");
        array.push(self.globals, name + " = private alias i64, getelementptr inbounds ("
            + layout + ", ptr " + obj + ", i32 0, i32 1)\n");
        return name;
    }

    // Makes one shared constant for a C string that ends with a NUL.
    String cstr(String s) {
        String? known = self.cstrs[s];
        if (known != null) {
            return known;
        }
        String name = "@cstr." + string.from(self.ncstr);
        self.ncstr++;
        self.cstrs[s] = name;
        array.push(self.globals, name + " = private unnamed_addr constant ["
            + string.from(string.length(s) + 1) + " x i8] c\"" + escapeIR(s) + "\\00\"\n");
        return name;
    }

    // Emits a TD_SLOTS descriptor carrying the field table of rec, for a block
    // of slots that starts at offset 0 (runtime.h). An async frame is the only
    // user: its slot [0] is the resume state, where a record holds its
    // descriptor, so tracing a frame as a record would read the state as a
    // TypeDesc pointer.
    String tdSlotsGlobal(types.Record rec) {
        String key = "slots:" + typeKey(rec);
        String? known = self.tds[key];
        if (known != null) {
            return known;
        }
        String name = "@td." + string.from(self.ntd);
        self.ntd++;
        self.tds[key] = name;    // register before recursing, as tdGlobal does

        String[] tds = [];
        forEach(rec.fields, f) {
            array.push(tds, "ptr " + self.tdGlobal(f.type));
        }
        int n = rec.fields.length;
        // There are no offsets and no size. A frame's slots are 8-byte units at
        // i*8, because §5.7 packs only what a program can name, and the TD_SLOTS
        // walk in gc.c reads them that way.
        if (n == 0) {
            array.push(self.globals, name
                + " = private constant %TD { i64 20, ptr null, i64 0, ptr null, ptr null, i64 0, ptr null, i64 0, ptr null }\n");
            return name;
        }
        String typesG = "@td." + string.from(self.ntd) + ".types";
        self.ntd++;
        array.push(self.globals, typesG + " = private constant [" + string.from(n)
            + " x ptr] [" + string.join(tds, ", ") + "]\n");
        array.push(self.globals, name + " = private constant %TD { i64 20, ptr null, i64 "
            + string.from(n) + ", ptr null, ptr " + typesG + ", i64 0, ptr null, i64 0, ptr null }\n");
        return name;
    }

    // Answers the TypeDesc global for t, and emits it if it does not yet exist.
    String tdGlobal(types.Type t) {
        types.Type c = types.concrete(t);
        types.Basic? b = c as types.Basic;
        if (b != null) {
            // The descriptor carries a width, so `int` and `float` first resolve
            // to the fixed-width type they are on this host.
            switch (b.kind) {
                case types.Kind.INT8:
                    return "@rt_td_int8";
                case types.Kind.INT16:
                    return "@rt_td_int16";
                case types.Kind.INT32:
                    return "@rt_td_int32";
                case types.Kind.UINT8:
                    return "@rt_td_uint8";
                case types.Kind.UINT16:
                    return "@rt_td_uint16";
                case types.Kind.UINT32:
                    return "@rt_td_uint32";
                case types.Kind.UINT64:
                    return "@rt_td_uint";
                case types.Kind.FLOAT32:
                    return "@rt_td_float32";
                case types.Kind.FLOAT64:
                    return "@rt_td_float";
                case types.Kind.STRING:
                    return "@rt_td_string";
                case types.Kind.BOOL:
                    return "@rt_td_bool";
                case types.Kind.DATETIME:
                    return "@rt_td_datetime";
                case types.Kind.DURATION:
                    return "@rt_td_duration";
                case types.Kind.JSON:
                    // One descriptor covers every Json. A node carries its own
                    // kind, so the collector reads the shape from the node
                    // (runtime.h).
                    return "@rt_td_json";
                case types.Kind.REGEXP:
                    // One descriptor covers every RegExp. The block holds no
                    // pointer, so the collector only marks it (§6.14).
                    return "@rt_td_regexp";
                case types.Kind.SOCKET:
                case types.Kind.LISTENER:
                    // A Socket and a Listener are one block, and only the
                    // checker tells them apart (§6.15).
                    return "@rt_td_socket";
                default:
                    return "@rt_td_int";
            }
        }
        types.FuncType? fn = c as types.FuncType;
        if (fn != null) {
            // One descriptor covers every function type, because a closure block
            // describes its own captures (runtime.h).
            return "@rt_td_func";
        }
        types.FutureType? fu = c as types.FutureType;
        if (fu != null) {
            // A future block carries the descriptors of its argument record and
            // of its result, so one static descriptor is enough.
            return "@rt_td_future";
        }

        String key = typeKey(t);
        String? known = self.tds[key];
        if (known != null) {
            return known;
        }
        String name = "@td." + string.from(self.ntd);
        self.ntd++;
        self.tds[key] = name;    // register before recursing (recursive records)

        switch (t) {
            case types.Array at:
                String elem = self.tdGlobal(at.elem);
                array.push(self.globals, name + " = private constant %TD { i64 6, ptr "
                    + elem + ", i64 0, ptr null, ptr null, i64 0, ptr null, i64 0, ptr null }\n");
            case types.Optional ot:
                String inner = self.tdGlobal(ot.inner);
                array.push(self.globals, name + " = private constant %TD { i64 7, ptr "
                    + inner + ", i64 0, ptr null, ptr null, i64 0, ptr null, i64 0, ptr null }\n");
            case types.MapType mt:
                // TD_MAP (16). The types slot holds the key descriptor and then
                // the value descriptor (runtime.h). The elem and name slots are
                // unused.
                String kvG = "@td." + string.from(self.ntd) + ".kv";
                self.ntd++;
                String keyTD = self.tdGlobal(mt.key);
                String valTD = self.tdGlobal(mt.value);
                array.push(self.globals, kvG + " = private constant [2 x ptr] [ptr "
                    + keyTD + ", ptr " + valTD + "]\n");
                array.push(self.globals, name + " = private constant %TD { i64 16, ptr null, i64 2, ptr null, ptr "
                    + kvG + ", i64 0, ptr null, i64 0, ptr null }\n");
            case types.Record rec:
                if (checker.isUnion(rec)) {
                    // TD_UNION (26) is the base of a `union` declaration (§2.11).
                    // The member tags go in the name table and their record
                    // descriptors in the type table, which lib/json.c reads to
                    // choose a member by the kind of a value. The descriptor is
                    // registered above before the members are emitted, because
                    // each member's uni slot points back here.
                    String[] mtags = [];
                    String[] mtds = [];
                    forEach(rec.extenders, arm) {
                        if (checker.unionTag(arm) == "") {
                            continue;
                        }
                        array.push(mtags, "ptr " + self.cstr(checker.unionTag(arm)));
                        array.push(mtds, "ptr " + self.tdGlobal(arm));
                    }
                    int mn = mtags.length;
                    String tagsG = "@td." + string.from(self.ntd) + ".names";
                    String memsG = "@td." + string.from(self.ntd) + ".types";
                    self.ntd++;
                    array.push(self.globals, tagsG + " = private constant [" + string.from(mn)
                        + " x ptr] [" + string.join(mtags, ", ") + "]\n");
                    array.push(self.globals, memsG + " = private constant [" + string.from(mn)
                        + " x ptr] [" + string.join(mtds, ", ") + "]\n");
                    array.push(self.globals, name + " = private constant %TD { i64 26, ptr null, i64 "
                        + string.from(mn) + ", ptr " + tagsG + ", ptr " + memsG
                        + ", i64 0, ptr null, i64 0, ptr null }\n");
                    return name;
                }
                // Only lib/json.c reads the name table, so it carries the JSON
                // key of each field: the declared name, or the one a
                // `'json:...'` annotation gave it.
                String[] names = [];
                String[] rtds = [];
                String[] offs = [];
                forEach(rec.fields, f, fi) {
                    array.push(names, "ptr " + self.cstr(f.jsonKey()));
                    array.push(rtds, "ptr " + self.tdGlobal(f.type));
                    array.push(offs, `i64 ${recOffset(rec, fi)}`);
                }
                int rn = rec.fields.length;
                // A union member's descriptor names its union (runtime.h), which
                // makes the JSON writer serialize the member as its payload
                // alone.
                String uni = "null";
                types.Record? ub = rec.base;
                if (ub != null && checker.unionTag(rec) != "") {
                    uni = self.tdGlobal(ub);
                }
                // The index of the catch-all field, plus one, so 0 means "none"
                // (runtime.h). lib/json.c reads it to find the field that
                // collects undeclared keys.
                int rest = rec.restField() + 1;
                String namesG = "@td." + string.from(self.ntd) + ".names";
                String typesG = "@td." + string.from(self.ntd) + ".types";
                String offsG = "@td." + string.from(self.ntd) + ".offs";
                self.ntd++;
                if (rn == 0) {
                    array.push(self.globals, name
                        + " = private constant %TD { i64 8, ptr null, i64 0, ptr null, ptr null, i64 "
                        + string.from(rest) + ", ptr null, i64 " + string.from(recSizeOf(rec))
                        + ", ptr " + uni + " }\n");
                } else {
                    array.push(self.globals, namesG + " = private constant [" + string.from(rn)
                        + " x ptr] [" + string.join(names, ", ") + "]\n");
                    array.push(self.globals, typesG + " = private constant [" + string.from(rn)
                        + " x ptr] [" + string.join(rtds, ", ") + "]\n");
                    // The field offsets and the block size (§5.7), which carry
                    // the same fold recOffset emits to every C file that walks a
                    // record without knowing its type.
                    array.push(self.globals, offsG + " = private constant [" + string.from(rn)
                        + " x i64] [" + string.join(offs, ", ") + "]\n");
                    array.push(self.globals, name + " = private constant %TD { i64 8, ptr null, i64 "
                        + string.from(rn) + ", ptr " + namesG + ", ptr " + typesG + ", i64 "
                        + string.from(rest) + ", ptr " + offsG + ", i64 "
                        + string.from(recSizeOf(rec)) + ", ptr " + uni + " }\n");
                }
            case types.Enum en:
                // TD_ENUM (12). The names slot holds the member names and the
                // types slot an [n x i64] of their values (runtime.h). print
                // walks them to show the name of a member.
                String[] enames = [];
                String[] vals = [];
                forEach(en.members, m) {
                    array.push(enames, "ptr " + self.cstr(m.name));
                    array.push(vals, `i64 ${m.value}`);
                }
                int nn = en.members.length;
                String enamesG = "@td." + string.from(self.ntd) + ".names";
                String valsG = "@td." + string.from(self.ntd) + ".values";
                self.ntd++;
                if (nn == 0) {
                    array.push(self.globals, name
                        + " = private constant %TD { i64 12, ptr null, i64 0, ptr null, ptr null, i64 0, ptr null, i64 0, ptr null }\n");
                } else {
                    array.push(self.globals, enamesG + " = private constant [" + string.from(nn)
                        + " x ptr] [" + string.join(enames, ", ") + "]\n");
                    array.push(self.globals, valsG + " = private constant [" + string.from(nn)
                        + " x i64] [" + string.join(vals, ", ") + "]\n");
                    array.push(self.globals, name + " = private constant %TD { i64 12, ptr null, i64 "
                        + string.from(nn) + ", ptr " + enamesG + ", ptr " + valsG + ", i64 0, ptr null, i64 0, ptr null }\n");
                }
            default:
                break;    // the scalar kinds answered above
        }
        return name;
    }

    // ---- json ----

    // Emits the functions of the built-in json module. Four are fallible,
    // because a document decides its own shape: asking for the number of a key
    // that holds a string is a failure a caller can act on. They use the
    // out-parameter convention of genFSCall.
    String genJSONCall(ast.CallExpression ex, String fn) {
        if (fn == "toText") {
            types.Type at = self.typeOf(ex.args[0]);
            String raw = self.toRaw(self.genExpr(ex.args[0]), llty(at));
            String v = self.newTmp();
            self.emit("%s = call ptr @rt_json_totext(i64 %s, ptr %s)", v, raw, self.tdGlobal(at));
            return v;
        }
        if (fn == "parse") {
            // Only a bare parse reaches this point. `as T` is an AsExpression.
            String text = self.genExpr(ex.args[0]);
            String sym = "rt_json_parse_value";
            if (self.parseArgIsBytes(ex.args[0])) {
                sym = "rt_json_parse_value_b";
            }
            String errSlot = self.rootSlot(types.ErrorT);
            self.emit("store ptr null, ptr %s", errSlot);
            String v = self.newTmp();
            self.emit("%s = call ptr @%s(ptr %s, ptr %s)", v, sym, text, errSlot);
            self.raiseFromSlot(errSlot, "json");
            return self.protect(v, types.JsonT);
        }
        if (fn == "getType" || fn == "length") {
            String sym = "rt_json_kind";
            if (fn == "length") {
                sym = "rt_json_length";
            }
            String v = self.newTmp();
            self.emit("%s = call i64 @%s(ptr %s)", v, sym, self.genExpr(ex.args[0]));
            return v;
        }
        if (fn == "keys") {
            String v = self.newTmp();
            self.emit("%s = call ptr @rt_json_keys(ptr %s)", v, self.genExpr(ex.args[0]));
            return self.protect(v, types.newArray(types.StringT));
        }
        if (fn == "remove") {
            String node = self.genExpr(ex.args[0]);
            self.protect(node, types.JsonT);
            String key = self.genExpr(ex.args[1]);
            self.emit("call void @rt_json_remove(ptr %s, ptr %s)", node, key);
            return "";
        }
        if (fn == "push") {
            String node = self.genExpr(ex.args[0]);
            self.protect(node, types.JsonT);
            String val = self.protect(self.genJSONNode(ex.args[1]), types.JsonT);
            self.emit("call void @rt_json_push(ptr %s, ptr %s)", node, val);
            return "";
        }
        // asInt, asFloat, asText, asBool
        String node = self.genExpr(ex.args[0]);
        self.protect(node, types.JsonT);
        String errSlot = self.rootSlot(types.ErrorT);
        self.emit("store ptr null, ptr %s", errSlot);
        String v = self.newTmp();
        if (fn == "asFloat") {
            self.emit("%s = call double @rt_json_as_float(ptr %s, ptr %s)", v, node, errSlot);
        } else if (fn == "asText") {
            self.emit("%s = call ptr @rt_json_as_text(ptr %s, ptr %s)", v, node, errSlot);
        } else if (fn == "asBool") {
            self.emit("%s = call i64 @rt_json_as_bool(ptr %s, ptr %s)", v, node, errSlot);
        } else {
            self.emit("%s = call i64 @rt_json_as_int(ptr %s, ptr %s)", v, node, errSlot);
        }
        self.raiseFromSlot(errSlot, "json");
        if (fn == "asText") {
            return self.protect(v, types.StringT);
        }
        return v;
    }

    // Emits a read of `doc[k]` (§6.3). A String key reaches into an object and
    // an int into an array. The result is a node, and it is MISSING when there
    // is nothing there, so a chain needs no guard at each link.
    String genJSONIndex(ast.IndexExpression ex) {
        String node = self.genExpr(ex.left);
        self.protect(node, types.JsonT);
        String idx = self.genExpr(ex.index);
        String v = self.newTmp();
        if (types.equal(types.unwrap(self.typeOf(ex.index)), types.StringT)) {
            self.emit("%s = call ptr @rt_json_get(ptr %s, ptr %s)", v, node, idx);
        } else {
            self.emit("%s = call ptr @rt_json_at(ptr %s, i64 %s)", v, node, idx);
        }
        // A read aliases into the tree (§6.3). Nothing allocated, and the tree
        // the caller holds already reaches the node.
        return v;
    }

    // Emits `doc[k] = v`. The store makes a deep copy (§6.3), so afterwards the
    // document and the assigned value change apart.
    void genJSONIndexAssign(ast.IndexExpression target, ast.Expression valExpr) {
        String node = self.genExpr(target.left);
        self.protect(node, types.JsonT);
        String idx = self.genExpr(target.index);
        bool isKey = types.equal(types.unwrap(self.typeOf(target.index)), types.StringT);
        if (isKey) {
            self.protect(idx, types.StringT);
        }

        String val = self.protect(self.genJSONNode(valExpr), types.JsonT);

        if (isKey) {
            self.emit("call void @rt_json_set(ptr %s, ptr %s, ptr %s)", node, idx, val);
        } else {
            self.emit("call void @rt_json_set_at(ptr %s, i64 %s, ptr %s)", node, idx, val);
        }
    }

    // Evaluates a value that goes into a document and answers the node to store.
    // A value with a JSON form converts through rt_json_of, and a Json passes
    // through.
    String genJSONNode(ast.Expression ex) {
        types.Type t = self.typeOf(ex);
        if (types.equal(t, types.JsonT)) {
            return self.genExpr(ex);
        }
        if (types.equal(t, types.NullT)) {
            // `doc[k] = null` is JSON null: the key is present and holds
            // nothing, which differs from json.remove.
            self.genExpr(ex);    // for its side effects
            String v = self.newTmp();
            self.emit("%s = call ptr @rt_json_of(i64 0, ptr @rt_td_json)", v);
            return v;
        }
        String raw = self.toRaw(self.genExpr(ex), llty(t));
        String v = self.newTmp();
        self.emit("%s = call ptr @rt_json_of(i64 %s, ptr %s)", v, raw, self.tdGlobal(t));
        return v;
    }

    // ---- errors (§2.9) ----
    //
    // A fallible function returns a pair: its result, and an Error pointer that
    // is null on success. There is no unwinding and there are no landing pads,
    // so propagation is a compare and a return at each call and an error crosses
    // an async suspension or a GC frame with no work from either. An Error is an
    // ordinary record of two slots.

    // Sends a non-null err where an error raised at this point belongs, and ends
    // the block. It tries the innermost destination first: a guarding catch,
    // then the caller of a fallible function, then rt_error_abort.
    void emitRaise(String err) {
        ErrCtx? dest = self.errDest;
        if (dest != null) {
            self.emit("store ptr %s, ptr %s", err, dest.slot);
            self.terminate("br label %%%s", dest.label);
            return;
        }
        if (self.fnFallible) {
            self.emitErrorReturn(err);
            return;
        }
        self.emit("call void @rt_error_abort(ptr %s)", err);
        self.terminate("unreachable");
    }

    // Returns err from the fallible function under generation and leaves the
    // result half of the pair at zero.
    void emitErrorReturn(String err) {
        if (self.inAsync) {
            // A step function reports through frame slot [3], and the scheduler
            // moves the error into the future.
            String slot = self.newTmp();
            self.emit("%s = getelementptr i8, ptr %%frame, i64 %s", slot, string.from(asyncErrOffset));
            self.emit("store ptr %s, ptr %s", err, slot);
            self.terminate("ret i64 0");
            return;
        }
        self.gcPop();
        if (types.equal(self.fnRet, types.VoidT)) {
            self.terminate("ret ptr %s", err);
            return;
        }
        String agg = self.newTmp();
        self.emit("%s = insertvalue {%s, ptr} zeroinitializer, ptr %s, 1", agg, llty(self.fnRet), err);
        self.terminate("ret {%s, ptr} %s", llty(self.fnRet), agg);
    }

    // Returns v from the function under generation, with a null error when the
    // function is fallible.
    void emitValueReturn(String v) {
        if (types.equal(self.fnRet, types.VoidT)) {
            if (self.fnFallible) {
                self.terminate("ret ptr null");
            } else {
                self.terminate("ret void");
            }
            return;
        }
        if (!self.fnFallible) {
            self.terminate("ret %s %s", llty(self.fnRet), v);
            return;
        }
        String agg = self.newTmp();
        self.emit("%s = insertvalue {%s, ptr} zeroinitializer, %s %s, 0",
            agg, llty(self.fnRet), llty(self.fnRet), v);
        self.terminate("ret {%s, ptr} %s", llty(self.fnRet), agg);
    }

    // Reads what a fallible call returned, branches to the place where an error
    // goes, and continues in a new block with the result value.
    String splitResult(String res, types.Type ret) {
        String err = "";
        String val = "";
        if (types.equal(ret, types.VoidT)) {
            err = res;
        } else {
            err = self.newTmp();
            self.emit("%s = extractvalue {%s, ptr} %s, 1", err, llty(ret), res);
            val = self.newTmp();
            self.emit("%s = extractvalue {%s, ptr} %s, 0", val, llty(ret), res);
        }
        String isErr = self.newTmp();
        String errL = self.newLabel("raise");
        String okL = self.newLabel("noraise");
        self.emit("%s = icmp ne ptr %s, null", isErr, err);
        self.terminate("br i1 %s, label %%%s, label %%%s", isErr, errL, okL);
        self.startBlock(errL);
        self.emitRaise(err);
        self.startBlock(okL);
        return val;
    }

    // Raises again the error a fallible async body left in its future. It is,
    // for an await, the branch splitResult emits after a direct call.
    void raiseFutureError(String fu) {
        // rt_future_error rather than a read of the field: taking the error
        // marks it observed, so rt_async_drain can report one that no await
        // collected instead of losing it.
        String err = self.newTmp();
        self.emit("%s = call ptr @rt_future_error(ptr %s)", err, fu);
        String isErr = self.newTmp();
        String errL = self.newLabel("aw.raise");
        String okL = self.newLabel("aw.noraise");
        self.emit("%s = icmp ne ptr %s, null", isErr, err);
        self.terminate("br i1 %s, label %%%s, label %%%s", isErr, errL, okL);
        self.startBlock(errL);
        self.emitRaise(err);
        self.startBlock(okL);
    }

    // Builds `Error("message")` and `Error("message", code)`, a record of two
    // slots. rt_alloc clears the block, so the one-argument form leaves the code
    // at 0 and stores nothing.
    String genErrorNew(ast.CallExpression ex) {
        String msg = self.genExpr(ex.args[0]);
        self.protect(msg, types.StringT);
        String code = "";
        if (ex.args.length == 2) {
            code = self.genExpr(ex.args[1]);
        }
        String r = self.newTmp();
        self.emit("%s = call ptr @rt_alloc(i64 %s)", r, string.from(recSizeOf(types.ErrorT)));
        self.emit("store ptr %s, ptr %s", self.tdGlobal(types.ErrorT), r);    // see genRecordLiteral
        String mslot = self.newTmp();
        self.emit("%s = getelementptr i8, ptr %s, i64 %s", mslot, r, string.from(recOffset(types.ErrorT, 0)));
        self.emit("store ptr %s, ptr %s", msg, mslot);
        if (code != "") {
            String slot = self.newTmp();
            self.emit("%s = getelementptr i8, ptr %s, i64 %s", slot, r, string.from(recOffset(types.ErrorT, 1)));
            self.emit("store i64 %s, ptr %s", code, slot);
        }
        return r;
    }

    // Emits `value catch ...`. The guarded expression runs with every raise in
    // it sent to the landing block of this catch, and the two paths meet at a
    // join block.
    String genCatch(ast.CatchExpr ex) {
        checker.CatchInfo? cip = self.info.catches[ex.id];
        if (cip == null) {
            unreachable("a catch expression the checker did not record");
            return "";
        }
        checker.CatchInfo ci = cip;
        String catchL = self.newLabel("catch");
        String doneL = self.newLabel("catch.done");
        String errSlot = self.rootSlot(types.ErrorT);

        // A catch at statement position, or over a void call, has no value to
        // carry across the join.
        bool needValue = !ci.discard && !types.equal(ci.result, types.VoidT);
        String res = "";
        if (needValue) {
            res = self.alloca(ci.result);
        }

        ErrCtx? saved = self.errDest;
        ErrCtx dest = { label: catchL, slot: errSlot };
        self.errDest = dest;
        String v = self.genConverted(ex.value, ci.result);
        // The handler runs outside the guarded expression, so an error raised in
        // it goes where the errors of this whole expression go.
        self.errDest = saved;
        if (needValue) {
            self.emit("store %s %s, ptr %s", llty(ci.result), v, res);
        }
        if (!self.terminated) {
            self.terminate("br label %%%s", doneL);
        }

        self.startBlock(catchL);
        ast.Expression? def = ex.default;
        if (def != null) {
            String d = self.genConverted(def, ci.result);
            if (needValue) {
                self.emit("store %s %s, ptr %s", llty(ci.result), d, res);
            }
        } else {
            self.genCatchBlock(ex, errSlot);
            // nullFill is the checker's verdict that this block can fall through
            // into an optional target, which a failure leaves null. An open
            // block does not prove it: a handler ending in a break or a continue
            // leaves codegen in a block nothing reaches.
            if (ci.nullFill && !self.terminated) {
                self.emit("store %s null, ptr %s", llty(ci.result), res);
            }
        }
        if (!self.terminated) {
            self.terminate("br label %%%s", doneL);
        }

        self.startBlock(doneL);
        if (!needValue) {
            return "";
        }
        String out = self.newTmp();
        self.emit("%s = load %s, ptr %s", out, llty(ci.result), res);
        return out;
    }

    // Binds the Error to the name of the catch and runs the handler.
    void genCatchBlock(ast.CatchExpr ex, String errSlot) {
        self.syms = newSymtab(self.syms);
        String err = self.newTmp();
        self.emit("%s = load ptr, ptr %s", err, errSlot);
        if (marked(self.info.boxedCatches, ex.id)) {
            // A function value captures it, so the binding lives in a heap box
            // that the closures share with this frame.
            String b = self.box(err, types.ErrorT);
            String slot = self.boxedSlot(types.ErrorT);
            self.emit("store ptr %s, ptr %s", b, slot);
            self.syms.m[ex.name] = newSym(slot, types.ErrorT, true);
            self.dbgLocal(ex.name, slot, types.ErrorT, ex.nameTok.line, 0, true);
        } else {
            String slot = self.alloca(types.ErrorT);
            self.emit("store ptr %s, ptr %s", err, slot);
            self.syms.m[ex.name] = newSym(slot, types.ErrorT, false);
            self.dbgLocal(ex.name, slot, types.ErrorT, ex.nameTok.line, 0, false);
        }
        ast.BlockStatement? body = ex.body;
        if (body != null) {
            forEach(body.statements, s) {
                self.genStatement(s, false);
            }
        }
        Symtab? outer = self.syms.outer;
        if (outer != null) {
            self.syms = outer;
        }
    }

    // ---- statement coverage ----
    //
    // The unit is the basic block: a run of statements with no branch between
    // them executes together, so it gets one counter, and every source line in
    // the run reports that counter.
    //
    // Where a block ends is read off the IR, not the AST: covHit opens a new
    // counter whenever the LLVM block it emits into is not the one the open
    // counter started in. This includes an await's suspension point and a
    // fallible call's raise branch, which §2.9 makes ordinary control flow.
    //
    // A module with no path is not instrumented, which is the standard library
    // written in Nio (§6.13).

    // Records that statement s belongs to the basic block under emission, and
    // opens a counter for that block at its first counted statement. The caller
    // calls it before the code of the statement, so a statement that panics or
    // raises still counts as reached.
    void covHit(ast.Statement s) {
        Coverage? cov = self.cov;
        if (cov == null || !covCounted(s)) {
            return;
        }
        module.Module? m = self.modules[self.qual];
        if (m == null || m.path == "") {
            return;
        }
        if (self.covBlk < 0 || self.covLL != self.block) {
            self.covBlk = cov.nblocks;
            cov.nblocks++;
            self.covLL = self.block;
            // The getelementptr is on i64 and not on the array type, because the
            // length of the array is not yet known. The scheduler is cooperative
            // and runs in one thread (§5.2), so the increment needs no atomic.
            String p = self.newTmp();
            String v = self.newTmp();
            String n = self.newTmp();
            self.emit("%s = getelementptr i64, ptr @nio.cov.counts, i64 %s", p, string.from(self.covBlk));
            self.emit("%s = load i64, ptr %s, align 8", v, p);
            self.emit("%s = add i64 %s, 1", n, v);
            self.emit("store i64 %s, ptr %s, align 8", n, p);
        }
        cov.addLine(m.path, s.tok.line, self.covBlk);
    }

    // Writes the counter array, the line table and the setup function. The
    // element type of the table is written in place, so no named type needs a
    // declaration first.
    void emitCoverage() {
        Coverage? covOpt = self.cov;
        if (covOpt == null) {
            return;
        }
        Coverage cov = covOpt;
        String args = "ptr null, ptr null, i64 0";
        int n = cov.lines.length;
        if (n > 0) {
            String[] names = [];
            forEach(cov.files, f) {
                array.push(names, self.cstr(f));
            }
            String[] entries = [];
            forEach(cov.lines, l) {
                array.push(entries, "{ ptr, i64, i64 } { ptr " + names[l.file] + ", i64 "
                    + string.from(l.line) + ", i64 " + string.from(l.block) + " }");
            }
            array.push(self.globals, "@nio.cov.counts = private global [" + string.from(cov.nblocks)
                + " x i64] zeroinitializer, align 8\n");
            array.push(self.globals, "@nio.cov.lines = private constant [" + string.from(n)
                + " x { ptr, i64, i64 }] [" + string.join(entries, ", ") + "]\n");
            args = `ptr @nio.cov.counts, ptr @nio.cov.lines, i64 ${n}`;
        }
        array.push(self.globals, "declare void @rt_cov_init(ptr, ptr, i64)\n");
        array.push(self.code, "\ndefine internal void " + covSetupSym + "()" + self.attrRef
            + " {\nstart:\n  call void @rt_cov_init(" + args + ")\n  ret void\n}\n");
    }
}

Gen newGen() {
    Symtab base = newSymtab(null);
    Gen g = {
        info: checker.newInfo(), qual: "", globals: [], code: [], attrRef: "",
        body: [], popSlots: [], allocas: [], rootTypes: [], tmp: 0, lbl: 0, block: "",
        terminated: false, fnRet: types.VoidT, fnName: "", fnFallible: false, errDest: null,
        inAsync: false, frameTypes: [], resumes: [], loops: [],
        syms: base, modSyms: {}, modules: {}, baseSyms: base,
        strs: {}, cstrs: {}, tds: {}, externDecls: {},
        nstr: 0, ncstr: 0, ntd: 0, nlocal: 0, nfrm: 0, nlam: 0,
        gcGlobals: [], cov: null, covBlk: -1, covLL: "",
        dbg: null, dbgSub: "", dbgLoc: "", dbgFnLine: 1, dbgFnLoc: "",
    };
    return g;
}

// What a command line asks of a build. It is one record and not one flag per
// parameter. Thus a new option is a field here and not a change to each
// signature between the CLI and this module, and two options of the same type
// cannot be passed in the wrong order. coverage and debug are for code
// generation. release is for the driver, and the driver finds targetAttrs.
// Both are here because they travel the same route.
export type Options {
    // coverage adds statement coverage instrumentation. When it is off, no
    // instrumentation is emitted.
    bool coverage;
    // debug adds DWARF debug information, under the same rule.
    bool debug;
    // release asks clang for the optimized whole-program build: -O2 with
    // -flto, which is what lets it inline the runtime into generated code.
    // When it is off, the build is -O0 with no LTO. That is the default unless
    // --release is given (§1.2). The IR is the same in both modes, and only
    // the driver reads this field.
    bool release;
    // targetAttrs is the "target-cpu"/"target-features" string clang stamps on
    // the runtime's C functions on this host, or "" when it is unknown.
    // Generated functions must carry the same string. The LLVM inliner refuses
    // a callee whose target features are not a subset of those of the caller.
    // A mismatch stops the inlining of each runtime helper without a warning,
    // which costs about 3.5x on array-heavy loops. It is not a flag (the
    // driver asks clang for it), but it travels the same route.
    String targetAttrs;
}

// Code generation asked for nothing: no instrumentation, no debug information,
// no host attributes, and the edit loop's build. What a caller that only wants
// IR passes.
export Options noOptions() {
    return { coverage: false, debug: false, release: false, targetAttrs: "" };
}

// Produces one LLVM IR module for a checked program. mods is in dependency
// order, with the entry module last.
export String generate(module.Module[] mods, Options opts) {
    Gen g = newGen();
    if (opts.targetAttrs != "") {
        g.attrRef = " #0";
    }
    if (opts.coverage) {
        g.cov = newCoverage();
    }

    forEach(mods, m) {
        g.modules[m.qual] = m;
    }
    if (opts.debug) {
        g.dbg = newDbg(mods);
        array.push(g.globals, "declare void @llvm.dbg.declare(metadata, metadata, metadata)\n");
    }
    // Rewrite every async body first, so each await sits at statement level.
    forEach(mods, m) {
        normalize.normalizeAsync(m, g.modules);
    }

    forEach(mods, m) {
        Symtab tab = newSymtab(null);
        g.modSyms[m.qual] = tab;
        forEach(m.prog.statements, s) {
            ast.VarDeclStatement? vd = s as ast.VarDeclStatement;
            if (vd == null) {
                continue;
            }
            types.Type t = types.InvalidT;
            types.Type? dt = m.info.declTypes[vd.id];
            if (dt != null) {
                t = dt;
            }
            String name = gvSym(m.qual, vd.name);
            tab.m[vd.name] = newSym(name, t, false);
            array.push(g.globals, name + " = global " + llty(t) + " " + zeroConst(t)
                + g.dbgGlobal(vd.name, m.qual, t, vd.tok.line) + "\n");
            if (isRef(t)) {
                GcGlobal gg = { sym: name, t: t };
                array.push(g.gcGlobals, gg);
            }
        }
    }
    g.emitGCGlobals();

    forEach(mods, m) {
        g.setModule(m);
        forEach(m.prog.statements, s) {
            ast.FunctionDeclStatement? fd = s as ast.FunctionDeclStatement;
            if (fd != null) {
                g.genFunction(fd);
                continue;
            }
            ast.TypeDeclStatement? td = s as ast.TypeDeclStatement;
            if (td != null) {
                g.genMethods(td);
            }
        }
    }

    // An imported module gets an init function for its top-level code. The
    // top-level code of the entry module is the body of main, after those inits.
    module.Module[] deps = array.slice(mods, 0, mods.length - 1);
    module.Module entry = mods[mods.length - 1];
    forEach(deps, m) {
        g.setModule(m);
        g.genModuleInit(m);
    }
    g.setModule(entry);
    g.genMain(deps, entry);
    // This comes last, when every counter that the program needs exists.
    g.emitCoverage();

    // One array and one join, and no chain of `+`. A chain of n pieces builds
    // n-1 intermediate strings and copies the full prefix into each one. On the
    // source of this compiler, a chain copied 34 MB for 7.4 MB of text.
    String[] parts = [header()];
    forEach(g.globals, s) {
        array.push(parts, s);
    }
    array.push(parts, "\n");
    forEach(g.code, s) {
        array.push(parts, s);
    }
    if (opts.targetAttrs != "") {
        array.push(parts, "\nattributes #0 = { ");
        array.push(parts, opts.targetAttrs);
        array.push(parts, " }\n");
    }
    Dbg? d = g.dbg;
    if (d != null) {
        d.finish();
        array.push(parts, "\n!llvm.dbg.cu = !{" + d.cu + "}\n");
        array.push(parts, "!llvm.module.flags = !{" + d.flags + "}\n");
        forEach(d.nodes, n) {
            array.push(parts, n);
        }
    }
    return string.join(parts, "");
}

// Opens the metadata of a program: the compile unit, the module flags that make
// a consumer keep it, and the signature type that all DISubprograms share.
//
// The file of the unit is that of the entry module, which generate puts last.
// A Nio module is not a translation unit here, because the full program is one
// LLVM module. Each function names its own DIFile and they share the unit, as
// the bodies of an included header do in C.
Dbg newDbg(module.Module[] mods) {
    Dbg d = {
        nodes: [], files: {}, locs: {}, types: {}, cu: "", cuIndex: 0, cuBody: "",
        cuGlobals: [], subType: "", flags: "",
    };
    module.Module? entry = entryOf(mods);
    String entryQual = "";
    if (entry != null) {
        entryQual = entry.qual;
    }
    String entryFile = d.add("!DIFile(" + dbgFileFields(entry, entryQual) + ")");
    // The unit's file is the entry module's own, so dbgFile finds it here
    // rather than making a second node for the same file.
    d.files[entryQual] = entryFile;
    // DW_LANG_C99, because DWARF has no number for this language and a consumer
    // has to read an expression in some syntax. The IR does not depend on the
    // build mode, so isOptimized is always true, which is correct for --release.
    d.cuBody = "distinct !DICompileUnit(language: DW_LANG_C99, file: " + entryFile
        + ", producer: " + mdStr("nio")
        + ", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug, splitDebugInlining: false";
    d.cuIndex = d.nodes.length;
    d.cu = d.add(d.cuBody + ")");
    String none = d.add("!{null}");
    d.subType = d.add("!DISubroutineType(types: " + none + ")");
    // Version 3 is the only debug-info format LLVM reads. LLVM drops the
    // metadata of a module without this flag and gives no diagnostic. The
    // Dwarf Version flag merges by taking the larger value, so it cannot
    // conflict with what clang stamps on the C of the runtime.
    String f1 = d.add("!{i32 2, !" + mdStr("Debug Info Version") + ", i32 3}");
    String f2 = d.add("!{i32 7, !" + mdStr("Dwarf Version") + ", i32 4}");
    d.flags = f1 + ", " + f2;
    return d;
}

// The entry module, which is the last one in dependency order.
module.Module? entryOf(module.Module[] mods) {
    if (mods.length == 0) {
        return null;
    }
    return mods[mods.length - 1];
}
