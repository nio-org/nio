test.start("lang: string substring", void () -> {
    h.expectOutput(`
import 'string';

String s = "hello world";
print(string.substring(s, 6, 11));            // a middle slice
print(string.substring(s, 0, 5));             // a prefix
print(string.substring(s, 0, 11));            // the whole string
print(string.length(string.substring(s, 3, 3)));   // empty, start == end
print(string.length(string.substring("", 0, 0)));  // empty input
print(string.substring("héllo", 1, 3));       // bytes, not characters: é is two
`, [
        "world", "hello", "hello world", "0", "0", "é",
    ]);
});

test.start("lang: string to int and to float", void () -> {
    h.expectOutput(`
import 'string';

print(string.toInt("42"));
print(string.toInt("+42"));
print(string.toInt("-42"));
print(string.toInt("0042"));                       // leading zeros are fine
print(string.toInt("9223372036854775807"));        // the widest int
print(string.toInt("-9223372036854775808"));       // and the narrowest
print(string.toInt("abc") catch -1);               // not a number: caught
print(string.toInt("12x") catch -1);               // trailing junk too
print(string.toInt(" 12") catch -1);               // no implicit trim
print(string.toInt("") catch -1);
print(string.toInt("9223372036854775808") catch -2);   // one past the top
print(string.toInt("-9223372036854775809") catch -2);  // one past the bottom

print(string.toFloat("3.14"));
print(string.toFloat("3"));                        // a whole number is a float too
print(string.toFloat("-0.5"));
print(string.toFloat(".5"));                       // a bare fraction
print(string.toFloat("2.5e2"));                    // exponents
print(string.toFloat("1e-3"));
print(string.toFloat("x") catch -1.0);
print(string.toFloat("1.2.3") catch -1.0);
print(string.toFloat("1e") catch -1.0);            // an exponent needs digits
print(string.toFloat("1e999") catch -2.0);         // too large for a double

string.toInt("bad") catch e {
    print(e.message);                              // the fs message shape
}
string.toFloat("1e999") catch e {
    print(e.message);
}
`, [
        "42", "42", "-42", "42", "9223372036854775807", "-9223372036854775808", "-1",
        "-1", "-1", "-1", "-2", "-2", "3.14", "3", "-0.5", "0.5", "250", "0.001",
        "-1", "-1", "-1", "-2", "string.toInt \"bad\": not an integer",
        "string.toFloat \"1e999\": out of range",
    ]);
});

// toInt cannot replace toUint (§6.6). An int does not assign to a uint, and no
// int holds the top half of the uint64 range.
test.start("lang: string to uint", void () -> {
    h.expectOutput(`
import 'string';

print(string.toUint("42"));
print(string.toUint("+42"));
print(string.toUint("0"));
print(string.toUint("0042"));                          // leading zeros are fine
print(string.toUint("18446744073709551615"));          // the widest uint64
print(getType(string.toUint("1") catch 0));            // and it is a uint

// A bare default takes its type from the call, so catch 0 is a uint here.
print(string.toUint("abc") catch 0);
print(string.toUint("12x") catch 0);                   // trailing junk
print(string.toUint(" 12") catch 0);                   // no implicit trim
print(string.toUint("") catch 0);
print(string.toUint("-") catch 0);                     // a sign is not a number
print(string.toUint("18446744073709551616") catch 1);  // one past the top

// A negative is the case toInt does not have: well formed, and simply not a
// value this type holds.
string.toUint("-1") catch e {
    print(e.message, e.code == string.ErrorCode.INVALID);
}
string.toUint("-x") catch e {
    print(e.message);                                  // shape wins over range
}

// It reaches the sized unsigned types through the ordinary assignment rules.
uint8 small = 0;
uint32 mid = 0;
small = 255;
mid = 4294967295;
print(small, mid);
`, [
        "42", "42", "0", "42", "18446744073709551615", "uint", "0", "0", "0", "0",
        "0", "1", "string.toUint \"-1\": out of range true",
        "string.toUint \"-x\": not an integer", "255 4294967295",
    ]);
});

// A catch default with no declared type takes the type of the guarded
// expression. As an int literal, catch 0 would not assign to a uint, a
// Duration or a narrow result.
test.start("lang: catch default takes the calls type", void () -> {
    h.expectOutput(`
import 'string';
import 'time';

uint count(String s) { return string.toUint(s); }
Duration wait(String s) {
    if (string.length(s) == 0) { return Error("empty"); }
    return time.duration(s);
}
int8 tiny(String s) {
    if (string.length(s) == 0) { return Error("empty"); }
    return 1;
}

print(getType(count("x") catch 0));
print(getType(wait("") catch 0));
print(getType(tiny("") catch 0));
print(time.milliseconds(wait("") catch 2000));

// A declared type still decides when there is one, which is what makes a
// null default under a declared optional type work, and what lets a narrow
// result answer with the wider type it was assigned to.
uint wide = count("7") catch 0;
print(wide, getType(wide));
int fromNarrow = tiny("") catch 0;
print(fromNarrow, getType(fromNarrow));
uint? maybe = count("x") catch null;
print(maybe);
`, [
        "uint", "Duration", "int8", "2000", "7 uint", "0 int", "null",
    ]);
});

// string.from returns the text that print writes, so the two must agree. Each
// case prints twice, so each expected line repeats.
test.start("lang: string from", void () -> {
    h.expectOutput(`
import 'string';
import 'time';

enum Status { OK: 200, NOT_FOUND: 404 }

int n = -42;
print(n);
print(string.from(n));

float f = 0.1;
print(f);
print(string.from(f));

// A float32 keeps the digits of its own width, which is the whole reason the
// descriptor travels with the value instead of the parameter naming a type:
// widening to float first would print the double's digits.
float32 narrow = 0.1;
print(narrow);
print(string.from(narrow));

print(true);
print(string.from(true));
print(string.from("already text"));
print(string.from(Status.NOT_FOUND));

DateTime moment = time.date.fromText("2026-07-28T09:31:04Z");
print(moment);
print(string.from(moment));

Duration d = 1500;
print(d);
print(string.from(d));

// An optional formats as print writes it: the value when present, "null"
// when not.
int? present = 7;
int? absent = null;
print(string.from(present));
print(string.from(absent));

// The round trip the parsers make: text out, the same value back.
print((string.toFloat(string.from(f)) catch -1.0) == f);
print((string.toInt(string.from(n)) catch -1) == n);
print((string.toFloat(string.from(1.0 / 3.0)) catch -1.0) == 1.0 / 3.0);

// The result is an ordinary string, so it concatenates and measures.
print("n = " + string.from(n) + "!");
print(string.length(string.from(1000)));
`, [
        "-42", "-42", "0.1", "0.1", "0.1", "0.1", "true", "true", "already text",
        "NOT_FOUND", "2026-07-28T09:31:04Z", "2026-07-28T09:31:04Z", "1500", "1500",
        "7", "null", "true", "true", "true", "n = -42!", "4",
    ]);
});

