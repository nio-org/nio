// A hexadecimal literal is an integer literal (§1.6). This includes the three
// places that take a literal and not an expression: a map key, an enum member
// value and a fixed-size array length.
test.start("lang: hexadecimal literals", void () -> {
    h.expectOutput(`
enum Mask { LOW: 0x0F, HIGH: 0xF0 }

int mask = 0xFF;
int upper = 0X10;
int lower = 0xff;
int wide = 0xDEADBEEF;
int most = 0x7FFFFFFFFFFFFFFF;
int neg = -0x80;
uint every = 0xFFFFFFFF;
byte b = 0x80;
int8 edge = 0x7F;
uint16 wider = 0xFFFF;
print(mask, upper, lower);
print(wide);
print(most);
print(neg);
print(every);
print(b, edge, wider);
print(0x10 == 16, 0xFF == 255, 0xa == 0xA);
print(0xA + 0xB, 0xFF - 0x0F);
print(getType(0xFF));
Map<int, String> names = { 0xFF: "high", 0x00: "low" };
print(names[255], names[0]);
int[0x4] quad = [1, 2, 3, 4];
print(quad.length, quad[0x3]);
print(Mask.LOW, Mask.HIGH);
print(Mask.HIGH == 240);
`, [
        "255 16 255", "3735928559", "9223372036854775807", "-128", "4294967295",
        "128 127 65535", "true true true", "21 240", "int", "high low", "4 4",
        "LOW HIGH", "true",
    ]);
});

// A float32 literal rounds once, at compile time, onto the binary32 grid.
test.start("lang: float32", void () -> {
    h.expectOutput(`
float32 tenth = 0.1;
float32 half = 0.5;
float32 negative = -2.25;
print(tenth);
print(half);
print(negative);
// Arithmetic widens, so a sum of float32s is a float64 and shows the
// digits of one: 0.1 as a float32 is not the double 0.1, and past the
// widening it no longer pretends to be.
float64 widened = tenth + half;
print(widened);
print(tenth + tenth);
float64 exact = tenth;
print(exact);
// Which is also why an exact literal compares equal and an inexact one
// does not: 0.1 on the right is a float64, and the two are different
// numbers (the same result C gives, for the same reason).
print(half == 0.5);
print(tenth == 0.1);
print(half < 0.75);
float32[] temps = [0.1, 0.5];
print(temps[0]);
float32? maybe = 0.25;
print(maybe);
maybe = null;
print(maybe);
`, [
        "0.1", "0.5", "-2.25", "0.6000000014901161", "0.20000000298023224",
        "0.10000000149011612", "true", "false", "true", "0.1", "0.25", "null",
    ]);
});

// JSON is the only source of values that the checker does not check, so the
// reader checks the range of every narrow type.
test.start("lang: narrow numbers JSON", void () -> {
    h.expectOutput(`
import 'json';
type Reading { int8 flag; int16 id; int32 count; float32 temp; }
Reading r = { flag: -128, id: 300, count: 100000, temp: 0.1 }
print(json.toText(r));
Reading back = json.parse('{"flag":127,"id":-32768,"count":2147483647,"temp":0.30000000000000004}') as Reading;
print(back.flag);
print(back.id);
print(back.count);
print(back.temp);
print(json.toText([back.temp]));
`, [
        "{\"flag\":-128,\"id\":300,\"count\":100000,\"temp\":0.1}", "127", "-32768",
        "2147483647", "0.3", "[0.3]",
    ]);
    h.expectRuntimeError(`
import 'json';
type T { int16 v; }
T t = json.parse('{"v":40000}') as T;
`, "int16 out of range at v");
    h.expectRuntimeError(`
import 'json';
type T { int32 v; }
T t = json.parse('{"v":3000000000}') as T;
`, "int32 out of range at v");
    h.expectRuntimeError(`
import 'json';
type T { float32 v; }
T t = json.parse('{"v":400000000000000000000000000000000000000}') as T;
`, "float32 out of range at v");
});

test.start("lang: unsigned integers", void () -> {
    h.expectOutput(`
import 'array';
import 'json';
import 'string';

uint8 a = 255;
uint16 b = 65535;
uint32 c = 4294967295;
uint64 d = 9223372036854775807;
uint e = 0;
print(a, b, c, d, e);
print(getType(a), getType(b), getType(c), getType(d), getType(e));

// Subtracting below zero wraps to the top of the range, and the value
// prints, formats and orders as the large number it is rather than as -1.
uint top = e - 1;
print(top);
print(string.from(top));
print(top > d, top / 2, top % 10, top / c);

// Arithmetic widens to uint, and a narrow unsigned type cannot hold it back.
uint8 x = 200;
uint8 y = 100;
print(getType(x + y), x + y);

// A byte is a uint8, so it meets an int without either side converting.
byte raw = 200;
int widened = raw + 1;
print(widened, getType(widened));

// A plain number written beside an unsigned value takes its type. No
// literal can name the top half of a uint64 (§1.6), so d + d + 1 is how
// that value is reached. This also shows the wrap.
print(top == d + d + 1, e == 0, x > 0, d <= d);

// Sorting is unsigned too: the wrapped value is the largest, not the least.
uint64[] xs = [1, 0, d];
array.push(xs, top);
array.sort(xs);
print(json.toText(xs));

// JSON writes the top half of a uint64 and reads it back exactly.
type Header { uint8 version; uint32 length; uint64 id; }
Header h = { version: a, length: c, id: top };
print(json.toText(h));
Header back = json.parse(json.toText(h)) as Header;
print(back.version, back.length, back.id);
Json tree = json.parse(json.toText(h));
print(json.toText(tree));

// And the rest of the language treats them as the scalars they are.
uint8? maybe = 7;
print(maybe, maybe == 7);
Map<uint8, String> names = { 1: "one", 200: "many" };
print(names[200]);
switch (a) {
    case 255: print("full");
    default: print("other");
}
`, [
        "255 65535 4294967295 9223372036854775807 0",
        "uint8 uint16 uint32 uint64 uint", "18446744073709551615",
        "18446744073709551615", "true 9223372036854775807 5 4294967297", "uint 300",
        "201 int", "true true true true",
        "[0,1,9223372036854775807,18446744073709551615]",
        "{\"version\":255,\"length\":4294967295,\"id\":18446744073709551615}",
        "255 4294967295 18446744073709551615",
        "{\"version\":255,\"length\":4294967295,\"id\":18446744073709551615}",
        "7 true", "many", "full",
    ]);
});

// int and int64 are different types with the same width on this host. On a
// 32-bit host, only the int-to-int64 direction compiles.
test.start("lang: sized and natural integers", void () -> {
    h.expectOutput(`
int64 a = 7;
int b = a;
int64 c = b + a;
float64 x = 1.5;
float y = x;
float64 z = y + x;
print(c);
print(z);
print(getType(a));
print(getType(b));
print(getType(x));
print(getType(y));
print(getType(1));
print(getType(1.5));
// Arithmetic keeps the sized type when both sides have it, and falls back
// to the natural one when they disagree.
print(getType(a + a));
print(getType(a + b));
print(getType(x + x));
`, [
        "14", "3", "int64", "int", "float64", "float", "int", "float", "int64", "int",
        "float64",
    ]);
});

// A narrow result crosses the async boundary in its family's register.
test.start("lang: narrow numbers async", void () -> {
    h.expectOutput(`
import 'async';
int16 async id() { return 300; }
float32 async temp() { return 0.5; }
void async report() {
    print(await id());
    print(await temp());
    print(getType(await temp()));
}
report();
async.run(temp(), void (float32 v) -> print(v));
`, [
        "0.5", "300", "0.5", "float32",
    ]);
});

test.start("lang: JSON", void () -> {
    h.expectOutput(`
import 'json';
import 'time';
type Point { int x; float y; }
type Shape { String name; Point center; String[] tags; bool visible; DateTime created; }
Shape s = {
    name: "circle",
    center: { x: 1, y: 2.5 },
    tags: ["round", "red"],
    visible: true,
    created: time.date.fromText("2026-07-25")
}
print(json.toText(s));
print(json.toText(42));
print(json.toText(1.5));
print(json.toText(true));
print(json.toText("plain"));
print(json.toText([1, 2, 3]));
print(json.toText("he said \\"hi\\"\\n"));
int? maybe = 3;
print(json.toText(maybe));
int? absent;
print(json.toText(absent));
print(json.toText([[1], [2, 3]]));
`, [
        "{\"name\":\"circle\",\"center\":{\"x\":1,\"y\":2.5},\"tags\":[\"round\",\"red\"],\"visible\":true,\"created\":\"2026-07-25T00:00:00Z\"}",
        "42", "1.5", "true", "\"plain\"", "[1,2,3]", "\"he said \\\"hi\\\"\\n\"", "3",
        "null", "[[1],[2,3]]",
    ]);
});

test.start("lang: time calendar", void () -> {
    h.expectOutput(`
import 'time';
DateTime d = time.date.fromText("2026-07-25T13:45:10Z");
print(time.date.toText(d));
print(time.date.year(d));
print(time.date.month(d));
print(time.date.day(d));

DateTime dayOnly = time.date.fromText("2026-01-02");
print(time.date.toText(dayOnly));

DateTime later = time.date.addDays(dayOnly, 31);
print(time.date.toText(later));
print(time.date.addDays(dayOnly, -2) < dayOnly);
print(d > dayOnly);
print(d == d);
print(time.date.year(time.now()) >= 2026);
`, [
        "2026-07-25T13:45:10Z", "2026", "7", "25", "2026-01-02T00:00:00Z",
        "2026-02-02T00:00:00Z", "true", "true", "true", "true",
    ]);
});

// A Duration is a count of milliseconds and prints as one.
test.start("lang: time duration", void () -> {
    h.expectOutput(`
import 'time';
print(time.duration("1s"));
print(time.duration("10s"));
print(time.duration("30m"));
print(time.duration("2h"));
print(time.duration("1d"));
print(time.duration("0s"));
print(time.duration("+90s"));
print(time.duration("-1d"));
print(time.milliseconds(time.duration("2h")));
print(time.duration("1d") > time.duration("23h"));
print(time.duration("60s") == time.duration("1m"));
`, [
        "1000", "10000", "1800000", "7200000", "86400000", "0", "90000", "-86400000",
        "7200000", "true", "true",
    ]);
    h.expectOutput(`
import 'time';

DateTime start = time.date.fromText("2026-07-25T00:00:00Z");
DateTime end = start + time.duration("90m");
print(time.date.toText(end));
print(end - start);
print(time.date.toText(end - time.duration("30m")));
print(time.date.toText(time.duration("1h") + start));

Duration gap = end - start;
print(gap + gap);
print(gap - time.duration("30m"));
print(gap * 2);
print(3 * gap);
print(gap / 3);
print(-gap);
print(time.milliseconds(gap));

// A bare number where a Duration is wanted is that many milliseconds.
Duration half = 500;
print(half, -half);
print(gap == 5400000, 5400000 == gap, gap > 1000);
print(time.date.toText(start + 1000));
print(time.date.toText(start - 1000));
`, [
        "2026-07-25T01:30:00Z", "5400000", "2026-07-25T01:00:00Z",
        "2026-07-25T01:00:00Z", "10800000", "3600000", "10800000", "16200000",
        "1800000", "-5400000", "5400000", "500 -500", "true true true",
        "2026-07-25T00:00:01Z", "2026-07-24T23:59:59Z",
    ]);
    h.expectOutput(`
import 'time';
import 'json';

type Span { DateTime at; Duration took; }
Span s = { at: time.date.fromText("2026-07-25"), took: time.duration("2s") }
print(json.toText(s));

Span back = json.parse("{\\"at\\":\\"2026-07-25T00:00:00Z\\",\\"took\\":4500}") as Span;
print(time.date.toText(back.at), back.took);
print(json.toText(time.duration("1m")));
`, [
        "{\"at\":\"2026-07-25T00:00:00Z\",\"took\":2000}",
        "2026-07-25T00:00:00Z 4500", "60000",
    ]);
});

test.start("lang: print record and time", void () -> {
    h.expectOutput(`
import 'json';
import 'time';
type Car { String make; int age; String? owner; }
Car c = { make: "t", age: 4 }
print(json.toText(c));
print(json.toText([1, 2]));
print(time.date.fromText("2026-07-25"));
`, [
        "{\"make\":\"t\",\"age\":4}", "[1,2]", "2026-07-25T00:00:00Z",
    ]);
});

// This case compares the whole output byte for byte. expectOutput compares by
// line.
test.start("lang: print and print inline", void () -> {
    h.Run r = h.runProgram(`
enum Color { RED: 1, BLUE: 2 }
String? absent;
printInline("a");
printInline("b", "c");
print();
print("x", 1, true, 0.5, Color.BLUE, absent);
print("only");
printInline("no", "newline", "at", "end");
`);
    h.expectCode(r, 0);
    test.expectString(r.out, "ab c\nx 1 true 0.5 BLUE null\nonly\nno newline at end");
});

test.start("lang: print evaluates arguments first", void () -> {
    h.Run r = h.runProgram(`
String shout(String s) {
    printInline("[", s, "]");
    return s;
}
int boom() {
    return Error("nope");
}
print("first", shout("mid"), "last");

int f() {
    print("never", boom());
    return 0;
}
f() catch e { print("caught:", e.message); };
`);
    h.expectCode(r, 0);
    test.expectString(r.out, "[ mid ]first mid last\ncaught: nope\n");
});

test.start("lang: get type", void () -> {
    h.expectOutput(`
import 'time';
type Car { String make; int age; { int amount; }[]? repairs; }
enum Color { RED: 1 }
int8[] bytes = [1, 2];
int[3] fixed = [1, 2, 3];
Car c = { make: "t", age: 4 }
Function(int)<int> dbl = int (int n) -> n * 2;
int async slow() { return 1; }
print(getType("s"));
print(getType(1));
print(getType(1.5));
print(getType(true));
print(getType(time.now()));
print(getType(time.duration("1s")));
print(getType(bytes));
print(getType(bytes[0]));
print(getType(fixed));
print(getType(c));
print(getType(c.make));
print(getType(c.repairs));
print(getType(Color.RED));
print(getType(dbl));
print(getType(dbl(2)));
print(getType(slow()));
print(getType(null));
print(getType(getType(1)));
`, [
        "String", "int", "float", "bool", "DateTime", "Duration", "int8[]", "int8",
        "int[3]", "Car", "String", "Car.repairs[]?", "Color", "Function(int)<int>",
        "int", "Future<int>", "null", "String",
    ]);
});

test.start("lang: get type ignores narrowing", void () -> {
    h.expectOutput(`
String? maybe = "x";
print(getType(maybe));
if (maybe != null) {
    print(getType(maybe));
    String sure = maybe;    // narrowing itself still applies here
    print(sure);
}
`, [
        "String?", "String?", "x",
    ]);
});

// getType folds to a constant. The constant must not depend on the block where
// the call started.
test.start("lang: get type with branching argument", void () -> {
    h.expectOutput(`
type Node { int value; Node? next; }
Node n = { value: 1, next: null }
print(getType(n.next));
print(getType(n.next?.value));
print(getType(n.next?.next?.value));
print(getType(true && n.value > 0));
`, [
        "Node?", "int?", "int?", "bool",
    ]);
});

test.start("lang: get type evaluates its argument", void () -> {
    h.expectOutput(`
int calls = 0;
int bump() {
    calls = calls + 1;
    return calls;
}
print(getType(bump()));
print(getType(bump()));
print(calls);
`, [
        "int", "int", "2",
    ]);
});

test.start("lang: get type in async functions", void () -> {
    h.expectOutput(`
int async slow() { return 7; }
void async report() {
    print(getType(await slow()));
    print(getType(1 + await slow()));
}
report();
`, [
        "int", "int",
    ]);
});

// math.toInt is the only math function that can stop the program (§6.21). A
// float with no int value is a program error. The caller can use floor, ceil
// or round to select the rounding.
test.start("lang: math.toInt refuses a value no int holds", void () -> {
    h.expectRuntimeError(`
import 'math';
float z = 0.0;
print(math.toInt(z / z));
`, "math.toInt");
    h.expectRuntimeError(`
import 'math';
float big = 1.0;
for (int i = 0; i < 70; i++) {
    big = big * 2.0;
}
print(math.toInt(big));
`, "math.toInt");
});

// The two random calls that stop the program (§6.22): pick on an empty array,
// and int with an inverted range.
test.start("lang: random refuses an empty pick and an inverted range", void () -> {
    h.expectRuntimeError(`
import 'random';
int[] none = [];
print(random.pick(none));
`, "random.pick: the array is empty");
    h.expectRuntimeError(`
import 'random';
print(random.int(5, 1));
`, "random.int: the low bound is above the high bound");
});

test.start("lang: runtime errors", void () -> {
    h.expectRuntimeError(`
int zero = 0;
print(1 / zero);
`, "division by zero");
    h.expectRuntimeError(`
int zero = 0;
print(1 % zero);
`, "modulo by zero");
    h.expectRuntimeError(`
int[] a = [1];
print(a[2]);
`, "index 2 out of range (array length 1)");
    h.expectRuntimeError(`
int[] a = [1];
int i = -1;
print(a[i]);
`, "index -1 out of range");
    h.expectRuntimeError(`
import 'time';
DateTime d = time.date.fromText("not a date");
`, "invalid date text");
    h.expectRuntimeError(`
import 'time';
Duration d = time.duration("soon");
`, "invalid duration");
    h.expectRuntimeError(`
import 'time';
Duration d = time.duration("10y");
`, "invalid duration unit");
    h.expectRuntimeError(`
import 'time';
Duration d = time.duration("9999999999999999999d");
`, "duration out of range");
    h.expectRuntimeError(`
import 'array';
int[] a = [1];
print(array.pop(a));
print(array.pop(a));
`, "pop from an empty array");
    h.expectRuntimeError(`
int f(int x) {
    if (x > 0) { return 1; }
}
print(f(-1));
`, "missing return in function f");
});

test.start("lang: enums", void () -> {
    h.expectOutput(`
enum HttpResponses {
    OK: 200,
    NOT_FOUND: 404
}

HttpResponses r = HttpResponses.OK;
print(r);                              // prints the member's name
print(HttpResponses.NOT_FOUND);
int code = r;                          // an enum widens to int
print(code);
print(r == HttpResponses.OK);
print(r == HttpResponses.NOT_FOUND);
print(r == 200);                       // and compares with ints
print(r < 300);
print(HttpResponses.OK < HttpResponses.NOT_FOUND);
r = HttpResponses.NOT_FOUND;
print(r);
`, [
        "OK", "NOT_FOUND", "200", "true", "false", "true", "true", "true",
        "NOT_FOUND",
    ]);
});

test.start("lang: enum zero value and negative members", void () -> {
    h.expectOutput(`
enum HttpResponses { OK: 200, NOT_FOUND: 404 }
enum Signal { UP: 1, FLAT: 0, DOWN: -1 }

HttpResponses r;                       // zero value 0: no member, prints the number
print(r);
Signal s;                              // zero value 0 names FLAT
print(s);
print(Signal.DOWN);
print(Signal.DOWN < Signal.FLAT);
`, [
        "0", "FLAT", "DOWN", "true",
    ]);
});

test.start("lang: enums in shapes", void () -> {
    h.expectOutput(`
import 'json';
import 'array';

enum Status { OK: 200, NOT_FOUND: 404 }
type Response { Status status; String? body }

Response resp = { status: Status.NOT_FOUND }
print(resp.status);
print(json.toText(resp));              // enums serialize as their number

Status[] all = [Status.OK, resp.status];
array.push(all, Status.OK);
forEach(all, e) {
    print(e);
}
print(json.toText(all));

Status? maybe = null;
print(maybe);
print(json.toText(maybe));
maybe = Status.OK;
if (maybe != null) {
    print(maybe);                      // narrowed to Status
}
print(maybe == Status.OK);
`, [
        "NOT_FOUND", "{\"status\":404}", "OK", "NOT_FOUND", "OK", "[200,404,200]",
        "null", "null", "OK", "true",
    ]);
});

test.start("lang: enums through functions", void () -> {
    h.expectOutput(`
enum Status { OK: 200, NOT_FOUND: 404 }

Status classify(int code) {
    if (code == 404) {
        return Status.NOT_FOUND;
    }
    return Status.OK;
}
void log(Status s) { print(s); }

log(classify(404));
log(classify(500));

Status async fetch(Status s) { return s; }
print(await fetch(Status.NOT_FOUND));  // enums flow through futures
`, [
        "NOT_FOUND", "OK", "NOT_FOUND",
    ]);
});

// s[i] is the byte at i (§3.5, rt_str_byte). Its type is uint8.
test.start("lang: string index", void () -> {
    h.expectOutput(`
import 'string';

type Rec { String name }

Rec? pick(bool yes) {
    if (yes) {
        Rec r = { name: "abc" };
        return r;
    }
    return null;
}

String s = "hello";
print(s[0]);
print(s[4]);
print(s[1] == 101);

byte[] b = string.toByteArray(s);
print(b[2] == s[2]);

// A byte above 127 reads as 128..255, exactly as toByteArray's element does.
String hi = "é";
byte[] hb = string.toByteArray(hi);
print(hi[0]);
print(hb[0] == hi[0]);

print(pick(true)?.name[1]);
print(pick(false)?.name[1]);

// Arithmetic on the byte -- the reason it is a byte rather than a String.
print("7"[0] - 48);

// The index is an expression, and it may allocate: the string has to stay
// rooted across it.
print(s[string.length(string.substring(s, 0, 2))]);
`, [
        "104", "111", "true", "true", "195", "true", "98", "null", "7", "108",
    ]);
});

test.start("lang: string index out of range", void () -> {
    h.expectRuntimeError(`
String s = "hi";
int i = 5;
print(s[i]);
`, "index 5 out of range (string length 2)");
});

// A chain of + is one n-ary concatenation (genConcatChain in codegen). The
// operands are in frame slots, so a later operand that allocates must not
// sweep an earlier one.
test.start("lang: string concat chain", void () -> {
    h.expectOutput(`
import 'string';
import 'array';

String[] order = [];

String tag(String s) {
    array.push(order, s);
    return s;
}

// Every call allocates, so under a collector that runs on allocation the
// earlier operands are reachable only through the chain's frame slots.
String churn(String s) {
    String[] junk = [];
    for (int i = 0; i < 20; i++) {
        array.push(junk, s + string.from(i));
    }
    return s;
}

print("a" + "b" + "c");
print("a" + "b" + "c" + "d" + "e" + "f" + "g" + "h");
print("[" + "" + "" + "]");
print("x" + ("y" + "z") + "w");
print(("a" + "b") + ("c" + "d"));
print(churn("aaaa") + churn("bbbb") + churn("cccc") + churn("dddd"));

// The operands must be evaluated left to right, exactly as the cascade did.
String out = tag("1") + tag("2") + tag("3") + tag("4");
print(out + "/" + string.join(order, ""));

// A number still has to be converted explicitly, and the conversion is an
// ordinary operand of the chain.
print("n=" + string.from(1 + 2) + "!" + string.from(4.5));
`, [
        "abc", "abcdefgh", "[]", "xyzw", "abcd", "aaaabbbbccccdddd", "1234/1234",
        "n=3!4.5",
    ]);
});

// In an async body, the chain's slots are in the heap frame, because each
// operand but the last is held across a suspension. A fallible operand raises
// from the middle of the chain.
test.start("lang: string concat chain async and fallible", void () -> {
    h.expectOutput(`
import 'string';
import 'async';

String async piece(String s) {
    return s;
}

String async build() {
    String a = await piece("aa");
    return a + await piece("bb") + await piece("cc") + await piece("dd");
}

String failing(bool boom) {
    if (boom) {
        return Error("boom", 1);
    }
    return "ok";
}

String tryChain(bool boom) {
    return ("[" + failing(boom) + "-" + failing(false) + "]") catch "caught";
}

print(await build());
print(tryChain(false));
print(tryChain(true));
`, [
        "aabbccdd", "[ok-ok]", "caught",
    ]);
});

test.start("lang: string library", void () -> {
