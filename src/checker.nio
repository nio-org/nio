// Static type checking, and the type information that codegen needs.
// A set here is a Map<String, bool> that holds only true (see has).
import 'token';
import 'ast';
import 'types';
import 'builtins';
import 'diag';
import 'lib/quote';
import 'lib/fmt';
import 'string';
import 'lib/str';
import 'array';
import 'map';

// ---- what a check produces ----

// MethodRef is the method that a call resolves to, for codegen.
export type MethodRef {
    types.Record owner;
    String name;
    types.FuncType sig;
}

export type CatchInfo {
    types.Type result;
    // discard marks a catch at statement position, where the value is dropped
    // and the block falls through.
    bool discard;
    // nullFill marks a block that falls through into an optional target and
    // yields null.
    bool nullFill;
}

// Capture is one variable that a function value captures.
export type Capture {
    String name;
    types.Type type;
}

export type Lambda {
    types.FuncType sig;
    Capture[] captures;
}

// Binding is one declared variable. A const binding accepts no new
// assignment; the value it refers to stays mutable. global marks a
// module-level variable, which closures read directly and never capture.
// fnLevel counts the function values open at the declaration.
export type Binding {
    // id is the variable's identity, and pathKey builds flow keys from it. It
    // is a number because a record cannot key a map (§3.2, §6.7).
    int id;
    types.Type t;
    bool isConst;
    bool global;
    int fnLevel;
    DeclRef decl;
    // Where the name was written, so a second declaration of it can point at
    // the first. A binding the checker makes for itself carries no token.
    token.Token at;
}

// The declaration kinds a binding can come from; each names a boxing table
// that recordUse marks. NONE has no declaration to mark.
export enum DeclKind {
    NONE: 0,
    VAR: 1,
    PARAM: 2,
    FOREACH_ELEM: 3,
    FOREACH_INDEX: 4,
    CASE_BIND: 5,
    CATCH: 6
}

export type DeclRef {
    DeclKind kind;
    int nodeID;
}

DeclRef noDecl() {
    DeclRef d = { kind: DeclKind.NONE, nodeID: 0 };
    return d;
}

export DeclRef declOf(DeclKind kind, int nodeID) {
    DeclRef d = { kind: kind, nodeID: nodeID };
    return d;
}

// Scope is a lexical scope. Flow narrowing keys paths by binding id, so two
// variables with the same name never mix.
export type Scope {
    Map<String, Binding> vars;
    Scope? outer;

    Binding? lookupBinding(String name) {
        Scope? sc = self;
        while (sc != null) {
            Binding? b = sc.vars[name];
            if (b != null) {
                return b;
            }
            sc = sc.outer;
        }
        return null;
    }

    types.Type? lookup(String name) {
        Binding? b = self.lookupBinding(name);
        if (b == null) {
            return null;
        }
        return b.t;
    }

    // What this scope itself holds for the name, ignoring the ones around it.
    // Only a "already declared in this scope" diagnostic asks, so that it can
    // point at the declaration it collided with.
    Binding? lookupHere(String name) {
        return self.vars[name];
    }

    // Returns null when this scope already has the name.
    Binding? declareBinding(String name, Binding b) {
        if (self.vars[name] != null) {
            return null;
        }
        self.vars[name] = b;
        return b;
    }
}

export Scope newScope(Scope? outer) {
    Scope s = { vars: {}, outer: outer };
    return s;
}

// ModuleRef is what an import alias resolves to: a built-in module, or the
// exports of a user module.
export type ModuleRef {
    String builtin;    // one of builtinModules; "" for user modules
    ModuleExports? exports;
}

// Info holds the results of a check that succeeded, for codegen. Every map
// with an int key uses the node id that the parser stamps on each AST node,
// not a position and not a name. Anything that builds an AST node must stamp
// an id on it.
export type Info {
    Map<int, types.Type> types;
    Map<int, types.Type> declTypes;
    Map<String, types.Record> records;
    Map<String, types.Enum> enums;
    // enumMembers maps each enum member access to its constant value; codegen
    // emits the constant and never evaluates the member expression's object.
    Map<int, int> enumMembers;
    Map<String, types.FuncType> funcs;
    // externs maps the extern function names (§5.8) to their signatures.
    // Codegen calls the bare C symbol. The loader holds two modules that
    // declare one symbol to one signature.
    Map<String, types.FuncType> externs;
    Map<String, ModuleRef> moduleAliases;
    // narrowed marks identifier and member expressions whose entry in types is
    // the inner type of their declared optional. The value still carries the
    // optional representation, so codegen unwraps it at each marked use.
    Map<int, bool> narrowed;
    // lambdas maps each function value to its signature and to the variables
    // that it captures, in a fixed order.
    Map<int, Lambda> lambdas;
    // boxedVars, boxedParams, boxedElems and boxedIndexes mark declarations
    // whose variable some function value captures. Captures are by reference,
    // so codegen moves each marked variable into a shared heap box.
    Map<int, bool> boxedVars;
    Map<int, bool> boxedParams;
    Map<int, bool> boxedElems;
    Map<int, bool> boxedIndexes;
    // boxedCaseBinds does the same for the binding of a type case (§4.9),
    // which has no declaration statement of its own.
    Map<int, bool> boxedCaseBinds;
    // Holds the record each type case resolved to (§4.9). The label is a type
    // annotation, not an expression, so it has no entry in types.
    Map<int, types.Record> caseTypes;
    // Holds the type a `case Union.Tag x:` binds, which is what the member
    // holds and not the wrapper the switch matched. Codegen loads the payload
    // for any case with an entry.
    Map<int, types.Type> casePayloads;
    // unionWraps marks the expressions §2.10 rule 7 converted, with the member
    // the value goes into. Codegen allocates the member and stores the value
    // in it, which is the whole of the conversion.
    Map<int, types.Record> unionWraps;
    // unionCtors marks the calls that are `Union.Tag(v)` rather than calls at
    // all. A wrap generates the expression and puts it in a member; a ctor is
    // the member and generates its argument.
    Map<int, types.Record> unionCtors;
    // asMembers marks the narrowings whose target is a union member. `t as
    // Union.Tag` answers what the member holds, so codegen loads field 0 on
    // the hit path.
    Map<int, types.Record> asMembers;
    // numericAs marks the `as` expressions that convert between two number
    // types (§3.6). Codegen cannot tell them apart from a document read:
    // `json.parse(s) as int` also records a number type on its value.
    Map<int, bool> numericAs;
    Map<int, bool> boxedCatches;
    // raises marks every call and await that can fail (§2.9), so codegen knows
    // where to emit an error branch.
    Map<int, bool> raises;
    Map<int, CatchInfo> catches;
    // methodCalls maps each call of a record method to the method it resolves
    // to. Resolution is static, so codegen emits a direct call and never looks
    // in the record.
    Map<int, MethodRef> methodCalls;
    // top is the module's top-level scope, where a method body an importing
    // file inherits resolves its free names, wherever it is compiled (§2.4).
    Scope? top;

    // builtinNamespace returns the built-in module and the namespace that e
    // names, when e is `alias.ns` and the alias is a built-in module that
    // groups functions under ns. It returns null in every other case.
    NsRef? builtinNamespace(ast.Expression e) {
        ast.MemberExpression? mem = e as ast.MemberExpression;
        if (mem == null || mem.optional) {
            return null;
        }
        ast.Identifier? id = mem.object as ast.Identifier;
        if (id == null) {
            return null;
        }
        ModuleRef? ref = self.moduleAliases[id.name];
        if (ref == null) {
            return null;
        }
        if (!isBuiltinNamespace(ref.builtin, mem.property)) {
            return null;
        }
        NsRef r = { module: ref.builtin, ns: mem.property };
        return r;
    }
}

export type NsRef {
    String module;
    String ns;
}

export Info newInfo() {
    Info i = {
        types: {}, declTypes: {}, records: {}, enums: {}, enumMembers: {},
        funcs: {}, externs: {}, moduleAliases: {}, narrowed: {}, lambdas: {},
        boxedVars: {}, boxedParams: {}, boxedElems: {}, boxedIndexes: {},
        boxedCaseBinds: {}, caseTypes: {}, casePayloads: {}, unionWraps: {}, unionCtors: {}, asMembers: {}, numericAs: {}, boxedCatches: {}, raises: {},
        catches: {}, methodCalls: {}, top: null,
    };
    return i;
}

// externOk tells whether t can cross the C boundary in an extern signature
// (§5.8): the integer and float families, bool, String, and arrays of those.
// Each one is a single unit that C can hold (runtime.h). Records, optionals,
// maps, functions, futures and the opaque types stay on this side.
bool externOk(types.Type t) {
    if (externScalarOk(t)) {
        return true;
    }
    types.Array? a = t as types.Array;
    if (a != null) {
        return externScalarOk(a.elem);
    }
    return false;
}

bool externScalarOk(types.Type t) {
    if (types.isIntFamily(t) || types.isFloatFamily(t)) {
        return true;
    }
    return types.equal(t, types.BoolT) || types.equal(t, types.StringT);
}

// ModuleExports is the exported surface of a checked module, as the files
// that import it see it.
export type ModuleExports {
    // qual is the unique symbol prefix of the module, and "" for the entry
    // file.
    String qual;
    Map<String, types.FuncType> funcs;
    Map<String, types.Type> vars;
    Map<String, types.Record> records;
    Map<String, types.Enum> enums;
    // consts marks the names in vars that the module declared const.
    Map<String, bool> consts;
    // Holds every top-level declaration, exported or not, so that an error can
    // separate "not exported" from "does not exist".
    Map<String, bool> names;
    // source is the file of the module, as the loader names it in diagnostics.
    // A diagnostic about a method body that this module wrote and another
    // module inherited reports a line of this file (§2.4).
    String source;

    // The qual that owns the symbol of each re-exported function or variable
    // (§5.4). A name this module declared itself is absent, because its symbol
    // sits under qual. Codegen reads it through qualFor. Records and enums
    // need no entry: a record carries its own qual and an enum member is a
    // constant, so neither reaches a symbol built from this one.
    Map<String, String> origins;

    // The fields below are what an extending type needs from the type that it
    // extends (§2.4), and no importer sees them otherwise. decls holds the
    // declaration of each exported record, whose methods the extending type
    // copies. info and top are where those copies resolve their free names.
    // homes carries the same three for every module this one reaches, because
    // a type can extend a type that extends a type from a third module.
    Map<String, ast.TypeDeclStatement> decls;
    Info? info;
    Scope? top;
    Map<String, ModuleExports> homes;
}

// ---- the fixed tables ----

// The built-in standard library modules (§6). A program must import one
// before it uses it, and no user module can take one of these names.
export Map<String, bool> const builtinModules = {
    "json": true, "time": true, "array": true, "string": true, "map": true,
    "async": true, "os": true, "path": true, "fs": true, "process": true,
    "regexp": true, "net": true, "crypto": true, "math": true, "random": true,
};

// The built-in modules written in Nio and not in C (§6.13). The checker knows
// nothing about their contents: they are listed here only so that the "import
// it first" diagnostics cover them. This list must agree with
// builtinNioModules in the loader.
export Map<String, bool> const builtinNioModules =
    { "test": true, "http": true, "tls": true, "x509": true };

// builtinModuleTypes are the types a built-in module exports, named through
// its alias in type positions (`os.Cpu c`), keyed "module.Type". A module
// listed here also needs its name reserved as a qual in the loader, or a user
// module of the same file name produces a colliding type descriptor.
//
// Every module that raises names one shared ErrorCode enum, so that
// fs.ErrorCode.NOT_FOUND and process.ErrorCode.OTHER are members of one
// nominal type that §2.5 lets a handler compare. An enum needs no reserved
// qual, because it never reaches the TypeDesc table of codegen by name.
Map<String, types.Type> builtinModuleTypes = {};
builtinModuleTypes["os.Cpu"] = types.CpuT;
builtinModuleTypes["json.Type"] = types.JsonTypeT;
builtinModuleTypes["string.ErrorCode"] = types.ErrorCodeT;
builtinModuleTypes["path.ErrorCode"] = types.ErrorCodeT;
builtinModuleTypes["regexp.ErrorCode"] = types.ErrorCodeT;
builtinModuleTypes["fs.Stat"] = types.StatT;
builtinModuleTypes["fs.DeleteOptions"] = types.DeleteOptionsT;
builtinModuleTypes["fs.ErrorCode"] = types.ErrorCodeT;
builtinModuleTypes["process.ChildRunResult"] = types.ChildRunResultT;
builtinModuleTypes["process.ChildRunOptions"] = types.ChildRunOptionsT;
builtinModuleTypes["process.ChildUsage"] = types.ChildUsageT;
builtinModuleTypes["process.ErrorCode"] = types.ErrorCodeT;
builtinModuleTypes["net.Options"] = types.NetOptionsT;
builtinModuleTypes["net.Datagram"] = types.DatagramT;
builtinModuleTypes["net.ErrorCode"] = types.ErrorCodeT;
builtinModuleTypes["crypto.ErrorCode"] = types.ErrorCodeT;

// moduleTypeNames lists the type names each module exports, for the
// diagnostic that names them. The order is written out here because a map
// walks in insertion order (§6.7) and the diagnostic shows sorted order.
Map<String, String[]> moduleTypeNames = {};
moduleTypeNames["os"] = ["Cpu"];
moduleTypeNames["json"] = ["Type"];
moduleTypeNames["string"] = ["ErrorCode"];
moduleTypeNames["path"] = ["ErrorCode"];
moduleTypeNames["regexp"] = ["ErrorCode"];
moduleTypeNames["fs"] = ["DeleteOptions", "ErrorCode", "Stat"];
moduleTypeNames["process"] = ["ChildRunOptions", "ChildRunResult", "ChildUsage", "ErrorCode"];
moduleTypeNames["net"] = ["Datagram", "ErrorCode", "Options"];
moduleTypeNames["crypto"] = ["ErrorCode"];

// The sub-names a built-in module groups functions under. `time.date.day(t)`
// is one call, not a member of a value `time.date`, which does not exist.
// Every site that takes a member callee apart goes through
// Info.builtinNamespace instead of matching the shape itself.
Map<String, bool> const builtinNamespaceSet = {
    "time.date": true,
    "process.stdout": true, "process.stderr": true,
    "process.stdin": true, "process.child": true,
    "net.tcp": true, "net.udp": true, "net.unix": true,
};

export bool isBuiltinNamespace(String module, String ns) {
    if (module == "") {
        return false;
    }
    return builtinNamespaceSet[module + "." + ns] != null;
}

// The names that user code cannot declare, in any file. They are in scope
// everywhere and no import brings them in. A built-in module name is not
// here: the import alias claims it per file, so every site that reads this
// map reads aliasInUse as well.
//
// Exported for tools/grammar.nio, which highlights these names in an editor.
export Map<String, bool> const reserved = {
    "Error": true, "print": true, "printInline": true, "getType": true,
};

// typeNameGuesses are the spellings that name no type but are close to one,
// with the name to suggest for each.
Map<String, String> const typeNameGuesses = {
    "string": "String",
    "date": "DateTime",
    "time": "DateTime",
    "Time": "DateTime",
    "datetime": "DateTime",
    "duration": "Duration",
    "regexp": "RegExp",
    "Regexp": "RegExp",
    "regex": "RegExp",
    "Regex": "RegExp",
};

// The built-in type names, and the type that each one resolves to. `int`,
// `uint` and `float` are types of their own, as wide as the machine, and not
// other names for `int64`, `uint64` and `float64`.
//
// Exported for tools/grammar.nio, which highlights these names in an editor.
export Map<String, types.Type> builtinTypes = {};
builtinTypes["int8"] = types.Int8T;
builtinTypes["int16"] = types.Int16T;
builtinTypes["int32"] = types.Int32T;
builtinTypes["int64"] = types.Int64T;
builtinTypes["int"] = types.IntT;
builtinTypes["uint8"] = types.Uint8T;
builtinTypes["byte"] = types.Uint8T;
builtinTypes["uint16"] = types.Uint16T;
builtinTypes["uint32"] = types.Uint32T;
builtinTypes["uint64"] = types.Uint64T;
builtinTypes["uint"] = types.UintT;
builtinTypes["float32"] = types.Float32T;
builtinTypes["float64"] = types.Float64T;
builtinTypes["float"] = types.FloatT;
builtinTypes["String"] = types.StringT;
builtinTypes["bool"] = types.BoolT;
builtinTypes["DateTime"] = types.DateTimeT;
builtinTypes["Duration"] = types.DurationT;
builtinTypes["Json"] = types.JsonT;
builtinTypes["RegExp"] = types.RegExpT;
builtinTypes["Socket"] = types.SocketT;
builtinTypes["Listener"] = types.ListenerT;
builtinTypes["Error"] = types.ErrorT;

// jsonRestTag marks the catch-all field of a record (§6.3), which holds the
// keys the record does not declare. It has no `target:key` shape.
String const jsonRestTag = "json*";

// renameTargets are the serialization formats that a field annotation can
// name with a `target:` prefix.
Map<String, bool> const renameTargets = { "json": true };

// jsonFuncs are the functions of the module other than parse, push and
// toText. Each one accepts a Json of any kind and reads a MISSING node as an
// absent one, so no call site must guard its argument. The four readers are
// fallible because the document decides its own shape.
Map<String, types.FuncType> jsonFuncs = {};
jsonFuncs["getType"] = types.newFuncType([types.JsonT], types.JsonTypeT);
jsonFuncs["keys"] = types.newFuncType([types.JsonT], types.newArray(types.StringT));
jsonFuncs["length"] = types.newFuncType([types.JsonT], types.IntT);
jsonFuncs["remove"] = types.newFuncType([types.JsonT, types.StringT], types.VoidT);
jsonFuncs["asInt"] = jsonReader(types.IntT);
jsonFuncs["asFloat"] = jsonReader(types.FloatT);
jsonFuncs["asText"] = jsonReader(types.StringT);
jsonFuncs["asBool"] = jsonReader(types.BoolT);

types.FuncType jsonReader(types.Type ret) {
    types.FuncType f = types.newFuncType([types.JsonT], ret);
    f.fallible = true;
    return f;
}

// jsonFuncNamesText lists the callable names of the module, for diagnostics.
String const jsonFuncNamesText = "toText, parse, asBool, asFloat, asInt, asText, getType, keys, length, remove";

// RaiseCtx follows the error flow through one function body. catches is the
// number of catch expressions that guard the position under check: a raise
// below none of them escapes, and makes the body fallible. raised counts
// every raise, guarded or not, so a catch can find that it handles nothing.
type RaiseCtx {
    RaiseCtx? outer;
    String name;    // the declared function's name; "" otherwise
    bool top;       // module top-level code: an escaping raise aborts
    int catches;
    int raised;
    bool fallible;
}

type LambdaScope {
    Lambda info;
    Map<String, bool> seen;    // capture names already recorded
}

// InheritedBody describes the inherited method body under check (§2.4).
type InheritedBody {
    String label;      // "Fancy.me (inherited from base.Item)"
    String source;     // the file the body was written in; "" when it is this one
    token.Token at;    // the `extends` clause, where a foreign body's errors land
}

// InheritedErr is one diagnostic from an inherited method body. The checker
// holds it aside until the whole module is checked (see mergeInherited).
type InheritedErr {
    String bare;          // as it would read in the type the body was written in
    String text;          // as reported: prefixed with the type that inherited it
    diag.Diagnostic d;    // text's structured form, spliced beside it
    int at;               // where it belongs among the errors reported directly
}

// BaseType is the type that an `extends` clause resolved to, whose methods
// the extending type copies (§2.4).
type BaseType {
    ast.TypeDeclStatement decl;
    types.Record? rec;    // null for a base declared in this file, still being built
    String qual;
    bool local;

    // name is the form of the base in diagnostics and on the copies of its
    // methods. It carries the module when the base is imported.
    String name() {
        types.Record? r = self.rec;
        if (self.local || r == null) {
            return self.decl.name;
        }
        return types.typeString(r);
    }
}

// BaseResult is what baseOf returns: a base and a reason. One of them is
// set, and neither one is set when there is no clause.
type BaseResult {
    BaseType? base;
    String why;
}

BaseResult noBase() {
    BaseResult r = { base: null, why: "" };
    return r;
}

BaseResult badBase(String why) {
    BaseResult r = { base: null, why: why };
    return r;
}

BaseResult okBase(BaseType b) {
    BaseResult r = { base: b, why: "" };
    return r;
}

// CheckResult is what checkModule returns. errs is the sentence form of
// diags, and not a second set of findings (src/diag.nio).
export type CheckResult {
    Info info;
    String[] errs;
    diag.Diagnostic[] diags;
}

// ---- free helpers ----

bool has(Map<String, bool> m, String k) {
    return m[k] != null;
}

bool hasInt(Map<int, bool> m, int k) {
    return m[k] != null;
}

// sortedKeys returns the keys of a set in sorted order. A map walks in
// insertion order (§6.7), which a diagnostic that lists names does not want.
String[] sortedKeys(Map<String, bool> m) {
    String[] out = map.keys(m);
    array.sort(out);
    return out;
}

bool sameSet(Map<String, bool> a, Map<String, bool> b) {
    if (a.length != b.length) {
        return false;
    }
    return array.every(map.keys(a), bool (String k) -> has(b, k));
}

bool copyFlowInto(Map<String, bool> src, Map<String, bool> dst) {
    forEach(map.keys(src), k) {
        dst[k] = true;
    }
    return true;
}

Map<String, bool> copyFlow(Map<String, bool> m) {
    Map<String, bool> out = {};
    copyFlowInto(m, out);
    return out;
}

Map<String, bool> withFacts(Map<String, bool> base, Map<String, bool> facts) {
    Map<String, bool> out = copyFlow(base);
    copyFlowInto(facts, out);
    return out;
}

// Keeps the paths that are known to be non-null in both branches.
Map<String, bool> intersectFlow(Map<String, bool> a, Map<String, bool> b) {
    Map<String, bool> out = {};
    forEach(map.keys(a), k) {
        if (has(b, k)) {
            out[k] = true;
        }
    }
    return out;
}

Map<String, bool> flowMinus(Map<String, bool> base, Map<String, bool> kills) {
    Map<String, bool> out = {};
    forEach(map.keys(base), k) {
        bool killed = false;
        forEach(map.keys(kills), kill) {
            if (k == kill || str.hasPrefix(k, kill + ".")) {
                killed = true;
            }
        }
        if (!killed) {
            out[k] = true;
        }
    }
    return out;
}

// bindingKey returns the flow key of a variable, which is its identity and
// not its name, so a narrowing never applies to the wrong variable.
String bindingKey(Binding b) {
    return "v" + string.from(b.id);
}

// terminates tells whether s never falls through to the next statement. Flow
// narrowing needs it: after `if (x == null) { return; }` the code below sees
// a narrowed x.
bool terminates(ast.Statement s) {
    switch (s) {
        case ast.ReturnStatement r:
            return true;
        case ast.BreakStatement b:
            return true;
        case ast.ContinueStatement co:
            return true;
        case ast.BlockStatement blk:
            bool any = false;
            forEach(blk.statements, bs) {
                if (terminates(bs)) {
                    any = true;
                }
            }
            return any;
        case ast.IfStatement ifs:
            ast.BlockStatement? els = ifs.else;
            if (els == null) {
                return false;
            }
            return terminates(ifs.then) && terminates(els);
        case ast.SwitchStatement sw:
            // A switch falls through unless every clause terminates without a
            // break. An exhaustive type switch (§4.9) needs no default
            // clause, because one of its clauses always runs.
            if (!sw.hasDefault() && !sw.exhaustive) {
                return false;
            }
            bool all = true;
            forEach(sw.cases, cl) {
                if (breaksOut(cl.body) || !terminates(cl.body)) {
                    all = false;
                }
            }
            return all;
        default:
            return false;
    }
}

// breaksOut tells whether s can leave the innermost loop or switch with a
// `break`. A loop or switch inside s binds its own breaks, so the walk stops
// at either one.
bool breaksOut(ast.Statement s) {
    bool found = false;
    switch (s) {
        case ast.BreakStatement b:
            return true;
        case ast.BlockStatement blk:
            forEach(blk.statements, bs) {
                if (breaksOut(bs)) {
                    found = true;
                }
            }
        case ast.IfStatement ifs:
            if (breaksOut(ifs.then)) {
                found = true;
            }
            ast.BlockStatement? els = ifs.else;
            if (els != null && breaksOut(els)) {
                found = true;
            }
        default:
            found = false;
    }
    if (found) {
        return true;
    }
    // A break in a catch handler leaves the loop, and only an expression
    // reaches the handler.
    forEach(ast.catchBlocks(s), b2) {
        if (breaksOut(b2)) {
            found = true;
        }
    }
    return found;
}

// cycleFrom writes the extends cycle that a chain closed: the names from the
// one the chain returned to, and then that name again.
String[] cycleFrom(String[] chain, String start) {
    int at = -1;
    forEach(chain, name, i) {
        if (at == -1 && name == start) {
            at = i;
        }
    }
    String[] out = [];
    if (at == -1) {
        at = 0;
    }
    for (int i = at; i < chain.length; i++) {
        array.push(out, chain[i]);
    }
    array.push(out, start);
    return out;
}

// overrideSpelling writes md with `override` added, for the diagnostic that
// asks for the modifier.
String overrideSpelling(ast.FunctionDeclStatement md) {
    String out = "void override ";
    ast.TypeNode? rt = md.returnType;
    if (rt != null) {
        out = ast.typeNodeString(rt) + " override ";
    }
    if (md.async) {
        out = out + "async ";
    }
    return out + md.name + "(…)";
}

// methodKey names a method in the fallibility sets. No function name can
// collide with one, because '.' is not an identifier character.
String methodKey(String recName, String method) {
    return recName + "." + method;
}

bool inheritsField(types.Record rec, String name) {
    types.Record? base = rec.base;
    if (base == null) {
        return false;
    }
    return base.fieldType(name) != null;
}

// sameSignature compares two signatures and ignores fallibility.
bool sameSignature(types.FuncType a, types.FuncType b) {
    types.FuncType x = types.newFuncType(a.params, a.return);
    x.async = a.async;
    x.variadic = a.variadic;
    types.FuncType y = types.newFuncType(b.params, b.return);
    y.async = b.async;
    y.variadic = b.variadic;
    return types.equal(x, y);
}

// valueProvesPresence tells whether an assignment of a value of type vt into
// an optional location proves that the location is non-null.
bool valueProvesPresence(types.Type? vt) {
    if (vt == null) {
        return false;
    }
    if (types.isInvalid(vt) || types.equal(vt, types.NullT)) {
        return false;
    }
    return (vt as types.Optional) == null;
}

// narrowIntLit tells whether a literal takes the type `expected` asks for
// rather than its own. A literal becomes a narrow or unsigned integer where
// one is wanted and it fits. A bare number where a Duration is wanted means
// that many milliseconds (§6.4). Only a literal is retyped, never a variable.
bool narrowIntLit(types.Type? expected, int v) {
    if (expected == null) {
        return false;
    }
    types.Type u = types.unwrap(expected);
    if (types.equal(u, types.DurationT)) {
        return true;
    }
    types.IntBounds? r = types.intRange(u);
    if (r == null) {
        return false;
    }
    return v >= r.lo && v <= r.hi;
}

// F32_OVERFLOW is the value at which a double stops rounding to a finite
// binary32: 2^128 - 2^103, the midpoint between MaxFloat32 and 2^128. A tie
// rounds to even and 2^128 is the even value, so the midpoint itself
// overflows and the test below is strict.
float const F32_OVERFLOW = 340282356779733661637539395458142568448.0;

// fitsFloat32 tells whether v passes through a binary32 and back as a finite
// number, which is the range check for a float32 (§2.1). NaN and the
// infinities give false. It is exported for tests/checker_test.nio.
export bool fitsFloat32(float v) {
    return v > -F32_OVERFLOW && v < F32_OVERFLOW;
}

// narrowFloatLit is narrowIntLit for the floats. A literal takes the float
// type that expected asks for when that type holds it. Rounding to a binary32
// is not a mismatch; overflow to infinity is.
bool narrowFloatLit(types.Type? expected, float v) {
    if (expected == null) {
        return false;
    }
    types.Type u = types.unwrap(expected);
    if (!types.isFloatFamily(u)) {
        return false;
    }
    return types.bits(u) >= 64 || fitsFloat32(v);
}

// litIntType and litFloatType choose the type of a number literal that no
// context constrains: the natural type, unless the value needs more bits.
types.Type litIntType(int v) {
    types.IntBounds? r = types.intRange(types.IntT);
    if (r != null && (v < r.lo || v > r.hi)) {
        return types.Int64T;
    }
    return types.IntT;
}

types.Type litFloatType(float v) {
    if (types.bits(types.FloatT) < 64 && !fitsFloat32(v)) {
        return types.Float64T;
    }
    return types.FloatT;
}

// printable tells whether print accepts a value of type t: a scalar basic
// type, an enum, or an optional of either one. A record or an array goes
// through json.toText, which keeps print free of the JSON runtime.
bool printable(types.Type t) {
    types.Type u = types.unwrap(t);
    if ((u as types.Enum) != null) {
        return true;
    }
    return comparableBasic(u);
}

bool comparableBasic(types.Type t) {
    types.Basic? b = t as types.Basic;
    if (b == null) {
        return false;
    }
    switch (b.kind) {
        case types.Kind.INT8:
        case types.Kind.INT16:
        case types.Kind.INT32:
        case types.Kind.INT64:
        case types.Kind.INT:
        case types.Kind.UINT8:
        case types.Kind.UINT16:
        case types.Kind.UINT32:
        case types.Kind.UINT64:
        case types.Kind.UINT:
        case types.Kind.FLOAT32:
        case types.Kind.FLOAT64:
        case types.Kind.FLOAT:
        case types.Kind.STRING:
        case types.Kind.BOOL:
        case types.Kind.DATETIME:
        case types.Kind.DURATION:
            return true;
        default:
            return false;
    }
}

// orderableBasic tells whether values of t support <, so a sort needs no
// comparator (§3.1). These are comparableBasic without bool, and with the
// enums, which order by their numbers.
bool orderableBasic(types.Type t) {
    if ((t as types.Enum) != null) {
        return true;
    }
    types.Basic? b = t as types.Basic;
    if (b == null) {
        return false;
    }
    switch (b.kind) {
        case types.Kind.INT8:
        case types.Kind.INT16:
        case types.Kind.INT32:
        case types.Kind.INT64:
        case types.Kind.INT:
        case types.Kind.UINT8:
        case types.Kind.UINT16:
        case types.Kind.UINT32:
        case types.Kind.UINT64:
        case types.Kind.UINT:
        case types.Kind.FLOAT32:
        case types.Kind.FLOAT64:
        case types.Kind.FLOAT:
        case types.Kind.STRING:
        case types.Kind.DATETIME:
        case types.Kind.DURATION:
            return true;
        default:
            return false;
    }
}

// intLitValue returns the value of a whole-number literal, with or without a
// leading minus, and null when e is not one.
int? intLitValue(ast.Expression e) {
    ast.PrefixExpression? p = e as ast.PrefixExpression;
    if (p != null && p.operator == "-") {
        ast.IntLiteral? neg = p.right as ast.IntLiteral;
        if (neg != null) {
            return -neg.value;
        }
        return null;
    }
    ast.IntLiteral? il = e as ast.IntLiteral;
    if (il != null) {
        return il.value;
    }
    return null;
}

// isIntLiteral accepts a whole-number literal with or without a leading
// minus.
bool isIntLiteral(ast.Expression e) {
    ast.Expression inner = e;
    ast.PrefixExpression? p = e as ast.PrefixExpression;
    if (p != null && p.operator == "-") {
        inner = p.right;
    }
    return (inner as ast.IntLiteral) != null;
}

// NoallocCtx is the `noalloc` function under check (§2.12). reported holds
// the diagnostics to one for each function, so a body written with no thought
// of the restriction does not report at every line.
type NoallocCtx {
    String name;
    bool reported;
}

// allocFreeBuiltins are the built-in functions that a `noalloc` body can call
// (§2.12): the ones whose runtime code makes no allocation. Check a new entry
// against its C body, because a wrong entry makes the guarantee false with no
// other sign.
Map<String, bool> const allocFreeBuiltins = {
    // length reads Str.len from the header.
    "string.length": true,
    // memchr and a compare loop over memory that the caller supplied.
    "string.contains": true,
    "string.find": true,
    // The constant-time comparisons read only the caller's memory.
    "string.equalsConstantTime": true,
    "string.bytesEqualConstantTime": true,
    // A Duration is its count of milliseconds (§6.4), so this call emits no
    // instructions.
    "time.milliseconds": true,
    // math is arithmetic on registers, in C or inline (§6.21).
    "math.abs": true, "math.acos": true, "math.asin": true, "math.atan": true,
    "math.atan2": true, "math.ceil": true, "math.clamp": true, "math.cos": true,
    "math.exp": true, "math.floor": true, "math.isInfinite": true, "math.isNaN": true,
    "math.log": true, "math.log10": true, "math.log2": true, "math.max": true,
    "math.min": true, "math.pow": true, "math.round": true, "math.sin": true,
    "math.sqrt": true, "math.tan": true, "math.toFloat": true, "math.toInt": true,
    // random advances a state in C and swaps or reads elements in place (§6.22).
    "random.float": true, "random.int": true, "random.pick": true,
    "random.seed": true, "random.shuffle": true,
    // Three of §6.5's additions move or compare elements in place.
    "array.contains": true, "array.fill": true, "array.reverse": true,
};

// isBitwiseOp tells whether op is an infix operator that reads its operands
// as bits and not as numbers (§3.1). The unary `~` is not here.
bool isBitwiseOp(String op) {
    return op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>";
}

// temporalInfix gives the type of the arithmetic that relates instants and
// durations (§6.4), and null when the operands are not such a pair.
//
//	DateTime - DateTime -> Duration    how long between the two
//	DateTime + Duration -> DateTime    and the mirror, Duration + DateTime
//	DateTime - Duration -> DateTime    (Duration - DateTime has no meaning)
//	Duration +- Duration -> Duration
//	Duration */  int     -> Duration   scaling, and the mirror int * Duration
//
// Every other combination is a compile error. Units never change silently.
types.Type? temporalInfix(String op, types.Type lt, types.Type rt) {
    bool lDate = types.equal(lt, types.DateTimeT);
    bool rDate = types.equal(rt, types.DateTimeT);
    bool lDur = types.equal(lt, types.DurationT);
    bool rDur = types.equal(rt, types.DurationT);
    if (op == "+") {
        if (lDate && rDur || lDur && rDate) {
            return types.DateTimeT;
        }
        if (lDur && rDur) {
            return types.DurationT;
        }
        return null;
    }
    if (op == "-") {
        if (lDate && rDate || lDur && rDur) {
            return types.DurationT;
        }
        if (lDate && rDur) {
            return types.DateTimeT;
        }
        return null;
    }
    if (op == "*") {
        if (lDur && types.isIntFamily(rt) || types.isIntFamily(lt) && rDur) {
            return types.DurationT;
        }
        return null;
    }
    if (op == "/") {
        if (lDur && types.isIntFamily(rt)) {
            return types.DurationT;
        }
    }
    return null;
}

// enumComparable tells whether one side is an enum and the pair compares. An
// enum compares with itself and with any signed integer type, because its
// members are signed. Two different enum types never compare.
bool enumComparable(types.Type a, types.Type b) {
    types.Enum? ae = a as types.Enum;
    types.Enum? be = b as types.Enum;
    if (ae != null && be != null) {
        return ae.id == be.id;
    }
    if (ae != null) {
        return types.isSignedFamily(b);
    }
    if (be != null) {
        return types.isSignedFamily(a);
    }
    return false;
}

// optionalOf puts an optional around t. An optional stays as it is, because
// there is no T??, which is how `a?.b` flattens.
types.Type optionalOf(types.Type t) {
    if ((t as types.Optional) != null) {
        return t;
    }
    return types.newOptional(t);
}

bool hasNullCase(ast.SwitchStatement st) {
    return array.some(st.cases, bool (ast.SwitchCase cl) -> array.some(cl.values, bool (ast.Expression v) -> (v as ast.NullLiteral) != null));
}

// A case label becomes a string key, so a comparison finds a label written
// twice. The first letter separates the families, so two labels of different
// shapes never collide. An enum member and the integer it stands for give the
// same key, because they are the same label.

// caseInt is the key of a label in the integer family: the integer types, bool,
// DateTime, Duration and the enum members.
String caseInt(int i) {
    return "i" + string.from(i);
}

// caseFloat is the key of a float label. The shortest decimal that round
// trips is unique for each value. A negative zero becomes a positive zero, so
// `case 0.0` and `case -0.0` are one label, as they compare equal.
String caseFloat(float f) {
    float v = f;
    if (v == 0.0) {
        v = 0.0;
    }
    return "f" + string.from(v);
}

String caseString(String v) {
    return "s" + v;
}

String const caseNull = "n";

// suggestText writes an expression for a diagnostic that gives the fix. The
// AST printer parenthesizes every precedence, which writes a module call as
// `(process.getArgs)()`, so the two forms a suggestion uses are written here.
String suggestText(ast.Expression e) {
    switch (e) {
        case ast.MemberExpression m:
            String op = ".";
            if (m.optional) {
                op = "?.";
            }
            return suggestText(m.object) + op + m.property;
        case ast.CallExpression call:
            String[] args = [];
            forEach(call.args, a) {
                array.push(args, suggestText(a));
            }
            return suggestText(call.callee) + "(" + string.join(args, ", ") + ")";
        default:
            return ast.exprString(e);
    }
}

// opaqueBasic tells whether b is a built-in type with no parts to write out
// or compare. Every caller reads this one list, so a new opaque type reaches
// serialization, equality and the diagnostics together.
bool opaqueBasic(types.Basic b) {
    return b.kind == types.Kind.REGEXP || b.kind == types.Kind.SOCKET
        || b.kind == types.Kind.LISTENER;
}

// opaqueKind names the value in t that jsonSerializable rejected, for the
// diagnostic.
String opaqueKind(types.Type t) {
    switch (t) {
        case types.Array a:
            return opaqueKind(a.elem);
        case types.Optional o:
            return opaqueKind(o.inner);
        case types.MapType m:
            return opaqueKind(m.value);
        case types.Basic b:
            if (b.kind == types.Kind.REGEXP) {
                return "RegExps";
            }
            if (b.kind == types.Kind.SOCKET) {
                return "Sockets";
            }
            if (b.kind == types.Kind.LISTENER) {
                return "Listeners";
            }
            return "function values";
        case types.Record r:
            // jsonSerializable rejects a union for the payload of one
            // member, so name the value in that payload.
            forEach(r.extenders, arm) {
                types.Type? pay = unionPayload(arm);
                if (pay != null && !jsonSerializable(pay)) {
                    return opaqueKind(pay);
                }
            }
            return "function values";
        default:
            return "function values";
    }
}

// badJSONMapKey tells whether t reaches a map with a non-String key outside a
// record field. Such a map has no JSON form. The writer omits one that is a
// record field, so a record stops the walk.
bool badJSONMapKey(types.Type t) {
    switch (t) {
        case types.MapType m:
            return !types.equal(m.key, types.StringT) || badJSONMapKey(m.value);
        case types.Array a:
            return badJSONMapKey(a.elem);
        case types.Optional o:
            return badJSONMapKey(o.inner);
        default:
            return false;
    }
}

// jsonSerializable tells whether a value of type t has a JSON form. Only the
// opaque values have none. A record always has one, because the writer omits
// a field of an opaque type (§6.3), so the walk never enters a record and
// terminates on a record type that reaches itself.
bool jsonSerializable(types.Type t) {
    Map<int, bool> seen = {};
    return jsonSerializableIn(t, seen);
}

bool jsonSerializableIn(types.Type t, Map<int, bool> seen) {
    switch (t) {
        case types.FuncType f:
            return false;
        case types.Basic b:
            return !opaqueBasic(b);
        case types.Array a:
            return jsonSerializableIn(a.elem, seen);
        case types.Optional o:
            return jsonSerializableIn(o.inner, seen);
        case types.MapType m:
            return types.equal(m.key, types.StringT) && jsonSerializableIn(m.value, seen);
        case types.Record r:
            // A union (§2.11) meets JSON as its payload does: a member
            // serializes as its payload alone, so a payload with no form
            // leaves nothing to write. seen covers a union that reaches
            // itself.
            if (!isUnion(r) || hasInt(seen, r.id)) {
                return true;
            }
            seen[r.id] = true;
            bool ok = true;
            forEach(r.extenders, arm) {
                types.Type? pay = unionPayload(arm);
                if (pay != null && (types.concrete(pay) as types.Record) == null
                    && !jsonSerializableIn(pay, seen)) {
                    ok = false;
                }
            }
            return ok;
        default:
            return true;
    }
}

// jsonParseable returns "" when a value of type t can be built from JSON, and
// the reason when it cannot. A fixed-size array shares its type descriptor
// with the growable array of the same element type, so the runtime cannot
// enforce the length.
String jsonParseable(types.Type t) {
    Map<int, bool> seen = {};
    return jsonParseableIn(t, seen);
}

String jsonParseableIn(types.Type t, Map<int, bool> seen) {
    switch (t) {
        case types.FuncType f:
            return "function values have no JSON form";
        case types.FutureType fu:
            return "futures have no JSON form";
        case types.Basic b:
            if (b.kind == types.Kind.REGEXP) {
                return "RegExps have no JSON form (parse the pattern as a String and compile it with regexp.create)";
            }
            if (b.kind == types.Kind.SOCKET || b.kind == types.Kind.LISTENER) {
                return types.typeString(b) + "s have no JSON form (a socket is an open connection, not data)";
            }
            if (types.equal(t, types.VoidT) || types.equal(t, types.NullT)) {
                return "it has no JSON form";
            }
            return "";
        case types.Array a:
            if (a.len > 0) {
                return "a fixed-size array cannot be parsed; use " + types.typeString(a.elem) + "[]";
            }
            return jsonParseableIn(a.elem, seen);
        case types.Optional o:
            return jsonParseableIn(o.inner, seen);
        case types.MapType m:
            if (!types.equal(m.key, types.StringT)) {
                return "JSON object keys are strings; use Map<String, " + types.typeString(m.value) + ">";
            }
            return jsonParseableIn(m.value, seen);
        case types.Record r:
            return jsonRecordOrUnion(r, seen);
        default:
            return "";
    }
}

// jsonRecordOrUnion sends a record type to the right test. A sealed type is
// not parseable: a document names no type, and nothing can construct a sealed
// base (§2.4). A union member is representation (§2.11), and the union is the
// type that a document fills.
String jsonRecordOrUnion(types.Record r, Map<int, bool> seen) {
    if (isUnion(r)) {
        return jsonUnionParseable(r, seen);
    }
    types.Record? owner = r.base;
    if (string.contains(r.name, ast.unionMark) && owner != null) {
        return types.typeString(r) + " is a union member; parse "
            + types.typeString(owner) + " and switch on it";
    }
    if (r.sealed) {
        return types.typeString(r)
            + " is sealed, and a document names no type to build; use a union or Json";
    }
    return jsonParseableRecord(r, seen);
}

// jsonUnionParseable returns "" when a union can be built from JSON. The
// value's kind chooses the member (§6.3), so no two members can come from the
// same kind: String and DateTime both arrive as a string, int and float as a
// number. JSON null is the kind of no member, and belongs to `U?`.
String jsonUnionParseable(types.Record u, Map<int, bool> seen) {
    if (hasInt(seen, u.id)) {
        return "";
    }
    seen[u.id] = true;
    Map<String, String> byKind = {};
    String why = "";
    forEach(u.extenders, arm) {
        if (why != "") {
            continue;
        }
        types.Type? pay = unionPayload(arm);
        if (pay == null) {
            // An `extends` written by hand on the base of the union (§2.4).
            why = types.typeString(arm) + " extends " + types.typeString(u)
                + " but is not one of its members, so a document cannot name it";
            continue;
        }
        String tag = unionTag(arm);
        types.Type cp = types.concrete(pay);
        types.Basic? pb = cp as types.Basic;
        if (pb != null && pb.kind == types.Kind.JSON) {
            why = "member " + tag + " is a Json, which accepts every value, so no other member could ever be chosen";
            continue;
        }
        if ((cp as types.Optional) != null) {
            why = "member " + tag + " is an optional; write " + types.typeString(u)
                + "? where the document may hold null";
            continue;
        }
        types.Record? pr = cp as types.Record;
        if (pr != null && isUnion(pr)) {
            why = "member " + tag + " is itself a union; the value's kind chooses one member, not two";
            continue;
        }
        String bad = jsonParseableIn(pay, seen);
        if (bad != "") {
            why = "member " + tag + ": " + bad;
            continue;
        }
        String kind = jsonKindClass(cp);
        if (kind == "") {
            why = "member " + tag + " has no JSON form";
            continue;
        }
        String? prev = byKind[kind];
        if (prev != null) {
            why = "members " + prev + " and " + tag + " are both read from " + kind
                + "; a document cannot say which is meant";
            continue;
        }
        byKind[kind] = tag;
    }
    return why;
}

// jsonKindClass names the JSON kind that a value of type t is read from, and
// "" for a type that no single kind covers. It must agree with jp_union in
// lib/json.c, or a union that the checker accepted fails on every document.
String jsonKindClass(types.Type t) {
    types.Type c = types.concrete(t);
    types.Basic? b = c as types.Basic;
    if (b != null) {
        if (b.kind == types.Kind.STRING || b.kind == types.Kind.DATETIME) {
            return "a string";
        }
        if (b.kind == types.Kind.BOOL) {
            return "true or false";
        }
        if (b.kind == types.Kind.INT8 || b.kind == types.Kind.INT16
            || b.kind == types.Kind.INT32 || b.kind == types.Kind.INT64
            || b.kind == types.Kind.INT || b.kind == types.Kind.UINT8
            || b.kind == types.Kind.UINT16 || b.kind == types.Kind.UINT32
            || b.kind == types.Kind.UINT64 || b.kind == types.Kind.UINT
            || b.kind == types.Kind.FLOAT32 || b.kind == types.Kind.FLOAT64
            || b.kind == types.Kind.FLOAT || b.kind == types.Kind.DURATION) {
            return "a number";
        }
        return "";
    }
    if ((c as types.Enum) != null) {
        return "a number";
    }
    if ((c as types.Array) != null) {
        return "an array";
    }
    if ((c as types.MapType) != null) {
        return "an object";
    }
    if ((c as types.Record) != null) {
        return "an object";
    }
    return "";
}

// jsonParseableRecord walks the fields of a record, which jsonParseable does
// not do. It skips a field with no JSON form, such as a function value or a
// RegExp, which keeps its zero value.
String jsonParseableRecord(types.Record r, Map<int, bool> seen) {
    if (hasInt(seen, r.id)) {
        return "";
    }
    seen[r.id] = true;
    String why = "";
    forEach(r.fields, f) {
        if (why != "" || !jsonSerializable(f.type)) {
            continue;
        }
        types.Type inner = f.type;
        while (true) {
            types.Array? a = inner as types.Array;
            if (a != null) {
                if (a.len > 0) {
                    why = "field \"" + f.name + "\" is a fixed-size array; use " + types.typeString(a.elem) + "[]";
                    break;
                }
                inner = a.elem;
                continue;
            }
            types.Optional? o = inner as types.Optional;
            if (o != null) {
                inner = o.inner;
                continue;
            }
            types.MapType? m = inner as types.MapType;
            if (m != null) {
                // Only a map with String keys reaches this point. Any other
                // key fails jsonSerializable above.
                inner = m.value;
                continue;
            }
            break;
        }
        if (why != "") {
            continue;
        }
        types.Record? rec = inner as types.Record;
        if (rec != null) {
            // A field can be a union or a sealed type, so go through the
            // router and not straight to the field walk.
            String inner2 = jsonRecordOrUnion(rec, seen);
            if (inner2 != "") {
                why = inner2;
            }
            continue;
        }
        if ((inner as types.FutureType) != null) {
            why = "field \"" + f.name + "\" is a future, which has no JSON form";
        }
    }
    return why;
}

bool containsFuture(types.Type t) {
    Map<int, bool> seen = {};
    return containsFutureIn(t, seen);
}

bool containsFutureIn(types.Type t, Map<int, bool> seen) {
    switch (t) {
        case types.FutureType f:
            return true;
        case types.Array a:
            return containsFutureIn(a.elem, seen);
        case types.Optional o:
            return containsFutureIn(o.inner, seen);
        case types.MapType m:
            return containsFutureIn(m.value, seen);
        case types.Record r:
            if (hasInt(seen, r.id)) {
                return false;
            }
            seen[r.id] = true;
            bool found = false;
            forEach(r.fields, f2) {
                if (containsFutureIn(f2.type, seen)) {
                    found = true;
                }
            }
            return found;
        default:
            return false;
    }
}

// sameCallShape tells whether two function types agree on everything except
// fallibility, the only difference a function value can cross (§2.9). It
// chooses the union member a literal goes into, before the literal is typed.
bool sameCallShape(types.FuncType a, types.FuncType b) {
    if (a.params.length != b.params.length || a.variadic != b.variadic || a.async != b.async) {
        return false;
    }
    forEach(a.params, p, i) {
        if (!types.equal(p, b.params[i])) {
            return false;
        }
    }
    return types.equal(a.return, b.return);
}

// unionTagsOf lists the member tags of a union, in declaration order, and is
// empty for a sealed type written by hand. ast.unionArmName names a member
// record `Union$Tag`, so the tag follows the mark. It is exported for the
// language server, which writes a union back in the form the source declared.
export String[] unionTagsOf(types.Record u) {
    String[] tags = [];
    forEach(u.extenders, e) {
        if (str.hasPrefix(e.name, u.name + ast.unionMark)) {
            array.push(tags, string.substring(e.name, string.length(u.name) + 1, string.length(e.name)));
        }
    }
    return tags;
}

// unionPayload returns the type that a union member carries, and null when r
// is not a member. A member name holds ast.unionMark, which §1.3 keeps out of
// every identifier a program can write, so the test needs no flag.
export types.Type? unionPayload(types.Record r) {
    if (!string.contains(r.name, ast.unionMark)) {
        return null;
    }
    types.FieldSlot? slot = r.fieldType(ast.unionPayload);
    if (slot == null) {
        return null;
    }
    return slot.type;
}

// unionTag returns the part of the generated name after the mark, and "" for
// a record that is not a member. The union is the type the member extends.
// The parser's rewrite keeps no other relation between them.
export String unionTag(types.Record arm) {
    types.Record? u = arm.base;
    if (u == null || !str.hasPrefix(arm.name, u.name + ast.unionMark)) {
        return "";
    }
    return string.substring(arm.name, string.length(u.name) + 1, string.length(arm.name));
}

// isUnion tells whether a `union` declaration produced this sealed record,
// and not a declaration written by hand. The answer changes only the words of
// a diagnostic.
export bool isUnion(types.Record r) {
    return r.sealed && unionTagsOf(r).length > 0;
}

// unionAccepts tells whether a member of u can hold a t. It asks rule 7 of
// §2.10 without performing the conversion, for a diagnostic.
bool unionAccepts(types.Record u, types.Type t) {
    bool fits = false;
    forEach(u.extenders, arm) {
        types.Type? pay = unionPayload(arm);
        if (pay != null && types.assignable(pay, t)) {
            fits = true;
        }
    }
    return fits;
}

// narrowsTo names what a sealed type narrows to, in the words of its
// declaration.
String narrowsTo(types.Record base) {
    if (isUnion(base)) {
        return "one of its members";
    }
    return "one of the types extending it";
}

// extendersOf names what a sealed type can narrow to. It describes a union in
// the words of its declaration, because "extended by" names the rewrite and
// not the program (§2.11).
String extendersOf(types.Record base) {
    if (isUnion(base)) {
        return types.typeString(base) + " has members "
            + string.join(unionTagsOf(base), ", ");
    }
    if (base.extenders.length == 0) {
        return "no type extends " + types.typeString(base);
    }
    String[] names = [];
    forEach(base.extenders, e) {
        array.push(names, types.typeString(e));
    }
    return types.typeString(base) + " is extended by " + string.join(names, ", ");
}

// nsExample names a function of the namespace ns, for a diagnostic about a
// call written one level too high.
String nsExample(String ns) {
    if (ns == "stdin") {
        return "read";
    }
    if (ns == "child") {
        return "run";
    }
    if (ns == "udp") {
        return "bind";
    }
    if (ns == "tcp" || ns == "unix") {
        return "listen";
    }
    return "write";    // stdout, stderr
}

// isRaise tells whether `return v` raises instead of returning. An Error is a
// raise wherever the declared return type cannot hold it, so a function whose
// result is an Error can still return one as a value.
bool isRaise(types.Type? retType, types.Type vt) {
    if (!types.isError(vt)) {
        return false;
    }
    if (retType == null) {
        return true;
    }
    return !types.assignable(retType, vt);
}

// badAlias names what an import alias cannot take: the built-in type names
// and the built-in functions. No built-in library needs an exception, because
// a library name is lower case and the type names it could hide are not.
bool badAlias(String name) {
    if (name == "print" || name == "printInline" || name == "getType") {
        return true;
    }
    return builtinTypes[name] != null;
}

// constKeyString writes the key of a map literal, to find duplicates and for
// diagnostics. It returns "" for anything that is not a constant.
String constKeyString(ast.Expression e) {
    switch (e) {
        case ast.StringLiteral s:
            return quote.quote(s.value);
        case ast.IntLiteral i:
            return string.from(i.value);
        case ast.FloatLiteral f:
            // string.from gives the shortest form that reads back as the same
            // value.
            return string.from(f.value);
        case ast.PrefixExpression p:
            String inner = constKeyString(p.right);
            if (inner != "") {
                return p.operator + inner;
            }
            return "";
        default:
            return "";
    }
}

// ---- the checker ----
// The token of a written type, or the declaration's own token when the
// function writes none, as with `void` and an inferred literal.
token.Token typeTokOr(ast.TypeNode? t, token.Token fallback) {
    if (t == null) {
        return fallback;
    }
    return t.tok;
}

// An empty token: no file wrote it, so it carries no span and a renderer skips
// its excerpt.
token.Token noTok() {
    token.Token t = {
        type: "", literal: "", line: 0, col: 0, note: "", quote: "",
        endLine: 0, endCol: 0,
    };
    return t;
}

// ---- initialization order ----
//
// §5.1 runs the top-level statements of a module in order, so a global holds
// no value until its own declaration statement runs. Scoping catches a direct
// read before that point, and cannot catch a read through a function:
//
//	print(a());              // runs first
//	String[] rows = ["x"];   // ... and this has not run yet
//	int a() { return b(); }
//	int b() { return rows.length; }
//
// The checker applies the textual rule transitively: for each top-level
// statement, every global reachable through calls must be declared above it.
// The reach is a fixpoint over the call graph. A function value reaches what
// its body reaches, at the point it is created rather than called. The rule
// stops at the module boundary, because a dependency's top-level code runs to
// completion before any importer's (§5.4).

// ownerTop, ownerFn and ownerMethod make the call-graph key for a top-level
// statement, a declared function and a method body. The three share one
// namespace, so the call graph is a map from a key to keys.
String ownerTop(int i) {
    return "@" + string.from(i);
}

String ownerFn(String name) {
    return "f:" + name;
}

String ownerMethod(String key) {
    return "m:" + key;
}

String calleeName(String owner) {
    if (string.length(owner) > 2) {
        String head = string.substring(owner, 0, 2);
        if (head == "f:" || head == "m:") {
            return string.substring(owner, 2, string.length(owner)) + "()";
        }
    }
    return owner;
}

// Edge is one call, with its position, so that a diagnostic can point at the
// call and not at the whole statement.
type Edge {
    String callee;
    token.Token tok;
}

// InitOrder is what the walk collects: the globals that each body names, the
// bodies that each body calls, and the position of each global declaration.
type InitOrder {
    Map<String, Map<String, bool>> reads;
    Map<String, Edge[]> calls;
    Map<String, int> declAt;
    Map<String, ast.VarDeclStatement> declPos;
}

InitOrder newInitOrder() {
    InitOrder o = { reads: {}, calls: {}, declAt: {}, declPos: {} };
    return o;
}

export type Checker {
    Info info;
    // errs is the sentence form of diags. errorf writes both, and
    // mergeInherited joins both again (src/diag.nio).
    String[] errs;
    diag.Diagnostic[] diags;
    // owner is the body under check, as an initialization-order key, and "" in
    // none of them.
    String owner;
    InitOrder init;
    Scope scope;
    types.Type? retType;    // non-null while checking a function body
    // The line a missing import should be written on: after the last one
    // the file has, or the first line when it has none. With it, the "import
    // it first" diagnostic carries an edit that an editor can apply.
    int importLine;
    // Where that return type is written, for the second place of a
    // "cannot return" diagnostic. It falls back to the declaration's own
    // token, because a function that returns nothing writes no type.
    token.Token retTok;
    int depth;       // 0 at top level
    String qual;     // module symbol prefix ("" for the entry file)
    String shown;    // what a type declared here is shown by, when not the qual
    // Counts the loops around the statement under check, so a `break` or a
    // `continue` knows whether it has a loop to bind to. The body of a
    // function value starts a new count.
    int loopDepth;
    // Counts the switch clauses around the statement, the other construct a
    // `break` can bind to (§4.9). It is separate from loopDepth because only a
    // loop accepts a `continue`.
    int switchDepth;

    // flow is the set of optional paths (see pathKey) known to be non-null at
    // this point. A use of a path in this set narrows to the inner type, and
    // the checker marks it in Info.narrowed.
    Map<String, bool> flow;
    // chainOpt marks the expressions whose optional type comes from an
    // optional chain, such as `a?.b`. Such a chain gives null in place of an
    // error, and nothing can assign through it.
    Map<int, bool> chainOpt;
    // nextBinding numbers the bindings that this check creates. A number makes
    // a stale flow key harmless, because no id is used twice.
    int nextBinding;
    // noNarrow is the expression that narrowing must not touch: the direct
    // operand of a comparison with null, which must see the raw optional.
    ast.Expression? noNarrow;
    // lambdas is the stack of function values whose bodies are under check. A
    // use of a binding declared outside one records a capture in it, and in
    // every function value nested deeper.
    LambdaScope[] lambdas;

    // raise follows the error flow through the body under check.
    RaiseCtx? raise;
    // Holds the functions that the previous inference round found to be
    // fallible. fallible collects what this round finds.
    Map<String, bool> seed;
    Map<String, bool> fallible;
    // catchStmt is the catch expression that stands alone as a statement, so
    // the program discards its value.
    ast.Expression? catchStmt;
    // Holds the function and method declarations whose name an earlier
    // declaration already claimed. The checker does not check their bodies,
    // because the name resolves to the first declaration's signature.
    Map<int, bool> nameTaken;
    // body describes the inherited method body under check, if there is one.
    // Its tokens point into the base type's declaration, so a diagnostic from
    // it must name the type that inherited it (§2.4).
    InheritedBody? body;
    // Holds those diagnostics until the module is checked, because the choice
    // to report one depends on what the base type reported for itself. See
    // mergeInherited.
    InheritedErr[] inherited;
    // Holds, by qual, the modules that could have written an inherited method
    // body: every module this one imports, and every module those reach. See
    // enterHome.
    Map<String, ModuleExports> homes;
    // noalloc is the `noalloc` function whose body is under check (§2.12), and
    // null everywhere else. Every expression passes through exprType, so the
    // check sits there and needs no walk of its own.
    NoallocCtx? noalloc;

    // ---- diagnostics ----

    // Names the second place the diagnostic just reported is about, and what
    // to say there. A type error is a disagreement between two places, and
    // naming one of them is half an answer.
    //
    // It attaches to the last diagnostic rather than taking two more
    // parameters on errorf, because most of the several hundred error sites
    // have no second place and the ones that do read better saying so on a
    // line of their own.
    void because(token.Token at, String message) {
        diag.Span span = diag.spanOf(at);
        int n = self.inherited.length;
        if (self.body != null && n > 0) {
            // The body came from another type's declaration, so the diagnostic
            // is held aside until mergeInherited decides whether to keep it.
            self.inherited[n - 1].d = diag.related(self.inherited[n - 1].d, span, message);
            return;
        }
        int k = self.diags.length;
        if (k == 0) {
            return;
        }
        self.diags[k - 1] = diag.related(self.diags[k - 1], span, message);
    }

    // Attaches an edit that resolves the diagnostic just reported. Only a site
    // that knows the whole edit may call this. An editor applies it without
    // asking, so a guess is worse than no offer.
    void suggest(diag.Span at, String text, String title) {
        int n = self.inherited.length;
        if (self.body != null && n > 0) {
            self.inherited[n - 1].d = diag.suggests(self.inherited[n - 1].d, at, text, title);
            return;
        }
        int k = self.diags.length;
        if (k == 0) {
            return;
        }
        self.diags[k - 1] = diag.suggests(self.diags[k - 1], at, text, title);
    }

    void errorf(token.Token tok, String format, ...String args) {
        String msg = fmt.fmtArr(format, args);
        String at = `line ${tok.line}:${tok.col}: `;
        InheritedBody? body = self.body;
        if (body == null) {
            diag.Diagnostic plain = diag.atTok(tok, msg);
            array.push(self.errs, diag.format(plain));
            array.push(self.diags, plain);
            return;
        }
        diag.Diagnostic d = diag.atTok(tok, body.label + ": " + msg);
        String text = at + body.label + ": " + msg;
        if (body.source != "") {
            // Another file wrote the body, so the position above is a line of
            // that file. Report at the `extends` clause in this file, and name
            // the file that holds the code.
            text = "line " + string.from(body.at.line) + ":" + string.from(body.at.col) + ": "
                + body.label + ", at " + body.source + " line " + string.from(tok.line)
                + ":" + string.from(tok.col) + ": " + msg;
            d = diag.atTok(body.at,
                body.label + ", at " + body.source + " line " + string.from(tok.line)
                + ":" + string.from(tok.col) + ": " + msg);
        }
        // The checker checks an inherited body once for each type that has it,
        // so keep this copy only until the original arrives.
        InheritedErr ie = { bare: at + msg, text: text, d: d, at: self.errs.length };
        array.push(self.inherited, ie);
    }

    // mergeInherited adds the diagnostics from the inherited method bodies
    // back in, and drops the ones the base type reported for itself.
    void mergeInherited() {
        if (self.inherited.length == 0) {
            return;
        }
        Map<String, bool> direct = {};
        forEach(self.errs, e) {
            direct[e] = true;
        }
        Map<String, bool> seen = {};
        String[] out = [];
        diag.Diagnostic[] outDiags = [];
        int next = 0;
        forEach(self.inherited, e) {
            if (has(direct, e.bare) || has(seen, e.text)) {
                continue;
            }
            seen[e.text] = true;
            for (int i = next; i < e.at; i++) {
                array.push(out, self.errs[i]);
                array.push(outDiags, self.diags[i]);
            }
            next = e.at;
            array.push(out, e.text);
            array.push(outDiags, e.d);
        }
        for (int i = next; i < self.errs.length; i++) {
            array.push(out, self.errs[i]);
            array.push(outDiags, self.diags[i]);
        }
        self.errs = out;
        self.diags = outDiags;
        self.inherited = [];
    }

    // ---- scope and bindings ----

    // declareVar declares name in the current scope, and returns null when the
    // scope already has that name.
    Binding? declareVar(String name, types.Type t, bool isConst, bool global, DeclRef decl) {
        return self.declareVarAt(name, t, isConst, global, decl, noTok());
    }

    // declareVar, with the place the name was written. Only a site that can
    // point at it passes one: the rest are bindings the checker makes for
    // itself, which no second declaration can collide with.
    Binding? declareVarAt(String name, types.Type t, bool isConst, bool global, DeclRef decl,
        token.Token at) {
        self.nextBinding++;
        Binding b = {
            id: self.nextBinding, t: t, isConst: isConst, global: global,
            fnLevel: self.lambdas.length, decl: decl, at: at,
        };
        return self.scope.declareBinding(name, b);
    }

    // recordUse notes a read or a write of a binding. A use inside a function
    // value, of a non-global binding declared outside it, is a capture: the
    // checker records it in that function value and in every one nested in it,
    // and marks the declaration for boxing. A capture is by reference, so the
    // declaring function and the closures share one heap cell.
    void recordUse(String name, Binding b) {
        if (b.global) {
            self.noteGlobalUse(name);
            return;
        }
        for (int i = b.fnLevel; i < self.lambdas.length; i++) {
            LambdaScope ls = self.lambdas[i];
            if (has(ls.seen, name)) {
                continue;
            }
            ls.seen[name] = true;
            Capture cap = { name: name, type: b.t };
            array.push(ls.info.captures, cap);
        }
        if (b.fnLevel < self.lambdas.length) {
            DeclRef d = b.decl;
            switch (d.kind) {
                case DeclKind.VAR:
                    self.info.boxedVars[d.nodeID] = true;
                case DeclKind.PARAM:
                    self.info.boxedParams[d.nodeID] = true;
                case DeclKind.FOREACH_ELEM:
                    self.info.boxedElems[d.nodeID] = true;
                case DeclKind.FOREACH_INDEX:
                    self.info.boxedIndexes[d.nodeID] = true;
                case DeclKind.CASE_BIND:
                    self.info.boxedCaseBinds[d.nodeID] = true;
                case DeclKind.CATCH:
                    self.info.boxedCatches[d.nodeID] = true;
                default:
                    return;
            }
        }
    }

    bool aliasInUse(String name) {
        return self.info.moduleAliases[name] != null;
    }

    // nameDeclared tells whether name resolves to a declaration in this file.
    // The name of a built-in library means the library only where nothing else
    // claims it, so the "import it first" hints call this first.
    bool nameDeclared(String name) {
        if (self.scope.lookupBinding(name) != null) {
            return true;
        }
        if (self.info.funcs[name] != null) {
            return true;
        }
        return self.info.enums[name] != null;
    }

    // missingImport reports a use of a built-in library name in a file that
    // does not import it. It returns false when the file gives the name its
    // own meaning.
    bool missingImport(token.Token tok, String name) {
        bool isLib = has(builtinModules, name) || has(builtinNioModules, name);
        if (!isLib || self.nameDeclared(name)) {
            return false;
        }
        self.errorf(tok, "%s is a built-in library; import it first: import '%s';", name, name);
        String line = "import '" + name + "';\n";
        diag.Span at = {
            file: "", line: self.importLine, col: 1,
            endLine: self.importLine, endCol: 1,
        };
        self.suggest(at, line, "add " + string.trim(line));
        return true;
    }

    // checkTypeName rejects a declared type name that does not start with a
    // capital letter, which keeps the built-in types the only lower-case type
    // names in the language. kind is "type" or "enum".
    void checkTypeName(String kind, String name, token.Token tok) {
        if (name == "") {
            return;
        }
        String first = string.substring(name, 0, 1);
        if (first >= "A" && first <= "Z") {
            return;
        }
        String rest = string.substring(name, 1, string.length(name));
        if (first >= "a" && first <= "z") {
            String fixed = string.toUpperCaseAscii(first) + rest;
            self.errorf(tok, "%s name %s must start with an upper-case letter (did you mean %s?)",
                kind, quote.quote(name), quote.quote(fixed));
            return;
        }
        self.errorf(tok, "%s name %s must start with an upper-case letter", kind, quote.quote(name));
    }

    // ---- error flow (§2.9) ----

    void pushRaise(String name) {
        RaiseCtx r = { outer: self.raise, name: name, top: false, catches: 0, raised: 0, fallible: false };
        self.raise = r;
    }

    // popRaise leaves the current body and tells whether an error escaped it.
    bool popRaise() {
        RaiseCtx? r = self.raise;
        if (r == null) {
            return false;
        }
        self.raise = r.outer;
        return r.fallible;
    }

    // noteRaise records that the evaluation of e can fail. Codegen reads
    // Info.raises to find the calls and awaits that need an error branch.
    void noteRaise(ast.Expression e) {
        self.info.raises[e.id] = true;
        RaiseCtx? r = self.raise;
        if (r == null) {
            return;
        }
        r.raised++;
        if (r.catches == 0) {
            r.fallible = true;
        }
    }

    // callProduces returns the type that a call of sig produces, and notes the
    // raise when the callee can fail. An async call never raises at the call
    // site: its fallibility travels on the future and appears at the await.
    types.Type callProduces(ast.Expression ex, types.FuncType sig) {
        if (sig.async) {
            return types.newFutureType(sig.return, sig.fallible);
        }
        if (sig.fallible) {
            self.noteRaise(ex);
        }
        return sig.return;
    }

    // errorCall checks `Error("message")` and `Error("message", code)`. The
    // code is optional and holds 0, the "unspecified" code, when it is left
    // out. It is an int and not an enum, so a program passes a member of its
    // own set by rule 5 of §2.10.
    types.Type errorCall(ast.CallExpression ex) {
        if (ex.args.length != 1 && ex.args.length != 2) {
            self.errorf(ex.tok, "Error takes 1 or 2 arguments, got %s", string.from(ex.args.length));
            forEach(ex.args, a) {
                self.exprType(a, null);
            }
            return types.ErrorT;
        }
        types.Type at = self.exprType(ex.args[0], types.StringT);
        if (!types.isInvalid(at) && !types.equal(at, types.StringT)) {
            self.errorf(ex.args[0].tok, "Error takes a String message, got %s", types.typeString(at));
        }
        if (ex.args.length == 2) {
            types.Type ct = self.exprType(ex.args[1], types.IntT);
            if (!types.isInvalid(ct) && !types.assignable(types.IntT, ct)) {
                self.errorf(ex.args[1].tok, "an Error code must be an int or an enum member, got %s", types.typeString(ct));
            }
        }
        return types.ErrorT;
    }

    // catchType checks `value catch ...` (§2.9). The guard covers everything
    // in value, so an error raised at any point of its evaluation arrives here
    // and `f(g())` needs one catch.
    types.Type catchType(ast.CatchExpr ex, types.Type? expected) {
        ast.Expression? cs = self.catchStmt;
        bool discard = cs != null && cs.id == ex.id;

        RaiseCtx? r = self.raise;
        int before = 0;
        if (r != null) {
            before = r.raised;
            r.catches++;
        }
        types.Type vt = self.exprType(ex.value, expected);
        int after = before;
        if (r != null) {
            r.catches--;
            after = r.raised;
        }
        if (after == before && !types.isInvalid(vt)) {
            self.errorf(ex.tok, "nothing in this expression can fail, so there is no error to catch");
        }

        CatchInfo ci = { result: types.VoidT, discard: discard, nullFill: false };
        self.info.catches[ex.id] = ci;
        ast.Expression? def = ex.default;
        if (def != null) {
            ci.result = self.catchDefault(ex, def, expected, vt);
        } else {
            ci.result = self.catchBlock(ex, expected, vt, discard, ci);
        }
        return ci.result;
    }

    // catchDefault checks the `f() catch <value>` form, and gives the whole
    // expression a type that both paths satisfy.
    types.Type catchDefault(ast.CatchExpr ex, ast.Expression def, types.Type? expected, types.Type vt) {
        if (types.equal(vt, types.VoidT)) {
            self.errorf(ex.tok, "this call has no value, so there is nothing for a default to replace (catch it with a block instead)");
            self.exprType(def, null);
            return types.VoidT;
        }
        // A default with no declared type takes its context from the guarded
        // expression, so `string.toUint(s) catch 0` is a uint and
        // `time.duration(s) catch 0` is a Duration.
        types.Type? ctx = expected;
        if (ctx == null || types.isInvalid(ctx)) {
            ctx = vt;
        }
        types.Type dt = self.exprType(def, ctx);
        if (types.isInvalid(vt) || types.isInvalid(dt)) {
            return types.InvalidT;
        }
        // The declared type decides when the two paths differ and both fit
        // it, which makes `String? n = f() catch null;` a String?.
        if (expected != null && !types.isInvalid(expected)
            && types.assignable(expected, vt) && types.assignable(expected, dt)) {
            return expected;
        }
        if (types.assignable(vt, dt)) {
            return vt;
        }
        self.errorf(def.tok, "cannot use %s as the default for %s", types.typeString(dt), types.typeString(vt));
        return vt;
    }

    // catchBlock checks the `f() catch e { ... }` form. The block runs outside
    // the guarded expression, so a raise in it escapes as any other raise
    // does, which makes `return e` a rethrow.
    types.Type catchBlock(ast.CatchExpr ex, types.Type? expected, types.Type vt, bool discard, CatchInfo ci) {
        ast.BlockStatement? bodyOpt = ex.body;
        if (bodyOpt == null) {
            return vt;
        }
        ast.BlockStatement body = bodyOpt;
        self.scope = newScope(self.scope);
        if (has(reserved, ex.name)) {
            self.errorf(ex.nameTok, "%s is a reserved name", quote.quote(ex.name));
        } else if (self.aliasInUse(ex.name)) {
            self.errorf(ex.nameTok, "%s is already used as a module name", quote.quote(ex.name));
        } else {
            // The catch scope is new, so this name hides an outer one.
            self.declareVar(ex.name, types.ErrorT, false, false, declOf(DeclKind.CATCH, ex.id));
        }

        // The block is one of two paths. No fact it establishes survives it,
        // and every path it assigns loses what the code before knew.
        Map<String, bool> saved = self.flow;
        forEach(body.statements, bs) {
            self.checkStatement(bs);
        }
        Map<String, bool> kills = {};
        self.assignedPaths(body, kills);
        self.flow = flowMinus(saved, kills);
        Scope? outer = self.scope.outer;
        if (outer != null) {
            self.scope = outer;
        }

        if (discard || terminates(body)) {
            // The failure path never reaches code that needs a value.
            return vt;
        }
        if (types.isInvalid(vt) || types.equal(vt, types.VoidT)) {
            return vt;
        }
        // A fall-through into an optional target yields null.
        if (expected != null && (expected as types.Optional) != null && types.assignable(expected, vt)) {
            ci.nullFill = true;
            return expected;
        }
        self.errorf(ex.tok, "this catch block falls through, leaving no value for %s: end it with return, break, or continue, or declare the target %s?",
            types.typeString(vt), types.typeString(vt));
        return vt;
    }

    // ---- flow narrowing ----
    //
    // A path is a variable, or a variable and then field names: `x`, `x.f.g`,
    // `m.x`. The key starts from the id of the binding and not from its name,
    // so a narrowing never applies to the wrong variable. An expression that
    // goes through an index or a call is not a path, and nothing narrows it.

    // pathKey answers the flow key of e, and "" when e is not a stable path.
    String pathKey(ast.Expression e) {
        switch (e) {
            case ast.Identifier id:
                Binding? b = self.scope.lookupBinding(id.name);
                if (b != null) {
                    return bindingKey(b);
                }
                return "";
            case ast.MemberExpression mem:
                ast.Identifier? id2 = mem.object as ast.Identifier;
                if (id2 != null) {
                    ModuleRef? ref = self.info.moduleAliases[id2.name];
                    if (ref != null) {
                        ModuleExports? exp = ref.exports;
                        if (exp != null && exp.vars[mem.property] != null) {
                            // The qual is unique per module, and never empty
                            // for a module that some file imports.
                            return "m" + exp.qual + "." + mem.property;
                        }
                        return "";
                    }
                }
                String obj = self.pathKey(mem.object);
                if (obj != "") {
                    return obj + "." + mem.property;
                }
                return "";
            default:
                return "";
        }
    }

    // narrowPath answers the inner type when the path is known non-null here,
    // and marks e for the unwrap in codegen. It answers null otherwise.
    types.Type? narrowPath(ast.Expression e, types.Optional opt, String key) {
        ast.Expression? nn = self.noNarrow;
        if (nn != null && nn.id == e.id) {
            return null;
        }
        if (key == "" || !has(self.flow, key)) {
            return null;
        }
        self.info.narrowed[e.id] = true;
        return opt.inner;
    }

    // Drops key and every path through it. An assignment to `x` invalidates
    // `x.f`, and an assignment to `x.f` leaves `x` valid.
    void killFlowPath(String key) {
        String[] doomed = array.filter(map.keys(self.flow),
            bool (String k) -> k == key || str.hasPrefix(k, key + "."));
        forEach(doomed, k) {
            map.remove(self.flow, k);
        }
    }

    // Collects the paths that a statement subtree assigns to. The checker
    // scans a loop body with it first: a fact from before the loop does not
    // survive an iteration that assigns the path again.
    void assignedPaths(ast.Statement s, Map<String, bool> out) {
        switch (s) {
            case ast.AssignStatement a:
                String k = self.pathKey(a.target);
                if (k != "") {
                    out[k] = true;
                }
            case ast.IncDecStatement inc:
                String k2 = self.pathKey(inc.target);
                if (k2 != "") {
                    out[k2] = true;
                }
            case ast.BlockStatement blk:
                forEach(blk.statements, bs) {
                    self.assignedPaths(bs, out);
                }
            case ast.IfStatement ifs:
                self.assignedPaths(ifs.then, out);
                ast.BlockStatement? els = ifs.else;
                if (els != null) {
                    self.assignedPaths(els, out);
                }
            case ast.SwitchStatement sw:
                forEach(sw.cases, cl) {
                    self.assignedPaths(cl.body, out);
                }
            case ast.WhileStatement w:
                self.assignedPaths(w.body, out);
            case ast.ForStatement fo:
                ast.Statement? init = fo.init;
                if (init != null) {
                    self.assignedPaths(init, out);
                }
                ast.Statement? post = fo.post;
                if (post != null) {
                    self.assignedPaths(post, out);
                }
                self.assignedPaths(fo.body, out);
            case ast.ForEachStatement fe:
                self.assignedPaths(fe.body, out);
            default:
                out = out;
        }
        // A catch handler hangs off an expression, so a walk that follows only
        // statements misses what it assigns.
        forEach(ast.catchBlocks(s), b) {
            self.assignedPaths(b, out);
        }
    }

    // ---- collection passes ----

    // collectRecords registers every top-level record type first, because a
    // field can name any other record in any declaration order.
    void collectRecords(ast.Program prog) {
        Map<String, ast.TypeDeclStatement> decls = {};
        String[] order = [];    // declaration order, so diagnostics come out in it
        forEach(prog.statements, s) {
            ast.TypeDeclStatement? td = s as ast.TypeDeclStatement;
            if (td == null) {
                continue;
            }
            if (has(reserved, td.name)) {
                self.errorf(td.tok, "%s is a reserved name", quote.quote(td.name));
                continue;
            }
            if (builtinTypes[td.name] != null) {
                self.errorf(td.tok, "cannot redefine built-in type %s", quote.quote(td.name));
                continue;
            }
            if (self.aliasInUse(td.name)) {
                self.errorf(td.tok, "%s is already used as a module name", quote.quote(td.name));
                continue;
            }
            if (self.info.enums[td.name] != null) {
                self.errorf(td.tok, "%s is already declared as an enum", quote.quote(td.name));
                continue;
            }
            if (decls[td.name] != null) {
                self.errorf(td.tok, "type %s already declared", quote.quote(td.name));
                continue;
            }
            // Registers the type anyway. To drop it would hide this error
            // under an "unknown type" at every use.
            self.checkTypeName("type", td.name, td.tok);
            decls[td.name] = td;
            array.push(order, td.name);
            types.Record rec = {
                id: types.newID(), name: td.name, qual: self.qual, shown: self.shown, base: null,
                sealed: false, extenders: [], fields: [], methods: [],
            };
            self.info.records[td.name] = rec;
        }
        // An extending type is built from the members of its base, so it comes
        // after the base (§2.4). Everything below follows this order.
        Map<String, BaseType> bases = {};
        String[] sorted = self.extendsOrder(decls, order, bases);
        forEach(sorted, name) {
            ast.TypeDeclStatement? td2 = decls[name];
            types.Record? rec2 = self.info.records[name];
            if (td2 == null || rec2 == null) {
                continue;
            }
            rec2.sealed = td2.sealed;
            BaseType? base = bases[name];
            if (base != null) {
                types.Record br = self.baseRecord(base);
                rec2.base = br;
                self.checkSealedExtension(td2, rec2, base);
                // Each base field is copied and keeps its index, so the two
                // layouts agree on the prefix.
                forEach(br.fields, f) {
                    array.push(rec2.fields, f);
                }
            }
            self.buildRecordFields(rec2, td2.fields, name, td2.tok);
        }
        // Methods come after the fields of every record, because a signature
        // can name any record, its own included, in any declaration order.
        forEach(sorted, name2) {
            ast.TypeDeclStatement? td3 = decls[name2];
            types.Record? rec3 = self.info.records[name2];
            if (td3 == null || rec3 == null) {
                continue;
            }
            self.inheritMethods(td3, bases[name2]);
            self.buildRecordMethods(rec3, td3);
        }
    }

    // extendsOrder answers the declared names in an order where each type
    // follows the type it extends, and fills `bases`. It reports and drops a
    // clause that names no usable type, or that closes a cycle: the type is
    // then checked as if it extended nothing.
    String[] extendsOrder(Map<String, ast.TypeDeclStatement> decls, String[] order, Map<String, BaseType> bases) {
        Map<String, String> dropped = {};    // type -> why its clause was dropped
        forEach(order, name) {
            ast.TypeDeclStatement? td = decls[name];
            if (td == null) {
                continue;
            }
            BaseResult r = self.baseOf(td, decls);
            BaseType? b = r.base;
            if (b != null) {
                bases[name] = b;
            } else if (r.why != "") {
                dropped[name] = r.why;
            }
        }
        // state: 1 is on the chain under walk, 2 is complete.
        Map<String, int> state = {};
        String[] sorted = [];
        forEach(order, name2) {
            self.visitExtends(name2, [], state, sorted, bases, dropped);
        }
        // Reported here, and not where each was found, so the diagnostics stay
        // in declaration order.
        forEach(order, name3) {
            String? why = dropped[name3];
            ast.TypeDeclStatement? td3 = decls[name3];
            if (why != null && td3 != null) {
                ast.NamedType? ext = td3.extends;
                if (ext != null) {
                    self.errorf(ext.tok, "%s", why);
                }
            }
        }
        return sorted;
    }

    void visitExtends(String name, String[] chain, Map<String, int> state, String[] sorted,
        Map<String, BaseType> bases, Map<String, String> dropped) {
        int? st = state[name];
        if (st != null && st == 2) {
            return;
        }
        if (st != null && st == 1) {
            // Drop the clause of the declaration that closes the cycle.
            String last = chain[chain.length - 1];
            if (chain.length == 1) {
                dropped[last] = "type " + quote.quote(last) + " cannot extend itself";
            } else {
                dropped[last] = "type " + quote.quote(last) + " cannot extend " + quote.quote(name)
                    + ": " + string.join(cycleFrom(chain, name), " extends ") + " form a cycle";
            }
            map.remove(bases, last);
            return;
        }
        state[name] = 1;
        // Only a base declared in this file can wait for this one. An imported
        // base was built when the compiler checked that module.
        BaseType? base = bases[name];
        if (base != null && base.local) {
            String[] next = array.copy(chain);
            array.push(next, name);
            self.visitExtends(base.decl.name, next, state, sorted, bases, dropped);
        }
        state[name] = 2;
        array.push(sorted, name);
    }

    // checkSealedExtension applies the two rules of `sealed` (§2.4) and
    // registers rec as an extender when the clause is permitted. Assignability
    // to the base and switch coverage both need the extender set to be closed.
    void checkSealedExtension(ast.TypeDeclStatement td, types.Record rec, BaseType base) {
        types.Record? bOpt = rec.base;
        if (bOpt == null) {
            return;
        }
        types.Record b = bOpt;
        ast.NamedType? ext = td.extends;
        if (ext == null) {
            return;
        }
        // A type that extends a sealed type is a leaf. To extend it would put
        // values in the hierarchy that no `case` over the extenders names.
        types.Record? bb = b.base;
        if (bb != null && bb.sealed) {
            self.errorf(ext.tok, "type %s extends %s, which is sealed, so %s cannot itself be extended",
                quote.quote(td.name), types.typeString(bb), types.typeString(b));
            return;
        }
        if (!b.sealed) {
            return;
        }
        // A module cannot see which files import it, so an extender declared
        // outside it would leave the set open.
        if (!base.local) {
            self.errorf(ext.tok, "type %s is sealed: only the module declaring it can extend it", types.typeString(b));
            return;
        }
        array.push(b.extenders, rec);
    }

    // baseOf resolves the `extends` clause to the type it names, or gives the
    // reason it names nothing extendable. Both results are empty with no clause.
    BaseResult baseOf(ast.TypeDeclStatement td, Map<String, ast.TypeDeclStatement> decls) {
        ast.NamedType? extOpt = td.extends;
        if (extOpt == null) {
            return noBase();
        }
        ast.NamedType ext = extOpt;
        if (ext.module != "") {
            return self.importedBase(ext);
        }
        ast.TypeDeclStatement? base = decls[ext.name];
        if (base != null) {
            BaseType b = { decl: base, rec: null, qual: self.qual, local: true };
            return okBase(b);
        }
        if (builtinTypes[ext.name] != null) {
            return badBase("type " + quote.quote(ext.name) + " is built in and cannot be extended");
        }
        if (self.info.enums[ext.name] != null) {
            return badBase(quote.quote(ext.name) + " is an enum, and only a type declaration can be extended");
        }
        return badBase("unknown type " + quote.quote(ext.name));
    }

    // importedBase resolves an `extends alias.Type` clause. The named module
    // is already checked, so its record and its method bodies are complete.
    BaseResult importedBase(ast.NamedType ext) {
        ModuleRef? ref = self.info.moduleAliases[ext.module];
        if (ref == null) {
            if (has(builtinModules, ext.module) || has(builtinNioModules, ext.module)) {
                return badBase(ext.module + " is a built-in library; import it first");
            }
            return badBase("unknown module " + quote.quote(ext.module));
        }
        if (ref.builtin != "") {
            // A compiler-declared record has no method body to copy.
            return badBase("type " + ast.typeNodeString(ext) + " is built in and cannot be extended");
        }
        ModuleExports? expOpt = ref.exports;
        if (expOpt == null) {
            return badBase("unknown module " + quote.quote(ext.module));
        }
        ModuleExports exp = expOpt;
        types.Record? rec = exp.records[ext.name];
        ast.TypeDeclStatement? decl = exp.decls[ext.name];
        if (rec == null || decl == null) {
            if (exp.enums[ext.name] != null) {
                return badBase(ast.typeNodeString(ext) + " is an enum, and only a type declaration can be extended");
            }
            if (has(exp.names, ext.name)) {
                return badBase(quote.quote(ext.name) + " is not exported by module " + ext.module);
            }
            return badBase("module " + ext.module + " has no exported type " + quote.quote(ext.name));
        }
        BaseType b = { decl: decl, rec: rec, qual: exp.qual, local: false };
        return okBase(b);
    }

    // Gives td a copy of each base method it does not declare, and checks the
    // `override` modifier. The copies are rebuilt on each inference round, so
    // nothing collects across rounds.
    void inheritMethods(ast.TypeDeclStatement td, BaseType? base) {
        td.inherited = [];
        Map<String, bool> inherited = {};
        if (base != null) {
            Map<String, ast.FunctionDeclStatement> own = {};
            forEach(td.methods, md) {
                if (own[md.name] == null) {
                    own[md.name] = md;
                }
            }
            ast.Origin origin = { type: base.name(), qual: base.qual };
            forEach(base.decl.allMethods(), bm) {
                if (hasInt(self.nameTaken, bm.id)) {
                    continue;    // the base already rejected it; one report is enough
                }
                inherited[bm.name] = true;
                ast.FunctionDeclStatement? md2 = own[bm.name];
                if (md2 != null) {
                    if (!md2.override) {
                        self.errorf(md2.tok, "type %s inherits a method %s from %s: write `%s` to replace it",
                            quote.quote(td.name), quote.quote(bm.name), base.name(), overrideSpelling(md2));
                    }
                    continue;    // the type's own body wins, override or not
                }
                // The copy is checked and compiled as a method of td, with
                // `self` typed as td. An override is then visible to the
                // inherited bodies, and the receiver is rooted under its own
                // type.
                array.push(td.inherited, ast.cloneMethod(bm, td.name, origin));
            }
        }
        forEach(td.methods, md3) {
            if (!md3.override || has(inherited, md3.name)) {
                continue;
            }
            if (base == null) {
                self.errorf(md3.tok, "method %s overrides nothing: type %s extends no type",
                    quote.quote(md3.name), quote.quote(td.name));
            } else {
                self.errorf(md3.tok, "method %s overrides nothing: %s has no method %s",
                    quote.quote(md3.name), base.name(), quote.quote(md3.name));
            }
        }
    }

    // baseRecord answers the record an extends clause resolved to. A local base
    // is complete here, because a type is built after the type it extends.
    types.Record baseRecord(BaseType base) {
        if (base.local) {
            types.Record? r = self.info.records[base.decl.name];
            if (r != null) {
                return r;
            }
        }
        types.Record? rec = base.rec;
        if (rec != null) {
            return rec;
        }
        types.Record empty = {
            id: types.newID(), name: base.decl.name, qual: base.qual, shown: "", base: null,
            sealed: false, extenders: [], fields: [], methods: [],
        };
        return empty;
    }

    // buildRecordMethods resolves the signature of every method of a record,
    // inherited ones included: an inherited method belongs to this record. A
    // signature holds no receiver.
    void buildRecordMethods(types.Record rec, ast.TypeDeclStatement td) {
        forEach(td.allMethods(), md) {
            if (rec.fieldType(md.name) != null) {
                ast.Origin? from = md.from;
                if (from != null) {
                    self.errorf(td.tok, "type %s declares a field %s and inherits a method by that name from %s",
                        quote.quote(rec.name), quote.quote(md.name), from.type);
                } else if (inheritsField(rec, md.name)) {
                    types.Record? b = rec.base;
                    String bn = "";
                    if (b != null) {
                        bn = b.name;
                    }
                    self.errorf(md.tok, "type %s inherits a field %s from %s and cannot declare a method by that name",
                        quote.quote(rec.name), quote.quote(md.name), bn);
                } else {
                    self.errorf(md.tok, "type %s declares both a field and a method named %s",
                        quote.quote(rec.name), quote.quote(md.name));
                }
                self.nameTaken[md.id] = true;
                continue;
            }
            if (rec.methodSig(md.name) != null) {
                self.errorf(md.tok, "type %s already declares a method %s", quote.quote(rec.name), quote.quote(md.name));
                self.nameTaken[md.id] = true;
                continue;
            }
            // Fallibility is inferred, so the signature starts from the result
            // of the previous round. checkMethodDecl updates it as this round
            // finds raises.
            types.FuncType sig = types.newFuncType([], types.VoidT);
            sig.async = md.async;
            sig.fallible = has(self.seed, methodKey(rec.name, md.name));
            sig.noalloc = md.noalloc;
            // An inherited signature names types as the module that wrote it
            // does, including types that module never exported.
            HomeSave restore = self.enterInherited(md, td, rec.name);
            self.paramTypes(sig, md.params);
            ast.TypeNode? rt = md.returnType;
            if (rt != null) {
                sig.return = self.resolveType(rt);
            }
            self.leaveInherited(restore);
            self.checkOverride(rec, md, sig);
            types.Method m = { name: md.name, sig: sig };
            array.push(rec.methods, m);
        }
    }

    // checkOverride requires a replacement to keep the signature of the method
    // it replaces. Fallibility is not part of the comparison, because the
    // checker infers it from the body and the source never writes it.
    void checkOverride(types.Record rec, ast.FunctionDeclStatement md, types.FuncType sig) {
        types.Record? baseOpt = rec.base;
        if (!md.override || baseOpt == null) {
            return;
        }
        types.Record base = baseOpt;
        types.FuncType? bs = base.methodSig(md.name);
        if (bs == null || sameSignature(bs, sig)) {
            return;
        }
        self.errorf(md.tok, "override of %s.%s must keep its signature %s, not %s",
            base.name, md.name, types.typeString(bs), types.typeString(sig));
    }

    // buildRecordFields resolves the fields of a record body and rejects a
    // duplicate name. path names the record in diagnostics, and gives its
    // identity to an unnamed record type a field declares, such as Car.repairs.
    void buildRecordFields(types.Record rec, ast.FieldDef[] fields, String path, token.Token tok) {
        Map<String, bool> seen = {};
        Map<String, String> jsonKeys = {};    // JSON key -> the field that claimed it
        // The fields already present are the inherited ones (§2.4). They claim
        // their names and their JSON keys as the others do.
        forEach(rec.fields, f) {
            seen[f.name] = true;
            jsonKeys[f.jsonKey()] = f.name;
        }
        forEach(fields, f2) {
            if (has(seen, f2.name)) {
                types.Record? base = rec.base;
                if (base != null && base.fieldType(f2.name) != null) {
                    self.errorf(tok, "type %s inherits field %s from %s and cannot declare it again",
                        quote.quote(path), quote.quote(f2.name), base.name);
                    continue;
                }
                self.errorf(tok, "type %s has duplicate field %s", quote.quote(path), quote.quote(f2.name));
                continue;
            }
            seen[f2.name] = true;
            types.Field field = {
                name: f2.name, type: self.resolveTypeAt(f2.type, path + "." + f2.name),
                jsonName: "", jsonRest: false,
            };
            if (f2.rename == jsonRestTag) {
                // The catch-all field (§6.3) is not a key of its own, so it
                // claims no JSON name and joins no duplicate-key check.
                field.jsonRest = self.checkRestField(rec, f2, field.type, path);
            } else if (f2.rename != "") {
                field.jsonName = self.checkRename(f2);
            }
            if (!field.jsonRest) {
                String? owner = jsonKeys[field.jsonKey()];
                if (owner != null) {
                    self.errorf(tok, "type %s maps both %s and %s to the JSON key %s",
                        quote.quote(path), quote.quote(owner), quote.quote(f2.name), quote.quote(field.jsonKey()));
                } else {
                    jsonKeys[field.jsonKey()] = f2.name;
                }
            }
            array.push(rec.fields, field);
        }
    }

    // checkRestField validates a `'json*'` field (§6.3) and answers whether it
    // is one. A record can have one, and its type must be Json.
    bool checkRestField(types.Record rec, ast.FieldDef f, types.Type ft, String path) {
        if (!types.equal(ft, types.JsonT)) {
            self.errorf(f.renameTok, "a 'json*' field collects values of any shape, so it must be a Json, not %s",
                types.typeString(ft));
            return false;
        }
        int i = rec.restField();
        if (i >= 0) {
            self.errorf(f.renameTok, "type %s already collects unknown JSON keys into %s; a type may have only one 'json*' field",
                quote.quote(path), quote.quote(rec.fields[i].name));
            return false;
        }
        return true;
    }

    // checkRename validates one `'target:key'` field annotation and answers the
    // key it assigns. A bad annotation answers "", and the field then keeps its
    // declared name.
    String checkRename(ast.FieldDef f) {
        int cut = string.find(f.rename, ":");
        if (cut < 0) {
            self.errorf(f.renameTok, "field annotation %s is missing a target: write 'json:%s' to set the JSON key of %s",
                quote.quote(f.rename), f.rename, quote.quote(f.name));
            return "";
        }
        String target = string.substring(f.rename, 0, cut);
        String key = string.substring(f.rename, cut + 1, string.length(f.rename));
        if (!has(renameTargets, target)) {
            self.errorf(f.renameTok, "unknown annotation target %s in %s; the supported target is 'json'",
                quote.quote(target), quote.quote(f.rename));
            return "";
        }
        if (key == "") {
            self.errorf(f.renameTok, "'%s:' needs a key after the target, e.g. '%s:%s'", target, target, f.name);
            return "";
        }
        if (key == f.name) {
            self.errorf(f.renameTok, "%s renames %s to itself; drop the annotation",
                quote.quote(f.rename), quote.quote(f.name));
            return "";
        }
        return key;
    }

    // collectEnums registers every top-level enum declaration. An enum name
    // shares the type namespace with records, and an expression reaches a
    // member through it, so it must differ from every function and variable
    // name too. collectFuncs and checkVarDecl apply that second rule.
    void collectEnums(ast.Program prog) {
        forEach(prog.statements, s) {
            ast.EnumDeclStatement? ed = s as ast.EnumDeclStatement;
            if (ed == null) {
                continue;
            }
            if (has(reserved, ed.name)) {
                self.errorf(ed.tok, "%s is a reserved name", quote.quote(ed.name));
                continue;
            }
            if (builtinTypes[ed.name] != null) {
                self.errorf(ed.tok, "cannot redefine built-in type %s", quote.quote(ed.name));
                continue;
            }
            if (self.aliasInUse(ed.name)) {
                self.errorf(ed.tok, "%s is already used as a module name", quote.quote(ed.name));
                continue;
            }
            if (self.info.enums[ed.name] != null) {
                self.errorf(ed.tok, "enum %s already declared", quote.quote(ed.name));
                continue;
            }
            if (ed.members.length == 0) {
                self.errorf(ed.tok, "enum %s needs at least one member", quote.quote(ed.name));
            }
            self.checkTypeName("enum", ed.name, ed.tok);
            types.Enum en = { id: types.newID(), name: ed.name, qual: self.qual, shown: self.shown, members: [] };
            Map<String, bool> seen = {};
            forEach(ed.members, m) {
                if (has(seen, m.name)) {
                    self.errorf(m.tok, "enum %s has duplicate member %s", quote.quote(ed.name), quote.quote(m.name));
                    continue;
                }
                seen[m.name] = true;
                types.EnumMember em = { name: m.name, value: m.value };
                array.push(en.members, em);
            }
            self.info.enums[ed.name] = en;
        }
    }

    void collectFuncs(ast.Program prog) {
        forEach(prog.statements, s) {
            ast.FunctionDeclStatement? fd = s as ast.FunctionDeclStatement;
            if (fd == null) {
                continue;
            }
            if (has(reserved, fd.name)) {
                self.errorf(fd.tok, "%s is a reserved name", quote.quote(fd.name));
                continue;
            }
            if (self.aliasInUse(fd.name)) {
                self.errorf(fd.tok, "%s is already used as a module name", quote.quote(fd.name));
                continue;
            }
            if (self.info.enums[fd.name] != null) {
                self.errorf(fd.tok, "%s is already declared as an enum", quote.quote(fd.name));
                continue;
            }
            if (self.info.funcs[fd.name] != null) {
                self.errorf(fd.tok, "function %s already declared", quote.quote(fd.name));
                self.nameTaken[fd.id] = true;
                continue;
            }
            // Fallibility is inferred, so the signature starts from the result
            // of the previous round. checkFunctionDecl updates it as this round
            // finds raises.
            types.FuncType sig = types.newFuncType([], types.VoidT);
            sig.async = fd.async;
            sig.fallible = has(self.seed, fd.name);
            // noalloc is declared and never inferred (§2.12), so it is known
            // here and never changes.
            sig.noalloc = fd.noalloc;
            self.paramTypes(sig, fd.params);
            ast.TypeNode? rt = fd.returnType;
            if (rt != null) {
                sig.return = self.resolveType(rt);
            }
            self.info.funcs[fd.name] = sig;
            if (fd.extern) {
                self.checkExternDecl(fd, sig);
            }
        }
    }

    // checkExternDecl validates an extern declaration (§5.8). The signature
    // must be expressible at the C boundary, and the name is the C symbol, so
    // it must differ from every symbol a program already links.
    void checkExternDecl(ast.FunctionDeclStatement fd, types.FuncType sig) {
        if (sig.variadic) {
            self.errorf(fd.nameTok, "an extern function cannot be variadic");
        }
        if (str.hasPrefix(fd.name, "rt_") || fd.name == "main") {
            self.errorf(fd.nameTok, "extern function %s collides with the runtime: rt_* and main name what every program already links", quote.quote(fd.name));
        }
        forEach(fd.params, p, i) {
            if (!externOk(sig.params[i])) {
                self.errorf(p.tok, "%s cannot cross the C boundary: an extern parameter is one of the integer or float types, bool, String, or an array of those (§5.8)", types.typeString(sig.params[i]));
            }
        }
        if (!types.equal(sig.return, types.VoidT) && !externOk(sig.return)) {
            self.errorf(fd.nameTok, "%s cannot cross the C boundary: an extern function returns one of the integer or float types, bool, String, an array of those, or void (§5.8)", types.typeString(sig.return));
        }
        sig.extern = true;
        self.info.externs[fd.name] = sig;
    }

    // checkNative validates the form of a native statement (§5.8). The loader
    // holds the file system, so it is what checks that a source path exists.
    void checkNative(ast.NativeStatement ns) {
        if (ns.kind == "source") {
            if (!(str.hasSuffix(ns.value, ".c") || str.hasSuffix(ns.value, ".m") || str.hasSuffix(ns.value, ".h"))) {
                self.errorf(ns.valueTok, "a native source is a .c, .m or .h file; per-OS selection happens inside the file, with the preprocessor");
            }
            return;
        }
        if (ns.os != "" && ns.os != "darwin" && ns.os != "linux" && ns.os != "windows") {
            self.errorf(ns.tok, "unknown platform %s in native flags: one of darwin, linux, windows, or none to apply everywhere", quote.quote(ns.os));
        }
    }

    // paramTypes fills sig.params from a parameter list. A variadic parameter
    // resolves to an array of the written element type, and only sig.variadic
    // records the form. The call site reads that flag to find how many
    // arguments go into the array.
    void paramTypes(types.FuncType sig, ast.Param[] params) {
        forEach(params, p, i) {
            types.Type t = self.resolveType(p.type);
            if (p.variadic && i == params.length - 1) {
                t = types.newArray(t);
                sig.variadic = true;
            }
            array.push(sig.params, t);
        }
    }

    // ---- type annotations ----

    types.Type resolveType(ast.TypeNode tn) {
        return self.resolveTypeAt(tn, "");
    }

    // resolveTypeAt resolves a type annotation. path is the field path an
    // unnamed record type takes as its identity, and is empty outside a field.
    types.Type resolveTypeAt(ast.TypeNode tn, String path) {
        switch (tn) {
            case ast.NamedType t:
                if (t.module != "") {
                    return self.resolveQualifiedType(t);
                }
                types.Type? bt = builtinTypes[t.name];
                if (bt != null) {
                    return bt;
                }
                types.Record? rec = self.info.records[t.name];
                if (rec != null) {
                    return rec;
                }
                types.Enum? en = self.info.enums[t.name];
                if (en != null) {
                    return en;
                }
                // Spellings a reader can expect that name nothing: the lower
                // case form of a built-in type, and `date`, which is a module.
                // A declared type name starts with a capital (§1.4), so none
                // of them can mean anything else.
                String? fixed = typeNameGuesses[t.name];
                if (fixed != null) {
                    self.errorf(t.tok, "unknown type %s (did you mean %s?)", quote.quote(t.name), fixed);
                    return types.InvalidT;
                }
                self.errorf(t.tok, "unknown type %s", quote.quote(t.name));
                return types.InvalidT;
            case ast.ArrayTypeNode a:
                types.Type elem = self.resolveTypeAt(a.elem, path);
                ast.IntLiteral? size = a.size;
                if (size == null) {
                    return types.newArray(elem);
                }
                if (size.value < 1) {
                    self.errorf(size.tok, "a fixed-size array needs a positive size, got %s", string.from(size.value));
                    return types.newArray(elem);
                }
                return types.newFixedArray(elem, size.value);
            case ast.OptionalTypeNode o:
                types.Type inner = self.resolveTypeAt(o.inner, path);
                if ((inner as types.Optional) != null) {
                    self.errorf(o.tok, "optional of optional is not supported");
                    return inner;
                }
                return types.newOptional(inner);
            case ast.RecordTypeNode r:
                if (path == "") {
                    self.errorf(r.tok, "anonymous record types are only allowed as field types inside a type declaration");
                    return types.InvalidT;
                }
                types.Record anon = {
                    id: types.newID(), name: path, qual: self.qual, shown: self.shown, base: null,
                    sealed: false, extenders: [], fields: [], methods: [],
                };
                self.buildRecordFields(anon, r.fields, path, r.tok);
                return anon;
            case ast.FuncTypeNode f:
                types.FuncType sig = types.newFuncType([], types.VoidT);
                sig.fallible = f.fallible;
                sig.variadic = f.variadic;
                forEach(f.params, pt, i) {
                    types.Type p = self.resolveTypeAt(pt, "");
                    if (f.variadic && i == f.params.length - 1) {
                        p = types.newArray(p);
                    }
                    array.push(sig.params, p);
                }
                ast.TypeNode? frt = f.return;
                if (frt != null) {
                    sig.return = self.resolveTypeAt(frt, "");
                }
                return sig;
            case ast.FutureTypeNode fu:
                ast.TypeNode? el = fu.elem;
                if (el == null) {
                    return types.newFutureType(types.VoidT, fu.fallible);
                }
                return types.newFutureType(self.resolveTypeAt(el, ""), fu.fallible);
            case ast.MapTypeNode m:
                types.Type key = self.resolveTypeAt(m.key, "");
                if (!types.isInvalid(key) && !types.validMapKey(key)) {
                    self.errorf(m.key.tok, "%s cannot be a map key (keys are String, the integer types, bool, DateTime, Duration, and enums)",
                        types.typeString(key));
                }
                types.Type val = self.resolveTypeAt(m.value, "");
                types.Optional? vo = val as types.Optional;
                if (vo != null) {
                    // The map continues with the inner type, so one report is
                    // enough.
                    self.errorf(m.value.tok, "a map value cannot be optional: m[k] already yields %s? (use Map<%s, %s>)",
                        types.typeString(vo.inner), types.typeString(key), types.typeString(vo.inner));
                    val = vo.inner;
                }
                return types.newMapType(key, val);
        }
    }

    // Gives the type of `Union.Tag(v)`, or null when the callee is not that
    // form. It answers the union, not the member, so the result is usable
    // everywhere the union is. The argument is checked here because a function
    // literal must learn its contract (§2.9) before rule 7 could give it one.
    types.Type? unionCall(ast.CallExpression ex, ast.MemberExpression callee) {
        ast.Identifier? obj = callee.object as ast.Identifier;
        if (obj == null || self.info.moduleAliases[obj.name] != null) {
            return null;    // an alias wins: `mod.f(x)` is a call, not a union
        }
        types.Record? arm = self.info.records[ast.unionArmName(obj.name, callee.property)];
        if (arm == null) {
            return null;
        }
        types.Record? u = self.info.records[obj.name];
        if (u == null) {
            return null;
        }
        types.Type pt = arm.fields[0].type;
        if (ex.args.length != 1) {
            self.errorf(ex.tok, "%s.%s takes one argument, the %s it holds",
                obj.name, callee.property, types.typeString(pt));
            forEach(ex.args, a) {
                self.exprType(a, null);
            }
            return u;
        }
        types.Type at = self.exprType(ex.args[0], pt);
        if (!types.isInvalid(at) && !types.assignable(pt, at)) {
            self.errorf(ex.args[0].tok, "%s.%s holds %s: cannot use %s",
                obj.name, callee.property, types.typeString(pt), types.typeString(at));
        }
        self.info.unionCtors[ex.id] = arm;
        return u;
    }

    // unionArm resolves `Name.Tag` to the member a union generated for that
    // tag, and answers null when Name names no union. The caller then reads the
    // name as a module alias. A tag the union does not have is reported here,
    // because "unknown module" would be wrong.
    types.Type? unionArm(String name, String tag, token.Token tok) {
        types.Record? arm = self.info.records[ast.unionArmName(name, tag)];
        if (arm != null) {
            return arm;
        }
        types.Record? u = self.info.records[name];
        if (u == null || !u.sealed) {
            return null;
        }
        String[] tags = unionTagsOf(u);
        if (tags.length == 0) {
            return null;    // a hand-written sealed type: its members are types, not tags
        }
        self.errorf(tok, "union %s has no member tagged %s (it has %s)",
            name, quote.quote(tag), string.join(tags, ", "));
        return types.InvalidT;
    }

    // resolveQualifiedType resolves `alias.name` at a type position to an
    // exported record type of an imported module.
    types.Type resolveQualifiedType(ast.NamedType t) {
        // `Union.Tag` reads the same as `alias.Type`. The union lookup comes
        // first, because the alias reading has an error of its own to fall
        // back on.
        if (t.member == "") {
            types.Type? arm = self.unionArm(t.module, t.name, t.tok);
            if (arm != null) {
                return arm;
            }
        }
        ModuleRef? ref = self.info.moduleAliases[t.module];
        if (ref == null) {
            self.errorf(t.tok, "unknown module %s (missing import?)", quote.quote(t.module));
            return types.InvalidT;
        }
        if (ref.builtin != "") {
            types.Type? bt = builtinModuleTypes[ref.builtin + "." + t.name];
            if (bt != null) {
                return bt;
            }
            String[]? names = moduleTypeNames[ref.builtin];
            if (names == null) {
                self.errorf(t.tok, "%s is a built-in library and has no exported types", t.module);
            } else {
                self.errorf(t.tok, "built-in library %s has no exported type %s (available: %s)",
                    t.module, quote.quote(t.name), string.join(names, ", "));
            }
            return types.InvalidT;
        }
        ModuleExports? expOpt = ref.exports;
        if (expOpt == null) {
            self.errorf(t.tok, "unknown module %s (missing import?)", quote.quote(t.module));
            return types.InvalidT;
        }
        ModuleExports exp = expOpt;
        types.Record? rec = exp.records[t.name];
        if (rec != null) {
            if (t.member != "") {
                // `alias.Union.Tag`: the member was exported with the union,
                // under its generated name.
                types.Record? marm = exp.records[ast.unionArmName(t.name, t.member)];
                if (marm != null) {
                    return marm;
                }
                String[] tags = unionTagsOf(rec);
                if (tags.length == 0) {
                    self.errorf(t.tok, "%s.%s is not a union, so it has no member %s",
                        t.module, t.name, quote.quote(t.member));
                } else {
                    self.errorf(t.tok, "union %s.%s has no member tagged %s (it has %s)",
                        t.module, t.name, quote.quote(t.member), string.join(tags, ", "));
                }
                return types.InvalidT;
            }
            return rec;
        }
        types.Enum? en = exp.enums[t.name];
        if (en != null) {
            return en;
        }
        if (has(exp.names, t.name)) {
            self.errorf(t.tok, "%s is not exported by module %s", quote.quote(t.name), t.module);
        } else {
            self.errorf(t.tok, "module %s has no exported type %s", t.module, quote.quote(t.name));
        }
        return types.InvalidT;
    }

    // ---- statements ----

    void checkStatement(ast.Statement s) {
        switch (s) {
            case ast.TypeDeclStatement td:
                if (self.depth > 0) {
                    self.errorf(td.tok, "type declarations are only allowed at the top level");
                    return;
                }
                self.checkMethods(td);
            case ast.EnumDeclStatement ed:
                if (self.depth > 0) {
                    self.errorf(ed.tok, "enum declarations are only allowed at the top level");
                }
            case ast.FunctionDeclStatement fd:
                self.checkFunctionDecl(fd);
            case ast.VarDeclStatement vd:
                self.checkVarDecl(vd);
            case ast.AssignStatement a:
                types.Type tt = self.assignTargetType(a.target);
                types.Type vt = self.exprType(a.value, tt);
                if (!types.isInvalid(tt) && !types.isInvalid(vt) && !self.assignableTo(a, tt, vt)) {
                    self.errorf(a.value.tok, "cannot assign %s to %s",
                        types.typeString(vt), types.typeString(tt));
                    self.because(a.target.tok, "this is " + types.typeString(tt));
                }
                self.flowAssign(a.target, tt, vt);
            case ast.ReturnStatement r:
                self.checkReturn(r);
            case ast.IfStatement ifs:
                self.checkIf(ifs);
            case ast.SwitchStatement sw:
                self.checkSwitch(sw);
            case ast.WhileStatement w:
                self.checkWhile(w);
            case ast.ForStatement fo:
                self.checkFor(fo);
            case ast.IncDecStatement inc:
                self.checkIncDec(inc);
                String key = self.pathKey(inc.target);
                if (key != "") {
                    self.killFlowPath(key);
                    if (hasInt(self.info.narrowed, inc.target.id)) {
                        self.flow[key] = true;    // a bumped value is still present
                    }
                }
            case ast.ForEachStatement fe:
                self.checkForEach(fe);
            case ast.BreakStatement br:
                if (self.loopDepth == 0 && self.switchDepth == 0) {
                    self.errorf(br.tok, "break outside a loop or switch");
                }
            case ast.ContinueStatement co:
                if (self.loopDepth == 0) {
                    self.errorf(co.tok, "continue outside a loop");
                }
            case ast.BlockStatement blk:
                self.checkBlock(blk);
            case ast.ExpressionStatement es:
                // A catch at statement position loses its value, so its block
                // may fall through.
                ast.Expression? saved = self.catchStmt;
                self.catchStmt = es.expression;
                self.exprType(es.expression, null);
                self.catchStmt = saved;
            case ast.NativeStatement ns:
                if (self.depth > 0) {
                    self.errorf(ns.tok, "native declarations are only allowed at the top level");
                    return;
                }
                self.checkNative(ns);
            case ast.ImportStatement imp:
                return;
            case ast.ReExportStatement re:
                // checkReExports validated the top-level ones before any
                // statement ran, so that a collision is reported once rather
                // than per round of the fallibility fixpoint. A nested one it
                // never saw, and a surface is a property of the module.
                if (self.depth > 0) {
                    self.errorf(re.tok, "a re-export is only allowed at the top level");
                }
                return;
        }
    }

    // Checks a condition and answers what its truth and its falsehood prove.
    FlowFacts condNarrow(ast.Expression cond) {
        FlowFacts f = self.condFacts(cond);
        types.Type? ct = self.info.types[cond.id];
        if (ct != null && !types.isInvalid(ct) && !types.equal(ct, types.BoolT)) {
            self.errorf(cond.tok, "condition must be bool, got %s", types.typeString(ct));
        }
        return f;
    }

    // Checks a boolean expression and finds the paths that are non-null when it
    // is true, in tf, and when it is false, in ff. `&&` and `||` let the right
    // operand see what the left one proved. Each subexpression is checked once.
    FlowFacts condFacts(ast.Expression e) {
        FlowFacts out = { tf: {}, ff: {} };
        ast.PrefixExpression? pe = e as ast.PrefixExpression;
        if (pe != null && pe.operator == "!") {
            FlowFacts inner = self.condFacts(pe.right);
            types.Type? rtOpt = self.info.types[pe.right.id];
            types.Type rt = types.InvalidT;
            if (rtOpt != null) {
                rt = rtOpt;
            }
            if (types.isInvalid(rt)) {
                self.info.types[pe.id] = types.InvalidT;
                return out;
            }
            if (!types.equal(rt, types.BoolT)) {
                self.errorf(pe.tok, "operator ! is not defined on %s", types.typeString(rt));
                self.info.types[pe.id] = types.InvalidT;
                return out;
            }
            self.info.types[pe.id] = types.BoolT;
            FlowFacts swapped = { tf: inner.ff, ff: inner.tf };
            return swapped;
        }
        ast.InfixExpression? ie = e as ast.InfixExpression;
        if (ie != null && (ie.operator == "&&" || ie.operator == "||")) {
            FlowFacts left = self.condFacts(ie.left);
            Map<String, bool> saved = self.flow;
            if (ie.operator == "&&") {
                self.flow = withFacts(saved, left.tf);
            } else {
                self.flow = withFacts(saved, left.ff);
            }
            FlowFacts right = self.condFacts(ie.right);
            self.flow = saved;
            types.Type lt = types.InvalidT;
            types.Type? ltOpt = self.info.types[ie.left.id];
            if (ltOpt != null) {
                lt = ltOpt;
            }
            types.Type rt2 = types.InvalidT;
            types.Type? rtOpt2 = self.info.types[ie.right.id];
            if (rtOpt2 != null) {
                rt2 = rtOpt2;
            }
            if (types.isInvalid(lt) || types.isInvalid(rt2)) {
                self.info.types[ie.id] = types.InvalidT;
            } else if (!types.equal(lt, types.BoolT) || !types.equal(rt2, types.BoolT)) {
                self.errorf(ie.tok, "operator %s is not defined on %s and %s",
                    ie.operator, types.typeString(lt), types.typeString(rt2));
                self.info.types[ie.id] = types.InvalidT;
            } else {
                self.info.types[ie.id] = types.BoolT;
            }
            if (ie.operator == "&&") {
                FlowFacts andF = { tf: withFacts(left.tf, right.tf), ff: intersectFlow(left.ff, right.ff) };
                return andF;
            }
            FlowFacts orF = { tf: intersectFlow(left.tf, right.tf), ff: withFacts(left.ff, right.ff) };
            return orF;
        }
        if (ie != null && (ie.operator == "==" || ie.operator == "!=")) {
            self.exprType(e, null);
            self.comparisonFacts(ie, out.tf, out.ff);
            return out;
        }
        self.exprType(e, types.BoolT);
        return out;
    }

    // Takes narrowing facts from `==` and `!=`. A comparison with null proves
    // presence on one side, and a comparison with a value that cannot be null
    // proves presence on the equal side.
    void comparisonFacts(ast.InfixExpression ex, Map<String, bool> tf, Map<String, bool> ff) {
        bool eq = ex.operator == "==";
        types.Type lt = types.InvalidT;
        types.Type? ltOpt = self.info.types[ex.left.id];
        if (ltOpt != null) {
            lt = ltOpt;
        }
        types.Type rt = types.InvalidT;
        types.Type? rtOpt = self.info.types[ex.right.id];
        if (rtOpt != null) {
            rt = rtOpt;
        }
        bool lNull = types.equal(lt, types.NullT);
        bool rNull = types.equal(rt, types.NullT);

        if (lNull && rNull) {
            return;    // constant; nothing to learn
        }
        if (lNull || rNull) {
            // p == null is false when p is present, and p != null is true.
            Map<String, bool> presentSide = ff;
            if (!eq) {
                presentSide = tf;
            }
            ast.Expression operand = ex.left;
            if (lNull) {
                operand = ex.right;
            }
            forEach(self.optionalPaths(operand), k) {
                presentSide[k] = true;
            }
            return;
        }
        // p == v, where v is neither optional nor null: equality proves
        // presence.
        Map<String, bool> present = tf;
        if (!eq) {
            present = ff;
        }
        if ((rt as types.Optional) == null && !types.isInvalid(rt)) {
            forEach(self.optionalPaths(ex.left), k2) {
                present[k2] = true;
            }
        }
        if ((lt as types.Optional) == null && !types.isInvalid(lt)) {
            forEach(self.optionalPaths(ex.right), k3) {
                present[k3] = true;
            }
        }
    }

    // optionalPaths answers the flow keys of e and of every prefix whose type
    // is optional. `a?.b != null` narrows `a.b` and `a`, because the comparison
    // finds a value only when every link is present.
    String[] optionalPaths(ast.Expression e) {
        String[] out = [];
        ast.Expression cur = e;
        while (true) {
            types.Type? t = self.info.types[cur.id];
            if (t != null && (t as types.Optional) != null) {
                String k = self.pathKey(cur);
                if (k != "") {
                    array.push(out, k);
                }
            }
            ast.MemberExpression? mem = cur as ast.MemberExpression;
            if (mem != null) {
                cur = mem.object;
                continue;
            }
            ast.IndexExpression? idx = cur as ast.IndexExpression;
            if (idx != null) {
                cur = idx.left;
                continue;
            }
            return out;
        }
    }

    void checkVarDecl(ast.VarDeclStatement st) {
        types.Type t = self.resolveType(st.type);
        self.info.declTypes[st.id] = t;
        // `int? x = 1;` boxes what goes in, and so allocates, although the
        // source writes no optional expression (§2.12).
        if (self.noalloc != null && (t as types.Optional) != null) {
            self.reportAlloc(st.tok, "declaring %s optional means boxing what goes in it, which allocates", st.name);
        }
        if (st.exported && self.depth > 0) {
            self.errorf(st.tok, "export is only allowed at the top level");
        }
        if (has(reserved, st.name)) {
            self.errorf(st.tok, "%s is a reserved name", quote.quote(st.name));
            return;
        }
        if (self.aliasInUse(st.name)) {
            self.errorf(st.tok, "%s is already used as a module name", quote.quote(st.name));
            return;
        }
        if (self.info.funcs[st.name] != null) {
            self.errorf(st.tok, "%s is already declared as a function", quote.quote(st.name));
            return;
        }
        if (self.info.enums[st.name] != null) {
            // A variable with the name of the enum would hide its members.
            self.errorf(st.tok, "%s is already declared as an enum", quote.quote(st.name));
            return;
        }
        types.Type? vt = null;
        ast.Expression? val = st.value;
        if (val != null) {
            vt = self.exprType(val, t);
            types.Type vt2 = types.InvalidT;
            if (vt != null) {
                vt2 = vt;
            }
            if (!types.isInvalid(t) && !types.isInvalid(vt2) && !types.assignable(t, vt2)) {
                // At the value, which is the half of the disagreement the
                // reader is most likely to have written by mistake, with the
                // written type named as the other half.
                self.errorf(val.tok, "cannot use %s as %s in declaration of %s",
                    types.typeString(vt2), types.typeString(t), quote.quote(st.name));
                self.because(st.type.tok, "expected because of this type");
            }
        }
        Binding? had = self.scope.lookupHere(st.name);
        Binding? b = self.declareVarAt(st.name, t, st.const, self.depth == 0,
            declOf(DeclKind.VAR, st.id), st.nameTok);
        if (b == null) {
            self.errorf(st.nameTok, "%s already declared in this scope", quote.quote(st.name));
            if (had != null && had.at.line > 0) {
                self.because(had.at, "the first declaration is here");
            }
            return;
        }
        // `int? x = 5;` starts narrowed, as an assignment would leave it.
        if ((t as types.Optional) != null && valueProvesPresence(vt)) {
            self.flow[bindingKey(b)] = true;
        }
    }

    // flowAssign invalidates the target path and everything through it, and
    // narrows an optional target when the value cannot be null.
    void flowAssign(ast.Expression target, types.Type tt, types.Type vt) {
        String key = self.pathKey(target);
        if (key == "") {
            return;
        }
        self.killFlowPath(key);
        if ((tt as types.Optional) != null && valueProvesPresence(vt)) {
            self.flow[key] = true;
        }
    }

    void checkFunctionDecl(ast.FunctionDeclStatement st) {
        if (self.depth > 0) {
            self.errorf(st.tok, "function declarations are only allowed at the top level");
            return;
        }
        types.FuncType? sigOpt = self.info.funcs[st.name];
        if (sigOpt == null || hasInt(self.nameTaken, st.id)) {
            return;    // rejected at collection; already reported
        }
        types.FuncType sig = sigOpt;
        if (st.extern) {
            // No body: nothing to walk, nothing to infer, and no
            // initialization-order edges. An extern is never fallible.
            return;
        }
        self.scope = newScope(self.scope);
        self.declareParams(st.params, sig);
        // The body runs at call time, so no fact from the top-level flow
        // around it holds inside it.
        Map<String, bool> savedFlow = self.flow;
        self.flow = {};
        self.retType = sig.return;
        self.retTok = typeTokOr(st.returnType, st.tok);
        self.depth++;
        self.pushRaise(st.name);
        String savedOwner = self.owner;
        self.owner = ownerFn(st.name);
        NoallocCtx? savedNoalloc = self.enterNoalloc(st, st.name, sig);
        forEach(st.body.statements, bs) {
            self.checkStatement(bs);
        }
        self.noalloc = savedNoalloc;
        self.owner = savedOwner;
        if (self.popRaise()) {
            // An error escaped the body. Recording it on the shared signature
            // shows it to the rest of this round, and the fixpoint in
            // checkModule carries it to the earlier callers.
            self.fallible[st.name] = true;
            sig.fallible = true;
        }
        self.depth--;
        self.retType = null;
        self.flow = savedFlow;
        Scope? outer = self.scope.outer;
        if (outer != null) {
            self.scope = outer;
        }
    }

    // homeOf answers the module the free names of an inherited body belong to,
    // and null when that module is this one, which needs no exchange of tables.
    ModuleExports? homeOf(String qual) {
        if (qual == self.qual) {
            return null;
        }
        return self.homes[qual];
    }

    // Makes the checker resolve names as the module home does, and answers what
    // leaveHome needs. It exchanges the top-level scope and the name-keyed
    // tables of types, functions and import aliases. Everything keyed by an AST
    // node stays with this module, because the nodes under check are its own
    // copies, and its codegen reads their types back (§2.4).
    HomeSave enterHome(ModuleExports home) {
        HomeSave s = {
            active: true,
            records: self.info.records, enums: self.info.enums,
            funcs: self.info.funcs, aliases: self.info.moduleAliases,
            scope: self.scope, qual: self.qual, body: self.body, hadBody: false,
        };
        Info? hi = home.info;
        Scope? ht = home.top;
        if (hi != null) {
            self.info.records = hi.records;
            self.info.enums = hi.enums;
            self.info.funcs = hi.funcs;
            self.info.moduleAliases = hi.moduleAliases;
        }
        if (ht != null) {
            self.scope = ht;
        }
        self.qual = home.qual;
        return s;
    }

    void leaveHome(HomeSave s) {
        if (!s.active) {
            return;
        }
        self.info.records = s.records;
        self.info.enums = s.enums;
        self.info.funcs = s.funcs;
        self.info.moduleAliases = s.aliases;
        self.scope = s.scope;
        self.qual = s.qual;
    }

    // Checks the method bodies of a type declaration. A method sees the module
    // scope a function in its place would see.
    void checkMethods(ast.TypeDeclStatement st) {
        types.Record? recOpt = self.info.records[st.name];
        if (recOpt == null) {
            return;    // the type declaration was rejected; its methods have no receiver
        }
        types.Record rec = recOpt;
        forEach(st.allMethods(), md) {
            if (hasInt(self.nameTaken, md.id)) {
                continue;    // rejected at collection; already reported
            }
            types.FuncType? sig = rec.methodSig(md.name);
            if (sig != null) {
                HomeSave restore = self.enterInherited(md, st, rec.name);
                self.checkMethodDecl(md, rec, sig);
                self.leaveInherited(restore);
            }
        }
    }

    // enterInherited prepares the check of an inherited method body: its
    // diagnostic context, and the module where its free names resolve. It does
    // nothing for a method declared in place.
    HomeSave enterInherited(ast.FunctionDeclStatement md, ast.TypeDeclStatement td, String owner) {
        ast.Origin? from = md.from;
        if (from == null) {
            HomeSave none = {
                active: false, records: self.info.records, enums: self.info.enums,
                funcs: self.info.funcs, aliases: self.info.moduleAliases,
                scope: self.scope, qual: self.qual, body: self.body, hadBody: false,
            };
            return none;
        }
        InheritedBody body = {
            label: owner + "." + md.name + " (inherited from " + from.type + ")",
            source: "", at: td.tok,
        };
        HomeSave save = {
            active: false, records: self.info.records, enums: self.info.enums,
            funcs: self.info.funcs, aliases: self.info.moduleAliases,
            scope: self.scope, qual: self.qual, body: self.body, hadBody: true,
        };
        ModuleExports? home = self.homeOf(from.qual);
        if (home != null) {
            ast.NamedType? ext = td.extends;
            body.source = home.source;
            if (ext != null) {
                body.at = ext.tok;
            }
            HomeSave inner = self.enterHome(home);
            save.active = true;
            save.records = inner.records;
            save.enums = inner.enums;
            save.funcs = inner.funcs;
            save.aliases = inner.aliases;
            save.scope = inner.scope;
            save.qual = inner.qual;
        }
        self.body = body;
        return save;
    }

    void leaveInherited(HomeSave s) {
        self.leaveHome(s);
        if (s.hadBody) {
            self.body = s.body;
        }
    }

    // Checks one method body: a function body with one more binding, `self`.
    // A record is a reference, so writing `self.field` changes the receiver.
    void checkMethodDecl(ast.FunctionDeclStatement md, types.Record rec, types.FuncType sig) {
        self.scope = newScope(self.scope);
        // This binding comes before the parameters, so a parameter named
        // `self` reads as a duplicate and does not hide the receiver.
        ast.Param? recv = md.recv;
        DeclRef rd = noDecl();
        if (recv != null) {
            rd = declOf(DeclKind.PARAM, recv.id);
        }
        self.declareVar("self", rec, false, false, rd);
        self.declareParams(md.params, sig);
        // The body runs at call time, so no fact from the top-level flow
        // around it holds inside it.
        Map<String, bool> savedFlow = self.flow;
        self.flow = {};
        self.retType = sig.return;
        self.retTok = typeTokOr(md.returnType, md.tok);
        self.depth++;
        String key = methodKey(rec.name, md.name);
        self.pushRaise(key);
        String savedOwner = self.owner;
        self.owner = ownerMethod(key);
        NoallocCtx? savedNoalloc = self.enterNoalloc(md, key, sig);
        forEach(md.body.statements, bs) {
            self.checkStatement(bs);
        }
        self.noalloc = savedNoalloc;
        self.owner = savedOwner;
        if (self.popRaise()) {
            self.fallible[key] = true;
            sig.fallible = true;
        }
        self.depth--;
        self.retType = null;
        self.flow = savedFlow;
        Scope? outer = self.scope.outer;
        if (outer != null) {
            self.scope = outer;
        }
    }

    void declareParams(ast.Param[] params, types.FuncType sig) {
        forEach(params, p, i) {
            if (has(reserved, p.name)) {
                self.errorf(p.tok, "%s is a reserved name", quote.quote(p.name));
                continue;
            }
            if (self.aliasInUse(p.name)) {
                self.errorf(p.tok, "%s is already used as a module name", quote.quote(p.name));
                continue;
            }
            types.Type pt = types.InvalidT;
            if (i < sig.params.length) {
                pt = sig.params[i];
            }
            if (self.declareVar(p.name, pt, false, false, declOf(DeclKind.PARAM, p.id)) == null) {
                self.errorf(p.tok, "duplicate parameter %s", quote.quote(p.name));
            }
        }
    }

    void checkReturn(ast.ReturnStatement st) {
        types.Type? retOpt = self.retType;
        ast.Expression? val = st.value;
        if (retOpt == null) {
            self.errorf(st.tok, "return outside function");
            if (val != null) {
                self.exprType(val, null);
            }
            return;
        }
        types.Type ret = retOpt;
        bool isVoid = types.equal(ret, types.VoidT);
        if (val == null) {
            if (!isVoid) {
                self.errorf(st.tok, "missing return value (function returns %s)", types.typeString(ret));
            }
            return;
        }
        types.Type vt = self.exprType(val, ret);
        if (isRaise(ret, vt)) {
            // `return Error(...)`, and `return e` in a catch block, is a raise.
            // It leaves through the error channel, so it need not satisfy the
            // declared return type (§2.9).
            self.noteRaise(val);
            return;
        }
        if (isVoid) {
            self.errorf(st.tok, "unexpected return value in void function");
            return;
        }
        if (!types.isInvalid(vt) && !types.assignable(ret, vt)) {
            self.errorf(val.tok, "cannot return %s (function returns %s)",
                types.typeString(vt), types.typeString(ret));
            self.because(self.retTok, "expected because of this return type");
        }
    }

    // The truth of the condition reaches the then branch, and its falsehood the
    // else branch, and the code after the statement when the then branch always
    // returns. After it, only facts that survive every fall-through path hold.
    void checkIf(ast.IfStatement st) {
        FlowFacts f = self.condNarrow(st.cond);
        Map<String, bool> base = self.flow;

        self.flow = withFacts(base, f.tf);
        self.checkBlock(st.then);
        Map<String, bool> thenOut = self.flow;
        bool thenTerm = terminates(st.then);

        self.flow = withFacts(base, f.ff);
        Map<String, bool> elseOut = self.flow;
        bool elseTerm = false;
        ast.BlockStatement? els = st.else;
        if (els != null) {
            self.checkBlock(els);
            elseOut = self.flow;
            elseTerm = terminates(els);
        }

        if (thenTerm && elseTerm) {
            self.flow = copyFlow(base);    // unreachable; keep the plain state
        } else if (thenTerm) {
            self.flow = elseOut;
        } else if (elseTerm) {
            self.flow = thenOut;
        } else {
            self.flow = intersectFlow(thenOut, elseOut);
        }
    }

    // Checks `switch (e) { case IntLit n: ... }` (§4.9). Only a sealed subject
    // (§2.4) can have one, because only there is the set of extending types
    // known. With no `default`, the clauses must cover every extender, so a new
    // one is a compile error at every switch that does not handle it.
    void checkTypeSwitch(ast.SwitchStatement st) {
        types.Type subj = self.exprType(st.subject, null);
        types.Record? base = subj as types.Record;
        if (types.isInvalid(subj)) {
            base = null;
        } else if (base == null || !base.sealed) {
            self.errorf(st.subject.tok, "cannot switch on the type of %s: only a sealed type has a known set of types extending it",
                types.typeString(subj));
            base = null;
        }

        Map<int, bool> covered = {};
        Map<int, types.Record> clauseType = {};
        forEach(st.cases, cl, i) {
            if (cl.typeName == null) {
                if (!cl.default) {
                    self.errorf(cl.tok, "this switch matches types, so its clauses cannot also match values");
                }
                continue;
            }
            types.Record? ext = self.resolveCaseType(cl, base);
            if (ext == null) {
                continue;
            }
            if (hasInt(covered, ext.id)) {
                ast.NamedType? tn = cl.typeName;
                if (tn != null) {
                    self.errorf(tn.tok, "type %s is already matched by an earlier clause", types.typeString(ext));
                }
                continue;
            }
            covered[ext.id] = true;
            clauseType[i] = ext;
            self.info.caseTypes[cl.id] = ext;    // codegen reads the resolved type here
            types.Type? pay = unionPayload(ext);
            if (pay != null) {
                self.info.casePayloads[cl.id] = pay;
            }
        }

        if (base != null) {
            String[] missing = [];
            forEach(base.extenders, ext2) {
                if (!hasInt(covered, ext2.id)) {
                    array.push(missing, types.typeString(ext2));
                }
            }
            if (missing.length > 0 && !st.hasDefault()) {
                self.errorf(st.tok, "this switch does not cover every type extending %s: add %s, or a default clause",
                    types.typeString(base), string.join(missing, ", "));
            } else if (missing.length == 0 && st.hasDefault()) {
                self.errorf(st.tok, "every type extending %s is already matched, so this switch's default clause can never run",
                    types.typeString(base));
            } else {
                st.exhaustive = missing.length == 0;
            }
        }

        Map<String, bool> base2 = self.flow;
        Map<String, bool> kills = {};
        forEach(st.cases, cl2) {
            self.assignedPaths(cl2.body, kills);
        }
        forEach(st.cases, cl3, i2) {
            self.flow = copyFlow(base2);
            self.scope = newScope(self.scope);
            if (cl3.typeName != null) {
                types.Type t = types.InvalidT;
                types.Record? ct = clauseType[i2];
                if (ct != null) {
                    t = ct;
                }
                self.declareCaseBinding(cl3, t);
            }
            self.switchDepth++;
            self.checkBlock(cl3.body);
            self.switchDepth--;
            Scope? outer = self.scope.outer;
            if (outer != null) {
                self.scope = outer;
            }
        }
        self.flow = flowMinus(base2, kills);
    }

    // resolveCaseType resolves the label of a type case to an extender of base.
    types.Record? resolveCaseType(ast.SwitchCase cl, types.Record? base) {
        ast.NamedType? tnOpt = cl.typeName;
        if (tnOpt == null) {
            return null;
        }
        ast.NamedType tn = tnOpt;
        types.Type t = self.resolveTypeAt(tn, "");
        if (types.isInvalid(t)) {
            return null;
        }
        types.Record? ext = t as types.Record;
        if (ext == null) {
            self.errorf(tn.tok, "a type case matches a type extending the subject's, and %s is not one", types.typeString(t));
            return null;
        }
        if (base == null) {
            return null;    // the subject was already reported; one message is enough
        }
        if (!ext.extends(base)) {
            self.errorf(tn.tok, "cannot match %s here: %s", types.typeString(ext), extendersOf(base));
            return null;
        }
        return ext;
    }

    void declareCaseBinding(ast.SwitchCase cl, types.Type t) {
        if (has(reserved, cl.bind)) {
            self.errorf(cl.tok, "%s is a reserved name", quote.quote(cl.bind));
            return;
        }
        if (self.aliasInUse(cl.bind)) {
            self.errorf(cl.tok, "%s is already used as a module name", quote.quote(cl.bind));
            return;
        }
        // A union member binds what it carries and not the record around it:
        // `case Text.Bytes b:` binds the `byte[]`.
        types.Type bt = t;
        types.Record? r = t as types.Record;
        if (r != null) {
            types.Type? pay = unionPayload(r);
            if (pay != null) {
                bt = pay;
            }
        }
        self.declareVar(cl.bind, bt, false, false, declOf(DeclKind.CASE_BIND, cl.id));
    }

    // checkSwitch types `switch (subject) { case v: ... default: ... }` (§4.9).
    // Each label is matched with the rules of `==` (§3.2), so a label the
    // subject can never equal is a type error. One clause runs at most, so no
    // fact from a clause survives: what holds after the switch is what held
    // before, less every path a clause assigns.
    void checkSwitch(ast.SwitchStatement st) {
        if (st.isTypeSwitch()) {
            self.checkTypeSwitch(st);
            return;
        }
        // `case null:` asks whether the subject is absent, so the subject keeps
        // its optional type even where the flow narrowed it. infixType makes
        // the same exception for `x == null`.
        if (hasNullCase(st)) {
            self.noNarrow = st.subject;
        }
        types.Type subj = self.exprType(st.subject, null);
        self.noNarrow = null;
        if (types.isInvalid(subj)) {
            subj = subj;
        } else if (types.equal(subj, types.NullT) || !self.equalityOK(subj, subj)) {
            self.errorf(st.subject.tok, "cannot switch on %s: clauses are matched with ==, which is not defined on it",
                types.typeString(subj));
            subj = types.InvalidT;
        }

        Map<String, bool> seen = {};
        forEach(st.cases, cl) {
            forEach(cl.values, v) {
                self.checkCaseValue(v, subj, seen);
            }
        }

        Map<String, bool> base = self.flow;
        Map<String, bool> kills = {};
        forEach(st.cases, cl2) {
            self.assignedPaths(cl2.body, kills);
        }
        forEach(st.cases, cl3) {
            // Each clause starts from the state before the switch: no other
            // clause ran, and a constant label changes nothing.
            self.flow = copyFlow(base);
            self.switchDepth++;
            self.checkBlock(cl3.body);
            self.switchDepth--;
        }
        self.flow = flowMinus(base, kills);
    }

    void checkCaseValue(ast.Expression v, types.Type subj, Map<String, bool> seen) {
        // The comparison uses the value inside an optional subject, so a
        // literal label takes its type from that value.
        types.Type? expect = null;
        if (!types.isInvalid(subj)) {
            expect = subj;
            types.Optional? opt = subj as types.Optional;
            if (opt != null) {
                expect = opt.inner;
            }
        }
        types.Type vt = self.exprType(v, expect);
        if (types.isInvalid(vt)) {
            return;
        }
        vt = self.durationLit("==", v, vt, subj);
        if (!types.isInvalid(subj) && !self.equalityOK(subj, vt)) {
            self.errorf(v.tok, "cannot compare case value %s with the switch subject's %s",
                types.typeString(vt), types.typeString(subj));
            return;
        }
        String k = self.caseConstOf(v);
        if (k == "") {
            self.errorf(v.tok, "a case value must be a constant: a literal, a negated number, null, or an enum member");
            return;
        }
        if (has(seen, k)) {
            self.errorf(v.tok, "duplicate case value %s", ast.exprString(v));
            return;
        }
        seen[k] = true;
    }

    // caseConstOf answers the constant value of a case label, and "" when it
    // has none. Two labels with the same constant are duplicates.
    String caseConstOf(ast.Expression e) {
        switch (e) {
            case ast.IntLiteral i:
                return caseInt(i.value);
            case ast.FloatLiteral f:
                return caseFloat(f.value);
            case ast.StringLiteral s:
                return caseString(s.value);
            case ast.BoolLiteral b:
                if (b.value) {
                    return caseInt(1);
                }
                return caseInt(0);
            case ast.NullLiteral n:
                return caseNull;
            case ast.PrefixExpression p:
                if (p.operator != "-") {
                    return "";
                }
                ast.IntLiteral? ri = p.right as ast.IntLiteral;
                if (ri != null) {
                    return caseInt(-ri.value);
                }
                ast.FloatLiteral? rf = p.right as ast.FloatLiteral;
                if (rf != null) {
                    return caseFloat(-rf.value);
                }
                return "";
            case ast.MemberExpression m:
                // An enum member is a constant, resolved when this expression
                // was typed.
                int? v = self.info.enumMembers[m.id];
                if (v != null) {
                    return caseInt(v);
                }
                return "";
            default:
                return "";
        }
    }

    // A fact from outside holds in the body, or after the loop, only when it
    // survives every iteration, so the paths the body assigns go first. The
    // facts of the condition are safe in the body. Their negation holds after
    // the loop only when a false condition is the only way out, so a `break`
    // removes it.
    void checkWhile(ast.WhileStatement st) {
        Map<String, bool> kills = {};
        self.assignedPaths(st.body, kills);
        Map<String, bool> base = flowMinus(self.flow, kills);

        self.flow = base;
        FlowFacts f = self.condNarrow(st.cond);
        self.flow = withFacts(base, f.tf);
        self.loopDepth++;
        self.checkBlock(st.body);
        self.loopDepth--;
        Map<String, bool> ff = f.ff;
        if (breaksOut(st.body)) {
            ff = {};
        }
        self.flow = withFacts(base, ff);
    }

    // checkFor types `for (init; cond; post) { ... }`. A variable the init
    // clause declares lives in a scope of its own that the body shares: it can
    // hide an outer name, and it leaves scope at the end of the loop. The post
    // clause is checked before the body, so it sees only the init variable and
    // the outer names. Narrowing follows checkWhile.
    void checkFor(ast.ForStatement st) {
        self.scope = newScope(self.scope);
        self.depth++;
        ast.Statement? init = st.init;
        if (init != null) {
            self.checkStatement(init);
        }
        Map<String, bool> kills = {};
        self.assignedPaths(st.body, kills);
        ast.Statement? post = st.post;
        if (post != null) {
            self.assignedPaths(post, kills);
        }
        Map<String, bool> base = flowMinus(self.flow, kills);

        self.flow = base;
        FlowFacts f = self.condNarrow(st.cond);
        if (post != null) {
            // The post clause runs after an iteration the checker cannot name,
            // so only the base without the assigned paths holds there.
            self.checkStatement(post);
            self.flow = base;
        }
        self.flow = withFacts(base, f.tf);
        self.loopDepth++;
        forEach(st.body.statements, bs) {
            self.checkStatement(bs);
        }
        self.loopDepth--;
        Map<String, bool> ff = f.ff;
        if (breaksOut(st.body)) {
            ff = {};    // a break leaves with the condition still true
        }
        self.flow = withFacts(base, ff);
        self.depth--;
        Scope? outer = self.scope.outer;
        if (outer != null) {
            self.scope = outer;
        }
    }

    // assignableTo is types.assignable (§2.10) plus the conversion an
    // assignment into a Json makes. What a program may write is what
    // json.toText accepts (§6.3), so both places report the same reason.
    bool assignableTo(ast.AssignStatement st, types.Type target, types.Type value) {
        if (types.assignable(target, value)) {
            return true;
        }
        if (!types.equal(target, types.JsonT)) {
            return false;
        }
        if ((st.target as ast.IndexExpression) == null) {
            return false;    // a whole Json variable takes only a Json
        }
        self.checkJSONWritable(st.value, value, "store in a Json");
        return true;    // checkJSONWritable reports the specific reason if there is one
    }

    // Reports why a value cannot go into a document. The set that fits is the
    // set json.toText accepts (§6.3), so there is no second list.
    void checkJSONWritable(ast.Expression at, types.Type t, String what) {
        if (types.isInvalid(t) || types.equal(t, types.NullT)) {
            // JSON null: the key is present and holds nothing, unlike a key
            // that json.remove left absent.
            return;
        }
        if (types.equal(t, types.VoidT)) {
            self.errorf(at.tok, "cannot %s: %s is not a value", what, types.typeString(t));
            return;
        }
        if (containsFuture(t)) {
            self.errorf(at.tok, "cannot %s %s: futures have no JSON form (await the value first)", what, types.typeString(t));
            return;
        }
        if (badJSONMapKey(t)) {
            self.errorf(at.tok, "cannot %s %s: JSON object keys are strings, so only Map<String, ...> has a JSON form",
                what, types.typeString(t));
            return;
        }
        if (!jsonSerializable(t)) {
            self.errorf(at.tok, "cannot %s %s: function values have no JSON form", what, types.typeString(t));
        }
    }

    // checkIncDec types `target++;` and `target--;`. A narrowed `int?` or
    // `float?` qualifies: the code reads the inner value and stores a new one.
    void checkIncDec(ast.IncDecStatement st) {
        types.Type tt = self.assignTargetType(st.target);
        if (types.isInvalid(tt)) {
            return;
        }
        ast.IndexExpression? idx = st.target as ast.IndexExpression;
        if (idx != null) {
            types.Type? lt = self.info.types[idx.left.id];
            if (lt != null) {
                types.Type u = types.unwrap(lt);
                if ((u as types.MapType) != null) {
                    self.errorf(st.tok, "cannot %s a map entry (the key may be absent); read m[k] into a variable and store it back", st.op);
                    return;
                }
                if (types.equal(u, types.JsonT)) {
                    self.errorf(st.tok, "cannot %s a Json member (it may be missing, or not a number); read it with json.asInt and store the result back", st.op);
                    return;
                }
            }
        }
        types.Optional? opt = tt as types.Optional;
        if (opt != null) {
            String key = self.pathKey(st.target);
            if (key != "" && has(self.flow, key)) {
                self.info.narrowed[st.target.id] = true;
                self.info.types[st.target.id] = opt.inner;
                tt = opt.inner;
            }
        }
        if (types.isNarrow(tt)) {
            self.errorf(st.tok, "operator %s is not defined on %s (%s arithmetic widens to %s)",
                st.op, types.typeString(tt), types.typeString(tt), types.typeString(types.widen(tt)));
            return;
        }
        // The narrow types are gone, so every number type left can hold the
        // result of adding one.
        if (types.natural(tt) == null) {
            self.errorf(st.tok, "operator %s is not defined on %s", st.op, types.typeString(tt));
        }
    }

    // checkForEach types `forEach (array, elem[, index]) { ... }`. The element
    // and index bindings live in a scope of their own, so they can hide an
    // outer name and the body cannot declare them again.
    void checkForEach(ast.ForEachStatement st) {
        types.Type at = self.exprType(st.array, null);
        types.Type elemT = types.InvalidT;
        types.Array? arr = at as types.Array;
        if (arr != null) {
            elemT = arr.elem;
        } else if (types.equal(at, types.StringT)) {
            // A walk over code points (§4.7): the element is the point, an
            // int, and the index is the byte offset it starts at.
            elemT = types.IntT;
        } else if ((at as types.MapType) != null) {
            self.errorf(st.array.tok, "forEach iterates over an array; iterate a map through its keys: forEach(map.keys(m), key) { ... }");
        } else if (!types.isInvalid(at)) {
            self.errorf(st.array.tok, "forEach iterates over an array, got %s", types.typeString(at));
        }
        // As in a while body, a fact from outside holds inside the loop, and
        // after it, only when no iteration assigns its path.
        Map<String, bool> kills = {};
        self.assignedPaths(st.body, kills);
        self.flow = flowMinus(self.flow, kills);

        self.scope = newScope(self.scope);
        self.declareLoopBinding(st.elemTok, st.elemName, elemT, declOf(DeclKind.FOREACH_ELEM, st.id));
        if (st.indexName != "") {
            self.declareLoopBinding(st.indexTok, st.indexName, types.IntT, declOf(DeclKind.FOREACH_INDEX, st.id));
        }
        self.depth++;
        self.loopDepth++;
        Map<String, bool> body = copyFlow(self.flow);
        self.flow = body;
        forEach(st.body.statements, bs) {
            self.checkStatement(bs);
        }
        self.loopDepth--;
        self.flow = flowMinus(body, kills);
        self.depth--;
        Scope? outer = self.scope.outer;
        if (outer != null) {
            self.scope = outer;
        }
    }

    // declareLoopBinding applies the naming rules a function parameter uses.
    void declareLoopBinding(token.Token tok, String name, types.Type t, DeclRef decl) {
        if (has(reserved, name)) {
            self.errorf(tok, "%s is a reserved name", quote.quote(name));
            return;
        }
        if (self.aliasInUse(name)) {
            self.errorf(tok, "%s is already used as a module name", quote.quote(name));
            return;
        }
        if (self.declareVar(name, t, false, false, decl) == null) {
            self.errorf(tok, "forEach bindings must have distinct names (%s is used twice)", quote.quote(name));
        }
    }

    void checkBlock(ast.BlockStatement b) {
        self.scope = newScope(self.scope);
        self.depth++;
        forEach(b.statements, s) {
            self.checkStatement(s);
        }
        self.depth--;
        Scope? outer = self.scope.outer;
        if (outer != null) {
            self.scope = outer;
        }
    }

    types.Type assignTargetType(ast.Expression target) {
        switch (target) {
            case ast.Identifier t:
                Binding? b = self.scope.lookupBinding(t.name);
                if (b == null) {
                    if (has(reserved, t.name)) {
                        self.errorf(t.tok, "cannot assign to %s", quote.quote(t.name));
                    } else if (self.aliasInUse(t.name)) {
                        self.errorf(t.tok, "cannot assign to module %s", quote.quote(t.name));
                    } else if (self.info.funcs[t.name] != null) {
                        self.errorf(t.tok, "cannot assign to function %s", quote.quote(t.name));
                    } else if (self.info.enums[t.name] != null) {
                        self.errorf(t.tok, "cannot assign to enum %s", quote.quote(t.name));
                    } else if (!self.missingImport(t.tok, t.name)) {
                        self.errorf(t.tok, "undefined: %s", t.name);
                    }
                    return types.InvalidT;
                }
                if (b.isConst) {
                    self.errorf(t.tok, "cannot assign to %s: it is declared const", quote.quote(t.name));
                    return types.InvalidT;
                }
                self.recordUse(t.name, b);
                self.info.types[t.id] = b.t;
                return b.t;
            case ast.IndexExpression ix:
                types.Type tt = self.indexTypeEx(ix, true);
                if (hasInt(self.chainOpt, ix.id)) {
                    self.errorf(ix.tok, "cannot assign through ?.");
                    return types.InvalidT;
                }
                return tt;
            case ast.MemberExpression m:
                ast.Identifier? id = m.object as ast.Identifier;
                if (id != null) {
                    ModuleRef? ref = self.info.moduleAliases[id.name];
                    if (ref != null) {
                        if (m.optional) {
                            self.errorf(m.tok, "?. cannot be used on module %s; write %s.%s", id.name, id.name, m.property);
                            return types.InvalidT;
                        }
                        return self.moduleAssignTargetType(m, id.name, ref);
                    }
                }
                types.Type mt = self.memberTypeEx(m, true);
                // The only member of an array or a map is length, which a
                // program can read and cannot write.
                types.Type? ot = self.info.types[m.object.id];
                if (ot != null) {
                    if ((ot as types.Array) != null) {
                        self.errorf(m.tok, "cannot assign to array length");
                        return types.InvalidT;
                    }
                    if ((ot as types.MapType) != null) {
                        self.errorf(m.tok, "cannot assign to map length");
                        return types.InvalidT;
                    }
                }
                return mt;
            default:
                self.errorf(target.tok, "invalid assignment target");
                return types.InvalidT;
        }
    }

    // moduleAssignTargetType types `alias.name = value`, an assignment to an
    // exported variable of an imported module.
    types.Type moduleAssignTargetType(ast.MemberExpression t, String alias, ModuleRef ref) {
        if (ref.builtin != "") {
            self.errorf(t.tok, "cannot assign to %s.%s: %s is a built-in library", alias, t.property, alias);
            return types.InvalidT;
        }
        ModuleExports? expOpt = ref.exports;
        if (expOpt == null) {
            return types.InvalidT;
        }
        ModuleExports exp = expOpt;
        types.Type? vt = exp.vars[t.property];
        if (vt != null) {
            if (has(exp.consts, t.property)) {
                self.errorf(t.tok, "cannot assign to %s.%s: it is declared const", alias, t.property);
                return types.InvalidT;
            }
            self.info.types[t.id] = vt;
            return vt;
        }
        if (exp.funcs[t.property] != null) {
            self.errorf(t.tok, "cannot assign to function %s.%s", alias, t.property);
            return types.InvalidT;
        }
        if (exp.enums[t.property] != null) {
            self.errorf(t.tok, "cannot assign to %s.%s: it is a type", alias, t.property);
            return types.InvalidT;
        }
        self.moduleNoMemberError(t.tok, alias, ref, t.property);
        return types.InvalidT;
    }

    void moduleNoMemberError(token.Token tok, String alias, ModuleRef ref, String name) {
        ModuleExports? exp = ref.exports;
        if (exp != null && has(exp.names, name)) {
            self.errorf(tok, "%s is not exported by module %s", quote.quote(name), alias);
        } else {
            self.errorf(tok, "module %s has no exported name %s", alias, quote.quote(name));
        }
    }

    // ---- expressions ----

    // exprType finds and records the type of e. expected gives a literal its
    // context: a record literal, an empty array, a narrow number range.
    types.Type exprType(ast.Expression e, types.Type? expected) {
        types.Type t = self.typeOf(e, self.unionExpectation(e, expected));
        t = self.unionWrap(e, t, expected);
        self.info.types[e.id] = t;
        if (self.noalloc != null) {
            self.noteAlloc(e, t);
        }
        return t;
    }

    // Opens the §2.12 context for a body declared noalloc, and answers what to
    // put back. A body without the modifier clears the context rather than
    // inheriting it: a function literal is a different body, called later. The
    // signature comes in as an argument, because a method's label `Type.name`
    // is not in info.funcs.
    NoallocCtx? enterNoalloc(ast.FunctionDeclStatement st, String label, types.FuncType sig) {
        NoallocCtx? saved = self.noalloc;
        if (!st.noalloc) {
            self.noalloc = null;
            return saved;
        }
        if (st.async) {
            self.errorf(st.tok, "%s cannot be both async and noalloc: an async function allocates the frame its locals live in before its body runs", label);
            self.noalloc = null;
            return saved;
        }
        NoallocCtx ctx = { name: label, reported: false };
        self.noalloc = ctx;
        // An optional in the signature boxes at the boundary: the caller boxes
        // an argument, and a `return v` that widens boxes here. Neither is an
        // expression with an optional type, so noteAlloc cannot see them.
        if ((sig.return as types.Optional) != null) {
            self.errorf(st.tok, "%s is declared noalloc, but returning an optional means boxing the value, which allocates", label);
            ctx.reported = true;
        } else {
            forEach(sig.params, p, i) {
                if ((p as types.Optional) != null && !ctx.reported && i < st.params.length) {
                    self.errorf(st.params[i].tok, "%s is declared noalloc, but an optional parameter means its caller boxes the value, which allocates", label);
                    ctx.reported = true;
                }
            }
        }
        return saved;
    }

    // Reports e when evaluating it allocates, in a body that declared it does
    // not (§2.12). The switch below carries no `default:`, like the ones in
    // find.nio and astwalk.nio: a new expression kind must be a compile error
    // here, and must not join the allocation-free side without a decision.
    void noteAlloc(ast.Expression e, types.Type t) {
        NoallocCtx? ctx = self.noalloc;
        if (ctx == null || ctx.reported) {
            return;
        }
        // An optional is a pointer to a box, so producing one allocates. This
        // one rule replaces a rule at each site codegen boxes: an assignment,
        // a map read, an argument, a widened return.
        if ((t as types.Optional) != null) {
            self.reportAlloc(e.tok, "an optional holds its value in a box, which has to be allocated");
            return;
        }
        switch (e) {
            // Values that already exist. A string literal is a constant emitted
            // with the program (GC_STATIC), not a string built here.
            case ast.IntLiteral il:
                return;
            case ast.FloatLiteral fl:
                return;
            case ast.StringLiteral sl:
                return;
            case ast.BoolLiteral bl:
                return;
            case ast.NullLiteral nl:
                return;
            case ast.Identifier id:
                return;
            case ast.PrefixExpression pe:
                return;    // -x, !x and ~x are each one instruction
            case ast.InfixExpression ie:
                // The only operator that allocates is `+` on strings. The
                // result type finds it: `a == b` on two strings gives a bool.
                if (types.equal(t, types.StringT)) {
                    self.reportAlloc(e.tok, "joining strings allocates the new one");
                }
                return;
            case ast.IndexExpression ix:
                // a[i] and s[i] read a slot the caller already owns. A map read
                // gives V?, which the optional test above already found.
                return;
            case ast.MemberExpression m:
                // A field read, or `.length`: both read memory in place.
                return;
            case ast.AsExpression ax:
                // A number conversion is a truncate or an extend.
                if (!hasInt(self.info.numericAs, ax.id)) {
                    self.reportAlloc(e.tok, "'as' on anything but a number reads a document or narrows a record");
                }
                return;
            case ast.CallExpression call:
                self.noteAllocCall(call);
                return;
            case ast.ArrayLiteral al:
                self.reportAlloc(e.tok, "an array literal allocates the array");
                return;
            case ast.RecordLiteral rl:
                self.reportAlloc(e.tok, "a record literal allocates the record");
                return;
            case ast.MapLiteral ml:
                self.reportAlloc(e.tok, "a map literal allocates the map");
                return;
            case ast.FuncLit fn:
                self.reportAlloc(e.tok, "a function value allocates the block holding what it captured");
                return;
            case ast.AwaitExpr aw:
                self.reportAlloc(e.tok, "an async call allocates the frame its locals live in");
                return;
            case ast.CatchExpr ce:
                self.reportAlloc(e.tok, "an Error is a record, so raising one allocates it");
                return;
        }
    }

    // noteAllocCall is the call case of noteAlloc, the only case whose answer
    // depends on more than the shape of the node. A call allocates nothing when
    // it reaches a function or method declared `noalloc`, or an alloc-free
    // built-in. A call through a function value is always refused: noalloc is
    // not part of types.FuncType, so the value does not carry the contract.
    void noteAllocCall(ast.CallExpression call) {
        MethodRef? m = self.info.methodCalls[call.id];
        if (m != null) {
            types.FuncType? msig = m.owner.methodSig(m.name);
            if (msig != null && msig.noalloc) {
                return;
            }
            self.reportAlloc(call.tok, "method %s is not declared noalloc", m.name);
            return;
        }
        ast.Identifier? id = call.callee as ast.Identifier;
        if (id != null) {
            types.FuncType? sig = self.info.funcs[id.name];
            if (sig != null) {
                if (sig.noalloc) {
                    return;
                }
                self.reportAlloc(call.tok, "%s is not declared noalloc", id.name);
                return;
            }
            // The four names always in scope (§1.4) are not in info.funcs, and
            // each one gets its own answer.
            if (id.name == "getType") {
                return;    // folds to a string constant at compile time (§2.13)
            }
            if (id.name == "print" || id.name == "printInline") {
                // print writes through a stack buffer for every type but one:
                // a DateTime becomes a string first (§6.4).
                forEach(call.args, a) {
                    types.Type? at = self.info.types[a.id];
                    if (at != null && types.equal(at, types.DateTimeT)) {
                        self.reportAlloc(a.tok, "printing a DateTime allocates the text it is rendered into");
                        return;
                    }
                }
                return;
            }
            if (id.name == "Error") {
                self.reportAlloc(call.tok, "an Error is a record, so building one allocates it");
                return;
            }
            // Every other callee is a variable holding a function value.
            self.reportAlloc(call.tok, "calling %s goes through a function value, which does not carry the noalloc contract", id.name);
            return;
        }
        ast.MemberExpression? mem = call.callee as ast.MemberExpression;
        if (mem != null) {
            ast.Identifier? obj = mem.object as ast.Identifier;
            if (obj != null) {
                ModuleRef? ref = self.info.moduleAliases[obj.name];
                if (ref != null) {
                    if (ref.builtin != "") {
                        String key = ref.builtin + "." + mem.property;
                        if (has(allocFreeBuiltins, key)) {
                            return;
                        }
                        self.reportAlloc(call.tok, "%s allocates the value it answers", key);
                        return;
                    }
                    // A function of another module. The contract crosses the
                    // boundary on the signature, which the exports carry.
                    ModuleExports? exp = ref.exports;
                    if (exp != null) {
                        types.FuncType? isig = exp.funcs[mem.property];
                        if (isig != null) {
                            if (isig.noalloc) {
                                return;
                            }
                            self.reportAlloc(call.tok, "%s.%s is not declared noalloc", obj.name, mem.property);
                            return;
                        }
                    }
                }
            }
        }
        self.reportAlloc(call.tok, "this call reaches a body that has not promised to allocate nothing");
    }

    // Names the construct and the contract it breaks, once per function.
    void reportAlloc(token.Token tok, String why, ...String args) {
        NoallocCtx? ctx = self.noalloc;
        if (ctx == null || ctx.reported) {
            return;
        }
        ctx.reported = true;
        self.errorf(tok, "%s is declared noalloc, but %s", ctx.name, fmt.fmtArr(why, args));
    }

    // unionExpectation narrows what a function literal written where a union is
    // wanted must satisfy, from the union to the member that will hold it. A
    // literal takes on the fallibility of the expected type (§2.9), and that
    // decides what codegen emits, so the member must be known before the
    // literal is typed. The source writes the signature, so no body check is
    // needed: the member is the one whose call shape matches.
    types.Type? unionExpectation(ast.Expression e, types.Type? expected) {
        if (expected == null) {
            return expected;
        }
        ast.FuncLit? fn = e as ast.FuncLit;
        if (fn == null) {
            return expected;
        }
        types.Record? u = types.unwrap(expected) as types.Record;
        if (u == null || !u.sealed) {
            return expected;
        }
        types.FuncType written = types.newFuncType([], types.VoidT);
        self.paramTypes(written, fn.params);
        ast.TypeNode? rt = fn.returnType;
        if (rt != null) {
            written.return = self.resolveType(rt);
        }
        types.Type? only = null;
        int n = 0;
        forEach(u.extenders, arm) {
            types.Type? pay = unionPayload(arm);
            if (pay == null) {
                continue;
            }
            types.FuncType? af = pay as types.FuncType;
            if (af != null && sameCallShape(af, written)) {
                only = pay;
                n++;
            }
        }
        if (n == 1) {
            return only;
        }
        return expected;    // none or several: rule 7 reports it from the type
    }

    // unionWrap applies rule 7 of §2.10: a value written where a union is
    // wanted becomes that union, in the single member that accepts it. It runs
    // in exprType, where the expected type of every expression is known, so
    // the assignability checks elsewhere see a value that already is the union.
    // Two members that accept is the error here; none is left to the caller,
    // whose "cannot use X as Y" is the right message.
    types.Type unionWrap(ast.Expression e, types.Type t, types.Type? expected) {
        if (expected == null || types.isInvalid(t)) {
            return t;
        }
        types.Record? u = types.unwrap(expected) as types.Record;
        if (u == null || !u.sealed || types.assignable(expected, t)) {
            return t;
        }
        types.Record[] fits = [];
        String[] tags = [];
        forEach(u.extenders, arm) {
            types.Type? pay = unionPayload(arm);
            if (pay == null) {
                continue;    // a hand-written sealed type has no members to wrap into
            }
            types.Type pt = pay;
            if (types.assignable(pt, t)) {
                array.push(fits, arm);
                array.push(tags, string.substring(arm.name, string.length(u.name) + 1, string.length(arm.name)));
            }
        }
        if (fits.length == 0) {
            return t;
        }
        if (fits.length > 1) {
            self.errorf(e.tok, "cannot tell which member of %s a %s is: %s both accept it; name the one meant, as %s.%s(...)",
                u.name, types.typeString(t), string.join(tags, " and "), u.name, tags[0]);
            return types.InvalidT;
        }
        self.info.unionWraps[e.id] = fits[0];
        return u;
    }

    types.Type typeOf(ast.Expression e, types.Type? expected) {
        switch (e) {
            case ast.IntLiteral il:
                if (narrowIntLit(expected, il.value) && expected != null) {
                    return types.unwrap(expected);
                }
                return litIntType(il.value);
            case ast.FloatLiteral fl:
                if (narrowFloatLit(expected, fl.value) && expected != null) {
                    return types.unwrap(expected);
                }
                return litFloatType(fl.value);
            case ast.StringLiteral sl:
                return types.StringT;
            case ast.BoolLiteral bl:
                return types.BoolT;
            case ast.NullLiteral nl:
                return types.NullT;
            case ast.Identifier id:
                return self.identType(id);
            case ast.PrefixExpression pe:
                return self.prefixType(pe, expected);
            case ast.InfixExpression ie:
                if (ie.operator == "&&" || ie.operator == "||") {
                    // condFacts runs outside a condition too, so
                    // `p != null && p.value > 0` narrows in any expression.
                    self.condFacts(ie);
                    types.Type? t = self.info.types[ie.id];
                    if (t == null) {
                        return types.InvalidT;
                    }
                    return t;
                }
                return self.infixType(ie);
            case ast.ArrayLiteral al:
                return self.arrayLiteralType(al, expected);
            case ast.CatchExpr ce:
                return self.catchType(ce, expected);
            case ast.RecordLiteral rl:
                return self.recordLiteralType(rl, expected);
            case ast.MapLiteral ml:
                return self.mapLiteralType(ml, expected);
            case ast.IndexExpression ix:
                return self.indexTypeEx(ix, false);
            case ast.MemberExpression m:
                return self.memberTypeEx(m, false);
            case ast.CallExpression call:
                return self.callType(call);
            case ast.FuncLit fn:
                return self.funcLitType(fn, expected);
            case ast.AwaitExpr aw:
                return self.awaitType(aw);
            case ast.AsExpression ax:
                return self.asType(ax);
        }
    }

    // awaitType types `await expr`: the operand is a future, and the result is
    // its element type. An await drives the future, so a body that has not
    // finished runs here, and the future keeps the result for a later await.
    types.Type awaitType(ast.AwaitExpr ex) {
        types.Type vt = self.exprType(ex.value, null);
        if (types.isInvalid(vt)) {
            return vt;
        }
        types.FutureType? fut = vt as types.FutureType;
        if (fut != null) {
            // The body runs here, so the error of a fallible async function
            // arrives here. The call that made the future raised nothing.
            if (fut.fallible) {
                self.noteRaise(ex);
            }
            return fut.elem;
        }
        types.Optional? opt = vt as types.Optional;
        if (opt != null && (opt.inner as types.FutureType) != null) {
            self.errorf(ex.tok, "cannot await optional type %s (compare with null first)", types.typeString(vt));
            return types.InvalidT;
        }
        self.errorf(ex.tok, "await needs a future, got %s", types.typeString(vt));
        return types.InvalidT;
    }

    // Checks a function value. The literal writes its own parameter types and
    // return type. Fallibility is the only part the context decides: a value
    // written where a `Function(...)<T!>` is expected takes that contract on,
    // because the callers compile against it. The body runs at call time, so no
    // narrowing fact from around it holds inside. recordUse turns each use of a
    // local from an enclosing scope into a capture.
    types.Type funcLitType(ast.FuncLit ex, types.Type? expected) {
        types.FuncType sig = types.newFuncType([], types.VoidT);
        self.paramTypes(sig, ex.params);
        ast.TypeNode? rt = ex.returnType;
        if (rt != null) {
            sig.return = self.resolveType(rt);
        }
        types.FuncType? want = null;
        if (expected != null) {
            want = types.unwrap(expected) as types.FuncType;
        }
        Lambda lam = { sig: sig, captures: [] };
        self.info.lambdas[ex.id] = lam;
        LambdaScope ls = { info: lam, seen: {} };
        array.push(self.lambdas, ls);

        self.scope = newScope(self.scope);
        self.declareParams(ex.params, sig);
        Map<String, bool> savedFlow = self.flow;
        types.Type? savedRet = self.retType;
        token.Token savedRetTok = self.retTok;
        int savedLoop = self.loopDepth;
        int savedSwitch = self.switchDepth;
        self.flow = {};
        self.retType = sig.return;
        self.retTok = typeTokOr(ex.returnType, ex.tok);
        self.loopDepth = 0;      // a loop around this value is not one its body can leave
        self.switchDepth = 0;    // a switch around it is not one either
        self.depth++;
        self.pushRaise("");
        // The body is not the enclosing declaration's body: it runs when
        // something calls the value. The literal itself is already reported
        // as an allocation.
        NoallocCtx? savedNoalloc = self.noalloc;
        self.noalloc = null;
        ast.BlockStatement? blockBody = ex.blockBody;
        ast.Expression? exprBody = ex.exprBody;
        if (blockBody != null) {
            forEach(blockBody.statements, bs) {
                self.checkStatement(bs);
            }
        } else if (exprBody != null) {
            if (types.equal(sig.return, types.VoidT)) {
                // A void expression body runs and its value is discarded, as
                // in an expression statement.
                self.exprType(exprBody, null);
            } else {
                types.Type vt = self.exprType(exprBody, sig.return);
                if (!types.isInvalid(vt) && !types.isInvalid(sig.return) && !types.assignable(sig.return, vt)) {
                    self.errorf(exprBody.tok, "cannot return %s (the function value returns %s)",
                        types.typeString(vt), types.typeString(sig.return));
                }
            }
        }
        self.noalloc = savedNoalloc;
        bool raised = self.popRaise();
        if (want != null && want.fallible) {
            // The contract says it can fail, so it can. A body that never
            // raises never takes the error path.
            sig.fallible = true;
        } else if (raised) {
            sig.fallible = true;
        }
        self.depth--;
        self.retType = savedRet;
        self.retTok = savedRetTok;
        self.flow = savedFlow;
        self.loopDepth = savedLoop;
        self.switchDepth = savedSwitch;
        Scope? outer = self.scope.outer;
        if (outer != null) {
            self.scope = outer;
        }
        array.pop(self.lambdas);
        if (sig.fallible && want != null && !want.fallible) {
            types.FuncType shown = types.newFuncType(sig.params, sig.return);
            shown.fallible = true;
            shown.variadic = sig.variadic;
            self.errorf(ex.tok, "this function value can fail; its type must say so: %s", types.typeString(shown));
        }
        return sig;
    }

    types.Type identType(ast.Identifier ex) {
        Binding? b = self.scope.lookupBinding(ex.name);
        if (b != null) {
            self.recordUse(ex.name, b);
            types.Optional? opt = b.t as types.Optional;
            if (opt != null) {
                types.Type? n = self.narrowPath(ex, opt, bindingKey(b));
                if (n != null) {
                    return n;
                }
            }
            return b.t;
        }
        if (self.info.funcs[ex.name] != null) {
            self.errorf(ex.tok, "function %s must be called: %s(...)", quote.quote(ex.name), ex.name);
            return types.InvalidT;
        }
        ModuleRef? ref = self.info.moduleAliases[ex.name];
        if (ref != null) {
            if (ref.builtin != "") {
                self.errorf(ex.tok, "%s is a built-in library; call its functions like %s.something(...)", ex.name, ex.name);
            } else {
                self.errorf(ex.tok, "%s is a module; use %s.name to access its exports", ex.name, ex.name);
            }
            return types.InvalidT;
        }
        types.Enum? en = self.info.enums[ex.name];
        if (en != null) {
            String example = ex.name + ".MEMBER";
            if (en.members.length > 0) {
                example = ex.name + "." + en.members[0].name;
            }
            self.errorf(ex.tok, "%s is an enum type, not a value (name one of its members: %s)", ex.name, example);
            return types.InvalidT;
        }
        if (ex.name == "print" || ex.name == "printInline") {
            self.errorf(ex.tok, "%s must be called: %s(value)", ex.name, ex.name);
        } else if (ex.name == "getType") {
            self.errorf(ex.tok, "getType must be called: getType(value)");
        } else if (ex.name == "self") {
            self.errorf(ex.tok, "self names the receiver and is only bound inside a method body (§2.4)");
        } else if (!self.missingImport(ex.tok, ex.name)) {
            self.errorf(ex.tok, "undefined: %s", ex.name);
        }
        return types.InvalidT;
    }

    types.Type prefixType(ast.PrefixExpression ex, types.Type? expected) {
        if (ex.operator == "-") {
            // The negation of a literal is a literal, so the sign joins the
            // range check and `int8 b = -5;` is accepted.
            ast.IntLiteral? il = ex.right as ast.IntLiteral;
            if (il != null && narrowIntLit(expected, -il.value) && expected != null) {
                types.Type t = types.unwrap(expected);
                self.info.types[ex.right.id] = t;
                return t;
            }
            ast.FloatLiteral? fl = ex.right as ast.FloatLiteral;
            if (fl != null && narrowFloatLit(expected, -fl.value) && expected != null) {
                types.Type t2 = types.unwrap(expected);
                self.info.types[ex.right.id] = t2;
                return t2;
            }
            types.Type rt = self.exprType(ex.right, null);
            if (types.isInvalid(rt)) {
                return rt;
            }
            // A Duration is signed and 64 bits wide, so its negation is a
            // Duration. Every other operand widens as arithmetic does: -x on
            // an int8 is an int, which holds -(-128).
            if (types.equal(rt, types.DurationT)) {
                return types.DurationT;
            }
            // A negation on an unsigned type could only mean a wrap, which a
            // program never states, so it is refused. Subtraction still wraps.
            if (types.isUnsignedFamily(rt)) {
                self.errorf(ex.tok,
                    "operator - is not defined on %s (an unsigned type has no negative values)",
                    types.typeString(rt));
                return types.InvalidT;
            }
            if (types.isIntFamily(rt) || types.isFloatFamily(rt)) {
                return types.widen(rt);
            }
            self.errorf(ex.tok, "operator - is not defined on %s", types.typeString(rt));
            return types.InvalidT;
        }
        if (ex.operator == "~") {
            // The complement widens as arithmetic does: the complement of a
            // `uint8` sets bits above the eighth, which a `uint8` result could
            // not hold. `~b as byte` asks for those bits again (§3.6).
            types.Type ct = self.exprType(ex.right, null);
            if (types.isInvalid(ct)) {
                return ct;
            }
            if (types.isIntFamily(ct)) {
                return types.widen(ct);
            }
            if (types.isFloatFamily(ct)) {
                self.errorf(ex.tok, "operator ~ is not defined on %s: it reads a value's bits, and only the integer types expose theirs",
                    types.typeString(ct));
                return types.InvalidT;
            }
            self.errorf(ex.tok, "operator ~ is not defined on %s", types.typeString(ct));
            return types.InvalidT;
        }
        // The operator left is "!".
        types.Type rt2 = self.exprType(ex.right, types.BoolT);
        if (types.isInvalid(rt2)) {
            return rt2;
        }
        if (!types.equal(rt2, types.BoolT)) {
            self.errorf(ex.tok, "operator ! is not defined on %s", types.typeString(rt2));
            return types.InvalidT;
        }
        return types.BoolT;
    }

    types.Type infixType(ast.InfixExpression ex) {
        // A comparison with null tests presence, so its optional operand keeps
        // the optional type even where the flow narrowed it.
        if (ex.operator == "==" || ex.operator == "!=") {
            if ((ex.right as ast.NullLiteral) != null) {
                self.noNarrow = ex.left;
            } else if ((ex.left as ast.NullLiteral) != null) {
                self.noNarrow = ex.right;
            }
        }
        types.Type lt = self.exprType(ex.left, null);
        types.Type rt = self.exprType(ex.right, null);
        self.noNarrow = null;
        if (types.isInvalid(lt) || types.isInvalid(rt)) {
            return types.InvalidT;
        }
        lt = self.durationLit(ex.operator, ex.left, lt, rt);
        rt = self.durationLit(ex.operator, ex.right, rt, lt);
        types.Type? temporal = temporalInfix(ex.operator, lt, rt);
        if (temporal != null) {
            return temporal;
        }
        lt = self.unsignedLit(ex.left, lt, rt);
        rt = self.unsignedLit(ex.right, rt, lt);
        // Two widths in one family are permitted, because both operands widen.
        // The families never mix, so a pair from two of them has no result.
        types.Type? pair = types.widenPair(lt, rt);

        String op = ex.operator;
        if (op == "+" && types.equal(lt, types.StringT) && types.equal(rt, types.StringT)) {
            return types.StringT;
        }
        if (op == "+" || op == "-" || op == "*" || op == "/") {
            if (pair != null) {
                return pair;
            }
        } else if (op == "%") {
            if (pair != null && types.isIntFamily(pair)) {
                return pair;
            }
        } else if (op == "&" || op == "|" || op == "^") {
            // The bitwise operators are defined on the pairs `+` is, within one
            // integer family, and widen the same way.
            if (pair != null && types.isIntFamily(pair)) {
                return pair;
            }
        } else if (op == "<<" || op == ">>") {
            // A shift is not a pair: the count brings no family to the result,
            // which is the widened type of the shifted operand. That keeps the
            // meaning of `>>` with the left operand, which fills with the sign
            // on a signed type and with zeros on an unsigned one.
            if (types.isIntFamily(lt) && types.isIntFamily(rt)) {
                return types.widen(lt);
            }
        } else if (op == "==" || op == "!=") {
            if (self.equalityOK(lt, rt)) {
                return types.BoolT;
            }
            self.errorf(ex.tok, "cannot compare %s and %s", types.typeString(lt), types.typeString(rt));
            return types.InvalidT;
        } else if (op == "<" || op == ">" || op == "<=" || op == ">=") {
            bool sameOrdered = types.equal(lt, rt) && (types.equal(lt, types.StringT)
                || types.equal(lt, types.DateTimeT) || types.equal(lt, types.DurationT));
            if (pair != null || enumComparable(lt, rt) || sameOrdered) {
                return types.BoolT;
            }
        }
        if (isBitwiseOp(op) && (types.isFloatFamily(lt) || types.isFloatFamily(rt))) {
            // A float's bits are a sign, an exponent and a mantissa, so a mask
            // over them is never what the program means.
            types.Type f = lt;
            if (!types.isFloatFamily(lt)) {
                f = rt;
            }
            self.errorf(ex.tok, "operator %s is not defined on %s: the bitwise operators read a value's bits, and only the integer types expose theirs",
                op, types.typeString(f));
            return types.InvalidT;
        }
        self.errorf(ex.tok, "operator %s is not defined on %s and %s",
            ex.operator, types.typeString(lt), types.typeString(rt));
        return types.InvalidT;
    }

    // Gives a new type to a bare integer literal that sits where a Duration
    // belongs. A Duration is a count of milliseconds (§6.4), so `d == 1000` and
    // `time.now() - 250` mean what they appear to mean. Only a literal changes
    // type, so an `int` variable is never a Duration. `*` and `/` are excluded,
    // because the number that scales a duration is a count. The recorded type
    // of e changes too, because codegen reads types from Info, not the AST.
    types.Type durationLit(String op, ast.Expression e, types.Type t, types.Type other) {
        if (!types.isIntFamily(t) || !isIntLiteral(e)) {
            return t;
        }
        if (op == "+" || op == "-") {
            if (!types.equal(other, types.DurationT) && !types.equal(other, types.DateTimeT)) {
                return t;
            }
        } else if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
            if (!types.equal(other, types.DurationT)) {
                return t;
            }
        } else {
            return t;
        }
        self.info.types[e.id] = types.DurationT;
        ast.PrefixExpression? p = e as ast.PrefixExpression;
        if (p != null) {
            self.info.types[p.right.id] = types.DurationT;
        }
        return types.DurationT;
    }

    // Gives a new type to a bare integer literal that sits opposite an unsigned
    // operand a signed literal cannot meet. Without this rule, `u == 5` and
    // `n + 1` would be two families that do not mix. It acts only where the
    // pair has no result type without it, so `b + 5` on a `byte` stays an
    // `int`. Only a literal changes type, and its type in Info changes with it.
    types.Type unsignedLit(ast.Expression e, types.Type t, types.Type other) {
        types.Type u = types.unwrap(other);    // `u? == 5` compares what it holds
        if (!types.isUnsignedFamily(u) || !types.isSignedFamily(t)) {
            return t;
        }
        if (types.widenPair(t, u) != null) {
            return t;
        }
        int? v = intLitValue(e);
        if (v == null) {
            return t;
        }
        types.IntBounds? r = types.intRange(u);
        if (r == null || v < r.lo || v > r.hi) {
            return t;
        }
        self.info.types[e.id] = u;
        return u;
    }

    bool equalityOK(types.Type lt, types.Type rt) {
        if (types.equal(lt, types.NullT) || types.equal(rt, types.NullT)) {
            bool lOpt = (lt as types.Optional) != null;
            bool rOpt = (rt as types.Optional) != null;
            return lOpt || rOpt || (types.equal(lt, types.NullT) && types.equal(rt, types.NullT));
        }
        types.Type lu = types.unwrap(lt);
        types.Type ru = types.unwrap(rt);
        // Two numbers compare when they have a common type, the rule
        // arithmetic uses, so an `int` never meets a `uint64`.
        if (types.widenPair(lu, ru) != null) {
            return true;
        }
        if (enumComparable(lu, ru)) {
            return true;
        }
        return types.equal(lu, ru) && comparableBasic(lu);
    }

    types.Type arrayLiteralType(ast.ArrayLiteral ex, types.Type? expected) {
        types.Type? elemExp = null;
        int declaredLen = 0;
        if (expected != null) {
            types.Array? a = types.unwrap(expected) as types.Array;
            if (a != null) {
                elemExp = a.elem;
                declaredLen = a.len;
            }
        }
        // The literal still takes the declared type, so the mismatch is not
        // reported a second time as an assignment error.
        if (declaredLen > 0 && ex.elements.length != declaredLen && expected != null) {
            self.errorf(ex.tok, "wrong number of elements for %s: got %s, want %s",
                types.typeString(types.unwrap(expected)), string.from(ex.elements.length), string.from(declaredLen));
        }
        if (ex.elements.length == 0) {
            if (elemExp == null) {
                self.errorf(ex.tok, "cannot infer the element type of an empty array literal");
                return types.InvalidT;
            }
            return types.newFixedArray(elemExp, declaredLen);
        }
        types.Type first = self.exprType(ex.elements[0], elemExp);
        types.Type base = first;
        if (elemExp != null) {
            base = elemExp;
        }
        if (types.isInvalid(base)) {
            return types.InvalidT;
        }
        if (!types.assignable(base, first)) {
            self.errorf(ex.elements[0].tok, "array element: cannot use %s as %s",
                types.typeString(first), types.typeString(base));
        }
        forEach(ex.elements, el, i) {
            if (i == 0) {
                continue;
            }
            types.Type et = self.exprType(el, base);
            if (!types.isInvalid(et) && !types.assignable(base, et)) {
                self.errorf(el.tok, "array element: cannot use %s as %s",
                    types.typeString(et), types.typeString(base));
            }
        }
        return types.newFixedArray(base, declaredLen);
    }

    types.Type recordLiteralType(ast.RecordLiteral ex, types.Type? expected) {
        types.Record? rec = null;
        if (expected != null) {
            types.Type u = types.unwrap(expected);
            rec = u as types.Record;
            types.MapType? mt = u as types.MapType;
            if (mt != null) {
                // `{}` where a map is expected is the empty map literal.
                // Identifier keys there can be misread, so the error below
                // gives both readings.
                if (ex.fields.length == 0) {
                    return mt;
                }
                String n = ex.fields[0].name;
                self.errorf(ex.tok, "map keys are literals; %s is an identifier (a literal key is quoted: { \"%s\": ... }; the value of the variable %s keys an entry through indexing: m[%s] = ...)",
                    quote.quote(n), n, n, n);
                forEach(ex.fields, f) {
                    self.exprType(f.value, null);
                }
                return types.InvalidT;
            }
        }
        if (rec == null) {
            self.errorf(ex.tok, "cannot determine the record type of this literal (use it where a record type is expected, e.g. Car c = { ... })");
            forEach(ex.fields, f2) {
                self.exprType(f2.value, null);
            }
            return types.InvalidT;
        }
        types.Record r = rec;
        // A sealed type is in no `extenders` list, so a value of it would match
        // no clause of a type switch, and §4.9's rule that one clause always
        // runs would be false. A program that wants only the fields of the base
        // declares an extender that adds none.
        if (r.sealed) {
            self.errorf(ex.tok, "cannot construct %s: it is sealed, so every value of it has one of the types that extend it. %s. Construct one of those, or declare a type that extends %s and adds no fields",
                r.name, extendersOf(r), r.name);
        }
        Map<String, bool> seen = {};
        forEach(ex.fields, f3) {
            if (has(seen, f3.name)) {
                self.errorf(ex.tok, "duplicate field %s in record literal", quote.quote(f3.name));
                continue;
            }
            seen[f3.name] = true;
            types.FieldSlot? slot = r.fieldType(f3.name);
            if (slot == null) {
                self.errorf(f3.value.tok, "type %s has no field %s", r.name, quote.quote(f3.name));
                self.exprType(f3.value, null);
                continue;
            }
            types.Type ft = slot.type;
            types.Type vt = self.exprType(f3.value, ft);
            if (!types.isInvalid(vt) && !types.isInvalid(ft) && !types.assignable(ft, vt)) {
                self.errorf(f3.value.tok, "field %s: cannot use %s as %s",
                    quote.quote(f3.name), types.typeString(vt), types.typeString(ft));
            }
        }
        forEach(r.fields, f4) {
            if ((f4.type as types.Optional) == null && !has(seen, f4.name)) {
                self.errorf(ex.tok, "missing field %s (%s) in %s literal",
                    quote.quote(f4.name), types.typeString(f4.type), r.name);
            }
        }
        return r;
    }

    // Checks `{ "alice": 31, ... }`. A map literal exists only where the
    // expected type says what it builds, as a record literal does. The parser
    // has already held the keys to constants.
    types.Type mapLiteralType(ast.MapLiteral ex, types.Type? expected) {
        types.MapType? mt = null;
        if (expected != null) {
            types.Type u = types.unwrap(expected);
            mt = u as types.MapType;
            types.Record? rec = u as types.Record;
            if (rec != null && mt == null) {
                self.errorf(ex.tok, "record fields are named by identifiers, not string literals: write { field: ... } for %s", rec.name);
                forEach(ex.entries, en) {
                    self.exprType(en.key, null);
                    self.exprType(en.value, null);
                }
                return types.InvalidT;
            }
        }
        if (mt == null) {
            self.errorf(ex.tok, "cannot determine the map type of this literal (use it where a map type is expected, e.g. Map<String, int> m = { ... })");
            forEach(ex.entries, en2) {
                self.exprType(en2.key, null);
                self.exprType(en2.value, null);
            }
            return types.InvalidT;
        }
        types.MapType m = mt;
        Map<String, bool> seen = {};
        forEach(ex.entries, en3) {
            types.Type kt = self.exprType(en3.key, m.key);
            if (!types.isInvalid(kt) && !types.isInvalid(m.key) && !types.assignable(m.key, kt)) {
                self.errorf(en3.key.tok, "map key: cannot use %s as %s", types.typeString(kt), types.typeString(m.key));
            }
            String key = constKeyString(en3.key);
            if (key != "") {
                if (has(seen, key)) {
                    self.errorf(en3.key.tok, "duplicate key %s in map literal", key);
                }
                seen[key] = true;
            }
            types.Type vt = self.exprType(en3.value, m.value);
            if (!types.isInvalid(vt) && !types.isInvalid(m.value) && !types.assignable(m.value, vt)) {
                self.errorf(en3.value.tok, "map value: cannot use %s as %s", types.typeString(vt), types.typeString(m.value));
            }
        }
        return m;
    }

    // indexTypeEx types `x[i]`. asTarget is set for the target of an
    // assignment, where a map entry differs from a read: `m[k]` gives V?,
    // because the key can be absent, and `m[k] = v` stores a plain V.
    types.Type indexTypeEx(ast.IndexExpression ex, bool asTarget) {
        types.Type lt = self.exprType(ex.left, null);

        // The indexed value decides the meaning of the index. A `?.` chain
        // removes one optional layer and passes null through in place of an
        // error.
        types.Type base = lt;
        bool chained = false;
        types.Optional? lopt = lt as types.Optional;
        if (lopt != null && hasInt(self.chainOpt, ex.left.id)) {
            base = lopt.inner;
            chained = true;
        }

        // An index into a Json moves through a document, so it always answers a
        // Json and never an optional. An absent key gives a MISSING node
        // (§6.3), so `raw["a"]["b"]` needs no guard at each step. A String key
        // reaches into an object, and an int into an array.
        if (types.equal(base, types.JsonT)) {
            types.Type kt = self.exprType(ex.index, null);
            if (!types.isInvalid(kt) && !types.equal(kt, types.StringT) && !types.isIntFamily(kt)) {
                self.errorf(ex.index.tok, "a Json is indexed by a String key or an int position, not %s", types.typeString(kt));
            }
            if (chained) {
                self.chainOpt[ex.id] = true;
                return optionalOf(types.JsonT);
            }
            return types.JsonT;
        }

        // An index into a String is a byte position and gives the byte, not a
        // string of one character, so reading text allocates nothing. Every
        // other index into a string is a byte offset too (§6.6). A program
        // cannot write one: codegen gives every occurrence of the same literal
        // one object, so a write through s[i] would reach all of them.
        if (types.equal(base, types.StringT)) {
            types.Type sit = self.exprType(ex.index, null);
            if (!types.isInvalid(sit) && !types.isIntFamily(sit)) {
                self.errorf(ex.index.tok, "string index must be int, got %s", types.typeString(sit));
            }
            if (asTarget) {
                self.errorf(ex.tok, "cannot assign to a byte of a String: strings are immutable (build the bytes with string.toByteArray and string.fromByteArray)");
                return types.InvalidT;
            }
            if (chained) {
                self.chainOpt[ex.id] = true;
                return optionalOf(types.Uint8T);
            }
            return types.Uint8T;
        }

        types.MapType? m = base as types.MapType;
        if (m != null) {
            types.Type kt2 = self.exprType(ex.index, m.key);
            if (!types.isInvalid(kt2) && !types.isInvalid(m.key) && !types.assignable(m.key, kt2)) {
                self.errorf(ex.index.tok, "map key: cannot use %s as %s", types.typeString(kt2), types.typeString(m.key));
            }
            if (chained) {
                self.chainOpt[ex.id] = true;
                return optionalOf(m.value);
            }
            if (asTarget) {
                return m.value;
            }
            // A lookup gives V?, because an absent key is ordinary data. V is
            // never itself optional, so this never builds a V??.
            return optionalOf(m.value);
        }

        types.Type it = self.exprType(ex.index, null);
        if (!types.isInvalid(it) && !types.isIntFamily(it)) {
            self.errorf(ex.index.tok, "array index must be int, got %s", types.typeString(it));
        }
        if (types.isInvalid(lt)) {
            return types.InvalidT;
        }
        if (lopt != null) {
            // An index continues an optional chain: `a?.items[0]` is null when
            // an earlier link is null.
            if (!chained) {
                self.errorf(ex.tok, "cannot index optional type %s (compare with null first)", types.typeString(lt));
                return types.InvalidT;
            }
            types.Array? a = base as types.Array;
            if (a == null) {
                self.errorf(ex.tok, "cannot index %s", types.typeString(lt));
                return types.InvalidT;
            }
            self.checkConstIndex(ex, a);
            self.chainOpt[ex.id] = true;
            return optionalOf(a.elem);
        }
        types.Array? a2 = lt as types.Array;
        if (a2 != null) {
            self.checkConstIndex(ex, a2);
            return a2.elem;
        }
        self.errorf(ex.tok, "cannot index %s", types.typeString(lt));
        return types.InvalidT;
    }

    // checkConstIndex rejects a constant index that a fixed-size array cannot
    // hold, at compile time rather than at run time.
    void checkConstIndex(ast.IndexExpression ex, types.Array a) {
        ast.IntLiteral? lit = ex.index as ast.IntLiteral;
        if (lit != null && a.len > 0 && lit.value >= a.len) {
            self.errorf(ex.index.tok, "index %s out of range for %s", string.from(lit.value), types.typeString(a));
        }
    }

    // memberTypeEx types `obj.prop` and `obj?.prop`. asTarget is set for the
    // last member of an assignment target, where two rules differ: flow
    // narrowing must not apply, because the declared type decides what a
    // program can store, and an optional chain is not assignable.
    types.Type memberTypeEx(ast.MemberExpression ex, bool asTarget) {
        ast.Identifier? id = ex.object as ast.Identifier;
        if (id != null) {
            ModuleRef? ref = self.info.moduleAliases[id.name];
            if (ref != null) {
                if (ex.optional) {
                    self.errorf(ex.tok, "?. cannot be used on module %s; write %s.%s", id.name, id.name, ex.property);
                    return types.InvalidT;
                }
                return self.moduleMemberType(ex, id.name, ref);
            }
            if (self.missingImport(id.tok, id.name)) {
                return types.InvalidT;
            }
            // An enum name at a member position names one of its constants. A
            // variable in scope takes priority and hides the enum.
            if (self.scope.lookupBinding(id.name) == null) {
                types.Enum? en = self.info.enums[id.name];
                if (en != null) {
                    return self.enumMemberType(ex, en, asTarget);
                }
            }
        }
        // `alias.Enum.MEMBER`. The inner expression names a type and not a
        // value, so it is resolved rather than typed.
        types.Enum? qen = self.qualifiedEnum(ex.object);
        if (qen != null) {
            return self.enumMemberType(ex, qen, asTarget);
        }
        types.Type ot = self.exprType(ex.object, null);
        if (types.isInvalid(ot)) {
            return ot;
        }
        types.Optional? opt = ot as types.Optional;
        if (opt != null) {
            // `a?.b`, or an access that continues a chain, as in `a?.b.c`.
            if (!ex.optional && !hasInt(self.chainOpt, ex.object.id)) {
                self.errorf(ex.tok, "cannot access %s on optional type %s (use ?. or compare with null first)",
                    quote.quote(ex.property), types.typeString(opt));
                return types.InvalidT;
            }
            if (asTarget) {
                self.errorf(ex.tok, "cannot assign through ?.");
                return types.InvalidT;
            }
            types.Type mt = self.memberOn(ex, opt.inner, false);
            if (types.isInvalid(mt)) {
                return mt;
            }
            self.chainOpt[ex.id] = true;
            return optionalOf(mt);
        }
        if (ex.optional) {
            self.errorf(ex.tok, "?. needs an optional value; type %s is never null (use .)", types.typeString(ot));
            return types.InvalidT;
        }
        types.Type mt2 = self.memberOn(ex, ot, asTarget);
        types.Optional? mopt = mt2 as types.Optional;
        if (mopt != null && !asTarget) {
            types.Type? n = self.narrowPath(ex, mopt, self.pathKey(ex));
            if (n != null) {
                return n;
            }
        }
        return mt2;
    }

    // qualifiedEnum answers the enum e names, when e is `alias.Name` for an
    // import alias and an enum that module exports, and null otherwise.
    types.Enum? qualifiedEnum(ast.Expression e) {
        ast.MemberExpression? inner = e as ast.MemberExpression;
        if (inner == null || inner.optional) {
            return null;
        }
        ast.Identifier? id = inner.object as ast.Identifier;
        if (id == null) {
            return null;
        }
        ModuleRef? ref = self.info.moduleAliases[id.name];
        if (ref == null) {
            return null;
        }
        // A built-in module carries no exports, because the compiler declares
        // its types. The enums come from the table a type position uses, so
        // `fs.ErrorCode c` and `fs.ErrorCode.NOT_FOUND` agree.
        if (ref.builtin != "") {
            types.Type? t = builtinModuleTypes[ref.builtin + "." + inner.property];
            if (t == null) {
                return null;
            }
            return t as types.Enum;
        }
        ModuleExports? exp = ref.exports;
        if (exp == null) {
            return null;
        }
        return exp.enums[inner.property];
    }

    // enumMemberType types `E.MEMBER` and `alias.E.MEMBER`, a compile-time
    // constant. It records the value in Info.enumMembers for codegen.
    types.Type enumMemberType(ast.MemberExpression ex, types.Enum en, bool asTarget) {
        if (ex.optional) {
            self.errorf(ex.tok, "?. cannot be used on enum %s; write %s.%s",
                types.typeString(en), types.typeString(en), ex.property);
            return types.InvalidT;
        }
        int? v = en.memberValue(ex.property);
        if (v == null) {
            self.errorf(ex.tok, "enum %s has no member %s", types.typeString(en), quote.quote(ex.property));
            return types.InvalidT;
        }
        if (asTarget) {
            self.errorf(ex.tok, "cannot assign to %s.%s: enum members are constants", types.typeString(en), ex.property);
            return types.InvalidT;
        }
        self.info.enumMembers[ex.id] = v;
        return en;
    }

    // memberOn resolves a member access on a type that is not optional.
    // asTarget is set for the last member of an assignment target, where a
    // method is a wrong kind of target and not a wrong kind of value.
    types.Type memberOn(ast.MemberExpression ex, types.Type t, bool asTarget) {
        switch (t) {
            case types.Array a:
                if (ex.property == "length") {
                    return types.IntT;
                }
                self.errorf(ex.tok, "arrays have no property %s (available: length)", quote.quote(ex.property));
            case types.MapType m:
                if (ex.property == "length") {
                    return types.IntT;
                }
                self.errorf(ex.tok, "maps have no property %s (available: length)", quote.quote(ex.property));
            case types.Record rec:
                types.FieldSlot? slot = rec.fieldType(ex.property);
                if (slot != null) {
                    return slot.type;
                }
                if (rec.methodSig(ex.property) != null) {
                    // A method belongs to the type and not to the value, so the
                    // record holds nothing to give out or to replace. A program
                    // can only call the name (§3.4).
                    if (asTarget) {
                        self.errorf(ex.tok, "cannot assign to method %s.%s: methods belong to the type, not to the value",
                            rec.name, ex.property);
                    } else {
                        self.errorf(ex.tok, "method %s.%s must be called: %s.%s(...)",
                            rec.name, ex.property, ast.exprString(ex.object), ex.property);
                    }
                    return types.InvalidT;
                }
                self.errorf(ex.tok, "type %s has no field %s", rec.name, quote.quote(ex.property));
            case types.FutureType fu:
                self.errorf(ex.tok, "type %s has no properties; await it first: (await %s).%s",
                    types.typeString(t), suggestText(ex.object), ex.property);
            default:
                self.errorf(ex.tok, "type %s has no properties", types.typeString(t));
        }
        return types.InvalidT;
    }

    // moduleMemberType types `alias.name` at a value position: an exported
    // variable of an imported module. A function has no value form.
    types.Type moduleMemberType(ast.MemberExpression ex, String alias, ModuleRef ref) {
        if (ref.builtin != "") {
            // A constant, such as math.PI (§6.21).
            if (builtins.constValue(ref.builtin, ex.property) != null) {
                return types.FloatT;
            }
            if (isBuiltinNamespace(ref.builtin, ex.property)) {
                self.errorf(ex.tok, "%s.%s is a group of functions, not a value; call one of them: %s.%s.something(...)",
                    alias, ex.property, alias, ex.property);
            } else if (builtinModuleTypes[ref.builtin + "." + ex.property] != null) {
                self.errorf(ex.tok, "%s.%s is a type, not a value", alias, ex.property);
            } else {
                self.errorf(ex.tok, "%s.%s must be called: %s.%s(...)", alias, ex.property, alias, ex.property);
            }
            return types.InvalidT;
        }
        ModuleExports? expOpt = ref.exports;
        if (expOpt == null) {
            return types.InvalidT;
        }
        ModuleExports exp = expOpt;
        if (exp.funcs[ex.property] != null) {
            self.errorf(ex.tok, "function %s.%s must be called: %s.%s(...)", alias, ex.property, alias, ex.property);
            return types.InvalidT;
        }
        types.Type? vt = exp.vars[ex.property];
        if (vt != null) {
            types.Optional? opt = vt as types.Optional;
            if (opt != null) {
                types.Type? n = self.narrowPath(ex, opt, self.pathKey(ex));
                if (n != null) {
                    return n;
                }
            }
            return vt;
        }
        if (exp.records[ex.property] != null) {
            self.errorf(ex.tok, "%s.%s is a type, not a value", alias, ex.property);
            return types.InvalidT;
        }
        types.Enum? en = exp.enums[ex.property];
        if (en != null) {
            String example = alias + "." + ex.property + ".MEMBER";
            if (en.members.length > 0) {
                example = alias + "." + ex.property + "." + en.members[0].name;
            }
            self.errorf(ex.tok, "%s.%s is an enum type, not a value (name one of its members: %s)",
                alias, ex.property, example);
            return types.InvalidT;
        }
        self.moduleNoMemberError(ex.tok, alias, ref, ex.property);
        return types.InvalidT;
    }

    // visitArgsInvalid types the arguments of a bad call anyway: a mistake in
    // one is worth a report. It answers the invalid type the call stands for.
    types.Type visitArgsInvalid(ast.CallExpression ex) {
        forEach(ex.args, a) {
            self.exprType(a, null);
        }
        return types.InvalidT;
    }

    types.Type callType(ast.CallExpression ex) {
        ast.Identifier? callee = ex.callee as ast.Identifier;
        if (callee != null) {
            if (callee.name == "print" || callee.name == "printInline") {
                return self.printCall(ex, callee.name);
            }
            if (callee.name == "getType") {
                return self.getTypeCall(ex);
            }
            if (callee.name == "Error") {
                return self.errorCall(ex);
            }
            // A binding in scope takes priority over a declared function of the
            // same name, and is called through its value.
            if (self.scope.lookupBinding(callee.name) != null) {
                types.Type t = self.exprType(callee, null);
                types.FuncType? sig = t as types.FuncType;
                if (sig != null) {
                    self.checkArgs(ex, callee.name, sig);
                    return self.callProduces(ex, sig);
                }
                types.Optional? opt = t as types.Optional;
                if (opt != null) {
                    if ((opt.inner as types.FuncType) != null) {
                        self.errorf(ex.tok, "cannot call optional type %s (compare %s with null first)",
                            types.typeString(t), quote.quote(callee.name));
                    } else {
                        self.errorf(ex.tok, "%s is not a function", quote.quote(callee.name));
                    }
                } else if (!types.isInvalid(t)) {
                    self.errorf(ex.tok, "%s is not a function", quote.quote(callee.name));
                }
                return self.visitArgsInvalid(ex);
            }
            types.FuncType? fsig = self.info.funcs[callee.name];
            if (fsig != null) {
                self.info.types[callee.id] = fsig;
                self.noteCall(ownerFn(callee.name), ex.tok);
                self.checkArgs(ex, callee.name, fsig);
                return self.callProduces(ex, fsig);
            }
            if (self.info.enums[callee.name] != null) {
                self.errorf(ex.tok, "%s is an enum type and cannot be called", callee.name);
                return self.visitArgsInvalid(ex);
            }
            if (!self.missingImport(callee.tok, callee.name)) {
                self.errorf(ex.tok, "undefined function: %s", callee.name);
            }
            return self.visitArgsInvalid(ex);
        }
        ast.MemberExpression? mem = ex.callee as ast.MemberExpression;
        if (mem != null) {
            return self.memberCallType(ex, mem);
        }
        // Every other callee is called through its value, as in makeAdder(1)(2)
        // and handlers[0](x).
        types.Type t2 = self.exprType(ex.callee, null);
        types.FuncType? sig2 = t2 as types.FuncType;
        if (sig2 != null) {
            self.checkArgs(ex, "the function value", sig2);
            return self.callProduces(ex, sig2);
        }
        types.Optional? opt2 = t2 as types.Optional;
        if (opt2 != null) {
            if ((opt2.inner as types.FuncType) != null) {
                self.errorf(ex.tok, "cannot call optional type %s (compare with null first)", types.typeString(t2));
            } else {
                self.errorf(ex.tok, "expression is not callable");
            }
        } else if (!types.isInvalid(t2)) {
            self.errorf(ex.tok, "expression is not callable");
        }
        return self.visitArgsInvalid(ex);
    }

    // Checks `print(a, b, ...)` and `printInline(a, b, ...)`. The two differ
    // only in what codegen writes after the last argument. A diagnostic uses
    // the name the call used.
    types.Type printCall(ast.CallExpression ex, String name) {
        forEach(ex.args, a) {
            types.Type at = self.exprType(a, null);
            bool isFn = (types.unwrap(at) as types.FuncType) != null;
            if (types.equal(at, types.VoidT)) {
                self.errorf(a.tok, "cannot print a void value");
            } else if (types.equal(at, types.NullT)) {
                self.errorf(a.tok, "cannot print a bare null");
            } else if (isFn) {
                self.errorf(a.tok, "cannot print a function value");
            } else if (types.equal(types.unwrap(at), types.RegExpT)) {
                // A RegExp is a compiled program and not text.
                self.errorf(a.tok, "cannot print a RegExp; print the pattern it was created from");
            } else if (!types.isInvalid(at) && !printable(at)) {
                self.errorf(a.tok, "cannot print %s; %s takes strings, numbers, bools, DateTime and Duration values, and enums (serialize records, arrays, and maps with json.toText)",
                    types.typeString(at), name);
            }
        }
        return types.VoidT;
    }

    // Checks `getType(value)`, which names the declared type of its argument.
    // Only the type reaches the result, so every type but void is permitted,
    // and codegen writes the answer as a constant. Flow narrowing does not
    // apply (§2.3): an optional reports the type its declaration wrote.
    types.Type getTypeCall(ast.CallExpression ex) {
        if (ex.args.length != 1) {
            self.errorf(ex.tok, "getType takes exactly 1 argument, got %s", string.from(ex.args.length));
            forEach(ex.args, a) {
                self.exprType(a, null);
            }
            return types.StringT;
        }
        self.noNarrow = ex.args[0];
        types.Type at = self.exprType(ex.args[0], null);
        self.noNarrow = null;
        if (types.equal(at, types.VoidT)) {
            self.errorf(ex.args[0].tok, "cannot take getType of a void value");
        }
        return types.StringT;
    }

    // checkArgs tests the number of arguments and their types against sig.
    // Every argument after the fixed parameters of a variadic signature is
    // checked against the element type of the collecting parameter (§5.2).
    void checkArgs(ast.CallExpression ex, String name, types.FuncType sig) {
        types.Type[] params = sig.params;
        int fixed = params.length;
        types.Type rest = types.InvalidT;
        if (sig.variadic) {
            fixed--;
            types.Array? arr = params[fixed] as types.Array;
            if (arr != null) {
                rest = arr.elem;
            }
        }
        if (ex.args.length < fixed || (!sig.variadic && ex.args.length > fixed)) {
            if (sig.variadic) {
                self.errorf(ex.tok, "%s takes at least %s argument(s), got %s",
                    name, string.from(fixed), string.from(ex.args.length));
            } else {
                self.errorf(ex.tok, "%s takes %s argument(s), got %s",
                    name, string.from(fixed), string.from(ex.args.length));
            }
            forEach(ex.args, a) {
                self.exprType(a, null);
            }
            return;
        }
        forEach(ex.args, a2, i) {
            types.Type want = rest;
            if (i < fixed) {
                want = params[i];
            }
            types.Type at = self.exprType(a2, want);
            if (types.isInvalid(at) || types.isInvalid(want) || types.assignable(want, at)) {
                continue;
            }
            // A caller can expect to pass a whole array to a collecting
            // parameter, and the language has no spread operator.
            if (i >= fixed && types.assignable(params[fixed], at)) {
                self.errorf(a2.tok, "argument %s of %s: %s collects its arguments one by one, so it takes %s, not the %s array itself",
                    string.from(i + 1), name, name, types.typeString(want), types.typeString(at));
                continue;
            }
            self.errorf(a2.tok, "argument %s of %s: cannot use %s as %s",
                string.from(i + 1), name, types.typeString(at), types.typeString(want));
        }
    }

    types.Type memberCallType(ast.CallExpression ex, ast.MemberExpression callee) {
        if (callee.optional) {
            self.errorf(ex.tok, "cannot call through ?.");
            return self.visitArgsInvalid(ex);
        }
        // `Union.Tag(v)` names the member where rule 7 cannot decide, which is
        // where two members accept the same value. It is also the only way to
        // reach a member whose type is a function type, since the contract a
        // literal takes on (§2.9) comes from its expected type.
        types.Type? built = self.unionCall(ex, callee);
        if (built != null) {
            return built;
        }
        // In `time.date.day(t)` the object of the callee is the namespace and
        // not a value, so it is resolved before anything types it.
        NsRef? ns = self.info.builtinNamespace(callee.object);
        if (ns != null) {
            ast.MemberExpression? nsMem = callee.object as ast.MemberExpression;
            String aliasName = "";
            if (nsMem != null) {
                ast.Identifier? nsId = nsMem.object as ast.Identifier;
                if (nsId != null) {
                    aliasName = nsId.name;
                }
            }
            String qual = aliasName + "." + ns.ns;
            if (ns.module == "time") {
                return self.builtinCall(ex, "time.date", qual, callee.property);
            }
            if (ns.module == "process") {
                return self.processNsCallType(ex, qual, ns.ns, callee.property);
            }
            if (ns.module == "net") {
                return self.builtinCall(ex, "net." + ns.ns, qual, callee.property);
            }
        }
        ast.Identifier? id = callee.object as ast.Identifier;
        if (id != null) {
            ModuleRef? ref = self.info.moduleAliases[id.name];
            if (ref != null) {
                String b = ref.builtin;
                if (b == "json") {
                    return self.jsonCallType(ex, id.name, callee.property);
                }
                if (b == "time") {
                    return self.timeCallType(ex, id.name, callee.property);
                }
                if (b == "array") {
                    return self.arrayCallType(ex, id.name, callee.property);
                }
                if (b == "string") {
                    return self.stringCallType(ex, id.name, callee.property);
                }
                if (b == "map") {
                    return self.mapCallType(ex, id.name, callee.property);
                }
                if (b == "async") {
                    return self.asyncCallType(ex, id.name, callee.property);
                }
                if (b == "math") {
                    return self.mathCallType(ex, id.name, callee.property);
                }
                if (b == "random") {
                    return self.randomCallType(ex, id.name, callee.property);
                }
                if (b == "os") {
                    return self.builtinCall(ex, "os", id.name, callee.property);
                }
                if (b == "path") {
                    return self.builtinCall(ex, "path", id.name, callee.property);
                }
                if (b == "fs") {
                    return self.builtinCall(ex, "fs", id.name, callee.property);
                }
                if (b == "process") {
                    return self.processCallType(ex, id.name, callee.property);
                }
                if (b == "regexp") {
                    return self.builtinCall(ex, "regexp", id.name, callee.property);
                }
                if (b == "crypto") {
                    return self.builtinCall(ex, "crypto", id.name, callee.property);
                }
                if (b == "net") {
                    return self.netCallType(ex, id.name, callee.property);
                }
                return self.moduleCallType(ex, id.name, ref, callee.property);
            }
            if (self.missingImport(id.tok, id.name)) {
                return self.visitArgsInvalid(ex);
            }
            if (self.scope.lookupBinding(id.name) == null && self.info.enums[id.name] != null) {
                self.errorf(ex.tok, "%s.%s is an enum member, not a function", id.name, callee.property);
                return self.visitArgsInvalid(ex);
            }
        }
        types.Type ot = self.exprType(callee.object, null);
        if (types.isInvalid(ot)) {
            return ot;
        }
        // A method resolves from the type of the receiver and not from the
        // value (§2.4). A field cannot have the same name, so this never
        // competes with a field that holds a function.
        types.Record? rec = ot as types.Record;
        if (rec != null) {
            types.FuncType? sig = rec.methodSig(callee.property);
            if (sig != null) {
                // The compiler emits one copy of a method for each type that
                // has it (§2.4). On a sealed receiver that copy would run on a
                // value of any extending type, which is the wrong body.
                // Narrowing first makes the type of the receiver certain.
                if (rec.sealed) {
                    self.errorf(ex.tok, "cannot call %s.%s here: %s is sealed, so this value may be of any type extending it, and a method is chosen by the type written down; match its type first (switch (%s) { case ... })",
                        types.typeString(rec), callee.property, types.typeString(rec), ast.exprString(callee.object));
                    return self.visitArgsInvalid(ex);
                }
                MethodRef mr = { owner: rec, name: callee.property, sig: sig };
                self.info.methodCalls[ex.id] = mr;
                self.noteCall(ownerMethod(rec.name + "." + callee.property), ex.tok);
                self.checkArgs(ex, rec.name + "." + callee.property, sig);
                return self.callProduces(ex, sig);
            }
            // Neither a method nor a field. Only a field holding a function
            // value is callable, so the error belongs here.
            if (rec.fieldType(callee.property) == null) {
                String hint = "";
                String[] names = rec.methodNames();
                if (names.length > 0) {
                    hint = " (available: " + string.join(names, ", ") + ")";
                }
                self.errorf(ex.tok, "type %s has no method %s%s", rec.name, quote.quote(callee.property), hint);
                return self.visitArgsInvalid(ex);
            }
        }
        if ((ot as types.Array) != null) {
            String p = callee.property;
            if (p == "push" || p == "pop" || p == "copy") {
                self.errorf(ex.tok, "arrays have no methods; %s is a function of the array library: import 'array'; array.%s(...)", p, p);
            } else {
                self.errorf(ex.tok, "arrays have no method %s (iterate with forEach(array, element) { ... })", quote.quote(p));
            }
            return self.visitArgsInvalid(ex);
        }
        if ((ot as types.MapType) != null) {
            String p2 = callee.property;
            if (p2 == "has" || p2 == "remove" || p2 == "keys" || p2 == "values" || p2 == "copy") {
                self.errorf(ex.tok, "maps have no methods; %s is a function of the map library: import 'map'; map.%s(...)", p2, p2);
            } else {
                self.errorf(ex.tok, "maps have no method %s (the map library has: copy, has, keys, remove, values)", quote.quote(p2));
            }
            return self.visitArgsInvalid(ex);
        }
        // A member that holds a function value, such as a record field: type
        // the member and call through it.
        types.Type mt = self.exprType(ex.callee, null);
        types.FuncType? msig = mt as types.FuncType;
        if (msig != null) {
            self.checkArgs(ex, callee.property, msig);
            return self.callProduces(ex, msig);
        }
        types.Optional? mopt = mt as types.Optional;
        if (mopt != null) {
            if ((mopt.inner as types.FuncType) != null) {
                self.errorf(ex.tok, "cannot call optional type %s (compare with null first)", types.typeString(mt));
            } else {
                self.errorf(ex.tok, "cannot call %s on %s", quote.quote(callee.property), types.typeString(ot));
            }
        } else if (!types.isInvalid(mt)) {
            self.errorf(ex.tok, "cannot call %s on %s", quote.quote(callee.property), types.typeString(ot));
        }
        return self.visitArgsInvalid(ex);
    }

    // moduleCallType types `alias.name(args)`: an exported function of an
    // imported module, or an exported variable holding a function value.
    types.Type moduleCallType(ast.CallExpression ex, String alias, ModuleRef ref, String fn) {
        ModuleExports? expOpt = ref.exports;
        if (expOpt == null) {
            return self.visitArgsInvalid(ex);
        }
        ModuleExports exp = expOpt;
        types.FuncType? sig = exp.funcs[fn];
        if (sig != null) {
            self.checkArgs(ex, alias + "." + fn, sig);
            return self.callProduces(ex, sig);
        }
        if (exp.vars[fn] != null) {
            types.Type vt = self.exprType(ex.callee, null);    // narrows an optional function variable
            types.FuncType? vsig = vt as types.FuncType;
            if (vsig != null) {
                self.checkArgs(ex, alias + "." + fn, vsig);
                return self.callProduces(ex, vsig);
            }
            types.Optional? opt = vt as types.Optional;
            if (opt != null) {
                if ((opt.inner as types.FuncType) != null) {
                    self.errorf(ex.tok, "cannot call optional type %s (compare %s.%s with null first)",
                        types.typeString(vt), alias, fn);
                } else {
                    self.errorf(ex.tok, "%s.%s is not a function", alias, fn);
                }
            } else if (!types.isInvalid(vt)) {
                self.errorf(ex.tok, "%s.%s is not a function", alias, fn);
            }
        } else if (exp.records[fn] != null) {
            self.errorf(ex.tok, "%s.%s is a type, not a function", alias, fn);
        } else if (exp.enums[fn] != null) {
            self.errorf(ex.tok, "%s.%s is a type, not a function", alias, fn);
        } else {
            self.moduleNoMemberError(ex.tok, alias, ref, fn);
        }
        return self.visitArgsInvalid(ex);
    }

    types.Type jsonCallType(ast.CallExpression ex, String alias, String fn) {
        if (fn == "parse") {
            // With no `as`, a parse has no type to check the document against,
            // so it answers the shape of the document (§6.3). asType handles
            // the form that carries a type.
            if (ex.args.length != 1) {
                self.errorf(ex.tok, "%s.parse takes exactly 1 argument, got %s", alias, string.from(ex.args.length));
                forEach(ex.args, a) {
                    self.exprType(a, types.StringT);
                }
                return types.JsonT;
            }
            types.Type at = self.exprType(ex.args[0], types.StringT);
            if (!types.isInvalid(at) && !types.assignable(types.StringT, at)
                && !types.isByteArray(at)) {
                self.errorf(ex.args[0].tok, "%s.parse takes a String or a byte[], got %s", alias, types.typeString(at));
            }
            // Parsed text comes from outside the program, so a bad document is
            // a failure the caller can catch and not a stop (§2.9).
            self.noteRaise(ex);
            return types.JsonT;
        }
        if (fn == "push") {
            // The value takes the conversion an indexed assignment makes: a
            // value with a JSON form becomes a node (§6.3). No one parameter
            // type describes that set, so the check cannot be a signature.
            if (ex.args.length != 2) {
                self.errorf(ex.tok, "%s.push takes exactly 2 arguments, got %s", alias, string.from(ex.args.length));
                forEach(ex.args, a2) {
                    self.exprType(a2, null);
                }
                return types.VoidT;
            }
            types.Type at2 = self.exprType(ex.args[0], types.JsonT);
            if (!types.isInvalid(at2) && !types.equal(at2, types.JsonT)) {
                self.errorf(ex.args[0].tok, "argument 1 of %s.push: cannot use %s as Json", alias, types.typeString(at2));
            }
            types.Type vt = self.exprType(ex.args[1], null);
            self.checkJSONWritable(ex.args[1], vt, "append to a Json");
            return types.VoidT;
        }
        types.FuncType? sig = jsonFuncs[fn];
        if (sig != null) {
            self.checkArgs(ex, alias + "." + fn, sig);
            return self.callProduces(ex, sig);
        }
        if (fn != "toText") {
            self.errorf(ex.tok, "%s has no function %s (available: %s)", alias, quote.quote(fn), jsonFuncNamesText);
            return types.InvalidT;
        }
        if (ex.args.length != 1) {
            self.errorf(ex.tok, "%s.toText takes exactly 1 argument, got %s", alias, string.from(ex.args.length));
            return types.StringT;
        }
        types.Type at3 = self.exprType(ex.args[0], null);
        if (types.equal(at3, types.VoidT) || types.equal(at3, types.NullT)) {
            self.errorf(ex.args[0].tok, "cannot serialize %s", types.typeString(at3));
        } else if (!types.isInvalid(at3) && containsFuture(at3)) {
            self.errorf(ex.args[0].tok, "cannot serialize %s: futures have no JSON form (await the value first)",
                types.typeString(at3));
        } else if (!types.isInvalid(at3) && badJSONMapKey(at3)) {
            self.errorf(ex.args[0].tok, "cannot serialize %s: JSON object keys are strings, so only Map<String, ...> has a JSON form",
                types.typeString(at3));
        } else if (!types.isInvalid(at3) && !jsonSerializable(at3)) {
            self.errorf(ex.args[0].tok, "cannot serialize %s: %s have no JSON form (as a record field one is omitted, but here there is nothing to omit it from)",
                types.typeString(at3), opaqueKind(at3));
        }
        return types.StringT;
    }

    // Checks `expr as T`, which reads JSON into a T. The document comes from
    // text through json.parse, or from a Json the program holds (§3.6); both
    // walk it against the same type descriptor. The read can fail in either
    // shape, because the data comes from outside the program.
    types.Type asType(ast.AsExpression ex) {
        types.Type target = self.resolveTypeAt(ex.type, "");

        ast.CallExpression? call = ex.value as ast.CallExpression;
        if (call != null && self.isJSONParse(call)) {
            if (call.args.length != 1) {
                self.errorf(call.tok, "json.parse takes exactly 1 argument, got %s", string.from(call.args.length));
                forEach(call.args, a) {
                    self.exprType(a, types.StringT);
                }
                return target;
            }
            types.Type at = self.exprType(call.args[0], types.StringT);
            if (!types.isInvalid(at) && !types.assignable(types.StringT, at)
                && !types.isByteArray(at)) {
                self.errorf(call.args[0].tok, "json.parse takes a String or a byte[], got %s", types.typeString(at));
            }
            self.checkAsTarget(ex, target);
            // The call carries the target type, so codegen reads it there and
            // knows this parse is typed and not bare.
            self.info.types[call.id] = target;
            self.noteRaise(ex);
            return target;
        }

        types.Type vt = self.exprType(ex.value, types.JsonT);
        if (types.isInvalid(vt)) {
            return target;
        }
        // The third thing `as` does (§3.6), told apart by the left operand: a
        // Json reads a document and can raise, a sealed record narrows to T?,
        // and a number converts and always succeeds.
        if (types.natural(vt) != null && types.natural(target) != null) {
            return self.numericAsType(ex, vt, target);
        }
        if ((types.equal(vt, types.DateTimeT) || types.equal(vt, types.DurationT))
            && types.natural(target) != null) {
            // Both are an i64 count of milliseconds, so the bits need no work.
            // The unit is the whole content of the type (§6.4), so a function
            // must name it.
            self.errorf(ex.tok, "'as' does not convert %s to %s: a %s is a count of milliseconds, so say so with time.milliseconds(x)",
                types.typeString(vt), types.typeString(target), types.typeString(vt));
            return target;
        }
        // A narrowing of a sealed type (§2.4) to one of its extenders. It reads
        // nothing: the result is the same value at the narrower type, or null.
        types.Record? base = vt as types.Record;
        if (base != null && base.sealed) {
            return self.downcastType(ex, base, target);
        }
        if (!types.equal(vt, types.JsonT)) {
            // The target is a union or a sealed type, so the source narrowed in
            // the wrong direction. `as` goes to the narrower type, because only
            // that direction can fail.
            types.Record? want = target as types.Record;
            if (want != null && want.sealed) {
                if (types.assignable(target, vt) || unionAccepts(want, vt)) {
                    self.errorf(ex.tok, "%s is already %s and needs no 'as' (§2.10): 'as' narrows %s to %s, which is the only direction whose answer can be no",
                        types.typeString(vt), types.typeString(want),
                        types.typeString(want), narrowsTo(want));
                    return target;
                }
                self.errorf(ex.tok, "%s is not %s, and 'as' cannot make it one: %s",
                    types.typeString(vt), types.typeString(want), extendersOf(want));
                return target;
            }
            types.Record? rec = vt as types.Record;
            if (rec != null) {
                self.errorf(ex.tok, "'as' can narrow a sealed type to one extending it, but %s is not sealed; on anything else it reads JSON and needs json.parse(text) or a Json on its left",
                    types.typeString(rec));
                return target;
            }
            self.errorf(ex.tok, "'as' reads JSON into a type, so it needs json.parse(text) or a Json on its left, not %s",
                types.typeString(vt));
            return target;
        }
        self.checkAsTarget(ex, target);
        self.noteRaise(ex);
        return target;
    }

    // Checks `expr as T` between two number types (§3.6). It is the only way
    // back into a narrow type after an operator widened it. Among the integer
    // types it always succeeds and wraps (§2.1): the value keeps the low bits
    // of T and is read back in the family of T. A conversion that changes
    // nothing is not an error here, because whether `i as int64` changes
    // anything depends on the host.
    types.Type numericAsType(ast.AsExpression ex, types.Type vt, types.Type target) {
        if (ex.strict) {
            self.errorf(ex.tok, "'strict' belongs to a JSON read: there is no document here, only a %s to convert",
                types.typeString(vt));
        }
        bool vInt = types.isIntFamily(vt);
        bool tInt = types.isIntFamily(target);
        if (vInt != tInt) {
            self.errorf(ex.tok, "'as' does not convert between %s and %s: it reinterprets a number's bits, and the integer and float types do not share theirs",
                types.typeString(vt), types.typeString(target));
            return target;
        }
        self.info.numericAs[ex.id] = true;
        return target;
    }

    // Checks `expr as T` where expr is a sealed record and T extends it (§2.4,
    // §3.6), and gives the expression the type `T?`. The optional separates
    // this form from the JSON form: a document read fails for many reasons and
    // raises an Error, while a narrowing fails for one, which null says.
    types.Type downcastType(ast.AsExpression ex, types.Record base, types.Type target) {
        if (types.isInvalid(target)) {
            return target;
        }
        if (ex.strict) {
            self.errorf(ex.tok, "'strict' belongs to a JSON read: there is no document here, only a %s to narrow",
                types.typeString(base));
        }
        types.Record? ext = target as types.Record;
        if (ext == null || !ext.extends(base)) {
            self.errorf(ex.type.tok, "cannot narrow %s to %s: %s",
                types.typeString(base), types.typeString(target), extendersOf(base));
            return types.newOptional(target);
        }
        // `t as Union.Tag` gives what the member holds, not the record holding
        // it: no program can name the payload field, so a result of the member
        // type would have no operations (§3.6).
        types.Type? pay = unionPayload(ext);
        if (pay != null) {
            types.Type pt = pay;
            self.info.asMembers[ex.id] = ext;
            return types.newOptional(pt);
        }
        return types.newOptional(ext);
    }

    // checkAsTarget rejects a target type that no document can be read into.
    void checkAsTarget(ast.AsExpression ex, types.Type target) {
        if (types.isInvalid(target)) {
            return;
        }
        String why = jsonParseable(target);
        if (why != "") {
            self.errorf(ex.type.tok, "cannot parse JSON into %s: %s", types.typeString(target), why);
            return;
        }
        // `strict` refuses an undeclared key and a catch-all field keeps every
        // one, so a program that writes both gets an error.
        if (ex.strict) {
            types.Record? rec = target as types.Record;
            if (rec != null && rec.restField() >= 0) {
                self.errorf(ex.tok, "%s collects unknown JSON keys into %s, so a strict parse has nothing to refuse; drop 'strict' or drop the 'json*' field",
                    types.typeString(rec), quote.quote(rec.fields[rec.restField()].name));
            }
        }
    }

    bool isJSONParse(ast.CallExpression call) {
        ast.MemberExpression? callee = call.callee as ast.MemberExpression;
        if (callee == null || callee.optional || callee.property != "parse") {
            return false;
        }
        ast.Identifier? id = callee.object as ast.Identifier;
        if (id == null) {
            return false;
        }
        ModuleRef? ref = self.info.moduleAliases[id.name];
        return ref != null && ref.builtin == "json";
    }

    // timeCallType types the time functions that work with instants and spans.
    // The calendar functions sit one level down, under `time.date`.
    types.Type timeCallType(ast.CallExpression ex, String alias, String fn) {
        if (!builtins.hasSig("time", fn)) {
            if (builtins.hasSig("time.date", fn)) {
                self.errorf(ex.tok, "%s has no function %s; it is a calendar function: %s.date.%s(...)",
                    alias, quote.quote(fn), alias, fn);
                return self.visitArgsInvalid(ex);
            }
            return self.noSuchBuiltin(ex, alias, fn,
                "now, duration, milliseconds, sleep, and the calendar functions under " + alias + ".date");
        }
        return self.builtinCall(ex, "time", alias, fn);
    }

    // asyncCallType types the functions of the built-in async module.
    // `async.run(f, cb)` registers cb to run when f completes. The callback
    // takes the result of the future, so it is `Function()<void>` for a
    // Future<void>.
    types.Type asyncCallType(ast.CallExpression ex, String alias, String fn) {
        if (fn == "race") {
            return self.asyncRaceType(ex, alias);
        }
        if (fn != "run") {
            if (fn == "sleep") {
                self.errorf(ex.tok, "%s has no function \"sleep\"; it moved to the time module: import 'time'; time.sleep(ms)", alias);
            } else {
                self.errorf(ex.tok, "%s has no function %s (available: race, run)", alias, quote.quote(fn));
            }
            return self.visitArgsInvalid(ex);
        }
        if (ex.args.length != 2) {
            self.errorf(ex.tok, "%s.run takes 2 argument(s), got %s", alias, string.from(ex.args.length));
            forEach(ex.args, a) {
                self.exprType(a, null);
            }
            return types.VoidT;
        }
        types.Type ft = self.exprType(ex.args[0], null);
        types.FutureType? fut = ft as types.FutureType;
        if (fut == null) {
            if (!types.isInvalid(ft)) {
                self.errorf(ex.args[0].tok, "argument 1 of %s.run must be a future, got %s", alias, types.typeString(ft));
            }
            self.exprType(ex.args[1], null);
            return types.VoidT;
        }
        if (fut.fallible) {
            // A completion callback has no error channel, so a failure would
            // have nowhere to go. An await is where catch applies (§2.9).
            self.errorf(ex.args[0].tok, "argument 1 of %s.run cannot be a fallible future (%s): await it instead, so its error has somewhere to go",
                alias, types.typeString(fut));
        }
        types.FuncType want = types.newFuncType([], types.VoidT);
        if (!types.equal(fut.elem, types.VoidT)) {
            array.push(want.params, fut.elem);
        }
        types.Type ct = self.exprType(ex.args[1], want);
        if (!types.isInvalid(ct) && !types.assignable(want, ct)) {
            self.errorf(ex.args[1].tok, "argument 2 of %s.run: cannot use %s as %s",
                alias, types.typeString(ct), types.typeString(want));
        }
        return types.VoidT;
    }

    // asyncRaceType types `async.race(f1, f2, ...)`, a future of the index of
    // the first argument to complete. It answers an index because the arguments
    // need not share a type. A fallible argument is permitted, unlike in
    // async.run: the race leaves every argument unchanged, so the error waits
    // at the await that collects it (§2.9).
    types.Type asyncRaceType(ast.CallExpression ex, String alias) {
        types.FutureType out = types.newFutureType(types.IntT, false);
        if (ex.args.length == 0) {
            self.errorf(ex.tok, "%s.race takes at least 1 argument, got 0", alias);
            return out;
        }
        forEach(ex.args, a, i) {
            types.Type t = self.exprType(a, null);
            if (types.isInvalid(t)) {
                continue;
            }
            if ((t as types.FutureType) == null) {
                self.errorf(a.tok, "argument %s of %s.race must be a future, got %s",
                    string.from(i + 1), alias, types.typeString(t));
            }
        }
        return out;
    }

    // arrayCallType types the functions of the built-in array module. They are
    // generic over the element type, so each one has its own check: the first
    // argument fixes the array type and the others follow from it. push and pop
    // change the length, so they take a growable array (T[]) only, and every
    // function that answers an array answers a growable one.
    types.Type arrayCallType(ast.CallExpression ex, String alias, String fn) {
        int lo = 0;
        int hi = 0;
        if (fn == "push") {
            lo = 2;
            hi = 2;
        } else if (fn == "pop" || fn == "copy") {
            lo = 1;
            hi = 1;
        } else if (fn == "sort") {
            lo = 1;
            hi = 2;
        } else if (fn == "indexOf") {
            lo = 2;
            hi = 2;
        } else if (fn == "slice") {
            lo = 2;
            hi = 3;
        } else if (fn == "map" || fn == "filter" || fn == "find" || fn == "some" || fn == "every"
            || fn == "contains" || fn == "fill" || fn == "concat") {
            lo = 2;
            hi = 2;
        } else if (fn == "reduce") {
            lo = 3;
            hi = 3;
        } else if (fn == "reverse" || fn == "flatten") {
            lo = 1;
            hi = 1;
        } else {
            self.errorf(ex.tok, "%s has no function %s (available: concat, contains, copy, every, fill, filter, find, flatten, indexOf, map, pop, push, reduce, reverse, slice, some, sort)",
                alias, quote.quote(fn));
            return self.visitArgsInvalid(ex);
        }
        if (ex.args.length < lo || ex.args.length > hi) {
            String want = string.from(lo);
            if (lo != hi) {
                want = want + " or " + string.from(hi);
            }
            self.errorf(ex.tok, "%s.%s takes %s argument(s), got %s", alias, fn, want, string.from(ex.args.length));
            return self.visitArgsInvalid(ex);
        }
        types.Type at = self.exprType(ex.args[0], null);
        types.Array? arr = at as types.Array;
        if (arr == null) {
            if (!types.isInvalid(at)) {
                self.errorf(ex.args[0].tok, "argument 1 of %s.%s must be an array, got %s",
                    alias, fn, types.typeString(at));
            }
            forEach(ex.args, a, i) {
                if (i > 0) {
                    self.exprType(a, null);
                }
            }
            return types.InvalidT;
        }
        // Only the two functions that change a length refuse a fixed-size
        // array.
        if (arr.len > 0 && (fn == "push" || fn == "pop")) {
            String prep = "from";
            if (fn == "push") {
                prep = "to";
            }
            self.errorf(ex.args[0].tok, "cannot %s %s a fixed-size array (%s); its length is part of the type",
                fn, prep, types.typeString(arr));
        }
        if (fn == "push") {
            types.Type vt = self.exprType(ex.args[1], arr.elem);
            if (!types.isInvalid(vt) && !types.isInvalid(arr.elem) && !types.assignable(arr.elem, vt)) {
                self.errorf(ex.args[1].tok, "argument 2 of %s.push: cannot use %s as %s",
                    alias, types.typeString(vt), types.typeString(arr.elem));
            }
            return types.VoidT;
        }
        if (fn == "pop") {
            return arr.elem;
        }
        if (fn == "sort") {
            self.checkSortOrder(ex, alias, arr);
            return types.VoidT;
        }
        if (fn == "map") {
            // The result type is the function's own, so no expectation can be
            // written for it: the argument is typed as it stands.
            String mname = alias + ".map";
            types.Type ft = self.exprType(ex.args[1], null);
            if (types.isInvalid(ft)) {
                return types.InvalidT;
            }
            types.FuncType? mf = ft as types.FuncType;
            if (mf == null || mf.params.length != 1 || mf.variadic) {
                self.errorf(ex.args[1].tok, "argument 2 of %s must be a function of one %s (Function(%s)<U>), got %s",
                    mname, types.typeString(arr.elem), types.typeString(arr.elem), types.typeString(ft));
                return types.InvalidT;
            }
            if (mf.fallible) {
                self.errorf(ex.args[1].tok, "argument 2 of %s cannot be fallible: %s has no way to report an error raised inside it; catch it in the function",
                    mname, mname);
                return types.InvalidT;
            }
            if (!types.isInvalid(arr.elem) && !types.assignable(mf.params[0], arr.elem)) {
                self.errorf(ex.args[1].tok, "argument 2 of %s must take %s, got %s",
                    mname, types.typeString(arr.elem), types.typeString(ft));
                return types.InvalidT;
            }
            if (types.equal(mf.return, types.VoidT)) {
                self.errorf(ex.args[1].tok, "argument 2 of %s must answer a value; the result is an array of what it answers", mname);
                return types.InvalidT;
            }
            return types.newArray(mf.return);
        }
        if (fn == "filter" || fn == "find" || fn == "some" || fn == "every") {
            types.FuncType want = types.newFuncType([arr.elem], types.BoolT);
            if (!self.checkFnArg(ex.args[1], alias + "." + fn, 2, want)) {
                return types.InvalidT;
            }
            if (fn == "filter") {
                return types.newArray(arr.elem);
            }
            if (fn == "find") {
                return types.newOptional(arr.elem);
            }
            return types.BoolT;
        }
        if (fn == "reduce") {
            types.Type acc = self.exprType(ex.args[1], null);
            if (types.isInvalid(acc)) {
                self.exprType(ex.args[2], null);
                return types.InvalidT;
            }
            if (types.equal(acc, types.NullT) || types.equal(acc, types.VoidT)) {
                self.errorf(ex.args[1].tok, "argument 2 of %s.reduce: cannot use %s as the starting value",
                    alias, types.typeString(acc));
                self.exprType(ex.args[2], null);
                return types.InvalidT;
            }
            types.FuncType want2 = types.newFuncType([acc, arr.elem], acc);
            if (!self.checkFnArg(ex.args[2], alias + ".reduce", 3, want2)) {
                return types.InvalidT;
            }
            return acc;
        }
        if (fn == "contains") {
            types.Type ct = self.exprType(ex.args[1], arr.elem);
            if (!types.isInvalid(ct) && !types.isInvalid(arr.elem)) {
                if (!self.equalityOK(arr.elem, arr.elem)) {
                    self.errorf(ex.args[0].tok, "cannot use %s.contains on %s: %s values cannot be compared with ==",
                        alias, types.typeString(arr), types.typeString(arr.elem));
                } else if (!types.assignable(arr.elem, ct)) {
                    self.errorf(ex.args[1].tok, "argument 2 of %s.contains: cannot use %s as %s",
                        alias, types.typeString(ct), types.typeString(arr.elem));
                }
            }
            return types.BoolT;
        }
        if (fn == "reverse") {
            return types.VoidT;
        }
        if (fn == "fill") {
            types.Type fv = self.exprType(ex.args[1], arr.elem);
            if (!types.isInvalid(fv) && !types.isInvalid(arr.elem) && !types.assignable(arr.elem, fv)) {
                self.errorf(ex.args[1].tok, "argument 2 of %s.fill: cannot use %s as %s",
                    alias, types.typeString(fv), types.typeString(arr.elem));
            }
            return types.VoidT;
        }
        if (fn == "concat") {
            types.Type bt = self.exprType(ex.args[1], types.newArray(arr.elem));
            types.Array? barr = bt as types.Array;
            if (!types.isInvalid(bt) && (barr == null || !types.equal(barr.elem, arr.elem))) {
                self.errorf(ex.args[1].tok, "argument 2 of %s.concat: cannot use %s as %s",
                    alias, types.typeString(bt), types.typeString(types.newArray(arr.elem)));
            }
            return types.newArray(arr.elem);
        }
        if (fn == "flatten") {
            types.Array? inner = arr.elem as types.Array;
            if (inner == null) {
                if (!types.isInvalid(arr.elem)) {
                    self.errorf(ex.args[0].tok, "argument 1 of %s.flatten must be an array of arrays, got %s",
                        alias, types.typeString(arr));
                }
                return types.InvalidT;
            }
            return types.newArray(inner.elem);
        }
        if (fn == "indexOf") {
            types.Type vt2 = self.exprType(ex.args[1], arr.elem);
            if (!types.isInvalid(vt2) && !types.isInvalid(arr.elem)) {
                // indexOf accepts the element types `==` accepts (§3.2), and
                // the runtime uses the same rt_eq. Records and arrays compare
                // by reference, so a search would find only the value the
                // caller already has.
                if (!self.equalityOK(arr.elem, arr.elem)) {
                    self.errorf(ex.args[0].tok, "cannot use %s.indexOf on %s: %s values cannot be compared with ==",
                        alias, types.typeString(arr), types.typeString(arr.elem));
                } else if (!types.assignable(arr.elem, vt2)) {
                    self.errorf(ex.args[1].tok, "argument 2 of %s.indexOf: cannot use %s as %s",
                        alias, types.typeString(vt2), types.typeString(arr.elem));
                }
            }
            return types.IntT;
        }
        if (fn == "slice") {
            forEach(ex.args, a2, i2) {
                if (i2 == 0) {
                    continue;
                }
                types.Type it = self.exprType(a2, types.IntT);
                if (!types.isInvalid(it) && !types.isIntFamily(it)) {
                    self.errorf(a2.tok, "argument %s of %s.slice must be an int, got %s",
                        string.from(i2 + 1), alias, types.typeString(it));
                }
            }
            return types.newArray(arr.elem);
        }
        return types.newArray(arr.elem);    // copy
    }

    // Checks a function-value argument against the signature a library
    // function calls it with (§6.5). A fallible one is refused: the loop that
    // calls it cannot carry a raise out, and neither can a sort.
    bool checkFnArg(ast.Expression arg, String name, int pos, types.FuncType want) {
        types.Type ft = self.exprType(arg, want);
        if (types.isInvalid(ft)) {
            return false;
        }
        types.FuncType? fn = ft as types.FuncType;
        if (fn == null) {
            self.errorf(arg.tok, "argument %s of %s must be %s, got %s",
                string.from(pos), name, types.typeString(want), types.typeString(ft));
            return false;
        }
        if (fn.fallible) {
            self.errorf(arg.tok, "argument %s of %s cannot be fallible: %s has no way to report an error raised inside it; catch it in the function",
                string.from(pos), name, name);
            return false;
        }
        if (!types.assignable(want, ft)) {
            self.errorf(arg.tok, "argument %s of %s must be %s, got %s",
                string.from(pos), name, types.typeString(want), types.typeString(ft));
            return false;
        }
        return true;
    }

    // Checks the argument that decides the order of a sort: either absent, and
    // the element type must have an order, or a comparator that gives one.
    void checkSortOrder(ast.CallExpression ex, String alias, types.Array arr) {
        if (ex.args.length == 1) {
            // With no comparator the order comes from the element type, which
            // must be one the language orders with `<` (§3.1).
            if (!types.isInvalid(arr.elem) && !orderableBasic(arr.elem)) {
                String el = types.typeString(arr.elem);
                self.errorf(ex.args[0].tok, "cannot sort %s: %s values have no order; pass a comparator (%s.sort(a, %s))",
                    types.typeString(arr), el, alias, "bool (" + el + " a, " + el + " b) -> …");
            }
            return;
        }
        types.FuncType want = types.newFuncType([arr.elem, arr.elem], types.BoolT);
        types.Type ft = self.exprType(ex.args[1], want);
        if (types.isInvalid(ft)) {
            return;
        }
        types.FuncType? fn = ft as types.FuncType;
        if (fn == null) {
            self.errorf(ex.args[1].tok, "argument 2 of %s.sort must be %s, got %s",
                alias, types.typeString(want), types.typeString(ft));
            return;
        }
        // A fallible function returns a {T, ptr} pair, which does not cross
        // into C, so the sort in C cannot carry the raise back out.
        if (fn.fallible) {
            self.errorf(ex.args[1].tok, "argument 2 of %s.sort cannot be fallible: a sort has no way to report an error raised inside it; catch it in the comparator", alias);
            return;
        }
        if (!types.assignable(want, ft)) {
            self.errorf(ex.args[1].tok, "argument 2 of %s.sort must be %s, got %s",
                alias, types.typeString(want), types.typeString(ft));
        }
    }

    // mapCallType types the functions of the built-in map module. They are
    // generic, like the array ones: the first argument fixes Map<K, V>, and
    // the key argument and the result follow from it.
    types.Type mapCallType(ast.CallExpression ex, String alias, String fn) {
        int want = 0;
        if (fn == "has" || fn == "remove") {
            want = 2;
        } else if (fn == "keys" || fn == "values" || fn == "copy") {
            want = 1;
        } else {
            self.errorf(ex.tok, "%s has no function %s (available: copy, has, keys, remove, values)",
                alias, quote.quote(fn));
            return self.visitArgsInvalid(ex);
        }
        if (ex.args.length != want) {
            self.errorf(ex.tok, "%s.%s takes %s argument(s), got %s",
                alias, fn, string.from(want), string.from(ex.args.length));
            return self.visitArgsInvalid(ex);
        }
        types.Type at = self.exprType(ex.args[0], null);
        types.MapType? mt = at as types.MapType;
        if (mt == null) {
            if (!types.isInvalid(at)) {
                self.errorf(ex.args[0].tok, "argument 1 of %s.%s must be a map, got %s",
                    alias, fn, types.typeString(at));
            }
            forEach(ex.args, a, i) {
                if (i > 0) {
                    self.exprType(a, null);
                }
            }
            return types.InvalidT;
        }
        if (want == 2) {
            types.Type kt = self.exprType(ex.args[1], mt.key);
            if (!types.isInvalid(kt) && !types.isInvalid(mt.key) && !types.assignable(mt.key, kt)) {
                self.errorf(ex.args[1].tok, "argument 2 of %s.%s: cannot use %s as %s",
                    alias, fn, types.typeString(kt), types.typeString(mt.key));
            }
        }
        if (fn == "has" || fn == "remove") {
            return types.BoolT;
        }
        if (fn == "keys") {
            return types.newArray(mt.key);
        }
        if (fn == "values") {
            return types.newArray(mt.value);
        }
        return types.newMapType(mt.key, mt.value);    // copy
    }

    // stringCallType types the functions of the built-in string module. Every
    // signature but that of `from` is fixed, so one table covers them.
    types.Type stringCallType(ast.CallExpression ex, String alias, String fn) {
        if (fn == "from") {
            return self.stringFromCall(ex, alias);
        }
        return self.builtinCall(ex, "string", alias, fn);
    }

    // Checks `string.from(v)` (§6.6), whose parameter is a set of types and not
    // one type. Its result is the text `print` writes for the same value, so it
    // takes what print takes: `printable` is that set, and the two agree.
    types.Type stringFromCall(ast.CallExpression ex, String alias) {
        String name = alias + ".from";
        // A hole in an interpolated string (§1.6) arrives through the
        // template alias, which no program wrote, so its messages name the
        // hole and not the call.
        String subject = "argument 1 of " + name;
        String taker = "from";
        if (alias == ast.templateAlias) {
            subject = "the value in ${}";
            taker = "a ${}";
        }
        if (ex.args.length != 1) {
            self.errorf(ex.tok, "%s takes 1 argument(s), got %s", name, string.from(ex.args.length));
            forEach(ex.args, a) {
                self.exprType(a, null);
            }
            return types.StringT;
        }
        ast.Expression a2 = ex.args[0];
        types.Type at = self.exprType(a2, null);
        bool isFn = (types.unwrap(at) as types.FuncType) != null;
        if (types.equal(at, types.VoidT)) {
            self.errorf(a2.tok, "%s: cannot use a void value", subject);
        } else if (types.equal(at, types.NullT)) {
            self.errorf(a2.tok, "%s: cannot use a bare null", subject);
        } else if (isFn) {
            self.errorf(a2.tok, "%s: cannot use a function value", subject);
        } else if (!types.isInvalid(at) && !printable(at)) {
            self.errorf(a2.tok, "%s: cannot use %s; %s takes what print takes (strings, numbers, bools, DateTime and Duration values, and enums; serialize records, arrays, and maps with json.toText)",
                subject, types.typeString(at), taker);
        }
        return types.StringT;
    }

    // mathCallType types the functions of the math module (§6.21). Five take
    // any number type and so have no fixed signature: abs, min, max and clamp
    // answer the widened type their arguments give under `+`, and toFloat
    // takes either integer family. The rest go through the signature table.
    types.Type mathCallType(ast.CallExpression ex, String alias, String fn) {
        String name = alias + "." + fn;
        int want = 0;
        if (fn == "abs" || fn == "toFloat") {
            want = 1;
        } else if (fn == "min" || fn == "max") {
            want = 2;
        } else if (fn == "clamp") {
            want = 3;
        } else {
            return self.builtinCall(ex, "math", alias, fn);
        }
        if (ex.args.length != want) {
            self.errorf(ex.tok, "%s takes %s argument(s), got %s", name, string.from(want), string.from(ex.args.length));
            return self.visitArgsInvalid(ex);
        }
        types.Type[] ts = [];
        bool bad = false;
        forEach(ex.args, a, i) {
            types.Type t = self.exprType(a, null);
            array.push(ts, t);
            if (types.isInvalid(t)) {
                bad = true;
            } else if (types.natural(t) == null || (fn == "toFloat" && !types.isIntFamily(t))) {
                String wanted = "a number";
                if (fn == "toFloat") {
                    wanted = "an integer";
                }
                self.errorf(a.tok, "argument %s of %s: cannot use %s as %s",
                    string.from(i + 1), name, types.typeString(t), wanted);
                bad = true;
            }
        }
        if (bad) {
            return types.InvalidT;
        }
        if (fn == "toFloat") {
            return types.FloatT;
        }
        // A bare literal takes the family of the value beside it, as it does
        // beside an operator.
        forEach(ex.args, a2, i2) {
            forEach(ts, other, j) {
                if (i2 != j) {
                    ts[i2] = self.unsignedLit(a2, ts[i2], other);
                }
            }
        }
        types.Type res = types.widen(ts[0]);
        forEach(ts, t2, k) {
            if (k > 0) {
                types.Type? pair = types.widenPair(res, t2);
                if (pair == null) {
                    self.errorf(ex.tok, "%s: %s and %s do not mix (convert one with %s.toFloat or %s.toInt)",
                        name, types.typeString(res), types.typeString(t2), alias, alias);
                    return types.InvalidT;
                }
                res = pair;
            }
        }
        return res;
    }

    // randomCallType types the functions of the random module (§6.22). shuffle
    // and pick take any array, so they have no fixed signature: pick answers
    // the element type. The rest go through the signature table.
    types.Type randomCallType(ast.CallExpression ex, String alias, String fn) {
        if (fn != "shuffle" && fn != "pick") {
            return self.builtinCall(ex, "random", alias, fn);
        }
        String name = alias + "." + fn;
        if (ex.args.length != 1) {
            self.errorf(ex.tok, "%s takes 1 argument(s), got %s", name, string.from(ex.args.length));
            return self.visitArgsInvalid(ex);
        }
        types.Type at = self.exprType(ex.args[0], null);
        types.Array? arr = at as types.Array;
        if (arr == null) {
            if (!types.isInvalid(at)) {
                self.errorf(ex.args[0].tok, "argument 1 of %s must be an array, got %s", name, types.typeString(at));
            }
            return types.InvalidT;
        }
        if (fn == "pick") {
            return arr.elem;
        }
        return types.VoidT;
    }

    // processCallType types the functions on the process module itself: `exit`
    // and `getArgs`. The standard streams and `child` are namespaces (§6.12)
    // and go through processNsCallType.
    types.Type processCallType(ast.CallExpression ex, String alias, String fn) {
        if (!builtins.hasSig("process", fn) && isBuiltinNamespace("process", fn)) {
            self.errorf(ex.tok, "%s.%s is a group of functions, not a function; call one of them: %s.%s.%s(...)",
                alias, fn, alias, fn, nsExample(fn));
            return self.visitArgsInvalid(ex);
        }
        return self.builtinCall(ex, "process", alias, fn);
    }

    // processNsCallType types `process.stdout.fn(...)` and the other three
    // namespaces. qual holds the text of the call up to the function name, so
    // a diagnostic quotes the source.
    types.Type processNsCallType(ast.CallExpression ex, String qual, String ns, String fn) {
        String n = ns;
        if (n != "stdout" && n != "stderr" && n != "child") {
            n = "stdin";
        }
        return self.builtinCall(ex, "process." + n, qual, fn);
    }

    // netCallType types the functions on the net module itself: what a socket
    // can do after it exists, which is the same for every protocol. The three
    // protocols are namespaces (§6.15), so a call that opens something goes
    // through builtinCall under "net.tcp" and the other two names. close and
    // address take either a Socket or a Listener, which no type describes, so
    // they have no signature and are checked here.
    types.Type netCallType(ast.CallExpression ex, String alias, String fn) {
        if (!builtins.hasSig("net", fn) && isBuiltinNamespace("net", fn)) {
            self.errorf(ex.tok, "%s.%s is a group of functions, not a function; call one of them: %s.%s.%s(...)",
                alias, fn, alias, fn, nsExample(fn));
            return self.visitArgsInvalid(ex);
        }
        if (fn == "close" || fn == "address") {
            return self.netHandleCall(ex, alias, fn);
        }
        return self.builtinCall(ex, "net", alias, fn);
    }

    // netHandleCall types net.close and net.address, whose one argument is a
    // Socket or a Listener. close cannot fail, because an already-closed socket
    // is nothing to report; address can, because it has no address to give.
    types.Type netHandleCall(ast.CallExpression ex, String alias, String fn) {
        types.Type out = types.VoidT;
        if (fn == "address") {
            out = types.StringT;
        }
        if (ex.args.length != 1) {
            self.errorf(ex.tok, "%s.%s takes 1 argument(s), got %s",
                alias, fn, string.from(ex.args.length));
            forEach(ex.args, a) {
                self.exprType(a, null);
            }
            return out;
        }
        types.Type at = self.exprType(ex.args[0], null);
        if (!types.isInvalid(at) && !types.equal(at, types.SocketT)
            && !types.equal(at, types.ListenerT)) {
            self.errorf(ex.args[0].tok, "argument 1 of %s.%s must be a Socket or a Listener, got %s",
                alias, fn, types.typeString(at));
        }
        if (fn == "address") {
            self.noteRaise(ex);
        }
        return out;
    }

    // ---- the shared check for a built-in call with a fixed signature ----

    // optionalTail chooses the signature to check a call against when the last
    // parameter of the built-in is an options record the call can omit. To omit
    // it means what a record with every field null means. It tests the count
    // first, so a diagnostic names both forms, and answers null when the count
    // matches neither.
    types.FuncType? optionalTail(ast.CallExpression ex, String name, types.FuncType sig) {
        int full = sig.params.length;
        if (ex.args.length == full) {
            return sig;
        }
        if (ex.args.length == full - 1) {
            types.FuncType short = types.newFuncType(array.slice(sig.params, 0, full - 1), sig.return);
            short.async = sig.async;
            short.fallible = sig.fallible;
            short.variadic = sig.variadic;
            return short;
        }
        self.errorf(ex.tok, "%s takes %s or %s argument(s), got %s",
            name, string.from(full - 1), string.from(full), string.from(ex.args.length));
        forEach(ex.args, a) {
            self.exprType(a, null);
        }
        return null;
    }

    // builtinCall types a call of a built-in function with a fixed signature,
    // read from src/builtins.nio. module is the key of the table, such as "fs"
    // or the dotted name of a namespace like "process.child". qual is the alias
    // the file imported the module under, so a diagnostic quotes the source.
    types.Type builtinCall(ast.CallExpression ex, String module, String qual, String fn) {
        types.FuncType? sigOpt = builtins.lookupSig(module, fn);
        if (sigOpt == null) {
            return self.noSuchBuiltin(ex, qual, fn, builtins.available(module));
        }
        types.FuncType sig = sigOpt;
        if (builtins.hasOptionalTail(module, fn)) {
            types.FuncType? short = self.optionalTail(ex, qual + "." + fn, sig);
            if (short == null) {
                // The call still stands for its result type, so what follows
                // it can be checked.
                if (sig.fallible) {
                    self.noteRaise(ex);
                }
                return sig.return;
            }
            sig = short;
        }
        self.checkArgs(ex, qual + "." + fn, sig);
        if (sig.fallible) {
            self.noteRaise(ex);
        }
        return sig.return;
    }

    types.Type noSuchBuiltin(ast.CallExpression ex, String qual, String fn, String available) {
        self.errorf(ex.tok, "%s has no function %s (available: %s)", qual, quote.quote(fn), available);
        return self.visitArgsInvalid(ex);
    }

    // ---- the run ----

    void processImports(ast.Program prog, Map<String, ModuleExports> deps) {
        // An interpolated string (§1.6) calls string.from through
        // ast.templateAlias, so every file has that alias bound to the
        // built-in module whether or not it imports one. §1.3 keeps the mark
        // out of identifiers, so no import and no declaration can take it.
        ModuleRef template = { builtin: "string", exports: null };
        self.info.moduleAliases[ast.templateAlias] = template;
        forEach(prog.imports, imp) {
            if (imp.tok.line >= self.importLine) {
                self.importLine = imp.tok.line + 1;
            }
        }
        forEach(prog.imports, imp) {
            if (badAlias(imp.alias)) {
                self.errorf(imp.tok, "cannot use %s as a module name", quote.quote(imp.alias));
                continue;
            }
            if (self.info.moduleAliases[imp.alias] != null) {
                self.errorf(imp.tok, "module name %s already used by another import", quote.quote(imp.alias));
                continue;
            }
            if (has(builtinModules, imp.path)) {
                ModuleRef ref = { builtin: imp.path, exports: null };
                self.info.moduleAliases[imp.alias] = ref;
                continue;
            }
            ModuleExports? exp = deps[imp.path];
            if (exp == null) {
                self.errorf(imp.tok, "cannot resolve module '%s'", imp.path);
                continue;
            }
            ModuleRef ref2 = { builtin: "", exports: exp };
            self.info.moduleAliases[imp.alias] = ref2;
            // An extending type can inherit a body from this module, or from
            // any module it reaches, and that body resolves its names there.
            // See enterHome.
            self.homes[exp.qual] = exp;
            forEach(map.keys(exp.homes), q) {
                ModuleExports? home = exp.homes[q];
                if (home != null) {
                    self.homes[q] = home;
                }
            }
        }
    }

    // noteGlobalUse records that the body under check names a global. Every
    // read and every write reaches it through recordUse.
    void noteGlobalUse(String name) {
        if (self.owner == "") {
            return;
        }
        Map<String, bool>? m = self.init.reads[self.owner];
        if (m == null) {
            Map<String, bool> fresh = {};
            self.init.reads[self.owner] = fresh;
            fresh[name] = true;
            return;
        }
        m[name] = true;
    }

    void noteCall(String callee, token.Token at) {
        if (self.owner == "" || self.owner == callee) {
            return;    // outside any statement, or direct recursion
        }
        Edge e = { callee: callee, tok: at };
        Edge[]? es = self.init.calls[self.owner];
        if (es == null) {
            Edge[] fresh = [e];
            self.init.calls[self.owner] = fresh;
            return;
        }
        array.push(es, e);
    }

    // checkInitOrder runs once, after the statements of the module are checked,
    // because it needs the full call graph.
    void checkInitOrder(ast.Program prog) {
        // The position of each global declaration. The first declaration wins,
        // so a message points at the earliest one.
        forEach(prog.statements, s, i) {
            ast.VarDeclStatement? vd = s as ast.VarDeclStatement;
            if (vd == null) {
                continue;
            }
            if (self.init.declAt[vd.name] != null) {
                continue;
            }
            self.init.declAt[vd.name] = i;
            self.init.declPos[vd.name] = vd;
        }

        // reach(owner) is reads(owner) with every reach(callee) added, as a
        // fixpoint. The graph holds cycles from recursion, so the loop grows
        // the sets until they stop growing rather than recursing.
        Map<String, Map<String, bool>> reach = {};
        forEach(map.keys(self.init.reads), owner) {
            Map<String, bool>? rs = self.init.reads[owner];
            Map<String, bool> m = {};
            if (rs != null) {
                forEach(map.keys(rs), g) {
                    m[g] = true;
                }
            }
            reach[owner] = m;
        }
        forEach(map.keys(self.init.calls), owner) {
            if (reach[owner] == null) {
                Map<String, bool> empty = {};
                reach[owner] = empty;
            }
        }
        bool changed = true;
        while (changed) {
            changed = false;
            forEach(map.keys(self.init.calls), owner) {
                Edge[]? es = self.init.calls[owner];
                Map<String, bool>? mine = reach[owner];
                if (es == null || mine == null) {
                    continue;
                }
                forEach(es, e) {
                    Map<String, bool>? theirs = reach[e.callee];
                    if (theirs == null) {
                        continue;
                    }
                    forEach(map.keys(theirs), g) {
                        if (mine[g] == null) {
                            mine[g] = true;
                            changed = true;
                        }
                    }
                }
            }
        }

        // Statement i must not reach a global declared at i or after it. The
        // statement at i counts, because an initializer runs before the
        // assignment to the global.
        forEach(prog.statements, s, i) {
            String owner = ownerTop(i);
            Map<String, bool>? mine = reach[owner];
            if (mine == null) {
                continue;
            }
            Map<String, bool>? direct = self.init.reads[owner];
            forEach(map.keys(mine), g) {
                int? at = self.init.declAt[g];
                if (at == null || at < i) {
                    continue;
                }
                if (direct != null && direct[g] != null) {
                    continue;    // ordinary scoping already reported it
                }
                self.reportInitOrder(owner, g, at == i);
            }
        }
    }

    // reportInitOrder describes one violation, at the call that reaches the
    // global. A statement that reaches the global it declares gets its own
    // wording, because there is no earlier line to move it to.
    void reportInitOrder(String owner, String global, bool itself) {
        String via = "";
        token.Token at = { type: "", literal: "", line: 0, col: 0, note: "", quote: "", endLine: 0, endCol: 0 };
        Edge[]? es = self.init.calls[owner];
        if (es != null) {
            forEach(es, e) {
                Map<String, bool> seen = {};
                if (!self.reaches(e.callee, global, seen)) {
                    continue;
                }
                String name = calleeName(e.callee);
                if (via == "" || name < via) {
                    via = name;
                    at = e.tok;
                }
            }
        }
        if (itself) {
            self.errorf(at, "%s reads %s, the global this statement is declaring: its value is not assigned until the initializer has finished",
                via, quote.quote(global));
            return;
        }
        ast.VarDeclStatement? decl = self.init.declPos[global];
        String line = "?";
        if (decl != null) {
            line = string.from(decl.tok.line);
        }
        self.errorf(at, "%s reads %s, which is declared later on line %s: a global has no value until its own declaration runs (§5.1)",
            via, quote.quote(global), line);
    }

    // reaches answers whether owner names global, or calls a body that does.
    bool reaches(String owner, String global, Map<String, bool> seen) {
        if (seen[owner] != null) {
            return false;
        }
        seen[owner] = true;
        Map<String, bool>? rs = self.init.reads[owner];
        if (rs != null && rs[global] != null) {
            return true;
        }
        Edge[]? es = self.init.calls[owner];
        if (es == null) {
            return false;
        }
        bool found = false;
        forEach(es, e) {
            if (!found && self.reaches(e.callee, global, seen)) {
                found = true;
            }
        }
        return found;
    }

    // Validates every `export alias ...` (§5.4). A republished surface may not
    // name a module the file did not import, may not name a built-in, may not
    // name what the target does not export, and may not publish one name
    // twice. The merge itself is exportsOf's, which runs once the module is
    // checked.
    void checkReExports(ast.Program prog) {
        // Where each published name comes from: "" for a declaration of this
        // file, the alias otherwise. A collision is reported at the second.
        Map<String, String> from = {};
        forEach(prog.statements, s) {
            switch (s) {
                case ast.FunctionDeclStatement fd:
                    if (fd.exported) {
                        from[fd.name] = "";
                    }
                case ast.VarDeclStatement vd:
                    if (vd.exported) {
                        from[vd.name] = "";
                    }
                case ast.TypeDeclStatement td:
                    if (td.exported) {
                        from[td.name] = "";
                    }
                case ast.EnumDeclStatement ed:
                    if (ed.exported) {
                        from[ed.name] = "";
                    }
                default:
                    continue;
            }
        }
        forEach(prog.statements, s) {
            ast.ReExportStatement? re = s as ast.ReExportStatement;
            if (re != null) {
                self.checkReExport(re, from);
            }
        }
    }

    void checkReExport(ast.ReExportStatement re, Map<String, String> from) {
        ModuleRef? refOpt = self.info.moduleAliases[re.alias];
        if (refOpt == null) {
            self.errorf(re.aliasTok,
                "%s is not an imported module; a re-export republishes a module this file imports",
                quote.quote(re.alias));
            return;
        }
        ModuleRef ref = refOpt;
        if (ref.builtin != "") {
            self.errorf(re.aliasTok,
                "cannot re-export %s: it is a built-in library, and every file can import it for itself",
                re.alias);
            return;
        }
        ModuleExports? expOpt = ref.exports;
        if (expOpt == null) {
            return;
        }
        ModuleExports exp = expOpt;
        forEach(re.names, n, i) {
            if (exportsName(exp, n)) {
                continue;
            }
            token.Token at = re.nameToks[i];
            if (has(exp.names, n)) {
                self.errorf(at, "%s is not exported by module %s", quote.quote(n), re.alias);
            } else {
                self.errorf(at, "module %s has no exported name %s", re.alias, quote.quote(n));
            }
        }
        // One statement reports its first collision alone: republishing a
        // whole surface over another would otherwise report every name in it.
        bool said = false;
        forEach(republishedNames(exp, re), n) {
            String? prev = from[n];
            if (prev == null) {
                from[n] = re.alias;
                continue;
            }
            if (said) {
                continue;
            }
            said = true;
            if (prev == "") {
                self.errorf(re.aliasTok,
                    "this file declares %s itself, so %s cannot republish it",
                    quote.quote(n), re.alias);
            } else if (prev == re.alias) {
                self.errorf(re.aliasTok,
                    "%s is republished twice, and both publish %s",
                    re.alias, quote.quote(n));
            } else {
                self.errorf(re.aliasTok,
                    "%s is published by both %s and %s; name what each one publishes with show or hide",
                    quote.quote(n), prev, re.alias);
            }
        }
    }

    void run(ast.Program prog, Map<String, ModuleExports> deps) {
        self.processImports(prog, deps);
        // The enums come first: a record field can name an enum type, and an
        // enum body names no other type.
        self.collectEnums(prog);
        self.collectRecords(prog);
        self.collectFuncs(prog);
        self.checkReExports(prog);
        // Top-level code has no caller, so an error that escapes it stops
        // the program. It still needs a context for a catch to sit in.
        self.pushRaise("");
        RaiseCtx? r = self.raise;
        if (r != null) {
            r.top = true;
        }
        forEach(prog.statements, s, i) {
            // A global this statement reaches through a call must be declared
            // above it.
            self.owner = ownerTop(i);
            self.checkStatement(s);
        }
        self.owner = "";
        self.popRaise();
        self.checkInitOrder(prog);
        self.mergeInherited();
        self.info.top = self.scope;
    }
}

// FlowFacts is what condNarrow and condFacts return: what the truth of a
// condition proves, and what its falsehood proves.
type FlowFacts {
    Map<String, bool> tf;
    Map<String, bool> ff;
}

// HomeSave is what enterHome and enterInherited return: the tables to
// restore, and whether there is anything to restore.
type HomeSave {
    bool active;
    Map<String, types.Record> records;
    Map<String, types.Enum> enums;
    Map<String, types.FuncType> funcs;
    Map<String, ModuleRef> aliases;
    Scope scope;
    String qual;
    InheritedBody? body;
    bool hadBody;
}

Checker newChecker(String qual, String shown, Map<String, bool> seed) {
    Checker c = {
        info: newInfo(), errs: [], diags: [], owner: "", init: newInitOrder(),
        scope: newScope(null), retType: null, retTok: noTok(), importLine: 1,
        depth: 0, qual: qual, shown: shown, loopDepth: 0, switchDepth: 0,
        flow: {}, chainOpt: {}, nextBinding: 0, noNarrow: null, lambdas: [],
        raise: null, seed: seed, fallible: {},
        catchStmt: null, nameTaken: {}, body: null, inherited: [], homes: {},
    };
    return c;
}

// check type-checks a program of one file. It accepts an import of a built-in
// module and reports an error for an import of another file. A program of
// several files goes through checkModule with resolved dependencies.
export CheckResult check(ast.Program prog) {
    Map<String, ModuleExports> none = {};
    return checkModule(prog, "", none);
}

// checkModule type-checks one module. qual is its unique symbol prefix ("" for
// the entry file); deps maps the file's import paths to the exports of the
// already-checked modules they resolve to. The type information it answers with
// is meaningful only when there are no errors.
//
// Fallibility is inferred from bodies, and a call may sit above its callee's
// declaration, so the check runs repeatedly against a growing set of known
// fallible names until the set stops growing. The set only grows, so this
// terminates. The round that proves it stable ran under the converged set, so
// its diagnostics and info are the right ones and earlier rounds are dropped.
export CheckResult checkModule(ast.Program prog, String qual, Map<String, ModuleExports> deps) {
    return checkModuleShown(prog, qual, "", deps);
}

// checkModule for a module shown by a name other than its qual: a package
// module, whose types a diagnostic names by package (types.Record.shown).
export CheckResult checkModuleShown(ast.Program prog, String qual, String shown,
    Map<String, ModuleExports> deps) {
    Map<String, bool> seed = {};
    while (true) {
        Checker c = newChecker(qual, shown, seed);
        c.run(prog, deps);
        if (sameSet(c.fallible, seed)) {
            CheckResult res = { info: c.info, errs: c.errs, diags: c.diags };
            return res;
        }
        seed = c.fallible;
    }
}

// The qual that owns the symbol of an exported name. It is the module's own
// unless the module republished the name from an import (§5.4), in which case
// the symbol stays where it was emitted and only the name travelled.
export String qualFor(ModuleExports exp, String name) {
    String? q = exp.origins[name];
    if (q == null) {
        return exp.qual;
    }
    return q;
}

// Tells whether a module's surface holds a name.
bool exportsName(ModuleExports exp, String name) {
    return exp.funcs[name] != null || exp.vars[name] != null
        || exp.records[name] != null || exp.enums[name] != null;
}

// Tells whether a re-export publishes one name of the module it names.
bool republishes(String mode, Map<String, bool> chosen, String name) {
    if (mode == "show") {
        return has(chosen, name);
    }
    if (mode == "hide") {
        return !has(chosen, name);
    }
    return true;
}

// The set a `show` or `hide` list names.
Map<String, bool> chosenSet(ast.ReExportStatement re) {
    Map<String, bool> chosen = {};
    forEach(re.names, n) {
        chosen[n] = true;
    }
    return chosen;
}

// Every name one re-export publishes, for a reader of the module rather than a
// compile: `nio doc` writes the surface a file republishes, which the statement
// itself does not list when it names no `show` or `hide`.
export String[] reExportedNames(Info info, ast.ReExportStatement re) {
    ModuleRef? ref = info.moduleAliases[re.alias];
    if (ref == null) {
        return [];
    }
    ModuleExports? exp = ref.exports;
    if (exp == null) {
        return [];
    }
    return republishedNames(exp, re);
}

// Every name one re-export publishes, over the four surfaces of the module it
// names. The checker reads it to find two statements publishing one name;
// exportsOf walks the surfaces itself, because it must keep each name in the
// map it came from.
String[] republishedNames(ModuleExports exp, ast.ReExportStatement re) {
    Map<String, bool> chosen = chosenSet(re);
    String[] out = [];
    forEach(map.keys(exp.funcs), k) {
        if (republishes(re.mode, chosen, k)) {
            array.push(out, k);
        }
    }
    forEach(map.keys(exp.vars), k) {
        if (republishes(re.mode, chosen, k)) {
            array.push(out, k);
        }
    }
    forEach(map.keys(exp.records), k) {
        if (republishes(re.mode, chosen, k)) {
            array.push(out, k);
        }
    }
    forEach(map.keys(exp.enums), k) {
        if (republishes(re.mode, chosen, k)) {
            array.push(out, k);
        }
    }
    return out;
}

export ModuleExports exportsOf(ast.Program prog, Info info, String qual) {
    ModuleExports exp = {
        qual: qual, funcs: {}, vars: {}, records: {}, enums: {}, consts: {},
        names: {}, source: "", origins: {}, decls: {}, info: info,
        top: info.top, homes: {},
    };
    // The homes of this module, so an extending type two files away can still
    // reach the module that wrote a body.
    forEach(map.keys(info.moduleAliases), alias) {
        ModuleRef? ref = info.moduleAliases[alias];
        if (ref == null) {
            continue;
        }
        ModuleExports? re = ref.exports;
        if (re == null) {
            continue;
        }
        exp.homes[re.qual] = re;
        forEach(map.keys(re.homes), q) {
            ModuleExports? home = re.homes[q];
            if (home != null) {
                exp.homes[q] = home;
            }
        }
    }
    forEach(prog.statements, s) {
        switch (s) {
            case ast.FunctionDeclStatement fd:
                exp.names[fd.name] = true;
                types.FuncType? sig = info.funcs[fd.name];
                if (fd.exported && sig != null) {
                    exp.funcs[fd.name] = sig;
                }
            case ast.VarDeclStatement vd:
                exp.names[vd.name] = true;
                types.Type? t = info.declTypes[vd.id];
                if (vd.exported && t != null) {
                    exp.vars[vd.name] = t;
                    if (vd.const) {
                        exp.consts[vd.name] = true;
                    }
                }
            case ast.TypeDeclStatement td:
                exp.names[td.name] = true;
                types.Record? rec = info.records[td.name];
                if (td.exported && rec != null) {
                    exp.records[td.name] = rec;
                    exp.decls[td.name] = td;
                }
            case ast.EnumDeclStatement ed:
                exp.names[ed.name] = true;
                types.Enum? en = info.enums[ed.name];
                if (ed.exported && en != null) {
                    exp.enums[ed.name] = en;
                }
            default:
                continue;
        }
    }
    // The republished surfaces come last, so a name this file declares wins the
    // map and the checker has already reported the collision that caused it.
    forEach(prog.statements, s) {
        ast.ReExportStatement? reOpt = s as ast.ReExportStatement;
        if (reOpt == null) {
            continue;
        }
        ast.ReExportStatement re = reOpt;
        ModuleRef? ref = info.moduleAliases[re.alias];
        if (ref == null) {
            continue;
        }
        ModuleExports? srcOpt = ref.exports;
        if (srcOpt == null) {
            continue;
        }
        ModuleExports src = srcOpt;
        Map<String, bool> chosen = chosenSet(re);
        forEach(map.keys(src.funcs), k) {
            types.FuncType? f = src.funcs[k];
            if (f == null || !republishes(re.mode, chosen, k) || has(exp.names, k)) {
                continue;
            }
            exp.funcs[k] = f;
            exp.names[k] = true;
            // The symbol stays where it was emitted, however far it travelled.
            exp.origins[k] = qualFor(src, k);
        }
        forEach(map.keys(src.vars), k) {
            types.Type? t = src.vars[k];
            if (t == null || !republishes(re.mode, chosen, k) || has(exp.names, k)) {
                continue;
            }
            exp.vars[k] = t;
            exp.names[k] = true;
            exp.origins[k] = qualFor(src, k);
            if (has(src.consts, k)) {
                exp.consts[k] = true;
            }
        }
        forEach(map.keys(src.records), k) {
            types.Record? rec = src.records[k];
            if (rec == null || !republishes(re.mode, chosen, k) || has(exp.names, k)) {
                continue;
            }
            // The same types.Record, so its id is unchanged and a value of it
            // crosses between the two names freely (§2.10). Its methods and its
            // symbols are the declaring module's and need no origin.
            exp.records[k] = rec;
            exp.names[k] = true;
            ast.TypeDeclStatement? decl = src.decls[k];
            if (decl != null) {
                exp.decls[k] = decl;
            }
        }
        forEach(map.keys(src.enums), k) {
            types.Enum? en = src.enums[k];
            if (en == null || !republishes(re.mode, chosen, k) || has(exp.names, k)) {
                continue;
            }
            exp.enums[k] = en;
            exp.names[k] = true;
        }
    }
    return exp;
}
