// Regenerates bootstrap/nio.ll and bootstrap/build.sh: the compiler as portable
// LLVM IR, and the command that turns it into a working `nio` with clang alone.
// Run it from the repository root after any change under src/.
//
//	nio run tools/bootstrap.nio
//
// A bootstrap that lags cannot build the tree it is checked in beside, because
// the compiler's source is written in the language it compiles.
// tests/bootstrap_test.nio makes that a failing test.
//
// Two things make the emitted IR portable:
//
//   - `attrs` is empty, so the functions carry no attribute group with
//     "target-cpu" and "target-features". That group is the only host-specific
//     text the generator produces. The bootstrap binary then calls its runtime
//     out of line. This makes it slower and does not change its output.
//   - `coverage` is false, so no stage built from it carries counters.
//
// It assumes a 64-bit host, through types.naturalBits.
import 'fs';
import 'string';
import 'array';
import 'path';
import '../src/lib/str' as str;
import '../src/loader' as loader;
import '../src/codegen' as codegen;

String const entryPath = "src/nio.nio";
String const outDir = "bootstrap";
String const irOut = "bootstrap/nio.ll";
String const shOut = "bootstrap/build.sh";

// Writes the build script around the C files this compile selected. The list
// comes from the compile that produced the .ll, so the clang command line and
// the IR cannot disagree about which built-in modules the compiler imports.
String renderScript(String[] cfiles, loader.LinkFlags libs) {
    String[] out = [];
    array.push(out, "#!/bin/sh");
    array.push(out, "# Generated by tools/bootstrap.nio. Do not edit.");
    array.push(out, "#");
    array.push(out, "# Builds the nio compiler from the checked-in IR with clang only. This is");
    array.push(out, "# stage 0: it needs no nio, only a C toolchain and this repository. After");
    array.push(out, "# it, the compiler builds itself.");
    array.push(out, "#");
    array.push(out, "#\tbootstrap/build.sh [output]        (default: ./nio; a .exe under a Windows shell)");
    array.push(out, "#");
    array.push(out, "# The C files are the ones the compiler's imports need. The compile that");
    array.push(out, "# emitted nio.ll lists them (tools/bootstrap.nio).");
    array.push(out, "set -eu");
    array.push(out, "");
    array.push(out, "root=$(CDPATH= cd -- \"$(dirname -- \"$0\")/..\" && pwd)");
    array.push(out, "out=${1:-nio}");
    // Windows runs a program by its extension. Git Bash and MSYS2 are the
    // shells this script meets there, and both report through uname.
    array.push(out, "# The Windows linker writes the time into the header. Brepro stops that,");
    array.push(out, "# so two builds give the same file. The linker also accepts the option with");
    array.push(out, "# a dash, and that form stops the shell from reading it as a path.");
    array.push(out, "repro=");
    array.push(out, "case $(uname -s) in");
    array.push(out, "MINGW*|MSYS*|CYGWIN*)");
    array.push(out, "    case $out in *.exe) ;; *) out=$out.exe ;; esac");
    array.push(out, "    repro=-Wl,-Brepro");
    array.push(out, "    libs=\"" + string.join(libs.windows, " ") + "\"");
    array.push(out, "    ;;");
    array.push(out, "*)");
    array.push(out, "    libs=\"" + string.join(libs.unix, " ") + "\"");
    array.push(out, "    ;;");
    array.push(out, "esac");
    array.push(out, "rt=\"$root/build/runtime\"");
    array.push(out, "");
    // The C files, then the libraries they need. A linker that resolves left to
    // right gets nothing from a library named before the object that wants it.
    // Only a file that ends in `.c` is an operand. The list also holds headers,
    // such as the vendored fiat arithmetic that `lib/crypto.c` includes. Given
    // a header, clang tries to precompile it, and the link fails. The driver
    // applies the same filter.
    String[] operands = [];
    forEach(cfiles, c) {
        if (!str.hasSuffix(c, ".c") && !str.hasSuffix(c, ".m")) {
            continue;
        }
        array.push(operands, "\"$rt/" + c + "\"");
    }

    array.push(out, "set -- -O2 ${repro:+$repro} -I \"$rt\" -o \"$out\" \"$root/bootstrap/nio.ll\" \\");
    forEach(operands, op, i) {
        String cont = " \\";
        if (i == operands.length - 1) {
            cont = "";
        }
        array.push(out, "    " + op + cont);
    }
    array.push(out, "");
    array.push(out, "# The libraries the built-in modules need, chosen per host above. They come");
    array.push(out, "# last, because a linker that resolves left to right ignores a library named");
    array.push(out, "# before the object that uses it. They are unquoted, so an empty set adds");
    array.push(out, "# nothing.");
    array.push(out, "# shellcheck disable=SC2086");
    array.push(out, "set -- \"$@\" $libs");
    array.push(out, "");
    array.push(out, "# -flto lets clang inline the runtime into the generated code, and needs a");
    array.push(out, "# linker that reads bitcode. Apple's ld64 and LLVM's lld do. GNU ld does only");
    array.push(out, "# with the plugin installed. A failure retries without it, as the compiler's");
    array.push(out, "# own link does, so the flag stays an optimization.");
    array.push(out, "clang -flto \"$@\" 2>/dev/null || clang \"$@\"");
    array.push(out, "");
    array.push(out, "echo \"built $out\"");
    array.push(out, "");
    return string.join(out, "\n");
}

bool write(String p, String text, String what) {
    fs.writeFile(p, string.toByteArray(text)) catch e {
        print("bootstrap: cannot write " + p + ": " + e.message);
        return false;
    };
    print("bootstrap: wrote " + p + " (" + what + ")");
    return true;
}

// The work is in a function so a failure can `return`: §4.9 wants a catch block
// to end in one.
void run() {
    byte[] data = fs.readFile(entryPath) catch e {
        print("bootstrap: cannot read " + entryPath + ": " + e.message);
        return;
    };
    loader.CompileResult res = loader.compileEntry(string.fromByteArray(data),
        loader.dirOf(entryPath), entryPath, codegen.noOptions());
    if (res.errs.length > 0) {
        // The same format as driver.compileErrors. Importing that function
        // pulls in the whole async half of the driver.
        print(entryPath + ":\n  " + string.join(res.errs, "\n  "));
        return;
    }
    if (!fs.exists(outDir)) {
        fs.createDir(outDir) catch e {
            print("bootstrap: cannot create " + outDir + ": " + e.message);
            return;
        };
    }
    String[] lines = string.split(res.ir, "\n");
    if (!write(irOut, res.ir, string.from(lines.length - 1) + " lines, "
        + string.from(string.length(res.ir)) + " bytes")) {
        return;
    }
    write(shOut, renderScript(res.cfiles, res.hostLibs),
        string.from(res.cfiles.length) + " runtime file(s)");
}

run();
