// Tests the tls module (§6.18) against the published handshake of RFC 8448:
// its key schedule and its protected records
// (tests/golden/rfc8448_records.txt). The rejection tables give the reader
// input that no writer produces: padding, a protected change_cipher_spec, a
// replay at a wrong sequence. RFC 8446 §5.4 makes the receiver refuse each one.
import 'test';
import 'tls';
import 'crypto';
import 'string';
import 'array';
import 'x509';
import './bytes' as bytes;
import './harness' as harness;
import './repo' as repo;

byte[] unhexB(String h) {
    return string.toByteArray(bytes.unhex(h));
}

byte[] toB(String s) {
    return string.toByteArray(s);
}

String hex(byte[] b) {
    return crypto.hexEncode(b);
}

byte[] catB(byte[] a, byte[] b) {
    return string.toByteArray(string.fromByteArray(a) + string.fromByteArray(b));
}

String repeated(String s, int n) {
    String[] parts = [];
    int i = 0;
    while (i < n) {
        array.push(parts, s);
        i++;
    }
    return string.join(parts, "");
}

// RFC 8448 §3: the two ephemeral key pairs and the six handshake messages.

String const CLIENT_PRIVATE = "49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005";
String const SERVER_PUBLIC = "c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f";

String const CLIENT_HELLO = "010000c00303cb34ecb1e78163ba1c38c6dacb196a6dffa21a8d9912ec18a2ef"
    + "6283024dece7000006130113031302010000910000000b000900000673657276"
    + "6572ff01000100000a00140012001d0017001800190100010101020103010400"
    + "230000003300260024001d002099381de560e4bd43d23d8e435a7dbafeb3c06e"
    + "51c13cae4d5413691e529aaf2c002b0003020304000d0020001e040305030603"
    + "020308040805080604010501060102010402050206020202002d00020101001c"
    + "00024001";

String const SERVER_HELLO = "020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155"
    + "772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdb"
    + "f7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304";

String const ENCRYPTED_EXTENSIONS = "080000240022000a00140012001d00170018001901000101010201030104001c"
    + "0002400100000000";

String const CERTIFICATE = "0b0001b9000001b50001b0308201ac30820115a003020102020102300d06092a"
    + "864886f70d01010b0500300e310c300a06035504031303727361301e170d3136"
    + "303733303031323335395a170d3236303733303031323335395a300e310c300a"
    + "0603550403130372736130819f300d06092a864886f70d010101050003818d00"
    + "30818902818100b4bb498f8279303d980836399b36c6988c0c68de55e1bdb826"
    + "d3901a2461eafd2de49a91d015abbc9a95137ace6c1af19eaa6af98c7ced4312"
    + "0998e187a80ee0ccb0524b1b018c3e0b63264d449a6d38e22a5fda4308467480"
    + "30530ef0461c8ca9d9efbfae8ea6d1d03e2bd193eff0ab9a8002c47428a6d35a"
    + "8d88d79f7f1e3f0203010001a31a301830090603551d1304023000300b060355"
    + "1d0f0404030205a0300d06092a864886f70d01010b05000381810085aad2a0e5"
    + "b9276b908c65f73a7267170618a54c5f8a7b337d2df7a594365417f2eae8f8a5"
    + "8c8f8172f9319cf36b7fd6c55b80f21a03015156726096fd335e5e67f2dbf102"
    + "702e608ccae6bec1fc63a42a99be5c3eb7107c3c54e9b9eb2bd5203b1c3b84e0"
    + "a8b2f759409ba3eac9d91d402dcc0cc8f8961229ac9187b42b4de10000";

String const CERT_VERIFY = "0f000084080400805a747c5d88fa9bd2e55ab085a61015b7211f824cd484145a"
    + "b3ff52f1fda8477b0b7abc90db78e2d33a5c141a078653fa6bef780c5ea248ee"
    + "aaa785c4f394cab6d30bbe8d4859ee511f602957b15411ac027671459e46445c"
    + "9ea58c181e818e95b8c3fb0bf3278409d3be152a3da5043e063dda65cdf5aea2"
    + "0d53dfacd42f74f3";

String const SERVER_FINISHED = "140000209b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454"
    + "b78f0718";

String const CLIENT_FINISHED = "14000020a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2"
    + "edd5ce61";

// The only plaintext record in the trace whose header this module writes the
// same way. The ClientHello record carries the 0x0301 compatibility version.
String const SH_RECORD = "160303005a020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb"
    + "1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095"
    + "fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304";

test.start("tls key schedule replays RFC 8448 §3", void () -> {
    tls.Transcript t = tls.transcript();
    t.push(unhexB(CLIENT_HELLO));
    t.push(unhexB(SERVER_HELLO));
    test.expectString(hex(t.hash()),
        "860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8");

    byte[] early = tls.earlySecret(null);
    test.expectString(hex(early),
        "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a");

    // The trace prints this expansion in full, so it checks the HkdfLabel
    // encoding directly.
    byte[] derived = tls.deriveSecret(early, "derived", crypto.sha256(toB("")));
    test.expectString(hex(derived),
        "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba");

    byte[] shared = crypto.x25519SharedSecret(unhexB(CLIENT_PRIVATE), unhexB(SERVER_PUBLIC));
    test.expectString(hex(shared),
        "8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d");

    byte[] handshake = tls.handshakeSecret(early, shared);
    test.expectString(hex(handshake),
        "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac");

    byte[] clientHs = tls.deriveSecret(handshake, "c hs traffic", t.hash());
    test.expectString(hex(clientHs),
        "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21");
    byte[] serverHs = tls.deriveSecret(handshake, "s hs traffic", t.hash());
    test.expectString(hex(serverHs),
        "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38");

    byte[] master = tls.masterSecret(handshake);
    test.expectString(hex(master),
        "18df06843d13a08bf2a449844c5f8a478001bc4d4c627984d5a41da8d0402919");

    // The key and iv expansion depends only on the length, here the trace's
    // 16-byte AES-128-GCM one.
    tls.TrafficKeys serverKeys = tls.trafficKeys(serverHs, 16);
    test.expectString(hex(serverKeys.key), "3fce516009c21727d0f2e4e86ee403bc");
    test.expectString(hex(serverKeys.iv), "5d313eb2671276ee13000b30");
    tls.TrafficKeys clientKeys = tls.trafficKeys(clientHs, 16);
    test.expectString(hex(clientKeys.key), "dbfaa693d1762c5b666af5d950258d01");
    test.expectString(hex(clientKeys.iv), "5bd3c71b836e0b76bb73265f");

    t.push(unhexB(ENCRYPTED_EXTENSIONS));
    t.push(unhexB(CERTIFICATE));
    t.push(unhexB(CERT_VERIFY));
    byte[] serverVerify = tls.finishedVerifyData(serverHs, t.hash());
    test.expectString(hex(serverVerify),
        "9b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718");
    t.push(unhexB(SERVER_FINISHED));
    test.expectString(hex(t.hash()),
        "9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13");

    byte[] clientAp = tls.deriveSecret(master, "c ap traffic", t.hash());
    test.expectString(hex(clientAp),
        "9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5");
    byte[] serverAp = tls.deriveSecret(master, "s ap traffic", t.hash());
    test.expectString(hex(serverAp),
        "a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643");
    byte[] exporter = tls.deriveSecret(master, "exp master", t.hash());
    test.expectString(hex(exporter),
        "fe22f881176eda18eb8f44529e6792c50c9a3f89452f68d8ae311b4309d3cf50");

    tls.TrafficKeys serverApKeys = tls.trafficKeys(serverAp, 16);
    test.expectString(hex(serverApKeys.key), "9f02283b6c9c07efc26bb9f2ac92e356");
    test.expectString(hex(serverApKeys.iv), "cf782b88dd83549aadf1e984");
    tls.TrafficKeys clientApKeys = tls.trafficKeys(clientAp, 16);
    test.expectString(hex(clientApKeys.key), "17422dda596ed5d9acd890e3c63f5051");
    test.expectString(hex(clientApKeys.iv), "5b78923dee08579033e523d9");

    byte[] clientVerify = tls.finishedVerifyData(clientHs, t.hash());
    test.expectString(hex(clientVerify),
        "a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61");
    t.push(unhexB(CLIENT_FINISHED));
    test.expectString(hex(t.hash()),
        "209145a96ee8e2a122ff810047cc952684658d6049e86429426db87c54ad143d");

    // The ticket nonce is the only context in the trace that is not empty and
    // not a hash. It checks that a short, odd-sized context encodes correctly.
    byte[] resumptionMaster = tls.deriveSecret(master, "res master", t.hash());
    test.expectString(hex(resumptionMaster),
        "7df235f2031d2a051287d02b0241b0bfdaf86cc856231f2d5aba46c434ec196c");
    byte[] resumption = tls.hkdfExpandLabel(resumptionMaster, "resumption", unhexB("0000"), 32);
    test.expectString(hex(resumption),
        "4ecd0eb6ec3b4d87f5d6028f922ca4c5851a277fd41311c9e62d2c9492e1c4f3");
});

// A round trip passes for any seal and open that agree with each other. These
// rows come from outside this repository, so a record layer that is only
// self-consistent fails them. They cover both directions and three sequence
// numbers, so they check the sequence-XOR-IV nonce (RFC 8446 §5.3) after seq 0.
// The test derives the secrets by replaying the trace. They are not copied.
test.start("tls record layer replays RFC 8448 §3's protected records", void () -> {
    if (!crypto.aesGcmAvailable()) {
        return;
    }

    tls.Transcript t = tls.transcript();
    t.push(unhexB(CLIENT_HELLO));
    t.push(unhexB(SERVER_HELLO));
    byte[] early = tls.earlySecret(null);
    byte[] shared = crypto.x25519SharedSecret(unhexB(CLIENT_PRIVATE), unhexB(SERVER_PUBLIC));
    byte[] handshake = tls.handshakeSecret(early, shared);
    byte[] clientHs = tls.deriveSecret(handshake, "c hs traffic", t.hash());
    byte[] serverHs = tls.deriveSecret(handshake, "s hs traffic", t.hash());
    byte[] master = tls.masterSecret(handshake);
    t.push(unhexB(ENCRYPTED_EXTENSIONS));
    t.push(unhexB(CERTIFICATE));
    t.push(unhexB(CERT_VERIFY));
    t.push(unhexB(SERVER_FINISHED));
    byte[] clientAp = tls.deriveSecret(master, "c ap traffic", t.hash());
    byte[] serverAp = tls.deriveSecret(master, "s ap traffic", t.hash());

    Map<String, byte[]> secrets = {
        "c-hs-traffic": clientHs,
        "s-hs-traffic": serverHs,
        "c-ap-traffic": clientAp,
        "s-ap-traffic": serverAp,
    };

    int rows = 0;
    forEach(string.split(repo.readText("tests/golden/rfc8448_records.txt"), "\n"), line) {
        if (string.length(line) == 0 || line[0] == 35) {    // '#'
            continue;
        }
        String[] f = string.split(line, " ");
        if (f.length != 6) {
            return Error("malformed record line: " + string.substring(line, 0, 40));
        }
        byte[]? secret = secrets[f[1]];
        if (secret == null) {
            return Error("the corpus names a secret this test does not derive: " + f[1]);
        }
        int seq = string.toInt(f[2]);
        int contentType = string.toInt(f[3]);
        byte[] payload = unhexB(f[4]);
        byte[] record = unhexB(f[5]);

        tls.RecordProtection reader = tls.protectionKeys(secret, tls.TLS_AES_128_GCM_SHA256);
        reader.seq = seq;
        tls.InnerPlaintext got = reader.open(record) catch e {
            return Error(f[0] + ": opening the trace's record failed: " + e.message);
        };
        test.assert(got.contentType == contentType,
            f[0] + ": opened content type " + string.from(got.contentType)
            + ", the trace says " + string.from(contentType));
        test.assert(hex(got.data) == hex(payload),
            f[0] + ": opened to different bytes than the trace's payload");

        tls.RecordProtection writer = tls.protectionKeys(secret, tls.TLS_AES_128_GCM_SHA256);
        writer.seq = seq;
        byte[] again = writer.seal(contentType, payload);
        test.assert(hex(again) == hex(record),
            f[0] + ": sealed to different bytes than the trace's record");
        rows = rows + 1;
    }
    test.expectInt(rows, 7);
});

test.start("tls.hkdfExpandLabel rejects what its encoding cannot carry", void () -> {
    byte[] secret = tls.earlySecret(null);

    byte[]? longLabel = tls.hkdfExpandLabel(secret, repeated("a", 250), toB(""), 32) catch e {
        test.expectInt(e.code, tls.ErrorCode.ILLEGAL_PARAMETER);
    };
    test.assert(longLabel == null, "a 250-byte label must be refused");

    byte[]? emptyLabel = tls.hkdfExpandLabel(secret, "", toB(""), 32) catch e {
        test.expectInt(e.code, tls.ErrorCode.ILLEGAL_PARAMETER);
    };
    test.assert(emptyLabel == null, "an empty label must be refused");

    byte[]? longContext = tls.hkdfExpandLabel(secret, "key", unhexB(CERTIFICATE), 32) catch e {
        test.expectInt(e.code, tls.ErrorCode.ILLEGAL_PARAMETER);
    };
    test.assert(longContext == null, "a 445-byte context must be refused");

    byte[]? zeroLength = tls.hkdfExpandLabel(secret, "key", toB(""), 0) catch e {
        test.expectInt(e.code, tls.ErrorCode.ILLEGAL_PARAMETER);
    };
    test.assert(zeroLength == null, "a zero output length must be refused");
});

test.start("tls plaintext records frame and parse", void () -> {
    byte[] rec = tls.plaintextRecord(tls.ContentType.HANDSHAKE, unhexB(SERVER_HELLO));
    test.expectString(hex(rec), SH_RECORD);

    tls.RecordHeader h = tls.parseRecordHeader(rec);
    test.expectInt(h.contentType, 22);
    test.expectInt(h.length, 90);

    // The header is read from the front. Trailing bytes belong to the next
    // record.
    tls.RecordHeader h2 = tls.parseRecordHeader(unhexB("170303001affff"));
    test.expectInt(h2.contentType, 23);
    test.expectInt(h2.length, 26);

    tls.RecordHeader? short_ = tls.parseRecordHeader(unhexB("16030300")) catch e {
        test.expectInt(e.code, tls.ErrorCode.DECODE_ERROR);
    };
    test.assert(short_ == null, "four bytes are not a record header");

    tls.RecordHeader? unknown = tls.parseRecordHeader(unhexB("1a03030005")) catch e {
        test.expectInt(e.code, tls.ErrorCode.UNEXPECTED_MESSAGE);
    };
    test.assert(unknown == null, "content type 26 must be refused");

    // 16641 = MAX_CIPHERTEXT + 1, written as 0x4101.
    tls.RecordHeader? huge = tls.parseRecordHeader(unhexB("1703034101")) catch e {
        test.expectInt(e.code, tls.ErrorCode.RECORD_OVERFLOW);
    };
    test.assert(huge == null, "a length above 2^14 + 256 must be refused");

    byte[] big = string.toByteArray(repeated("a", 16385));
    byte[]? over = tls.plaintextRecord(tls.ContentType.APPLICATION_DATA, big) catch e {
        test.expectInt(e.code, tls.ErrorCode.RECORD_OVERFLOW);
    };
    test.assert(over == null, "a 16385-byte payload must not be framed");
});

test.start("tls record protection round-trips, both directions counting", void () -> {
    byte[] secret = unhexB("b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38");
    tls.RecordProtection writer = tls.protectionKeys(secret, tls.TLS_CHACHA20_POLY1305_SHA256);
    tls.RecordProtection reader = tls.protectionKeys(secret, tls.TLS_CHACHA20_POLY1305_SHA256);

    // The reader opens them in order, because its own count gives each nonce.
    byte[] r1 = writer.seal(tls.ContentType.HANDSHAKE, toB("first flight"));
    byte[] r2 = writer.seal(tls.ContentType.APPLICATION_DATA, toB("payload"));
    byte[] r3 = writer.seal(tls.ContentType.ALERT, unhexB("0100"));
    test.expectInt(writer.seq, 3);

    tls.InnerPlaintext p1 = reader.open(r1);
    test.expectInt(p1.contentType, 22);
    test.expectString(string.fromByteArray(p1.data), "first flight");
    tls.InnerPlaintext p2 = reader.open(r2);
    test.expectInt(p2.contentType, 23);
    test.expectString(string.fromByteArray(p2.data), "payload");
    tls.InnerPlaintext p3 = reader.open(r3);
    test.expectInt(p3.contentType, 21);
    test.expectString(hex(p3.data), "0100");
    test.expectInt(reader.seq, 3);

    // The header always says application_data (RFC 8446 §5.2). The length
    // covers the inner plaintext plus the tag.
    test.expectInt(r1[0], 23);
    tls.RecordHeader h = tls.parseRecordHeader(r1);
    test.expectInt(h.length, 12 + 1 + 16);

    // An empty payload still round-trips: one type byte under the AEAD.
    byte[] r4 = writer.seal(tls.ContentType.APPLICATION_DATA, toB(""));
    tls.InnerPlaintext p4 = reader.open(r4);
    test.expectInt(p4.contentType, 23);
    test.expectInt(p4.data.length, 0);
});

test.start("tls record protection refuses what §5 says to refuse", void () -> {
    byte[] secret = unhexB("b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21");
    tls.RecordProtection writer = tls.protectionKeys(secret, tls.TLS_CHACHA20_POLY1305_SHA256);
    byte[] rec = writer.seal(tls.ContentType.APPLICATION_DATA, toB("attack at dawn"));

    // A wrong sequence number changes the nonce, so replay and reordering
    // fail the tag.
    tls.RecordProtection skipped = tls.protectionKeys(secret, tls.TLS_CHACHA20_POLY1305_SHA256);
    skipped.seq = 1;
    tls.InnerPlaintext? wrongSeq = skipped.open(rec) catch e {
        test.expectInt(e.code, crypto.ErrorCode.AUTHENTICATION);
    };
    test.assert(wrongSeq == null, "a record at the wrong sequence must not open");
    // A failed open must not move the count past the record it refused.
    test.expectInt(skipped.seq, 1);

    // A flipped bit fails authentication, not decoding.
    byte[] bent = writer.seal(tls.ContentType.APPLICATION_DATA, toB("attack at dawn"));
    bent[7] = (bent[7] ^ 1) as byte;
    tls.RecordProtection reader = tls.protectionKeys(secret, tls.TLS_CHACHA20_POLY1305_SHA256);
    reader.seq = 1;
    tls.InnerPlaintext? tampered = reader.open(bent) catch e {
        test.expectInt(e.code, crypto.ErrorCode.AUTHENTICATION);
    };
    test.assert(tampered == null, "a tampered record must not open");

    // A header changed to a plaintext type is refused before any crypto.
    byte[] retyped = writer.seal(tls.ContentType.APPLICATION_DATA, toB("x"));
    retyped[0] = 22;
    tls.RecordProtection reader2 = tls.protectionKeys(secret, tls.TLS_CHACHA20_POLY1305_SHA256);
    reader2.seq = 2;
    tls.InnerPlaintext? wrongType = reader2.open(retyped) catch e {
        test.expectInt(e.code, tls.ErrorCode.UNEXPECTED_MESSAGE);
    };
    test.assert(wrongType == null, "a protected record must claim application_data");

    // A length that does not match the bytes present is a framing error. Its
    // code is different from the code for a forgery.
    byte[] truncated = array.slice(writer.seal(tls.ContentType.APPLICATION_DATA, toB("xyz")), 0, 20);
    tls.RecordProtection reader3 = tls.protectionKeys(secret, tls.TLS_CHACHA20_POLY1305_SHA256);
    reader3.seq = 3;
    tls.InnerPlaintext? cut = reader3.open(truncated) catch e {
        test.expectInt(e.code, tls.ErrorCode.DECODE_ERROR);
    };
    test.assert(cut == null, "a truncated record must not open");
});

test.start("tls record reader strips padding it never writes", void () -> {
    byte[] secret = unhexB("9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5");
    tls.TrafficKeys tk = tls.trafficKeys(secret, 32);

    // The layout of RFC 8446 §5.4: content, the true type, then zeros. At
    // sequence zero the nonce is the IV, so the record seals directly through
    // the AEAD.
    byte[] inner = catB(toB("data"), unhexB("16000000"));
    byte[] header = unhexB("1703030018");    // 4 + 4 + 16 = 24 bytes follow
    byte[] sealed = crypto.chacha20Poly1305Seal(tk.key, tk.iv, inner, header);
    tls.RecordProtection reader = tls.protectionKeys(secret, tls.TLS_CHACHA20_POLY1305_SHA256);
    tls.InnerPlaintext p = reader.open(catB(header, sealed));
    test.expectInt(p.contentType, 22);
    test.expectString(string.fromByteArray(p.data), "data");

    // A record of only padding names no type. RFC 8446 §5.4 makes that a
    // decode error, found after verification, so the code is not
    // AUTHENTICATION.
    byte[] allPad = unhexB("00000000");
    byte[] padHeader = unhexB("1703030014");    // 4 + 16
    byte[] padSealed = crypto.chacha20Poly1305Seal(tk.key, tk.iv, allPad, padHeader);
    tls.RecordProtection reader2 = tls.protectionKeys(secret, tls.TLS_CHACHA20_POLY1305_SHA256);
    tls.InnerPlaintext? empty = reader2.open(catB(padHeader, padSealed)) catch e {
        test.expectInt(e.code, tls.ErrorCode.DECODE_ERROR);
    };
    test.assert(empty == null, "a record of only padding must not open");

    // CHANGE_CIPHER_SPEC exists only as plaintext for compatibility, so a
    // protected one is refused by its type.
    byte[] ccsInner = unhexB("0114");
    byte[] ccsHeader = unhexB("1703030012");    // 2 + 16
    byte[] ccsSealed = crypto.chacha20Poly1305Seal(tk.key, tk.iv, ccsInner, ccsHeader);
    tls.RecordProtection reader3 = tls.protectionKeys(secret, tls.TLS_CHACHA20_POLY1305_SHA256);
    tls.InnerPlaintext? ccs = reader3.open(catB(ccsHeader, ccsSealed)) catch e {
        test.expectInt(e.code, tls.ErrorCode.UNEXPECTED_MESSAGE);
    };
    test.assert(ccs == null, "a protected change_cipher_spec must be refused");
});

