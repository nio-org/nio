// webview: a native window that shows web content with the platform's own
// engine. macOS (WKWebView) only. It is an external library (§5.8,
// libraries/README.md). Programs import it by path.
//
// C cannot call a Nio function (§7). Page messages queue on the native side,
// and the program drains them between steps. A queued message ends a step at
// once.

import 'string';
import 'json';

native source './native/webview_native.m';
native flags darwin '-framework Cocoa -framework WebKit -framework CoreLocation -lobjc';

