int hits = 0;
bool inc() {
    hits = hits + 1;
    return true;
}
bool r1 = false && inc();
print(r1);
print(hits);
bool r2 = true || inc();
print(r2);
print(hits);
bool r3 = true && inc();
print(r3);
print(hits);
print(!true);
print(true == false);
`, [
        "false", "0", "true", "0", "true", "1", "false", "false",
    ]);
});

