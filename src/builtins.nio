// The hover text for the members whose type is not a types.FuncType, written as
// §6 writes it, with `T`, `K`, `V` and `any` where no type name applies. An
// argument a call can omit has a `?` after its name (`int end?`). A `?` on the
// type means that the argument can be null.
// Every member of builtinMemberNames with no signature has a row here.
export Map<String, String> const builtinShapes = {
    "array.copy": "T[] array.copy(T[] a)",
    "array.indexOf": "int array.indexOf(T[] a, T v)",
    "array.pop": "T array.pop(T[] a)",
    "array.push": "void array.push(T[] a, T v)",
    "array.slice": "T[] array.slice(T[] a, int start, int end?)",
    "array.sort": "void array.sort(T[] a, Function(T, T)<bool> cmp?)",
    "array.map": "U[] array.map(T[] a, Function(T)<U> f)",
    "array.filter": "T[] array.filter(T[] a, Function(T)<bool> keep)",
    "array.reduce": "U array.reduce(T[] a, U start, Function(U, T)<U> f)",
    "array.find": "T? array.find(T[] a, Function(T)<bool> test)",
    "array.some": "bool array.some(T[] a, Function(T)<bool> test)",
    "array.every": "bool array.every(T[] a, Function(T)<bool> test)",
    "array.contains": "bool array.contains(T[] a, T v)",
    "array.reverse": "void array.reverse(T[] a)",
    "array.fill": "void array.fill(T[] a, T v)",
    "array.concat": "T[] array.concat(T[] a, T[] b)",
    "array.flatten": "T[] array.flatten(T[][] a)",
    "math.PI": "float math.PI",
    "math.E": "float math.E",
    "math.abs": "T math.abs(T x)",
    "math.min": "T math.min(T a, T b)",
    "math.max": "T math.max(T a, T b)",
    "math.clamp": "T math.clamp(T x, T lo, T hi)",
    "math.toFloat": "float math.toFloat(T n)",
    "random.pick": "T random.pick(T[] a)",
    "random.shuffle": "void random.shuffle(T[] a)",
    "map.copy": "Map<K, V> map.copy(Map<K, V> m)",
    "map.has": "bool map.has(Map<K, V> m, K k)",
    "map.keys": "K[] map.keys(Map<K, V> m)",
    "map.remove": "bool map.remove(Map<K, V> m, K k)",
    "map.values": "V[] map.values(Map<K, V> m)",
    "json.asBool": "bool! json.asBool(Json v)",
    "json.asFloat": "float! json.asFloat(Json v)",
    "json.asInt": "int! json.asInt(Json v)",
    "json.asText": "String! json.asText(Json v)",
    "json.getType": "json.Type json.getType(Json v)",
    "json.keys": "String[] json.keys(Json v)",
    "json.length": "int json.length(Json v)",
    "json.parse": "Json! json.parse(String s)\nT! json.parse(String s) as T",
    "json.push": "void json.push(Json v, any x)",
    "json.remove": "void json.remove(Json v, String k)",
    "json.toText": "String json.toText(any v)",
    "async.race": "Future<int> async.race(Future<any> first, ...Future<any> more)",
    "async.run": "void async.run(Future<T> f, Function(T)<void> cb)",
    "string.from": "String string.from(printable v)",

    // Two rows each: no type describes "a Socket or a Listener".
    "net.close": "void net.close(Socket s)\nvoid net.close(Listener l)",
    "net.address": "String! net.address(Socket s)\nString! net.address(Listener l)",
};

// The constants a built-in module exports (§6.21), keyed "module.NAME". A
// constant is a member with a written shape and no signature: the checker
// types one as a float, and codegen writes its value in place.
export Map<String, float> const builtinConsts = {
    "math.PI": 3.141592653589793,
    "math.E": 2.718281828459045,
};

export float? constValue(String module, String name) {
    return builtinConsts[module + "." + name];
}

// The hover text for the four names always in scope: the `reserved` set of the
// checker (§2.9, §6.1, §6.2). None is in builtinSigs. The checker checks each
// at its call site. `Error` is also a type. A hover in type position shows the
// record from checker.builtinTypes.
export Map<String, String> const globalShapes = {
    "print": "void print(printable v)",
    "printInline": "void printInline(printable v)",
    "getType": "String getType(any v)",
    "Error": "Error Error(String message, int code?)",
};

export String globalShape(String name) {
    String? s = globalShapes[name];
    if (s == null) {
        return "";
    }
    return s;
}

// What a program can write after `key.`, where key is a module or a namespace
// in a module. Empty for any other key, so a caller can use it to test a name.
export String[] members(String key) {
    String[]? names = builtinMemberNames[key];
    if (names == null) {
        return [];
    }
    return names;
}

export bool isNamespace(String key, String name) {
    return builtinMemberNames[key + "." + name] != null;
}

export types.FuncType? lookupSig(String module, String fn) {
    return builtinSigs[module + "." + fn];
}

// Empty for a function with no recorded names. The caller then writes only the
// types.
export String[] paramNames(String module, String fn) {
    String[]? names = builtinParamNames[module + "." + fn];
    if (names == null) {
        return [];
    }
    return names;
}

export String shape(String module, String fn) {
    String? s = builtinShapes[module + "." + fn];
    if (s == null) {
        return "";
    }
    return s;
}

export bool hasSig(String module, String fn) {
    return builtinSigs[module + "." + fn] != null;
}

export String available(String module) {
    String? s = builtinAvailable[module];
    if (s == null) {
        return "";
    }
    return s;
}

export bool hasOptionalTail(String module, String fn) {
    return builtinOptionalTail[module + "." + fn] != null;
}
