    "        return Error(\"unsupported version \\\"\" + version + \"\\\"\", ErrorCode.MALFORMED_RESPONSE);",
    "    }",
    "    String rest = string.substring(line, sp1 + 1, string.length(line));",
    "    int sp2 = string.find(rest, \" \");",
    "    String code = rest;",
    "    String reason = \"\";",
    "    if (sp2 >= 0) {",
    "        code = string.substring(rest, 0, sp2);",
    "        reason = string.substring(rest, sp2 + 1, string.length(rest));",
    "    }",
