// A type-checked AST to textual LLVM IR.
//
// Every value is computed in one 8-byte unit, which llty answers: an i64 for
// the integers, bool, DateTime, Duration and an enum; a double for the floats;
// a ptr for everything else. Where a value is stored it takes its own width
// (§5.7), which llStore answers. Only loadElem and storeElem see the
// difference: they extend on a load and truncate on a store.
//
// The narrow number types are ranges and not layouts in a register. Their
// TypeDescs carry the distinction, and the width, to the runtime.
//
// A record is a heap block: slot [0] points to its own TypeDesc, then the
// declared fields in order, each at its own width (recOffset). Methods take no
// space there. They are ordinary functions (methodSym) that take the receiver
// as a hidden first parameter, resolved at the call site from Info.methodCalls.
//
// Garbage collection. The collector (runtime/gc.c) finds a heap pointer only
// where this module says one is, so every pointer live across an allocation
// must sit in a root and never in an SSA register alone. Globals go in the
// @gcglobals table. Locals go in a shadow-stack frame whose slots are cleared
// before it is pushed, because the collector scans them from that moment.
// alloca roots a named value. An intermediate needs protect.
//
// A string literal is the only heap-shaped value this module emits itself. It
// has the same one-word GCObj header as a heap block (strGlobal, runtime.h).
import 'ast';
import 'checker';
import 'builtins';
import 'types';
import 'module';
import 'normalize';
import 'lib/fmt';
import 'string';
import 'lib/str';
import 'array';
import 'map';

// The start of the IR: the shared types, the runtime symbols and the TypeDescs
// the runtime owns. §1.6 has no multi-line string, so it is a list of lines.
String[] const headerLines = [
    "%TD = type { i64, ptr, i64, ptr, ptr, i64, ptr, i64, ptr }",
    "%GCFrame = type { ptr, i64, ptr, ptr, ptr }",
    "%GCGlobal = type { ptr, ptr }",
    "",
    "declare void @rt_gc_globals(ptr, i64)",
    "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)",
    "@rt_gc_top = external global ptr",
    "",
    "declare ptr @rt_alloc(i64)",
    "declare ptr @rt_box(i64, ptr)",
    "declare ptr @rt_str_concat(ptr, ptr)",
    "declare ptr @rt_str_concat_n(ptr, i64)",
    "declare i64 @rt_str_byte(ptr, i64)",
    "declare i64 @rt_str_eq(ptr, ptr)",
    "declare i64 @rt_str_cmp(ptr, ptr)",
    "declare ptr @rt_arr_new(i64, i64)",
    "declare i64 @rt_arr_len(ptr)",
    "declare ptr @rt_arr_slot(ptr, i64)",
    "declare ptr @rt_map_new()",
    "declare i64 @rt_map_len(ptr)",
    "declare ptr @rt_map_get(ptr, i64, ptr)",
    "declare void @rt_map_set(ptr, i64, i64, ptr)",
    "declare i64 @rt_map_has(ptr, i64, ptr)",
    "declare i64 @rt_map_remove(ptr, i64, ptr)",
    "declare ptr @rt_map_keys(ptr, ptr)",
    "declare ptr @rt_map_values(ptr, ptr)",
    "declare ptr @rt_map_copy(ptr, ptr)",
    "declare void @rt_arr_push(ptr, i64, ptr)",
    "declare i64 @rt_arr_pop(ptr, ptr)",
    "declare ptr @rt_arr_copy(ptr, ptr)",
    "declare i64 @rt_arr_index_of(ptr, i64, ptr)",
    "declare ptr @rt_arr_slice(ptr, i64, i64, ptr)",
    "declare void @rt_arr_sort(ptr, ptr)",
    "declare void @rt_arr_sort_by(ptr, ptr, ptr)",
    "declare i64 @rt_eq(i64, i64, ptr)",
    "declare void @rt_print(i64, ptr)",
    "declare void @rt_print_space()",
    "declare void @rt_print_newline()",
    "declare ptr @rt_scalar_to_text(i64, ptr)",
    "declare ptr @rt_json_totext(i64, ptr)",
    "declare i64 @rt_json_parse(ptr, ptr)",
    "declare i64 @rt_json_parse_typed(ptr, ptr, i64, ptr)",
    "declare i64 @rt_json_parse_typed_b(ptr, ptr, i64, ptr)",
    "declare ptr @rt_json_parse_value_b(ptr, ptr)",
    "declare i64 @rt_json_from_node(ptr, ptr, i64, ptr)",
    "declare ptr @rt_json_parse_value(ptr, ptr)",
    "declare i64 @rt_json_kind(ptr)",
    "declare ptr @rt_json_get(ptr, ptr)",
    "declare ptr @rt_json_at(ptr, i64)",
    "declare void @rt_json_set(ptr, ptr, ptr)",
    "declare void @rt_json_set_at(ptr, i64, ptr)",
    "declare void @rt_json_push(ptr, ptr)",
    "declare void @rt_json_remove(ptr, ptr)",
    "declare ptr @rt_json_keys(ptr)",
    "declare i64 @rt_json_length(ptr)",
    "declare i64 @rt_json_as_int(ptr, ptr)",
    "declare double @rt_json_as_float(ptr, ptr)",
    "declare ptr @rt_json_as_text(ptr, ptr)",
    "declare i64 @rt_json_as_bool(ptr, ptr)",
    "declare ptr @rt_json_of(i64, ptr)",
    "declare i64 @rt_time_now()",
    "declare i64 @rt_time_duration(ptr)",
    "declare ptr @rt_time_sleep(i64)",
    "declare i64 @rt_date_from_text(ptr)",
    "declare ptr @rt_date_to_text(i64)",
    "declare i64 @rt_date_year(i64)",
    "declare i64 @rt_date_month(i64)",
    "declare i64 @rt_date_day(i64)",
    "declare i64 @rt_date_add_days(i64, i64)",
    "declare ptr @rt_string_to_byte_array(ptr)",
    "declare ptr @rt_string_upper(ptr)",
    "declare ptr @rt_string_lower(ptr)",
    "declare i64 @rt_str_decode(ptr, i64, ptr)",
    "declare i64 @rt_string_rune_count(ptr)",
    "declare i64 @rt_string_rune_at(ptr, i64)",
