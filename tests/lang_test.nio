// End-to-end tests of the language. Each case compiles a program with clang,
// runs it and compares the output. The fs, os and path cases need a real
// directory, so they are in tests/lang_fs_test.nio.
import 'test';
import 'string';
import 'array';
import 'path';
import './harness' as h;

// Repeats s n times by squaring. The regexp cases below need 33,000
// characters, and a loop that appends one copy at a time copies the whole
// string at each step.
String repeat(String s, int n) {
    String out = "";
    String chunk = s;
    int left = n;
    while (left > 0) {
        if (left % 2 == 1) {
            out = out + chunk;
        }
        chunk = chunk + chunk;
        left = left / 2;
    }
    return out;
}

// Sorts a copy of xs without array.sort. It gives the expected order for the
// array.sort cases below, so array.sort is not compared with itself.
int[] sortedCopy(int[] xs) {
    int[] out = [];
    forEach(xs, v) {
        array.push(out, v);
    }
    for (int i = 1; i < out.length; i++) {
        int v = out[i];
        int j = i - 1;
        while (j >= 0 && out[j] > v) {
            out[j + 1] = out[j];
            j = j - 1;
        }
        out[j + 1] = v;
    }
    return out;
}

test.start("lang: spec example", void () -> {
    h.expectOutput(`
import 'json';

type Car {
    String make;
    int age;
    String? owner;
}

int[] myArray = [2,5,4]; //size is optional

int sum;

int sumElements(int a, int b) {
    return a + b;
}

forEach(myArray, element) {
    sum = sumElements(sum, element);
}
print(sum);

Car myCar = {
    make: "toyota",
    age: 4
}

String myCarJson = json.toText(myCar);
print(myCarJson);
`, [
        "11", "{\"make\":\"toyota\",\"age\":4}",
    ]);
});

test.start("lang: int arithmetic", void () -> {
    h.expectOutput(`
print(2 + 3 * 4);
print((2 + 3) * 4);
print(10 / 3);
print(-7 / 2);
print(10 % 3);
print(-7 % 2);
print(-5);
print(2 - 10);
`, [
        "14", "20", "3", "-3", "1", "-1", "-5", "-8",
    ]);
});

// Codegen emits / and % inline. It guards a variable divisor and not a literal
// one, so each case uses both forms.
test.start("lang: int division edge cases", void () -> {
    h.expectOutput(`
int two = 2;
int neg = -1;
int one = 1;
int min = -9223372036854775807 - 1;

print(7 / 2);      print(7 / two);
print(-7 / 2);     print(-7 / two);
print(7 % 2);      print(7 % two);
print(-7 % 2);     print(-7 % two);

// INT64_MIN / -1 overflows the quotient: the result wraps, and the
// remainder is 0. A raw sdiv/srem would trap here.
print(min / neg);  print(min % neg);
print(7 / neg);    print(7 % neg);
print(min / one);  print(min % one);
`, [
        "3", "3", "-3", "-3", "1", "1", "-1", "-1", "-9223372036854775808", "0", "-7",
        "0", "-9223372036854775808", "0",
    ]);
});

test.start("lang: float arithmetic", void () -> {
    h.expectOutput(`
print(1.5 + 2.25);
print(10.0 / 4.0);
print(2.5 * 4.0);
print(1.0 - 0.75);
print(-1.5);
print(0.1 + 0.2);
`, [
        "3.75", "2.5", "10", "0.25", "-1.5", "0.30000000000000004",
    ]);
});

test.start("lang: strings", void () -> {
    h.expectOutput(`
print("foo" + "bar");
String s = "hello";
print(s + " " + "world");
print("");
// The empty literal is the smallest static string there is: its GC header
// plus its length field come to exactly 16 bytes, the size of a mergeable
// literal. Concatenating from it reads its length, which is where a
// mis-placed constant shows up as leading garbage.
String acc = "";
print(acc + "x");
print("" + "y" == "y");
print("" + "" == "");
print("a" < "b");
print("abc" < "abd");
print("ab" < "abc");
print("a" == "a");
print("a" != "b");
print("b" >= "b");
`, [
        "foobar", "hello world", "", "x", "true", "true", "true", "true", "true",
        "true", "true", "true",
    ]);
});

test.start("lang: multiline strings and block comments", void () -> {
    h.expectOutput(`
import 'string';

/* a block comment that spans lines, holding // and "quotes" and
   code that never runs: int x = ;
*/
String s = \`one
two\`;
print(s);
print(s == "one\\ntwo");
print(string.length(\`
\`));
print(string.length(\`\`));
print(\`a\\\`b\`);
print(1 /* inline */ + 2);
String[] lines = string.split(\`a
b
c\`, "\\n");
print(lines[2]);
`, [
        "one", "two", "true", "1", "0", "a`b", "3", "c",
    ]);
});

