    "        if (lead == \" \" || lead == \"\\t\") {",
    "            return Error(\"obsolete line folding in header block\", ErrorCode.MALFORMED_REQUEST);",
    "        }",
    "        int c = string.find(line, \":\");",
    "        if (c <= 0) {",
    "            return Error(\"malformed header line \\\"\" + line + \"\\\"\", ErrorCode.MALFORMED_REQUEST);",
    "        }",
