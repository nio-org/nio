test.start("lang: optional narrowing", void () -> {
    h.expectOutput(`
type Node { int value; Node? next; }

Node first = { value: 1, next: null };
Node second = { value: 2, next: first };

if (second.next != null) {
    print(second.next.value);
}

String? owner;
if (owner == null) {
    print("nobody");
} else {
    print(owner + "!");
}
owner = "alice";
print(owner + "!");

int? n = 5;
print(n + 1);

int? m;
if (m != null && m > 3) {
    print("big");
} else {
    print("null or small");
}

int sum = 0;
Node? cur = second;
while (cur != null) {
    sum = sum + cur.value;
    cur = cur.next;
}
print(sum);

int valueOf(Node? x) {
    if (x == null) {
        return -1;
    }
    return x.value;
}
print(valueOf(second));
print(valueOf(null));

int? k;
if (k == 7) {
    print("seven");
} else {
    print("not seven");
}
`, [
        "1", "nobody", "alice!", "6", "null or small", "3", "2", "-1", "not seven",
    ]);
});

