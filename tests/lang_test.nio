test.start("lang: map growth and order", void () -> {
    h.expectOutput(`
import 'map';
import 'json';

// Enough entries to force several rehashes; every key stays findable.
Map<int, int> squares;
for (int i = 0; i < 300; i++) {
    squares[i] = i * i;
}
print(squares.length);
print(squares[299]);
bool ok = true;
for (int i = 0; i < 300; i++) {
    int? v = squares[i];
    if (v == null || v != i * i) {
        ok = false;
    }
}
print(ok);

// Overwrites do not change length; removal keeps insertion order.
Map<String, int> m = { "a": 0, "b": 1, "c": 2, "d": 3 };
m["b"] = 10;
print(m.length);
map.remove(m, "a");
map.remove(m, "c");
print(json.toText(map.keys(m)));
m["a"] = 99;
print(json.toText(m));

// Runtime-built string keys hash by content.
String k = "ke";
m[k + "y"] = 7;
print(m["key"]);
`, [
        "300", "89401", "true", "4", "[\"b\",\"d\"]", "{\"b\":10,\"d\":3,\"a\":99}",
        "7",
    ]);
});

test.start("lang: map JSON", void () -> {
    h.expectOutput(`
import 'json';

// Serialization: entries in insertion order, keys escaped like any string.
Map<String, int> ages;
ages["alice"] = 31;
ages["say \\"hi\\""] = 1;
print(json.toText(ages));

// Dynamic keys parse into a map; nesting and records compose.
type Ledger { int total; }
String text = '{"user-1":{"total":30},"user-2":{"total":12}}';
Map<String, Ledger> byUser = json.parse(text) as Map<String, Ledger>;
print(byUser.length);
print(byUser["user-2"]?.total);
print(byUser["user-3"]?.total);

// A duplicate key in the document overwrites, like rt_map_set always does.
Map<String, int> dup = json.parse('{"a":1,"a":2}') as Map<String, int>;
print(dup.length);
print(dup["a"]);

// Maps nested in maps, and maps as record fields, round-trip.
Map<String, Map<String, int>> nested = json.parse('{"outer":{"a":1}}') as Map<String, Map<String, int>>;
print(json.toText(nested));
type Blob { Map<String, int> counts; }
Blob b = json.parse('{"counts":{"x":5}}') as Blob;
print(json.toText(b));
`, [
        "{\"alice\":31,\"say \\\"hi\\\"\":1}", "2", "12", "null", "1", "2",
        "{\"outer\":{\"a\":1}}", "{\"counts\":{\"x\":5}}",
    ]);
});

