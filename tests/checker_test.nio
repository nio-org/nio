// The checker. Nothing else in the suite pins the wording of a diagnostic.
// A message carries a line and column, so a case matches by substring.
import 'test';
import 'string';
import 'array';
import 'map';
import '../src/checker' as checker;
import '../src/ast' as ast;
import '../src/types' as types;
import '../src/builtins' as builtins;

import './checkerlib' as lib;

String const CARTYPE = `
type Car {
    String make;
    int age;
    String? owner;
}
`;

String const HTTPENUM = `
enum HttpResponses {
    OK: 200,
    NOT_FOUND: 404
}
`;

String const COUNTERTYPE = `
type Counter {
    int n;
    String label;

    int bump() {
        self.n = self.n + 1;
        return self.n;
    }

    void reset() {
        self.n = 0;
    }
}
`;

String const VEHICLETYPES = `
type Car {
    String name;
    String? color;
    int wheels() { return 4; }
    String describe() { return self.name; }
}

type Truck extends Car {
    int load;
    int override wheels() { return 6; }
}
`;

test.start("checker: valid programs", void () -> {
    lib.accepts([
        lib.ok("spec example",
            `import 'json';
type Car {
    String make;
    int age;
    String? owner;
}

int[] myArray = [2,5,4];
int sum;
int sumElements(int a, int b) {
    return a + b;
}
forEach(myArray, e, i) {
    sum = sumElements(sum, e + i);
}
Car myCar = {
    make: "toyota",
    age: 4
}
Car[] myCars = [myCar, { make: "honda", age: 6 }];
String myCarJson = json.toText(myCar);
`),
        lib.ok("arithmetic and comparisons",
            `
int a = 1 + 2 * 3 - 4 / 2 % 2;
float f = 1.5 * 2.0;
bool b = 1 < 2 && 2.0 >= 1.0 || "a" < "b";
bool c = !b == false;
int n = -a;
float g = -f;
`),
        lib.ok("control flow",
            `
int i = 0;
while (i < 10) {
    if (i % 2 == 0) {
        i = i + 1;
    } else if (i > 5) {
        i = i + 2;
    } else {
        i = i + 3;
    }
}
`),
        lib.ok("for loops and inc/dec",
            `
type Car {
    String make;
    int age;
    String? owner;
}

int myVariable = 10;
int sum = 0;
for (int i = 0; i < myVariable; i++) {
    sum = sum + i;
}
int i = 99;                            // the loop's i is gone; shadowing is fine
for (int i = 0; i < 3; i++) {
    sum = sum - i;
}
for (i = 5; i > 0; i--) {
    sum = sum + 1;
}
for (; i < 3;) { i++; }
float f;
f--;
int[] a = [1, 2];
a[0]++;
Car c = { make: "x", age: 1 }
c.age--;
`),
        lib.ok("functions and recursion",
            `
int fib(int n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}
void noop() { return; }
int x = fib(10);
noop();
`),
        lib.ok("const bindings",
            `import 'array';
type Car {
    String make;
    int age;
    String? owner;
}

String const greeting = "ciao";
int const limit = 10;
int[] const nums = [1, 2, 3];
Car const c = { make: "fiat", age: 1 }
int n = limit + nums[0];
nums[0] = 9;                           // element writes are allowed
nums[1]++;
array.push(nums, 4);                   // the array stays mutable
array.pop(nums);
c.make = "toyota";                     // field writes are allowed
c.age++;
if (n > limit) {
    int limit = 0;                     // shadowing a const is fine
    limit = 1;                         // and the shadow is not const
}
`),
        lib.ok("optionals",
            `
type Car {
    String make;
    int age;
    String? owner;
}

String? s;
s = null;
s = "hi";
bool b1 = s == null;
bool b2 = s != "hi";
int? n = 5;
bool b3 = n == 5;
int? m = n;
Car? c = { make: "x", age: 1 }
bool b4 = c == null;
`),
        lib.ok("narrowing",
            `
type Car {
    String make;
    int age;
    String? owner;
}

Car? c;
if (c != null) {
    String m = c.make;
    c.age = c.age + 1;
}
if (c == null) {
    printInline("none");
} else {
    printInline(c.make);
}
int? n;
if (n != null && n > 3) {
    int big = n;
}
bool viaOr = n == null || n + 1 > 0;
String? s = "hi";
printInline(s + "!");
s = null;
int? cnt = 1;
cnt++;
printInline(cnt + 1);
int f(Car? x) {
    if (x == null) {
        return 0;
    }
    return x.age;
}
`),
        lib.ok("narrowing in loops",
            `
type Node { int value; Node? next; }
Node? cur;
int sum;
while (cur != null) {
    sum = sum + cur.value;
    cur = cur.next;
}
int? n;
while (n == null) {
    n = 1;
}
int after = n;
`),
        lib.ok("optional chaining",
            `
type Team { String name; String[] members; }
type Company { Team? boss; }
type Node { int value; Node? next; }
Company c = { boss: null };
String? name = c.boss?.name;
int? count = c.boss?.members.length;
String? first = c.boss?.members[0];
Node nd = { value: 1, next: null };
int? deep = nd.next?.next?.value;
bool b = c.boss?.name != null;
printInline(c.boss?.name);
`),
        lib.ok("int8",
            `
int8 small = 127;
int8 negative = -128;
byte alias = 7;
int widened = small + negative;
int direct = small;
`),
        lib.ok("narrow numbers",
            `
int8 small = 1;
int16 short = 32767;
int32 long = -2147483648;
float32 temp = 0.1;
int16 fromByte = small;
int32 fromShort = short;
int64 fromLong = long;
float64 fromTemp = temp;
int sum = short + long + small;
float scaled = temp * 2.0;
bool ordered = small < short && short < long;
bool same = temp == 1.5;
int16[] shorts = [1, 2];
float32[] temps = [0.5];
int32 indexed = shorts[short];
`),
        lib.ok("alternate spellings",
            `
int64 a = 1;
int b = a;
int64 c = b;
float64 x = 1.5;
float y = x;
float64 z = y;
byte n = 1;
uint8 m = n;
uint16 w = m;
int q = m;
uint64 big = 1;
uint natural = 2;
uint64 wider = natural;
uint alsoNatural = big;
int fromByte = n + 1;
bool small = n < 200 && big > 0 && natural == 2;
uint sum = natural + big;
uint quot = big / natural;
uint8[] bytes = [0, 255];
Map<uint8, uint> counts = { 1: 2 };
`),
        lib.ok("records",
            `
type Car {
    String make;
    int age;
    String? owner;
}

Car a = { make: "t", age: 1 }
Car b = { make: "u", age: 2, owner: "bob" }
a.age = 3;
a.owner = null;
String s = a.make;
String? o = a.owner;
bool same = a.owner == "bob";
`),
        lib.ok("arrays",
            `
int[] xs = [1, 2, 3];
int[] empty = [];
xs[0] = 5;
int n = xs[1] + xs.length;
String[] ss = ["a", "b"];
forEach(ss, s) { printInline(s); }
forEach(xs, x, i) { xs[i] = x + i; }
int?[] opts = [1, null, 3];
`),
        lib.ok("array library and fixed-size arrays",
            `
import 'array';
int[] xs = [1, 2, 3];
array.push(xs, 4);
int last = array.pop(xs);
int[] ys = array.copy(xs);
int[5] fixed = [1, 2, 3, 4, 5];
fixed[0] = 9;
int n = fixed[4] + fixed.length;
int[] loose = array.copy(fixed);
forEach(fixed, e, i) { printInline(e + i); }
String[] ss = [];
array.push(ss, "hi");
String s = array.pop(ss);
int[2][] rows = [[1, 2], [3, 4]];
int[2] row = rows[0];
`),
        lib.ok("aliased array module",
            `
import 'array' as arr;
int[] xs = [];
arr.push(xs, 1);
int x = arr.pop(xs);
`),
        lib.ok("forEach shadows outer name",
            `
int e = 1;
int[] xs = [1];
forEach(xs, e) { printInline(e); }
forEach(xs, e, i) {
    while (e > 0) { e = e - 1; }
}
`),
        lib.ok("nested and anonymous types",
            `
type Engine { float liters; int cylinders }
type Truck {
    String make;
    Engine engine;
    {
        String label;
        { int weight }[] boxes;
    }[]? cargo;
}
Truck t = { make: "volvo", engine: { liters: 12.8, cylinders: 6 } }
t.cargo = [{ label: "a", boxes: [{ weight: 1 }] }];
float l = t.engine.liters;
`),
        lib.ok("record arrays",
            `
type Car {
    String make;
    int age;
    String? owner;
}

Car[] cars = [{ make: "a", age: 1 }, { make: "b", age: 2, owner: "o" }];
forEach(cars, c, i) {
    printInline(c.make);
    printInline(i);
}
Car? maybe = cars[0];
`),
        lib.ok("times",
            `
import 'time';
DateTime now = time.now();
Duration span = time.duration("30m");
DateTime d = time.date.fromText("2026-07-25");
String s = time.date.toText(d);
int y = time.date.year(d);
int m = time.date.month(d);
int dd = time.date.day(d);
DateTime later = time.date.addDays(d, 30);
bool cmp = d < later && d != later && span < time.duration("1h");
`),
        lib.ok("instants and durations",
            `
import 'time';
DateTime start = time.now();
DateTime end = start + time.duration("1h");
Duration took = end - start;
Duration twice = took + took;
Duration less = took - time.duration("30m");
Duration scaled = took * 3;
Duration mirrored = 3 * took;
Duration shared = took / 4;
Duration back = -took;
DateTime earlier = end - time.duration("15m");
int ms = time.milliseconds(took);
bool ok = took > time.duration("1s") && took == 3600000 && ms > 0 && earlier < end;
`),
        // A bare number where a Duration is wanted means milliseconds.
        lib.ok("integer literals become durations",
            `
import 'time';
Duration d = 500;
Duration neg = -250;
bool a = d == 500;
bool b = 500 == d;
bool c = d < 1000 && -1 < d;
Duration sum = d + 250;
Duration diff = 1000 - d;
DateTime t = time.now() + 5000;
DateTime u = 5000 + time.now();
DateTime v = time.now() - 5000;
`),
        lib.ok("time.sleep is a Future<void>",
            `
import 'time';
import 'async';
void async nap() { await time.sleep(time.duration("1s")); }
void async slow() { await time.sleep(1); }
async.run(time.sleep(0), void () -> printInline("tick"));
`),
        lib.ok("json",
            `import 'json';
type Car {
    String make;
    int age;
    String? owner;
}

Car c = { make: "t", age: 1 }
String a = json.toText(c);
String b = json.toText([1, 2]);
String s = json.toText("x");
String f = json.toText(1.5);
printInline(a);
`),
        lib.ok("nested records",
            `
type Point { int x; int y; }
type Line { Point from; Point to; }
Line l = { from: { x: 0, y: 0 }, to: { x: 1, y: 1 } }
int x = l.from.x;
l.to = { x: 2, y: 2 }
`),
        lib.ok("shadowing in blocks",
            `
int x = 1;
if (x == 1) {
    int y = 2;
    x = y;
}
int f(int x) { return x; }
`),
        lib.ok("DateTime equality with optional",
            `
DateTime? maybe;
bool b = maybe == null;
`),
        lib.ok("aliased builtin modules",
            `
import 'time' as when;
import 'json' as encode;
DateTime d = when.now();
String s = encode.toText(when.date.year(d));
`),
        lib.ok("single-quoted strings",
            `
String s = 'hello';
bool b = 'a' < "b";
`),
        // getType accepts the records, arrays and function values print rejects.
        lib.ok("getType",
            `
type Car {
    String make;
    int age;
    String? owner;
}

enum E { A: 1 }
Car c;
int[] xs = [1, 2];
Function(int)<int> f = int (int n) -> n;
int async slow() { return 1; }
String a = getType(c);
String b = getType(xs);
String d = getType(f);
String e = getType(E.A);
String g = getType(slow());
String h = getType(null);
String i = getType(1 + 2);
printInline(getType("x") + "!");
`),
        lib.ok("record field named length",
            `
type T { int length; }
T v = { length: 3 }
v.length = 5;
int n = v.length;
`),
        lib.ok("break and continue in every loop",
            `
while (true) {
    if (true) { continue; }
    break;
}
for (int i = 0; i < 3; i++) {
    if (i == 1) { continue; }
    break;
}
forEach([1, 2], e) {
    if (e == 1) { continue; }
    break;
}
`),
        lib.ok("break and continue bind to the innermost loop",
            `
forEach([1, 2], e) {
    while (true) {
        break;
    }
    continue;
}
`),
        lib.ok("break and continue inside a function declaration's loop",
            `
int f(int[] xs) {
    int n = 0;
    forEach(xs, x) {
        if (x < 0) { continue; }
        if (x > 10) { break; }
        n = n + x;
    }
    return n;
}
`),
        lib.ok("continue narrows for the rest of the body",
            `
int? maybe() { return 1; }
forEach([1, 2], e) {
    int? x = maybe();
    if (x == null) { continue; }
    printInline(x + 1);
}
`),
        lib.ok("break narrows for the rest of the body",
            `
int? maybe() { return 1; }
while (true) {
    int? x = maybe();
    if (x == null) { break; }
    printInline(x + 1);
}
`),
        lib.ok("a loop with no break still narrows after it",
            `
int? maybe() { return 1; }
int? x = maybe();
while (x == null) {
    x = maybe();
}
printInline(x + 1);
`),
        lib.ok("a loop inside a function value has its own loops",
            `
Function()<void> f = void () -> {
    while (true) { break; }
};
`),
        // A library name stays free in a file that does not import it.
        lib.ok("library names are free without the import",
            `
type Route { String path; int os; }
String path = "/tmp";
int[] array = [1, 2];
Map<String, int> map = { "a": 1 }
int time = 3;
String json(String s) { return s; }
int async(int n) { return n * 2; }
Route fs(String string) { return { path: string, os: 1 } }
forEach(array, os) { printInline(os); }
printInline(path + json("x") + fs(path).path);
printInline(async(time));
printInline(map["a"] == null);
`),
        lib.ok("a renamed import frees the library's own name",
            `
import 'path' as p;
String path = "/tmp";
printInline(p.join(path, "a"));
`),
    ]);
});

test.start("checker: invalid programs", void () -> {
    lib.rejects([
        lib.bad("undefined variable", "printInline(x);", "undefined: x"),
        lib.bad("undefined function", "foo();", "undefined function: foo"),
        lib.bad("call non-function", "int x = 1; x();", "\"x\" is not a function"),
        lib.bad("redeclared variable", "int x = 1; int x = 2;", "already declared"),
        lib.bad("unknown type", "frob x;", "unknown type \"frob\""),
        lib.bad("type mismatch decl", "int x = \"a\";", "cannot use String as int"),
        lib.bad("int float mix",
            "int x = 1 + 1.5;",
            "operator + is not defined on int and float"),
        lib.bad("String minus", "String s = \"a\" - \"b\";", "operator - is not defined"),
        lib.bad("float modulo", "float f = 1.5 % 2.0;", "operator % is not defined"),
        lib.bad("bang on int", "bool b = !1;", "operator ! is not defined on int"),
        lib.bad("minus on string",
            "String s = -\"a\";",
            "operator - is not defined on String"),
        lib.bad("and on ints", "bool b = 1 && 2;", "operator && is not defined"),
        lib.bad("condition not bool", "if (1) {}", "condition must be bool"),
        lib.bad("break at top level", "break;", "break outside a loop"),
        lib.bad("continue at top level", "continue;", "continue outside a loop"),
        lib.bad("break in a function, no loop",
            "void f() { break; }",
            "break outside a loop"),
        lib.bad("break after the loop ends",
            "while (true) {} break;",
            "break outside a loop"),
        lib.bad("break in an if, no loop",
            "if (true) { continue; }",
            "continue outside a loop"),
        lib.bad("break in a function value nested in a loop",
            "while (true) { Function()<void> f = void () -> { break; }; f(); }",
            "break outside a loop"),
        lib.bad("a loop with a break does not narrow after it",
            `int? maybe() { return 1; }
int? x = maybe();
while (x == null) { x = maybe(); break; }
printInline(x + 1);`,
            "operator + is not defined on int? and int"),
        lib.bad("while condition not bool", "while (\"x\") {}", "condition must be bool"),
        lib.bad("assign type mismatch",
            "int x = 1; x = \"a\";",
            "cannot assign String to int"),
        lib.bad("assign to undefined", "x = 1;", "undefined: x"),
        lib.bad("assign to const",
            "int const x = 1; x = 2;",
            "cannot assign to \"x\": it is declared const"),
        lib.bad("assign to const string",
            "String const s = \"a\"; s = \"b\";",
            "cannot assign to \"s\": it is declared const"),
        lib.bad("assign to const array binding",
            "int[] const a = [1]; a = [2];",
            "cannot assign to \"a\": it is declared const"),
        lib.bad("incdec on const",
            "int const x = 1; x++;",
            "cannot assign to \"x\": it is declared const"),
        lib.bad("const in for post",
            "for (int const i = 0; i < 3; i++) {}",
            "cannot assign to \"i\": it is declared const"),
        lib.bad("assign to const in function",
            "int const x = 1; void f() { x = 2; }",
            "cannot assign to \"x\": it is declared const"),
        lib.bad("assign to function",
            "void f() {} f = 1;",
            "cannot assign to function \"f\""),
        lib.bad("return outside function", "return 1;", "return outside function"),
        lib.bad("void returns value",
            "void f() { return 1; }",
            "unexpected return value in void function"),
        lib.bad("missing return value", "int f() { return; }", "missing return value"),
        // sealed types (§2.4, §3.6, §4.9)
        lib.bad("sealed extended from another module is caught elsewhere; here: a leaf cannot be extended",
            "sealed type E { int l; } type A extends E { int a; } type B extends A { int b; }",
            "which is sealed, so A cannot itself be extended"),
        lib.bad("plain extends still grants no assignability",
            "type V { String m; } type T extends V { int l; } T t = { m: \"a\", l: 1 }; V v = t;",
            "cannot use T as V"),
        lib.bad("downcast target must extend the subject",
            `sealed type E { int l; } type A extends E { int a; } type O { int z; }
\t\t\t A a = { l: 1, a: 2 }; E e = a; O? o = e as O;`,
            "cannot narrow E to O: E is extended by A"),
        lib.bad("as on an unsealed record is not a narrowing",
            "type P { int z; } P p = { z: 1 }; P? q = p as P;",
            "but P is not sealed"),
        lib.bad("type switch must cover every extender",
            `sealed type E { int l; } type A extends E { int a; } type B extends E { int b; }
\t\t\t A a = { l: 1, a: 2 }; E e = a; switch (e) { case A x: print(x.a); }`,
            "does not cover every type extending E: add B, or a default clause"),
        lib.bad("an exhaustive type switch has no reachable default",
            `sealed type E { int l; } type A extends E { int a; }
\t\t\t A a = { l: 1, a: 2 }; E e = a;
\t\t\t switch (e) { case A x: print(x.a); default: print("no"); }`,
            "already matched, so this switch's default clause can never run"),
        lib.bad("a type is matched once",
            `sealed type E { int l; } type A extends E { int a; } type B extends E { int b; }
\t\t\t A a = { l: 1, a: 2 }; E e = a;
\t\t\t switch (e) { case A x: print(x.a); case A y: print(y.a); default: print("?"); }`,
            "type A is already matched by an earlier clause"),
        lib.bad("only a sealed type has a known set of extenders",
            "type P { int z; } P p = { z: 1 }; switch (p) { case P q: print(q.z); }",
            "only a sealed type has a known set of types extending it"),
        lib.bad("type labels and value labels do not mix",
            `sealed type E { int l; } type A extends E { int a; }
\t\t\t A a = { l: 1, a: 2 }; E e = a;
\t\t\t switch (e) { case A x: print(x.a); case 3: print("three"); }`,
            "matches types, so its clauses cannot also match values"),
        lib.bad("a method needs a certain receiver",
            `sealed type S { int n; String d() { return "s"; } }
\t\t\t type Q extends S { String override d() { return "q"; } }
\t\t\t Q q = { n: 1 }; S s = q; print(s.d());`,
            "S is sealed, so this value may be of any type extending it"),
        lib.bad("wrong return type", "int f() { return \"a\"; }", "cannot return String"),
        lib.bad("int8 out of range", "int8 b = 200;", "cannot use int as int8"),
        lib.bad("int8 from int var", "int x = 1; int8 b = x;", "cannot use int as int8"),
        lib.bad("int16 out of range", "int16 s = 32768;", "cannot use int as int16"),
        lib.bad("int16 negative out of range",
            "int16 s = -32769;",
            "cannot use int as int16"),
        lib.bad("int32 out of range", "int32 n = 2147483648;", "cannot use int as int32"),
        lib.bad("int32 negative out of range",
            "int32 n = -2147483649;",
            "cannot use int as int32"),
        lib.bad("no narrowing int32 to int16",
            "int32 n = 1; int16 s = n;",
            "cannot use int32 as int16"),
        lib.bad("no narrowing int16 to int8",
            "int16 s = 1; int8 b = s;",
            "cannot use int16 as int8"),
        lib.bad("no narrowing int64 to int32",
            "int64 n = 1; int32 m = n;",
            "cannot use int64 as int32"),
        lib.bad("widened arithmetic does not fit back",
            "int16 a = 1; int16 b = 2; int16 c = a + b;",
            "cannot use int as int16"),
        lib.bad("negation widens", "int8 b = -128; int8 c = -b;", "cannot use int as int8"),
        lib.bad("float32 out of range",
            "float32 f = 400000000000000000000000000000000000000.0;",
            "cannot use float as float32"),
        lib.bad("no narrowing float64 to float32",
            "float64 g = 1.5; float32 f = g;",
            "cannot use float64 as float32"),
        lib.bad("float32 arithmetic widens",
            "float32 f = 1.5; float32 g = f + f;",
            "cannot use float as float32"),
        lib.bad("int literal is not a float32",
            "float32 f = 1;",
            "cannot use int as float32"),
        lib.bad("families do not mix",
            "int16 s = 1; float32 f = 1.5; printInline(s + f);",
            "operator + is not defined on int16 and float32"),
        lib.bad("redefine int32",
            "type int32 { int x; }",
            "cannot redefine built-in type \"int32\""),
