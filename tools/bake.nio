// Regenerates src/embed/stdlib.nio and src/embed/runtime.nio: the standard
// library modules written in Nio (§6.13) and the C runtime, as string
// constants. Run it after any change to a stdlib module or a runtime C file.
//
// §7 has no embed directive, so both trees are checked in as constants and
// regenerated by running this:
//
//	nio run tools/bake.nio
//
// tests/bake_test.nio re-runs it and fails if either checked-in file drifted.
//
// Each source becomes one string constant per line, so a line carries no
// newline of its own to escape. The escaping is only what §1.6 defines, `\`
// and the quote. quote.quote would write a non-ASCII rune as `\u00a7`, which
// the language does not read as an escape at all.
import 'fs';
import 'string';
import 'array';
import 'path';
import 'process';
import '../src/lib/str' as str;

String const stdlibDir = "build/stdlib";
String const stdlibOut = "src/embed/stdlib.nio";
String const runtimeDir = "build/runtime";
String const runtimeOut = "src/embed/runtime.nio";

// Renders one line as the body of a double-quoted Nio literal. Only a backslash
// and a double quote need escaping. A tab is legal raw, and every other byte
// passes through, UTF-8 included.
String escape(String line) {
    byte[] data = string.toByteArray(line);
    String[] out = [];
    forEach(data, b) {
        if (b == 92) {    // '\'
            array.push(out, "\\\\");
            continue;
        }
        if (b == 34) {    // '"'
            array.push(out, "\\\"");
            continue;
        }
        array.push(out, string.fromByteArray([b]));
    }
    return string.join(out, "");
}

void emitLines(String[] out, String sym, String text) {
    String[] lines = string.split(text, "\n");
    array.push(out, "String[] const " + sym + " = [");
    forEach(lines, line) {
        array.push(out, "    \"" + escape(line) + "\",");
    }
    array.push(out, "];");
    array.push(out, "");
}

// A file's text, or "" when it cannot be read. The names come from a directory
// listing, so the caller has already shown the file is there.
String read(String p) {
    byte[] data = fs.readFile(p) catch [];
    return string.fromByteArray(data);
}

// --- the standard library modules written in Nio -------------------------

// The import path a file under build/stdlib answers to: its base name without
// the extension, the way the loader's table names it.
String moduleName(String file) {
    if (str.hasSuffix(file, ".nio")) {
        return string.substring(file, 0, string.length(file) - 4);
    }
    return file;
}

String renderStdlib(String[] files) {
    String[] out = [];
    array.push(out, "// Generated by tools/bake.nio -- do not edit.");
    array.push(out, "//");
    array.push(out, "// The standard library modules written in Nio rather than C (§6.13), as");
    array.push(out, "// source text. §7 has no directive that embeds a file, so the sources are");
    array.push(out, "// checked in as constants and regenerated by tools/bake.nio.");
    array.push(out, "import 'string';");
    array.push(out, "");

    String[] names = [];
    forEach(files, file) {
        String name = moduleName(file);
        array.push(names, name);
        emitLines(out, name + "Lines", read(path.join(stdlibDir, file)));
    }

    array.push(out, "// source answers the text of a built-in module written in Nio, or null");
    array.push(out, "// when there is no such module. The loader's builtinNioModules table is");
    array.push(out, "// what decides which names are asked for.");
    array.push(out, "export String? source(String name) {");
    forEach(names, name) {
        array.push(out, "    if (name == \"" + name + "\") {");
        array.push(out, "        return string.join(" + name + "Lines, \"\\n\");");
        array.push(out, "    }");
    }
    array.push(out, "    return null;");
    array.push(out, "}");
    array.push(out, "");
    return string.join(out, "\n");
}

// --- the C runtime -------------------------------------------------------

// Turns a runtime file's slash-separated name into an identifier: `lib/json.c`
// becomes `lib_json_c`. The names are fixed and ASCII.
String symbolOf(String name) {
    return string.replaceAll(string.replaceAll(name, "/", "_"), ".", "_");
}

// The runtime tree as the linker asks for it: slash-separated names relative to
// build/runtime, top level then lib/, each group sorted. The tree is two levels
// deep. A third level needs a walk.
String[] runtimeFiles() {
    String[] out = [];
    String[] top = fs.readDir(runtimeDir) catch [];
    array.sort(top);
    forEach(top, f) {
        if (str.hasSuffix(f, ".c") || str.hasSuffix(f, ".h")) {
            array.push(out, f);
        }
    }
    String[] lib = fs.readDir(path.join(runtimeDir, "lib")) catch [];
    array.sort(lib);
    forEach(lib, f) {
        if (str.hasSuffix(f, ".c") || str.hasSuffix(f, ".h")) {
            array.push(out, "lib/" + f);
        }
    }
    return out;
}

String renderRuntime(String[] files) {
    String[] out = [];
    array.push(out, "// Generated by tools/bake.nio -- do not edit.");
    array.push(out, "//");
    array.push(out, "// The C runtime (build/runtime/), as source text: runtime.h plus the core");
    array.push(out, "// and one file per built-in library. §7 has no directive that embeds a");
    array.push(out, "// file, so the sources are checked in as constants and regenerated by");
    array.push(out, "// tools/bake.nio.");
    array.push(out, "//");
    array.push(out, "// This module is the runtime as *text*, to be written out beside the .ll");
    array.push(out, "// file for clang to compile -- not the runtime this compiler itself runs");
    array.push(out, "// on, which is linked into it like any other program's.");
    array.push(out, "import 'string';");
    array.push(out, "");

    forEach(files, file) {
        emitLines(out, symbolOf(file), read(path.join(runtimeDir, path.localize(file))));
    }

    array.push(out, "// names lists every embedded file, in the order the tree is walked. It is");
    array.push(out, "// what a test checks the bake against; the driver asks for the files it");
    array.push(out, "// needs by name instead.");
    array.push(out, "export String[] names() {");
    String[] quoted = [];
    forEach(files, file) {
        array.push(quoted, "\"" + file + "\"");
    }
    array.push(out, "    return [" + string.join(quoted, ", ") + "];");
    array.push(out, "}");
    array.push(out, "");
    array.push(out, "// file answers the text of one runtime source, or null when there is no");
    array.push(out, "// such file -- which is a mistake in the driver's list, not something a");
    array.push(out, "// program can cause.");
    array.push(out, "export String? file(String name) {");
    forEach(files, file) {
        array.push(out, "    if (name == \"" + file + "\") {");
        array.push(out, "        return string.join(" + symbolOf(file) + ", \"\\n\");");
        array.push(out, "    }");
    }
    array.push(out, "    return null;");
    array.push(out, "}");
    array.push(out, "");
    return string.join(out, "\n");
}

// --- driver --------------------------------------------------------------

bool write(String outPath, String text, String what) {
    fs.writeFile(outPath, string.toByteArray(text)) catch e {
        print("bake: cannot write " + outPath + ": " + e.message);
        return false;
    };
    print("bake: wrote " + outPath + " (" + what + ")");
    return true;
}

// The work is in a function so a failure can `return`: §4.9 wants a catch block
// to end in one.
void run() {
    String[] files = fs.readDir(stdlibDir) catch e {
        print("bake: cannot read " + stdlibDir + ": " + e.message);
        return;
    };
    array.sort(files);
    String[] nio = [];
    forEach(files, f) {
        if (str.hasSuffix(f, ".nio")) {
            array.push(nio, f);
        }
    }
    if (!write(stdlibOut, renderStdlib(nio), string.from(nio.length) + " module(s)")) {
        return;
    }

    String[] c = runtimeFiles();
    if (c.length == 0) {
        print("bake: cannot read " + runtimeDir);
        return;
    }
    write(runtimeOut, renderRuntime(c), string.from(c.length) + " file(s)");
}

run();
