// The entry program that `nio test` generates.
import 'test';
import '../src/testcmd' as testcmd;
import '../src/parser' as parser;
import '../src/lexer' as lexer;
import '../src/ast' as ast;

// A Windows path holds backslashes, and "\n" in "Temp\nio-tests" is an escape
// in a literal. The import must name the file exactly as it was found.
test.start("testcmd: an import names the path exactly", void () -> {
    String[] files = ["Temp\\nio-tests\\a_test.nio", "./it's/b_test.nio"];
    parser.Parser p = parser.newParser(lexer.newLexer(testcmd.entrySource(files)));
    ast.Program prog = p.parseProgram();
    test.expectInt(p.errs.length, 0);
    test.expectString(prog.imports[0].path, "./Temp\\nio-tests\\a_test");
    test.expectString(prog.imports[1].path, "./it's/b_test");
});
