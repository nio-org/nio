test.start("lang: array library", void () -> {
    h.expectOutput(`
import 'array';
import 'json';

// push and pop mutate in place, through every alias
int[] xs = [1, 2, 3];
int[] alias = xs;
array.push(xs, 4);
print(alias.length);
print(alias[3]);
print(array.pop(alias));
print(xs.length);

// growth far past the initial capacity
int[] big = [];
for (int i = 0; i < 1000; i++) {
    array.push(big, i);
}
print(big.length);
print(big[999]);
int sum;
forEach(big, e) { sum = sum + e; }
print(sum);

// copy decouples: writes and pushes to one side stay on that side
int[] a = [1, 2, 3];
int[] b = array.copy(a);
b[0] = 99;
array.push(b, 4);
print(a[0]);
print(a.length);
print(json.toText(b));

// pointer elements survive being pushed
String[] words = [];
array.push(words, "hello");
array.push(words, "wor" + "ld");
print(words[0] + " " + array.pop(words));

// pushed value may be an optional (boxed) element
int?[] opts = [];
array.push(opts, 7);
array.push(opts, null);
print(opts[0] == 7);
print(opts[1] == null);
`, [
        "4", "4", "4", "3", "1000", "999", "499500", "1", "3", "[99,2,3,4]",
        "hello world", "true", "true",
    ]);
});

test.start("lang: array sort natural order", void () -> {
    h.expectOutput(`
import 'array';
import 'json';
import 'time';

int[] ns = [5, 3, 9, 1, 3, 7, -2];
array.sort(ns);
print(json.toText(ns));

// -0.0 and 0.0 compare equal, so the sort is stable for them: they come out
// in the order they went in.
float[] fs = [2.5, -1.5, 0.0, 10.25, -0.0];
array.sort(fs);
print(json.toText(fs));

String[] ws = ["pear", "apple", "Fig", "apple", ""];
array.sort(ws);
print(json.toText(ws));

// Narrow numbers order as the numbers they are, not as the bytes they fit in.
int8[] bs = [100, -100, 0, 127, -128];
array.sort(bs);
print(json.toText(bs));

// An enum orders by its members' numbers, which is what < already means.
enum Level { HIGH: 9, LOW: 1, MID: 5 }
Level[] ls = [Level.HIGH, Level.LOW, Level.MID];
array.sort(ls);
print(ls[0], ls[1], ls[2]);

Duration[] ds = [time.duration("3s"), time.duration("1s"), time.duration("2s")];
array.sort(ds);
print(time.milliseconds(ds[0]), time.milliseconds(ds[2]));

// Nothing to do, and nothing allocated to do it with.
int[] none = [];
int[] one = [7];
array.sort(none);
array.sort(one);
print(none.length, one[0]);

// A fixed-size array sorts: reordering is not resizing, so the length being
// part of the type is no obstacle.
int[4] fixed = [4, 2, 3, 1];
array.sort(fixed);
print(json.toText(fixed));
`, [
        "[-2,1,3,3,5,7,9]", "[-1.5,0,-0,2.5,10.25]",
        "[\"\",\"Fig\",\"apple\",\"apple\",\"pear\"]", "[-128,-100,0,100,127]",
        "LOW MID HIGH", "1000 3000", "0 7", "[1,2,3,4]",
    ]);
});

test.start("lang: array sort comparator", void () -> {
    h.expectOutput(`
import 'array';
import 'json';
import 'string';

// Descending, which is the natural order asked the other way round.
int[] ns = [5, 3, 9, 1];
array.sort(ns, bool (int x, int y) -> x > y);
print(json.toText(ns));

// A record, sorted by a field. Nothing about the element type has an order;
// the comparator is where the order comes from.
type P { String name; int age; }
P[] ps = [{ name: "cara", age: 31 }, { name: "abe", age: 44 }, { name: "bo", age: 19 }];
array.sort(ps, bool (P x, P y) -> x.age < y.age);
String names = "";
forEach(ps, p) { names = names + p.name + " "; }
print(string.trim(names));

// A closure: the comparator captures, so the order can be decided at run time.
bool up = false;
array.sort(ps, bool (P x, P y) -> { if (up) { return x.name < y.name; } return x.name > y.name; });
names = "";
forEach(ps, p) { names = names + p.name + " "; }
print(string.trim(names));

// An array of arrays has no order either, and a comparator gives it one.
int[][] rows = [[3, 3], [1, 9], [2, 0]];
array.sort(rows, bool (int[] x, int[] y) -> x[0] < y[0]);
print(json.toText(rows));
`, [
        "[9,5,3,1]", "bo cara abe", "cara bo abe", "[[1,9],[2,0],[3,3]]",
    ]);
});

test.start("lang: array sort is stable", void () -> {
    h.expectOutput(`
import 'array';
import 'string';

type Row { String tag; int key; int group; }
Row[] rows = [
    { tag: "d", key: 2, group: 1 },
    { tag: "a", key: 1, group: 2 },
    { tag: "c", key: 2, group: 2 },
    { tag: "b", key: 1, group: 1 },
    { tag: "e", key: 1, group: 2 },
];

array.sort(rows, bool (Row x, Row y) -> x.key < y.key);
String order = "";
forEach(rows, r) { order = order + r.tag; }
print(order);          // the three key-1 rows keep a, b, e; then d, c

// Two keys, two passes: sort by the minor key first, then by the major one.
// Only a stable sort leaves the first pass's work standing.
array.sort(rows, bool (Row x, Row y) -> x.tag < y.tag);
array.sort(rows, bool (Row x, Row y) -> x.group < y.group);
order = "";
forEach(rows, r) { order = order + r.tag + string.from(r.group); }
print(order);
`, [
        "abedc", "b1d1a2c2e2",
    ]);
});

// NaN sorts before every number. A plain a < b comparison leaves it in place,
// and the result is not sorted.
test.start("lang: array sort puts na N first", void () -> {
    h.expectOutput(`
import 'array';
import 'string';

float zero = 0.0;
float nan = zero / zero;
float inf = 1.0 / zero;
float[] fs = [3.0, nan, -1.0, inf, 0.0 - inf, nan];
array.sort(fs);

String out = "";
forEach(fs, f) { out = out + string.from(f) + " "; }
print(string.trim(out));
`, [
        "nan nan -inf -1 3 inf",
    ]);
});

test.start("lang: array index of", void () -> {
    h.expectOutput(`
import 'array';

int[] ns = [5, 3, 9, 3];
print(array.indexOf(ns, 3), array.indexOf(ns, 5), array.indexOf(ns, 100));

String[] ws = ["a", "bc", "d"];
print(array.indexOf(ws, "b" + "c"), array.indexOf(ws, "z"));

int?[] opts = [1, null, 2];
print(array.indexOf(opts, null), array.indexOf(opts, 2));

enum Color { RED: 1, BLUE: 2 }
Color[] cs = [Color.BLUE, Color.RED];
print(array.indexOf(cs, Color.RED));

int[] none = [];
print(array.indexOf(none, 1));

int[3] fixed = [7, 8, 9];
print(array.indexOf(fixed, 9));
`, [
        "1 0 -1", "1 -1", "1 2", "1", "-1", "2",
    ]);
});

test.start("lang: array slice", void () -> {
    h.expectOutput(`
import 'array';
import 'json';

int[] ns = [0, 1, 2, 3, 4];
print(json.toText(array.slice(ns, 1, 4)));
print(json.toText(array.slice(ns, 2)));
print(json.toText(array.slice(ns, 0, 0)));
print(json.toText(array.slice(ns, 5)));
print(json.toText(array.slice(ns, 0, 5)));

int[] part = array.slice(ns, 0, 2);
array.push(part, 99);
part[0] = -1;
print(json.toText(part), json.toText(ns));

String[3] fixed = ["a", "b", "c"];
String[] grown = array.slice(fixed, 1);
array.push(grown, "d");
print(json.toText(grown));
`, [
        "[1,2,3]", "[2,3,4]", "[]", "[]", "[0,1,2,3,4]", "[-1,1,99] [0,1,2,3,4]",
        "[\"b\",\"c\",\"d\"]",
    ]);
});

// A comparator can be unassigned, or it can change the array during the sort.
// Both are runtime errors.
test.start("lang: array sort comparator misuse", void () -> {
    h.expectRuntimeError(`
import 'array';
int[] ns = [3, 1, 2];
Function(int, int)<bool> cmp;
array.sort(ns, cmp);
`, "called a function value that was never assigned");
    h.expectRuntimeError(`
import 'array';
int[] ns = [3, 1, 2, 4];
array.sort(ns, bool (int x, int y) -> { array.push(ns, 9); return x < y; });
`, "array.sort: the comparator changed the array's length");
});

test.start("lang: fixed size arrays", void () -> {
    h.expectOutput(`
import 'array';
import 'json';

// the declared size is the actual size, elements are mutable
int[5] xs = [10, 20, 30, 40, 50];
xs[2] = 33;
print(xs.length);
print(xs[2]);
int total;
forEach(xs, e) { total = total + e; }
print(total);

// declared without an initializer: every slot exists, holding zero values
int[4] zeros;
print(zeros[3]);
String[3] names;
print(names[0] == "");
names[1] = "bob";
print(names[1]);

// record elements start as distinct zero records, not shared ones
type Point { int x; int y }
Point[2] pts;
pts[0].x = 7;
print(pts[0].x);
print(pts[1].x);

// fixed arrays serialize like any array
print(json.toText(xs));

// array.copy is the bridge to a growable array
int[] loose = array.copy(xs);
array.push(loose, 60);
print(loose.length);
print(xs.length);

// fixed arrays nest inside growable ones
int[2][] rows = [[1, 2], [3, 4]];
int[2] row = rows[1];
print(row[0] + row[1]);
`, [
        "5", "33", "153", "0", "true", "bob", "7", "0", "[10,20,33,40,50]", "6", "5",
        "7",
    ]);
});

test.start("lang: for loops", void () -> {
    h.expectOutput(`
int myVariable = 4;
int sum = 0;
for (int i = 0; i < myVariable; i++) {
    sum = sum + i;
}
print(sum);

// init and post clauses may be empty; the counter may be an outer variable
int j = 3;
for (; j > 0; j--) {
    print(j);
}
print(j);

// nested loops with independent counters
int count = 0;
for (int a = 0; a < 3; a++) {
    for (int b = 0; b < 3; b++) {
        count++;
    }
}
print(count);

// the init declaration shadows an outer variable and ends with the loop
int i = 99;
for (int i = 0; i < 2; i++) {
    print(i);
}
print(i);

// an assignment as the post clause
for (int k = 2; k > 0; k = k - 1) {
    print(k);
}
`, [
        "6", "3", "2", "1", "0", "9", "0", "1", "99", "2", "1",
    ]);
});

test.start("lang: for in functions", void () -> {
    h.expectOutput(`
int firstOver(int[] xs, int limit) {
    for (int i = 0; i < xs.length; i++) {
        if (xs[i] > limit) { return xs[i]; }    // returning skips the post clause
    }
    return -1;
}
print(firstOver([1, 8, 3], 2));
print(firstOver([1, 2], 5));

String repeat(String s, int n) {
    String out = "";
    for (int i = 0; i < n; i++) {
        out = out + s;
    }
    return out;
}
print(repeat("ab", 3));
`, [
        "8", "-1", "ababab",
    ]);
});

test.start("lang: inc dec statements", void () -> {
    h.expectOutput(`
int i = 10;
i++;
i++;
i--;
print(i);

float f = 1.5;
f++;
print(f);
f--;
f--;
print(f);

int[] a = [5, 7];
a[0]++;
a[a.length - 1]--;
print(a[0]);
print(a[1]);

type Box { int n }
Box b = { n: 41 };
b.n++;
print(b.n);

// the target address is computed once: idx() runs once per statement
int calls = 0;
int idx() {
    calls++;
    return 0;
}
a[idx()]++;
print(a[0]);
print(calls);
`, [
        "11", "2.5", "0.5", "6", "6", "42", "7", "1",
    ]);
});

// const freezes the binding. The array and the record it holds stay mutable.
test.start("lang: const declarations", void () -> {
    h.expectOutput(`
import 'array';

type Car { String make; int age; }

String const greeting = "ciao";
int const limit = 10;
int[] const nums = [1, 2, 3];
Car const c = { make: "fiat", age: 4 };

print(greeting);
print(limit);

nums[0] = 9;
nums[1]++;
array.push(nums, 7);
print(nums[0]);
print(nums[1]);
print(nums.length);
array.pop(nums);
print(nums.length);

c.make = "toyota";
c.age++;
print(c.make);
print(c.age);

if (true) {
    int limit = 1;      // shadowing a const with a mutable binding
    limit++;
    print(limit);
}
print(limit);
`, [
        "ciao", "10", "9", "3", "4", "3", "toyota", "5", "2", "10",
    ]);
});

test.start("lang: for each statement", void () -> {
    h.expectOutput(`
int[] a = [10, 20, 30];
forEach(a, e, i) {
    print(i);
    print(e);
}

forEach(a, e) {
    e = e + 1;             // the element binding is a copy...
}
print(a[0]);

forEach(a, e, i) {
    a[i] = e * 2;          // ...writing back goes through the index
}
print(a[2]);

int sum = 0;
forEach([1, 2, 3], v) {
    if (v == 2) {
        sum = sum + 10;
    } else {
        sum = sum + v;
    }
}
print(sum);

int[] empty = [];
forEach(empty, e) { print(e); }
print("done");
`, [
        "0", "10", "1", "20", "2", "30", "10", "60", "14", "done",
    ]);
});

test.start("lang: for each in functions", void () -> {
    h.expectOutput(`
int firstAbove(int[] xs, int limit) {
    forEach(xs, x) {
        if (x > limit) { return x; }
    }
    return -1;
}
print(firstAbove([1, 8, 3], 2));
print(firstAbove([1, 2], 5));

int cells(int[] rows, int[] cols) {
    int n = 0;
    forEach(rows, r) {
        forEach(cols, c) {
            n = n + 1;
        }
    }
    return n;
}
print(cells([1, 2], [1, 2, 3]));
`, [
        "8", "-1", "6",
    ]);
});

test.start("lang: break and continue", void () -> {
    h.expectOutput(`
// while: continue jumps back to the condition, break leaves the loop
int i = 0;
while (true) {
    i++;
    if (i == 3) { continue; }
    if (i > 5) { break; }
    print(i);
}
print(i);

// for: continue still runs the post clause, so the counter advances
for (int j = 0; j < 10; j++) {
    if (j % 2 == 0) { continue; }
    if (j > 6) { break; }
    print(j);
}

// forEach: continue still advances to the next element
int sum = 0;
forEach([10, 20, 30, 40, 50], e, k) {
    if (k == 1) { continue; }
    if (e == 40) { break; }
    sum = sum + e;
}
print(sum);

// each binds to its innermost loop
int seen = 0;
for (int a = 0; a < 3; a++) {
    forEach([1, 2, 3], b) {
        if (b == 2) { continue; }
        if (a == 2) { break; }
        seen = seen + a * 10 + b;
    }
    if (a == 2) { continue; }
    seen = seen + 1000;
}
print(seen);

// a loop whose body is nothing but a break runs once
int once = 0;
while (true) {
    once++;
    break;
}
print(once);

// break from an if whose else branch falls through
int n = 0;
for (int c = 0; c < 8; c++) {
    if (c == 5) { break; } else { n = n + c; }
}
print(n);

// continue in an else branch
int m = 0;
for (int d = 0; d < 6; d++) {
    if (d > 3) { m = m + 100; } else { continue; }
}
print(m);
`, [
        "1", "2", "4", "5", "6", "1", "3", "5", "40", "2028", "1", "10", "200",
    ]);
});

test.start("lang: switch statement", void () -> {
    h.expectOutput(`
// One clause runs and the switch ends: no clause falls into the next.
void classify(int n) {
    switch (n) {
        case 1:
        case 2:
            print("low");
        case 3:
            print("three");
        default:
            print("other");
    }
}
classify(1);
classify(2);
classify(3);
classify(9);

// break leaves the switch early, and needs no loop around it.
switch (2) {
    case 2:
        print("before");
        if (true) { break; }
        print("unreachable");
    default:
        print("no");
}

// A switch with no default and nothing matching runs nothing at all.
switch (99) { case 1: print("no"); }
print("fell through");

// Labels are tried in source order, so the first match wins.
String grade(int score) {
    switch (score) {
        case 100:
            return "perfect";
        case 0:
            return "zero";
        default:
            return "middling";
    }
}
print(grade(100));
print(grade(0));
print(grade(50));
`, [
        "low", "low", "three", "other", "before", "fell through", "perfect", "zero",
        "middling",
    ]);
});

test.start("lang: switch on every comparable type", void () -> {
    h.expectOutput(`
enum Color { Red: 1, Green: 2, Blue: 3 }

// Strings compare by contents, not by identity.
String name = "gr" + "een";
switch (name) {
    case "red":
        print("R");
    case "green":
        print("G");
    default:
        print("?");
}

// An enum subject, and an integer label against the same enum.
Color c = Color.Blue;
switch (c) {
    case Color.Red:
        print("red");
    case Color.Blue:
        print("blue");
    default:
        print("other");
}
switch (Color.Green) { case 2: print("two"); default: print("not two"); }

// bool, float, and a negated label.
switch (false) { case true: print("t"); default: print("f"); }
switch (-1.5) { case -1.5: print("neg"); default: print("no"); }

// Duration takes a bare millisecond count, as == does.
Duration d = 1000;
switch (d) { case 1000: print("a second"); default: print("other"); }

// An optional subject: null is a label like any other.
int? maybe = null;
switch (maybe) { case null: print("absent"); case 7: print("seven"); default: print("other"); }
maybe = 7;
switch (maybe) { case null: print("absent"); case 7: print("seven"); default: print("other"); }
`, [
        "G", "blue", "two", "f", "neg", "a second", "absent", "seven",
    ]);
});

test.start("lang: switch and loops", void () -> {
    h.expectOutput(`
import 'string';

// A break inside a switch leaves the switch; the loop keeps going. A
// continue inside one belongs to the loop, and still runs the post clause.
for (int i = 0; i < 6; i++) {
    switch (i) {
        case 0:
            break;
        case 2:
            continue;
        case 4:
            print("four");
        default:
            print(i);
    }
    print("end of " + string.from(i));
}

// A loop inside a switch binds its own break.
switch (1) {
    case 1:
        int n = 0;
        while (true) {
            n++;
            if (n == 3) { break; }
        }
        print(n);
    default:
        print("no");
}

// A switch inside a switch: each break leaves its own.
switch (1) {
    case 1:
        switch (2) {
            case 2:
                print("inner");
                break;
            default:
                print("no");
        }
        print("outer still running");
    default:
        print("no");
}
`, [
        "end of 0", "1", "end of 1", "3", "end of 3", "four", "end of 4", "5",
        "end of 5", "3", "inner", "outer still running",
    ]);
});

test.start("lang: switch in async and methods", void () -> {
    h.expectOutput(`
import 'time';
import 'string';

int async slow(int n) {
    await time.sleep(1);
    return n;
}

// An await in the subject, and another inside a clause body: the dispatch
// survives a suspension in either place.
void async pick(int n) {
    switch (await slow(n)) {
        case 1:
            print("one");
            await time.sleep(1);
            print("resumed");
        case 2:
            print("two");
        default:
            print("other");
    }
}
await pick(1);
await pick(2);
await pick(9);

// A switch in a method, on a field, allocating in its clauses.
type Tag {
    String kind;
    String describe() {
        switch (self.kind) {
            case "a":
            case "b":
                return "letter " + self.kind;
            default:
                return "unknown " + self.kind;
        }
    }
}
Tag t = { kind: "b" };
print(t.describe());
Tag u = { kind: "z" };
print(u.describe());

// A fallible subject, caught before the dispatch sees it.
int boom() { return Error("nope"); }
switch (boom() catch -1) {
    case -1:
        print("caught");
    default:
        print("no");
}

// An inherited method body carrying a switch is cloned and compiled again
// for the extending type, so the override is what its clause reaches.
type Shape {
    int sides;
    String kind() {
        switch (self.sides) {
            case 3:
                return "triangle";
            case 4:
                return self.quad();
            default:
                return "polygon";
        }
    }
    String quad() { return "quadrilateral"; }
}
type Square extends Shape {
    String override quad() { return "square"; }
}
Shape sh = { sides: 4 };
print(sh.kind());
Square sq = { sides: 4 };
print(sq.kind());
print(sq.kind() == "square");

// A type switch in an inherited body. A type case has two things a value
// case does not: the label that names the type, and the name it binds. A
// clone that dropped them left the body
// matching a value against a type and reading an undefined name (§4.9).
sealed type Node { int at; }
type Leaf extends Node { int value; }
type Pair extends Node { int left; int right; }
type Reader {
    int depth;
    String read(Node n) {
        switch (n) {
            case Leaf lf:
                return "leaf " + string.from(lf.value);
            case Pair pr:
                return "pair " + string.from(pr.left);
        }
    }
}
type Tracing extends Reader { bool loud; }
Tracing tr = { depth: 0, loud: true };
Leaf lf = { at: 0, value: 7 };
print(tr.read(lf));
`, [
        "one", "resumed", "two", "other", "letter b", "unknown z", "caught",
        "quadrilateral", "square", "true", "leaf 7",
    ]);
});

test.start("lang: break and continue in functions", void () -> {
    h.expectOutput(`
// break leaves only the loop; the function keeps running
int firstNegative(int[] xs) {
    int found = 0;
    forEach(xs, x) {
        if (x >= 0) { continue; }
        found = x;
        break;
    }
    return found;
}
print(firstNegative([1, -2, -3]));
print(firstNegative([1, 2]));

// a loop inside a function value
Function(int)<int> countdown = int (int from) -> {
    int steps = 0;
    while (from > 0) {
        from--;
        if (from == 2) { break; }
        steps++;
    }
    return steps;
};
print(countdown(6));

// a break in a loop that also holds heap values across allocations
String joinUntil(String[] parts, String stop) {
    String out = "";
    forEach(parts, p) {
        if (p == stop) { break; }
        if (p == "") { continue; }
        out = out + p + "-";
    }
    return out;
}
print(joinUntil(["a", "", "b", "x", "c"], "x"));
`, [
        "-2", "0", "3", "a-b-",
    ]);
});

test.start("lang: record arrays", void () -> {
    h.expectOutput(`
import 'json';
type Car { String make; int age; String? owner; }

Car[] myCars = [{
    make: "toyota",
    age: 4
},
{
    make: "honda",
    age: 6
}];
print(myCars.length);
forEach(myCars, c, i) {
    print(c.make);
    print(i);
}
myCars[1].age = 7;
print(json.toText(myCars));
Car? maybe = myCars[0];
print(maybe == null);
`, [
        "2", "toyota", "0", "honda", "1",
        "[{\"make\":\"toyota\",\"age\":4},{\"make\":\"honda\",\"age\":7}]", "false",
    ]);
});

test.start("lang: nested anonymous types", void () -> {
    h.expectOutput(`
import 'json';

type CarWeight {
    int empty;
    int? full
}

type Car {
    String make;
    {
        int amount;
        String? piece
    }[]? repairs;
    CarWeight weight;
}

Car c = { make: "toyota", weight: { empty: 1200 } }
print(json.toText(c));

c.repairs = [{ amount: 250, piece: "brakes" }, { amount: 90 }];
print(json.toText(c));
print(c.weight.empty);

Car zero;
print(json.toText(zero));
`, [
        "{\"make\":\"toyota\",\"weight\":{\"empty\":1200}}",
        "{\"make\":\"toyota\",\"repairs\":[{\"amount\":250,\"piece\":\"brakes\"},{\"amount\":90}],\"weight\":{\"empty\":1200}}",
        "1200", "{\"make\":\"\",\"weight\":{\"empty\":0}}",
