import 'map';

Map<String, int> ages;
print(ages.length);
ages["alice"] = 31;
ages["bob"] = 27;
ages["alice"] = 32;
print(ages.length);

int? age = ages["alice"];
if (age != null) {
    print(age);
}
print(ages["carol"]);

print(map.has(ages, "bob"));
print(map.remove(ages, "bob"));
print(map.remove(ages, "bob"));
print(ages.length);

ages["dana"] = 45;
forEach(map.keys(ages), name, i) {
    print(name);
    print(i);
}

