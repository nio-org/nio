// A prefix must be a name. A separator in it would escape the temporary
// directory.
test.start("lang: FS create temp dir refuses prefixes that are not names", void () -> {
    h.expectOutput(`
import 'fs';
import 'string';

fs.createTempDir("../escape") catch e { print(e.message); }
fs.createTempDir("a/b") catch e { print(e.message); }
fs.createTempDir("a\\\\b") catch e { print(e.message); }
fs.createTempDir(string.fromByteArray([110, 0, 120])) catch e { print(e.message); }

// A prefix is optional in the sense that nothing requires one: the system
// still picks a name nothing else has.
String bare = fs.createTempDir("") catch "";
print(bare != "", fs.exists(bare));
fs.delete(bare);
`, [
        "fs.createTempDir: a prefix cannot contain a path separator",
        "fs.createTempDir: a prefix cannot contain a path separator",
        "fs.createTempDir: a prefix cannot contain a path separator",
        "fs.createTempDir: a prefix cannot contain a NUL byte", "true true",
    ]);
});

test.start("lang: string join", void () -> {
    h.expectOutput(`
import 'string';
import 'array';

print(string.join(["a", "b", "c"], ", "));
print(string.join(["a"], ", "));                  // no separator to place
print(string.length(string.join([], ", ")));      // 0 -- and no separator
print(string.join(["a", "b"], ""));               // an empty separator is fine
print(string.join(["", "", ""], "-"));            // empty pieces are kept

// The round trip with split, which is the property that ties the two
// together: for any non-empty separator, joining what split produced
// reproduces the string, empty pieces and all.
String s = "-a--b-";
print(string.join(string.split(s, "-"), "-") == s);

// Bytes, not characters: a multi-byte piece and separator contribute every
// byte they have.
print(string.length(string.join(["é", "ü"], "·")));

// A NUL is an ordinary byte in a piece, as everywhere else.
print(string.length(string.join([string.fromByteArray([97, 0]), "b"], "")));

// Built one at a time, which is what join is for.
String[] parts = [];
for (int i = 0; i < 4; i++) { array.push(parts, string.from(i)); }
print(string.join(parts, "+"));

// The array is untouched -- join copies out of it.
print(parts.length, parts[0]);
`, [
        "a, b, c", "a", "0", "ab", "--", "true", "6", "3", "0+1+2+3", "4 0",
    ]);
});

// A Nio string can hold a NUL byte, which no escape can write.
test.start("lang: string from byte array", void () -> {
    h.expectOutput(`
import 'string';
import 'json';

print(string.fromByteArray(string.toByteArray("hello")));
print(string.length(string.fromByteArray([])));
print(string.fromByteArray([104, 105]));

// Multi-byte UTF-8 survives: "é" is two bytes, both above 127.
String e = "é";
print(string.fromByteArray(string.toByteArray(e)) == e);
print(json.toText(string.toByteArray(e)));

// A NUL is an ordinary byte in a counted string: it neither ends it nor is
// dropped, so the length is the whole array.
print(string.length(string.fromByteArray([97, 0, 98])));
`, [
        "hello", "0", "hi", "true", "[195,169]", "3",
    ]);
});

test.start("lang: string library edge cases", void () -> {
    h.expectOutput(`
import 'string';
import 'json';

print(string.find("abc", ""));                  // an empty sub is found at 0
print(string.contains("abc", ""));
print(string.replace("abc", "", "x"));          // empty old: unchanged
print(string.replaceAll("abc", "zz", "x"));     // absent old: unchanged
print(string.replaceAll("aaa", "a", "aa"));     // replacements are not rescanned
print(string.replaceAll("banana", "ana", "X")); // matches never overlap
print(string.length(string.trim("   ")));       // all whitespace trims to ""
print(string.trim("\\ta b\\n"));                  // inner whitespace stays
print(json.toText(string.split("a--b", "-")));  // empty pieces are kept
print(json.toText(string.split("-", "-")));
print(json.toText(string.split("abc", "abc")));
print(json.toText(string.split("abc", "xyz"))); // no separator: one piece
print(json.toText(string.toByteArray("")));
print(string.toByteArray("é")[0]);              // a byte is a uint8: 0..255
print(getType(string.split("a", "-")));
print(getType(string.toByteArray("a")));
`, [
        "0", "true", "abc", "abc", "aaaaaa", "bXna", "0", "a b", "[\"a\",\"\",\"b\"]",
        "[\"\",\"\"]", "[\"\",\"\"]", "[\"abc\"]", "[]", "195", "String[]", "uint8[]",
    ]);
});

