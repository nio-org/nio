// The shim that the BoringSSL BoGo TLS test runner drives.
//
// The runner starts this program once for each test case, with a set of flags.
// The program connects to loopback:`-port` and writes `-shim-id` as eight
// little-endian bytes. That socket is then the TLS transport, and this end is
// the client. The exit status is the result: 0 passed, 89 skipped, any other
// value failed, with a reason on stderr.
//
// Each known flag is on a list, and an unknown flag exits 89. If the shim
// ignored an unknown flag, it would report a pass for the feature that the
// flag tests. `tools/bogo.sh` counts the skips.
import 'net';
import 'tls';
import 'x509';
import 'string';
import 'array';
import 'crypto';
import 'process';
import 'fs';
import 'async';
import 'map';

// The runner's `errUnimplemented` status. The runner skips the test and counts
// no pass or failure.
int const EXIT_UNIMPLEMENTED = 89;
int const EXIT_FAILURE = 1;

// The runner finds its `expectedError` as a substring of stderr.
// tools/bogo_shim_config.json maps BoringSSL error names onto these tokens.
void fail(String token, String detail) {
    process.stderr.write(token + " " + detail + "\n");
    process.exit(EXIT_FAILURE);
}

void unimplemented(String what) {
    process.stderr.write("unimplemented: " + what + "\n");
    process.exit(EXIT_UNIMPLEMENTED);
}

// Turns a caught error into the stable string the runner matches on.
String tokenFor(int code) {
    if (code == tls.ErrorCode.DECODE_ERROR) { return ":NIO_DECODE_ERROR:"; }
    if (code == tls.ErrorCode.UNEXPECTED_MESSAGE) { return ":NIO_UNEXPECTED_MESSAGE:"; }
    if (code == tls.ErrorCode.ILLEGAL_PARAMETER) { return ":NIO_ILLEGAL_PARAMETER:"; }
    if (code == tls.ErrorCode.HANDSHAKE_FAILURE) { return ":NIO_HANDSHAKE_FAILURE:"; }
    if (code == tls.ErrorCode.DECRYPT_ERROR) { return ":NIO_DECRYPT_ERROR:"; }
    if (code == tls.ErrorCode.RECORD_OVERFLOW) { return ":NIO_RECORD_OVERFLOW:"; }
    if (code == tls.ErrorCode.UNSUPPORTED_CERTIFICATE) { return ":NIO_UNSUPPORTED_CERTIFICATE:"; }
    if (code == tls.ErrorCode.UNSUPPORTED_EXTENSION) { return ":NIO_UNSUPPORTED_EXTENSION:"; }
    if (code == tls.ErrorCode.TOO_MANY_MESSAGES) { return ":NIO_TOO_MANY_MESSAGES:"; }
    if (code == tls.ErrorCode.PEER_ALERT) { return ":NIO_PEER_ALERT:"; }
    if (code == crypto.ErrorCode.AUTHENTICATION) { return ":NIO_BAD_RECORD_MAC:"; }
    if (code == x509.ErrorCode.BAD_CERTIFICATE) { return ":NIO_CERT_MALFORMED:"; }
    if (code == x509.ErrorCode.UNSUPPORTED_ALGORITHM) { return ":NIO_CERT_UNSUPPORTED:"; }
    if (code == x509.ErrorCode.EXPIRED) { return ":NIO_CERT_EXPIRED:"; }
    if (code == x509.ErrorCode.NOT_YET_VALID) { return ":NIO_CERT_NOT_YET_VALID:"; }
    if (code == x509.ErrorCode.UNTRUSTED_ROOT) { return ":NIO_CERT_UNTRUSTED:"; }
    if (code == x509.ErrorCode.HOSTNAME_MISMATCH) { return ":NIO_CERT_HOSTNAME:"; }
    if (code == x509.ErrorCode.CONSTRAINT_VIOLATION) { return ":NIO_CERT_CONSTRAINT:"; }
    if (code == x509.ErrorCode.BAD_SIGNATURE) { return ":NIO_CERT_BAD_SIGNATURE:"; }
    return ":NIO_ERROR:";
}

