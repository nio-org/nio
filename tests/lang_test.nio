test.start("lang: JSON field renaming", void () -> {
    h.expectOutput(`
import 'json';

type Engine {
    float liters;
    int power 'json:engine_power';
    String? serial 'json:serial_no';
}

type Truck {
    String make 'json:manufacturer';
    Engine engine;
    { int weight 'json:weight_kg'; }[] cargo;
}

Truck t = {
    make: "volvo",
    engine: { liters: 12.8, power: 550 },
    cargo: [{ weight: 14000 }, { weight: 9000 }]
}
print(json.toText(t));

// Renaming is serialization-only: the field is read by its Nio name.
print(t.engine.power);
print(t.cargo[0].weight);

// An absent optional is omitted under its renamed key, present under it too.
print(json.toText(t.engine));
t.engine.serial = "X-1";
print(json.toText(t.engine));
`, [
        "{\"manufacturer\":\"volvo\",\"engine\":{\"liters\":12.8,\"engine_power\":550},\"cargo\":[{\"weight_kg\":14000},{\"weight_kg\":9000}]}",
        "550", "14000", "{\"liters\":12.8,\"engine_power\":550}",
        "{\"liters\":12.8,\"engine_power\":550,\"serial_no\":\"X-1\"}",
    ]);
});

test.start("lang: JSON strips function fields", void () -> {
    h.expectOutput(`
import 'json';

type Car {
    String make;
    Function()<int> year;
    Function(int)<int>? maybe;
    Function()<void>[] handlers;
    int? age;
}

Car c = { make: "volvo", year: int () -> 1922, handlers: [] }
print(json.toText(c));
c.age = 4;
print(json.toText(c));
print(c.year());

// Every field stripped: a well-formed empty object, not a broken one.
type OnlyFns { Function()<int> a; Function()<int> b; }
OnlyFns o = { a: int () -> 1, b: int () -> 2 }
print(json.toText(o));

// Stripping is per-record, so an outer record keeps a field whose element
// type is a record that merely contains a function.
type Inner { int n; Function()<int> f; }
type Outer { Inner[] xs; }
Outer out = { xs: [{ n: 7, f: int () -> 1 }] }
print(json.toText(out));
`, [
        "{\"make\":\"volvo\"}", "{\"make\":\"volvo\",\"age\":4}", "1922", "{}",
        "{\"xs\":[{\"n\":7}]}",
    ]);
});

test.start("lang: JSON parse", void () -> {
    h.expectOutput(`
import 'json';

type Engine {
    float liters;
    int power 'json:engine_power';
}

type Truck {
    String make;
    Engine engine;
    String? nickname;
    { String label; int weight; }[] cargo;
}

// Keys the type does not declare are dropped, however deeply nested, and
// a renamed field is read under its JSON key.
String text = \`{
  "make": "volvo",
  "unknown": {"deeply": [1, 2, {"nested": true}]},
  "engine": { "liters": 12.8, "engine_power": 550, "extra": "dropped" },
  "cargo": [ {"label":"timber","weight":14000}, {"label":"steel","weight":9000} ]
}\`;

Truck t = json.parse(text) as Truck;
print(t.make);
print(t.engine.power);
print(t.engine.liters);
print(t.cargo[1].label);
print(t.cargo.length);
print(t.nickname == null);
print(json.toText(t));
`, [
        "volvo", "550", "12.8", "steel", "2", "true",
        "{\"make\":\"volvo\",\"engine\":{\"liters\":12.8,\"engine_power\":550},\"cargo\":[{\"label\":\"timber\",\"weight\":14000},{\"label\":\"steel\",\"weight\":9000}]}",
    ]);
});

test.start("lang: JSON parse scalars and shapes", void () -> {
    h.expectOutput(`
import 'json';
import 'time';

enum Status { OK: 200, GONE: 410 }
type Node { int value; Node? next; }

print(json.parse("42") as int);
print(json.parse("1.5e2") as float);
print(json.parse("true") as bool);
print((json.parse("\\"a\\\\nb\\"") as String) == "a\\nb");   // escapes decode
print(json.parse("\\"caf\\\\u00e9\\"") as String);         // \\u decodes to UTF-8
print((json.parse("null") as int?) == null);
print(json.parse("7") as int?);
print(json.parse("410") as Status);
print(time.date.year(json.parse("\\"2026-07-25T10:00:00Z\\"") as DateTime));

int[] xs = json.parse("[1,2,3]") as int[];
print(xs.length);
print(xs[2]);

String[][] grid = json.parse("[[\\"a\\"],[\\"b\\",\\"c\\"]]") as String[][];
print(grid[1][1]);

// A recursive record type, and an absent optional at the end of the chain.
Node n = json.parse("{\\"value\\":1,\\"next\\":{\\"value\\":2,\\"next\\":null}}") as Node;
print(n.next?.value);
print(n.next?.next == null);
`, [
        "42", "150", "true", "true", "café", "true", "7", "GONE", "2026", "3", "3",
        "c", "2", "true",
    ]);
});

// json.parse reads a byte[] in place (§6.3), without a copy to a String.
test.start("lang: JSON parse from bytes", void () -> {
    h.expectOutput(`
import 'json';
import 'string';

type Point { int x; int y; }

byte[] doc = string.toByteArray('{"x":1,"y":2}');
Point p = json.parse(doc) as Point;
print(p.x + p.y);

Json j = json.parse(doc);
print(json.asInt(j["y"]) catch -1);

// strict applies to the byte form exactly as to the string one.
Point? q = json.parse(string.toByteArray('{"x":1,"y":2,"z":3}')) strict as Point
    catch e { print(e.message); };
print(q == null);

// A malformed document raises the same catchable error.
Json? bad = json.parse(string.toByteArray("{oops")) catch e { print("malformed"); };
print(bad == null);
`, [
        "3", "2",
        "cannot parse JSON: unknown key \"z\"", "true",
        "malformed", "true",
    ]);
});

// The reader parses the digits as an integer, not through a double.
// 9007199254740993 is the first integer a double cannot hold. 2^63 must be out
// of range.
test.start("lang: JSON signed int is exact", void () -> {
    h.expectOutput(`
import 'json';
type T { int v; }
T a = json.parse('{"v":9007199254740993}') as T;
print(a.v);
T b = json.parse('{"v":-9223372036854775808}') as T;
print(b.v);
T c = json.parse('{"v":9223372036854775807}') as T;
print(c.v);
T? d = json.parse('{"v":9223372036854775808}') as T catch e { print(e.message); };
print(d == null);
`, [
        "9007199254740993",
        "-9223372036854775808",
        "9223372036854775807",
        "cannot parse JSON: expected a whole number an int can hold at v",
        "true",
    ]);
});

