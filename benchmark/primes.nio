// Counts primes below 2,000,000 by trial division: measures integer loops,
// % and comparisons. The inner loop exits through its condition, with no break.
int limit = 2000000;
int count = 1;    // 2 is prime
int i = 3;

while (i < limit) {
    bool isPrime = true;
    int j = 3;
    while (j * j <= i && isPrime) {
        if (i % j == 0) {
            isPrime = false;
        }
        j = j + 2;
    }
    if (isPrime) {
        count = count + 1;
    }
    i = i + 2;
}

print(count);
