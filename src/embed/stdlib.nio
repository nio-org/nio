    "// Decodes as many complete chunks as `s` holds, from offset `start`. When the",
    "// zero-length last chunk has not arrived, it answers `complete: false`, and the",
    "// caller reads more and calls again. It keeps no state between calls.",
    "//",
    "// A null `maxBody` means no limit. The client has no limit by default. The",
    "// server always has one.",
    "export Chunked decodeChunked(String s, int start, int? maxBody) {",
    "    String[] parts = [];",
    "    int total = 0;",
    "    int i = start;",
    "    int n = string.length(s);",
    "    while (true) {",
    "        int eol = findFrom(s, CRLF, i);",
    "        if (eol < 0) { return { body: \"\", consumed: 0, complete: false }; }",
    "",
    "        // A chunk size can have extensions after a `;`. They are ignored.",
    "        String head = string.substring(s, i, eol);",
    "        int semi = string.find(head, \";\");",
    "        if (semi >= 0) { head = string.substring(head, 0, semi); }",
    "        int size = hexValue(string.trim(head));",
    "",
    "        int dataStart = eol + 2;",
    "        if (size == 0) {",
    "            // The trailer section, then a blank line. Trailers are skipped.",
    "            int end = findFrom(s, CRLF, dataStart);",
    "            while (end >= 0 && end != dataStart) {",
    "                dataStart = end + 2;",
    "                end = findFrom(s, CRLF, dataStart);",
    "            }",
    "            if (end < 0) { return { body: \"\", consumed: 0, complete: false }; }",
    "            return { body: string.join(parts, \"\"), consumed: end + 2 - start, complete: true };",
    "        }",
    "",
    "        total = total + size;",
    "        int? cap = maxBody;",
    "        if (cap != null && total > cap) {",
    "            return Error(`body larger than ${cap} bytes`, ErrorCode.TOO_LARGE);",
    "        }",
    "        if (dataStart + size + 2 > n) {",
    "            return { body: \"\", consumed: 0, complete: false };",
    "        }",
    "        array.push(parts, string.substring(s, dataStart, dataStart + size));",
    "        i = dataStart + size + 2;",
    "    }",
    "    return { body: \"\", consumed: 0, complete: false };",
    "}",
    "",
    "// `string.find` from offset `from`. It searches a copy of the rest of s, so its",
    "// cost is the length after `from`.",
    "int findFrom(String s, String sub, int from) {",
    "    int n = string.length(s);",
    "    if (from >= n) { return -1; }",
    "    int at = string.find(string.substring(s, from, n), sub);",
    "    if (at < 0) { return -1; }",
    "    return from + at;",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Query strings",
    "// ---------------------------------------------------------------------------",
    "",
    "// Splits `a=1&b=2` into a map. A key with no `=` maps to the empty string. `+`",
    "// decodes to a space, as in a form-encoded body.",
    "export Map<String, String> parseQuery(String query) {",
    "    Map<String, String> out = {};",
    "    if (string.length(query) == 0) { return out; }",
    "    forEach(string.split(query, \"&\"), pair) {",
    "        if (string.length(pair) == 0) { continue; }",
    "        int eq = string.find(pair, \"=\");",
    "        if (eq < 0) {",
    "            out[formDecode(pair)] = \"\";",
    "            continue;",
    "        }",
    "        out[formDecode(string.substring(pair, 0, eq))] =",
    "            formDecode(string.substring(pair, eq + 1, string.length(pair)));",
    "    }",
    "    return out;",
    "}",
    "",
    "String formDecode(String s) {",
    "    return percentDecode(string.replaceAll(s, \"+\", \" \"));",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// URLs",
    "// ---------------------------------------------------------------------------",
    "",
    "export type Url {",
    "    String scheme;",
    "    String host;",
    "    int port;",
    "    String path;",
    "    String query;",
    "}",
    "",
    "// Splits an absolute URL. The port defaults to the one for the scheme and the",
    "// path to `/`, so the result can go on the wire as it is.",
    "export Url parseUrl(String url) {",
    "    int i = string.find(url, \"://\");",
    "    if (i <= 0) {",
    "        return Error(\"no scheme in \\\"\" + url + \"\\\"\", ErrorCode.MALFORMED_REQUEST);",
    "    }",
    "    String scheme = string.toLowerCaseAscii(string.substring(url, 0, i));",
    "    String rest = string.substring(url, i + 3, string.length(url));",
    "",
    "    // A fragment is never sent.",
    "    int hash = string.find(rest, \"#\");",
    "    if (hash >= 0) { rest = string.substring(rest, 0, hash); }",
    "",
    "    String query = \"\";",
    "    int q = string.find(rest, \"?\");",
    "    if (q >= 0) {",
    "        query = string.substring(rest, q + 1, string.length(rest));",
    "        rest = string.substring(rest, 0, q);",
    "    }",
    "",
    "    String path = \"/\";",
    "    int slash = string.find(rest, \"/\");",
    "    if (slash >= 0) {",
    "        path = string.substring(rest, slash, string.length(rest));",
    "        rest = string.substring(rest, 0, slash);",
    "    }",
    "",
    "    int port = 80;",
    "    if (scheme == \"https\") { port = 443; }",
    "    String host = rest;",
    "",
    "    if (string.find(rest, \"[\") == 0) {",
    "        // An IPv6 literal, whose colons are not a port separator.",
    "        int close = string.find(rest, \"]\");",
    "        if (close < 0) {",
    "            return Error(\"unterminated IPv6 host in \\\"\" + url + \"\\\"\", ErrorCode.MALFORMED_REQUEST);",
    "        }",
    "        host = string.substring(rest, 1, close);",
    "        String after = string.substring(rest, close + 1, string.length(rest));",
    "        if (string.find(after, \":\") == 0) {",
    "            port = parsePort(string.substring(after, 1, string.length(after)));",
    "        }",
    "    } else {",
    "        int colon = string.find(rest, \":\");",
    "        if (colon >= 0) {",
    "            host = string.substring(rest, 0, colon);",
    "            port = parsePort(string.substring(rest, colon + 1, string.length(rest)));",
    "        }",
    "    }",
    "    if (string.length(host) == 0) {",
    "        return Error(\"no host in \\\"\" + url + \"\\\"\", ErrorCode.MALFORMED_REQUEST);",
    "    }",
    "    return { scheme: scheme, host: host, port: port, path: path, query: query };",
    "}",
    "",
    "int parsePort(String s) {",
    "    int p = string.toInt(s) catch e {",
    "        return Error(\"malformed port \\\"\" + s + \"\\\"\", ErrorCode.MALFORMED_REQUEST);",
    "    };",
    "    if (p < 1 || p > 65535) {",
    "        return Error(`port out of range: ${p}`, ErrorCode.MALFORMED_REQUEST);",
    "    }",
    "    return p;",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Status reasons",
    "// ---------------------------------------------------------------------------",
    "",
    "// The reason phrase a server writes. A client should ignore it (RFC 9110), so",
    "// an unlisted status gets the generic phrase for its class.",
    "export String reasonFor(int status) {",
    "    if (status == 200) { return \"OK\"; }",
    "    if (status == 201) { return \"Created\"; }",
    "    if (status == 204) { return \"No Content\"; }",
    "    if (status == 301) { return \"Moved Permanently\"; }",
    "    if (status == 302) { return \"Found\"; }",
    "    if (status == 304) { return \"Not Modified\"; }",
    "    if (status == 400) { return \"Bad Request\"; }",
    "    if (status == 401) { return \"Unauthorized\"; }",
    "    if (status == 403) { return \"Forbidden\"; }",
    "    if (status == 404) { return \"Not Found\"; }",
    "    if (status == 405) { return \"Method Not Allowed\"; }",
    "    if (status == 408) { return \"Request Timeout\"; }",
    "    if (status == 413) { return \"Content Too Large\"; }",
    "    if (status == 500) { return \"Internal Server Error\"; }",
    "    if (status == 502) { return \"Bad Gateway\"; }",
    "    if (status == 503) { return \"Service Unavailable\"; }",
    "    if (status < 200) { return \"Informational\"; }",
    "    if (status < 300) { return \"Success\"; }",
    "    if (status < 400) { return \"Redirection\"; }",
    "    if (status < 500) { return \"Client Error\"; }",
    "    return \"Server Error\";",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Conn: the transport that every byte goes through",
    "// ---------------------------------------------------------------------------",
    "",
    "// A byte stream, as a record of closures. A `sealed` hierarchy would need a",
    "// type switch at every read, because §2.4 refuses a method call on a value",
    "// whose static type is the sealed base. Built-in functions are not values",
    "// (§3.4), so each constructor wraps `net.read` and `net.write` in a lambda.",
    "export type Conn {",
    "    Function(int)<Future<byte[]!>> read;",
    "    Function(byte[])<Future<void!>> write;",
    "    Function()<void> close;",
    "    String peer;",
    "",
    "    // Reads exactly n bytes in one future. A body read with a known length uses",
    "    // it: one parked operation instead of one per READ_CHUNK. A transport",
    "    // without such a call leaves it null, and Body reads in READ_CHUNK pieces.",
    "    Function(int)<Future<byte[]!>>? readExactly;",
    "}",
    "",
    "export Conn tcpConn(Socket s) {",
    "    return {",
    "        read: Future<byte[]!> (int n) -> net.read(s, n),",
    "        write: Future<void!> (byte[] b) -> net.write(s, b),",
    "        close: void () -> net.close(s),",
    "        peer: net.peer(s) catch \"\",",
    "        readExactly: Future<byte[]!> (int n) -> net.readExactly(s, n),",
    "    };",
    "}",
    "",
    "// A Conn over a TLS connection. `readExactly` is null because a TLS read gives",
    "// one whole record, decrypted and authenticated, so the layer below cannot fill",
    "// a caller's count in place.",
    "//",
    "// `close` starts the TLS close and does not wait for it. Conn.close is",
    "// synchronous, and a TLS close must write close_notify (§6.18). `async.run`",
    "// gives it to the scheduler, which main drains before exit.",
    "export Conn tlsConn(tls.Conn t, String peer) {",
    "    return {",
    "        read: Future<byte[]!> (int n) -> t.read(n),",
    "        write: Future<void!> (byte[] b) -> t.write(b),",
    "        close: void () -> { async.run(t.close(), void () -> { }); },",
    "        peer: peer,",
    "        readExactly: null,",
    "    };",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Reader: a buffer over a Conn",
    "// ---------------------------------------------------------------------------",
    "",
    "// Buffers a Conn. A message does not arrive in the pieces it is made of, so",
    "// Reader keeps the bytes left over. A Body reads through it, so the bytes a",
    "// body does not use start the next message.",
    "//",
    "// Only the header scan appends to `buf` with `+`, and MAX_HEADER_BYTES limits",
    "// it. The n-ary fold of §6.6 applies only within one expression, so appending",
    "// that way over a 10 MB body would copy gigabytes.",
    "type Reader {",
    "    Conn conn;",
    "    String buf;",
    "    // True when the server stops reading a request body before its end.",
    "    bool unread;",
    "",
    "    // Reads up to the blank line and answers the text before it. `buf` then",
    "    // starts at the body. A close between messages raises END_OF_FILE, which",
    "    // ends a keep-alive loop. A close inside a message raises",
    "    // MALFORMED_REQUEST.",
    "    String async headerBlock() {",
    "        int scanned = 0;",
    "        while (true) {",
    "            int at = findFrom(self.buf, CRLF2, scanned);",
    "            if (at >= 0) {",
    "                String block = string.substring(self.buf, 0, at);",
    "                self.buf = string.substring(self.buf, at + 4, string.length(self.buf));",
    "                return block;",
    "            }",
    "            if (string.length(self.buf) > MAX_HEADER_BYTES) {",
    "                return Error(`header block over ${MAX_HEADER_BYTES} bytes`,",
    "                    ErrorCode.TOO_LARGE);",
    "            }",
    "            // Resume three bytes back, because the terminator can cross the",
    "            // join.",
    "            scanned = string.length(self.buf) - 3;",
    "            if (scanned < 0) { scanned = 0; }",
    "",
    "            byte[] b = await self.conn.read(READ_CHUNK);",
    "            if (b.length == 0) {",
    "                if (string.length(self.buf) == 0) {",
    "                    return Error(\"connection closed\", net.ErrorCode.END_OF_FILE);",
    "                }",
    "                return Error(\"connection closed mid-headers\", ErrorCode.MALFORMED_REQUEST);",
    "            }",
    "            self.buf = self.buf + string.fromByteArray(b);",
    "        }",
    "        return \"\";",
    "    }",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Body: a message body, in pieces",
    "// ---------------------------------------------------------------------------",
    "",
    "// A message body, read in pieces. `next` answers the next piece, or an empty",
    "// array at the end. A program gets a closure over a Body. So a body can go from",
    "// one direction to another without being held whole, for example from a client",
    "// response into a streamed server response.",
    "//",
    "// The fields give the framing. `held` is a body already read. `chunked` is",
    "// chunked framing. `left` at 0 or more is the Content-Length still to read.",
    "// `left` below 0 means the close ends the body.",
    "type Body {",
    "    Reader rd;",
    "    byte[]? held;    // a body already read: answered once, then nothing",
    "    int left;        // bytes still to read; below 0 the close ends the body",
    "    bool chunked;",
    "    bool done;",
    "    int chunkLeft;    // data bytes left in the chunk being delivered",
    "    bool needCrlf;    // the CRLF after the chunk data is not read yet",
    "",
    "    byte[] async next() {",
    "        if (self.done) { return []; }",
    "",
    "        byte[]? inHand = self.held;",
    "        if (inHand != null) {",
    "            self.held = null;",
    "            self.done = true;",
    "            return inHand;",
    "        }",
    "",
    "        if (self.chunked) { return await self.nextChunk(); }",
    "        if (self.left == 0) {",
    "            self.done = true;",
    "            return [];",
    "        }",
    "        if (self.left > 0) { return await self.nextCounted(); }",
    "        return await self.nextToClose();",
    "    }",
    "",
    "    // Content-Length framing. It never asks for more than is still to read, so",
    "    // a read cannot take bytes of the next message.",
    "    //",
    "    // When the transport has a bulk read, the body uses it: BODY_ASK bytes per",
    "    // parked operation instead of READ_CHUNK.",
    "    byte[] async nextCounted() {",
    "        int have = string.length(self.rd.buf);",
    "        if (have > 0) {",
    "            int take = self.left;",
    "            if (take > have) { take = have; }",
    "            String piece = string.substring(self.rd.buf, 0, take);",
    "            self.rd.buf = string.substring(self.rd.buf, take, have);",
    "            self.left = self.left - take;",
    "            if (self.left == 0) { self.done = true; }",
    "            return string.toByteArray(piece);",
    "        }",
    "",
    "        int ask = self.left;",
    "        if (ask > BODY_ASK) { ask = BODY_ASK; }",
    "        Function(int)<Future<byte[]!>>? bulk = self.rd.conn.readExactly;",
    "        if (bulk != null) {",
    "            byte[] b = await bulk(ask);",
    "            self.left = self.left - b.length;",
    "            if (self.left == 0) { self.done = true; }",
    "            return b;",
    "        }",
    "",
    "        if (ask > READ_CHUNK) { ask = READ_CHUNK; }",
    "        byte[] b = await self.rd.conn.read(ask);",
    "        if (b.length == 0) {",
    "            return Error(\"connection closed mid-body\", ErrorCode.MALFORMED_REQUEST);",
    "        }",
    "        self.left = self.left - b.length;",
    "        if (self.left == 0) { self.done = true; }",
    "        return b;",
    "    }",
    "",
    "    // The close ends the body, so a close is the end and not an error.",
    "    byte[] async nextToClose() {",
    "        int have = string.length(self.rd.buf);",
    "        if (have > 0) {",
    "            String piece = self.rd.buf;",
    "            self.rd.buf = \"\";",
    "            return string.toByteArray(piece);",
    "        }",
    "        byte[] b = await self.rd.conn.read(READ_CHUNK);",
    "        if (b.length == 0) {",
    "            self.done = true;",
    "            return [];",
    "        }",
    "        return b;",
    "    }",
    "",
    "    // Chunked framing. It answers data in the pieces that arrived, not in the",
    "    // chunk sizes the peer declared. A large chunk is answered in parts, so a",
    "    // declared size does not control how much this holds.",
    "    byte[] async nextChunk() {",
    "        while (true) {",
    "            if (self.chunkLeft > 0) {",
    "                int have = string.length(self.rd.buf);",
    "                if (have == 0) {",
    "                    await self.fill();",
    "                    continue;",
    "                }",
    "                int take = self.chunkLeft;",
    "                if (take > have) { take = have; }",
    "                String piece = string.substring(self.rd.buf, 0, take);",
    "                self.rd.buf = string.substring(self.rd.buf, take, have);",
    "                self.chunkLeft = self.chunkLeft - take;",
    "                if (self.chunkLeft == 0) { self.needCrlf = true; }",
    "                return string.toByteArray(piece);",
    "            }",
    "",
    "            if (self.needCrlf) {",
    "                while (string.length(self.rd.buf) < 2) { await self.fill(); }",
    "                if (string.substring(self.rd.buf, 0, 2) != CRLF) {",
    "                    return Error(\"chunk not ended by CRLF\", ErrorCode.MALFORMED_REQUEST);",
    "                }",
    "                self.rd.buf = string.substring(self.rd.buf, 2, string.length(self.rd.buf));",
    "                self.needCrlf = false;",
    "            }",
    "",
    "            int eol = findFrom(self.rd.buf, CRLF, 0);",
    "            if (eol < 0) {",
    "                if (string.length(self.rd.buf) > MAX_LINE) {",
    "                    return Error(`chunk size line over ${MAX_LINE} bytes`,",
    "                        ErrorCode.MALFORMED_REQUEST);",
    "                }",
    "                await self.fill();",
    "                continue;",
    "            }",
    "",
    "            // A chunk size can have extensions after a `;`. They are ignored.",
    "            String head = string.substring(self.rd.buf, 0, eol);",
    "            int semi = string.find(head, \";\");",
    "            if (semi >= 0) { head = string.substring(head, 0, semi); }",
    "            int size = hexValue(string.trim(head));",
    "            self.rd.buf = string.substring(self.rd.buf, eol + 2, string.length(self.rd.buf));",
    "            if (size == 0) { return await self.trailer(); }",
    "            self.chunkLeft = size;",
    "        }",
    "        return [];",
    "    }",
    "",
    "    // The trailer section after the zero-length chunk, up to the blank line.",
    "    // Trailers are skipped.",
    "    byte[] async trailer() {",
    "        while (true) {",
    "            int eol = findFrom(self.rd.buf, CRLF, 0);",
    "            if (eol == 0) {",
    "                self.rd.buf = string.substring(self.rd.buf, 2, string.length(self.rd.buf));",
    "                self.done = true;",
    "                return [];",
    "            }",
    "            if (eol > 0) {",
    "                self.rd.buf = string.substring(self.rd.buf, eol + 2, string.length(self.rd.buf));",
    "                continue;",
    "            }",
    "            if (string.length(self.rd.buf) > MAX_HEADER_BYTES) {",
    "                return Error(`trailer over ${MAX_HEADER_BYTES} bytes`,",
    "                    ErrorCode.MALFORMED_REQUEST);",
    "            }",
    "            await self.fill();",
    "        }",
    "        return [];",
    "    }",
    "",
    "    // Appends one read to the buffer. A close here ends a message inside its",
    "    // framing, so it is malformed.",
    "    void async fill() {",
    "        byte[] b = await self.rd.conn.read(READ_CHUNK);",
    "        if (b.length == 0) {",
    "            return Error(\"connection closed mid-body\", ErrorCode.MALFORMED_REQUEST);",
    "        }",
    "        self.rd.buf = self.rd.buf + string.fromByteArray(b);",
    "    }",
    "",
    "    // Reads and discards the rest of the body, up to `limit` bytes. Answers",
    "    // true if the body ended. If it did not, the connection cannot be used",
    "    // again.",
    "    bool async drain(int limit) {",
    "        int total = 0;",
    "        while (true) {",
    "            byte[] piece = await self.next() catch e { return false; };",
    "            if (piece.length == 0) { return true; }",
    "            total = total + piece.length;",
    "            if (total > limit) { return false; }",
    "        }",
    "        return true;",
    "    }",
    "}",
    "",
    "// A body of length n. A length of zero gives a body that is already done, as",
    "// for a request with no framing headers or a 204 response.",
    "Body counted(Reader rd, int n) {",
    "    return {",
    "        rd: rd, held: null, left: n, chunked: false, done: n == 0,",
    "        chunkLeft: 0, needCrlf: false,",
    "    };",
    "}",
    "",
    "Body chunkedBody(Reader rd) {",
    "    return {",
    "        rd: rd, held: null, left: -1, chunked: true, done: false,",
    "        chunkLeft: 0, needCrlf: false,",
    "    };",
    "}",
    "",
    "// A body that the close ends: no length and no chunks. It is read until the",
    "// peer closes.",
    "Body toCloseBody(Reader rd) {",
    "    return {",
    "        rd: rd, held: null, left: -1, chunked: false, done: false,",
    "        chunkLeft: 0, needCrlf: false,",
    "    };",
    "}",
    "",
    "// A body already read, answered once. Nothing is copied and the connection is",
    "// not used, so `read` costs nothing on a buffered route.",
    "Body heldBody(Reader rd, byte[] b) {",
    "    return {",
    "        rd: rd, held: b, left: 0, chunked: false, done: false,",
    "        chunkLeft: 0, needCrlf: false,",
    "    };",
    "}",
    "",
    "// The body that a message's framing describes. With neither framing header, a",
    "// request has no body and a response ends at the close. `toClose` tells which",
    "// of the two this is.",
    "Body bodyFor(Reader rd, Framing f, bool toClose) {",
    "    if (f.chunked) { return chunkedBody(rd); }",
    "    if (f.length > 0) { return counted(rd, f.length); }",
    "    if (f.length < 0 && toClose) { return toCloseBody(rd); }",
    "    return counted(rd, 0);",
    "}",
    "",
    "// Reads the rest of a body into one array. `cap` is the limit, and null means",
    "// no limit. A body over the limit raises TOO_LARGE and is not truncated,",
    "// because a truncated body can still parse as a complete one.",
    "//",
    "// The pieces are joined once at the end. The n-ary fold of §6.6 applies only",
    "// within one expression, so `all = all + piece` over a 10 MB body would copy",
    "// gigabytes.",
    "byte[] async drainAll(Function()<Future<byte[]!>> read, int? cap) {",
    "    String[] parts = [];",
    "    int total = 0;",
    "    while (true) {",
    "        byte[] piece = await read();",
    "        if (piece.length == 0) { break; }",
    "        total = total + piece.length;",
    "        int? limit = cap;",
    "        if (limit != null && total > limit) {",
    "            return Error(`body over ${limit} bytes`, ErrorCode.TOO_LARGE);",
    "        }",
    "        array.push(parts, string.fromByteArray(piece));",
    "    }",
    "    return string.toByteArray(string.join(parts, \"\"));",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Writing a message",
    "// ---------------------------------------------------------------------------",
    "",
    "// The status line, the headers, and the blank line that ends them.",
    "String headText(Response r, bool keepAlive) {",
    "    if (keepAlive) {",
    "        setHeader(r.headers, \"connection\", \"keep-alive\");",
    "    } else {",
    "        setHeader(r.headers, \"connection\", \"close\");",
    "    }",
    "",
    "    String[] out = [];",
    "    array.push(out, \"HTTP/1.1 \" + string.from(r.status) + \" \" + reasonFor(r.status) + CRLF);",
    "    forEach(map.keys(r.headers), k) {",
    "        String? v = r.headers[k];",
    "        if (v == null) { continue; }",
    "        array.push(out, k + \": \" + v + CRLF);",
    "    }",
    "    array.push(out, CRLF);",
    "    return string.join(out, \"\");",
    "}",
    "",
    "// Encodes a response. It always writes `Content-Length`, which makes the",
    "// framing clear: a handler answers a whole body, so its length is known.",
    "byte[] encodeResponse(Response r, bool keepAlive, bool headOnly) {",
    "    setHeader(r.headers, \"content-length\", string.from(r.body.length));",
    "    String head = headText(r, keepAlive);",
    "    // A HEAD response has the headers of the GET, Content-Length included, and",
    "    // no body (RFC 9110). The body is dropped here, not by the handler.",
    "    if (headOnly) { return string.toByteArray(head); }",
    "    return string.toByteArray(head + string.fromByteArray(r.body));",
    "}",
    "",
    "// The head of a streamed response. The length is not known when the head is",
    "// sent, so the framing is chunked. A `Content-Length` from the handler is",
    "// removed, because it does not describe this body.",
    "byte[] streamHead(Response r, bool keepAlive) {",
    "    map.remove(r.headers, \"content-length\");",
    "    setHeader(r.headers, \"transfer-encoding\", \"chunked\");",
    "    return string.toByteArray(headText(r, keepAlive));",
    "}",
    "",
    "// One chunk: its size in hex, the bytes, and the CRLF that ends them.",
    "byte[] encodeChunk(byte[] piece) {",
    "    return string.toByteArray(hexSize(piece.length) + CRLF",
    "        + string.fromByteArray(piece) + CRLF);",
    "}",
    "",
    "// The zero-length chunk and an empty trailer section, which end a chunked body.",
    "// A body that stops without it is truncated for the peer. A producer that fails",
    "// mid-stream has no other way to signal the failure.",
    "String const END_CHUNK = \"0\\r\\n\\r\\n\";",
    "",
    "// A chunk size in hexadecimal, with no leading zeros.",
    "String hexSize(int n) {",
    "    if (n == 0) { return \"0\"; }",
    "    String out = \"\";",
    "    int v = n;",
    "    while (v > 0) {",
    "        int d = v % 16;",
    "        out = string.substring(HEX, d, d + 1) + out;",
    "        v = v / 16;",
    "    }",
    "    return out;",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Routing",
    "// ---------------------------------------------------------------------------",
    "",
    "// A handler answers a response directly or through a future. Function types are",
    "// structural and assign only when equal (§2.6), so no single function type",
    "// accepts both. A union does.",
    "//",
    "// The `Sync` member is fallible and the `Async` member is not. §2.9 coerces a",
    "// function value into a fallible function type, so `Sync` accepts a handler",
    "// that raises and one that does not. A raise becomes a 500. That coercion does",
    "// not apply inside a future (§2.7), so an async handler must handle its own",
    "// failures.",
    "export union ResponseFunction {",
    "    Function(Request)<Response!> Sync,",
    "    Function(Request)<Future<Response>> Async }",
    "",
    "// What a route matches: a path pattern split on \"/\", or a compiled RegExp for",
    "// what segments cannot express. Each member takes its tag from its type",
    "// (§2.11). Rule 7 wraps the value a caller gives.",
    "export union Pattern {",
    "    String,",
    "    RegExp }",
    "",
    "// One registered route. Only one of `segments` and `pattern` is set.",
    "//",
    "// `routeStream` sets `stream`. The server then does not read the request body",
    "// of this route, and the handler reads it through `Request.read`.",
    "type Route {",
    "    Method method;",
    "    String[] segments;",
    "    RegExp? pattern;",
    "    ResponseFunction fn;",
    "    bool stream;",
    "}",
    "",
    "// A route and the parameters its pattern captured. Matching comes before the",
    "// body is read, because the route decides whether to read it.",
    "type Match {",
    "    Route route;",
    "    Map<String, String> params;",
    "}",
    "",
    "// Splits a path on \"/\" and drops the empty piece before a leading \"/\", so",
    "// \"/a/b\" and \"a/b\" give the same result. A trailing \"/\" is kept.",
    "String[] splitPath(String p) {",
    "    String[] all = string.split(p, \"/\");",
    "    String[] out = [];",
    "    int i = 0;",
    "    forEach(all, piece) {",
    "        if (i == 0 && string.length(piece) == 0) { i++; continue; }",
    "        array.push(out, piece);",
    "        i++;",
    "    }",
    "    return out;",
    "}",
    "",
    "// The bound parameters, or null when the route does not match. Each call builds",
    "// a new map, so a failed match leaves no bindings.",
    "Map<String, String>? matchRoute(Route r, Method m, String path, String[] got) {",
    "    if (r.method != m) { return null; }",
    "",
    "    RegExp? re = r.pattern;",
    "    if (re != null) {",
    "        if (!regexp.match(path, re)) { return null; }",
    "        return {};",
    "    }",
    "",
    "    Map<String, String> params = {};",
    "    String[] want = r.segments;",
    "    int i = 0;",
    "    while (i < want.length) {",
    "        String w = want[i];",
    "        // \"*\" matches this segment and every one after it.",
    "        if (w == \"*\") { return params; }",
    "        if (i >= got.length) { return null; }",
    "        if (string.find(w, \":\") == 0) {",
    "            params[string.substring(w, 1, string.length(w))] = got[i];",
    "        } else if (w != got[i]) {",
    "            return null;",
    "        }",
    "        i++;",
    "    }",
    "    if (got.length != want.length) { return null; }",
    "    return params;",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Options",
    "// ---------------------------------------------------------------------------",
    "",
    "export type Options {",
    "    Duration? timeout;",
    "    int? backlog;",
    "    int? maxBody;",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Server",
    "// ---------------------------------------------------------------------------",
    "",
    "export type Server {",
    "    Route[] routes;",
    "    Listener? listener;",
    "    int maxBody;",
    "    bool running;",
    "",
    "    // Registers handler h for requests with method m whose path matches p. `p`",
    "    // and `h` are unions (§2.11), and §2.10 rule 7 selects the member from what",
    "    // a caller gives, so no call site names a tag. A path pattern is split",
    "    // here, not per request.",
    "    void route(Method m, Pattern p, ResponseFunction h) {",
    "        self.add(m, p, h, false);",
    "    }",
    "",
    "    // Registers a handler that reads the request body itself. The server reads",
    "    // none of the body: `Request.body` is empty and `Request.read` answers the",
    "    // pieces as they arrive, so an upload is never held whole.",
    "    //",
    "    // This is not the default, because a handler that reads the body must",
    "    // await, and only a named async function can (§5.2). If every route",
    "    // streamed, no inline handler could be used. After the handler answers, the",
    "    // server reads and discards up to DRAIN_LIMIT unread bytes. If more remain,",
    "    // it closes the connection.",
    "    void routeStream(Method m, Pattern p, ResponseFunction h) {",
    "        self.add(m, p, h, true);",
    "    }",
    "",
    "    void add(Method m, Pattern p, ResponseFunction h, bool stream) {",
    "        switch (p) {",
    "            case Pattern.String path:",
    "                array.push(self.routes, {",
    "                    method: m, segments: splitPath(path), pattern: null, fn: h,",
    "                    stream: stream,",
    "                });",
    "            case Pattern.RegExp re:",
    "                array.push(self.routes, {",
    "                    method: m, segments: [], pattern: re, fn: h, stream: stream,",
    "                });",
    "        }",
    "    }",
    "",
    "    // The first route that matches a method and a path, with the parameters its",
    "    // pattern captured. The first match wins, so register a catch-all last.",
    "    Match? routeFor(Method m, String path) {",
    "        String[] got = splitPath(path);",
    "        forEach(self.routes, r) {",
    "            Map<String, String>? params = matchRoute(r, m, path, got);",
    "            if (params == null) { continue; }",
    "            return { route: r, params: params };",
    "        }",
    "        return null;",
    "    }",
    "",
    "    // Runs one route's handler.",
    "    Response async run(Route r, Request req) {",
    "        switch (r.fn) {",
    "            case ResponseFunction.Sync h: return h(req);",
    "            case ResponseFunction.Async a: return await a(req);",
    "        }",
    "    }",
    "",
    "    // Finds the route a request lands on and runs it.",
    "    Response async dispatch(Request req) {",
    "        Match? m = self.routeFor(req.method, req.path);",
    "        if (m == null) { return text(404, \"not found\"); }",
    "        Match hit = m;",
    "        req.params = hit.params;",
    "        return await self.run(hit.route, req);",
    "    }",
    "",
    "    // Binds the listener and answers the bound port, so a caller that asks for",
    "    // port 0 learns its port. It is synchronous and separate from `serve`,",
    "    // because a call to an async function does not run its body (§5.2). A",
    "    // program that starts `serve` with `async.run` would otherwise read",
    "    // `port()` before the bind.",
    "    int bind(String host, int port, Options? o) {",
    "        int backlog = 128;",
    "        Options? opts = o;",
    "        if (opts != null) {",
    "            int? b = opts.backlog;",
    "            if (b != null) { backlog = b; }",
    "            int? mb = opts.maxBody;",
    "            if (mb != null) { self.maxBody = mb; }",
    "        }",
    "        Listener l = net.tcp.listen(joinAddr(host, port), { backlog: backlog });",
    "        self.listener = l;",
    "        self.running = true;",
    "        return self.port();",
    "    }",
    "",
    "    // Accepts connections until `close`. Call `bind` first.",
    "    void async serve() {",
    "        Listener? bound = self.listener;",
    "        if (bound == null) {",
    "            return Error(\"serve before bind\", ErrorCode.MALFORMED_REQUEST);",
    "        }",
    "        Listener l = bound;",
    "",
    "        while (self.running) {",
    "            Socket c = await net.accept(l) catch e {",
    "                if (!self.running) { break; }",
    "                // Running out of descriptors is temporary, because a finished",
    "                // connection releases one. It does not stop the server.",
    "                if (e.code == net.ErrorCode.TOO_MANY_FILES) { continue; }",
    "                if (e.code == net.ErrorCode.NOT_CONNECTED) { break; }",
    "                return e;",
    "            };",
    "            async.run(serveConn(self, tcpConn(c)), void () -> { });",
    "        }",
    "        net.close(l);",
    "    }",
    "",
    "    // Calls `bind`, then `serve`. A caller that must read `port()` between them",
    "    // calls the two itself.",
    "    void async listen(String host, int port, Options? o) {",
    "        self.bind(host, port, o);",
    "        await self.serve();",
    "    }",
    "",
    "    // The bound port. A caller that asked for port 0 reads its port here.",
    "    int port() {",
    "        Listener? l = self.listener;",
    "        if (l == null) { return 0; }",
    "        String a = net.address(l) catch \"\";",
    "        int c = lastIndexOf(a, \":\");",
    "        if (c < 0) { return 0; }",
    "        return string.toInt(string.substring(a, c + 1, string.length(a))) catch 0;",
    "    }",
    "",
    "    // Stops the accept loop. Connections already being served finish.",
    "    void close() {",
    "        self.running = false;",
    "        Listener? l = self.listener;",
    "        if (l != null) { net.close(l); }",
    "        self.listener = null;",
    "    }",
    "}",
    "",
    "// A new server with no routes. Each call gives a separate server, so a program",
    "// can run two at once.",
    "export Server server() {",
    "    return { routes: [], listener: null, maxBody: MAX_BODY, running: false };",
    "}",
    "",
    "// Formats the address that `net` takes. It puts brackets around a bare IPv6",
    "// literal.",
    "String joinAddr(String host, int port) {",
    "    if (string.find(host, \":\") >= 0 && string.find(host, \"[\") != 0) {",
    "        return \"[\" + host + \"]:\" + string.from(port);",
    "    }",
    "    return host + \":\" + string.from(port);",
    "}",
    "",
    "int lastIndexOf(String s, String sub) {",
    "    int best = -1;",
    "    int at = string.find(s, sub);",
    "    int base = 0;",
    "    while (at >= 0) {",
    "        best = base + at;",
    "        base = best + 1;",
    "        if (base >= string.length(s)) { break; }",
    "        at = string.find(string.substring(s, base, string.length(s)), sub);",
    "    }",
    "    return best;",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Serving one connection",
    "// ---------------------------------------------------------------------------",
    "",
    "// Serves requests on one connection until it closes or asks to close. It",
    "// catches every error: `async.run` refuses a fallible future (§6.8), and one",
    "// bad connection must not stop the program.",
    "//",
    "// `serveOne` is separate to limit memory. The locals of an async body live in",
    "// its heap frame while it runs. This function runs for the whole life of a",
    "// keep-alive connection, so a body held in its frame would stay reachable while",
    "// the connection is idle. In the frame of `serveOne` it becomes garbage when",
    "// the response is written.",
    "void async serveConn(Server s, Conn c) {",
    "    Reader rd = { conn: c, buf: \"\", unread: false };",
    "    while (true) {",
    "        bool keep = await serveOne(s, c, rd);",
    "        if (!keep) { break; }",
    "    }",
    "    if (rd.unread) {",
    "        await async.race(discardAll(c), time.sleep(LINGER));",
    "    }",
    "    c.close();",
    "}",
    "",
    "// Reads until the peer closes. The close in serveConn ends a read that is still",
    "// waiting, and the error is dropped here because no one awaits this future.",
    "void async discardAll(Conn c) {",
    "    while (true) {",
    "        byte[] b = await c.read(BODY_ASK) catch e { return; };",
    "        if (b.length == 0) { return; }",
    "    }",
    "}",
    "",
    "// Serves one request. Answers true if the connection can take another request.",
    "bool async serveOne(Server s, Conn c, Reader rd) {",
    "    String block = await rd.headerBlock() catch e {",
    "        // END_OF_FILE between messages is how a keep-alive connection ends.",
    "        if (e.code != net.ErrorCode.END_OF_FILE) {",
    "            await writeStatus(c, 400, e.message) catch e2 { };",
    "        }",
    "        return false;",
    "    };",
    "",
    "    String[] lines = string.split(block, CRLF);",
    "    RequestLine rl = parseRequestLine(lines[0]) catch e {",
    "        await writeStatus(c, 400, e.message) catch e2 { };",
    "        return false;",
    "    };",
    "    HeaderBlock hb = parseHeaders(array.slice(lines, 1)) catch e {",
    "        await writeStatus(c, 400, e.message) catch e2 { };",
    "        return false;",
    "    };",
    "    Framing f = framingOf(hb.headers) catch e {",
    "        await writeStatus(c, 400, e.message) catch e2 { };",
    "        return false;",
    "    };",
    "",
    "    // The route decides whether the body is read, so find the route first.",
    "    Match? found = s.routeFor(rl.method, rl.path);",
    "    bool streaming = false;",
    "    if (found != null) {",
    "        Match hit = found;",
    "        streaming = hit.route.stream;",
    "    }",
    "",
    "    // Most requests have no body, and then `wire` is already done. It becomes",
    "    // the source as it is, with no read, join or copy.",
    "    Body wire = bodyFor(rd, f, false);",
    "    Body source = wire;",
    "    byte[] held = [];",
    "    if (!streaming && !wire.done) {",
    "        // A declared length over the limit is refused before any of the body is",
    "        // read. A chunked body declares no length, so the limit is checked",
    "        // while it is read.",
    "        if (!f.chunked && f.length > s.maxBody) {",
    "            rd.unread = true;",
    "            await writeStatus(c, 413, `body over ${s.maxBody} bytes`) catch e2 { };",
    "            return false;",
    "        }",
    "        held = await drainAll(Future<byte[]!> () -> wire.next(), s.maxBody) catch e {",
    "            rd.unread = true;",
    "            await writeStatus(c, statusForError(e), e.message) catch e2 { };",
    "            return false;",
    "        };",
    "        source = heldBody(rd, held);",
    "    }",
    "",
    "    bool keep = keepAliveFor(rl, hb.headers);",
    "",
    "    Request req = {",
    "        method: rl.method,",
    "        path: rl.path,",
    "        query: rl.query,",
    "        headers: hb.headers,",
    "        params: {},",
    "        body: held,",
    "        peer: c.peer,",
    "        read: Future<byte[]!> () -> source.next(),",
    "        maxBody: s.maxBody,",
    "    };",
    "",
    "    // A handler that raised gets a bare 500. The error message is for the",
    "    // server to report, not for the client. A catch for a non-optional target",
    "    // must leave the block (§3.7), so the failure arrives here as null.",
    "    Response? answered = null;",
    "    if (found != null) {",
    "        Match hit = found;",
    "        req.params = hit.params;",
    "        answered = await s.run(hit.route, req) catch null;",
    "    } else {",
    "        answered = text(404, \"not found\");",
    "    }",
    "    if (answered == null) {",
    "        keep = false;",
    "        answered = text(500, \"internal server error\");",
    "    }",
    "    Response resp = answered;",
    "",
    "    // The next message on this connection starts where this body ends, so the",
    "    // server must read what a streaming handler did not. It reads up to",
    "    // DRAIN_LIMIT and closes the connection if more remains.",
    "    if (streaming && !source.done) {",
    "        bool drained = await source.drain(DRAIN_LIMIT);",
    "        if (!drained) {",
    "            keep = false;",
    "            rd.unread = true;",
    "        }",
    "    }",
    "",
    "    bool headOnly = rl.method == Method.HEAD;",
    "    BodyStream? produce = resp.stream;",
    "    if (produce == null) {",
    "        await c.write(encodeResponse(resp, keep, headOnly)) catch e {",
    "            return false;",
    "        };",
    "        return keep;",
    "    }",
    "    return await writeStream(c, resp, produce, keep, headOnly);",
    "}",
    "",
    "// Writes a streamed response: the chunked head, one chunk per piece, and the",
    "// terminator. Answers true if the connection can take another request.",
    "//",
    "// The head goes out before the first piece is requested, so a producer that",
    "// fails mid-stream cannot send a status. The body then ends without its",
    "// terminator and the connection closes, which tells the peer that the body is",
    "// incomplete.",
    "bool async writeStream(Conn c, Response r, BodyStream produce,",
    "    bool keepAlive, bool headOnly) {",
    "    await c.write(streamHead(r, keepAlive)) catch e { return false; };",
    "",
    "    // A HEAD response has the headers of the GET and no body. The producer is",
    "    // never called, so a HEAD costs only the headers.",
    "    if (headOnly) { return keepAlive; }",
    "",
    "    while (true) {",
    "        byte[] piece = [];",
    "        switch (produce) {",
    "            case BodyStream.Plain p: piece = await p();",
    "            case BodyStream.Raising q: piece = await q() catch e { return false; };",
    "        }",
    "        if (piece.length == 0) { break; }",
    "        await c.write(encodeChunk(piece)) catch e { return false; };",
    "    }",
    "    await c.write(string.toByteArray(END_CHUNK)) catch e { return false; };",
    "    return keepAlive;",
    "}",
    "",
    "// Whether to keep the connection open. The version decides, and a Connection",
    "// header overrides it.",
    "bool keepAliveFor(RequestLine rl, Map<String, String> h) {",
    "    String? conn = h[\"connection\"];",
    "    if (conn == null) { return rl.keepAlive; }",
    "    String lc = string.toLowerCaseAscii(conn);",
    "    if (string.contains(lc, \"close\")) { return false; }",
    "    if (string.contains(lc, \"keep-alive\")) { return true; }",
    "    return rl.keepAlive;",
    "}",
    "",
    "int statusForError(Error e) {",
    "    if (e.code == ErrorCode.TOO_LARGE) { return 413; }",
    "    return 400;",
    "}",
    "",
    "// A bare status, for a request too malformed to have a route.",
    "void async writeStatus(Conn c, int status, String message) {",
    "    Response r = text(status, message);",
    "    await c.write(encodeResponse(r, false, false));",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Client",
    "// ---------------------------------------------------------------------------",
    "",
    "// The options of a client request. Every field is optional, because §2.4",
    "// requires every non-optional field in a record literal, and each caller would",
    "// have to give it.",
    "//",
    "// `body` is a `String`, so that `body: \"test\"` type-checks (§2.10 has no",
    "// implicit conversion). `bodyBytes` carries a body that is not text, and is",
    "// used when both are set.",
    "export type ClientOptions {",
    "    Map<String, String>? headers;",
    "    String? body;",
    "    byte[]? bodyBytes;",
    "    Duration? timeout;",
    "    bool? followRedirects;",
    "",
    "    // The options that an `https` dial gives to `tls.connect`, such as `roots`,",
    "    // `pins` or `insecureSkipVerify` (§6.18). When null, the peer is verified",
    "    // against the host's trust store. `alpn` is ignored, because this module",
    "    // speaks HTTP/1.1.",
    "    tls.Options? tls;",
    "",
    "    // The largest response body that `ClientResponse.bytes` and `text` hold.",
    "    // Null means no limit: the body is a stream and the caller decides how",
    "    // much to keep. `ClientResponse.read` does not",
    "    // apply this limit, because a caller that reads piece by piece makes that",
    "    // decision itself.",
    "    //",
    "    // When set, the declared length is compared with it before any of the body",
    "    // is read, so refusing a large response costs nothing.",
    "    int? maxBody;",
    "",
    "    // Sets header `name`. Header names are case-insensitive and map keys are",
    "    // not, so these accessors use the lower-cased name: `Content-Type` and",
    "    // `content-type` are one header.",
    "    void setHeader(String name, String value) {",
    "        Map<String, String>? h = self.headers;",
    "        if (h == null) {",
    "            Map<String, String> fresh = {};",
    "            self.headers = fresh;",
    "            h = fresh;",
    "        }",
    "        h[string.toLowerCaseAscii(name)] = value;",
    "    }",
    "",
    "    String? getHeader(String name) {",
    "        Map<String, String>? h = self.headers;",
    "        if (h == null) { return null; }",
    "        return h[string.toLowerCaseAscii(name)];",
    "    }",
    "",
    "    void removeHeader(String name) {",
    "        Map<String, String>? h = self.headers;",
    "        if (h == null) { return; }",
    "        map.remove(h, string.toLowerCaseAscii(name));",
    "    }",
    "}",
    "",
    "// An empty ClientOptions, for a caller that fills it with the setters.",
    "export ClientOptions options() {",
    "    return {",
    "        headers: null, body: null, bodyBytes: null, timeout: null,",
    "        followRedirects: null, tls: null, maxBody: null,",
    "    };",
    "}",
    "",
    "// The response body limit of a request. Null means no limit.",
    "int? maxBodyOf(ClientOptions? o) {",
    "    ClientOptions? opts = o;",
    "    if (opts == null) { return null; }",
    "    return opts.maxBody;",
    "}",
    "",
    "int const MAX_REDIRECTS = 5;",
    "",
    "// Sends a request and answers the response. A failure is raised at the `await`.",
    "// When `followRedirects` is set, it follows up to MAX_REDIRECTS redirects.",
    "export ClientResponse async request(Method m, String url, ClientOptions? o) {",
    "    String at = url;",
    "    int hops = 0;",
    "    while (true) {",
    "        Url u = parseUrl(at);",
    "        if (u.scheme != \"http\" && u.scheme != \"https\") {",
    "            return Error(\"unsupported scheme \\\"\" + u.scheme + \"\\\"\", ErrorCode.UNSUPPORTED_SCHEME);",
    "        }",
    "",
    "        ClientResponse res = await once(m, u, o);",
    "        if (!wantsRedirect(o) || !isRedirect(res.status)) { return res; }",
    "",
    "        String? loc = res.headers[\"location\"];",
    "        if (loc == null) { return res; }",
    "",
    "        // The body of a redirect is not the one the caller asked for, and",
    "        // nothing else reads it, so the connection closes.",
    "        res.close();",
    "        hops++;",
    "        if (hops > MAX_REDIRECTS) {",
    "            return Error(`more than ${MAX_REDIRECTS} redirects`,",
    "                ErrorCode.TOO_MANY_REDIRECTS);",
    "        }",
    "        at = absolute(u, loc);",
    "    }",
    "    return Error(\"unreachable\", ErrorCode.MALFORMED_RESPONSE);",
    "}",
    "",
    "bool wantsRedirect(ClientOptions? o) {",
    "    ClientOptions? opts = o;",
    "    if (opts == null) { return false; }",
    "    bool? f = opts.followRedirects;",
    "    if (f == null) { return false; }",
    "    return f;",
    "}",
    "",
    "bool isRedirect(int status) {",
    "    return status == 301 || status == 302 || status == 303 || status == 307 || status == 308;",
    "}",
    "",
    "// Resolves a Location against the URL it came from. A full URL carries its own",
    "// scheme, so a redirect from http to https changes the transport. A rooted path",
    "// keeps the scheme of the current URL.",
    "String absolute(Url from, String loc) {",
    "    if (string.find(loc, \"://\") > 0) { return loc; }",
    "    String base = from.scheme + \"://\" + joinAddr(from.host, from.port);",
    "    if (string.find(loc, \"/\") == 0) { return base + loc; }",
    "    return base + \"/\" + loc;",
    "}",
    "",
    "// One request and response on a new connection. There is no connection pool. A",
    "// pool is a cache with an eviction policy, and belongs above this function.",
    "ClientResponse async once(Method m, Url u, ClientOptions? o) {",
    "    Map<String, String> headers = {};",
    "    String bodyText = \"\";",
    "    ClientOptions? opts = o;",
    "    if (opts != null) {",
    "        Map<String, String>? h = opts.headers;",
    "        if (h != null) {",
    "            forEach(map.keys(h), k) {",
    "                String? v = h[k];",
    "                if (v != null) { headers[string.toLowerCaseAscii(k)] = v; }",
    "            }",
    "        }",
    "        byte[]? raw = opts.bodyBytes;",
    "        if (raw != null) {",
    "            bodyText = string.fromByteArray(raw);",
    "        } else {",
    "            String? t = opts.body;",
    "            if (t != null) { bodyText = t; }",
    "        }",
    "    }",
    "",
    "    // HTTP/1.1 requires Host. A Host that the caller set is kept.",
    "    if (headers[\"host\"] == null) {",
    "        headers[\"host\"] = hostHeader(u);",
    "    }",
    "    headers[\"content-length\"] = string.from(string.length(bodyText));",
    "    headers[\"connection\"] = \"close\";",
    "",
    "    String target = u.path;",
    "    if (string.length(u.query) > 0) { target = target + \"?\" + u.query; }",
    "",
    "    String[] out = [];",
    "    array.push(out, string.from(m) + \" \" + target + \" HTTP/1.1\" + CRLF);",
    "    forEach(map.keys(headers), k) {",
    "        String? v = headers[k];",
    "        if (v == null) { continue; }",
    "        array.push(out, k + \": \" + v + CRLF);",
    "    }",
    "    array.push(out, CRLF);",
    "    array.push(out, bodyText);",
    "",
    "    Conn c = await dial(u, o);",
    "    await c.write(string.toByteArray(string.join(out, \"\")));",
    "",
    "    Reader rd = { conn: c, buf: \"\", unread: false };",
    "    String block = await rd.headerBlock();",
    "    String[] lines = string.split(block, CRLF);",
    "    StatusLine sl = parseStatusLine(lines[0]);",
    "    HeaderBlock hb = parseHeaders(array.slice(lines, 1));",
    "",
    "    int? maxBody = maxBodyOf(o);",
    "",
    "    // 204 and 304 responses have no body, whatever their headers say (RFC",
    "    // 9110). A read would block until the connection closed.",
    "    Body body = counted(rd, 0);",
    "    if (sl.status != 204 && sl.status != 304 && m != Method.HEAD) {",
    "        Framing f = framingOf(hb.headers);",
    "        // A limit that the caller set is checked against the declared length",
    "        // before the body is read. The server answers 413 here. A client has",
    "        // nobody to answer, so it raises.",
    "        int? cap = maxBody;",
    "        if (cap != null && !f.chunked && f.length > cap) {",
    "            c.close();",
    "            return Error(`response body over ${cap} bytes`, ErrorCode.TOO_LARGE);",
    "        }",
    "        body = bodyFor(rd, f, true);",
    "    }",
    "",
    "    // A message with no body is done with its connection, so close it now.",
    "    // Otherwise the connection stays open as long as the body, and `readPiece`",
    "    // closes it at the end. There is no pool, so a drained connection has no",
    "    // other use.",
    "    if (body.done) { c.close(); }",
    "",
    "    return {",
    "        status: sl.status,",
    "        reason: sl.reason,",
    "        headers: hb.headers,",
    "        setCookies: hb.setCookies,",
    "        read: Future<byte[]!> () -> readPiece(body, c),",
    "        close: void () -> c.close(),",
    "        maxBody: maxBody,",
    "    };",
    "}",
    "",
    "// Answers the next piece of the body. It closes the connection at the end of",
    "// the body and on a failure. A caller that stops early must close it.",
    "byte[] async readPiece(Body b, Conn c) {",
    "    byte[] piece = await b.next() catch e {",
    "        c.close();",
    "        return e;",
    "    };",
    "    if (piece.length == 0) { c.close(); }",
    "    return piece;",
    "}",
    "",
    "// Opens the transport for the scheme: a TCP socket for `http`, a TLS connection",
    "// for `https`. For https, `tls.connect` verifies the host of the URL, and a",
    "// caller cannot give a different name. ALPN is fixed to `http/1.1`.",
    "Conn async dial(Url u, ClientOptions? o) {",
    "    Duration? timeout = null;",
    "    tls.Options? given = null;",
    "    ClientOptions? opts = o;",
    "    if (opts != null) {",
    "        timeout = opts.timeout;",
    "        given = opts.tls;",
    "    }",
    "",
    "    if (u.scheme == \"http\") {",
    "        Socket sock = await net.tcp.connect(joinAddr(u.host, u.port), { timeout: timeout });",
    "        return tcpConn(sock);",
    "    }",
    "",
    "    // The caller's TLS options are copied one field at a time, so that this",
    "    // module controls `alpn`. Each field that `tls.Options` gets and that a",
    "    // caller can set must be copied here too, or it has no effect over https.",
    "    tls.Options handed = { timeout: timeout, alpn: [\"http/1.1\"] };",
    "    if (given != null) {",
    "        handed.roots = given.roots;",
    "        handed.insecureSkipVerify = given.insecureSkipVerify;",
    "        handed.pins = given.pins;",
    "        Duration? t = given.timeout;",
    "        if (t != null) { handed.timeout = t; }",
    "    }",
    "    tls.Conn conn = await tls.connect(joinAddr(u.host, u.port), u.host, handed);",
    "    return tlsConn(conn, joinAddr(u.host, u.port));",
    "}",
    "",
    "// The value of the `Host` header. The port is left out when it is the default",
    "// for the scheme, because virtual hosts are matched against that form.",
    "String hostHeader(Url u) {",
    "    String h = u.host;",
    "    if (string.find(h, \":\") >= 0) { h = \"[\" + h + \"]\"; }",
    "    if (u.scheme == \"http\" && u.port == 80) { return h; }",
    "    if (u.scheme == \"https\" && u.port == 443) { return h; }",
    "    return h + \":\" + string.from(u.port);",
    "}",
    "",
];

String[] const testLines = [
    "// The `test` module (§6.13): declaring tests, asserting inside them, and",
    "// reporting how they went.",
    "//",
    "// An assertion raises (§2.9). `assert` returns an Error, which makes the test",
    "// body fallible, and `start` catches it at the closure boundary. A test stops",
    "// at its first failed assertion. An unexpected error is reported as a failure",
    "// and does not end the program.",
    "//",
    "// A test program reads `--filter text` off its own command line and runs only",
    "// the tests whose title holds that text, so `nio test --filter lexer` and",
    "// `nio run tests/all.nio --filter lexer` select the same way.",
    "import 'array';",
    "import 'string';",
    "import 'process';",
    "",
    "type Pending {",
    "    String title;",
    "    Future<void!> task;",
    "}",
    "",
    "int passed = 0;",
    "int failed = 0;",
    "int filtered = 0;",
    "Pending[] pending = [];",
    "",
    "// The `--filter text` or `--filter=text` the program was started with, read",
    "// once. A title that holds the text is selected, so a filter names one test or",
    "// a family of them.",
    "String chosen = \"\";",
    "bool asked = false;",
    "",
    "String filter() {",
    "    if (asked) {",
    "        return chosen;",
    "    }",
    "    asked = true;",
    "    String[] args = process.getArgs();",
    "    forEach(args, a, i) {",
    "        if (a == \"--filter\" && i + 1 < args.length) {",
    "            chosen = args[i + 1];",
    "        }",
    "        if (string.find(a, \"--filter=\") == 0) {",
    "            chosen = string.substring(a, 9, string.length(a));",
    "        }",
    "    }",
    "    return chosen;",
    "}",
    "",
    "bool selected(String title) {",
    "    String f = filter();",
    "    if (f == \"\") {",
    "        return true;",
    "    }",
    "    return string.contains(title, f);",
    "}",
    "",
    "// Each result prints when it is known. A run that never reaches `run` still",
    "// shows what it checked. Output to a pipe is buffered, so each line is flushed:",
    "// when a test stops the run, the last line names the test before it.",
    "void note(String title, bool ok, String message) {",
    "    if (ok) {",
    "        passed++;",
    "        print(\"ok   \" + title);",
    "    } else {",
    "        failed++;",
    "        print(\"FAIL \" + title + \" - \" + message);",
    "    }",
    "    process.stdout.flush();",
    "}",
    "",
    "// Runs body now and reports it. The parameter is fallible, which lets the body",
    "// assert. A body that cannot fail is accepted too.",
    "export void start(String title, Function()<void!> body) {",
    "    if (!selected(title)) {",
    "        filtered++;",
    "        return;",
    "    }",
    "    body() catch e {",
    "        note(title, false, e.message);",
    "        return;",
    "    };",
    "    note(title, true, \"\");",
    "}",
    "",
    "// Registers a task. Calling an async function does not run its body (§5.2).",
    "// The scheduler does not step until `run` awaits, so all tests registered",
    "// before then interleave at their awaits.",
    "export void startAsync(String title, Future<void!> task) {",
    "    array.push(pending, { title: title, task: task });",
    "}",
    "",
    "export void assert(bool ok, String message) {",
    "    if (!ok) { return Error(message); }",
    "}",
    "",
    "// There are no generics (§7), so each type has its own expectation. `assert`",
    "// covers the other types.",
    "export void expectInt(int got, int want) {",
    "    if (got != want) {",
    "        return Error(`expected ${want}, got ${got}`);",
    "    }",
    "}",
    "",
    "export void expectFloat(float got, float want) {",
    "    if (got != want) {",
    "        return Error(`expected ${want}, got ${got}`);",
    "    }",
    "}",
    "",
    "// For a computed value: arithmetic that gives 0.3 rarely gives exactly 0.3.",
    "export void expectFloatNear(float got, float want, float tolerance) {",
    "    float d = got - want;",
    "    if (d < 0.0) { d = -d; }",
    "    if (d > tolerance) {",
    "        return Error(`expected ${want} within ${tolerance}, got ${got}`);",
    "    }",
    "}",
    "",
    "export void expectString(String got, String want) {",
    "    if (got != want) {",
    "        return Error(\"expected \\\"\" + want + \"\\\", got \\\"\" + got + \"\\\"\");",
    "    }",
    "}",
    "",
    "export void expectBool(bool got, bool want) {",
    "    if (got != want) {",
    "        return Error(`expected ${want}, got ${got}`);",
    "    }",
    "}",
    "",
    "// Waits for every test started with startAsync, prints the summary, and exits",
    "// with status 1 if anything failed. A successful run returns.",
    "export void run() {",
    "    forEach(pending, p) {",
    "        if (!selected(p.title)) {",
    "            // The caller started the task before registering it (§5.2), so a",
    "            // filter cannot stop it. Await it and discard the result, or the",
    "            // drain reports an error that no await took.",
    "            await p.task catch e { };",
    "            filtered++;",
    "            continue;",
    "        }",
    "        await p.task catch e {",
    "            note(p.title, false, e.message);",
    "            continue;",
    "        };",
    "        note(p.title, true, \"\");",
    "    }",
    "    pending = [];",
    "    if (filter() == \"\") {",
    "        print(`${passed} passed, ${failed} failed`);",
    "    } else {",
    "        print(`${passed} passed, ${failed} failed, ${filtered} filtered out`);",
    "    }",
    "    if (failed > 0) { process.exit(1); }",
    "}",
    "",
];

String[] const tlsLines = [
    "// The `tls` module (§6.18): a TLS 1.3 client with key schedule, record layer",
    "// and handshake. Every operation on a secret is a call into `crypto`. No code",
    "// here compares a secret directly: the Finished MAC comparison uses",
    "// `string.bytesEqualConstantTime` at its call site.",
    "//",
    "// No code here owns a socket. The key schedule and `RecordProtection` do not",
    "// depend on each other, so QUIC (RFC 9001) can use the schedule with its own",
    "// packet protection.",
    "//",
    "// Both cipher suites use SHA-256, so it is the only hash.",
    "//",
    "// Error codes have the names of the TLS alerts that they become (RFC 8446 §6).",
    "// A record that fails authentication passes `crypto.ErrorCode.AUTHENTICATION`",
    "// through unchanged. That code becomes `bad_record_mac`.",
    "import 'crypto';",
    "import 'string';",
    "import 'array';",
    "import 'map';",
    "import 'net';",
    "import 'x509';",
    "",
    "// The error codes of tls. They start at 200, above the NIO_ERR_* set and the",
    "// 100s of http, so the three sets do not overlap. The names are the alert names",
    "// of RFC 8446 §6, and `alertFor` maps a caught code to the alert to send. This",
    "// end never sends PEER_ALERT: it means that the peer sent an alert.",
    "export enum ErrorCode {",
    "    ILLEGAL_PARAMETER: 200,",
    "    DECODE_ERROR: 201,",
    "    RECORD_OVERFLOW: 202,",
    "    UNEXPECTED_MESSAGE: 203,",
    "    PEER_ALERT: 204,",
    "    HANDSHAKE_FAILURE: 205,",
    "    DECRYPT_ERROR: 206,",
    "    UNSUPPORTED_CERTIFICATE: 207,",
    "    UNSUPPORTED_EXTENSION: 208,",
    "    TOO_MANY_MESSAGES: 209,",
    "    // The chain verified and no certificate in it carries a pinned key.",
    "    PIN_MISMATCH: 210,",
    "    // The options contradict each other. The fault is at this end, so it is",
    "    // raised before any byte is sent.",
    "    MISCONFIGURED: 211",
    "}",
    "",
    "// The record-layer content types (RFC 8446 §5.1). A 1.3 endpoint drops",
    "// CHANGE_CIPHER_SPEC, and the record layer recognizes the byte to report it.",
    "export enum ContentType {",
    "    CHANGE_CIPHER_SPEC: 20,",
    "    ALERT: 21,",
    "    HANDSHAKE: 22,",
    "    APPLICATION_DATA: 23",
    "}",
    "",
    "// RFC 8446 §5.1 and §5.2 make both limits hard: a receiver must enforce them.",
    "// A protected record adds up to 255 padding bytes plus the 16-byte tag.",
    "int const MAX_PLAINTEXT = 16384;",
    "int const MAX_CIPHERTEXT = 16640;    // 2^14 + 256",
    "",
    "byte[] const EMPTY = string.toByteArray(\"\");",
    "",
    "// Transcript-Hash of zero messages. The two \"derived\" steps of the key schedule",
    "// use it as their context (RFC 8446 §7.1).",
    "byte[] const EMPTY_HASH = crypto.sha256(EMPTY);",
    "",
    "// Concatenates through the packed string form. That is one memcpy in each",
    "// direction (§6.6) and not a loop per element.",
    "byte[] cat(byte[] a, byte[] b) {",
    "    return string.toByteArray(string.fromByteArray(a) + string.fromByteArray(b));",
    "}",
    "",
    "byte[] zeros32() {",
    "    byte[] out = [];",
    "    int i = 0;",
    "    while (i < 32) {",
    "        array.push(out, 0);",
    "        i++;",
    "    }",
    "    return out;",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// HKDF-Expand-Label (RFC 8446 §7.1)",
    "// ---------------------------------------------------------------------------",
    "",
    "// The body without checks. Each caller in this file passes a label and context",
    "// that the protocol fixes, so the length bytes cannot wrap. The exported",
    "// function validates.",
    "byte[] expandLabel(byte[] secret, String label, byte[] context, int length) {",
    "    String full = \"tls13 \" + label;",
    "    byte[] head = [",
    "        (length / 256) as byte,",
    "        (length % 256) as byte,",
    "        string.length(full) as byte,",
    "    ];",
    "    String info = string.fromByteArray(head) + full",
    "        + string.fromByteArray([context.length as byte])",
    "        + string.fromByteArray(context);",
    "    return crypto.hkdfExpandSha256(secret, string.toByteArray(info), length);",
    "}",
    "",
    "// HKDF-Expand-Label of RFC 8446. Raises ILLEGAL_PARAMETER when a length byte",
    "// would wrap. The label follows the six bytes of \"tls13 \" on the wire, so 249",
    "// and 255 are the limits of the encoding. A `length` above the 8160-byte limit",
    "// of HKDF stops the program in `crypto.hkdfExpandSha256` (§6.17).",
    "export byte[] hkdfExpandLabel(byte[] secret, String label, byte[] context, int length) {",
    "    int n = string.length(label);",
    "    if (n < 1 || n > 249) {",
    "        return Error(`label must be 1..249 bytes, have ${n}`,",
    "            ErrorCode.ILLEGAL_PARAMETER);",
    "    }",
    "    if (context.length > 255) {",
    "        return Error(`context must be at most 255 bytes, have ${context.length}`,",
    "            ErrorCode.ILLEGAL_PARAMETER);",
    "    }",
    "    if (length < 1) {",
    "        return Error(`length must be positive, is ${length}`,",
    "            ErrorCode.ILLEGAL_PARAMETER);",
    "    }",
    "    return expandLabel(secret, label, context, length);",
    "}",
    "",
    "// Derive-Secret of RFC 8446. It takes the transcript hash and not the",
    "// messages, so a caller hashes once per flight.",
    "export byte[] deriveSecret(byte[] secret, String label, byte[] transcriptHash) {",
    "    return hkdfExpandLabel(secret, label, transcriptHash, 32);",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// The key schedule (RFC 8446 §7.1)",
    "// ---------------------------------------------------------------------------",
    "",
    "// The schedule is three extractions. Each uses a \"derived\" expansion of the",
    "// previous secret as its salt. The three functions below do the transitions",
    "// and do not export the raw extract, so a caller cannot skip the \"derived\"",
    "// step.",
    "",
    "// Begins the schedule: HKDF-Extract of the pre-shared key, or of 32 zeros when",
    "// there is none. The module has no resumption, so every connection uses the",
    "// zeros.",
    "export byte[] earlySecret(byte[]? psk) {",
    "    byte[] ikm = zeros32();",
    "    byte[]? p = psk;",
    "    if (p != null) {",
    "        ikm = p;",
    "    }",
    "    return crypto.hkdfExtractSha256(EMPTY, ikm);",
    "}",
    "",
    "// Adds the ECDHE shared secret. `shared` comes from",
    "// `crypto.x25519SharedSecret`, which already rejected a small-order point",
    "// (§6.17).",
    "export byte[] handshakeSecret(byte[] early, byte[] shared) {",
    "    return crypto.hkdfExtractSha256(expandLabel(early, \"derived\", EMPTY_HASH, 32), shared);",
    "}",
    "",
    "// Ends the schedule. Application traffic, exporter and resumption secrets are",
    "// derived from this secret, not extracted.",
    "export byte[] masterSecret(byte[] handshake) {",
    "    return crypto.hkdfExtractSha256(expandLabel(handshake, \"derived\", EMPTY_HASH, 32), zeros32());",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Transcript hash (RFC 8446 §4.4.1)",
    "// ---------------------------------------------------------------------------",
    "",
    "// The running hash of every handshake message, header included, in order.",
    "// The messages are kept and hashed when needed, because the HelloRetryRequest",
    "// rewrite (§4.4.1) later replaces the first ClientHello.",
    "export type Transcript {",
    "    String[] parts;",
    "",
    "    // Appends one message as it appears on the wire, from its 4-byte header on.",
    "    // Record framing never enters the transcript.",
    "    void push(byte[] message) {",
    "        array.push(self.parts, string.fromByteArray(message));",
    "    }",
    "",
    "    byte[] hash() {",
    "        return crypto.sha256(string.toByteArray(string.join(self.parts, \"\")));",
    "    }",
    "}",
    "",
    "export Transcript transcript() {",
    "    return { parts: [] };",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Traffic keys (RFC 8446 §7.3) and Finished (§4.4.4)",
    "// ---------------------------------------------------------------------------",
    "",
    "// The record protection material for one direction. The key length depends on",
    "// the AEAD: 32 bytes for ChaCha20-Poly1305, 16 for AES-128-GCM. The IV is 12",
    "// bytes for both.",
    "export type TrafficKeys {",
    "    byte[] key;",
    "    byte[] iv;",
    "}",
    "",
    "// The write key and IV for one direction. Each direction has its own secret,",
    "// its own keys and its own record sequence.",
    "export TrafficKeys trafficKeys(byte[] trafficSecret, int keyLength) {",
    "    return {",
    "        key: expandLabel(trafficSecret, \"key\", EMPTY, keyLength),",
    "        iv: expandLabel(trafficSecret, \"iv\", EMPTY, 12),",
    "    };",
    "}",
    "",
    "// The verify_data of a Finished message (§4.4.4). The receiver computes it",
    "// again and compares with `string.bytesEqualConstantTime`. `==` would leak the",
    "// position of the first difference (§6.17).",
    "export byte[] finishedVerifyData(byte[] trafficSecret, byte[] transcriptHash) {",
    "    byte[] finishedKey = expandLabel(trafficSecret, \"finished\", EMPTY, 32);",
    "    return crypto.hmacSha256(finishedKey, transcriptHash);",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Record framing (RFC 8446 §5.1)",
    "// ---------------------------------------------------------------------------",
    "",
    "// The 5-byte header: type, the frozen legacy version 0x0303, and a two-byte",
    "// length. §5.1 makes a receiver ignore the version field. The first",
    "// ClientHello is the one record that carries 0x0301 (handshakeClient).",
    "byte[] recordHeader(int contentType, int length) {",
    "    return [",
    "        contentType as byte,",
    "        3,",
    "        3,",
    "        (length / 256) as byte,",
    "        (length % 256) as byte,",
    "    ];",
    "}",
    "",
    "// Frames a payload that is sent without protection. A payload over 2^14 bytes",
    "// raises RECORD_OVERFLOW, because §5.1 forbids sending it as well as receiving",
    "// it.",
    "export byte[] plaintextRecord(int contentType, byte[] payload) {",
    "    if (payload.length > MAX_PLAINTEXT) {",
    "        return Error(`record payload of ${payload.length} bytes exceeds ${MAX_PLAINTEXT}`,",
    "            ErrorCode.RECORD_OVERFLOW);",
    "    }",
    "    return cat(recordHeader(contentType, payload.length), payload);",
    "}",
    "",
    "// `length` is what follows the header on the wire. For a protected record it",
    "// includes the tag.",
    "export type RecordHeader {",
    "    int contentType;",
    "    int length;",
    "}",
    "",
    "// Reads the first five bytes of `data`. The length is checked against the",
    "// protected limit, the larger of the two, because the header does not say",
    "// whether the record is protected. `RecordProtection.open` checks again after",
    "// it decrypts.",
    "export RecordHeader parseRecordHeader(byte[] data) {",
    "    if (data.length < 5) {",
    "        return Error(`record header needs 5 bytes, have ${data.length}`,",
    "            ErrorCode.DECODE_ERROR);",
    "    }",
    "    int t = data[0];",
    "    if (t != ContentType.CHANGE_CIPHER_SPEC && t != ContentType.ALERT",
    "        && t != ContentType.HANDSHAKE && t != ContentType.APPLICATION_DATA) {",
    "        return Error(`unknown content type ${t}`, ErrorCode.UNEXPECTED_MESSAGE);",
    "    }",
    "    int len = data[3] * 256 + data[4];",
    "    if (len > MAX_CIPHERTEXT) {",
    "        return Error(`record of ${len} bytes exceeds ${MAX_CIPHERTEXT}`,",
    "            ErrorCode.RECORD_OVERFLOW);",
    "    }",
    "    return { contentType: t, length: len };",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Record protection (RFC 8446 §5.2, §5.3)",
    "// ---------------------------------------------------------------------------",
    "",
    "// The true content type from inside the encryption, and the payload without",
    "// padding.",
    "export type InnerPlaintext {",
    "    int contentType;",
    "    byte[] data;",
    "}",
    "",
    "// A `RecordProtection` covers one direction of one connection, never both. Its",
    "// sequence number starts at zero when the keys are installed, advances by one",
    "// per record, and is never transmitted. A record lost or reordered therefore",
    "// fails authentication.",
    "//",
    "// ChaCha20-Poly1305 is always available. AES-128-GCM is available only where",
    "// the CPU can run it in constant time (§6.17). Thus the suite is a property of",
    "// the connection and not a constant.",
    "export int const TLS_AES_128_GCM_SHA256 = 4865;          // 0x1301",
    "export int const TLS_CHACHA20_POLY1305_SHA256 = 4867;    // 0x1303",
    "",
    "// The suite's AEAD key length. The IV is 12 bytes for both.",
    "int keyLengthFor(int suite) {",
    "    if (suite == TLS_AES_128_GCM_SHA256) {",
    "        return 16;",
    "    }",
    "    return 32;",
    "}",
    "",
    "// The suites that this host supports, in order of preference. AES-128-GCM is",
    "// offered only when `crypto.aesGcmAvailable()`. The server can choose any",
    "// offered suite, and this host must not use a suite that leaks through cache",
    "// timing.",
    "export int[] offeredSuites() {",
    "    int[] out = [TLS_CHACHA20_POLY1305_SHA256];",
    "    if (crypto.aesGcmAvailable()) {",
    "        array.push(out, TLS_AES_128_GCM_SHA256);",
    "    }",
    "    return out;",
    "}",
    "",
    "export type RecordProtection {",
    "    byte[] key;",
    "    byte[] iv;",
    "    int seq;",
    "    int suite;",
    "",
    "    // Protects one record. The header says APPLICATION_DATA for any true",
    "    // content type (§5.2) and is authenticated as additional data. No padding",
    "    // is written. `open` removes padding in either case.",
    "    byte[] seal(int contentType, byte[] payload) {",
    "        if (payload.length > MAX_PLAINTEXT) {",
    "            return Error(`record payload of ${payload.length} bytes exceeds ${MAX_PLAINTEXT}`,",
    "                ErrorCode.RECORD_OVERFLOW);",
    "        }",
    "        byte[] inner = cat(payload, [contentType as byte]);",
    "        byte[] header = recordHeader(ContentType.APPLICATION_DATA, inner.length + 16);",
    "        byte[] nonce = nonceFor(self.iv, self.seq);",
    "        byte[] sealed = [];",
    "        if (self.suite == TLS_AES_128_GCM_SHA256) {",
    "            sealed = crypto.aes128GcmSeal(self.key, nonce, inner, header);",
    "        } else {",
    "            sealed = crypto.chacha20Poly1305Seal(self.key, nonce, inner, header);",
    "        }",
    "        self.seq = self.seq + 1;",
    "        return cat(header, sealed);",
    "    }",
    "",
    "    // Verifies and unwraps one whole record, with its header. A tag that does",
    "    // not verify passes `crypto.ErrorCode.AUTHENTICATION` from the AEAD through",
    "    // (§6.17). All other errors that this function raises are for a frame that",
    "    // is malformed in the clear.",
    "    InnerPlaintext open(byte[] record) {",
    "        RecordHeader h = parseRecordHeader(record);",
    "        if (h.contentType != ContentType.APPLICATION_DATA) {",
    "            return Error(`protected record must claim application_data, claims ${h.contentType}`,",
    "                ErrorCode.UNEXPECTED_MESSAGE);",
    "        }",
    "        if (h.length != record.length - 5) {",
    "            return Error(`record length field says ${h.length}, record carries ${record.length - 5}`,",
    "                ErrorCode.DECODE_ERROR);",
    "        }",
    "        byte[] nonce = nonceFor(self.iv, self.seq);",
    "        byte[] body = array.slice(record, 5);",
    "        byte[] aad = array.slice(record, 0, 5);",
    "        byte[] inner = [];",
    "        if (self.suite == TLS_AES_128_GCM_SHA256) {",
    "            inner = crypto.aes128GcmOpen(self.key, nonce, body, aad);",
    "        } else {",
    "            inner = crypto.chacha20Poly1305Open(self.key, nonce, body, aad);",
    "        }",
    "        self.seq = self.seq + 1;",
    "",
    "        // §5.2 limits the whole TLSInnerPlaintext (content, type byte and",
    "        // padding) to 2^14 + 1. A check on the content only would let a peer",
    "        // hide a message of legal size inside a record with any amount of",
    "        // padding.",
    "        if (inner.length > MAX_PLAINTEXT + 1) {",
    "            return Error(`inner plaintext of ${inner.length} bytes exceeds ${MAX_PLAINTEXT + 1}`,",
    "                ErrorCode.RECORD_OVERFLOW);",
    "        }",
    "",
    "        // The true content type is the last non-zero byte, and all bytes after",
    "        // it are padding (§5.4). A record of all zeros has no type, which is a",
    "        // decode_error.",
    "        int i = inner.length - 1;",
    "        while (i >= 0 && inner[i] == 0) {",
    "            i = i - 1;",
    "        }",
    "        if (i < 0) {",
    "            return Error(\"protected record holds no content type\", ErrorCode.DECODE_ERROR);",
    "        }",
    "        if (i > MAX_PLAINTEXT) {",
    "            return Error(`inner plaintext of ${i} bytes exceeds ${MAX_PLAINTEXT}`,",
    "                ErrorCode.RECORD_OVERFLOW);",
    "        }",
    "        int t = inner[i];",
    "        // A protected CHANGE_CIPHER_SPEC, or any type the protocol does not",
    "        // name, gets unexpected_message (§5).",
    "        if (t != ContentType.ALERT && t != ContentType.HANDSHAKE",
    "            && t != ContentType.APPLICATION_DATA) {",
    "            return Error(`protected record carries content type ${t}`,",
    "                ErrorCode.UNEXPECTED_MESSAGE);",
    "        }",
    "        return { contentType: t, data: array.slice(inner, 0, i) };",
    "    }",
    "}",
    "",
    "// Makes the state for one direction from its traffic secret. A caller holds",
    "// two, one for each direction, and each has its own sequence.",
    "export RecordProtection protectionKeys(byte[] trafficSecret, int suite) {",
    "    TrafficKeys tk = trafficKeys(trafficSecret, keyLengthFor(suite));",
    "    return { key: tk.key, iv: tk.iv, seq: 0, suite: suite };",
    "}",
    "",
    "// The per-record nonce of §5.3: the 64-bit sequence number, big endian, padded",
    "// on the left to the 12 bytes of the IV and XORed into it. While the sequence",
    "// increases, no nonce is used twice, as §6.17 requires.",
    "byte[] nonceFor(byte[] iv, int seq) {",
    "    byte[] nonce = array.slice(iv, 0);",
    "    int i = 0;",
    "    while (i < 8) {",
    "        int b = nonce[4 + i];",
    "        int s = (seq >> (8 * (7 - i))) & 255;",
    "        nonce[4 + i] = (b ^ s) as byte;",
    "        i++;",
    "    }",
    "    return nonce;",
    "}",
    "",
    "// ===========================================================================",
    "// The handshake (RFC 8446 §4)",
    "// ===========================================================================",
    "//",
    "// The parser is the attack surface. Every read of an incoming byte goes through",
    "// `Reader`, which raises DECODE_ERROR and does not index past the end. An",
    "// out-of-range index is a runtime error (§5.5), and in a network parser that is",
    "// a denial of service. No code below indexes a received array directly.",
    "//",
    "// The state machine takes one message at a time and refuses all messages",
    "// except the next one that the protocol names.",
    "//",
    "// `checkPeer` builds the chain and checks the CertificateVerify together.",
    "// Certificates are public, so a chain check alone authenticates nobody.",
    "// `Options.insecureSkipVerify` turns off both checks or neither.",
    "",
    "// Handshake message types (§4).",
    "export enum HandshakeType {",
    "    CLIENT_HELLO: 1,",
    "    SERVER_HELLO: 2,",
    "    NEW_SESSION_TICKET: 4,",
    "    ENCRYPTED_EXTENSIONS: 8,",
    "    CERTIFICATE: 11,",
    "    CERTIFICATE_REQUEST: 13,",
    "    CERTIFICATE_VERIFY: 15,",
    "    FINISHED: 20,",
    "    KEY_UPDATE: 24",
    "}",
    "",
    "// The extensions that this client sends or reads, with their IANA numbers.",
    "int const EXT_SERVER_NAME = 0;",
    "int const EXT_SUPPORTED_GROUPS = 10;",
    "int const EXT_SIGNATURE_ALGORITHMS = 13;",
    "int const EXT_ALPN = 16;",
    "int const EXT_SUPPORTED_VERSIONS = 43;",
    "int const EXT_KEY_SHARE = 51;",
    "",
    "// The only group that this client supports. A server can choose only from what",
    "// was offered, so any other group is refused.",
    "int const GROUP_X25519 = 29;      // 0x001d",
    "int const VERSION_TLS12 = 771;    // 0x0303, the frozen legacy value",
    "int const VERSION_TLS13 = 772;    // 0x0304, what supported_versions says",
    "",
    "// The signature schemes offered in signature_algorithms. The list holds only",
    "// the schemes that this client can verify.",
    "//",
    "// The PKCS#1 v1.5 pair is offered but is not accepted in a CertificateVerify,",
    "// because RFC 8446 §4.4.3 forbids it. It is in the list because the extension",
    "// also names what a client accepts in the certificate chain, where most CAs",
    "// sign with PKCS#1 v1.5.",
    "int const SIG_ECDSA_SECP256R1_SHA256 = 1027;    // 0x0403",
    "int const SIG_RSA_PSS_RSAE_SHA256 = 2052;       // 0x0804",
    "int const SIG_RSA_PSS_RSAE_SHA384 = 2053;       // 0x0805",
    "int const SIG_ECDSA_SECP384R1_SHA384 = 1283;    // 0x0503",
    "int const SIG_RSA_PKCS1_SHA256 = 1025;          // 0x0401",
    "int const SIG_RSA_PKCS1_SHA384 = 1281;          // 0x0501",
    "",
    "// A HelloRetryRequest is a ServerHello whose random is this fixed value",
    "// (§4.1.3). This client offers only x25519, so it cannot retry and reports a",
    "// handshake failure.",
    "String const HELLO_RETRY_RANDOM =",
    "    \"cf21ad74e59a6111be1d8c021e65b891c2a21167abb8c5e079e09e2c8a8339c2\";",
    "",
    "// The maximum size of a handshake message. The length field of RFC 8446 is 24",
    "// bits, but a peer that declares 16 MB is broken or hostile.",
    "int const MAX_HANDSHAKE = 262144;",
    "",
    "// Each message that a peer can send without limit and at no cost has a",
    "// counter. RFC 8446 sets no limit for them, so the receiver sets one.",
    "// change_cipher_spec records carry nothing (§D.4).",
    "int const MAX_CCS = 8;",
    "",
    "// A record with an empty plaintext is legal padding, so the first one cannot be",
    "// refused. A series of them makes this end decrypt forever with no progress.",
    "// The counter resets on any record that is not empty.",
    "int const MAX_EMPTY_RECORDS = 32;",
    "",
    "// A KeyUpdate costs the receiver a key schedule step, and a reply when the",
    "// peer asks for one. A peer changes keys after a number of bytes or records,",
    "// not in a burst.",
    "int const MAX_KEY_UPDATES = 32;",
    "",
    "// TLS 1.3 removed warning alerts except `user_canceled`, which JDK11 sends as a",
    "// full-duplex signal. This end ignores it and counts it.",
    "int const MAX_USER_CANCELED = 4;",
    "int const ALERT_USER_CANCELED = 90;",
    "",
    "// The number of bytes to read from the transport at one time. The 8184-byte",
    "// size class of the collector holds a header plus this payload. With 8192, the",
    "// block would use the next, larger cell.",
    "int const READ_CHUNK = 8128;",
    "",
    "// ---------------------------------------------------------------------------",
    "// Reading the wire format",
    "// ---------------------------------------------------------------------------",
    "",
    "// A bounds-checked cursor over received bytes. Every accessor raises",
    "// DECODE_ERROR and does not read past the end. Received bytes are read through",
    "// this type and never indexed directly.",
    "export type Reader {",
    "    byte[] data;",
    "    int pos;",
    "",
    "    int left() {",
    "        return self.data.length - self.pos;",
    "    }",
    "",
    "    bool done() {",
    "        return self.pos >= self.data.length;",
    "    }",
    "",
    "    int u8() {",
    "        if (self.left() < 1) {",
    "            return Error(`truncated: wanted 1 byte, ${self.left()} left`,",
    "                ErrorCode.DECODE_ERROR);",
    "        }",
    "        int v = self.data[self.pos];",
    "        self.pos = self.pos + 1;",
    "        return v;",
    "    }",
    "",
    "    int u16() {",
    "        if (self.left() < 2) {",
    "            return Error(`truncated: wanted 2 bytes, ${self.left()} left`,",
    "                ErrorCode.DECODE_ERROR);",
    "        }",
    "        int v = self.data[self.pos] * 256 + self.data[self.pos + 1];",
    "        self.pos = self.pos + 2;",
    "        return v;",
    "    }",
    "",
    "    int u24() {",
    "        if (self.left() < 3) {",
    "            return Error(`truncated: wanted 3 bytes, ${self.left()} left`,",
    "                ErrorCode.DECODE_ERROR);",
    "        }",
    "        int v = self.data[self.pos] * 65536 + self.data[self.pos + 1] * 256 + self.data[self.pos + 2];",
    "        self.pos = self.pos + 3;",
    "        return v;",
    "    }",
    "",
    "    byte[] take(int n) {",
    "        if (n < 0 || self.left() < n) {",
    "            return Error(`truncated: wanted ${n} bytes, ${self.left()} left`,",
    "                ErrorCode.DECODE_ERROR);",
    "        }",
    "        byte[] out = array.slice(self.data, self.pos, self.pos + n);",
    "        self.pos = self.pos + n;",
    "        return out;",
    "    }",
    "",
    "    // A length-prefixed vector, the form of every variable-length TLS field.",
    "    byte[] vector8() {",
    "        return self.take(self.u8());",
    "    }",
    "",
    "    byte[] vector16() {",
    "        return self.take(self.u16());",
    "    }",
    "",
    "    byte[] vector24() {",
    "        return self.take(self.u24());",
    "    }",
    "",
    "    // A Reader over the contents of a vector. A nested structure gets its own",
    "    // cursor, so an inner length cannot reach past the outer one.",
    "    Reader sub(byte[] body) {",
    "        return { data: body, pos: 0 };",
    "    }",
    "}",
    "",
    "export Reader reader(byte[] data) {",
    "    return { data: data, pos: 0 };",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Writing the wire format",
    "// ---------------------------------------------------------------------------",
    "",
    "// The opposite of Reader. Lengths are written after the body: `open16` writes a",
    "// placeholder and returns a mark, and `close16` fills in the length of what was",
    "// written since. Each `close` checks the length, so no message that this module",
    "// sends can overflow a length field.",
    "export type Writer {",
    "    byte[] out;",
    "",
    "    void u8(int v) {",
    "        array.push(self.out, (v & 255) as byte);",
    "    }",
    "",
    "    void u16(int v) {",
    "        array.push(self.out, ((v >> 8) & 255) as byte);",
    "        array.push(self.out, (v & 255) as byte);",
    "    }",
    "",
    "    void u24(int v) {",
    "        array.push(self.out, ((v >> 16) & 255) as byte);",
    "        array.push(self.out, ((v >> 8) & 255) as byte);",
    "        array.push(self.out, (v & 255) as byte);",
    "    }",
    "",
    "    void raw(byte[] b) {",
    "        forEach(b, x) {",
    "            array.push(self.out, x);",
    "        }",
    "    }",
    "",
    "    int open8() {",
    "        array.push(self.out, 0);",
    "        return self.out.length;",
    "    }",
    "",
    "    void close8(int mark) {",
    "        int n = self.out.length - mark;",
    "        if (n > 255) {",
    "            return Error(`vector of ${n} bytes needs more than one length byte`,",
    "                ErrorCode.ILLEGAL_PARAMETER);",
    "        }",
    "        self.out[mark - 1] = n as byte;",
    "    }",
    "",
    "    int open16() {",
    "        array.push(self.out, 0);",
    "        array.push(self.out, 0);",
    "        return self.out.length;",
    "    }",
    "",
    "    void close16(int mark) {",
    "        int n = self.out.length - mark;",
    "        if (n > 65535) {",
    "            return Error(`vector of ${n} bytes overflows a 16-bit length`,",
    "                ErrorCode.ILLEGAL_PARAMETER);",
    "        }",
    "        self.out[mark - 2] = ((n >> 8) & 255) as byte;",
    "        self.out[mark - 1] = (n & 255) as byte;",
    "    }",
    "",
    "    int open24() {",
    "        array.push(self.out, 0);",
    "        array.push(self.out, 0);",
    "        array.push(self.out, 0);",
    "        return self.out.length;",
    "    }",
    "",
    "    void close24(int mark) {",
    "        int n = self.out.length - mark;",
    "        self.out[mark - 3] = ((n >> 16) & 255) as byte;",
    "        self.out[mark - 2] = ((n >> 8) & 255) as byte;",
    "        self.out[mark - 1] = (n & 255) as byte;",
    "    }",
    "}",
    "",
    "export Writer writer() {",
    "    return { out: [] };",
    "}",
    "",
    "// Wraps a body in its 4-byte header. The transcript and the wire both use this",
    "// form.",
    "export byte[] handshakeMessage(int msgType, byte[] body) {",
    "    Writer w = writer();",
    "    w.u8(msgType);",
    "    w.u24(body.length);",
    "    w.raw(body);",
    "    return w.out;",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Extensions",
    "// ---------------------------------------------------------------------------",
    "",
    "// Reads an extension block into a map from type to body. A repeated extension",
    "// is refused (§4.2), because with two copies a peer could choose which copy",
    "// each reader keeps.",
    "export Map<int, byte[]> parseExtensions(byte[] block) {",
    "    Map<int, byte[]> out = {};",
    "    Reader r = reader(block);",
    "    while (!r.done()) {",
    "        int t = r.u16();",
    "        byte[] ext = r.vector16();",
    "        if (out[t] != null) {",
    "            // §4.2 names no alert for this. The defect is in the framing and not",
    "            // in the value of a field, so the alert is decode_error.",
    "            return Error(`extension ${t} appears twice`,",
    "                ErrorCode.DECODE_ERROR);",
    "        }",
    "        out[t] = ext;",
    "    }",
    "    return out;",
    "}",
    "",
    "// RFC 8446 §4.2: a server extension that the ClientHello did not offer is",
    "// fatal, and the alert is unsupported_extension.",
    "//",
    "// `allowed` is the set for the message being read. Every caller builds it from",
    "// the ClientHello that was sent, and the set is different for each message",
    "// kind.",
    "void checkSolicited(Map<int, byte[]> exts, int[] allowed, String where) {",
    "    forEach(map.keys(exts), t) {",
    "        if (array.indexOf(allowed, t) < 0) {",
    "            return Error(\"server sent extension \" + string.from(t) + \" in the \"",
    "                + where + \", which this client did not offer\",",
    "                ErrorCode.UNSUPPORTED_EXTENSION);",
    "        }",
    "    }",
    "}",
    "",
    "void writeExtension(Writer w, int t, byte[] body) {",
    "    w.u16(t);",
    "    w.u16(body.length);",
    "    w.raw(body);",
    "}",
    "",
    "// SNI (RFC 6066): a list that holds one host_name. An IP address is not a",
    "// legal SNI value, so the caller does not send it.",
    "byte[] serverNameExtension(String host) {",
    "    Writer w = writer();",
    "    int list = w.open16();",
    "    w.u8(0);    // NameType.host_name",
    "    int name = w.open16();",
    "    w.raw(string.toByteArray(host));",
    "    w.close16(name);",
    "    w.close16(list);",
    "    return w.out;",
    "}",
    "",
    "byte[] supportedVersionsClient() {",
    "    Writer w = writer();",
    "    int list = w.open8();",
    "    w.u16(VERSION_TLS13);",
    "    w.close8(list);",
    "    return w.out;",
    "}",
    "",
    "byte[] supportedGroupsExtension() {",
    "    Writer w = writer();",
    "    int list = w.open16();",
    "    w.u16(GROUP_X25519);",
    "    w.close16(list);",
    "    return w.out;",
    "}",
    "",
    "byte[] signatureAlgorithmsExtension() {",
    "    Writer w = writer();",
    "    int list = w.open16();",
    "    w.u16(SIG_ECDSA_SECP256R1_SHA256);",
    "    w.u16(SIG_RSA_PSS_RSAE_SHA256);",
    "    w.u16(SIG_ECDSA_SECP384R1_SHA384);",
    "    w.u16(SIG_RSA_PSS_RSAE_SHA384);",
    "    w.u16(SIG_RSA_PKCS1_SHA256);",
    "    w.u16(SIG_RSA_PKCS1_SHA384);",
    "    w.close16(list);",
    "    return w.out;",
    "}",
    "",
    "byte[] keyShareClient(byte[] publicKey) {",
    "    Writer w = writer();",
    "    int list = w.open16();",
    "    w.u16(GROUP_X25519);",
    "    int share = w.open16();",
    "    w.raw(publicKey);",
    "    w.close16(share);",
    "    w.close16(list);",
    "    return w.out;",
    "}",
    "",
    "byte[] keyShareServer(byte[] publicKey) {",
    "    Writer w = writer();",
    "    w.u16(GROUP_X25519);",
    "    int share = w.open16();",
    "    w.raw(publicKey);",
    "    w.close16(share);",
    "    return w.out;",
    "}",
    "",
    "byte[] alpnExtension(String[] protocols) {",
    "    Writer w = writer();",
    "    int list = w.open16();",
    "    forEach(protocols, p) {",
    "        int one = w.open8();",
    "        w.raw(string.toByteArray(p));",
    "        w.close8(one);",
    "    }",
    "    w.close16(list);",
    "    return w.out;",
    "}",
    "",
    "// Reads the protocol that a server selected. RFC 7301 §4.2.1 requires a",
    "// list of exactly one name.",
    "String parseAlpn(byte[] body) {",
    "    Reader r = reader(body);",
    "    Reader list = r.sub(r.vector16());",
    "    byte[] name = list.vector8();",
    "    if (!list.done()) {",
    "        return Error(\"server selected more than one ALPN protocol\",",
    "            ErrorCode.ILLEGAL_PARAMETER);",
    "    }",
    "    if (name.length == 0) {",
    "        return Error(\"server selected an empty ALPN protocol\", ErrorCode.ILLEGAL_PARAMETER);",
    "    }",
    "    return string.fromByteArray(name);",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// ClientHello and ServerHello",
    "// ---------------------------------------------------------------------------",
    "",
    "export type ClientHello {",
    "    byte[] random;",
    "    byte[] sessionId;",
    "    int[] cipherSuites;",
    "    byte[] keyShare;    // the x25519 share, empty if none was offered",
    "    String[] alpn;",
    "    String serverName;",
    "}",
    "",
    "export type ServerHello {",
    "    byte[] random;",
    "    byte[] sessionId;",
    "    int cipherSuite;",
    "    byte[] keyShare;",
    "    bool helloRetryRequest;",
    "}",
    "",
    "// SNI holds a host name, never an address literal, which RFC 6066 §3 forbids.",
    "// Both the message writer and the check on the reply call this function, so",
    "// the offer and the solicited set always agree.",
    "bool sendsServerName(String serverName) {",
    "    return string.length(serverName) > 0 && !looksNumeric(serverName);",
    "}",
    "",
    "// Writes the ClientHello that this client sends. §4.1.2 fixes the legacy",
    "// fields: version 0x0303, a 32-byte session id, and one null compression",
    "// method. The real version is in supported_versions.",
    "export byte[] buildClientHello(byte[] random, byte[] sessionId, byte[] publicKey,",
    "    String serverName, String[] alpn) {",
    "    Writer w = writer();",
    "    w.u16(VERSION_TLS12);",
    "    w.raw(random);",
    "    int sid = w.open8();",
    "    w.raw(sessionId);",
    "    w.close8(sid);",
    "",
    "    int suites = w.open16();",
    "    forEach(offeredSuites(), s) {",
    "        w.u16(s);",
    "    }",
    "    w.close16(suites);",
    "",
    "    int comp = w.open8();",
    "    w.u8(0);",
    "    w.close8(comp);",
    "",
    "    int exts = w.open16();",
    "    if (sendsServerName(serverName)) {",
    "        writeExtension(w, EXT_SERVER_NAME, serverNameExtension(serverName));",
    "    }",
    "    writeExtension(w, EXT_SUPPORTED_GROUPS, supportedGroupsExtension());",
    "    writeExtension(w, EXT_SIGNATURE_ALGORITHMS, signatureAlgorithmsExtension());",
    "    writeExtension(w, EXT_SUPPORTED_VERSIONS, supportedVersionsClient());",
    "    writeExtension(w, EXT_KEY_SHARE, keyShareClient(publicKey));",
    "    if (alpn.length > 0) {",
    "        writeExtension(w, EXT_ALPN, alpnExtension(alpn));",
    "    }",
    "    w.close16(exts);",
    "",
    "    return handshakeMessage(HandshakeType.CLIENT_HELLO, w.out);",
    "}",
    "",
    "// True for an IPv4 address or an IPv6 literal. It does not parse the address,",
    "// because a name that could be an address must not be sent as a host.",
    "bool looksNumeric(String host) {",
    "    if (string.contains(host, \":\")) { return true; }",
    "    String[] parts = string.split(host, \".\");",
    "    if (parts.length != 4) { return false; }",
    "    forEach(parts, p) {",
    "        int v = string.toInt(p) catch -1;",
    "        if (v < 0 || v > 255) { return false; }",
    "    }",
    "    return true;",
    "}",
    "",
    "// Reads a ClientHello body, the message without its 4-byte header.",
    "export ClientHello parseClientHello(byte[] body) {",
    "    Reader r = reader(body);",
    "    int version = r.u16();",
    "    if (version != VERSION_TLS12) {",
    "        return Error(`ClientHello legacy_version is ${version}, not 0x0303`,",
    "            ErrorCode.ILLEGAL_PARAMETER);",
    "    }",
    "    byte[] random = r.take(32);",
    "    byte[] sessionId = r.vector8();",
    "",
    "    Reader suites = r.sub(r.vector16());",
    "    int[] offered = [];",
    "    while (!suites.done()) {",
    "        array.push(offered, suites.u16());",
    "    }",
    "    byte[] comp = r.vector8();",
    "    if (comp.length != 1 || comp[0] != 0) {",
    "        return Error(\"ClientHello offers a compression method\", ErrorCode.ILLEGAL_PARAMETER);",
    "    }",
    "",
    "    Map<int, byte[]> exts = parseExtensions(r.vector16());",
    "    byte[] share = string.toByteArray(\"\");",
    "    byte[]? ks = exts[EXT_KEY_SHARE];",
    "    if (ks != null) {",
    "        Reader kr = reader(ks);",
    "        Reader list = kr.sub(kr.vector16());",
    "        while (!list.done()) {",
    "            int group = list.u16();",
    "            byte[] key = list.vector16();",
    "            if (group == GROUP_X25519) {",
    "                share = key;",
    "            }",
    "        }",
    "    }",
    "",
    "    String[] names = [];",
    "    byte[]? ap = exts[EXT_ALPN];",
    "    if (ap != null) {",
    "        Reader ar = reader(ap);",
    "        Reader list = ar.sub(ar.vector16());",
    "        while (!list.done()) {",
    "            array.push(names, string.fromByteArray(list.vector8()));",
    "        }",
    "    }",
    "",
    "    String host = \"\";",
    "    byte[]? sni = exts[EXT_SERVER_NAME];",
    "    if (sni != null) {",
    "        Reader sr = reader(sni);",
    "        Reader list = sr.sub(sr.vector16());",
    "        while (!list.done()) {",
    "            int nameType = list.u8();",
    "            byte[] name = list.vector16();",
    "            if (nameType == 0) {",
    "                host = string.fromByteArray(name);",
    "            }",
    "        }",
    "    }",
    "",
    "    return {",
    "        random: random,",
    "        sessionId: sessionId,",
    "        cipherSuites: offered,",
    "        keyShare: share,",
    "        alpn: names,",
    "        serverName: host,",
    "    };",
    "}",
    "",
    "// Reads a ServerHello body and does all the checks that §4.1.3 requires of a",
    "// receiver. A server can choose only from what was offered, so a group that",
    "// was not offered is refused here.",
    "export ServerHello parseServerHello(byte[] body) {",
    "    Reader r = reader(body);",
    "    int version = r.u16();",
    "    if (version != VERSION_TLS12) {",
    "        return Error(`ServerHello legacy_version is ${version}, not 0x0303`,",
    "            ErrorCode.ILLEGAL_PARAMETER);",
    "    }",
    "    byte[] random = r.take(32);",
    "    bool hrr = crypto.hexEncode(random) == HELLO_RETRY_RANDOM;",
    "    byte[] sessionId = r.vector8();",
    "    int suite = r.u16();",
    "    int comp = r.u8();",
    "    if (comp != 0) {",
    "        return Error(\"ServerHello selects a compression method\", ErrorCode.ILLEGAL_PARAMETER);",
    "    }",
    "",
    "    Map<int, byte[]> exts = parseExtensions(r.vector16());",
    "",
    "    // §4.1.3 lets a ServerHello carry only the two extensions that make it a",
    "    // TLS 1.3 ServerHello, plus pre_shared_key, which this client never offers.",
    "    // Any other extension would be a negotiated value that no key protects.",
    "    checkSolicited(exts, [EXT_SUPPORTED_VERSIONS, EXT_KEY_SHARE], \"ServerHello\");",
    "",
    "    // supported_versions makes this TLS 1.3. This client supports one version",
    "    // and never negotiates a lower one.",
    "    byte[]? sv = exts[EXT_SUPPORTED_VERSIONS];",
    "    if (sv == null) {",
    "        return Error(\"ServerHello has no supported_versions: the peer is not TLS 1.3\",",
    "            ErrorCode.ILLEGAL_PARAMETER);",
    "    }",
    "    Reader svr = reader(sv);",
    "    int chosen = svr.u16();",
    "    if (chosen != VERSION_TLS13) {",
    "        return Error(`server selected version ${chosen}, not TLS 1.3`,",
    "            ErrorCode.ILLEGAL_PARAMETER);",
    "    }",
    "",
    "    byte[] share = string.toByteArray(\"\");",
    "    byte[]? ks = exts[EXT_KEY_SHARE];",
    "    if (ks != null && !hrr) {",
    "        Reader kr = reader(ks);",
    "        int group = kr.u16();",
    "        if (group != GROUP_X25519) {",
    "            return Error(`server chose group ${group}, which was not offered`,",
    "                ErrorCode.ILLEGAL_PARAMETER);",
    "        }",
    "        share = kr.vector16();",
    "    }",
    "",
    "    // §4.1.3 ends the ServerHello at its extension block. The check for",
    "    // trailing bytes is here. Otherwise the transcript finds them three",
    "    // messages later as a decryption failure.",
    "    if (!r.done()) {",
    "        return Error(\"trailing bytes after the ServerHello\", ErrorCode.DECODE_ERROR);",
    "    }",
    "",
    "    return {",
    "        random: random,",
    "        sessionId: sessionId,",
    "        cipherSuite: suite,",
    "        keyShare: share,",
    "        helloRetryRequest: hrr,",
    "    };",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Certificate, CertificateVerify, Finished",
    "// ---------------------------------------------------------------------------",
    "",
    "// The chain, end-entity certificate first, as the DER of each entry. This",
    "// function does not read inside a certificate. `x509` does that.",
    "export byte[][] parseCertificate(byte[] body) {",
    "    Reader r = reader(body);",
    "    byte[] context = r.vector8();",
    "    if (context.length != 0) {",
    "        return Error(\"server sent a certificate_request_context\", ErrorCode.ILLEGAL_PARAMETER);",
    "    }",
    "    Reader list = r.sub(r.vector24());",
    "    byte[][] chain = [];",
    "    while (!list.done()) {",
    "        byte[] der = list.vector24();",
    "        if (der.length == 0) {",
    "            return Error(\"certificate entry is empty\", ErrorCode.ILLEGAL_PARAMETER);",
    "        }",
    "        array.push(chain, der);",
    "        // §4.4.2 gives every certificate entry its own extension block, and",
    "        // the rule of §4.2 applies to it. This client asks for neither",
    "        // status_request nor signed_certificate_timestamp, so the block must be",
    "        // empty.",
    "        checkSolicited(parseExtensions(list.vector16()), [], \"Certificate\");",
    "    }",
    "    if (chain.length == 0) {",
    "        return Error(\"server sent an empty certificate chain\", ErrorCode.ILLEGAL_PARAMETER);",
    "    }",
    "    if (!r.done()) {",
    "        return Error(\"trailing bytes after the Certificate\", ErrorCode.DECODE_ERROR);",
    "    }",
    "    return chain;",
    "}",
    "",
    "// The \"no certificate\" reply of §4.4.2: the certificate_request_context sent",
    "// back, and a zero-length certificate list.",
    "byte[] emptyCertificateBody(byte[] context) {",
    "    Writer w = writer();",
    "    int c = w.open8();",
    "    w.raw(context);",
    "    w.close8(c);",
    "    int list = w.open24();",
    "    w.close24(list);",
    "    return w.out;",
    "}",
    "",
    "// Validates the structure of §4.6.1 and keeps nothing. This client does not",
    "// resume, but it must still check the frame of a message that it ignores.",
    "void checkNewSessionTicket(byte[] body) {",
    "    Reader r = reader(body);",
    "    r.u16();        // ticket_lifetime, high half",
    "    r.u16();        // ticket_lifetime, low half",
    "    r.u16();        // ticket_age_add, high half",
    "    r.u16();        // ticket_age_add, low half",
    "    r.vector8();    // ticket_nonce",
    "    byte[] ticket = r.vector16();",
    "    if (ticket.length == 0) {",
    "        return Error(\"NewSessionTicket carries an empty ticket\", ErrorCode.DECODE_ERROR);",
    "    }",
    "    parseExtensions(r.vector16());",
    "    if (!r.done()) {",
    "        return Error(\"trailing bytes after NewSessionTicket\", ErrorCode.DECODE_ERROR);",
    "    }",
    "}",
    "",
    "// The signature is kept here and not checked. `checkPeer` does the check.",
    "export type CertificateVerify {",
    "    int algorithm;",
    "    byte[] signature;",
    "}",
    "",
    "export CertificateVerify parseCertificateVerify(byte[] body) {",
    "    Reader r = reader(body);",
    "    int alg = r.u16();",
    "    byte[] sig = r.vector16();",
    "    if (!r.done()) {",
    "        return Error(\"trailing bytes after CertificateVerify\", ErrorCode.DECODE_ERROR);",
    "    }",
    "    return { algorithm: alg, signature: sig };",
    "}",
    "",
    "// The content that a CertificateVerify signs (§4.4.3): 64 spaces, a context",
    "// string, a zero byte, and the transcript hash. The 64 spaces prevent the",
    "// replay of a signature made for one purpose as a signature for another.",
    "export byte[] certificateVerifyContent(String context, byte[] transcriptHash) {",
    "    Writer w = writer();",
    "    int i = 0;",
    "    while (i < 64) {",
    "        w.u8(32);",
    "        i++;",
    "    }",
    "    w.raw(string.toByteArray(context));",
    "    w.u8(0);",
    "    w.raw(transcriptHash);",
    "    return w.out;",
    "}",
    "",
    "String const SERVER_CV_CONTEXT = \"TLS 1.3, server CertificateVerify\";",
    "",
    "// ---------------------------------------------------------------------------",
    "// Alerts (RFC 8446 §6)",
    "// ---------------------------------------------------------------------------",
    "",
    "int const ALERT_WARNING = 1;",
    "int const ALERT_FATAL = 2;",
    "",
    "int const ALERT_CLOSE_NOTIFY = 0;",
    "int const ALERT_UNEXPECTED_MESSAGE = 10;",
    "int const ALERT_BAD_RECORD_MAC = 20;",
    "int const ALERT_RECORD_OVERFLOW = 22;",
    "int const ALERT_HANDSHAKE_FAILURE = 40;",
    "int const ALERT_BAD_CERTIFICATE = 42;",
    "int const ALERT_UNSUPPORTED_CERTIFICATE = 43;",
    "int const ALERT_CERTIFICATE_EXPIRED = 45;",
    "int const ALERT_UNKNOWN_CA = 48;",
    "int const ALERT_ILLEGAL_PARAMETER = 47;",
    "int const ALERT_DECODE_ERROR = 50;",
    "int const ALERT_DECRYPT_ERROR = 51;",
    "int const ALERT_INTERNAL_ERROR = 80;",
    "int const ALERT_UNSUPPORTED_EXTENSION = 110;",
    "",
    "// The alert that this end sends when it stops for this reason. It is one",
    "// function, so a new code cannot become internal_error at some call sites",
    "// without notice.",
    "export int alertFor(int code) {",
    "    if (code == ErrorCode.ILLEGAL_PARAMETER) { return ALERT_ILLEGAL_PARAMETER; }",
    "    if (code == ErrorCode.DECODE_ERROR) { return ALERT_DECODE_ERROR; }",
    "    if (code == ErrorCode.RECORD_OVERFLOW) { return ALERT_RECORD_OVERFLOW; }",
    "    if (code == ErrorCode.UNEXPECTED_MESSAGE) { return ALERT_UNEXPECTED_MESSAGE; }",
    "    if (code == ErrorCode.HANDSHAKE_FAILURE) { return ALERT_HANDSHAKE_FAILURE; }",
    "    if (code == ErrorCode.DECRYPT_ERROR) { return ALERT_DECRYPT_ERROR; }",
    "    if (code == ErrorCode.UNSUPPORTED_CERTIFICATE) { return ALERT_UNSUPPORTED_CERTIFICATE; }",
    "    if (code == ErrorCode.UNSUPPORTED_EXTENSION) { return ALERT_UNSUPPORTED_EXTENSION; }",
    "    // §6.2 uses unexpected_message for a message that is not permitted in that",
    "    // quantity or at that point. Every counter in this file refuses that.",
    "    if (code == ErrorCode.TOO_MANY_MESSAGES) { return ALERT_UNEXPECTED_MESSAGE; }",
    "    // The certificate of the peer is valid but is not one that this end",
    "    // accepts.",
    "    if (code == ErrorCode.PIN_MISMATCH) { return ALERT_BAD_CERTIFICATE; }",
    "    if (code == crypto.ErrorCode.AUTHENTICATION) { return ALERT_BAD_RECORD_MAC; }",
    "    // The codes of x509 arrive here unchanged, so a caller that catches a",
    "    // failed `connect` sees \"expired\" or \"wrong hostname\", not one general",
    "    // error.",
    "    if (code == x509.ErrorCode.EXPIRED) { return ALERT_CERTIFICATE_EXPIRED; }",
    "    if (code == x509.ErrorCode.NOT_YET_VALID) { return ALERT_CERTIFICATE_EXPIRED; }",
    "    if (code == x509.ErrorCode.UNTRUSTED_ROOT) { return ALERT_UNKNOWN_CA; }",
    "    if (code == x509.ErrorCode.HOSTNAME_MISMATCH) { return ALERT_BAD_CERTIFICATE; }",
    "    if (code == x509.ErrorCode.BAD_CERTIFICATE) { return ALERT_BAD_CERTIFICATE; }",
    "    if (code == x509.ErrorCode.BAD_SIGNATURE) { return ALERT_DECRYPT_ERROR; }",
    "    if (code == x509.ErrorCode.CONSTRAINT_VIOLATION) { return ALERT_BAD_CERTIFICATE; }",
    "    if (code == x509.ErrorCode.UNSUPPORTED_ALGORITHM) { return ALERT_UNSUPPORTED_CERTIFICATE; }",
    "    return ALERT_INTERNAL_ERROR;",
    "}",
    "",
    "// The name of a received alert, for the error message. An alert without a name",
    "// is written as its number.",
    "String alertName(int description) {",
    "    if (description == 0) { return \"close_notify\"; }",
    "    if (description == 10) { return \"unexpected_message\"; }",
    "    if (description == 20) { return \"bad_record_mac\"; }",
    "    if (description == 22) { return \"record_overflow\"; }",
    "    if (description == 30) { return \"decompression_failure\"; }",
    "    if (description == 40) { return \"handshake_failure\"; }",
    "    if (description == 42) { return \"bad_certificate\"; }",
    "    if (description == 43) { return \"unsupported_certificate\"; }",
    "    if (description == 44) { return \"certificate_revoked\"; }",
    "    if (description == 45) { return \"certificate_expired\"; }",
    "    if (description == 46) { return \"certificate_unknown\"; }",
    "    if (description == 47) { return \"illegal_parameter\"; }",
    "    if (description == 48) { return \"unknown_ca\"; }",
    "    if (description == 49) { return \"access_denied\"; }",
    "    if (description == 50) { return \"decode_error\"; }",
    "    if (description == 51) { return \"decrypt_error\"; }",
    "    if (description == 70) { return \"protocol_version\"; }",
    "    if (description == 71) { return \"insufficient_security\"; }",
    "    if (description == 80) { return \"internal_error\"; }",
    "    if (description == 109) { return \"missing_extension\"; }",
    "    if (description == 110) { return \"unsupported_extension\"; }",
    "    if (description == 112) { return \"unrecognized_name\"; }",
    "    if (description == 120) { return \"no_application_protocol\"; }",
    "    return \"alert \" + string.from(description);",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Transport: the byte stream under the record layer",
    "// ---------------------------------------------------------------------------",
    "",
    "// A byte stream as a record of closures, because built-ins are not first-class",
    "// values (§3.4). All code below reads and writes through these three closures",
    "// and never uses `net`, so this file owns no socket.",
    "export type Transport {",
    "    Function(int)<Future<byte[]!>> read;",
    "    Function(byte[])<Future<void!>> write;",
    "    Function()<void> close;",
    "}",
    "",
    "export Transport socketTransport(Socket s, Duration? timeout) {",
    "    return {",
    "        read: Future<byte[]!> (int n) -> net.read(s, n, { timeout: timeout }),",
    "        write: Future<void!> (byte[] b) -> net.write(s, b, { timeout: timeout }),",
    "        close: void () -> net.close(s),",
    "    };",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Framer: records in, handshake messages and application data out",
    "// ---------------------------------------------------------------------------",
    "",
    "// The read half of a connection. It has three buffers, because a record and a",
    "// message are independent units. Bytes arrive in the sizes that the network",
    "// chooses (`buf`). One record can hold several handshake messages or part of",
    "// one (`hs`), or application data that the caller has not read yet (`app`).",
    "export type Framer {",
    "    Transport io;",
    "    String buf;",
    "    String hs;",
    "    String app;",
    "    RecordProtection? rp;",
    "    bool handshaking;",
    "    int ccs;",
    "    bool closed;         // a close_notify arrived: EOF, not an error",
    "    bool eof;            // the transport ended",
    "    int empties;         // consecutive records that carried nothing",
    "    int keyUpdates;      // KeyUpdates applied on this connection",
    "    int userCanceled;    // user_canceled alerts ignored on this connection",
    "",
    "    void async fill() {",
    "        byte[] b = await self.io.read(READ_CHUNK);",
    "        if (b.length == 0) {",
    "            self.eof = true;",
    "            return Error(\"connection closed\", net.ErrorCode.END_OF_FILE);",
    "        }",
    "        self.buf = self.buf + string.fromByteArray(b);",
    "    }",
    "",
    "    // One whole record, with its header.",
    "    byte[] async record() {",
    "        while (string.length(self.buf) < 5) {",
    "            await self.fill();",
    "        }",
    "        RecordHeader h = parseRecordHeader(",
    "            string.toByteArray(string.substring(self.buf, 0, 5)));",
    "        int total = 5 + h.length;",
    "        while (string.length(self.buf) < total) {",
    "            await self.fill();",
    "        }",
    "        String rec = string.substring(self.buf, 0, total);",
    "        self.buf = string.substring(self.buf, total, string.length(self.buf));",
    "        return string.toByteArray(rec);",
    "    }",
    "",
    "    // Reads one record and puts its contents in the correct buffer. All rules",
    "    // about which records are acceptable at which time are here.",
    "    void async pump() {",
    "        byte[] rec = await self.record();",
    "        int outer = rec[0];",
    "",
    "        // change_cipher_spec is always plaintext and can be ignored, but only",
    "        // during the handshake and only in limited numbers (§D.4).",
    "        if (outer == ContentType.CHANGE_CIPHER_SPEC) {",
    "            if (!self.handshaking) {",
    "                return Error(\"change_cipher_spec after the handshake\",",
    "                    ErrorCode.UNEXPECTED_MESSAGE);",
    "            }",
    "            self.ccs = self.ccs + 1;",
    "            if (self.ccs > MAX_CCS) {",
    "                return Error(`more than ${MAX_CCS} change_cipher_spec records`,",
    "                    ErrorCode.TOO_MANY_MESSAGES);",
    "            }",
    "            byte[] payload = array.slice(rec, 5);",
    "            if (payload.length != 1 || payload[0] != 1) {",
    "                return Error(\"malformed change_cipher_spec\", ErrorCode.UNEXPECTED_MESSAGE);",
    "            }",
    "            return;",
    "        }",
    "",
    "        RecordProtection? p = self.rp;",
    "        if (p == null) {",
    "            byte[] payload = array.slice(rec, 5);",
    "            if (outer == ContentType.ALERT) {",
    "                self.alert(payload);",
    "                return;",
    "            }",
    "            if (outer != ContentType.HANDSHAKE) {",
    "                return Error(`unprotected record of type ${outer}`,",
    "                    ErrorCode.UNEXPECTED_MESSAGE);",
    "            }",
    "            self.hs = self.hs + string.fromByteArray(payload);",
    "            return;",
    "        }",
    "",
    "        InnerPlaintext ip = p.open(rec);",
    "",
    "        // A record that decrypts to nothing is legal padding. A record with at",
    "        // least one byte resets the counter, so padding between real records",
    "        // is not counted.",
    "        if (ip.data.length == 0 && ip.contentType != ContentType.ALERT) {",
    "            self.empties = self.empties + 1;",
    "            if (self.empties > MAX_EMPTY_RECORDS) {",
    "                return Error(`more than ${MAX_EMPTY_RECORDS} consecutive empty records`,",
    "                    ErrorCode.TOO_MANY_MESSAGES);",
    "            }",
    "            return;",
    "        }",
    "        self.empties = 0;",
    "",
    "        if (ip.contentType == ContentType.ALERT) {",
    "            self.alert(ip.data);",
    "            return;",
    "        }",
    "        if (ip.contentType == ContentType.HANDSHAKE) {",
    "            self.hs = self.hs + string.fromByteArray(ip.data);",
    "            return;",
    "        }",
    "        // Application data before the end of the handshake means that the peer",
    "        // skipped a step.",
    "        if (self.handshaking) {",
    "            return Error(\"application data during the handshake\",",
    "                ErrorCode.UNEXPECTED_MESSAGE);",
    "        }",
    "        self.app = self.app + string.fromByteArray(ip.data);",
    "    }",
    "",
    "    // close_notify is the end of the stream. user_canceled is counted and",
    "    // ignored. Every other alert fails with the reason that the peer gave.",
    "    void alert(byte[] payload) {",
    "        if (payload.length != 2) {",
    "            return Error(\"malformed alert record\", ErrorCode.DECODE_ERROR);",
    "        }",
    "        int level = payload[0];",
    "        int description = payload[1];",
    "        // §6 defines two level values. A record with another value cannot be",
    "        // parsed, so this end does not read its description.",
    "        if (level != ALERT_WARNING && level != ALERT_FATAL) {",
    "            return Error(`alert level is ${level}`,",
    "                ErrorCode.ILLEGAL_PARAMETER);",
    "        }",
    "        if (description == ALERT_CLOSE_NOTIFY) {",
    "            self.closed = true;",
    "            return;",
    "        }",
    "        // TLS 1.3 removed warning alerts (§6): every alert except close_notify",
    "        // and user_canceled is fatal, for any level byte.",
    "        if (level == ALERT_WARNING && description != ALERT_USER_CANCELED) {",
    "            return Error(\"peer sent a warning alert (\" + alertName(description)",
    "                + \"), which TLS 1.3 does not have\", ErrorCode.DECODE_ERROR);",
    "        }",
    "        // user_canceled is ignored and counted. Without a limit, a peer could",
    "        // make this end read forever.",
    "        if (description == ALERT_USER_CANCELED) {",
    "            self.userCanceled = self.userCanceled + 1;",
    "            if (self.userCanceled > MAX_USER_CANCELED) {",
    "                return Error(`more than ${MAX_USER_CANCELED} user_canceled alerts`,",
    "                    ErrorCode.TOO_MANY_MESSAGES);",
    "            }",
    "            return;",
    "        }",
    "        return Error(\"peer sent \" + alertName(description), ErrorCode.PEER_ALERT);",
    "    }",
    "",
    "    // RFC 8446 §5.1: handshake messages must not span a key change. Every",
    "    // handshake byte that the peer sent under the old keys must be read as part",
    "    // of a whole message. Otherwise a buffer outlives the key that",
    "    // authenticated it.",
    "    void endFlight(String what) {",
    "        if (string.length(self.hs) != 0) {",
    "            return Error(string.from(string.length(self.hs))",
    "                + \" handshake bytes left over at \" + what,",
    "                ErrorCode.UNEXPECTED_MESSAGE);",
    "        }",
    "    }",
    "",
    "    // One whole handshake message, with its 4-byte header, which is the form",
    "    // that the transcript needs.",
    "    byte[] async message() {",
    "        while (string.length(self.hs) < 4) {",
    "            if (self.closed) {",
    "                return Error(\"peer closed mid-handshake\", ErrorCode.UNEXPECTED_MESSAGE);",
    "            }",
    "            await self.pump();",
    "        }",
    "        byte[] head = string.toByteArray(string.substring(self.hs, 0, 4));",
    "        int len = head[1] * 65536 + head[2] * 256 + head[3];",
    "        if (len > MAX_HANDSHAKE) {",
    "            return Error(`handshake message of ${len} bytes exceeds ${MAX_HANDSHAKE}`,",
    "                ErrorCode.RECORD_OVERFLOW);",
    "        }",
    "        while (string.length(self.hs) < 4 + len) {",
    "            if (self.closed) {",
    "                return Error(\"peer closed mid-handshake\", ErrorCode.UNEXPECTED_MESSAGE);",
    "            }",
    "            await self.pump();",
    "        }",
    "        String msg = string.substring(self.hs, 0, 4 + len);",
    "        self.hs = string.substring(self.hs, 4 + len, string.length(self.hs));",
    "        return string.toByteArray(msg);",
    "    }",
    "",
    "    // `message` plus the rule of the state machine: the message that arrived",
    "    // must be the next message that the protocol names, or the handshake ends.",
    "    byte[] async expect(int msgType) {",
    "        byte[] msg = await self.message();",
    "        if (msg[0] != msgType) {",
    "            return Error(`expected handshake message ${msgType}, got ${msg[0]}`,",
    "                ErrorCode.UNEXPECTED_MESSAGE);",
    "        }",
    "        return msg;",
    "    }",
    "}",
    "",
    "export Framer framer(Transport io) {",
    "    return {",
    "        io: io, buf: \"\", hs: \"\", app: \"\", rp: null,",
    "        handshaking: true, ccs: 0, closed: false, eof: false,",
    "        empties: 0, keyUpdates: 0, userCanceled: 0,",
    "    };",
    "}",
    "",
    "// A handshake message without its 4-byte header.",
    "export byte[] messageBody(byte[] message) {",
    "    return array.slice(message, 4);",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// The connection",
    "// ---------------------------------------------------------------------------",
    "",
    "// A TLS connection after the handshake. `peerCertificates` is the chain as it",
    "// arrived, end-entity first. It is not verified here. `checkPeer` verifies it.",
    "export type Conn {",
    "    Framer in;",
    "    RecordProtection out;",
    "    Transport io;",
    "    String alpn;",
    "    byte[][] peerCertificates;",
    "    byte[] readSecret;",
    "    byte[] writeSecret;",
    "    bool sentClose;",
    "",
    "    // Returns up to n bytes, or an empty array at the end of the stream, as",
    "    // `net.read` does.",
    "    byte[] async read(int n) {",
    "        while (string.length(self.in.app) == 0) {",
    "            if (self.in.closed || self.in.eof) {",
    "                return string.toByteArray(\"\");",
    "            }",
    "            await self.pumpPostHandshake();",
    "        }",
    "        int have = string.length(self.in.app);",
    "        int take = n;",
    "        if (take > have) { take = have; }",
    "        String out = string.substring(self.in.app, 0, take);",
    "        self.in.app = string.substring(self.in.app, take, have);",
    "        return string.toByteArray(out);",
    "    }",
    "",
    "    // `pump` plus the two messages that can arrive after the handshake. A",
    "    // KeyUpdate is applied, because a peer that sends one has already changed",
    "    // its keys. Otherwise every later record would fail to authenticate.",
    "    void async pumpPostHandshake() {",
    "        await self.in.pump();",
    "        while (string.length(self.in.hs) >= 4) {",
    "            byte[] msg = await self.in.message();",
    "            int mt = msg[0];",
    "            if (mt == HandshakeType.NEW_SESSION_TICKET) {",
    "                checkNewSessionTicket(messageBody(msg));",
    "                continue;",
    "            }",
    "            if (mt == HandshakeType.KEY_UPDATE) {",
    "                await self.keyUpdate(messageBody(msg));",
    "                continue;",
    "            }",
    "            return Error(`unexpected post-handshake message ${mt}`,",
    "                ErrorCode.UNEXPECTED_MESSAGE);",
    "        }",
    "    }",
    "",
    "    // Changes the read keys, and also the write keys when the peer asks.",
    "    // §4.6.3 makes the reply mandatory.",
    "    void async keyUpdate(byte[] request) {",
    "        if (request.length != 1) {",
    "            return Error(\"malformed KeyUpdate\", ErrorCode.DECODE_ERROR);",
    "        }",
    "        self.in.keyUpdates = self.in.keyUpdates + 1;",
    "        if (self.in.keyUpdates > MAX_KEY_UPDATES) {",
    "            return Error(`more than ${MAX_KEY_UPDATES} KeyUpdates`,",
    "                ErrorCode.TOO_MANY_MESSAGES);",
    "        }",
    "        self.readSecret = hkdfExpandLabel(self.readSecret, \"traffic upd\",",
    "            string.toByteArray(\"\"), 32);",
    "        self.in.rp = protectionKeys(self.readSecret, self.out.suite);",
    "        if (request[0] == 0) {",
    "            return;",
    "        }",
    "        if (request[0] != 1) {",
    "            return Error(`KeyUpdate request is ${request[0]}`,",
    "                ErrorCode.ILLEGAL_PARAMETER);",
    "        }",
    "        byte[] answer = handshakeMessage(HandshakeType.KEY_UPDATE, [0]);",
    "        await self.io.write(self.out.seal(ContentType.HANDSHAKE, answer));",
    "        self.writeSecret = hkdfExpandLabel(self.writeSecret, \"traffic upd\",",
    "            string.toByteArray(\"\"), 32);",
    "        self.out = protectionKeys(self.writeSecret, self.out.suite);",
    "    }",
    "",
    "    // Sends application data, split into records at the plaintext limit, so a",
    "    // caller can give any amount.",
    "    void async write(byte[] data) {",
    "        int at = 0;",
    "        while (at < data.length) {",
    "            int end = at + MAX_PLAINTEXT;",
    "            if (end > data.length) { end = data.length; }",
    "            await self.io.write(",
    "                self.out.seal(ContentType.APPLICATION_DATA, array.slice(data, at, end)));",
    "            at = end;",
    "        }",
    "    }",
    "",
    "    // Sends close_notify and leaves the transport open. This is the first half",
    "    // of the clean shutdown of §6.1. A caller can continue to read after it. A",
    "    // failed write is ignored, because a peer that is gone cannot get a",
    "    // message.",
    "    void async closeWrite() {",
    "        if (!self.sentClose) {",
    "            self.sentClose = true;",
    "            await self.io.write(",
    "                self.out.seal(ContentType.ALERT, [ALERT_WARNING as byte, 0])) catch e { };",
    "        }",
    "    }",
    "",
    "    // The `close` for an error: the connection stops because something is",
    "    // wrong, and the peer gets the reason. Without it, a peer sees only a",
    "    // closed socket, which looks like a network failure.",
    "    void async abort(int description) {",
    "        await self.io.write(self.out.seal(ContentType.ALERT,",
    "            [ALERT_FATAL as byte, description as byte])) catch e { };",
    "        self.sentClose = true;",
    "        self.io.close();",
    "    }",
    "",
    "    // Sends close_notify and closes the transport. The alert tells the peer",
    "    // that the stream ended and was not cut. This separates a clean end from a",
    "    // truncation attack.",
    "    void async close() {",
    "        await self.closeWrite();",
    "        self.io.close();",
    "    }",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Options",
    "// ---------------------------------------------------------------------------",
    "",
    "// The trailing options record, in the form that every `net` call uses (§6.15).",
    "//",
    "// Verification is on when this record does not set it. By default, `connect`",
    "// builds the chain to a root in the trust store of the host, checks the leaf",
    "// against the requested name, and checks that the peer holds the private key",
    "// of the leaf.",
    "export type Options {",
    "    Duration? timeout;",
    "    String[]? alpn;",
    "    // The roots to trust in place of the store of the host. It narrows trust",
    "    // and does not remove it.",
    "    x509.Certificate[]? roots;",
    "    // insecureSkipVerify turns off all authentication of the peer: no chain,",
    "    // no hostname, no CertificateVerify. The connection stays private against",
    "    // an eavesdropper, but gives no protection against anyone who can redirect",
    "    // traffic. It exists because `testAccept` cannot sign.",
    "    bool? insecureSkipVerify;",
    "",
    "    // SHA-256 hashes of the SubjectPublicKeyInfo of the keys that this peer can",
    "    // hold (`x509.spkiPin`). When null, only the chain decides. When set, the",
    "    // verified chain must contain at least one of them. This protects against",
    "    // a certificate authority that issues a certificate for this name in error.",
    "    //",
    "    // It is a set, because with one pin a key rotation causes an outage. Pin",
    "    // the current key and the next key, or pin an intermediate, which outlives",
    "    // a leaf. For this reason, pinning is off by default. Verification still",
    "    // runs: a pin narrows the accepted chains and does not replace",
    "    // verification.",
    "    byte[][]? pins;",
    "}",
    "",
    "String[] alpnOf(Options? o) {",
    "    Options? opts = o;",
    "    if (opts == null) { return []; }",
    "    String[]? a = opts.alpn;",
    "    if (a == null) { return []; }",
    "    return a;",
    "}",
    "",
    "Duration? timeoutOf(Options? o) {",
    "    Options? opts = o;",
    "    if (opts == null) { return null; }",
    "    return opts.timeout;",
    "}",
    "",
    "x509.Certificate[]? rootsOf(Options? o) {",
    "    Options? opts = o;",
    "    if (opts == null) { return null; }",
    "    return opts.roots;",
    "}",
    "",
    "byte[][]? pinsOf(Options? o) {",
    "    Options? opts = o;",
    "    if (opts == null) { return null; }",
    "    return opts.pins;",
    "}",
    "",
    "// Refuses a pair of options that cannot both apply. If either one were ignored",
    "// without notice, the connection would succeed with nothing pinned.",
    "void checkOptions(Options? o) {",
    "    byte[][]? pins = pinsOf(o);",
    "    if (pins == null) { return; }",
    "    if (pins.length == 0) {",
    "        return Error(\"pins is empty, so no peer can match it; leave it null to \"",
    "            + \"verify without pinning\", ErrorCode.MISCONFIGURED);",
    "    }",
    "    if (skipVerify(o)) {",
    "        return Error(\"insecureSkipVerify turns off the verification that pins \"",
    "            + \"narrow, so the two cannot both be set\", ErrorCode.MISCONFIGURED);",
    "    }",
    "}",
    "",
    "// Absent means verify.",
    "bool skipVerify(Options? o) {",
    "    Options? opts = o;",
    "    if (opts == null) { return false; }",
    "    bool? skip = opts.insecureSkipVerify;",
    "    if (skip == null) { return false; }",
    "    return skip;",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Authenticating the peer (RFC 8446 §4.4.2, §4.4.3)",
    "// ---------------------------------------------------------------------------",
    "",
    "// Checks the verified chain against the pins of the caller. Any certificate in",
    "// the chain can carry a pinned key, so a pin on an intermediate stays valid for",
    "// every leaf issued under it. `checkOptions` already refused an empty set,",
    "// which would refuse every peer.",
    "void checkPins(x509.Certificate[] verified, byte[][]? pins) {",
    "    byte[][]? given = pins;",
    "    if (given == null) { return; }",
    "    if (x509.pinned(verified, given)) { return; }",
    "    return Error(\"no certificate in the peer's verified chain carries a pinned \"",
    "        + \"public key\", ErrorCode.PIN_MISMATCH);",
    "}",
    "",
    "// Authenticates the peer. The two checks are useful only together. The chain",
    "// shows that a certificate authority states that this public key belongs to",
    "// this name. The CertificateVerify shows that this peer holds the matching",
    "// private key. Certificates are public, so a chain check alone authenticates",
    "// nobody.",
    "void checkPeer(byte[][] chain, String serverName, CertificateVerify cv,",
    "    byte[] transcriptHash, Options? o) {",
    "    // The codes of x509 pass through unchanged, and `alertFor` maps each one to",
    "    // its alert.",
    "    x509.Certificate[] verified = x509.verifyChain(chain, serverName, rootsOf(o), null);",
    "    checkPins(verified, pinsOf(o));",
    "    x509.Certificate leaf = verified[0];",
    "",
    "    // RFC 5280 §4.2.1.3 and RFC 8446 §4.4.2.2: the certificate must permit its",
    "    // key to sign, because the CertificateVerify below is a signature.",
    "    if (!leaf.mayDigitallySign()) {",
    "        return Error(\"the server's certificate does not permit its key to sign\",",
    "            x509.ErrorCode.CONSTRAINT_VIOLATION);",
    "    }",
    "",
    "    byte[] content = certificateVerifyContent(SERVER_CV_CONTEXT, transcriptHash);",
    "",
    "    // PKCS#1 v1.5 is not here, because RFC 8446 §4.4.3 forbids it. The scheme",
    "    // sets the hash and the kind of key that the leaf must hold. A mismatch",
    "    // fails in the key accessor below.",
    "    String hash = \"\";",
    "    bool ecdsa = false;",
    "    String wantCurve = \"\";",
    "    if (cv.algorithm == SIG_RSA_PSS_RSAE_SHA256) {",
    "        hash = \"sha256\";",
    "    } else if (cv.algorithm == SIG_RSA_PSS_RSAE_SHA384) {",
    "        hash = \"sha384\";",
    "    } else if (cv.algorithm == SIG_ECDSA_SECP256R1_SHA256) {",
    "        hash = \"sha256\";",
    "        ecdsa = true;",
    "        wantCurve = \"p256\";",
    "    } else if (cv.algorithm == SIG_ECDSA_SECP384R1_SHA384) {",
    "        hash = \"sha384\";",
    "        ecdsa = true;",
    "        wantCurve = \"p384\";",
    "    } else {",
    "        return Error(\"server signed its CertificateVerify with scheme \"",
    "            + string.from(cv.algorithm) + \", which this client does not accept\",",
    "            ErrorCode.UNSUPPORTED_CERTIFICATE);",
    "    }",
    "    byte[] digest = crypto.sha256(content);",
    "    if (hash == \"sha384\") {",
    "        digest = crypto.sha384(content);",
    "    }",
    "",
    "    if (ecdsa) {",
    "        x509.EcdsaPublicKey key = x509.ecdsaPublicKey(leaf) catch e {",
    "            return Error(\"the CertificateVerify scheme does not fit the certificate: \"",
    "                + e.message, ErrorCode.UNSUPPORTED_CERTIFICATE);",
    "        };",
    "        // §4.2.3 ties each ecdsa_secp*r1 scheme to its curve.",
    "        if (key.curve != wantCurve) {",
    "            return Error(\"the CertificateVerify scheme names \" + wantCurve",
    "                + \" but the certificate's key is on \" + key.curve,",
    "                ErrorCode.ILLEGAL_PARAMETER);",
    "        }",
    "        x509.EcdsaSignature sig = x509.parseEcdsaSignature(cv.signature) catch e {",
    "            return Error(\"the server's CertificateVerify signature is malformed: \"",
    "                + e.message, ErrorCode.DECODE_ERROR);",
    "        };",
    "        crypto.ecdsaVerify(key.curve, key.point, digest, sig.r, sig.s) catch e {",
    "            return Error(\"the server does not hold the private key for the certificate \"",
    "                + \"it presented: \" + e.message, ErrorCode.DECRYPT_ERROR);",
    "        };",
    "        return;",
    "    }",
    "",
    "    x509.RsaPublicKey key = x509.rsaPublicKey(leaf) catch e {",
    "        return Error(\"the CertificateVerify scheme does not fit the certificate: \"",
    "            + e.message, ErrorCode.UNSUPPORTED_CERTIFICATE);",
    "    };",
    "    crypto.rsaVerifyPss(key.modulus, key.exponent, hash, digest, cv.signature) catch e {",
    "        return Error(\"the server does not hold the private key for the certificate \"",
    "            + \"it presented: \" + e.message, ErrorCode.DECRYPT_ERROR);",
    "    };",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// The client handshake (RFC 8446 §4)",
    "// ---------------------------------------------------------------------------",
    "",
    "// The progress of the handshake, used only to send an alert at the correct",
    "// protection level. Before the key schedule runs, an alert is sent in the",
    "// clear. After it, the peer reads an unprotected record as a MAC failure.",
    "type AlertLevel {",
    "    RecordProtection? rp;",
    "    // The compatibility change_cipher_spec (§D.4), until this end writes its",
    "    // first protected record. It goes out in the same write as that record.",
    "    // Written alone, a small record can wait for an ACK, and a close in that",
    "    // time discards it.",
    "    byte[] ccs;",
    "}",
    "",
    "// Writes a fatal alert at the protection level that the handshake has reached.",
    "// Every caller ignores a failure, because a peer that is gone cannot get a",
    "// message.",
    "void async sendAlert(Transport io, AlertLevel al, int description) {",
    "    RecordProtection? p = al.rp;",
    "    if (p == null) {",
    "        await io.write(plaintextRecord(ContentType.ALERT,",
    "            [ALERT_FATAL as byte, description as byte]));",
    "        return;",
    "    }",
    "    await io.write(cat(al.ccs, p.seal(ContentType.ALERT,",
    "        [ALERT_FATAL as byte, description as byte])));",
    "}",
    "",
    "// Runs a full 1-RTT client handshake over `io` and returns the connection. Any",
    "// transport works, so a test or a QUIC implementation can use it.",
    "//",
    "// When it fails, it sends the alert to the peer itself. `connect` cannot do",
    "// this, because only this function knows whether keys existed at the failure.",
    "export Conn async handshakeClient(Transport io, String serverName, Options? o) {",
    "    // This check comes before any byte is sent. An option that this end cannot",
    "    // apply is not a fault of the peer, so it gets no alert.",
    "    checkOptions(o);",
    "    AlertLevel al = { rp: null, ccs: EMPTY };",
    "    Conn c = await handshakeClientInner(io, serverName, o, al) catch e {",
    "        await sendAlert(io, al, alertFor(e.code)) catch e2 { };",
    "        return e;",
    "    };",
    "    return c;",
    "}",
    "",
    "Conn async handshakeClientInner(Transport io, String serverName, Options? o,",
    "    AlertLevel al) {",
    "    byte[] priv = crypto.randomBytes(32);",
    "    byte[] pub = crypto.x25519PublicKey(priv);",
    "    byte[] random = crypto.randomBytes(32);",
    "    byte[] sessionId = crypto.randomBytes(32);",
    "    String[] alpn = alpnOf(o);",
    "",
    "    Transcript t = transcript();",
    "    Framer f = framer(io);",
    "",
    "    byte[] hello = buildClientHello(random, sessionId, pub, serverName, alpn);",
    "    t.push(hello);",
    "    // §5.1 lets the first ClientHello carry the record version 0x0301, and",
    "    // some servers refuse any other value in it.",
    "    byte[] helloRecord = plaintextRecord(ContentType.HANDSHAKE, hello);",
    "    helloRecord[2] = 1;",
    "    // This is the only write before the first read. A server that refuses the",
    "    // ClientHello closes the connection, and a second write here can fail",
    "    // before this end reads the alert that tells why.",
    "    await io.write(helloRecord);",
    "",
    "    byte[] shMsg = await f.expect(HandshakeType.SERVER_HELLO);",
    "    ServerHello sh = parseServerHello(messageBody(shMsg));",
    "    if (sh.helloRetryRequest) {",
    "        return Error(",
    "            \"server asked for a HelloRetryRequest, and x25519 is the only group offered\",",
    "            ErrorCode.HANDSHAKE_FAILURE);",
    "    }",
    "    // The offered suites depend on what this host can do safely, so this",
    "    // checks the current list and not a constant.",
    "    if (array.indexOf(offeredSuites(), sh.cipherSuite) < 0) {",
    "        return Error(`server chose cipher suite ${sh.cipherSuite}, which was not offered`,",
    "            ErrorCode.ILLEGAL_PARAMETER);",
    "    }",
    "    int suite = sh.cipherSuite;",
    "    // §4.1.3: the server echoes the session id. A different one is the reply",
    "    // to a different ClientHello.",
    "    if (crypto.hexEncode(sh.sessionId) != crypto.hexEncode(sessionId)) {",
    "        return Error(\"server echoed a different session id\", ErrorCode.ILLEGAL_PARAMETER);",
    "    }",
    "    if (sh.keyShare.length != 32) {",
    "        return Error(\"server sent no usable key share\", ErrorCode.ILLEGAL_PARAMETER);",
    "    }",
    "    t.push(shMsg);",
    "",
    "    // `x25519SharedSecret` is fallible, so the small-order check cannot be",
    "    // skipped (§6.17).",
    "    byte[] shared = crypto.x25519SharedSecret(priv, sh.keyShare) catch e {",
    "        return Error(\"server key share is unusable: \" + e.message,",
    "            ErrorCode.ILLEGAL_PARAMETER);",
    "    };",
    "",
    "    byte[] early = earlySecret(null);",
    "    byte[] hs = handshakeSecret(early, shared);",
    "    byte[] clientHs = deriveSecret(hs, \"c hs traffic\", t.hash());",
    "    byte[] serverHs = deriveSecret(hs, \"s hs traffic\", t.hash());",
    "    // The first key change: no unprotected data can stay in the buffer.",
    "    f.endFlight(\"the end of the ServerHello\");",
    "    f.rp = protectionKeys(serverHs, suite);",
    "    // The same object seals the Finished below, so its sequence numbers are",
    "    // the single sequence that the peer expects.",
    "    RecordProtection hsOut = protectionKeys(clientHs, suite);",
    "    al.rp = hsOut;",
    "    // It must precede every protected record that this end sends, an alert",
    "    // included.",
    "    al.ccs = plaintextRecord(ContentType.CHANGE_CIPHER_SPEC, [1]);",
    "",
    "    byte[] eeMsg = await f.expect(HandshakeType.ENCRYPTED_EXTENSIONS);",
    "    t.push(eeMsg);",
    "    // The EncryptedExtensions can reply only to what this ClientHello asked,",
    "    // so the allowed list comes from what was sent.",
    "    Reader eer = reader(messageBody(eeMsg));",
    "    Map<int, byte[]> ee = parseExtensions(eer.vector16());",
    "    if (!eer.done()) {",
    "        return Error(\"trailing bytes after the EncryptedExtensions\",",
    "            ErrorCode.DECODE_ERROR);",
    "    }",
    "    int[] eeAllowed = [EXT_SUPPORTED_GROUPS];",
    "    if (sendsServerName(serverName)) { array.push(eeAllowed, EXT_SERVER_NAME); }",
    "    if (alpn.length > 0) { array.push(eeAllowed, EXT_ALPN); }",
    "    checkSolicited(ee, eeAllowed, \"EncryptedExtensions\");",
    "    // RFC 6066 §3 makes the server reply to SNI an empty extension. A body here",
    "    // is data that has no field to hold it.",
    "    byte[]? sniAck = ee[EXT_SERVER_NAME];",
    "    if (sniAck != null && sniAck.length != 0) {",
    "        return Error(\"the server's server_name acknowledgement is not empty\",",
    "            ErrorCode.DECODE_ERROR);",
    "    }",
    "    String selected = \"\";",
    "    byte[]? ap = ee[EXT_ALPN];",
    "    if (ap != null) {",
    "        selected = parseAlpn(ap);",
    "        if (array.indexOf(alpn, selected) < 0) {",
    "            return Error(\"server selected ALPN protocol \\\"\" + selected",
    "                + \"\\\", which was not offered\", ErrorCode.ILLEGAL_PARAMETER);",
    "        }",
    "    }",
    "",
    "    // This client has no certificate and never signs. §4.4.2 says to reply to a",
    "    // CertificateRequest with an empty Certificate list and no",
    "    // CertificateVerify. A server that requests a certificate, but does not",
    "    // require one, accepts this. The reply echoes the context, so it is kept.",
    "    byte[] certRequestContext = EMPTY;",
    "    bool certRequested = false;",
    "    byte[] certMsg = await f.message();",
    "    int certType = certMsg[0];",
    "    if (certType == HandshakeType.CERTIFICATE_REQUEST) {",
    "        certRequested = true;",
    "        // The extension block is read and not skipped, because this end must",
    "        // check the frame of a message that it ignores.",
    "        Reader crr = reader(messageBody(certMsg));",
    "        certRequestContext = crr.vector8();",
    "        parseExtensions(crr.vector16());",
    "        if (!crr.done()) {",
    "            return Error(\"trailing bytes after the CertificateRequest\",",
    "                ErrorCode.DECODE_ERROR);",
    "        }",
    "        t.push(certMsg);",
    "        certMsg = await f.message();",
    "        certType = certMsg[0];",
    "    }",
    "    if (certType != HandshakeType.CERTIFICATE) {",
    "        return Error(`expected Certificate, got ${certType}`,",
    "            ErrorCode.UNEXPECTED_MESSAGE);",
    "    }",
    "    byte[][] chain = parseCertificate(messageBody(certMsg));",
    "    t.push(certMsg);",
    "",
    "    // The CertificateVerify signs the transcript up to the Certificate message,",
    "    // so the hash is taken before the CertificateVerify is added.",
    "    byte[] beforeCv = t.hash();",
    "    byte[] cvMsg = await f.expect(HandshakeType.CERTIFICATE_VERIFY);",
    "    CertificateVerify cv = parseCertificateVerify(messageBody(cvMsg));",
    "    t.push(cvMsg);",
    "",
    "    if (!skipVerify(o)) {",
    "        checkPeer(chain, serverName, cv, beforeCv, o);",
    "    }",
    "",
    "    // The Finished of the server proves that the peer completed the key",
    "    // exchange. The chain and the CertificateVerify above identify the peer.",
    "    byte[] beforeFinished = t.hash();",
    "    byte[] finMsg = await f.expect(HandshakeType.FINISHED);",
    "    byte[] want = finishedVerifyData(serverHs, beforeFinished);",
    "    if (!string.bytesEqualConstantTime(messageBody(finMsg), want)) {",
    "        return Error(\"server Finished does not verify\", ErrorCode.DECRYPT_ERROR);",
    "    }",
    "    t.push(finMsg);",
    "    // The second key change. Handshake bytes must not span it. Data left in the",
    "    // buffer after the Finished of the server is not part of a message.",
    "    f.endFlight(\"the end of the server's Finished\");",
    "",
    "    byte[] master = masterSecret(hs);",
    "    byte[] clientAp = deriveSecret(master, \"c ap traffic\", t.hash());",
    "    byte[] serverAp = deriveSecret(master, \"s ap traffic\", t.hash());",
    "",
    "    // Declines the certificate that the server asked for (§4.4.2). It goes",
    "    // into the transcript before the Finished, so the verify_data below covers",
    "    // it. The application secrets above come from the transcript up to the",
    "    // Finished of the server (§7.1), so they are computed before this.",
    "    byte[] flight = al.ccs;",
    "    if (certRequested) {",
    "        byte[] decline = handshakeMessage(HandshakeType.CERTIFICATE,",
    "            emptyCertificateBody(certRequestContext));",
    "        t.push(decline);",
    "        flight = cat(flight, hsOut.seal(ContentType.HANDSHAKE, decline));",
    "    }",
    "",
    "    // The Finished of the client is the last message under the handshake keys.",
    "    byte[] verify = finishedVerifyData(clientHs, t.hash());",
    "    flight = cat(flight, hsOut.seal(ContentType.HANDSHAKE,",
    "        handshakeMessage(HandshakeType.FINISHED, verify)));",
    "    al.ccs = EMPTY;",
    "    await io.write(flight);",
    "",
    "    f.rp = protectionKeys(serverAp, suite);",
    "    f.handshaking = false;",
    "",
    "    return {",
    "        in: f,",
    "        out: protectionKeys(clientAp, suite),",
    "        io: io,",
    "        alpn: selected,",
    "        peerCertificates: chain,",
    "        readSecret: serverAp,",
    "        writeSecret: clientAp,",
    "        sentClose: false,",
    "    };",
    "}",
    "",
    "// Opens a TCP connection and runs the handshake over it.",
    "//",
    "// The certificate of the server is verified. The chain must build to a root in",
    "// the trust store of the host, the leaf must be valid for `serverName`, and",
    "// the CertificateVerify must prove that the peer holds the private key of the",
    "// leaf. `Options.roots` narrows what is trusted. `Options.insecureSkipVerify`",
    "// removes the check.",
    "export Conn async connect(String address, String serverName, Options? o) {",
    "    Duration? timeout = timeoutOf(o);",
    "    Socket s = await net.tcp.connect(address, { timeout: timeout });",
    "    Transport io = socketTransport(s, timeout);",
    "    Conn c = await handshakeClient(io, serverName, o) catch e {",
    "        // `handshakeClient` sends the alert, because only it knows whether",
    "        // there were keys to protect it. This code closes the socket.",
    "        net.close(s);",
    "        return e;",
    "    };",
    "    return c;",
    "}",
    "",
    "// Writes an unprotected fatal alert, for the test peer below before it has",
    "// keys. On failure the client uses `sendAlert`, which chooses a level.",
    "void async sendPlainAlert(Transport io, int description) {",
    "    await io.write(plaintextRecord(ContentType.ALERT,",
    "        [ALERT_FATAL as byte, description as byte]));",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// The server handshake: a test peer, not a server",
    "// ---------------------------------------------------------------------------",
    "",
    "// This is not a TLS server. Do not use it as one. This module cannot sign, so",
    "// `testAccept` sends a CertificateVerify of the correct form with a signature",
    "// that verifies nothing. Any peer that checks signatures rejects it.",
    "//",
    "// It lets the whole module run against itself over loopback, with no network",
    "// and no external tools. Thus the failure paths of the handshake are testable.",
    "export type TestConfig {",
    "    byte[][] certificates;",
    "    String[] alpn;",
    "}",
    "",
    "export Conn async testAccept(Transport io, TestConfig config) {",
    "    Transcript t = transcript();",
    "    Framer f = framer(io);",
    "",
    "    byte[] chMsg = await f.expect(HandshakeType.CLIENT_HELLO);",
    "    ClientHello ch = parseClientHello(messageBody(chMsg));",
    "    // The first of the two suites that the client offered, so a client without",
    "    // AES still gets a handshake.",
    "    int suite = 0;",
    "    forEach(ch.cipherSuites, s) {",
    "        if (suite == 0 && (s == TLS_CHACHA20_POLY1305_SHA256",
    "            || s == TLS_AES_128_GCM_SHA256)) {",
    "            suite = s;",
    "        }",
    "    }",
    "    if (suite == 0) {",
    "        return Error(\"client offers no cipher suite this peer speaks\",",
    "            ErrorCode.HANDSHAKE_FAILURE);",
    "    }",
    "    if (ch.keyShare.length != 32) {",
    "        return Error(\"client offered no x25519 key share\", ErrorCode.HANDSHAKE_FAILURE);",
    "    }",
    "    t.push(chMsg);",
    "",
    "    byte[] priv = crypto.randomBytes(32);",
    "    byte[] pub = crypto.x25519PublicKey(priv);",
    "    byte[] shared = crypto.x25519SharedSecret(priv, ch.keyShare) catch e {",
    "        return Error(\"client key share is unusable: \" + e.message,",
    "            ErrorCode.ILLEGAL_PARAMETER);",
    "    };",
    "",
    "    // The first offered protocol that this config also names. This is the",
    "    // order of the server preference.",
    "    String selected = \"\";",
    "    forEach(config.alpn, mine) {",
    "        if (selected == \"\" && array.indexOf(ch.alpn, mine) >= 0) {",
    "            selected = mine;",
    "        }",
    "    }",
    "",
    "    Writer sh = writer();",
    "    sh.u16(VERSION_TLS12);",
    "    sh.raw(crypto.randomBytes(32));",
    "    int sid = sh.open8();",
    "    sh.raw(ch.sessionId);",
    "    sh.close8(sid);",
    "    sh.u16(suite);",
    "    sh.u8(0);",
    "    int exts = sh.open16();",
    "    Writer sv = writer();",
    "    sv.u16(VERSION_TLS13);",
    "    writeExtension(sh, EXT_SUPPORTED_VERSIONS, sv.out);",
    "    writeExtension(sh, EXT_KEY_SHARE, keyShareServer(pub));",
    "    sh.close16(exts);",
    "",
    "    byte[] shMsg = handshakeMessage(HandshakeType.SERVER_HELLO, sh.out);",
    "    t.push(shMsg);",
    "    await io.write(plaintextRecord(ContentType.HANDSHAKE, shMsg));",
    "    await io.write(plaintextRecord(ContentType.CHANGE_CIPHER_SPEC, [1]));",
    "",
    "    byte[] early = earlySecret(null);",
    "    byte[] hs = handshakeSecret(early, shared);",
    "    byte[] clientHs = deriveSecret(hs, \"c hs traffic\", t.hash());",
    "    byte[] serverHs = deriveSecret(hs, \"s hs traffic\", t.hash());",
    "    RecordProtection out = protectionKeys(serverHs, suite);",
    "    f.rp = protectionKeys(clientHs, suite);",
    "",
    "    Writer ee = writer();",
    "    int eeExts = ee.open16();",
    "    if (selected != \"\") {",
    "        writeExtension(ee, EXT_ALPN, alpnExtension([selected]));",
    "    }",
    "    ee.close16(eeExts);",
    "    byte[] eeMsg = handshakeMessage(HandshakeType.ENCRYPTED_EXTENSIONS, ee.out);",
    "    t.push(eeMsg);",
    "    await io.write(out.seal(ContentType.HANDSHAKE, eeMsg));",
    "",
    "    Writer cert = writer();",
    "    int ctx = cert.open8();",
    "    cert.close8(ctx);",
    "    int list = cert.open24();",
    "    forEach(config.certificates, der) {",
    "        int one = cert.open24();",
    "        cert.raw(der);",
    "        cert.close24(one);",
    "        int certExts = cert.open16();",
    "        cert.close16(certExts);",
    "    }",
    "    cert.close24(list);",
    "    byte[] certMsg = handshakeMessage(HandshakeType.CERTIFICATE, cert.out);",
    "    t.push(certMsg);",
    "    await io.write(out.seal(ContentType.HANDSHAKE, certMsg));",
    "",
    "    // A fake signature. Its length and algorithm are those of a real",
    "    // RSA-PSS-SHA256 signature, so the parser of the client sees the real form.",
    "    // Its content is the bare hash, which a verifier rejects.",
    "    Writer cv = writer();",
    "    cv.u16(SIG_RSA_PSS_RSAE_SHA256);",
    "    int sig = cv.open16();",
    "    cv.raw(crypto.sha256(certificateVerifyContent(SERVER_CV_CONTEXT, t.hash())));",
    "    cv.close16(sig);",
    "    byte[] cvMsg = handshakeMessage(HandshakeType.CERTIFICATE_VERIFY, cv.out);",
    "    t.push(cvMsg);",
    "    await io.write(out.seal(ContentType.HANDSHAKE, cvMsg));",
    "",
    "    byte[] finMsg = handshakeMessage(HandshakeType.FINISHED,",
    "        finishedVerifyData(serverHs, t.hash()));",
    "    t.push(finMsg);",
    "    await io.write(out.seal(ContentType.HANDSHAKE, finMsg));",
    "",
    "    byte[] master = masterSecret(hs);",
    "    byte[] clientAp = deriveSecret(master, \"c ap traffic\", t.hash());",
    "    byte[] serverAp = deriveSecret(master, \"s ap traffic\", t.hash());",
    "",
    "    byte[] want = finishedVerifyData(clientHs, t.hash());",
    "    byte[] clientFin = await f.expect(HandshakeType.FINISHED);",
    "    if (!string.bytesEqualConstantTime(messageBody(clientFin), want)) {",
    "        return Error(\"client Finished does not verify\", ErrorCode.DECRYPT_ERROR);",
    "    }",
    "",
    "    f.rp = protectionKeys(clientAp, suite);",
    "    f.handshaking = false;",
    "",
    "    return {",
    "        in: f,",
    "        out: protectionKeys(serverAp, suite),",
    "        io: io,",
    "        alpn: selected,",
    "        peerCertificates: [],",
    "        readSecret: clientAp,",
    "        writeSecret: serverAp,",
    "        sentClose: false,",
    "    };",
    "}",
    "",
];

String[] const x509Lines = [
    "// The `x509` module (§6.19): certificate parsing and the trust decision.",
    "// This file does parsing and policy. The signature check is a call into",
    "// `crypto`.",
    "//",
    "// This file parses bytes that an attacker can choose. Three rules apply.",
    "//",
    "// No code indexes a received array directly. Every byte goes through `Der`,",
    "// which raises BAD_CERTIFICATE where an index gives a runtime error (§5.5).",
    "// tests/x509_test.nio feeds back every prefix of every certificate it holds.",
    "//",
    "// This file enforces the DER encoding rules and refuses BER: definite minimal",
    "// lengths, no trailing bytes after a structure, integers without redundant",
    "// leading bytes, booleans 0x00 or 0xFF only. A signature covers bytes, so two",
    "// encodings of one certificate give a forgery primitive.",
    "//",
    "// Everything unrecognized fails closed. A critical extension that this module",
    "// does not implement makes the certificate unusable (RFC 5280 §4.2). An",
    "// algorithm that it cannot check is refused. SHA-1 signatures are refused.",
    "//",
    "// Revocation (CRL, OCSP) is not implemented. See https://nio-lang.org/docs.",
    "import 'crypto';",
    "import 'string';",
    "import 'array';",
    "import 'time';",
    "import 'fs';",
    "",
    "// The codes start at 300, so the http (100), tls (200) and x509 sets coexist.",
    "export enum ErrorCode {",
    "    BAD_CERTIFICATE: 300,",
    "    UNSUPPORTED_ALGORITHM: 301,",
    "    EXPIRED: 302,",
    "    NOT_YET_VALID: 303,",
    "    UNTRUSTED_ROOT: 304,",
    "    HOSTNAME_MISMATCH: 305,",
    "    CONSTRAINT_VIOLATION: 306,",
    "    BAD_SIGNATURE: 307",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Limits",
    "// ---------------------------------------------------------------------------",
    "//",
    "// Each bound covers something an attacker controls the size of. An unbounded",
    "// list, depth or search in hostile input is a denial of service.",
    "",
    "// No real certificate is larger than this.",
    "int const MAX_CERTIFICATE = 65536;",
    "",
    "// The maximum chain length, leaf included. RFC 5280 sets no limit.",
    "int const MAX_CHAIN_DEPTH = 10;",
    "",
    "// The maximum number of candidates the chain search examines. Without it, a",
    "// peer can send a pool of cross-signed certificates that makes the search",
    "// exponential.",
    "int const MAX_CHAIN_WORK = 100;",
    "",
    "int const MAX_NAME_ENTRIES = 64;",
    "int const MAX_SAN_ENTRIES = 256;",
    "int const MAX_EXTENSIONS = 64;",
    "",
    "// The deepest nesting the DER reader follows. It stops a structure built to",
    "// exhaust the stack.",
    "int const MAX_DER_DEPTH = 32;",
    "",
    "// ---------------------------------------------------------------------------",
    "// Object identifiers",
    "// ---------------------------------------------------------------------------",
    "//",
    "// OIDs are dotted decimal, so a diagnostic shows an unrecognized OID in the",
    "// standard form.",
    "",
    "String const OID_RSA_ENCRYPTION = \"1.2.840.113549.1.1.1\";",
    "String const OID_RSASSA_PSS = \"1.2.840.113549.1.1.10\";",
    "String const OID_SHA256_RSA = \"1.2.840.113549.1.1.11\";",
    "String const OID_SHA384_RSA = \"1.2.840.113549.1.1.12\";",
    "String const OID_SHA512_RSA = \"1.2.840.113549.1.1.13\";",
    "String const OID_SHA1_RSA = \"1.2.840.113549.1.1.5\";",
    "String const OID_MD5_RSA = \"1.2.840.113549.1.1.4\";",
    "String const OID_EC_PUBLIC_KEY = \"1.2.840.10045.2.1\";",
    "String const OID_ECDSA_SHA256 = \"1.2.840.10045.4.3.2\";",
    "String const OID_ECDSA_SHA384 = \"1.2.840.10045.4.3.3\";",
    "String const OID_ED25519 = \"1.3.101.112\";",
    "String const OID_CURVE_P256 = \"1.2.840.10045.3.1.7\";    // secp256r1 (RFC 5480)",
    "String const OID_CURVE_P384 = \"1.3.132.0.34\";           // secp384r1",
    "",
    "String const OID_SHA256 = \"2.16.840.1.101.3.4.2.1\";",
    "String const OID_SHA384 = \"2.16.840.1.101.3.4.2.2\";",
    "",
    "String const OID_EXT_KEY_USAGE = \"2.5.29.15\";",
    "String const OID_EXT_SAN = \"2.5.29.17\";",
    "String const OID_EXT_BASIC_CONSTRAINTS = \"2.5.29.19\";",
    "String const OID_EXT_NAME_CONSTRAINTS = \"2.5.29.30\";",
    "String const OID_EXT_EXT_KEY_USAGE = \"2.5.29.37\";",
    "",
    "String const OID_EKU_SERVER_AUTH = \"1.3.6.1.5.5.7.3.1\";",
    "String const OID_EKU_CLIENT_AUTH = \"1.3.6.1.5.5.7.3.2\";",
    "String const OID_EKU_ANY = \"2.5.29.37.0\";",
    "",
    "// The attribute types a distinguished name is rendered with. Anything else",
    "// appears by its OID.",
    "String attrShortName(String oid) {",
    "    if (oid == \"2.5.4.3\") { return \"CN\"; }",
    "    if (oid == \"2.5.4.6\") { return \"C\"; }",
    "    if (oid == \"2.5.4.7\") { return \"L\"; }",
    "    if (oid == \"2.5.4.8\") { return \"ST\"; }",
    "    if (oid == \"2.5.4.10\") { return \"O\"; }",
    "    if (oid == \"2.5.4.11\") { return \"OU\"; }",
    "    if (oid == \"2.5.4.5\") { return \"serialNumber\"; }",
    "    if (oid == \"0.9.2342.19200300.100.1.25\") { return \"DC\"; }",
    "    if (oid == \"1.2.840.113549.1.9.1\") { return \"emailAddress\"; }",
    "    return oid;",
    "}",
    "",
    "// keyUsage bits (RFC 5280 §4.2.1.3), numbered from the most significant bit",
    "// of the first byte, which is how a DER BIT STRING counts.",
    "int const KU_DIGITAL_SIGNATURE = 0;",
    "int const KU_KEY_ENCIPHERMENT = 2;",
    "int const KU_KEY_CERT_SIGN = 5;",
    "int const KU_CRL_SIGN = 6;",
    "",
    "// ---------------------------------------------------------------------------",
    "// The DER reader",
    "// ---------------------------------------------------------------------------",
    "",
    "int const TAG_BOOLEAN = 1;",
    "int const TAG_INTEGER = 2;",
    "int const TAG_BIT_STRING = 3;",
    "int const TAG_OCTET_STRING = 4;",
    "int const TAG_NULL = 5;",
    "int const TAG_OID = 6;",
    "int const TAG_UTF8_STRING = 12;",
    "int const TAG_SEQUENCE = 48;    // 0x30, constructed",
    "int const TAG_SET = 49;         // 0x31, constructed",
    "int const TAG_PRINTABLE_STRING = 19;",
    "int const TAG_T61_STRING = 20;",
    "int const TAG_IA5_STRING = 22;",
    "int const TAG_BMP_STRING = 30;",
    "int const TAG_UTC_TIME = 23;",
    "int const TAG_GENERALIZED_TIME = 24;",
    "",
    "// One tag-length-value header, as positions in the buffer it came from.",
    "// `start` and `end` give the structure's own encoding, which a signature",
    "// covers, with no re-encoding.",
    "export type Tlv {",
    "    int tag;",
    "    int start;",
    "    int contentStart;",
    "    int end;",
    "}",
    "",
    "// A bounds-checked cursor over DER. Every accessor raises BAD_CERTIFICATE when",
    "// it reads past the end. All received bytes are read through this type.",
    "export type Der {",
    "    byte[] data;",
    "    int pos;",
    "    int end;",
    "    int depth;",
    "",
    "    int left() {",
    "        return self.end - self.pos;",
    "    }",
    "",
    "    bool done() {",
    "        return self.pos >= self.end;",
    "    }",
    "",
    "    int at(int i) {",
    "        if (i < 0 || i >= self.end) {",
    "            return Error(`truncated DER: no byte at ${i}`,",
    "                ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        return self.data[i];",
    "    }",
    "",
    "    byte[] bytes(int from, int to) {",
    "        if (from < 0 || to < from || to > self.end) {",
    "            return Error(`truncated DER: no bytes ${from}..${to}`, ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        return array.slice(self.data, from, to);",
    "    }",
    "",
    "    // Reads one header. DER has no indefinite length, and a length uses the",
    "    // fewest bytes that hold it. This function checks both rules.",
    "    Tlv readTlv() {",
    "        int start = self.pos;",
    "        int tag = self.at(self.pos);",
    "        self.pos = self.pos + 1;",
    "        // The high-tag-number form (low five bits all set) starts a multi-byte",
    "        // tag. No certificate uses one.",
    "        if ((tag % 32) == 31) {",
    "            return Error(\"multi-byte DER tags are not supported\",",
    "                ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        int first = self.at(self.pos);",
    "        self.pos = self.pos + 1;",
    "        int length = 0;",
    "        if (first < 128) {",
    "            length = first;",
    "        } else {",
    "            int count = first - 128;",
    "            if (count == 0) {",
    "                return Error(\"indefinite DER length (BER, not DER)\",",
    "                    ErrorCode.BAD_CERTIFICATE);",
    "            }",
    "            if (count > 4) {",
    "                return Error(\"DER length over four bytes\", ErrorCode.BAD_CERTIFICATE);",
    "            }",
    "            int firstByte = self.at(self.pos);",
    "            if (firstByte == 0) {",
    "                return Error(\"non-minimal DER length: leading zero byte\",",
    "                    ErrorCode.BAD_CERTIFICATE);",
    "            }",
    "            int i = 0;",
    "            while (i < count) {",
    "                length = length * 256 + self.at(self.pos + i);",
    "                i = i + 1;",
    "            }",
    "            self.pos = self.pos + count;",
    "            if (length < 128) {",
    "                return Error(`non-minimal DER length: ${length} written long-form`,",
    "                    ErrorCode.BAD_CERTIFICATE);",
    "            }",
    "        }",
    "        int contentStart = self.pos;",
    "        int stop = contentStart + length;",
    "        if (length < 0 || stop > self.end) {",
    "            return Error(`DER length ${length} runs past the end`,",
    "                ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        self.pos = stop;",
    "        return { tag: tag, start: start, contentStart: contentStart, end: stop };",
    "    }",
    "",
    "    // Reads one header and requires the given tag. A wrong tag raises an",
    "    // error, so a field is never read as a different type.",
    "    Tlv expect(int tag) {",
    "        Tlv t = self.readTlv();",
    "        if (t.tag != tag) {",
    "            return Error(`expected DER tag ${tag}, found ${t.tag}`, ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        return t;",
    "    }",
    "",
    "    bool peekIs(int tag) {",
    "        if (self.done()) {",
    "            return false;",
    "        }",
    "        return self.data[self.pos] == tag;",
    "    }",
    "",
    "    // A cursor over a header's content, one level deeper. The depth limit stops",
    "    // deep nesting from exhausting the stack.",
    "    Der inner(Tlv t) {",
    "        if (self.depth + 1 > MAX_DER_DEPTH) {",
    "            return Error(`DER nested deeper than ${MAX_DER_DEPTH}`,",
    "                ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        return { data: self.data, pos: t.contentStart, end: t.end, depth: self.depth + 1 };",
    "    }",
    "",
    "    byte[] content(Tlv t) {",
    "        return self.bytes(t.contentStart, t.end);",
    "    }",
    "",
    "    byte[] raw(Tlv t) {",
    "        return self.bytes(t.start, t.end);",
    "    }",
    "",
    "    // Every structure ends with this check. DER has no trailing padding, so",
    "    // unread bytes inside a SEQUENCE make the encoding invalid.",
    "    void atEnd(String what) {",
    "        if (!self.done()) {",
    "            return Error(what + \": \" + string.from(self.left())",
    "                + \" unread trailing bytes\", ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "    }",
    "}",
    "",
    "export Der der(byte[] data) {",
    "    return { data: data, pos: 0, end: data.length, depth: 0 };",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Primitive values",
    "// ---------------------------------------------------------------------------",
    "",
    "// An unsigned INTEGER's magnitude under DER's rules: at least one byte, not",
    "// negative, no redundant leading zero. An extra leading zero on a modulus gives",
    "// a second encoding of one key.",
    "byte[] readUnsigned(Der d, String what) {",
    "    Tlv t = d.expect(TAG_INTEGER);",
    "    byte[] v = d.content(t);",
    "    if (v.length == 0) {",
    "        return Error(what + \": empty INTEGER\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    if (v[0] >= 128) {",
    "        return Error(what + \": negative INTEGER\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    if (v.length > 1 && v[0] == 0 && v[1] < 128) {",
    "        return Error(what + \": non-minimal INTEGER encoding\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    if (v.length > 1 && v[0] == 0) {",
    "        return array.slice(v, 1, v.length);",
    "    }",
    "    return v;",
    "}",
    "",
    "// The same value as an int, for the fields that are counts: version and",
    "// pathLenConstraint.",
    "int readSmallInt(Der d, String what) {",
    "    byte[] v = readUnsigned(d, what);",
    "    if (v.length > 4) {",
    "        return Error(what + \": integer too large\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    int n = 0;",
    "    forEach(v, b) {",
    "        n = n * 256 + b;",
    "    }",
    "    return n;",
    "}",
    "",
    "// A BOOLEAN. DER has one encoding each for true and false. If any nonzero byte",
    "// were true, `cA` (the field that lets a certificate sign others) would have",
    "// two encodings.",
    "bool readBoolean(Der d, String what) {",
    "    Tlv t = d.expect(TAG_BOOLEAN);",
    "    byte[] v = d.content(t);",
    "    if (v.length != 1) {",
    "        return Error(what + \": BOOLEAN is not one byte\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    if (v[0] == 0) {",
    "        return false;",
    "    }",
    "    if (v[0] == 255) {",
    "        return true;",
    "    }",
    "    return Error(what + \": BOOLEAN is neither 0x00 nor 0xFF (BER, not DER)\",",
    "        ErrorCode.BAD_CERTIFICATE);",
    "}",
    "",
    "// An OBJECT IDENTIFIER as dotted decimal. The first byte packs the first two",
    "// arcs; the rest are base-128 with the high bit as a continuation flag.",
    "String readOid(Der d, String what) {",
    "    Tlv t = d.expect(TAG_OID);",
    "    byte[] v = d.content(t);",
    "    if (v.length == 0) {",
    "        return Error(what + \": empty OID\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    if (v[v.length - 1] >= 128) {",
    "        return Error(what + \": OID ends mid-arc\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    String out = \"\";",
    "    int acc = 0;",
    "    bool startOfArc = true;",
    "    bool first = true;",
    "    int i = 0;",
    "    while (i < v.length) {",
    "        int b = v[i];",
    "        // A leading 0x80 is a padded arc, a second encoding of one OID.",
    "        if (startOfArc && b == 128) {",
    "            return Error(what + \": non-minimal OID arc\", ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        startOfArc = false;",
    "        // This limit prevents overflow of the accumulator.",
    "        if (acc > 72057594037927936) {",
    "            return Error(what + \": OID arc too large\", ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        acc = acc * 128 + (b % 128);",
    "        if (b < 128) {",
    "            if (first) {",
    "                int a1 = acc / 40;",
    "                if (a1 > 2) {",
    "                    a1 = 2;",
    "                }",
    "                out = `${a1}.${acc - a1 * 40}`;",
    "                first = false;",
    "            } else {",
    "                out = out + \".\" + string.from(acc);",
    "            }",
    "            acc = 0;",
    "            startOfArc = true;",
    "        }",
    "        i = i + 1;",
    "    }",
    "    return out;",
    "}",
    "",
    "// A BIT STRING's payload, plus the count of unused bits in its last byte.",
    "type Bits {",
    "    byte[] data;",
    "    int unused;",
    "}",
    "",
    "Bits readBitString(Der d, String what) {",
    "    Tlv t = d.expect(TAG_BIT_STRING);",
    "    byte[] v = d.content(t);",
    "    if (v.length == 0) {",
    "        return Error(what + \": empty BIT STRING\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    int unused = v[0];",
    "    if (unused > 7) {",
    "        return Error(what + \": BIT STRING claims \" + string.from(unused)",
    "            + \" unused bits\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    if (v.length == 1 && unused != 0) {",
    "        return Error(what + \": empty BIT STRING with unused bits\",",
    "            ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    // DER requires the unused bits to be zero. keyUsage is a BIT STRING, and",
    "    // set padding bits would give it two readings.",
    "    if (unused > 0) {",
    "        int last = v[v.length - 1];",
    "        if (last % pow2(unused) != 0) {",
    "            return Error(what + \": BIT STRING has non-zero unused bits\",",
    "                ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "    }",
    "    return { data: array.slice(v, 1, v.length), unused: unused };",
    "}",
    "",
    "// Returns true when every byte is in the PrintableString alphabet. A string",
    "// with other bytes makes the certificate malformed.",
    "bool validPrintable(byte[] v) {",
    "    forEach(v, c) {",
    "        bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57);",
    "        // The rest of PrintableString's alphabet: space ' ( ) + , - . / : = ?",
    "        if (!ok && c != 32 && c != 39 && c != 40 && c != 41 && c != 43 && c != 44",
    "            && c != 45 && c != 46 && c != 47 && c != 58 && c != 61 && c != 63) {",
    "            return false;",
    "        }",
    "    }",
    "    return true;",
    "}",
    "",
    "bool validIA5(byte[] v) {",
    "    forEach(v, c) {",
    "        if (c > 127) {",
    "            return false;",
    "        }",
    "    }",
    "    return true;",
    "}",
    "",
    "// UTF-8 as the standard defines it. An overlong encoding, a surrogate or a",
    "// value above U+10FFFF is refused, because each gives a second encoding.",
    "bool validUtf8(byte[] v) {",
    "    int i = 0;",
    "    while (i < v.length) {",
    "        int c = v[i];",
    "        int extra = 0;",
    "        int least = 0;",
    "        int cp = 0;",
    "        if (c < 128) {",
    "            i = i + 1;",
    "            continue;",
    "        } else if (c >= 194 && c <= 223) {",
    "            extra = 1;",
    "            least = 128;",
    "            cp = c - 192;",
    "        } else if (c >= 224 && c <= 239) {",
    "            extra = 2;",
    "            least = 2048;",
    "            cp = c - 224;",
    "        } else if (c >= 240 && c <= 244) {",
    "            extra = 3;",
    "            least = 65536;",
    "            cp = c - 240;",
    "        } else {",
    "            return false;    // a continuation byte, or 0xC0/0xC1/0xF5+",
    "        }",
    "        if (i + extra >= v.length) {",
    "            return false;",
    "        }",
    "        int j = 1;",
    "        while (j <= extra) {",
    "            int cc = v[i + j];",
    "            if (cc < 128 || cc > 191) {",
    "                return false;",
    "            }",
    "            cp = cp * 64 + (cc - 128);",
    "            j = j + 1;",
    "        }",
    "        if (cp < least || cp > 1114111 || (cp >= 55296 && cp <= 57343)) {",
    "            return false;",
    "        }",
    "        i = i + extra + 1;",
    "    }",
    "    return true;",
    "}",
    "",
    "// Reads a text field. The bytes must be valid for their string type, and are",
    "// then used as they are. This module compares names by their DER encoding, so",
    "// it does no Unicode normalization.",
    "String readText(Der d, String what) {",
    "    Tlv t = d.readTlv();",
    "    if (t.tag != TAG_UTF8_STRING && t.tag != TAG_PRINTABLE_STRING",
    "        && t.tag != TAG_IA5_STRING && t.tag != TAG_T61_STRING",
    "        && t.tag != TAG_BMP_STRING) {",
    "        return Error(what + \": DER tag \" + string.from(t.tag) + \" is not a string\",",
    "            ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    byte[] v = d.content(t);",
    "    if (t.tag == TAG_PRINTABLE_STRING && !validPrintable(v)) {",
    "        return Error(what + \": PrintableString holds bytes it may not\",",
    "            ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    if (t.tag == TAG_IA5_STRING && !validIA5(v)) {",
    "        return Error(what + \": IA5String holds a byte above 127\",",
    "            ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    if (t.tag == TAG_UTF8_STRING && !validUtf8(v)) {",
    "        return Error(what + \": UTF8String is not valid UTF-8\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    if (t.tag == TAG_BMP_STRING && v.length % 2 != 0) {",
    "        return Error(what + \": BMPString has an odd length\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    if (t.tag == TAG_BMP_STRING) {",
    "        // UCS-2, big-endian. Only the ASCII subset is shown, for a diagnostic.",
    "        String out = \"\";",
    "        int i = 0;",
    "        while (i + 1 < v.length) {",
    "            int cp = v[i] * 256 + v[i + 1];",
    "            if (cp >= 32 && cp < 127) {",
    "                out = out + string.fromByteArray([cp as byte]);",
    "            } else {",
    "                out = out + \"?\";",
    "            }",
    "            i = i + 2;",
    "        }",
    "        return out;",
    "    }",
    "    return string.fromByteArray(v);",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Time",
    "// ---------------------------------------------------------------------------",
    "//",
    "// UTCTime and GeneralizedTime, only in the form RFC 5280 §4.1.2.5 allows: it",
    "// ends in a literal Z. Local times and fractional seconds are valid ASN.1, but",
    "// this module refuses them.",
    "//",
    "// The result is a fixed epoch plus an offset. `time.date.fromText` makes",
    "// malformed input a runtime error (§6.4), so received text never goes to it.",
    "",
    "DateTime const EPOCH = time.date.fromText(\"1970-01-01\");",
    "Duration const ONE_SECOND = time.duration(\"1s\");",
    "",
    "int digitsAt(byte[] v, int off, int n, String what) {",
    "    int out = 0;",
    "    int i = 0;",
    "    while (i < n) {",
    "        int idx = off + i;",
    "        if (idx >= v.length) {",
    "            return Error(what + \": time is truncated\", ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        int c = v[idx];",
    "        if (c < 48 || c > 57) {",
    "            return Error(what + \": time has a non-digit\", ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        out = out * 10 + (c - 48);",
    "        i = i + 1;",
    "    }",
    "    return out;",
    "}",
    "",
    "// Days from 1970-01-01 to y-m-d, proleptic Gregorian. This is Howard Hinnant's",
    "// days_from_civil, which shifts the year to start in March.",
    "int daysFromCivil(int y, int m, int d) {",
    "    int yy = y;",
    "    if (m <= 2) {",
    "        yy = yy - 1;",
    "    }",
    "    int era = yy / 400;",
    "    if (yy < 0) {",
    "        era = (yy - 399) / 400;",
    "    }",
    "    int yoe = yy - era * 400;",
    "    int mp = m + 9;",
    "    if (m > 2) {",
    "        mp = m - 3;",
    "    }",
    "    int doy = (153 * mp + 2) / 5 + d - 1;",
    "    int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;",
    "    return era * 146097 + doe - 719468;",
    "}",
    "",
    "int daysInMonth(int y, int m) {",
    "    if (m == 1 || m == 3 || m == 5 || m == 7 || m == 8 || m == 10 || m == 12) {",
    "        return 31;",
    "    }",
    "    if (m == 4 || m == 6 || m == 9 || m == 11) {",
    "        return 30;",
    "    }",
    "    if (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)) {",
    "        return 29;",
    "    }",
    "    return 28;",
    "}",
    "",
    "DateTime readTime(Der d, String what) {",
    "    Tlv t = d.readTlv();",
    "    if (t.tag != TAG_UTC_TIME && t.tag != TAG_GENERALIZED_TIME) {",
    "        return Error(what + \": DER tag \" + string.from(t.tag) + \" is not a time\",",
    "            ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    byte[] v = d.content(t);",
    "    int year = 0;",
    "    int off = 0;",
    "    if (t.tag == TAG_UTC_TIME) {",
    "        if (v.length != 13) {",
    "            return Error(what + \": UTCTime is not YYMMDDHHMMSSZ\",",
    "                ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        int yy = digitsAt(v, 0, 2, what);",
    "        // RFC 5280 §4.1.2.5.1: 50 and above is 19xx, below is 20xx.",
    "        year = 2000 + yy;",
    "        if (yy >= 50) {",
    "            year = 1900 + yy;",
    "        }",
    "        off = 2;",
    "    } else {",
    "        if (v.length != 15) {",
    "            return Error(what + \": GeneralizedTime is not YYYYMMDDHHMMSSZ\",",
    "                ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        year = digitsAt(v, 0, 4, what);",
    "        off = 4;",
    "    }",
    "    if (v[v.length - 1] != 90) {    // 'Z'",
    "        return Error(what + \": time is not UTC (no trailing Z)\",",
    "            ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    int month = digitsAt(v, off, 2, what);",
    "    int day = digitsAt(v, off + 2, 2, what);",
    "    int hour = digitsAt(v, off + 4, 2, what);",
    "    int minute = digitsAt(v, off + 6, 2, what);",
    "    int second = digitsAt(v, off + 8, 2, what);",
    "    if (year < 1 || month < 1 || month > 12 || day < 1 || day > daysInMonth(year, month)) {",
    "        return Error(what + \": time is not a date\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    // A leap second (:60) is legal in GeneralizedTime and folds onto :59.",
    "    if (hour > 23 || minute > 59 || second > 60) {",
    "        return Error(what + \": time is not a time\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    if (second > 59) {",
    "        second = 59;",
    "    }",
    "    int secs = hour * 3600 + minute * 60 + second;",
    "    return time.date.addDays(EPOCH, daysFromCivil(year, month, day)) + ONE_SECOND * secs;",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// The certificate",
    "// ---------------------------------------------------------------------------",
    "",
    "// One extension, kept whole, so a caller can read an extension that this",
    "// module does not interpret. Verification refuses a critical extension that",
    "// this module does not interpret, and names its OID.",
    "export type Extension {",
    "    String oid;",
    "    bool critical;",
    "    byte[] value;",
    "}",
    "",
    "// The general-name forms that this module reads, by context tag number. It",
    "// reads these three forms from a subjectAltName and compares only these forms",
    "// against a name constraint.",
    "export int const GN_EMAIL = 1;",
    "export int const GN_DNS = 2;",
    "export int const GN_IP = 7;",
    "",
    "// One entry of a permittedSubtrees or excludedSubtrees list (RFC 5280",
    "// §4.2.1.10). A subtree names one form and constrains only that form: a",
    "// certificate carrying no name of a form is not constrained by it.",
    "export type Subtree {",
    "    int kind;        // GN_DNS, GN_EMAIL or GN_IP",
    "    String name;     // a dNSName or rfc822Name subtree, as text",
    "    byte[] range;    // an iPAddress subtree: the address, then its mask",
    "}",
    "",
    "// A parsed certificate. The `raw*` fields are slices of the received bytes",
    "// with no re-encoding, because a signature covers bytes.",
    "export type Certificate {",
    "    byte[] raw;",
    "    byte[] rawTbs;",
    "    byte[] rawIssuer;",
    "    byte[] rawSubject;",
    "    byte[] rawSpki;",
    "",
    "    int version;",
    "    String serialNumber;",
    "    String issuer;",
    "    String subject;",
    "    DateTime notBefore;",
    "    DateTime notAfter;",
    "",
    "    String signatureAlgorithm;",
    "    byte[] signature;",
    "",
    "    String publicKeyAlgorithm;",
    "    byte[] rsaModulus;",
    "    int rsaExponent;",
    "",
    "    // For an id-ecPublicKey key: the curve as a short name (\"p256\", \"p384\"), or",
    "    // its own OID when this module does not implement it, and the SEC 1",
    "    // uncompressed point. Both are empty when the key is not EC.",
    "    String ecCurve;",
    "    byte[] ecPoint;",
    "",
    "    bool basicConstraintsPresent;",
    "    bool isCA;",
    "    int maxPathLen;    // -1 when the certificate sets none",
    "",
    "    bool keyUsagePresent;",
    "    int keyUsage;    // a bit set, indexed by the KU_ constants",
    "",
    "    bool extKeyUsagePresent;",
    "    String[] extKeyUsage;",
    "",
    "    String[] dnsNames;",
    "    String[] ipAddresses;",
    "    String[] emailAddresses;",
    "",
    "    // The iPAddress entries as received. A name constraint compares these",
    "    // bytes under a mask.",
    "    byte[][] rawIpAddresses;",
    "",
    "    // Name constraints (RFC 5280 §4.2.1.10) restrict the names of the",
    "    // certificates below this one in a chain. Each list is empty when the",
    "    // extension names no subtree of a form that this module compares.",
    "    // `unsupportedConstraints` holds the other subtrees. A certificate with",
    "    // one of those cannot issue certificates, because its constraint cannot",
    "    // be shown to hold.",
    "    bool nameConstraintsPresent;",
    "    Subtree[] permittedSubtrees;",
    "    Subtree[] excludedSubtrees;",
    "    String[] unsupportedConstraints;",
    "",
    "    Extension[] extensions;",
    "    String[] unhandledCritical;",
    "",
    "    bool hasKeyUsage(int bit) {",
    "        return (self.keyUsage / pow2(bit)) % 2 == 1;",
    "    }",
    "",
    "    // RFC 5280 §4.2.1.3: an absent keyUsage leaves the key unrestricted, and a",
    "    // present one is the complete list of permitted uses. `tls.checkPeer`",
    "    // calls this when it checks the signature.",
    "    bool mayDigitallySign() {",
    "        if (!self.keyUsagePresent) { return true; }",
    "        return self.hasKeyUsage(KU_DIGITAL_SIGNATURE);",
    "    }",
    "",
    "    // True when subject and issuer have the same DER encoding. Path-length",
    "    // counting skips these certificates.",
    "    bool isSelfIssued() {",
    "        return sameBytes(self.rawSubject, self.rawIssuer);",
    "    }",
    "}",
    "",
    "int pow2(int n) {",
    "    int v = 1;",
    "    int i = 0;",
    "    while (i < n) {",
    "        v = v * 2;",
    "        i = i + 1;",
    "    }",
    "    return v;",
    "}",
    "",
    "// Byte equality for names and key identifiers. These are public values, so an",
    "// early exit leaks nothing. Secrets use `string.bytesEqualConstantTime`.",
    "bool sameBytes(byte[] a, byte[] b) {",
    "    if (a.length != b.length) {",
    "        return false;",
    "    }",
    "    return string.fromByteArray(a) == string.fromByteArray(b);",
    "}",
    "",
    "// Renders a Name for display only. Comparisons use the raw DER.",
    "String readName(Der outer, Tlv nameTlv, String what) {",
    "    Der rdns = outer.inner(nameTlv);",
    "    String[] parts = [];",
    "    int count = 0;",
    "    while (!rdns.done()) {",
    "        count = count + 1;",
    "        if (count > MAX_NAME_ENTRIES) {",
    "            return Error(what + \": over \" + string.from(MAX_NAME_ENTRIES) + \" name entries\",",
    "                ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        Tlv setTlv = rdns.expect(TAG_SET);",
    "        Der set = rdns.inner(setTlv);",
    "        while (!set.done()) {",
    "            Tlv atvTlv = set.expect(TAG_SEQUENCE);",
    "            Der atv = set.inner(atvTlv);",
    "            String oid = readOid(atv, what);",
    "            String value = readText(atv, what);",
    "            atv.atEnd(what + \" attribute\");",
    "            array.push(parts, attrShortName(oid) + \"=\" + value);",
    "        }",
    "    }",
    "    return string.join(parts, \",\");",
    "}",
    "",
    "// Parses one DER certificate. Every Certificate comes from this function, so",
    "// the encoding checks always run. It raises BAD_CERTIFICATE (or",
    "// CONSTRAINT_VIOLATION) for malformed input.",
    "export Certificate parseCertificate(byte[] data) {",
    "    if (data.length == 0) {",
    "        return Error(\"empty certificate\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    if (data.length > MAX_CERTIFICATE) {",
    "        return Error(`certificate is ${data.length} bytes, over the ${MAX_CERTIFICATE}-byte limit`,",
    "            ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    Der top = der(data);",
    "    Tlv certTlv = top.expect(TAG_SEQUENCE);",
    "    top.atEnd(\"certificate\");",
    "    Der cert = top.inner(certTlv);",
    "",
    "    Tlv tbsTlv = cert.expect(TAG_SEQUENCE);",
    "    byte[] rawTbs = cert.raw(tbsTlv);",
    "    Der tbs = cert.inner(tbsTlv);",
    "",
    "    // RFC 5280 §4.1.1.2 requires the outer AlgorithmIdentifier to equal the one",
    "    // inside the TBS. The check is at the end of this function.",
    "    String tbsSigAlg = \"\";",
    "    byte[] tbsSigParams = [];",
    "",
    "    // version [0] EXPLICIT, defaulting to v1.",
    "    int version = 1;",
    "    if (tbs.peekIs(160)) {    // 0xA0",
    "        Tlv vTlv = tbs.expect(160);",
    "        Der v = tbs.inner(vTlv);",
    "        version = readSmallInt(v, \"version\") + 1;",
    "        v.atEnd(\"version\");",
    "        if (version < 2 || version > 3) {",
    "            return Error(`certificate version ${version} is not 2 or 3`,",
    "                ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        // DER omits a field equal to its default.",
    "        if (version == 1) {",
    "            return Error(\"certificate encodes the default version explicitly\",",
    "                ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "    }",
    "",
    "    byte[] serial = readUnsigned(tbs, \"serialNumber\");",
    "",
    "    Tlv algTlv = tbs.expect(TAG_SEQUENCE);",
    "    Der alg = tbs.inner(algTlv);",
    "    tbsSigAlg = readOid(alg, \"signature algorithm\");",
    "    tbsSigParams = alg.bytes(alg.pos, alg.end);",
    "",
    "    Tlv issuerTlv = tbs.expect(TAG_SEQUENCE);",
    "    byte[] rawIssuer = tbs.raw(issuerTlv);",
    "    String issuer = readName(tbs, issuerTlv, \"issuer\");",
    "",
    "    Tlv validTlv = tbs.expect(TAG_SEQUENCE);",
    "    Der valid = tbs.inner(validTlv);",
    "    DateTime notBefore = readTime(valid, \"notBefore\");",
    "    DateTime notAfter = readTime(valid, \"notAfter\");",
    "    valid.atEnd(\"validity\");",
    "",
    "    Tlv subjectTlv = tbs.expect(TAG_SEQUENCE);",
    "    byte[] rawSubject = tbs.raw(subjectTlv);",
    "    String subject = readName(tbs, subjectTlv, \"subject\");",
    "",
    "    Tlv spkiTlv = tbs.expect(TAG_SEQUENCE);",
    "    byte[] rawSpki = tbs.raw(spkiTlv);",
    "    Der spki = tbs.inner(spkiTlv);",
    "    Tlv keyAlgTlv = spki.expect(TAG_SEQUENCE);",
    "    Der keyAlg = spki.inner(keyAlgTlv);",
    "    String keyOid = readOid(keyAlg, \"public key algorithm\");",
    "    Bits keyBits = readBitString(spki, \"subjectPublicKey\");",
    "    spki.atEnd(\"subjectPublicKeyInfo\");",
    "    if (keyBits.unused != 0) {",
    "        return Error(\"subjectPublicKey has unused bits\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "",
    "    byte[] rsaModulus = [];",
    "    int rsaExponent = 0;",
    "    String ecCurve = \"\";",
    "    byte[] ecPoint = [];",
    "    if (keyOid == OID_RSA_ENCRYPTION) {",
    "        // RFC 3279 §2.3.1: rsaEncryption's parameters field is present and",
    "        // NULL. Any other form is a second encoding of one key.",
    "        Tlv nullTlv = keyAlg.expect(TAG_NULL);",
    "        if (nullTlv.end != nullTlv.contentStart) {",
    "            return Error(\"rsaEncryption NULL parameters are not empty\",",
    "                ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        keyAlg.atEnd(\"rsaEncryption parameters\");",
    "        Der key = der(keyBits.data);",
    "        Tlv rsaTlv = key.expect(TAG_SEQUENCE);",
    "        key.atEnd(\"RSAPublicKey\");",
    "        Der rsa = key.inner(rsaTlv);",
    "        rsaModulus = readUnsigned(rsa, \"RSA modulus\");",
    "        rsaExponent = readSmallInt(rsa, \"RSA exponent\");",
    "        rsa.atEnd(\"RSAPublicKey\");",
    "    } else if (keyOid == OID_EC_PUBLIC_KEY) {",
    "        // RFC 5480 §2.1.1: the ECParameters CHOICE must be a namedCurve OID.",
    "        // Explicit parameters would make this module trust a curve that the",
    "        // certificate chose.",
    "        String curveOid = readOid(keyAlg, \"EC curve\");",
    "        keyAlg.atEnd(\"ecPublicKey parameters\");",
    "        ecCurve = curveOid;",
    "        int pointLength = 0;",
    "        if (curveOid == OID_CURVE_P256) {",
    "            ecCurve = \"p256\";",
    "            pointLength = 65;",
    "        } else if (curveOid == OID_CURVE_P384) {",
    "            ecCurve = \"p384\";",
    "            pointLength = 97;",
    "        }",
    "        // The point is SEC 1 uncompressed (0x04 || X || Y). A compressed point",
    "        // is refused. A key on a curve that this module does not implement",
    "        // parses, but every verification with it fails.",
    "        if (pointLength > 0) {",
    "            if (keyBits.data.length != pointLength || keyBits.data[0] != 4) {",
    "                return Error(\"EC public key is not an uncompressed SEC 1 point\",",
    "                    ErrorCode.BAD_CERTIFICATE);",
    "            }",
    "            ecPoint = keyBits.data;",
    "        }",
    "    }",
    "",
    "    // The two optional unique identifiers, [1] and [2]. This module does not",
    "    // use them, but skips them to read the extensions that follow.",
    "    if (tbs.peekIs(129)) {    // 0x81",
    "        tbs.readTlv();",
    "    }",
    "    if (tbs.peekIs(130)) {    // 0x82",
    "        tbs.readTlv();",
    "    }",
    "",
    "    Extension[] extensions = [];",
    "    String[] unhandledCritical = [];",
    "    bool bcPresent = false;",
    "    bool isCA = false;",
    "    int maxPathLen = -1;",
    "    bool kuPresent = false;",
    "    int keyUsage = 0;",
    "    bool ekuPresent = false;",
    "    String[] extKeyUsage = [];",
    "    String[] dnsNames = [];",
    "    String[] ipAddresses = [];",
    "    String[] emailAddresses = [];",
    "    byte[][] rawIpAddresses = [];",
    "    bool ncPresent = false;",
    "    Subtree[] permitted = [];",
    "    Subtree[] excluded = [];",
    "    String[] unsupportedConstraints = [];",
    "",
    "    if (tbs.peekIs(163)) {    // 0xA3, extensions [3] EXPLICIT",
    "        if (version != 3) {",
    "            return Error(`extensions in a version ${version} certificate`,",
    "                ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        Tlv extsOuter = tbs.expect(163);",
    "        Der extsWrap = tbs.inner(extsOuter);",
    "        Tlv extsTlv = extsWrap.expect(TAG_SEQUENCE);",
    "        extsWrap.atEnd(\"extensions\");",
    "        Der exts = extsWrap.inner(extsTlv);",
    "        int seen = 0;",
    "        while (!exts.done()) {",
    "            seen = seen + 1;",
    "            if (seen > MAX_EXTENSIONS) {",
    "                return Error(`over ${MAX_EXTENSIONS} extensions`,",
    "                    ErrorCode.BAD_CERTIFICATE);",
    "            }",
    "            Tlv oneTlv = exts.expect(TAG_SEQUENCE);",
    "            Der one = exts.inner(oneTlv);",
    "            String oid = readOid(one, \"extension\");",
    "            bool critical = false;",
    "            if (one.peekIs(TAG_BOOLEAN)) {",
    "                critical = readBoolean(one, \"extension \" + oid);",
    "                // DER omits a FALSE that equals the default.",
    "                if (!critical) {",
    "                    return Error(\"extension \" + oid + \" encodes critical=FALSE explicitly\",",
    "                        ErrorCode.BAD_CERTIFICATE);",
    "                }",
    "            }",
    "            Tlv valTlv = one.expect(TAG_OCTET_STRING);",
    "            byte[] value = one.content(valTlv);",
    "            one.atEnd(\"extension \" + oid);",
    "            forEach(extensions, prior) {",
    "                if (prior.oid == oid) {",
    "                    return Error(\"extension \" + oid + \" appears twice\",",
    "                        ErrorCode.BAD_CERTIFICATE);",
    "                }",
    "            }",
    "            Extension e = { oid: oid, critical: critical, value: value };",
    "            array.push(extensions, e);",
    "",
    "            if (oid == OID_EXT_BASIC_CONSTRAINTS) {",
    "                bcPresent = true;",
    "                Der bc = der(value);",
    "                Tlv bcTlv = bc.expect(TAG_SEQUENCE);",
    "                bc.atEnd(\"basicConstraints\");",
    "                Der b = bc.inner(bcTlv);",
    "                if (b.peekIs(TAG_BOOLEAN)) {",
    "                    isCA = readBoolean(b, \"basicConstraints cA\");",
    "                    if (!isCA) {",
    "                        return Error(\"basicConstraints encodes cA=FALSE explicitly\",",
    "                            ErrorCode.BAD_CERTIFICATE);",
    "                    }",
    "                }",
    "                if (!b.done()) {",
    "                    maxPathLen = readSmallInt(b, \"pathLenConstraint\");",
    "                    if (!isCA) {",
    "                        return Error(\"pathLenConstraint on a non-CA certificate\",",
    "                            ErrorCode.CONSTRAINT_VIOLATION);",
    "                    }",
    "                }",
    "                b.atEnd(\"basicConstraints\");",
    "            } else if (oid == OID_EXT_KEY_USAGE) {",
    "                kuPresent = true;",
    "                Der ku = der(value);",
    "                Bits bits = readBitString(ku, \"keyUsage\");",
    "                ku.atEnd(\"keyUsage\");",
    "                int bit = 0;",
    "                forEach(bits.data, octet) {",
    "                    int mask = 128;",
    "                    int j = 0;",
    "                    while (j < 8) {",
    "                        if ((octet / mask) % 2 == 1) {",
    "                            keyUsage = keyUsage + pow2(bit);",
    "                        }",
    "                        mask = mask / 2;",
    "                        bit = bit + 1;",
    "                        j = j + 1;",
    "                    }",
    "                }",
    "            } else if (oid == OID_EXT_EXT_KEY_USAGE) {",
    "                ekuPresent = true;",
    "                Der eku = der(value);",
    "                Tlv ekuTlv = eku.expect(TAG_SEQUENCE);",
    "                eku.atEnd(\"extKeyUsage\");",
    "                Der list = eku.inner(ekuTlv);",
    "                while (!list.done()) {",
    "                    array.push(extKeyUsage, readOid(list, \"extKeyUsage\"));",
    "                    if (extKeyUsage.length > MAX_NAME_ENTRIES) {",
    "                        return Error(`over ${MAX_NAME_ENTRIES} extended key usages`,",
    "                            ErrorCode.BAD_CERTIFICATE);",
    "                    }",
    "                }",
    "            } else if (oid == OID_EXT_SAN) {",
    "                Der san = der(value);",
    "                Tlv sanTlv = san.expect(TAG_SEQUENCE);",
    "                san.atEnd(\"subjectAltName\");",
    "                Der list = san.inner(sanTlv);",
    "                int entries = 0;",
    "                while (!list.done()) {",
    "                    entries = entries + 1;",
    "                    if (entries > MAX_SAN_ENTRIES) {",
    "                        return Error(`over ${MAX_SAN_ENTRIES} subjectAltName entries`,",
    "                            ErrorCode.BAD_CERTIFICATE);",
    "                    }",
    "                    Tlv gn = list.readTlv();",
    "                    byte[] body = list.content(gn);",
    "                    // The general-name forms this module reads, by context tag:",
    "                    // rfc822Name [1], dNSName [2], iPAddress [7]. It skips the",
    "                    // other forms.",
    "                    if (gn.tag == 130) {",
    "                        // `matchHostname` compares dNSNames, so this checks",
    "                        // their syntax. An empty label or a non-IA5 byte puts",
    "                        // attacker-chosen text into the hostname comparison",
    "                        // (CVE-2009-2408).",
    "                        if (!validDnsName(body)) {",
    "                            return Error(\"subjectAltName dNSName \\\"\"",
    "                                + string.fromByteArray(body) + \"\\\" is not a host name\",",
    "                                ErrorCode.BAD_CERTIFICATE);",
    "                        }",
    "                        array.push(dnsNames, string.fromByteArray(body));",
    "                    } else if (gn.tag == 129) {",
    "                        if (!validEmail(body)) {",
    "                            return Error(\"subjectAltName rfc822Name is not an address\",",
    "                                ErrorCode.BAD_CERTIFICATE);",
    "                        }",
    "                        array.push(emailAddresses, string.fromByteArray(body));",
    "                    } else if (gn.tag == 135) {",
    "                        String ip = formatIp(body);",
    "                        if (ip == \"\") {",
    "                            return Error(`subjectAltName iPAddress is ${body.length} bytes`,",
    "                                ErrorCode.BAD_CERTIFICATE);",
    "                        }",
    "                        array.push(ipAddresses, ip);",
    "                        array.push(rawIpAddresses, body);",
    "                    }",
    "                }",
    "            } else if (oid == OID_EXT_NAME_CONSTRAINTS) {",
    "                ncPresent = true;",
    "                Der nc = der(value);",
    "                Tlv ncTlv = nc.expect(TAG_SEQUENCE);",
    "                nc.atEnd(\"nameConstraints\");",
    "                Der body = nc.inner(ncTlv);",
    "                // permittedSubtrees [0] and excludedSubtrees [1], both",
    "                // constructed and both optional.",
    "                if (body.peekIs(160)) {",
    "                    Tlv t = body.expect(160);",
    "                    permitted = readSubtrees(body.inner(t), \"permittedSubtrees\",",
    "                        unsupportedConstraints);",
    "                }",
    "                if (body.peekIs(161)) {",
    "                    Tlv t = body.expect(161);",
    "                    excluded = readSubtrees(body.inner(t), \"excludedSubtrees\",",
    "                        unsupportedConstraints);",
    "                }",
    "                body.atEnd(\"nameConstraints\");",
    "                // RFC 5280 §4.2.1.10: one of the two must be present, and each",
    "                // is a SEQUENCE SIZE (1..MAX), so an extension that constrains",
    "                // nothing is malformed.",
    "                if (permitted.length == 0 && excluded.length == 0",
    "                    && unsupportedConstraints.length == 0) {",
    "                    return Error(\"nameConstraints constrains nothing\",",
    "                        ErrorCode.BAD_CERTIFICATE);",
    "                }",
    "            } else if (critical) {",
    "                array.push(unhandledCritical, oid);",
    "            }",
    "        }",
    "        exts.atEnd(\"extensions\");",
    "        // RFC 5280 §4.2.1.10: the extension belongs in a CA certificate. On",
    "        // anything else it constrains nothing, because nothing is below it.",
    "        if (ncPresent && !isCA) {",
    "            return Error(\"nameConstraints on a certificate that is not a \"",
    "                + \"certificate authority\", ErrorCode.CONSTRAINT_VIOLATION);",
    "        }",
    "    }",
    "    tbs.atEnd(\"tbsCertificate\");",
    "",
    "    Tlv outerAlgTlv = cert.expect(TAG_SEQUENCE);",
    "    Der outerAlg = cert.inner(outerAlgTlv);",
    "    String sigAlg = readOid(outerAlg, \"signature algorithm\");",
    "    byte[] sigParams = outerAlg.bytes(outerAlg.pos, outerAlg.end);",
    "    Bits sigBits = readBitString(cert, \"signatureValue\");",
    "    cert.atEnd(\"certificate\");",
    "    if (sigBits.unused != 0) {",
    "        return Error(\"signatureValue has unused bits\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    if (sigAlg != tbsSigAlg || !sameBytes(sigParams, tbsSigParams)) {",
    "        return Error(\"the signature algorithm inside the certificate (\"",
    "            + tbsSigAlg + \") differs from the one outside it (\" + sigAlg + \")\",",
    "            ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "",
    "    // RFC 5758 §3.2: an ecdsa-with-SHA2 AlgorithmIdentifier has no parameters",
    "    // field. A NULL there is also refused.",
    "    if ((sigAlg == OID_ECDSA_SHA256 || sigAlg == OID_ECDSA_SHA384)",
    "        && sigParams.length != 0) {",
    "        return Error(\"an ECDSA signature AlgorithmIdentifier carries parameters\",",
    "            ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "",
    "    Certificate out = {",
    "        raw: data,",
    "        rawTbs: rawTbs,",
    "        rawIssuer: rawIssuer,",
    "        rawSubject: rawSubject,",
    "        rawSpki: rawSpki,",
    "        version: version,",
    "        serialNumber: crypto.hexEncode(serial),",
    "        issuer: issuer,",
    "        subject: subject,",
    "        notBefore: notBefore,",
    "        notAfter: notAfter,",
    "        signatureAlgorithm: sigAlg,",
    "        signature: sigBits.data,",
    "        publicKeyAlgorithm: keyOid,",
    "        rsaModulus: rsaModulus,",
    "        rsaExponent: rsaExponent,",
    "        ecCurve: ecCurve,",
    "        ecPoint: ecPoint,",
    "        basicConstraintsPresent: bcPresent,",
    "        isCA: isCA,",
    "        maxPathLen: maxPathLen,",
    "        keyUsagePresent: kuPresent,",
    "        keyUsage: keyUsage,",
    "        extKeyUsagePresent: ekuPresent,",
    "        extKeyUsage: extKeyUsage,",
    "        dnsNames: dnsNames,",
    "        ipAddresses: ipAddresses,",
    "        emailAddresses: emailAddresses,",
    "        rawIpAddresses: rawIpAddresses,",
    "        nameConstraintsPresent: ncPresent,",
    "        permittedSubtrees: permitted,",
    "        excludedSubtrees: excluded,",
    "        unsupportedConstraints: unsupportedConstraints,",
    "        extensions: extensions,",
    "        unhandledCritical: unhandledCritical,",
    "    };",
    "    return out;",
    "}",
    "",
    "// A dNSName holds IA5 bytes, and every label between the dots is non-empty.",
    "// This is not a full hostname grammar, because real SANs contain characters",
    "// that RFC 1035 does not allow. It refuses an empty name, an empty label, a",
    "// leading or trailing dot, a control byte and a byte above 127.",
    "bool validDnsName(byte[] v) {",
    "    if (v.length == 0 || !validIA5(v)) {",
    "        return false;",
    "    }",
    "    int labelLen = 0;",
    "    forEach(v, c) {",
    "        if (c < 33 || c == 127) {",
    "            return false;    // a space, a control byte, a NUL",
    "        }",
    "        if (c == 46) {    // '.'",
    "            if (labelLen == 0) {",
    "                return false;",
    "            }",
    "            labelLen = 0;",
    "        } else {",
    "            labelLen = labelLen + 1;",
    "            if (labelLen > 63) {",
    "                return false;",
    "            }",
    "        }",
    "    }",
    "    return labelLen > 0;",
    "}",
    "",
    "// An rfc822Name: a local part, one '@' and a valid domain. A general name that",
    "// is not an address makes the certificate malformed.",
    "bool validEmail(byte[] v) {",
    "    if (v.length == 0 || !validIA5(v)) {",
    "        return false;",
    "    }",
    "    int at = -1;",
    "    int i = 0;",
    "    while (i < v.length) {",
    "        if (v[i] == 64) {    // '@'",
    "            if (at >= 0) {",
    "                return false;",
    "            }",
    "            at = i;",
    "        }",
    "        i = i + 1;",
    "    }",
    "    if (at <= 0 || at == v.length - 1) {",
    "        return false;",
    "    }",
    "    return validDnsName(array.slice(v, at + 1, v.length));",
    "}",
    "",
    "// Renders a SAN iPAddress. IPv6 is written in full, without :: compression,",
    "// because the result is compared with the caller's text.",
    "String formatIp(byte[] b) {",
    "    if (b.length == 4) {",
    "        return string.from(b[0]) + \".\" + string.from(b[1]) + \".\"",
    "            + string.from(b[2]) + \".\" + string.from(b[3]);",
    "    }",
    "    if (b.length == 16) {",
    "        String[] groups = [];",
    "        int i = 0;",
    "        while (i < 16) {",
    "            array.push(groups, hex4(b[i] * 256 + b[i + 1]));",
    "            i = i + 2;",
    "        }",
    "        return string.join(groups, \":\");",
    "    }",
    "    return \"\";",
    "}",
    "",
    "String hex4(int v) {",
    "    String digits = \"0123456789abcdef\";",
    "    String out = \"\";",
    "    int shift = 12;",
    "    while (shift >= 0) {",
    "        int nib = (v / pow2(shift)) % 16;",
    "        out = out + string.substring(digits, nib, nib + 1);",
    "        shift = shift - 4;",
    "    }",
    "    return out;",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Name constraints",
    "// ---------------------------------------------------------------------------",
    "",
    "// The permittedSubtrees or excludedSubtrees of a nameConstraints extension.",
    "// A subtree in a form that this module cannot compare goes into `unsupported`.",
    "// A certificate with one of those cannot issue certificates, because a",
    "// constraint that cannot be checked is not met.",
    "Subtree[] readSubtrees(Der list, String what, String[] unsupported) {",
    "    Subtree[] out = [];",
    "    int seen = 0;",
    "    while (!list.done()) {",
    "        seen = seen + 1;",
    "        if (seen > MAX_NAME_ENTRIES) {",
    "            return Error(what + `: over ${MAX_NAME_ENTRIES} subtrees`,",
    "                ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        Tlv subTlv = list.expect(TAG_SEQUENCE);",
    "        Der sub = list.inner(subTlv);",
    "        Tlv base = sub.readTlv();",
    "        byte[] body = sub.content(base);",
    "        // minimum [0] and maximum [1]: RFC 5280 §4.2.1.10 says a conforming CA",
    "        // must use neither. A subtree with one is refused, because ignoring a",
    "        // maximum widens the subtree.",
    "        if (sub.peekIs(128) || sub.peekIs(129)) {",
    "            return Error(what + \": a subtree sets minimum or maximum\",",
    "                ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        sub.atEnd(what + \" subtree\");",
    "",
    "        if (base.tag == 130) {",
    "            // A zero-length dNSName subtree matches every name. Any other value",
    "            // must be a valid subjectAltName dNSName. That refuses a leading",
    "            // dot, which can mean \"this domain\" or \"below this domain\".",
    "            if (body.length > 0 && !validDnsName(body)) {",
    "                return Error(what + \": dNSName subtree \\\"\" + string.fromByteArray(body)",
    "                    + \"\\\" is not a host name\", ErrorCode.BAD_CERTIFICATE);",
    "            }",
    "            Subtree dns = { kind: GN_DNS, name: string.fromByteArray(body), range: [] };",
    "            array.push(out, dns);",
    "        } else if (base.tag == 129) {",
    "            if (!validIA5(body)) {",
    "                return Error(what + \": rfc822Name subtree is not IA5 text\",",
    "                    ErrorCode.BAD_CERTIFICATE);",
    "            }",
    "            Subtree mail = { kind: GN_EMAIL, name: string.fromByteArray(body), range: [] };",
    "            array.push(out, mail);",
    "        } else if (base.tag == 135) {",
    "            // An iPAddress subtree is an address followed by a mask of the same",
    "            // width: 8 bytes for IPv4, 32 for IPv6.",
    "            if (body.length != 8 && body.length != 32) {",
    "                return Error(what + `: an iPAddress subtree is ${body.length} bytes `",
    "                    + \"rather than an address and a mask\", ErrorCode.BAD_CERTIFICATE);",
    "            }",
    "            Subtree ip = { kind: GN_IP, name: \"\", range: body };",
    "            array.push(out, ip);",
    "        } else {",
    "            array.push(unsupported, what + \" [\" + string.from(gnNumber(base.tag)) + \"]\");",
    "        }",
    "    }",
    "    return out;",
    "}",
    "",
    "// A context tag's number, whether it was written primitive or constructed.",
    "int gnNumber(int tag) {",
    "    if (tag >= 160) {",
    "        return tag - 160;",
    "    }",
    "    return tag - 128;",
    "}",
    "",
    "// RFC 5280 §4.2.1.10 dNSName: a subtree matches a name equal to it and every",
    "// name below it. The comparison is label by label. A text comparison would put",
    "// \"evilexample.com\" inside \"example.com\".",
    "bool dnsInSubtree(String name, String constraint) {",
    "    if (string.length(constraint) == 0) {",
    "        return true;",
    "    }",
    "    String[] n = string.split(string.toLowerCaseAscii(name), \".\");",
    "    String[] c = string.split(string.toLowerCaseAscii(constraint), \".\");",
    "    if (n.length < c.length) {",
    "        return false;",
    "    }",
    "    int i = 0;",
    "    while (i < c.length) {",
    "        if (n[n.length - 1 - i] != c[c.length - 1 - i]) {",
    "            return false;",
    "        }",
    "        i = i + 1;",
    "    }",
    "    return true;",
    "}",
    "",
    "// RFC 5280 §4.2.1.10 rfc822Name has three forms, and this reads all three: a",
    "// whole address, a host, or a domain with a leading dot. A bare host matches",
    "// only that host. The constraint \"example.com\" does not admit",
    "// \"mail.example.com\". Some implementations read a bare host as a domain. The",
    "// strict reading cannot admit a name that the CA did not write.",
    "bool emailInSubtree(String address, String constraint) {",
    "    if (string.length(constraint) == 0) {",
    "        return true;",
    "    }",
    "    int at = string.find(address, \"@\");",
    "    if (at < 0) {",
    "        return false;",
    "    }",
    "    String local = string.substring(address, 0, at);",
    "    String host = string.toLowerCaseAscii(",
    "        string.substring(address, at + 1, string.length(address)));",
    "",
    "    int cat = string.find(constraint, \"@\");",
    "    if (cat >= 0) {",
    "        // The local part is case-sensitive and the domain is not.",
    "        String want = string.substring(constraint, 0, cat);",
    "        String wantHost = string.toLowerCaseAscii(",
    "            string.substring(constraint, cat + 1, string.length(constraint)));",
    "        return local == want && host == wantHost;",
    "    }",
    "    if (constraint[0] == 46) {    // '.': every address in a name below it",
    "        String below = string.toLowerCaseAscii(",
    "            string.substring(constraint, 1, string.length(constraint)));",
    "        return host != below && dnsInSubtree(host, below);",
    "    }",
    "    return host == string.toLowerCaseAscii(constraint);",
    "}",
    "",
    "// An iPAddress subtree is an address and a mask. An address of the other",
    "// family is outside the subtree.",
    "bool ipInSubtree(byte[] ip, byte[] range) {",
    "    int width = range.length / 2;",
    "    if (ip.length != width) {",
    "        return false;",
    "    }",
    "    int i = 0;",
    "    while (i < width) {",
    "        byte mask = range[width + i];",
    "        if ((ip[i] & mask) != (range[i] & mask)) {",
    "            return false;",
    "        }",
    "        i = i + 1;",
    "    }",
    "    return true;",
    "}",
    "",
    "bool inSubtree(int kind, String text, byte[] raw, Subtree sub) {",
    "    if (kind == GN_DNS) {",
    "        return dnsInSubtree(text, sub.name);",
    "    }",
    "    if (kind == GN_EMAIL) {",
    "        return emailInSubtree(text, sub.name);",
    "    }",
    "    return ipInSubtree(raw, sub.range);",
    "}",
    "",
    "// RFC 5280 §6.1.3: an issuer's constraints apply to every certificate below it",
    "// in the chain. `below` is leaf first and holds only the certificates under",
    "// this candidate, because the chain is built upwards.",
    "//",
    "// A self-issued certificate that is not the leaf is skipped. This lets a CA",
    "// re-issue its own certificate after it adds a constraint.",
    "void checkConstraints(Certificate parent, Certificate[] below) {",
    "    if (!parent.nameConstraintsPresent) {",
    "        return;",
    "    }",
    "    if (parent.unsupportedConstraints.length > 0) {",
    "        return Error(\"\\\"\" + parent.subject + \"\\\" constrains names in a form this module \"",
    "            + \"cannot compare (\" + string.join(parent.unsupportedConstraints, \", \")",
    "            + \"), so nothing below it can be shown to be within its constraint\",",
    "            ErrorCode.CONSTRAINT_VIOLATION);",
    "    }",
    "    int i = 0;",
    "    while (i < below.length) {",
    "        Certificate cert = below[i];",
    "        if (i > 0 && cert.isSelfIssued()) {",
    "            i = i + 1;",
    "            continue;",
    "        }",
    "        forEach(cert.dnsNames, name) {",
    "            checkName(parent, cert, GN_DNS, name, [], \"the name \\\"\" + name + \"\\\"\");",
    "        }",
    "        forEach(cert.emailAddresses, addr) {",
    "            checkName(parent, cert, GN_EMAIL, addr, [],",
    "                \"the address \\\"\" + addr + \"\\\"\");",
    "        }",
    "        int j = 0;",
    "        while (j < cert.rawIpAddresses.length) {",
    "            checkName(parent, cert, GN_IP, \"\", cert.rawIpAddresses[j],",
    "                \"the address \" + cert.ipAddresses[j]);",
    "            j = j + 1;",
    "        }",
    "        i = i + 1;",
    "    }",
    "}",
    "",
    "// Checks one name of one form against both lists. A match in the excluded list",
    "// always fails. The permitted list restricts only the forms that it names",
    "// (RFC 5280 §4.2.1.10).",
    "void checkName(Certificate parent, Certificate cert, int kind, String text,",
    "    byte[] raw, String described) {",
    "    forEach(parent.excludedSubtrees, sub) {",
    "        if (sub.kind != kind) {",
    "            continue;",
    "        }",
    "        if (inSubtree(kind, text, raw, sub)) {",
    "            return Error(\"\\\"\" + cert.subject + \"\\\" carries \" + described + \", which \\\"\"",
    "                + parent.subject + \"\\\" excludes\", ErrorCode.CONSTRAINT_VIOLATION);",
    "        }",
    "    }",
    "    bool restricted = false;",
    "    forEach(parent.permittedSubtrees, sub) {",
    "        if (sub.kind != kind) {",
    "            continue;",
    "        }",
    "        restricted = true;",
    "        if (inSubtree(kind, text, raw, sub)) {",
    "            return;",
    "        }",
    "    }",
    "    if (!restricted) {",
    "        return;",
    "    }",
    "    return Error(\"\\\"\" + cert.subject + \"\\\" carries \" + described + \", which \\\"\"",
    "        + parent.subject + \"\\\" does not permit\", ErrorCode.CONSTRAINT_VIOLATION);",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// PEM",
    "// ---------------------------------------------------------------------------",
    "",
    "String const PEM_BEGIN = \"-----BEGIN CERTIFICATE-----\";",
    "String const PEM_END = \"-----END CERTIFICATE-----\";",
    "",
    "// Returns every certificate in a PEM bundle, as DER. It skips blocks that are",
    "// not CERTIFICATE blocks. A block that does not close, or whose body is not",
    "// base64, raises BAD_CERTIFICATE. A root store with missing roots would make",
    "// connections fail with no visible cause.",
    "export byte[][] parsePem(String text) {",
    "    byte[][] out = [];",
    "    int pos = 0;",
    "    while (true) {",
    "        int begin = string.find(string.substring(text, pos, string.length(text)), PEM_BEGIN);",
    "        if (begin < 0) {",
    "            return out;",
    "        }",
    "        int bodyStart = pos + begin + string.length(PEM_BEGIN);",
    "        int rest = string.find(string.substring(text, bodyStart, string.length(text)), PEM_END);",
    "        if (rest < 0) {",
    "            return Error(\"PEM block opened and never closed\", ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        String body = string.substring(text, bodyStart, bodyStart + rest);",
    "        String[] joined = [];",
    "        forEach(string.split(body, \"\\n\"), line) {",
    "            String t = string.trim(line);",
    "            if (string.length(t) > 0) {",
    "                array.push(joined, t);",
    "            }",
    "        }",
    "        byte[] d = crypto.base64Decode(string.join(joined, \"\")) catch e {",
    "            return Error(\"PEM block is not base64: \" + e.message,",
    "                ErrorCode.BAD_CERTIFICATE);",
    "        };",
    "        array.push(out, d);",
    "        pos = bodyStart + rest + string.length(PEM_END);",
    "    }",
    "    return out;",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// The system root store",
    "// ---------------------------------------------------------------------------",
    "",
    "// The bundle paths to probe, in order. The first one that exists and parses",
    "// wins. Windows is not in the list, because its store is an API and not a",
    "// file.",
    "String[] rootStorePaths() {",
    "    return [",
    "        \"/etc/ssl/cert.pem\",                         // macOS, OpenBSD, Alpine",
    "        \"/etc/ssl/certs/ca-certificates.crt\",        // Debian, Ubuntu, Gentoo",
    "        \"/etc/pki/tls/certs/ca-bundle.crt\",          // Fedora, RHEL",
    "        \"/etc/ssl/ca-bundle.pem\",                    // OpenSUSE",
    "        \"/etc/pki/tls/cacert.pem\",                   // OpenELEC",
    "        \"/etc/ssl/cert.pem\",                         // FreeBSD",
    "        \"/usr/local/share/certs/ca-root-nss.crt\",    // DragonFly, FreeBSD",
    "    ];",
    "}",
    "",
    "// Reads the host's trusted roots. It raises UNTRUSTED_ROOT when it finds no",
    "// roots, and never returns an empty store.",
    "export Certificate[] systemRoots() {",
    "    String tried = \"\";",
    "    forEach(rootStorePaths(), path) {",
    "        bool there = fs.exists(path);",
    "        if (!there) {",
    "            if (string.length(tried) > 0) {",
    "                tried = tried + \", \";",
    "            }",
    "            tried = tried + path;",
    "            continue;",
    "        }",
    "        byte[] data = fs.readFile(path) catch e {",
    "            continue;",
    "        };",
    "        byte[][] ders = parsePem(string.fromByteArray(data));",
    "        Certificate[] roots = [];",
    "        forEach(ders, one) {",
    "            // A root that this module cannot parse is skipped. This is the only",
    "            // place where a parse failure is ignored, for one certificate only.",
    "            Certificate c = parseCertificate(one) catch e {",
    "                continue;",
    "            };",
    "            array.push(roots, c);",
    "        }",
    "        if (roots.length == 0) {",
    "            continue;",
    "        }",
    "        return roots;",
    "    }",
    "    return Error(\"no system root store found (tried \" + tried + \")\",",
    "        ErrorCode.UNTRUSTED_ROOT);",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Hostname verification (RFC 6125)",
    "// ---------------------------------------------------------------------------",
    "",
    "// Checks that `cert` is valid for `host`, and raises HOSTNAME_MISMATCH when it",
    "// is not. Only subjectAltName is used. The common name is untyped display",
    "// text, and major clients do not use it.",
    "export void matchHostname(Certificate cert, String host) {",
    "    String want = string.toLowerCaseAscii(string.trim(host));",
    "    if (string.length(want) == 0) {",
    "        return Error(\"no hostname to check against\", ErrorCode.HOSTNAME_MISMATCH);",
    "    }",
    "    // A trailing dot is a legal, fully-qualified spelling of the same name.",
    "    if (want[string.length(want) - 1] == 46) {    // '.'",
    "        want = string.substring(want, 0, string.length(want) - 1);",
    "    }",
    "    if (looksNumeric(want)) {",
    "        forEach(cert.ipAddresses, ip) {",
    "            if (ip == want) {",
    "                return;",
    "            }",
    "        }",
    "        return Error(\"certificate is not valid for \" + host + \" (it names \"",
    "            + describeNames(cert) + \")\", ErrorCode.HOSTNAME_MISMATCH);",
    "    }",
    "    forEach(cert.dnsNames, name) {",
    "        if (dnsMatches(string.toLowerCaseAscii(name), want)) {",
    "            return;",
    "        }",
    "    }",
    "    return Error(\"certificate is not valid for \" + host + \" (it names \"",
    "        + describeNames(cert) + \")\", ErrorCode.HOSTNAME_MISMATCH);",
    "}",
    "",
    "String describeNames(Certificate cert) {",
    "    String[] all = [];",
    "    forEach(cert.dnsNames, n) {",
    "        array.push(all, n);",
    "    }",
    "    forEach(cert.ipAddresses, n) {",
    "        array.push(all, n);",
    "    }",
    "    if (all.length == 0) {",
    "        return \"no names at all\";",
    "    }",
    "    if (all.length > 6) {",
    "        String[] head = array.slice(all, 0, 6);",
    "        return string.join(head, \", \") + \" and \" + string.from(all.length - 6) + \" more\";",
    "    }",
    "    return string.join(all, \", \");",
    "}",
    "",
    "// An address literal is matched against iPAddress entries only, never against",
    "// dNSName entries. `tls` uses the same test to decide whether SNI may carry a",
    "// name.",
    "bool looksNumeric(String host) {",
    "    if (string.contains(host, \":\")) {",
    "        return true;",
    "    }",
    "    String[] parts = string.split(host, \".\");",
    "    if (parts.length != 4) {",
    "        return false;",
    "    }",
    "    forEach(parts, p) {",
    "        if (string.length(p) == 0 || string.length(p) > 3) {",
    "            return false;",
    "        }",
    "        forEach(string.toByteArray(p), c) {",
    "            if (c < 48 || c > 57) {",
    "                return false;",
    "            }",
    "        }",
    "    }",
    "    return true;",
    "}",
    "",
    "// RFC 6125 §6.4.3: a wildcard may be only the whole leftmost label and matches",
    "// one label. `*.example.com` covers `www.example.com`, and covers neither",
    "// `example.com` nor `a.b.example.com`.",
    "bool dnsMatches(String pattern, String host) {",
    "    if (string.length(pattern) == 0 || string.length(host) == 0) {",
    "        return false;",
    "    }",
    "    if (!string.contains(pattern, \"*\")) {",
    "        return pattern == host;",
    "    }",
    "    if (string.length(pattern) < 3 || pattern[0] != 42 || pattern[1] != 46) {",
    "        return false;    // '*' must be followed by '.'",
    "    }",
    "    String suffix = string.substring(pattern, 1, string.length(pattern));",
    "    if (string.contains(suffix, \"*\")) {",
    "        return false;",
    "    }",
    "    int dot = string.find(host, \".\");",
    "    if (dot <= 0) {",
    "        return false;",
    "    }",
    "    // A wildcard may not cover a public suffix such as `*.com`. Two labels must",
    "    // follow the wildcard.",
    "    String[] tail = string.split(suffix, \".\");",
    "    int labels = 0;",
    "    forEach(tail, t) {",
    "        if (string.length(t) > 0) {",
    "            labels = labels + 1;",
    "        }",
    "    }",
    "    if (labels < 2) {",
    "        return false;",
    "    }",
    "    return string.substring(host, dot, string.length(host)) == suffix;",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Signatures",
    "// ---------------------------------------------------------------------------",
    "",
    "// Verifies that `parent`'s key signed `child`, and raises BAD_SIGNATURE when",
    "// it did not. Every unsupported case raises, because a permissive reading",
    "// accepts a forgery.",
    "export void checkSignature(Certificate child, Certificate parent) {",
    "    String alg = child.signatureAlgorithm;",
    "    if (alg == OID_SHA1_RSA || alg == OID_MD5_RSA) {",
    "        return Error(\"signature algorithm \" + alg",
    "            + \" (SHA-1 or MD5) is refused: chosen-prefix collisions against it are practical\",",
    "            ErrorCode.UNSUPPORTED_ALGORITHM);",
    "    }",
    "    if (alg == OID_ED25519) {",
    "        return Error(\"signature algorithm \" + alg",
    "            + \" is not implemented yet, so this certificate cannot be verified\",",
    "            ErrorCode.UNSUPPORTED_ALGORITHM);",
    "    }",
    "",
    "    // The issuer's key gives the curve and the algorithm gives the hash. The",
    "    // two choices are independent.",
    "    if (alg == OID_ECDSA_SHA256 || alg == OID_ECDSA_SHA384) {",
    "        if (parent.publicKeyAlgorithm != OID_EC_PUBLIC_KEY) {",
    "            return Error(\"an ECDSA signature under a \" + parent.publicKeyAlgorithm",
    "                + \" issuer key\", ErrorCode.BAD_CERTIFICATE);",
    "        }",
    "        if (parent.ecPoint.length == 0) {",
    "            return Error(\"issuer's EC curve \" + parent.ecCurve",
    "                + \" is not implemented, so this certificate cannot be verified\",",
    "                ErrorCode.UNSUPPORTED_ALGORITHM);",
    "        }",
    "        byte[] digest = crypto.sha256(child.rawTbs);",
    "        if (alg == OID_ECDSA_SHA384) {",
    "            digest = crypto.sha384(child.rawTbs);",
    "        }",
    "        EcdsaSignature sig = parseEcdsaSignature(child.signature) catch e {",
    "            return Error(\"\\\"\" + child.subject + \"\\\": \" + e.message,",
    "                ErrorCode.BAD_CERTIFICATE);",
    "        };",
    "        crypto.ecdsaVerify(parent.ecCurve, parent.ecPoint, digest, sig.r, sig.s)",
    "        catch e {",
    "            return signatureError(child, parent, e);",
    "        };",
    "        return;",
    "    }",
    "",
    "    if (parent.publicKeyAlgorithm != OID_RSA_ENCRYPTION) {",
    "        return Error(\"issuer's key algorithm \" + parent.publicKeyAlgorithm",
    "            + \" cannot carry a \" + alg + \" signature\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    if (parent.rsaModulus.length == 0) {",
    "        return Error(\"issuer has no usable RSA key\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "",
    "    String hash = \"\";",
    "    bool pss = false;",
    "    if (alg == OID_SHA256_RSA) {",
    "        hash = \"sha256\";",
    "    } else if (alg == OID_SHA384_RSA) {",
    "        hash = \"sha384\";",
    "    } else if (alg == OID_RSASSA_PSS) {",
    "        // Only the TLS 1.3 profile is accepted: MGF1 with the same hash, and a",
    "        // salt length equal to the hash length.",
    "        hash = pssHash(child);",
    "        pss = true;",
    "    } else {",
    "        return Error(\"signature algorithm \" + alg + \" is not recognized\",",
    "            ErrorCode.UNSUPPORTED_ALGORITHM);",
    "    }",
    "",
    "    byte[] digest = crypto.sha256(child.rawTbs);",
    "    if (hash == \"sha384\") {",
    "        digest = crypto.sha384(child.rawTbs);",
    "    }",
    "    if (pss) {",
    "        crypto.rsaVerifyPss(parent.rsaModulus, parent.rsaExponent, hash, digest,",
    "            child.signature) catch e {",
    "            return signatureError(child, parent, e);",
    "        };",
    "        return;",
    "    }",
    "    crypto.rsaVerifyPkcs1v15(parent.rsaModulus, parent.rsaExponent, hash, digest,",
    "        child.signature) catch e {",
    "        return signatureError(child, parent, e);",
    "    };",
    "}",
    "",
    "// Keeps the two crypto failures apart. An unusable key or signature is",
    "// BAD_CERTIFICATE. A signature that does not verify is BAD_SIGNATURE.",
    "Error signatureError(Certificate child, Certificate parent, Error e) {",
    "    int code = ErrorCode.BAD_SIGNATURE;",
    "    if (e.code == crypto.ErrorCode.INVALID) {",
    "        code = ErrorCode.BAD_CERTIFICATE;",
    "    }",
    "    return Error(\"\\\"\" + child.subject + \"\\\" is not signed by \\\"\" + parent.subject",
    "        + \"\\\": \" + e.message, code);",
    "}",
    "",
    "// Reads the RSASSA-PSS parameters and requires the profile that RFC 8446",
    "// §4.2.3 defines for rsa_pss_rsae_*.",
    "String pssHash(Certificate cert) {",
    "    // `parseCertificate` keeps only the algorithm OID, so this reads the",
    "    // parameters again from the certificate bytes.",
    "    Der top = der(cert.raw);",
    "    Tlv certTlv = top.expect(TAG_SEQUENCE);",
    "    Der body = top.inner(certTlv);",
    "    body.readTlv();    // tbsCertificate",
    "    Tlv algTlv = body.expect(TAG_SEQUENCE);",
    "    Der alg = body.inner(algTlv);",
    "    readOid(alg, \"signature algorithm\");",
    "    if (alg.done()) {",
    "        return Error(\"RSASSA-PSS with no parameters\", ErrorCode.UNSUPPORTED_ALGORITHM);",
    "    }",
    "    Tlv paramsTlv = alg.expect(TAG_SEQUENCE);",
    "    Der params = alg.inner(paramsTlv);",
    "    alg.atEnd(\"RSASSA-PSS parameters\");",
    "",
    "    String hash = OID_SHA256;",
    "    bool sawHash = false;",
    "    String mgfHash = OID_SHA256;",
    "    bool sawMgf = false;",
    "    int saltLen = 20;    // the ASN.1 default",
    "    while (!params.done()) {",
    "        Tlv f = params.readTlv();",
    "        Der v = params.inner(f);",
    "        if (f.tag == 160) {    // [0] hashAlgorithm",
    "            Tlv h = v.expect(TAG_SEQUENCE);",
    "            Der hd = v.inner(h);",
    "            hash = readOid(hd, \"PSS hashAlgorithm\");",
    "            sawHash = true;",
    "        } else if (f.tag == 161) {    // [1] maskGenAlgorithm",
    "            Tlv m = v.expect(TAG_SEQUENCE);",
    "            Der md = v.inner(m);",
    "            String mgf = readOid(md, \"PSS maskGenAlgorithm\");",
    "            if (mgf != \"1.2.840.113549.1.1.8\") {",
    "                return Error(\"RSASSA-PSS mask function \" + mgf + \" is not MGF1\",",
    "                    ErrorCode.UNSUPPORTED_ALGORITHM);",
    "            }",
    "            Tlv mh = md.expect(TAG_SEQUENCE);",
    "            Der mhd = md.inner(mh);",
    "            mgfHash = readOid(mhd, \"PSS MGF1 hash\");",
    "            sawMgf = true;",
    "        } else if (f.tag == 162) {    // [2] saltLength",
    "            saltLen = readSmallInt(v, \"PSS saltLength\");",
    "        } else if (f.tag == 163) {    // [3] trailerField",
    "            int trailer = readSmallInt(v, \"PSS trailerField\");",
    "            if (trailer != 1) {",
    "                return Error(\"RSASSA-PSS trailerField is not 1\",",
    "                    ErrorCode.UNSUPPORTED_ALGORITHM);",
    "            }",
    "        }",
    "    }",
    "    // The ASN.1 defaults are SHA-1 and a 20-byte salt, which this module",
    "    // refuses. The error for omitted fields names the SHA-1 defaults.",
    "    if (!sawHash || !sawMgf) {",
    "        return Error(\"RSASSA-PSS with defaulted SHA-1 parameters is refused\",",
    "            ErrorCode.UNSUPPORTED_ALGORITHM);",
    "    }",
    "    if (hash != mgfHash) {",
    "        return Error(\"RSASSA-PSS hash and MGF1 hash differ\",",
    "            ErrorCode.UNSUPPORTED_ALGORITHM);",
    "    }",
    "    if (hash == OID_SHA256) {",
    "        if (saltLen != 32) {",
    "            return Error(`RSASSA-PSS salt length ${saltLen} is not the hash length`,",
    "                ErrorCode.UNSUPPORTED_ALGORITHM);",
    "        }",
    "        return \"sha256\";",
    "    }",
    "    if (hash == OID_SHA384) {",
    "        if (saltLen != 48) {",
    "            return Error(`RSASSA-PSS salt length ${saltLen} is not the hash length`,",
    "                ErrorCode.UNSUPPORTED_ALGORITHM);",
    "        }",
    "        return \"sha384\";",
    "    }",
    "    return Error(\"RSASSA-PSS hash \" + hash + \" is not supported\",",
    "        ErrorCode.UNSUPPORTED_ALGORITHM);",
    "}",
    "",
    "// An RSA public key from a certificate. A caller uses it to check a signature",
    "// that is not a certificate signature, such as TLS's CertificateVerify.",
    "export type RsaPublicKey {",
    "    byte[] modulus;",
    "    int exponent;",
    "}",
    "",
    "export RsaPublicKey rsaPublicKey(Certificate cert) {",
    "    if (cert.publicKeyAlgorithm != OID_RSA_ENCRYPTION) {",
    "        return Error(\"certificate holds a \" + cert.publicKeyAlgorithm",
    "            + \" key, not an RSA one\", ErrorCode.UNSUPPORTED_ALGORITHM);",
    "    }",
    "    if (cert.rsaModulus.length == 0) {",
    "        return Error(\"certificate holds no usable RSA key\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    return { modulus: cert.rsaModulus, exponent: cert.rsaExponent };",
    "}",
    "",
    "// An ECDSA public key from a certificate, for the same use.",
    "// `crypto.ecdsaVerify` takes the curve name and the point.",
    "export type EcdsaPublicKey {",
    "    String curve;    // \"p256\" or \"p384\"",
    "    byte[] point;    // SEC 1 uncompressed",
    "}",
    "",
    "export EcdsaPublicKey ecdsaPublicKey(Certificate cert) {",
    "    if (cert.publicKeyAlgorithm != OID_EC_PUBLIC_KEY) {",
    "        return Error(\"certificate holds a \" + cert.publicKeyAlgorithm",
    "            + \" key, not an EC one\", ErrorCode.UNSUPPORTED_ALGORITHM);",
    "    }",
    "    if (cert.ecPoint.length == 0) {",
    "        return Error(\"certificate's EC curve \" + cert.ecCurve + \" is not implemented\",",
    "            ErrorCode.UNSUPPORTED_ALGORITHM);",
    "    }",
    "    return { curve: cert.ecCurve, point: cert.ecPoint };",
    "}",
    "",
    "// The SHA-256 of a certificate's SubjectPublicKeyInfo, which is the pin value",
    "// (§6.18). It hashes `rawSpki`, the received bytes. A certificate reissued for",
    "// the same key keeps its pin, and a rotated key gets a new pin.",
    "export byte[] spkiPin(Certificate cert) {",
    "    return crypto.sha256(cert.rawSpki);",
    "}",
    "",
    "// Returns true when any certificate in `chain` holds a key that `pins` names.",
    "// Pin an intermediate to accept every leaf issued under it, or pin a leaf to",
    "// accept one key only.",
    "//",
    "// Call it on a chain that is already verified. A pin narrows which verified",
    "// chains are acceptable, and does not give trust. An empty `pins` matches",
    "// nothing, so `tls.Options` refuses an empty list.",
    "export bool pinned(Certificate[] chain, byte[][] pins) {",
    "    forEach(chain, cert) {",
    "        byte[] have = spkiPin(cert);",
    "        forEach(pins, pin) {",
    "            if (string.bytesEqualConstantTime(have, pin)) { return true; }",
    "        }",
    "    }",
    "    return false;",
    "}",
    "",
    "// An ECDSA signature value (RFC 5480 §3): SEQUENCE { r INTEGER, s INTEGER },",
    "// under the same DER strictness as everything else here. It is exported because",
    "// TLS's CertificateVerify carries the same encoding.",
    "export type EcdsaSignature {",
    "    byte[] r;",
    "    byte[] s;",
    "}",
    "",
    "export EcdsaSignature parseEcdsaSignature(byte[] data) {",
    "    Der d = der(data);",
    "    Tlv seq = d.expect(TAG_SEQUENCE);",
    "    d.atEnd(\"ECDSA signature\");",
    "    Der body = d.inner(seq);",
    "    byte[] r = readUnsigned(body, \"ECDSA r\");",
    "    byte[] s = readUnsigned(body, \"ECDSA s\");",
    "    body.atEnd(\"ECDSA signature\");",
    "    return { r: r, s: s };",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// Chain verification",
    "// ---------------------------------------------------------------------------",
    "",
    "export type Options {",
    "    // The name the server must be valid for. Left out, no hostname check runs.",
    "    String? dnsName;",
    "    // The trusted roots. Left out, the system store is read.",
    "    Certificate[]? roots;",
    "    // The instant to judge validity at. Left out, now.",
    "    DateTime? at;",
    "}",
    "",
    "// Takes the chain a peer sent, leaf first as TLS 1.3 sends it, and returns the",
    "// verified chain from the leaf up to the root. The received certificates are",
    "// only candidates, so the returned chain can differ from the received one.",
    "// It raises an ErrorCode that gives the reason when no chain is trusted.",
    "export Certificate[] verify(Certificate[] chain, Options? options) {",
    "    if (chain.length == 0) {",
    "        return Error(\"the peer sent no certificates\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    Certificate leaf = chain[0];",
    "    DateTime at = time.now();",
    "    Options? opts = options;",
    "    if (opts != null) {",
    "        DateTime? given = opts.at;",
    "        if (given != null) {",
    "            at = given;",
    "        }",
    "    }",
    "    Certificate[] roots = [];",
    "    if (opts != null) {",
    "        Certificate[]? r = opts.roots;",
    "        if (r != null) {",
    "            roots = r;",
    "        }",
    "    }",
    "    if (roots.length == 0) {",
    "        roots = systemRoots();",
    "    }",
    "",
    "    // The leaf is checked before any chain is built, so the error gives the",
    "    // specific reason, such as a wrong host or an unhandled critical extension.",
    "    checkUsable(leaf, at);",
    "    if (leaf.basicConstraintsPresent && leaf.isCA) {",
    "        // Several known attacks present a CA certificate as a server identity.",
    "        if (leaf.extKeyUsagePresent && !hasServerAuth(leaf)) {",
    "            return Error(\"the leaf certificate is a CA and is not valid for server \"",
    "                + \"authentication\", ErrorCode.CONSTRAINT_VIOLATION);",
    "        }",
    "    }",
    "    if (leaf.extKeyUsagePresent && !hasServerAuth(leaf)) {",
    "        return Error(\"the leaf certificate is not valid for server authentication\",",
    "            ErrorCode.CONSTRAINT_VIOLATION);",
    "    }",
    "    if (opts != null) {",
    "        String? name = opts.dnsName;",
    "        if (name != null) {",
    "            matchHostname(leaf, name);",
    "        }",
    "    }",
    "",
    "    Certificate[] pool = [];",
    "    int i = 1;",
    "    while (i < chain.length) {",
    "        array.push(pool, chain[i]);",
    "        i = i + 1;",
    "    }",
    "",
    "    Work work = { budget: MAX_CHAIN_WORK, why: \"\" };",
    "    Certificate[] built = [];",
    "    array.push(built, leaf);",
    "    Certificate[]? found = extend(built, pool, roots, at, work);",
    "    if (found == null) {",
    "        String why = \"no trusted root vouches for \\\"\" + leaf.subject + \"\\\"\";",
    "        if (string.length(work.why) > 0) {",
    "            why = why + \": \" + work.why;",
    "        }",
    "        return Error(why, ErrorCode.UNTRUSTED_ROOT);",
    "    }",
    "    return found;",
    "}",
    "",
    "// The shared state of the search: a budget that bounds the work on a pool of",
    "// cross-signed certificates, and the last reason a candidate failed.",
    "type Work {",
    "    int budget;",
    "    String why;",
    "}",
    "",
    "// The chain search. A chain is complete when its top certificate is a root by",
    "// identity. The store makes a root trusted, so its self-signature is not",
    "// checked. Roots are tried before intermediates, so the shortest trusted chain",
    "// comes first.",
    "Certificate[]? extend(Certificate[] built, Certificate[] pool, Certificate[] roots,",
    "    DateTime at, Work work) {",
    "    Certificate top = built[built.length - 1];",
    "    forEach(roots, root) {",
    "        if (sameBytes(root.rawSubject, top.rawSubject)",
    "            && sameBytes(root.rawSpki, top.rawSpki)) {",
    "            // The peer sent the root itself, which is redundant but common.",
    "            return built;",
    "        }",
    "    }",
    "    if (built.length >= MAX_CHAIN_DEPTH) {",
    "        work.why = `the chain is longer than ${MAX_CHAIN_DEPTH}`;",
    "        return null;",
    "    }",
    "    Certificate[]? viaRoot = tryParents(built, roots, pool, roots, at, work, true);",
    "    if (viaRoot != null) {",
    "        return viaRoot;",
    "    }",
    "    return tryParents(built, pool, pool, roots, at, work, false);",
    "}",
    "",
    "Certificate[]? tryParents(Certificate[] built, Certificate[] candidates,",
    "    Certificate[] pool, Certificate[] roots, DateTime at,",
    "    Work work, bool terminal) {",
    "    Certificate top = built[built.length - 1];",
    "    forEach(candidates, parent) {",
    "        if (work.budget <= 0) {",
    "            work.why = `the search gave up after ${MAX_CHAIN_WORK} candidates`;",
    "            return null;",
    "        }",
    "        if (!sameBytes(parent.rawSubject, top.rawIssuer)) {",
    "            continue;",
    "        }",
    "        // A certificate may not be its own parent or appear twice in one chain.",
    "        // Either one lets a loop in a cross-signed pool make the search",
    "        // endless.",
    "        bool seen = false;",
    "        forEach(built, already) {",
    "            if (sameBytes(already.raw, parent.raw)) {",
    "                seen = true;",
    "            }",
    "        }",
    "        if (seen) {",
    "            continue;",
    "        }",
    "        work.budget = work.budget - 1;",
    "        checkIssuer(parent, built, at) catch e {",
    "            work.why = e.message;",
    "            continue;",
    "        };",
    "        checkSignature(top, parent) catch e {",
    "            work.why = e.message;",
    "            continue;",
    "        };",
    "        Certificate[] longer = array.copy(built);",
    "        array.push(longer, parent);",
    "        if (terminal) {",
    "            return longer;",
    "        }",
    "        Certificate[]? done = extend(longer, pool, roots, at, work);",
    "        if (done != null) {",
    "            return done;",
    "        }",
    "    }",
    "    return null;",
    "}",
    "",
    "// What every certificate in a chain must satisfy, whatever its position: it is",
    "// inside its validity window, and nothing critical in it went unread.",
    "void checkUsable(Certificate cert, DateTime at) {",
    "    if (cert.unhandledCritical.length > 0) {",
    "        return Error(\"\\\"\" + cert.subject + \"\\\" has a critical extension this module \"",
    "            + \"does not implement (\" + string.join(cert.unhandledCritical, \", \")",
    "            + \"), so it cannot be judged safe\", ErrorCode.CONSTRAINT_VIOLATION);",
    "    }",
    "    if (at < cert.notBefore) {",
    "        return Error(\"\\\"\" + cert.subject + \"\\\" is not valid until \"",
    "            + time.date.toText(cert.notBefore), ErrorCode.NOT_YET_VALID);",
    "    }",
    "    if (at > cert.notAfter) {",
    "        return Error(\"\\\"\" + cert.subject + \"\\\" expired at \"",
    "            + time.date.toText(cert.notAfter), ErrorCode.EXPIRED);",
    "    }",
    "}",
    "",
    "// The conditions a certificate must meet to sign the one below it. The three",
    "// constraints come from RFC 5280 §6.1.4. Without the CA flag check, any valid",
    "// certificate could sign others.",
    "void checkIssuer(Certificate parent, Certificate[] built, DateTime at) {",
    "    checkUsable(parent, at);",
    "    if (!parent.basicConstraintsPresent || !parent.isCA) {",
    "        return Error(\"\\\"\" + parent.subject + \"\\\" is not a certificate authority\",",
    "            ErrorCode.CONSTRAINT_VIOLATION);",
    "    }",
    "    if (parent.keyUsagePresent && !parent.hasKeyUsage(KU_KEY_CERT_SIGN)) {",
    "        return Error(\"\\\"\" + parent.subject + \"\\\" is not allowed to sign certificates\",",
    "            ErrorCode.CONSTRAINT_VIOLATION);",
    "    }",
    "    if (parent.maxPathLen >= 0) {",
    "        // pathLenConstraint counts the non-self-issued intermediates that may",
    "        // follow this certificate. `built` holds the leaf and every certificate",
    "        // between it and this one.",
    "        int intermediates = 0;",
    "        int i = 1;",
    "        while (i < built.length) {",
    "            if (!built[i].isSelfIssued()) {",
    "                intermediates = intermediates + 1;",
    "            }",
    "            i = i + 1;",
    "        }",
    "        if (intermediates > parent.maxPathLen) {",
    "            return Error(\"\\\"\" + parent.subject + \"\\\" allows \" + string.from(parent.maxPathLen)",
    "                + \" intermediates below it and this chain has \" + string.from(intermediates),",
    "                ErrorCode.CONSTRAINT_VIOLATION);",
    "        }",
    "    }",
    "    checkConstraints(parent, built);",
    "}",
    "",
    "bool hasServerAuth(Certificate cert) {",
    "    forEach(cert.extKeyUsage, oid) {",
    "        if (oid == OID_EKU_SERVER_AUTH || oid == OID_EKU_ANY) {",
    "            return true;",
    "        }",
    "    }",
    "    return false;",
    "}",
    "",
    "// ---------------------------------------------------------------------------",
    "// The whole job, from what a peer sent",
    "// ---------------------------------------------------------------------------",
    "",
    "// The entry point for `tls`: DER in, verified chain out. One call does every",
    "// step in order, so a caller cannot skip a step. It raises the first error.",
    "export Certificate[] verifyChain(byte[][] ders, String? dnsName,",
    "    Certificate[]? roots, DateTime? at) {",
    "    if (ders.length == 0) {",
    "        return Error(\"the peer sent no certificates\", ErrorCode.BAD_CERTIFICATE);",
    "    }",
    "    Certificate[] parsed = [];",
    "    forEach(ders, one) {",
    "        array.push(parsed, parseCertificate(one));",
    "    }",
    "    Options opts = { dnsName: dnsName, roots: roots, at: at };",
    "    return verify(parsed, opts);",
    "}",
    "",
];

// source answers the text of a built-in module written in Nio, or null
// when there is no such module. The loader's builtinNioModules table is
// what decides which names are asked for.
export String? source(String name) {
    if (name == "http") {
        return string.join(httpLines, "\n");
    }
    if (name == "test") {
        return string.join(testLines, "\n");
    }
    if (name == "tls") {
        return string.join(tlsLines, "\n");
    }
    if (name == "x509") {
        return string.join(x509Lines, "\n");
    }
    return null;
}
