    "declare ptr @rt_string_split(ptr, ptr)",
    "declare ptr @rt_string_join(ptr, ptr)",
    "declare ptr @rt_string_trim(ptr)",
    "declare i64 @rt_string_contains(ptr, ptr)",
    "declare i64 @rt_string_equals_ct(ptr, ptr)",
    "declare i64 @rt_bytes_equals_ct(ptr, ptr)",
