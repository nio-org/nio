    "declare void @rt_process_stderr_flush()",
    "declare ptr @rt_process_stdin_read(ptr)",
    "declare ptr @rt_process_stdin_read_line(ptr)",
    "declare ptr @rt_process_stdin_read_bytes(i64, ptr)",
    "declare ptr @rt_regexp_create(ptr, ptr, ptr)",
    "declare i64 @rt_regexp_find(ptr, ptr)",
    "declare i64 @rt_regexp_match(ptr, ptr)",
    "declare ptr @rt_crypto_sha256(ptr)",
    "declare ptr @rt_crypto_sha384(ptr)",
    "declare ptr @rt_crypto_hmac_sha256(ptr, ptr)",
    "declare ptr @rt_crypto_hmac_sha384(ptr, ptr)",
    "declare ptr @rt_crypto_hkdf_extract_sha256(ptr, ptr)",
    "declare ptr @rt_crypto_hkdf_extract_sha384(ptr, ptr)",
    "declare ptr @rt_crypto_hkdf_expand_sha256(ptr, ptr, i64)",
    "declare ptr @rt_crypto_hkdf_expand_sha384(ptr, ptr, i64)",
