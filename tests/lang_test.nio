// A chain never gives T??. A field that is already optional keeps its type.
test.start("lang: optional chaining", void () -> {
    h.expectOutput(`
import 'json';
type Team { String name; String[] members; }
type Company { Team? boss; }
type Node { int value; Node? next; }

Company c = { boss: { name: "core", members: ["ada", "bob"] } };
Company empty = { boss: null };

print(c.boss?.name);
print(empty.boss?.name);
print(c.boss?.members.length);
print(c.boss?.members[1]);
print(empty.boss?.members.length);
print(empty.boss?.members[0]);

Node first = { value: 1, next: null };
Node second = { value: 2, next: first };
print(second.next?.value);
print(second.next?.next?.value);
print(first.next?.value);

// a chain result is an ordinary optional: compare, narrow, serialize
if (c.boss?.name != null) {
    print("named");
}
String? bossName = c.boss?.name;
print(bossName == "core");
print(json.toText(empty.boss?.name));
`, [
        "core", "null", "2", "bob", "null", "null", "1", "null", "null", "named",
        "true", "null",
    ]);
});

