// `nio test`: find the tests under a path, build them into one program, and run
// it (§3.4).
//
// A test registers itself while its module initializes (§6.13), so a test
// program is an entry file that imports every test module. This command
// generates that entry and gives it to the driver as text. It writes nothing
// into the tree under test.
//
// All test files build into one program, so the suite pays for one link. A
// test program is not async (§3.5). To run files in parallel needs one process
// per file, and each process costs one link.
import './driver' as driver;
import './codegen' as codegen;
import './fmtcmd' as fmtcmd;
import './loader' as loader;
import './lib/str' as str;
import 'string';
import 'array';
import 'process';

// The generated entry. It names no file on disk, and appears in a diagnostic
// and in a coverage report under this name.
String const ENTRY = "nio-test-main.nio";

void writeErr(String s) {
    process.stderr.write(s);
}

export void usage() {
    writeErr("usage: nio test [flags] [path]...\n");
    writeErr("  every *_test.nio at or under each path, or under the working\n");
    writeErr("  directory when no path is given\n");
    writeErr("flags:\n");
    writeErr("  --filter <text>   run only the tests whose title holds <text>\n");
    writeErr("  --release         optimize the test program (§5.1)\n");
    writeErr("  --coverage        write LCOV on exit\n");
    writeErr("  -g                emit debug information\n");
}

// `nio test`. The status is the test program's status: 0 when every selected
// test passed and 1 when a test failed. It is 2 when the run could not start:
// an unknown flag, no test file under the paths, or a program that does not
// build.
export int async testCmd(String[] args) {
    codegen.Options opts = codegen.noOptions();
    String filter = "";
    String[] roots = [];
    int i = 0;
    while (i < args.length) {
        String a = args[i];
        if (a == "--filter" && i + 1 < args.length) {
            filter = args[i + 1];
            i = i + 2;
            continue;
        }
        if (string.find(a, "--filter=") == 0) {
            filter = string.substring(a, 9, string.length(a));
            i++;
            continue;
        }
        if (a == "--release") {
            opts.release = true;
        } else if (a == "--coverage") {
            opts.coverage = true;
        } else if (a == "-g") {
            opts.debug = true;
        } else if (a == "--help") {
            usage();
            return 0;
        } else if (str.hasPrefix(a, "-")) {
            writeErr("unknown flag " + a + "\n");
            usage();
            return 2;
        } else {
            array.push(roots, a);
        }
        i++;
    }
    if (roots.length == 0) {
        array.push(roots, ".");
    }
    String[] files = discover(roots);
    if (files.length == 0) {
        writeErr("no *_test.nio file under " + string.join(roots, ", ") + "\n");
        return 2;
    }
    String[] progArgs = [];
    if (filter != "") {
        array.push(progArgs, "--filter");
        array.push(progArgs, filter);
    }
    driver.RunResult r = await driver.runFile(entrySource(files), ENTRY, progArgs, opts);
    String? failure = r.err;
    if (failure != null) {
        writeErr(failure + "\n");
        return 2;
    }
    return r.code;
}

// Every `*_test.nio` at or under the roots, in the fixed order in which the
// formatter walks a tree. Two runs register the tests in the same sequence.
export String[] discover(String[] roots) {
    String[] out = [];
    forEach(fmtcmd.nioFiles(roots), f) {
        if (str.hasSuffix(f, "_test.nio")) {
            array.push(out, f);
        }
    }
    return out;
}

// The entry file as text. Each module is imported under a generated alias, so
// the names that two test modules export cannot collide.
export String entrySource(String[] files) {
    String[] lines = [];
    array.push(lines, "// Generated by `nio test`. It is never written to disk.");
    forEach(files, f, i) {
        array.push(lines, "import '" + importPath(f) + "' as t" + string.from(i) + ";");
    }
    array.push(lines, "import 'test';");
    array.push(lines, "");
    array.push(lines, "test.run();");
    return string.join(lines, "\n") + "\n";
}

// The path that an import writes for a file. It has no extension, because the
// loader adds it. It is relative unless it already names a root.
String importPath(String file) {
    String p = file;
    if (str.hasSuffix(p, ".nio")) {
        p = string.substring(p, 0, string.length(p) - 4);
    }
    if (loader.isAbs(p) || str.hasPrefix(p, ".")) {
        return p;
    }
    return "./" + p;
}
